# @trusted: compiler systems module — audited raw-pointer core (like Rust std internals)
# compiler/src/srclex.tr - lossless "lexeme" layer shared by the developer tools
# (`tauraroc fmt`, `tauraroc doc`, `tauraroc cov`).
#
# The real lexer (lexer.tr) throws away exactly the things a source tool needs:
# raw literal text (it stores the *decoded* string), whitespace, and comments.
# This module re-scans a source file with the SAME lexical rules (string forms,
# char literals, f/r/b prefixes, triple quotes, number shapes, multi-character
# operators) but keeps every byte: a lexeme is (kind, raw text, byte span, line
# span, leading whitespace). It does not build a parse tree and never rejects
# input - the formatter proves its output against the real lexer afterwards.
#
# It also groups lexemes into *logical lines* the way the real lexer does:
#   * a newline inside ( [ { never ends a statement;
#   * a line that ENDS with `.` or whose next code line STARTS with `.` continues
#     (method-chain continuation, no INDENT/DEDENT);
#   * comment-only physical lines between the pieces of one logical line belong
#     to it.

from core.vec import Vec
from core.string import StringBuilder

pub def LK_WORD() -> int:    return 0   # identifier / keyword / number
pub def LK_STR() -> int:     return 1   # any string / f-string / char literal (raw text, may span lines)
pub def LK_OP() -> int:      return 2   # operator or punctuation
pub def LK_COMMENT() -> int: return 3   # `# ...` to end of line

pub def IK_COMMENT() -> int: return 1   # standalone comment line
pub def IK_CODE() -> int:    return 2   # logical code line

pub def b_is_digit(c: int) -> bool:  return c >= 48 and c <= 57
pub def b_is_alpha(c: int) -> bool:  return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
pub def b_is_alnum(c: int) -> bool:  return b_is_alpha(c) or b_is_digit(c)
pub def b_is_hex(c: int) -> bool:    return b_is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)

pub class SrcLex:
    pub src:     Pointer[char]
    pub n:       int
    pub kinds:   Vec[int]
    pub texts:   Vec[str]
    pub starts:  Vec[int]    # byte offset of the first byte
    pub ends:    Vec[int]    # byte offset one past the last byte
    pub widths:  Vec[int]    # whitespace columns before the lexeme on its line (tab = 4)
    pub lines:   Vec[int]    # 1-based line of the first byte
    pub elines:  Vec[int]    # 1-based line of the last byte
    pub firsts:  Vec[bool]   # first lexeme on its physical line
    # Logical-line items (filled by group()).
    pub i_kind:     Vec[int]    # IK_*
    pub i_first:    Vec[int]    # first lexeme index
    pub i_last:     Vec[int]    # last lexeme index (inclusive)
    pub i_verbatim: Vec[bool]   # holds a block-expression inside brackets: keep line structure untouched
    pub i_blank:    Vec[int]    # blank physical lines directly before the item

extend SrcLex:
    pub def init(source: str) -> SrcLex:
        mut s = SrcLex()
        unsafe:
            s.src = source as Pointer[char]
        mut ln = 0
        unsafe:
            mut p = s.src
            while p.offset(ln).read() as int != 0:
                ln = ln + 1
        s.n = ln
        s.kinds = Vec[int].init(256)
        s.texts = Vec[str].init(256)
        s.starts = Vec[int].init(256)
        s.ends = Vec[int].init(256)
        s.widths = Vec[int].init(256)
        s.lines = Vec[int].init(256)
        s.elines = Vec[int].init(256)
        s.firsts = Vec[bool].init(256)
        s.i_kind = Vec[int].init(64)
        s.i_first = Vec[int].init(64)
        s.i_last = Vec[int].init(64)
        s.i_verbatim = Vec[bool].init(64)
        s.i_blank = Vec[int].init(64)
        return s

    pub def b(self, i: int) -> int:
        if i < 0 or i >= self.n:
            return 0
        unsafe:
            return (self.src.offset(i).read() as int) & 255

    # Raw source bytes [a, b) as a string.
    pub def slice_raw(self, a: int, e: int) -> str:
        mut sb = StringBuilder.init(e - a + 2)
        mut i = a
        while i < e:
            sb.append_char(self.b(i))
            i = i + 1
        return sb.to_owned()

    pub def count_lines(self, a: int, e: int) -> int:
        mut c = 0
        mut i = a
        while i < e:
            if self.b(i) == 10:
                c = c + 1
            i = i + 1
        return c

    # --- string-literal scanners (return the end offset; mirror lexer.tr) ---------
    pub def scan_triple(self, i: int, quote: int) -> int:
        # i points just past the opening three quotes.
        mut j = i
        while j < self.n:
            if self.b(j) == quote and self.b(j + 1) == quote and self.b(j + 2) == quote:
                return j + 3
            j = j + 1
        return self.n

    # Plain/byte string: backslash escapes the next byte; ends at the next `quote`.
    pub def scan_escaped(self, i: int, quote: int) -> int:
        # i points just past the opening quote.
        mut j = i
        while j < self.n and self.b(j) != quote:
            if self.b(j) == 92:
                j = j + 2
            else:
                j = j + 1
        if j < self.n:
            j = j + 1
        if j > self.n:
            j = self.n
        return j

    # f-string / r-string: no escapes, ends at the next `quote`.
    pub def scan_plain(self, i: int, quote: int) -> int:
        mut j = i
        while j < self.n and self.b(j) != quote:
            j = j + 1
        if j < self.n:
            j = j + 1
        return j

    pub def op_len(self, i: int) -> int:
        mut c = self.b(i)
        mut c1 = self.b(i + 1)
        mut c2 = self.b(i + 2)
        if c == 60 and c1 == 60 and c2 == 61: return 3   # <<=
        if c == 62 and c1 == 62 and c2 == 61: return 3   # >>=
        if c == 42 and c1 == 42 and c2 == 61: return 3   # **=
        if c == 47 and c1 == 47 and c2 == 61: return 3   # //=
        if c == 46 and c1 == 46 and c2 == 46: return 3   # ...
        if c == 46 and c1 == 46 and c2 == 61: return 3   # ..=
        if c1 == 61:
            if c == 61 or c == 33 or c == 60 or c == 62 or c == 43 or c == 45 or c == 42 or c == 47 or c == 37 or c == 38 or c == 124 or c == 94:
                return 2
        if c == 60 and c1 == 60: return 2
        if c == 62 and c1 == 62: return 2
        if c == 42 and c1 == 42: return 2
        if c == 47 and c1 == 47: return 2
        if c == 45 and c1 == 62: return 2   # ->
        if c == 61 and c1 == 62: return 2   # =>
        if c == 46 and c1 == 46: return 2   # ..
        return 1

    pub def add(self, kind: int, a: int, e: int, ws: int, ln: int, first: bool):
        self.kinds.push(kind)
        self.texts.push(self.slice_raw(a, e))
        self.starts.push(a)
        self.ends.push(e)
        self.widths.push(ws)
        self.lines.push(ln)
        self.elines.push(ln + self.count_lines(a, e))
        self.firsts.push(first)

    # Scan the whole source into lexemes.
    pub def scan(self):
        mut i = 0
        if self.n >= 3 and self.b(0) == 239 and self.b(1) == 187 and self.b(2) == 191:
            i = 3
        mut line = 1
        mut ws = 0
        mut first = true
        while i < self.n:
            mut c = self.b(i)
            if c == 10:
                line = line + 1
                i = i + 1
                ws = 0
                first = true
                continue
            if c == 13:
                if self.b(i + 1) != 10:
                    line = line + 1
                    ws = 0
                    first = true
                i = i + 1
                continue
            if c == 32:
                ws = ws + 1
                i = i + 1
                continue
            if c == 9:
                ws = ws + 4
                i = i + 1
                continue
            mut st = i
            mut kind = LK_WORD()
            mut e = i
            if c == 35:
                kind = LK_COMMENT()
                e = i
                while e < self.n and self.b(e) != 10 and self.b(e) != 13:
                    e = e + 1
                # rstrip
                while e > i + 1 and (self.b(e - 1) == 32 or self.b(e - 1) == 9):
                    e = e - 1
            elif c == 34 and self.b(i + 1) == 34 and self.b(i + 2) == 34:
                kind = LK_STR()
                e = self.scan_triple(i + 3, 34)
            elif c == 34 or c == 39:
                kind = LK_STR()
                if c == 39 and (self.b(i + 2) == 39 or self.b(i + 1) == 92):
                    # char literal
                    e = i + 1
                    if self.b(e) == 92:
                        e = e + 2
                    else:
                        e = e + 1
                    if self.b(e) == 39:
                        e = e + 1
                    if e > self.n: e = self.n
                else:
                    e = self.scan_escaped(i + 1, c)
            elif c == 102 and self.b(i + 1) == 34 and self.b(i + 2) == 34 and self.b(i + 3) == 34:
                kind = LK_STR()
                e = self.scan_triple(i + 4, 34)
            elif c == 102 and (self.b(i + 1) == 34 or self.b(i + 1) == 39):
                kind = LK_STR()
                e = self.scan_plain(i + 2, self.b(i + 1))
            elif c == 114 and (self.b(i + 1) == 34 or self.b(i + 1) == 39):
                kind = LK_STR()
                e = self.scan_plain(i + 2, self.b(i + 1))
            elif c == 98 and (self.b(i + 1) == 34 or self.b(i + 1) == 39):
                kind = LK_STR()
                e = self.scan_escaped(i + 2, self.b(i + 1))
            elif b_is_digit(c):
                kind = LK_WORD()
                e = i
                mut hexlit = (c == 48 and (self.b(i + 1) == 120 or self.b(i + 1) == 88))
                while b_is_alnum(self.b(e)) or self.b(e) >= 128:
                    e = e + 1
                if self.b(e) == 46 and b_is_digit(self.b(e + 1)):
                    e = e + 1
                    while b_is_alnum(self.b(e)):
                        e = e + 1
                if not hexlit:
                    mut lc = self.b(e - 1)
                    if (lc == 101 or lc == 69) and (self.b(e) == 43 or self.b(e) == 45) and b_is_digit(self.b(e + 1)):
                        e = e + 1
                        while b_is_digit(self.b(e)):
                            e = e + 1
            elif b_is_alpha(c) or c >= 128:
                kind = LK_WORD()
                e = i
                while b_is_alnum(self.b(e)) or self.b(e) >= 128:
                    e = e + 1
            else:
                kind = LK_OP()
                e = i + self.op_len(i)
            self.add(kind, st, e, ws, line, first)
            line = line + self.count_lines(st, e)
            i = e
            ws = 0
            first = false
        # The fixed `first` flag above is "first since the last newline"; a string that
        # spans lines makes the next lexeme share its END line, which is not first.

    # --- logical-line grouping ------------------------------------------------------
    pub def seg_end(self, k: int) -> int:
        mut e = k + 1
        while e < self.kinds.len and not self.firsts.get(e):
            e = e + 1
        return e

    pub def is_comment_seg(self, k: int, e: int) -> bool:
        return e - k == 1 and self.kinds.get(k) == LK_COMMENT()

    # Index of the last non-comment lexeme in [k, e), or -1.
    pub def last_code(self, k: int, e: int) -> int:
        mut j = e - 1
        while j >= k:
            if self.kinds.get(j) != LK_COMMENT():
                return j
            j = j - 1
        return -1

    pub def is_text(self, j: int, t: str) -> bool:
        return self.kinds.get(j) != LK_STR() and self.kinds.get(j) != LK_COMMENT() and self.texts.get(j) == t

    # True when the next code (non comment-only) physical line, at or after lexeme
    # index k, starts with a '.' character.
    pub def next_code_starts_dot(self, k: int) -> bool:
        mut j = k
        while j < self.kinds.len:
            mut e = self.seg_end(j)
            if self.is_comment_seg(j, e):
                j = e
                continue
            if self.kinds.get(j) == LK_OP() and self.b(self.starts.get(j)) == 46:
                return true
            return false
        return false

    pub def group(self):
        mut m = self.kinds.len
        mut prev_end_line = 0
        mut k = 0
        while k < m:
            mut e = self.seg_end(k)
            mut blank = self.lines.get(k) - prev_end_line - 1
            if blank < 0: blank = 0
            if prev_end_line == 0: blank = 0
            if self.is_comment_seg(k, e):
                self.i_kind.push(IK_COMMENT())
                self.i_first.push(k)
                self.i_last.push(k)
                self.i_verbatim.push(false)
                self.i_blank.push(blank)
                prev_end_line = self.elines.get(k)
                k = e
                continue
            # code logical line
            mut a = k
            mut depth = 0
            mut verb = false
            mut cur = k
            mut fin = k
            while true:
                mut se = self.seg_end(cur)
                if not self.is_comment_seg(cur, se):
                    mut j = cur
                    while j < se:
                        if self.kinds.get(j) == LK_OP():
                            mut tx = self.texts.get(j)
                            if tx == "(" or tx == "[" or tx == "{": depth = depth + 1
                            elif tx == ")" or tx == "]" or tx == "}":
                                if depth > 0: depth = depth - 1
                        j = j + 1
                    mut lc = self.last_code(cur, se)
                    if lc >= 0 and depth > 0 and self.is_text(lc, ":") and self.kinds.get(lc) == LK_OP():
                        verb = true
                fin = se
                mut cont = false
                if self.is_comment_seg(cur, se):
                    cont = true   # only reached while a continuation is pending
                elif depth > 0:
                    cont = true
                else:
                    mut lc2 = self.last_code(cur, se)
                    if lc2 >= 0 and self.kinds.get(lc2) == LK_OP() and self.texts.get(lc2) == ".":
                        # a '.' right after a number is a malformed float, not a chain
                        mut afternum = false
                        if lc2 > cur and self.kinds.get(lc2 - 1) == LK_WORD() and b_is_digit(self.b(self.starts.get(lc2 - 1))):
                            afternum = true
                        if not afternum: cont = true
                    if not cont:
                        if self.next_code_starts_dot(se): cont = true
                if cont and se < m:
                    cur = se
                else:
                    break
            self.i_kind.push(IK_CODE())
            self.i_first.push(a)
            self.i_last.push(fin - 1)
            self.i_verbatim.push(verb)
            self.i_blank.push(blank)
            prev_end_line = self.elines.get(fin - 1)
            k = fin
