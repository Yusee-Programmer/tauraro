# @trusted: compiler systems module — audited raw-pointer core (like Rust std internals)
# compiler/src/tokfmt.tr - `tauraroc fmt`: the canonical Tauraro source formatter.
#
# Design (see docs/dev/12_developer_tools.md):
#   * Token/layout based, NOT AST based. The source is scanned into lossless
#     lexemes (srclex.tr) and re-laid-out; nothing is ever re-printed from a parse
#     tree, so no literal, comment, blank-line structure or operator can be altered.
#   * What it normalises: indentation (4 spaces per level), spacing around
#     operators/commas/colons/brackets, trailing whitespace, runs of blank lines,
#     a blank line before block-bodied def/class/enum/extend/interface, comment
#     indentation and the two-space gap before trailing comments, final newline,
#     and (opt-in) import ordering. Over-long single-line statements are wrapped
#     at brackets to the configured width.
#   * What it never touches: string/char/f-string contents, comment text, the
#     order of statements, existing line breaks inside brackets (they are kept and
#     re-indented), and logical lines that contain an indentation-sensitive block
#     expression inside brackets (kept verbatim, shifted as a unit).
#   * Safety nets run on EVERY file before anything is written: the original must
#     parse; the output must re-lex to the identical token stream of the real lexer
#     and parse; and formatting the output again must reproduce it byte for byte.
#     If any check fails the file is left untouched and the error is reported.

from std.core.io import read_file, write_file, file_exists
from core.vec import Vec
from core.string import StringBuilder
from lexer import Lexer
from token import Token
from parser import Parser
from srclex import SrcLex, LK_WORD, LK_STR, LK_OP, LK_COMMENT, IK_COMMENT, IK_CODE, b_is_digit

extern "C":
    def _tr_exit(c: int)
    def _tr_print_raw(s: str)
    def _tr_opendir(path: str) -> Pointer[void]
    def _tr_readdir(h: Pointer[void]) -> str
    def _tr_closedir(h: Pointer[void])
    def _tr_is_dir(path: str) -> bool
    def _tr_read_stdin_line() -> str

# --- small string helpers -----------------------------------------------------------

pub def tf_pad(n: int) -> str:
    mut sb = StringBuilder.init(n + 2)
    mut i = 0
    while i < n:
        sb.append_char(32)
        i = i + 1
    return sb.to_owned()

# Display width of a string: UTF-8 continuation bytes do not count.
pub def tf_disp_len(s: str) -> int:
    mut p = s as Pointer[char]
    mut n = 0
    mut i = 0
    unsafe:
        while true:
            mut c = (p.offset(i).read() as int) & 255
            if c == 0: break
            if (c & 192) != 128: n = n + 1
            i = i + 1
    return n

pub def tf_is_open(t: str) -> bool:
    return t == "(" or t == "[" or t == "{"

pub def tf_is_close(t: str) -> bool:
    return t == ")" or t == "]" or t == "}"

# Keywords after which an expression (and therefore a space before `(`/`[`/`{`
# and a unary operator) follows. Primitive type names, `self`, `super`, `sizeof`,
# True/False/None are deliberately absent: they behave like identifiers.
pub def tf_is_kw(t: str) -> bool:
    if t == "and" or t == "or" or t == "not" or t == "in" or t == "is": return true
    if t == "if" or t == "elif" or t == "else" or t == "while" or t == "for": return true
    if t == "return" or t == "yield" or t == "await" or t == "match" or t == "case": return true
    if t == "assert" or t == "raise" or t == "with" or t == "lambda" or t == "spawn": return true
    if t == "defer" or t == "move" or t == "own" or t == "borrow" or t == "mut": return true
    if t == "pub" or t == "const" or t == "static" or t == "stack" or t == "shared": return true
    if t == "extern" or t == "unsafe" or t == "async" or t == "throws" or t == "extends": return true
    if t == "implements" or t == "import" or t == "from" or t == "as": return true
    if t == "def" or t == "class" or t == "enum" or t == "struct" or t == "interface": return true
    if t == "extend" or t == "loop" or t == "do" or t == "try" or t == "except": return true
    if t == "finally" or t == "export" or t == "macro" or t == "decorator" or t == "where": return true
    if t == "actor" or t == "taskgroup" or t == "task_group" or t == "asm": return true
    return false

pub def tf_is_unary_cap(t: str) -> bool:
    return t == "-" or t == "+" or t == "*" or t == "**" or t == "&" or t == "~"

pub def tf_is_opch(c: int) -> bool:
    # + - * / % & | ^ < > = ! ~ . : ? @
    return c == 43 or c == 45 or c == 42 or c == 47 or c == 37 or c == 38 or c == 124 or c == 94 or c == 60 or c == 62 or c == 61 or c == 33 or c == 126 or c == 46 or c == 58 or c == 63 or c == 64

pub def tf_str_lt(a: str, b: str) -> bool:
    mut pa = a as Pointer[char]
    mut pb = b as Pointer[char]
    mut i = 0
    unsafe:
        while true:
            mut ca = (pa.offset(i).read() as int) & 255
            mut cb = (pb.offset(i).read() as int) & 255
            if ca != cb: return ca < cb
            if ca == 0: return false
            i = i + 1
    return false

# --- the formatter ---------------------------------------------------------------------

pub class TFmt:
    pub lx:        SrcLex
    pub width:     int
    pub sort_imports: bool
    pub ok:        bool
    pub err:       str
    # output lines
    pub out_text:  Vec[str]
    pub out_kind:  Vec[int]    # 0 blank, 1 comment, 2 decorator, 3 code
    pub out_level: Vec[int]
    # per-logical-line scratch
    pub tt:   Vec[str]     # token texts
    pub tk:   Vec[int]     # token lexeme kinds
    pub to:   Vec[bool]    # original whitespace before the token
    pub tbrk: Vec[bool]    # token started a physical line in the original (not the first token)
    pub un:   Vec[bool]    # token is a unary operator
    pub sp:   Vec[int]     # computed space before the token
    pub bd:   Vec[int]     # bracket depth BEFORE the token
    pub ctx:  Vec[int]     # innermost open bracket char (0 if none) at the token
    pub ctext:  Vec[str]   # comment texts
    pub cpos:   Vec[int]   # index of the token the comment precedes (ntokens = after the last)
    pub ctrail: Vec[bool]  # comment trails code on the same line

extend TFmt:
    pub def init(source: str, width: int, sort_imports: bool) -> TFmt:
        mut f = TFmt()
        f.lx = SrcLex.init(source)
        f.width = width
        f.sort_imports = sort_imports
        f.ok = true
        f.err = ""
        f.out_text = Vec[str].init(256)
        f.out_kind = Vec[int].init(256)
        f.out_level = Vec[int].init(256)
        f.tt = Vec[str].init(64)
        f.tk = Vec[int].init(64)
        f.to = Vec[bool].init(64)
        f.tbrk = Vec[bool].init(64)
        f.un = Vec[bool].init(64)
        f.sp = Vec[int].init(64)
        f.bd = Vec[int].init(64)
        f.ctx = Vec[int].init(64)
        f.ctext = Vec[str].init(8)
        f.cpos = Vec[int].init(8)
        f.ctrail = Vec[bool].init(8)
        return f

    pub def fail(self, msg: str):
        if self.ok:
            self.ok = false
            self.err = msg

    pub def emit(self, text: str, kind: int, level: int):
        self.out_text.push(text)
        self.out_kind.push(kind)
        self.out_level.push(level)

    # --- operand / unary classification ---------------------------------------------
    pub def operand_end(self, i: int) -> bool:
        if i < 0: return false
        mut k = self.tk.get(i)
        mut t = self.tt.get(i)
        if k == LK_STR(): return true
        if k == LK_WORD(): return not tf_is_kw(t)
        if k == LK_OP(): return tf_is_close(t) or t == "?"
        return false

    # --- spacing -------------------------------------------------------------------------
    pub def orig_pair(self, i: int) -> int:
        # preserved spacing around an operator token at index i: spaced when either side was.
        mut s = false
        if self.to.get(i): s = true
        if i + 1 < self.tt.len and self.to.get(i + 1): s = true
        if s: return 1
        return 0

    pub def pair_space(self, i: int) -> int:
        mut p = i - 1
        mut t = self.tt.get(i)
        mut pt = self.tt.get(p)
        mut tkd = self.tk.get(i)
        mut pkd = self.tk.get(p)
        mut t_op = tkd == LK_OP()
        mut p_op = pkd == LK_OP()
        if t_op and (t == "," or t == ";"): return 0
        if t_op and tf_is_close(t): return 0
        if p_op and tf_is_open(pt): return 0
        if p_op and pt == ".": return 0
        if t_op and t == ".": return 0
        if t_op and t == "?": return 0
        if p_op and pt == "@": return 0
        if t_op and t == "!":
            if self.operand_end(p): return 0
            if self.to.get(i): return 1
            return 0
        if p_op and pt == "!": return 0
        if t_op and (t == "(" or t == "["):
            if self.operand_end(p): return 0
            if pkd == LK_WORD() and pt == "def" and t == "(": return 0   # function type `def(int) -> int`
            if p_op and self.un.get(p): return 0
            return 1
        if t_op and t == "{":
            if self.operand_end(p):
                if self.to.get(i): return 1
                return 0
            if p_op and self.un.get(p): return 0
            return 1
        if t_op and t == ":":
            if self.ctx.get(i) == 91:
                if self.to.get(i): return 1
                return 0
            return 0
        if p_op and pt == ":":
            if self.ctx.get(i) == 91:
                if self.to.get(i): return 1
                return 0
            return 1
        # operators whose spacing is preserved (symmetrically)
        if t_op and (t == ".." or t == "..=" or t == "..."):
            return self.orig_pair(i)
        if p_op and (pt == ".." or pt == "..=" or pt == "..."):
            return self.orig_pair(p)
        if t_op and t == "**" and not self.un.get(i):
            return self.orig_pair(i)
        if p_op and pt == "**" and not self.un.get(p):
            return self.orig_pair(p)
        if t_op and t == "=" and self.bd.get(i) > 0:
            return self.orig_pair(i)
        if p_op and pt == "=" and self.bd.get(p) > 0:
            return self.orig_pair(p)
        if t_op and self.un.get(i): return 1
        if p_op and self.un.get(p): return 0
        return 1

    pub def compute_spacing(self):
        mut n = self.tt.len
        self.sp.clear()
        self.un.clear()
        self.bd.clear()
        self.ctx.clear()
        # bracket depth + context + unary flags
        mut stack = Vec[int].init(16)
        mut i = 0
        while i < n:
            mut t = self.tt.get(i)
            mut isop = self.tk.get(i) == LK_OP()
            self.bd.push(stack.len)
            if stack.len > 0:
                self.ctx.push(stack.get(stack.len - 1))
            else:
                self.ctx.push(0)
            if isop and tf_is_close(t):
                if stack.len > 0: stack.len = stack.len - 1
            mut u = false
            if isop and tf_is_unary_cap(t):
                if t == "~":
                    u = true
                elif i == 0:
                    u = true
                elif not self.operand_end(i - 1):
                    u = true
            if isop and t == "@": u = true
            self.un.push(u)
            if isop and tf_is_open(t):
                mut oc = 40
                if t == "[": oc = 91
                if t == "{": oc = 123
                stack.push(oc)
            i = i + 1
        i = 0
        while i < n:
            if i == 0:
                self.sp.push(0)
            else:
                self.sp.push(self.pair_space(i))
            i = i + 1

    # Join tokens [lo, hi) using the computed spacing; the first token gets no leading space.
    pub def flat(self, lo: int, hi: int) -> str:
        mut sb = StringBuilder.init(128)
        mut i = lo
        while i < hi:
            if i > lo and self.sp.get(i) == 1:
                sb.append_char(32)
            sb.append(self.tt.get(i))
            i = i + 1
        return sb.to_owned()

    # --- wrapping ----------------------------------------------------------------------------
    # Emit `[lo, hi)` as one or more lines whose first line is indented by `ind` columns.
    pub def wrap(self, lo: int, hi: int, ind: int, lines: Vec[str]):
        mut text = self.flat(lo, hi)
        if ind + tf_disp_len(text) <= self.width:
            lines.push(tf_pad(ind) + text)
            return
        # depth-0 bracket groups inside [lo, hi)
        mut gopen = Vec[int].init(8)
        mut gclose = Vec[int].init(8)
        mut stack = Vec[int].init(8)
        mut i = lo
        while i < hi:
            mut t = self.tt.get(i)
            if self.tk.get(i) == LK_OP():
                if tf_is_open(t):
                    stack.push(i)
                elif tf_is_close(t):
                    if stack.len > 0:
                        mut o = stack.get(stack.len - 1)
                        stack.len = stack.len - 1
                        if stack.len == 0 and i > o + 1:
                            gopen.push(o)
                            gclose.push(i)
            i = i + 1
        if gopen.len == 0:
            lines.push(tf_pad(ind) + text)
            return
        # choose the last group whose head line fits; otherwise the first group
        mut pick = 0
        mut found = false
        mut g = gopen.len - 1
        while g >= 0:
            mut head = self.flat(lo, gopen.get(g) + 1)
            if ind + tf_disp_len(head) <= self.width:
                pick = g
                found = true
                break
            g = g - 1
        if not found: pick = 0
        mut o2 = gopen.get(pick)
        mut c2 = gclose.get(pick)
        lines.push(tf_pad(ind) + self.flat(lo, o2 + 1))
        # body
        mut body = self.flat(o2 + 1, c2)
        if ind + 4 + tf_disp_len(body) <= self.width:
            lines.push(tf_pad(ind + 4) + body)
        else:
            # split into depth-0 comma separated elements
            mut starts = Vec[int].init(8)
            mut depth = 0
            starts.push(o2 + 1)
            mut j = o2 + 1
            while j < c2:
                mut tj = self.tt.get(j)
                if self.tk.get(j) == LK_OP():
                    if tf_is_open(tj): depth = depth + 1
                    elif tf_is_close(tj): depth = depth - 1
                    elif tj == "," and depth == 0:
                        if j + 1 < c2: starts.push(j + 1)
                j = j + 1
            mut e = 0
            while e < starts.len:
                mut a = starts.get(e)
                mut z = c2
                if e + 1 < starts.len: z = starts.get(e + 1)
                self.wrap(a, z, ind + 4, lines)
                e = e + 1
        # closing line: closer + whatever follows it
        lines.push(tf_pad(ind) + self.flat(c2, hi))

    # --- logical line -> output lines ---------------------------------------------------
    pub def load_item(self, idx: int):
        self.tt.clear()
        self.tk.clear()
        self.to.clear()
        self.tbrk.clear()
        self.ctext.clear()
        self.cpos.clear()
        self.ctrail.clear()
        mut a = self.lx.i_first.get(idx)
        mut z = self.lx.i_last.get(idx)
        mut k = a
        while k <= z:
            mut kind = self.lx.kinds.get(k)
            if kind == LK_COMMENT():
                self.ctext.push(self.lx.texts.get(k))
                self.cpos.push(self.tt.len)
                # trailing when it shares its physical line with an earlier token
                self.ctrail.push(not self.lx.firsts.get(k))
            else:
                self.tt.push(self.lx.texts.get(k))
                self.tk.push(kind)
                self.to.push(self.lx.widths.get(k) > 0)
                self.tbrk.push(self.lx.firsts.get(k) and k != a)
            k = k + 1

    pub def has_multi(self) -> bool:
        mut i = 1
        while i < self.tt.len:
            if self.tbrk.get(i): return true
            i = i + 1
        mut c = 0
        while c < self.ctext.len:
            if self.cpos.get(c) < self.tt.len: return true
            c = c + 1
        return false

    pub def render_code(self, idx: int, level: int):
        mut base = level * 4
        if self.lx.i_verbatim.get(idx):
            self.render_verbatim(idx, base, level)
            return
        self.load_item(idx)
        mut n = self.tt.len
        if n == 0:
            return
        self.compute_spacing()
        mut kind = 3
        if self.tt.get(0) == "@" and self.tk.get(0) == LK_OP(): kind = 2
        mut lines = Vec[str].init(8)
        # trailing comment of a single-line statement
        mut tail = ""
        if not self.has_multi():
            if self.ctext.len > 0:
                tail = "  " + self.ctext.get(0)
            self.wrap(0, n, base, lines)
            # Wrap only when the wrapped form fits: an unbreakable string/expression
            # makes the result no better than the flat line, so keep the flat line.
            if lines.len > 1:
                mut toolong = false
                mut wi = 0
                while wi < lines.len:
                    if tf_disp_len(lines.get(wi)) > self.width: toolong = true
                    wi = wi + 1
                if toolong:
                    lines.clear()
                    lines.push(tf_pad(base) + self.flat(0, n))
            if tail != "":
                mut li = lines.len - 1
                lines.set(li, lines.get(li) + tail)
        else:
            self.render_multi(base, lines)
        mut li2 = 0
        while li2 < lines.len:
            self.emit(lines.get(li2), kind, level)
            li2 = li2 + 1

    # Preserve the original line breaks of a multi-line logical line; re-indent each
    # continuation line by bracket depth.
    pub def render_multi(self, base: int, lines: Vec[str]):
        mut n = self.tt.len
        # does any continuation line start at depth 0 (method chain)?
        mut dotlevel = 0
        mut i = 1
        while i < n:
            if self.tbrk.get(i) and self.bd.get(i) == 0: dotlevel = 1
            i = i + 1
        # A block header (`def f(a,\n b):`) whose continuation has no dedicated closing
        # line would line its parameters up with the body; indent it one more level.
        mut hang = 0
        if n > 0 and self.tk.get(n - 1) == LK_OP() and self.tt.get(n - 1) == ":":
            hang = 4
            mut hi = 1
            while hi < n:
                if self.tbrk.get(hi) and self.tk.get(hi) == LK_OP() and tf_is_close(self.tt.get(hi)): hang = 0
                hi = hi + 1
        mut cur = StringBuilder.init(128)
        mut cur_has = false
        mut cur_ind = base
        mut ci = 0
        i = 0
        while i <= n:
            # comments that precede token i
            while ci < self.ctext.len and self.cpos.get(ci) == i:
                if self.ctrail.get(ci) and cur_has:
                    cur.append("  ")
                    cur.append(self.ctext.get(ci))
                    lines.push(tf_pad(cur_ind) + cur.to_owned())
                    cur.clear()
                    cur_has = false
                else:
                    if cur_has:
                        lines.push(tf_pad(cur_ind) + cur.to_owned())
                        cur.clear()
                        cur_has = false
                    mut d = 0
                    if i < n: d = self.bd.get(i)
                    else: d = 0
                    mut ind = base + 4 * (d + dotlevel)
                    if d > 0: ind = ind + hang
                    if i == 0: ind = base
                    lines.push(tf_pad(ind) + self.ctext.get(ci))
                ci = ci + 1
            if i == n: break
            mut brk = self.tbrk.get(i)
            if (i > 0 and brk) or (i > 0 and not cur_has):
                if cur_has:
                    lines.push(tf_pad(cur_ind) + cur.to_owned())
                    cur.clear()
                    cur_has = false
            if not cur_has:
                # starting a new physical line at token i
                if i == 0:
                    cur_ind = base
                else:
                    mut d2 = self.bd.get(i)
                    if tf_is_close(self.tt.get(i)) and self.tk.get(i) == LK_OP() and d2 > 0: d2 = d2 - 1
                    cur_ind = base + 4 * (d2 + dotlevel)
                    if self.bd.get(i) > 0: cur_ind = cur_ind + hang
            else:
                if self.sp.get(i) == 1: cur.append_char(32)
            cur.append(self.tt.get(i))
            cur_has = true
            i = i + 1
        if cur_has:
            lines.push(tf_pad(cur_ind) + cur.to_owned())

    pub def render_verbatim(self, idx: int, base: int, level: int):
        mut a = self.lx.i_first.get(idx)
        mut z = self.lx.i_last.get(idx)
        mut delta = base - self.lx.widths.get(a)
        mut k = a
        while k <= z:
            mut e = self.lx.seg_end(k)
            if e > z + 1: e = z + 1
            mut text = self.lx.slice_raw(self.lx.starts.get(k), self.lx.ends.get(e - 1))
            mut ind = self.lx.widths.get(k) + delta
            if k == a: ind = base
            if ind < 0: ind = 0
            self.emit(tf_pad(ind) + text, 3, level)
            k = e

    # --- block level / driver ------------------------------------------------------------------
    pub def sim_level(self, stack: Vec[int], w: int) -> int:
        mut n = stack.len
        if w > stack.get(n - 1): return n
        mut j = n - 1
        while j > 0 and stack.get(j) > w:
            j = j - 1
        return j

    pub def is_def_header(self, idx: int) -> bool:
        self.load_item(idx)
        mut n = self.tt.len
        if n < 2: return false
        if not (self.tk.get(n - 1) == LK_OP() and self.tt.get(n - 1) == ":"): return false
        mut j = 0
        while j < n and j < 4:
            mut t = self.tt.get(j)
            if t == "pub" or t == "async" or t == "export" or t == "unsafe" or t == "static":
                j = j + 1
                continue
            break
        if j >= n: return false
        mut h = self.tt.get(j)
        return h == "def" or h == "class" or h == "enum" or h == "interface" or h == "extend" or h == "struct" or h == "actor" or h == "macro" or h == "decorator"

    pub def import_key(self, idx: int) -> str:
        # sortable one-line import statements only; "" otherwise
        if self.lx.i_kind.get(idx) != IK_CODE() or self.lx.i_verbatim.get(idx): return ""
        mut a = self.lx.i_first.get(idx)
        mut z = self.lx.i_last.get(idx)
        mut first_line = self.lx.lines.get(a)
        if self.lx.elines.get(z) != first_line: return ""
        mut t0 = self.lx.texts.get(a)
        if not (t0 == "from" or t0 == "import"): return ""
        mut sb = StringBuilder.init(64)
        mut k = a
        while k <= z:
            if self.lx.kinds.get(k) == LK_COMMENT(): break
            sb.append(self.lx.texts.get(k))
            sb.append_char(32)
            k = k + 1
        return sb.to_owned()

    pub def in_import_group(self, s: int, e: int, m: int) -> bool:
        if e >= m: return false
        if self.lx.i_blank.get(e) != 0: return false
        if self.lx.widths.get(self.lx.i_first.get(e)) != self.lx.widths.get(self.lx.i_first.get(s)): return false
        mut k = self.import_key(e)
        return k != ""

    pub def run(self) -> str:
        self.lx.scan()
        self.lx.group()
        mut m = self.lx.i_kind.len
        # item order (identity unless import sorting)
        mut ord = Vec[int].init(m + 1)
        mut q = 0
        while q < m:
            ord.push(q)
            q = q + 1
        if self.sort_imports:
            mut s = 0
            while s < m:
                mut key = self.import_key(s)
                if key == "":
                    s = s + 1
                    continue
                mut e = s + 1
                while self.in_import_group(s, e, m):
                    e = e + 1
                # insertion sort ord[s..e) by key
                mut a = s + 1
                while a < e:
                    mut cur = ord.get(a)
                    mut ck = self.import_key(cur)
                    mut b = a - 1
                    while true:
                        if b < s: break
                        if not tf_str_lt(ck, self.import_key(ord.get(b))): break
                        ord.set(b + 1, ord.get(b))
                        b = b - 1
                    ord.set(b + 1, cur)
                    a = a + 1
                s = e
        # pass 1: levels
        mut lev = Vec[int].init(m + 1)
        mut stack = Vec[int].init(16)
        stack.push(0)
        mut oi = 0
        while oi < m:
            mut idx = ord.get(oi)
            mut w = self.lx.widths.get(self.lx.i_first.get(idx))
            if self.lx.i_kind.get(idx) == IK_CODE():
                if w > stack.get(stack.len - 1):
                    stack.push(w)
                elif w < stack.get(stack.len - 1):
                    while stack.len > 1 and stack.get(stack.len - 1) > w:
                        stack.len = stack.len - 1
                    if stack.get(stack.len - 1) != w:
                        self.fail("inconsistent indentation at line " + self.lx.lines.get(self.lx.i_first.get(idx)).to_str())
                        return ""
                lev.push(stack.len - 1)
            else:
                # standalone comment: look ahead to the next code line
                mut lnext = 0
                mut found = false
                mut oj = oi + 1
                while oj < m:
                    mut jdx = ord.get(oj)
                    if self.lx.i_kind.get(jdx) == IK_CODE():
                        lnext = self.sim_level(stack, self.lx.widths.get(self.lx.i_first.get(jdx)))
                        found = true
                        break
                    oj = oj + 1
                if not found: lnext = 0
                mut top = stack.len - 1
                mut level = 0
                if w > stack.get(top):
                    if lnext == stack.len:
                        level = lnext
                    else:
                        level = top
                else:
                    level = self.sim_level(stack, w)
                lev.push(level)
            oi = oi + 1
        # pass 2: emit
        mut pending = 0
        oi = 0
        while oi < m:
            mut idx2 = ord.get(oi)
            mut level2 = lev.get(oi)
            # blank lines belong to the position, not to a (possibly moved) item
            pending = self.lx.i_blank.get(oi)
            mut cap = 1
            if level2 == 0: cap = 2
            if pending > cap: pending = cap
            if self.out_text.len == 0: pending = 0
            if self.lx.i_kind.get(idx2) == IK_COMMENT():
                mut p = 0
                while p < pending:
                    self.emit("", 0, 0)
                    p = p + 1
                self.emit(tf_pad(level2 * 4) + self.lx.texts.get(self.lx.i_first.get(idx2)), 1, level2)
            else:
                # blank line before a block-bodied declaration
                if pending == 0 and self.out_text.len > 0 and self.is_def_header(idx2):
                    mut j = self.out_text.len
                    # skip the directly attached comment/decorator group at this level
                    while j > 0 and (self.out_kind.get(j - 1) == 1 or self.out_kind.get(j - 1) == 2) and self.out_level.get(j - 1) == level2:
                        j = j - 1
                    if j > 0 and self.out_kind.get(j - 1) == 3 and self.out_level.get(j - 1) >= level2:
                        self.insert_blank(j)
                mut p2 = 0
                while p2 < pending:
                    self.emit("", 0, 0)
                    p2 = p2 + 1
                self.render_code(idx2, level2)
            oi = oi + 1
        # assemble
        mut sb = StringBuilder.init(self.lx.n + 256)
        mut r = 0
        while r < self.out_text.len:
            sb.append(self.out_text.get(r))
            sb.append_char(10)
            r = r + 1
        return sb.to_owned()

    pub def insert_blank(self, at: int):
        # Vec has no insert: rebuild the three parallel vectors.
        mut nt = Vec[str].init(self.out_text.len + 8)
        mut nk = Vec[int].init(self.out_text.len + 8)
        mut nl = Vec[int].init(self.out_text.len + 8)
        mut i = 0
        while i < self.out_text.len:
            if i == at:
                nt.push("")
                nk.push(0)
                nl.push(0)
            nt.push(self.out_text.get(i))
            nk.push(self.out_kind.get(i))
            nl.push(self.out_level.get(i))
            i = i + 1
        if at >= self.out_text.len:
            nt.push("")
            nk.push(0)
            nl.push(0)
        self.out_text = nt
        self.out_kind = nk
        self.out_level = nl

# --- verification against the real lexer/parser -------------------------------------------

# Returns "" when `source` lexes+parses, otherwise a short message.
pub def tf_parse_error(source: str, path: str) -> str:
    mut lexer = Lexer.init(source)
    mut tokens = lexer.tokenize()
    mut parser = Parser.init(tokens, lexer.token_lines)
    parser.current_file = path
    parser.cols = lexer.token_cols
    parser.src_text = source
    mut prog = parser.parse_program()
    if parser.error_count > 0:
        return parser.error_count.to_str() + " parse error(s)"
    return ""

pub def tf_tok_text(t: Token) -> str:
    return t.debug()

# Index of the first token (by debug text) where the two sources' real-lexer token
# streams differ, or -1 when identical.
pub def tf_with_final_nl(s: str) -> str:
    mut n = s.len()
    if n == 0: return s
    if s.char_at(n - 1) == 10: return s
    return s + "\n"

pub def tf_token_diff(a0: str, b0: str) -> int:
    # A missing final newline lexes without the closing NEWLINE token; compare as if present.
    mut a = tf_with_final_nl(a0)
    mut b = tf_with_final_nl(b0)
    mut la = Lexer.init(a)
    mut ta = la.tokenize()
    mut lb = Lexer.init(b)
    mut tb = lb.tokenize()
    if ta.len != tb.len: return 0 - 2
    mut i = 0
    while i < ta.len:
        if tf_tok_text(ta.get(i)) != tf_tok_text(tb.get(i)): return i
        i = i + 1
    return 0 - 1

pub class FmtOutcome:
    pub ok:   bool
    pub text: str
    pub err:  str
    pub alt:  str    # on failure: the first-pass / second-pass text, for --debug

# Format `source`; verify; never returns text that failed a safety check.
pub def tf_format(source: str, path: str, width: int, sort_imports: bool) -> FmtOutcome:
    mut res = FmtOutcome()
    res.ok = false
    res.text = ""
    res.err = ""
    res.alt = ""
    mut perr = tf_parse_error(source, path)
    if perr != "":
        res.err = "does not parse (" + perr + "); not formatting"
        return res
    mut f = TFmt.init(source, width, sort_imports)
    mut out = f.run()
    if not f.ok:
        res.err = f.err
        return res
    if not sort_imports:
        mut d = tf_token_diff(source, out)
        if d != 0 - 1:
            res.err = "internal error: formatted output changes the token stream (at token " + d.to_str() + "); file left unchanged"
            res.alt = out
            return res
    mut perr2 = tf_parse_error(out, path)
    if perr2 != "":
        res.err = "internal error: formatted output does not parse (" + perr2 + "); file left unchanged"
        return res
    mut f2 = TFmt.init(out, width, sort_imports)
    mut out2 = f2.run()
    if not f2.ok or out2 != out:
        res.err = "internal error: formatter is not idempotent on this file; file left unchanged"
        res.alt = out + "\n=========== second pass ===========\n" + out2
        return res
    res.ok = true
    res.text = out
    return res

# --- file discovery + CLI -------------------------------------------------------------------

pub def tf_ends_tr(p: str) -> bool:
    mut n = p.len()
    if n < 3: return false
    return p.slice(n - 3, n) == ".tr"

# Recursively collect .tr files under `path` (or `path` itself), sorted.
pub def tf_collect(path: str, out: Vec[str]):
    if _tr_is_dir(path):
        mut h = _tr_opendir(path)
        mut names = Vec[str].init(32)
        while true:
            mut nm = _tr_readdir(h)
            if nm == "": break
            if nm == "." or nm == ".." or nm == "build" or nm.starts_with("."): continue
            names.push(nm)
        _tr_closedir(h)
        # insertion sort for deterministic order
        mut i = 1
        while i < names.len:
            mut cur = names.get(i)
            mut j = i - 1
            while true:
                if j < 0: break
                if not tf_str_lt(cur, names.get(j)): break
                names.set(j + 1, names.get(j))
                j = j - 1
            names.set(j + 1, cur)
            i = i + 1
        mut k = 0
        while k < names.len:
            mut sep = "/"
            if path.ends_with("/"): sep = ""
            tf_collect(path + sep + names.get(k), out)
            k = k + 1
    else:
        if tf_ends_tr(path): out.push(path)

pub def tf_parse_int(s: str, dflt: int) -> int:
    mut n = s.len()
    if n == 0: return dflt
    mut v = 0
    mut i = 0
    while i < n:
        mut c = (s as Pointer[char]).offset(i).read() as int
        if c < 48 or c > 57: return dflt
        v = v * 10 + (c - 48)
        i = i + 1
    return v

pub def tf_read_stdin() -> str:
    mut sb = StringBuilder.init(4096)
    while true:
        mut ln = _tr_read_stdin_line()
        if ln == "": break
        sb.append(ln)
    return sb.to_owned()

pub def tf_usage():
    print("Usage: tauraroc fmt [options] <file.tr | dir> ...")
    print("       tauraroc fmt [options] -        (read stdin, write stdout)")
    print("Options:")
    print("  -w, --write        Rewrite files in place (only when they change)")
    print("  --check            Do not write; list files that would change, exit 1 if any")
    print("  --width <n>        Wrap single-line statements longer than n columns (default 100)")
    print("  --sort-imports     Sort runs of consecutive one-line import statements")
    print("  --ast              Use the legacy AST printer instead (single file, stdout or -w)")
    print("Exit status: 0 ok, 1 --check found differences, 2 error (parse failure, I/O).")

# Returns the process exit code. `legacy_fmt` is main.tr's AST-based run_fmt.
pub def tf_main(args: Vec[str]) -> int:
    mut write_in_place = false
    mut check = false
    mut width = 100
    mut sort_imports = false
    mut debug = false
    mut use_stdin = false
    mut paths = Vec[str].init(8)
    mut i = 2
    while i < args.len:
        mut a = args.get(i)
        if a == "-w" or a == "--write": write_in_place = true
        elif a == "--check": check = true
        elif a == "--sort-imports": sort_imports = true
        elif a == "--debug": debug = true
        elif a == "--stdin" or a == "-": use_stdin = true
        elif a == "--width" and i + 1 < args.len:
            i = i + 1
            width = tf_parse_int(args.get(i), 100)
        elif a.starts_with("--width="):
            width = tf_parse_int(a.slice(8, a.len()), 100)
        elif a == "-h" or a == "--help":
            tf_usage()
            return 0
        elif a.starts_with("-") and a != "-":
            print("error: unknown fmt option " + a)
            tf_usage()
            return 2
        else:
            paths.push(a)
        i = i + 1
    if width < 20: width = 20
    if use_stdin:
        mut src = tf_read_stdin()
        mut r = tf_format(src, "<stdin>", width, sort_imports)
        if not r.ok:
            print("error: <stdin>: " + r.err)
            return 2
        if check:
            if r.text != src:
                print("would reformat <stdin>")
                return 1
            return 0
        _tr_print_raw(r.text)
        return 0
    mut files = Vec[str].init(16)
    mut pi = 0
    while pi < paths.len:
        mut p = paths.get(pi)
        if not file_exists(p) and not _tr_is_dir(p) and not tf_ends_tr(p):
            p = p + ".tr"
        if not file_exists(p) and not _tr_is_dir(p):
            print("error: no such file or directory: " + paths.get(pi))
            return 2
        tf_collect(p, files)
        pi = pi + 1
    if files.len == 0:
        print("error: fmt needs at least one .tr file or directory (or - for stdin)")
        tf_usage()
        return 2
    if files.len > 1 and not write_in_place and not check:
        print("error: several files given; use -w to rewrite them or --check to verify them")
        return 2
    mut changed = 0
    mut failed = 0
    mut fi = 0
    while fi < files.len:
        mut path = files.get(fi)
        mut src2 = read_file(path)
        if src2 == "" and not file_exists(path):
            print("error: cannot read " + path)
            failed = failed + 1
            fi = fi + 1
            continue
        mut r2 = tf_format(src2, path, width, sort_imports)
        if not r2.ok:
            print("error: " + path + ": " + r2.err)
            if debug: _tr_print_raw(r2.alt)
            failed = failed + 1
            fi = fi + 1
            continue
        if r2.text != src2:
            changed = changed + 1
            if check:
                print("would reformat " + path)
            elif write_in_place:
                write_file(path, r2.text)
                print("formatted " + path)
        if not check and not write_in_place:
            _tr_print_raw(r2.text)
        fi = fi + 1
    if check:
        print(changed.to_str() + " file(s) would be reformatted, " + (files.len - changed - failed).to_str() + " already formatted")
    if failed > 0: return 2
    if check and changed > 0: return 1
    return 0
