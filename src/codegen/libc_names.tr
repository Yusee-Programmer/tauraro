# codegen.libc_names -- identifiers that the generated C translation unit already
# declares through the libc / POSIX / pthread / socket headers that tauraro_rt.h pulls in
# (functions and function-like macros). A user `def` with one of these names would be
# emitted under that exact C name and fail with "conflicting types for 'brk'" (bug log
# #19), so codegen emits such free functions as `_tr_fn_<name>` (the same escape already
# used for C keywords). Generated from the preprocessed output of a generated program
# (gcc -E -dD, glibc/Linux); over-approximating is harmless -- the prefix is invisible
# to Tauraro code. Extern "C" and @export functions always keep their exact name.

pub def libc_fn_names() -> str:
    return " _dl_find_object _dl_mcount_wrapper_check _exit _longjmp _setjmp _tolower _toupper a64l abort abs accept accept4 access acct acos acosf acosf128 acosf32 acosf32x acosf64 acosf64x acosh acoshf acoshf128 acoshf32 acoshf32x acoshf64 acoshf64x acoshl acosl acospi acospif acospif128 acospif32 acospif32x acospif64 acospif64x acospil adjtime alarm aligned aligned_alloc alloca alphasort alphasort64 arc4random arc4random_buf arc4random_uniform asctime asctime_r asin asinf asinf128 asinf32 asinf32x asinf64 asinf64x asinh asinhf asinhf128 asinhf32 asinhf32x asinhf64 asinhf64x asinhl asinl asinpi asinpif asinpif128 asinpif32 asinpif32x asinpif64 asinpif64x asinpil asprintf at_quick_exit atan atan2 atan2f atan2f128 atan2f32 atan2f32x atan2f64 atan2f64x atan2l atan2pi atan2pif atan2pif128 atan2pif32 atan2pif32x atan2pif64 atan2pif64x atan2pil atanf atanf128 atanf32 atanf32x atanf64 atanf64x atanh atanhf atanhf128 atanhf32 atanhf32x atanhf64 atanhf64x atanhl atanl atanpi atanpif atanpif128 atanpif32 atanpif32x atanpif64 atanpif64x atanpil atexit atof atoi atol atoll atomic_compare_exchange_strong atomic_compare_exchange_strong_explicit atomic_compare_exchange_weak atomic_compare_exchange_weak_explicit atomic_exchange atomic_exchange_explicit atomic_fetch_add atomic_fetch_add_explicit atomic_fetch_and atomic_fetch_and_explicit atomic_fetch_or atomic_fetch_or_explicit atomic_fetch_sub atomic_fetch_sub_explicit atomic_fetch_xor atomic_fetch_xor_explicit atomic_flag_clear atomic_flag_clear_explicit atomic_flag_test_and_set atomic_flag_test_and_set_explicit atomic_init atomic_is_lock_free atomic_load atomic_load_explicit atomic_signal_fence atomic_store atomic_store_explicit atomic_thread_fence basename bcmp bcopy be16toh be32toh be64toh bind bindresvport bindresvport6 brk bsearch bzero call_once calloc canonicalize canonicalize_file_name canonicalizef canonicalizef128 canonicalizef32 canonicalizef32x canonicalizef64 canonicalizef64x canonicalizel cbrt cbrtf cbrtf128 cbrtf3