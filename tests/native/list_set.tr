def main():
    mut a = [10, 20, 30]
    a.set(1, 99)
    a.set(2, a.get(0) + 5)
    mut i = 0
    while i < a.len:
        print(a.get(i))
        i = i + 1

    mut s = ["x", "y", "z"]
    s.set(0, "AA")
    print(s.get(0))
    print(s.get(1))

    mut f = [1.5, 2.5]
    f.set(1, 9.25)
    print(f.get(1))
