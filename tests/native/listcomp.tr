# native≡c / llvm≡c differential corpus: list comprehensions (map, filter, range source).
def main():
    mut xs = [1, 2, 3, 4, 5]
    mut doubled = [x * 2 for x in xs]
    print(doubled[0])            # 2
    print(doubled[4])            # 10
    print(len(doubled))          # 5
    mut evens = [x for x in xs if x % 2 == 0]
    print(len(evens))            # 2
    print(evens[0])              # 2
    print(evens[1])              # 4
    mut strs = ["a", "bb", "ccc"]
    mut lens = [len(s) for s in strs]
    print(lens[0])               # 1
    print(lens[2])               # 3
    mut kept = [s for s in strs if len(s) >= 2]
    print(len(kept))             # 2
