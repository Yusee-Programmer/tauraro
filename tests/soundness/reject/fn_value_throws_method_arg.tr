# EXPECT: [F-4]
# Same rule for method arguments.

class Runner:
    pub n: int

extend Runner:
    pub def go(self, op: def(int) throws str -> int) -> int:
        r = op(self.n)
        if r.is_err:
            return -1
        return r.ok

def plain(v: int) -> int:
    return v

def main():
    mut r = Runner()
    r.n = 1
    print(r.go(plain))
