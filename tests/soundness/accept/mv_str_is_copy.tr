# str is a Copy type under --strict: passing, appending, binding and storing
# wrapping a str does not consume it.
enum Msg:
    Text(body: str)
    Quit
def take(s: str) -> int:
    return len(s)
def main():
    mut s = "hello"
    mut names: List[str] = []
    names.append(s)
    mut t = s
    mut n = take(s)
    mut m = Msg.Text(s)
    mut o = Some(s)
    mut ch: Chan[str] = Chan.init(4)
    ch.send(s)
    ch.send(s + "!")
    ch.close()
    mut got: List[str] = []
    for v in ch:
        got.append(v)
    if len(got) != 2 or got.get(0) != "hello" or got.get(1) != "hello!":
        raise("bad chan")
    print(s)
    print(t)
    print(f"{s} {n}")
    if len(names) != 1 or n != 5:
        raise("bad")
