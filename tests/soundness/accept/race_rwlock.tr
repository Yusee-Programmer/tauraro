# EXPECT: pass
# Concurrency soundness: safe pattern (run under TSan during development).
def reader(rw: RwLock[int], out: Atomic[int]) -> void:
    mut v = rw.read()
    rw.read_unlock()
    out.add(v)
def writer(rw: RwLock[int]) -> void:
    mut old = rw.write()
    rw.write_set(old + 1)
async def main():
    mut rw: RwLock[int] = RwLock.init(10)
    mut out: Atomic[int] = Atomic.new(0)
    task_group:
        spawn reader(rw, out)
        spawn writer(rw)
        spawn reader(rw, out)
        spawn writer(rw)
    mut f = rw.read()
    rw.read_unlock()
    assert_eq(f, 12)
