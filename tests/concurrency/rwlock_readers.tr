# Concurrency corpus — RwLock: concurrent readers and one writer. Readers must always observe
# a value the writer actually stored (never a torn / uninitialised one) and the final value is the
# writer's last store.
def reader(rw: RwLock[int], bad: Atomic[int]) -> void:
    mut i = 0
    while i < 400:
        mut v = rw.read()
        rw.read_unlock()
        if v < 0 or v > 100: bad.add(1)
        i = i + 1

def writer(rw: RwLock[int]) -> void:
    mut i = 1
    while i <= 100:
        mut old = rw.write()
        rw.write_set(i)
        i = i + 1

async def main():
    mut rw: RwLock[int] = RwLock.init(0)
    mut bad: Atomic[int] = Atomic.new(0)
    task_group:
        spawn reader(rw, bad)
        spawn reader(rw, bad)
        spawn reader(rw, bad)
        spawn writer(rw)
    mut last = rw.read()
    rw.read_unlock()
    mut msg = "rwlock_readers last=" + last.to_str() + " bad=" + bad.load().to_str()
    if last == 100 and bad.load() == 0: print("OK " + msg)
    else: print("FAIL " + msg)
