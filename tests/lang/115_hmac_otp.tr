# tests/lang/115_hmac_otp.tr
# Binary-safe HMAC (std.crypto.hmac: SHA-1/256/384/512, RFC 2202/4231 vectors,
# cross-checked with Python hmac) and HOTP/TOTP (std.crypto.otp: RFC 4226 Appendix D,
# RFC 6238 Appendix B, Base32 secrets, windows, provisioning URI).

from std.test import TestRunner
from std.crypto.hmac import Hmac
from std.crypto.otp import Hotp, Totp, Otp
from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

def rep(b: int, n: int) -> str:
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, b)
        i = i + 1
    return CryptoBytes.wrap(p, n)

def main():
    mut t = TestRunner.init("115_hmac_otp")
    t.section("HMAC (RFC 2202 / 4231 test cases)")

    t.assert_eq_str(Hmac.compute_hex("sha1", rep(11, 20), "Hi There"), "b617318655057264e28bc0b6fb378c8ef146be00", "sha1 rfc case 1 (key 0x0b*20, 'Hi There')")
    t.assert_eq_str(Hmac.compute_hex("sha1", "Jefe", "what do ya want for nothing?"), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79", "sha1 rfc case 2 ('Jefe')")
    t.assert_eq_str(Hmac.compute_hex("sha1", rep(170, 20), rep(221, 50)), "125d7342b9ac11cd91a39af48aa17b4f63f175d3", "sha1 rfc case 3 (0xaa*20, 0xdd*50)")
    t.assert_eq_str(Hmac.compute_hex("sha1", rep(170, 131), "Test Using Larger Than Block-Size Key - Hash Key First"), "90d0dace1c1bdc957339307803160335bde6df2b", "sha1 rfc case 6 (key 0xaa*131 > block)")
    t.assert_eq_str(Hmac.compute_hex("sha1", "", ""), "fbdb1d1b18aa6c08324b7d64b71fb76370690e1d", "sha1 empty key and message")
    t.assert_eq_str(Hmac.compute_hex("sha1", "k", Hex.decode("0000000000000001")), "fd612f8235cd3b17f92ef6ddf93f8fd9e09b666b", "sha1 NUL-containing message (HOTP-style)")
    t.assert_eq_str(Hmac.compute_hex("sha256", rep(11, 20), "Hi There"), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", "sha256 rfc case 1 (key 0x0b*20, 'Hi There')")
    t.assert_eq_str(Hmac.compute_hex("sha256", "Jefe", "what do ya want for nothing?"), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", "sha256 rfc case 2 ('Jefe')")
    t.assert_eq_str(Hmac.compute_hex("sha256", rep(170, 20), rep(221, 50)), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe", "sha256 rfc case 3 (0xaa*20, 0xdd*50)")
    t.assert_eq_str(Hmac.compute_hex("sha256", rep(170, 131), "Test Using Larger Than Block-Size Key - Hash Key First"), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", "sha256 rfc case 6 (key 0xaa*131 > block)")
    t.assert_eq_str(Hmac.compute_hex("sha256", "", ""), "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad", "sha256 empty key and message")
    t.assert_eq_str(Hmac.compute_hex("sha256", "k", Hex.decode("0000000000000001")), "a02d18027969b5ed2d51bddf6f185dc835dc4a084f4fc10aa49e02d529d8f592", "sha256 NUL-containing message (HOTP-style)")
    t.assert_eq_str(Hmac.compute_hex("sha384", rep(11, 20), "Hi There"), "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6", "sha384 rfc case 1 (key 0x0b*20, 'Hi There')")
    t.assert_eq_str(Hmac.compute_hex("sha384", "Jefe", "what do ya want for nothing?"), "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649", "sha384 rfc case 2 ('Jefe')")
    t.assert_eq_str(Hmac.compute_hex("sha384", rep(170, 20), rep(221, 50)), "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27", "sha384 rfc case 3 (0xaa*20, 0xdd*50)")
    t.assert_eq_str(Hmac.compute_hex("sha384", rep(170, 131), "Test Using Larger Than Block-Size Key - Hash Key First"), "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952", "sha384 rfc case 6 (key 0xaa*131 > block)")
    t.assert_eq_str(Hmac.compute_hex("sha384", "", ""), "6c1f2ee938fad2e24bd91298474382ca218c75db3d83e114b3d4367776d14d3551289e75e8209cd4b792302840234adc", "sha384 empty key and message")
    t.assert_eq_str(Hmac.compute_hex("sha384", "k", Hex.decode("0000000000000001")), "042aec2121903cf222ab498dea7f4bfc71127b0038b481e10513c1a16ffdd7726884381de1b1737c8ea2d4e1a53a0e6e", "sha384 NUL-containing message (HOTP-style)")
    t.assert_eq_str(Hmac.compute_hex("sha512", rep(11, 20), "Hi There"), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854", "sha512 rfc case 1 (key 0x0b*20, 'Hi There')")
    t.assert_eq_str(Hmac.compute_hex("sha512", "Jefe", "what do ya want for nothing?"), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737", "sha512 rfc case 2 ('Jefe')")
    t.assert_eq_str(Hmac.compute_hex("sha512", rep(170, 20), rep(221, 50)), "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb", "sha512 rfc case 3 (0xaa*20, 0xdd*50)")
    t.assert_eq_str(Hmac.compute_hex("sha512", rep(170, 131), "Test Using Larger Than Block-Size Key - Hash Key First"), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598", "sha512 rfc case 6 (key 0xaa*131 > block)")
    t.assert_eq_str(Hmac.compute_hex("sha512", "", ""), "b936cee86c9f87aa5d3c6f2e84cb5a4239a5fe50480a6ec66b70ab5b1f4ac6730c6c515421b327ec1d69402e53dfb49ad7381eb067b338fd7b0cb22247225d47", "sha512 empty key and message")
    t.assert_eq_str(Hmac.compute_hex("sha512", "k", Hex.decode("0000000000000001")), "8a5a663d0467878c00d8be885c6524edac0137f6d93dde04d24278ba564a01a86f242e206145354a56bff7d2bb8e4bd8bb99beae68ca49a05bb2673dd6651f47", "sha512 NUL-containing message (HOTP-style)")
    t.assert_eq_str(Hmac.compute_hex("md5", "k", "m"), "", "unknown algorithm gives empty")
    t.assert_eq_int(Hmac.compute("sha256", "k", "m").len(), 32, "raw tag length sha256")
    t.assert_eq_int(Hmac.compute("sha512", "k", "m").len(), 64, "raw tag length sha512")
    t.assert_eq_int(Hmac.digest_size("sha384"), 48, "digest_size sha384")
    t.assert_eq_str(Hmac.compute_hex("sha256", "Jefe", "what do ya want for nothing?"), Hmac.sha256_str("Jefe", "what do ya want for nothing?"), "agrees with the legacy Hmac.sha256_str")
    mut good = Hmac.compute("sha256", "key", "message")
    t.assert_true(Hmac.verify("sha256", "key", "message", good), "verify accepts the right tag")
    t.assert_true(not Hmac.verify("sha256", "key", "messagf", good), "verify rejects other message")
    t.assert_true(not Hmac.verify("sha256", "kez", "message", good), "verify rejects other key")
    t.assert_true(not Hmac.verify("sha256", "key", "message", CryptoBytes.slice(good, 0, 31)), "verify rejects truncated tag")
    t.assert_true(not Hmac.verify("nope", "key", "message", good), "verify rejects unknown algorithm")

    t.section("HOTP RFC 4226 Appendix D")
    mut k1 = "12345678901234567890"
    t.assert_eq_str(Hex.encode(Hmac.compute("sha1", k1, Hex.decode("0000000000000000"))), "cc93cf18508d94934c64b65d8ba7667fb7cde4b0", "intermediate HMAC for counter 0")

    t.assert_eq_str(Hotp.generate(k1, 0, 6, "sha1"), "755224", "HOTP counter 0")
    t.assert_eq_str(Hotp.generate(k1, 1, 6, "sha1"), "287082", "HOTP counter 1")
    t.assert_eq_str(Hotp.generate(k1, 2, 6, "sha1"), "359152", "HOTP counter 2")
    t.assert_eq_str(Hotp.generate(k1, 3, 6, "sha1"), "969429", "HOTP counter 3")
    t.assert_eq_str(Hotp.generate(k1, 4, 6, "sha1"), "338314", "HOTP counter 4")
    t.assert_eq_str(Hotp.generate(k1, 5, 6, "sha1"), "254676", "HOTP counter 5")
    t.assert_eq_str(Hotp.generate(k1, 6, 6, "sha1"), "287922", "HOTP counter 6")
    t.assert_eq_str(Hotp.generate(k1, 7, 6, "sha1"), "162583", "HOTP counter 7")
    t.assert_eq_str(Hotp.generate(k1, 8, 6, "sha1"), "399871", "HOTP counter 8")
    t.assert_eq_str(Hotp.generate(k1, 9, 6, "sha1"), "520489", "HOTP counter 9")
    t.assert_eq_str(Hotp.generate6(k1, 9), "520489", "generate6")
    t.assert_eq_str(Hotp.generate(k1, 0, 8, "sha1"), "84755224", "8 digits")
    t.assert_eq_str(Hotp.generate(k1, 0, 10, "sha1"), "1284755224", "10 digits")
    t.assert_eq_str(Hotp.generate(k1, -1, 6, "sha1"), "", "negative counter rejected")
    t.assert_eq_str(Hotp.generate(k1, 0, 5, "sha1"), "", "5 digits rejected")
    t.assert_eq_str(Hotp.generate(k1, 0, 11, "sha1"), "", "11 digits rejected")
    t.assert_eq_str(Hotp.generate(k1, 0, 6, "md5"), "", "unknown alg rejected")
    t.assert_eq_str(Hotp.generate("", 0, 6, "sha1"), "", "empty secret rejected")
    t.assert_eq_int(Hotp.verify(k1, "287922", 3, 5, 6, "sha1"), 6, "verify finds counter 6 within look-ahead")
    t.assert_eq_int(Hotp.verify(k1, "287922", 3, 2, 6, "sha1"), -1, "verify outside look-ahead")
    t.assert_eq_int(Hotp.verify(k1, "000000", 0, 3, 6, "sha1"), -1, "wrong code")

    t.section("TOTP RFC 6238 Appendix B (8 digits, period 30)")
    mut k256 = "12345678901234567890123456789012"
    mut k512 = "1234567890123456789012345678901234567890123456789012345678901234"
    t.assert_eq_str(Totp.generate(k1, 59, 30, 8, "sha1"), "94287082", "TOTP sha1 t=59")
    t.assert_eq_str(Totp.generate(k256, 59, 30, 8, "sha256"), "46119246", "TOTP sha256 t=59")
    t.assert_eq_str(Totp.generate(k512, 59, 30, 8, "sha512"), "90693936", "TOTP sha512 t=59")
    t.assert_eq_str(Totp.generate(k1, 1111111109, 30, 8, "sha1"), "07081804", "TOTP sha1 t=1111111109")
    t.assert_eq_str(Totp.generate(k256, 1111111109, 30, 8, "sha256"), "68084774", "TOTP sha256 t=1111111109")
    t.assert_eq_str(Totp.generate(k512, 1111111109, 30, 8, "sha512"), "25091201", "TOTP sha512 t=1111111109")
    t.assert_eq_str(Totp.generate(k1, 1111111111, 30, 8, "sha1"), "14050471", "TOTP sha1 t=1111111111")
    t.assert_eq_str(Totp.generate(k256, 1111111111, 30, 8, "sha256"), "67062674", "TOTP sha256 t=1111111111")
    t.assert_eq_str(Totp.generate(k512, 1111111111, 30, 8, "sha512"), "99943326", "TOTP sha512 t=1111111111")
    t.assert_eq_str(Totp.generate(k1, 1234567890, 30, 8, "sha1"), "89005924", "TOTP sha1 t=1234567890")
    t.assert_eq_str(Totp.generate(k256, 1234567890, 30, 8, "sha256"), "91819424", "TOTP sha256 t=1234567890")
    t.assert_eq_str(Totp.generate(k512, 1234567890, 30, 8, "sha512"), "93441116", "TOTP sha512 t=1234567890")
    t.assert_eq_str(Totp.generate(k1, 2000000000, 30, 8, "sha1"), "69279037", "TOTP sha1 t=2000000000")
    t.assert_eq_str(Totp.generate(k256, 2000000000, 30, 8, "sha256"), "90698825", "TOTP sha256 t=2000000000")
    t.assert_eq_str(Totp.generate(k512, 2000000000, 30, 8, "sha512"), "38618901", "TOTP sha512 t=2000000000")
    t.assert_eq_str(Totp.generate(k1, 20000000000, 30, 8, "sha1"), "65353130", "TOTP sha1 t=20000000000")
    t.assert_eq_str(Totp.generate(k256, 20000000000, 30, 8, "sha256"), "77737706", "TOTP sha256 t=20000000000")
    t.assert_eq_str(Totp.generate(k512, 20000000000, 30, 8, "sha512"), "47863826", "TOTP sha512 t=20000000000")
    t.assert_eq_int(Totp.step(59, 30), 1, "step")
    t.assert_eq_str(Totp.generate(k1, 59, 0, 6, "sha1"), "", "period 0 rejected")
    t.section("Base32 secrets")
    mut b32 = "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"
    t.assert_eq_str(Otp.decode_secret(b32), k1, "decode_secret")
    t.assert_eq_str(Otp.decode_secret("gezdgnbv gy3tqojq-GEZDGNBVGY3TQOJQ"), k1, "lower case, spaces and dashes tolerated")
    t.assert_eq_str(Otp.decode_secret("GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ===="), k1, "padding tolerated")
    t.assert_eq_str(Otp.decode_secret("not base32 !"), "", "invalid secret gives empty")
    t.assert_eq_str(Otp.encode_secret(k1), b32, "encode_secret")
    t.assert_eq_str(Totp.generate_b32(b32, 59, 30, 8, "sha1"), "94287082", "generate_b32")
    t.assert_eq_str(Totp.generate_b32(b32, 1111111109, 30, 6, "sha1"), "081804", "6-digit via Base32")
    t.assert_eq_str(Totp.generate_b32("!!!", 59, 30, 6, "sha1"), "", "bad Base32 secret")
    t.section("verify with a time window")
    mut c0 = Totp.generate(k1, 1000000, 30, 6, "sha1")
    mut cprev = Totp.generate(k1, 1000000 - 30, 30, 6, "sha1")
    mut cnext = Totp.generate(k1, 1000000 + 30, 30, 6, "sha1")
    mut cold = Totp.generate(k1, 1000000 - 90, 30, 6, "sha1")
    t.assert_eq_int(Totp.verify(k1, c0, 1000000, 0, 30, 6, "sha1"), 1000000 / 30, "current step, window 0")
    t.assert_eq_int(Totp.verify(k1, cprev, 1000000, 0, 30, 6, "sha1"), -1, "previous step rejected at window 0")
    t.assert_eq_int(Totp.verify(k1, cprev, 1000000, 1, 30, 6, "sha1"), 1000000 / 30 - 1, "previous step accepted at window 1")
    t.assert_eq_int(Totp.verify(k1, cnext, 1000000, 1, 30, 6, "sha1"), 1000000 / 30 + 1, "next step accepted at window 1")
    t.assert_eq_int(Totp.verify(k1, cold, 1000000, 1, 30, 6, "sha1"), -1, "3 steps old rejected at window 1")
    t.assert_eq_int(Totp.verify_b32(b32, c0, 1000000, 1), 1000000 / 30, "verify_b32")
    t.assert_eq_int(Totp.verify(k1, "12345", 1000000, 1, 30, 6, "sha1"), -1, "wrong-length code")
    t.assert_eq_int(Totp.verify(k1, c0, -5, 1, 30, 6, "sha1"), -1, "negative time rejected")
    t.assert_eq_int(Totp.verify(k1, c0, 5, 3, 30, 6, "sha1") >= -1, 1, "window below step 0 does not crash")
    t.section("provisioning URI and generated secrets")
    t.assert_eq_str(Otp.provisioning_uri("totp", "Example Co", "alice@example.com", "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", "sha1", 6, 30, 0), "otpauth://totp/Example%20Co:alice%40example.com?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&issuer=Example%20Co&algorithm=SHA1&digits=6&period=30", "totp URI")
    t.assert_eq_str(Otp.provisioning_uri("hotp", "", "bob", "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", "sha256", 8, 30, 5), "otpauth://hotp/bob?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA256&digits=8&counter=5", "hotp URI, no issuer")
    t.assert_eq_str(Otp.provisioning_uri("x", "i", "a", "S", "sha1", 6, 30, 0), "", "unknown kind")
    mut gs = Otp.generate_secret_b32(20)
    t.assert_eq_int(gs.len(), 32, "20 bytes -> 32 base32 chars")
    t.assert_eq_int(Otp.decode_secret(gs).len(), 20, "generated secret round-trips")
    t.assert_eq_int(Otp.generate_secret(16).len(), 16, "raw secret length")
    t.assert_true(gs != Otp.generate_secret_b32(20), "generated secrets differ")
    mut nowc = Totp.now(gs)
    t.assert_eq_int(nowc.len(), 6, "Totp.now yields 6 digits")
    t.assert_true(Totp.verify_b32(gs, nowc, Totp.unix_now(), 1) >= 0, "Totp.now verifies against the clock")
    t.assert_true(Totp.unix_now() > 1700000000, "unix_now is a plausible epoch time")
    t.summary()
