# tests/lang/171_fmt_modes.tr
# `tauraroc fmt` — CLI modes: --check (exit status), -w, stdin, --width wrapping,
# --sort-imports, directory arguments, and refusal to touch unparsable input.
# Skips (without failing) when the compiler binary is not in the working directory.

from std.test import TestRunner
from std.core.io import read_file, write_file, file_exists
from std.sys.process import Process
from std.sys.platform import Platform
from std.sys.fs import Fs

def tc_bin() -> str:
    if Platform.is_windows():
        return ".\\tauraroc.exe"
    return "./tauraroc"

def tc_present() -> bool:
    if Platform.is_windows():
        return file_exists("tauraroc.exe")
    return file_exists("tauraroc")

def norm(s: str) -> str:
    return s.replace("\r", "")

# Run `fmt <args>`; returns the process status (0 = success). Output lands in _t171_out.txt.
def run_status(args: str) -> int:
    return Process.system(tc_bin() + " fmt " + args + " > _t171_out.txt 2>&1")

def out_text() -> str:
    return norm(read_file("_t171_out.txt"))

def main():
    mut t = TestRunner.init("171_fmt_modes")
    if not tc_present():
        t.skip("tauraroc binary not found in the working directory")
        t.summary()
        return

    t.section("--check")
    write_file("_t171_a.tr", "def f():\n    return 1\n")
    t.assert_eq_int(run_status("--check _t171_a.tr"), 0, "formatted file: --check succeeds")
    write_file("_t171_b.tr", "def f( ):\n    return   1\n")
    t.assert_true(run_status("--check _t171_b.tr") != 0, "unformatted file: --check fails")
    t.assert_contains(out_text(), "would reformat _t171_b.tr", "--check names the file")
    t.assert_eq_str(norm(read_file("_t171_b.tr")), "def f( ):\n    return   1\n", "--check never writes")

    t.section("-w rewrites in place, only when needed")
    t.assert_eq_int(run_status("-w _t171_b.tr"), 0, "-w succeeds")
    t.assert_eq_str(norm(read_file("_t171_b.tr")), "def f():\n    return 1\n", "file rewritten")
    t.assert_eq_int(run_status("--check _t171_b.tr"), 0, "rewritten file passes --check")

    t.section("stdin")
    write_file("_t171_in.txt", "x=1\ny=f( 2 )\n")
    t.assert_eq_int(Process.system(tc_bin() + " fmt - < _t171_in.txt > _t171_out.txt 2>&1"), 0, "stdin mode succeeds")
    t.assert_eq_str(out_text(), "x = 1\ny = f(2)\n", "stdin is formatted to stdout")
    t.assert_true(Process.system(tc_bin() + " fmt --check - < _t171_in.txt > _t171_out.txt 2>&1") != 0, "stdin --check fails on unformatted input")

    t.section("--width wrapping")
    write_file("_t171_w.tr", "def f():\n    result = compute_something(first_argument, second_argument, third_argument)\n")
    t.assert_eq_int(run_status("_t171_w.tr"), 0, "default width leaves a 80-col line alone")
    t.assert_eq_str(out_text(), "def f():\n    result = compute_something(first_argument, second_argument, third_argument)\n", "line shorter than 100 untouched")
    t.assert_eq_int(run_status("--width 60 _t171_w.tr"), 0, "--width 60 succeeds")
    t.assert_eq_str(out_text(), "def f():\n    result = compute_something(\n        first_argument, second_argument, third_argument\n    )\n", "wrapped at the call brackets")
    t.assert_eq_int(run_status("--width=40 _t171_w.tr"), 0, "--width=40 succeeds")
    t.assert_eq_str(out_text(), "def f():\n    result = compute_something(\n        first_argument,\n        second_argument,\n        third_argument\n    )\n", "one argument per line when the body does not fit")
    # wrapped output is a fixed point
    write_file("_t171_w2.tr", out_text())
    t.assert_eq_int(run_status("--width=40 --check _t171_w2.tr"), 0, "wrapped output is stable")
    write_file("_t171_s.tr", "def f():\n    x = \"a very long string literal that can never be wrapped by any bracket rule at all\"\n")
    t.assert_eq_int(run_status("--width 40 _t171_s.tr"), 0, "unwrappable line accepted")
    t.assert_eq_str(out_text(), "def f():\n    x = \"a very long string literal that can never be wrapped by any bracket rule at all\"\n", "unwrappable line left as is")

    t.section("--sort-imports")
    write_file("_t171_i.tr", "from std.b import B\nfrom std.a import A\n\nfrom std.z import Z\nfrom std.c import C\n\ndef main():\n    pass\n")
    t.assert_eq_int(run_status("--sort-imports _t171_i.tr"), 0, "sort succeeds")
    t.assert_eq_str(out_text(), "from std.a import A\nfrom std.b import B\n\nfrom std.c import C\nfrom std.z import Z\n\ndef main():\n    pass\n", "runs sorted, blank-line groups kept apart")
    t.assert_eq_int(run_status("_t171_i.tr"), 0, "without the flag")
    t.assert_starts_with(out_text(), "from std.b import B\nfrom std.a import A\n", "import order untouched by default")

    t.section("errors")
    write_file("_t171_bad.tr", "def f(:\n    x = = 1\n")
    t.assert_true(run_status("_t171_bad.tr") != 0, "unparsable input fails")
    t.assert_contains(out_text(), "not formatting", "reports that it refused")
    t.assert_eq_str(norm(read_file("_t171_bad.tr")), "def f(:\n    x = = 1\n", "unparsable file untouched even with -w")
    t.assert_true(run_status("-w _t171_bad.tr") != 0, "-w on unparsable input fails")
    t.assert_eq_str(norm(read_file("_t171_bad.tr")), "def f(:\n    x = = 1\n", "file still untouched")
    t.assert_true(run_status("--no-such-flag _t171_a.tr") != 0, "unknown option rejected")
    t.assert_true(run_status("_t171_missing_file.tr") != 0, "missing file rejected")

    Fs.delete("_t171_a.tr")
    Fs.delete("_t171_b.tr")
    Fs.delete("_t171_in.txt")
    Fs.delete("_t171_w.tr")
    Fs.delete("_t171_w2.tr")
    Fs.delete("_t171_s.tr")
    Fs.delete("_t171_i.tr")
    Fs.delete("_t171_bad.tr")
    Fs.delete("_t171_out.txt")
    t.summary()
