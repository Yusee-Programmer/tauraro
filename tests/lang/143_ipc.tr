# tests/lang/143_ipc.tr
# std.io.ipc — message-framed channels over Unix domain sockets: socket pairs,
# framing edge cases (binary, empty, partial frames, size limits, peer close),
# a fork-based server/client conversation, stale socket handling, and timeouts.
# Needs POSIX (Windows named pipes are compile-checked only): self-skips elsewhere.

from std.test import TestRunner
from std.io.ipc import IpcServer, IpcChannel, IpcMessage, Ipc
from std.sys.env import Env
from std.sys.fs import Fs
from std.sys.process import Process
from std.sys.platform import Platform
from std.core.string import StringBuilder

extern "C":
    def _tr_sys_fork() -> int
    def _tr_sys_waitpid(pid: int, ms: int) -> int
    def _tr_sys_exit_now(code: int)
    def _tr_io_write(h: int, buf: Pointer[char], n: int) -> int

def tmp_path(name: str) -> str:
    mut e = Env.init()
    mut d = e.get_var("TMPDIR")
    if d == "": d = e.get_var("TEMP")
    if d == "": d = e.get_var("TMP")
    if d == "": d = "/tmp"
    return d + "/tau_ipc_" + f"{Process.get_pid()}" + "_" + name

def raw_write(c: IpcChannel, s: str):
    _tr_io_write(c.handle, s as Pointer[char], s.len())

# A frame header (u32 big-endian length) followed by `body` — built with
# StringBuilder because `str + str` is not NUL-safe (bug log N1-1) and literals
# have no \x escapes (N1-2).
def frame_head(n: int, body: str) -> str:
    mut sb = StringBuilder.init(16)
    sb.append_char((n / 16777216) % 256)
    sb.append_char((n / 65536) % 256)
    sb.append_char((n / 256) % 256)
    sb.append_char(n % 256)
    sb.append(body)
    mut out = sb.to_owned()
    sb.free()
    return out

def main():
    mut t = TestRunner.init("143_ipc")
    if not Platform.is_posix() or Platform.is_wasm() or not IpcChannel.supported():
        t.skip("IPC channel tests need POSIX Unix-domain sockets")
        t.summary()
        return

    t.section("default_address")
    mut da = Ipc.default_address("demoapp")
    t.assert_contains(da, "demoapp", "address contains the app name")
    t.assert_ends_with(da, ".sock", "POSIX address ends with .sock")
    t.assert_starts_with(da, "/", "POSIX address is absolute")

    t.section("socket pair: framing")
    mut a = IpcChannel.pair()
    t.assert_true(a.is_open(), "pair() opens")
    mut b = a.take_peer()
    t.assert_true(b.is_open(), "take_peer() opens the other end")
    mut nobody = a.take_peer()
    t.assert_false(nobody.is_open(), "the peer can only be taken once")
    t.assert_true(a.send("hello"), "send")
    mut m1 = b.recv(2000)
    t.assert_true(m1.ok(), "recv ok")
    t.assert_eq_str(m1.data, "hello", "payload")
    t.assert_true(b.send("reply"), "send back")
    t.assert_eq_str(a.recv(2000).data, "reply", "reply payload")
    t.assert_true(a.send(""), "empty message is legal")
    mut m2 = b.recv(2000)
    t.assert_true(m2.ok(), "empty message received")
    t.assert_eq_int(m2.data.len(), 0, "and it is empty")
    t.assert_true(a.send("x\0y\0\0z"), "binary payload")
    mut m3 = b.recv(2000)
    t.assert_eq_int(m3.data.len(), 6, "binary length preserved")
    t.assert_eq_str(m3.data.slice(5, 6), "z", "bytes after NULs intact")
    mut i = 0
    mut order_ok = true
    while i < 20:
        a.send("m" + f"{i}")
        i = i + 1
    i = 0
    while i < 20:
        mut mm = b.recv(2000)
        if not mm.ok() or mm.data != "m" + f"{i}": order_ok = false
        i = i + 1
    t.assert_true(order_ok, "20 queued messages arrive whole and in order")
    mut big = "0123456789abcdef"
    mut k = 0
    while k < 12:
        big = big + big            # 16 * 2^12 = 64 KiB
        k = k + 1
    t.assert_eq_int(big.len(), 65536, "built a 64 KiB payload")
    t.assert_true(a.send(big), "send 64 KiB")
    mut mb = b.recv(5000)
    t.assert_true(mb.ok() and mb.data == big, "64 KiB round trips intact")

    t.section("timeouts keep partial frames")
    mut idle = a.recv(40)
    t.assert_true(idle.is_timeout(), "recv on an idle channel times out")
    t.assert_eq_int(idle.status, 1, "timeout status")
    raw_write(a, frame_head(5, "ab"))    # header says 5 bytes, only 2 sent
    mut part = b.recv(40)
    t.assert_true(part.is_timeout(), "incomplete frame -> timeout, not an error")
    raw_write(a, "cde")
    mut done = b.recv(2000)
    t.assert_true(done.ok(), "frame completes on the next call")
    t.assert_eq_str(done.data, "abcde", "partial progress was kept")

    t.section("size limits")
    a.set_max_message(10)
    t.assert_false(a.send("0123456789X"), "send over the limit refused")
    t.assert_eq_int(a.status, 4, "IPC_TOO_BIG status on send")
    t.assert_true(a.send("0123456789"), "send exactly at the limit")
    t.assert_eq_str(b.recv(2000).data, "0123456789", "at-limit message arrives")
    b.set_max_message(5)
    t.assert_true(a.send("123456"), "sender (limit 10) sends 6 bytes")
    mut tb = b.recv(2000)
    t.assert_eq_int(tb.status, 4, "receiver with limit 5 reports IPC_TOO_BIG")
    mut tb2 = b.recv(100)
    t.assert_eq_int(tb2.status, 4, "channel stays poisoned after a protocol violation")

    t.section("peer closing")
    mut c1 = IpcChannel.pair()
    mut c2 = c1.take_peer()
    c1.send("last")
    c1.close()
    t.assert_false(c1.is_open(), "closed")
    t.assert_false(c1.send("x"), "send on a closed channel fails")
    mut lastm = c2.recv(2000)
    t.assert_eq_str(lastm.data, "last", "message sent before close is delivered")
    mut closed = c2.recv(2000)
    t.assert_true(closed.is_closed(), "then the clean close is reported")
    t.assert_eq_int(closed.status, 2, "IPC_CLOSED status")
    mut d1 = IpcChannel.pair()
    mut d2 = d1.take_peer()
    raw_write(d1, frame_head(100, "abc"))   # promises 100 bytes, delivers 3, then dies
    d1.close()
    mut trunc = d2.recv(2000)
    t.assert_eq_int(trunc.status, 3, "death mid-frame is an error, not a clean close")
    t.assert_true(trunc.error.len() > 0, "with a message")
    a.close()
    b.close()
    c2.close()
    d2.close()

    t.section("server / client over a socket path (fork)")
    mut path = tmp_path("srv.sock")
    Fs.delete(path)
    mut late = IpcChannel.connect(path, 40)
    t.assert_false(late.is_open(), "connect to a missing server fails after the timeout")
    t.assert_true(late.error.len() > 0, "with an error message")
    mut pid = _tr_sys_fork()
    if pid == 0:
        # the client starts BEFORE the server listens: connect() must retry
        mut cc = IpcChannel.connect(path, 8000)
        if not cc.is_open(): _tr_sys_exit_now(10)
        mut n = 0
        while n < 3:
            cc.send("req" + f"{n}")
            mut rep = cc.recv(5000)
            if not rep.ok() or rep.data != "ECHO:req" + f"{n}": _tr_sys_exit_now(11)
            n = n + 1
        cc.send("bye")
        mut fin = cc.recv(5000)
        if not fin.ok() or fin.data != "bye!": _tr_sys_exit_now(12)
        _tr_sys_exit_now(0)
    Process.sleep_ms(150)
    mut srv = IpcServer.listen(path)
    t.assert_true(srv.is_open(), "listen")
    mut again = IpcServer.listen(path)
    t.assert_false(again.is_open(), "a second listen on a live address fails")
    mut conn = srv.accept(8000)
    t.assert_true(conn.is_open(), "accept")
    mut served = 0
    mut running = true
    while running:
        mut req = conn.recv(5000)
        if not req.ok():
            running = false
        elif req.data == "bye":
            conn.send("bye!")
            running = false
        else:
            conn.send("ECHO:" + req.data)
            served = served + 1
    t.assert_eq_int(served, 3, "server echoed three requests")
    t.assert_eq_int(_tr_sys_waitpid(pid, 10000), 0, "client process finished cleanly")
    # listen_replace probes the address by connecting; it must refuse a live one.
    # (Done after the conversation: the probe is a short-lived connection that the
    # live server sees in its accept queue and that closes immediately.)
    mut steal = IpcServer.listen_replace(path)
    t.assert_false(steal.is_open(), "listen_replace refuses to steal a live server's address")
    mut probe = srv.accept(1000)
    if probe.is_open():
        mut pm = probe.recv(1000)
        t.assert_true(pm.is_closed(), "the liveness probe closes without sending anything")
        probe.close()
    mut idle_accept = srv.accept(40)
    t.assert_false(idle_accept.is_open(), "accept with no client times out")
    t.assert_eq_int(idle_accept.status, 1, "accept timeout status")
    conn.close()
    srv.close()
    t.assert_false(Fs.is_file(path) , "close() removed the socket file")

    t.section("stale socket files")
    mut spath = tmp_path("stale.sock")
    Fs.delete(spath)
    mut spid = _tr_sys_fork()
    if spid == 0:
        mut dead = IpcServer.listen(spath)
        if not dead.is_open(): _tr_sys_exit_now(20)
        _tr_sys_exit_now(0)       # leaves the socket file behind (no close())
    t.assert_eq_int(_tr_sys_waitpid(spid, 10000), 0, "crashing server child exited")
    mut blocked = IpcServer.listen(spath)
    t.assert_false(blocked.is_open(), "listen on a stale path fails (EADDRINUSE)")
    mut replaced = IpcServer.listen_replace(spath)
    t.assert_true(replaced.is_open(), "listen_replace recovers a stale socket file")
    replaced.close()

    t.section("bad addresses")
    mut longp = "/tmp/" + "x".repeat(200) + ".sock"
    mut lp = IpcServer.listen(longp)
    t.assert_false(lp.is_open(), "over-long socket path rejected")
    mut ep = IpcServer.listen("")
    t.assert_false(ep.is_open(), "empty address rejected")
    mut cl = IpcServer.listen(tmp_path("closed.sock"))
    cl.close()
    mut after_close = cl.accept(10)
    t.assert_false(after_close.is_open(), "accept on a closed server fails")
    t.summary()
