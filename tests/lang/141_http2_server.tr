def run_suite(t: TestRunner, port: int, tls: int):
    shared ctl = Ctl()
    ctl.stop = Atomic.new(0)
    ctl.cancelled = Atomic.new(0)
    ctl.handled = Atomic.new(0)
    ctl.tls = tls
    ctl.port = port
    mut th = Thread.spawn(server_loop, ctl)
    Thread.sleep(300)
    if tls == 0:
        mut r1: Result[bool, str] = suite_h2c(t, port, ctl)
        t.assert_true(r1.is_ok, "h2c suite completed")
        if r1.is_err: print(r1.err)
    else:
        mut r2: Result[bool, str] = suite_tls(t, port)
        t.assert_true(r2.is_ok, "TLS suite completed")
        if r2.is_err: print(r2.err)
    ctl.stop.store(1)
    th.join()

def suite_h2c(t: TestRunner, port: int, ctl: Shared[Ctl]) throws str -> bool:
    test_client(t, port, ctl)?
    test_raw(t, port)?
    test_goaway(t, port, ctl)?
    return true

def suite_tls(t: TestRunner, port: int) throws str -> bool:
    test_https(t, port)?
    return true

def main():
    mut t = TestRunner.init("141_http2_server")
    run_suite(t, 19141, 0)
    run_suite(t, 19142, 1)
    t.summary()
