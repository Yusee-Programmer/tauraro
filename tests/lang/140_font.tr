def coverage(img: Image) -> float:
    mut sum = 0
    mut i = 3
    while i < img.width * img.height * 4:
        sum = sum + (img.pixels.get(i) as int)
        i = i + 4
    return (sum as float) / 255.0

def near(t: TestRunner, got: float, want: float, tol: float, label: str):
    mut d = got - want
    if d < 0.0: d = 0.0 - d
    t.assert_true(d <= want * tol, label + f" ({got} vs {want})")

def test_ttf(t: TestRunner) throws str:
    t.section("TrueType (glyf) font")
    mut f = Font.load(ttf_bytes())?
    t.assert_eq_int(f.units_per_em, 2048, "unitsPerEm")
    t.assert_eq_int(f.num_glyphs, 29, "glyph count")
    t.assert_eq_int(f.ascent, 1901, "ascent")
    t.assert_eq_int(f.descent, -483, "descent")
    t.assert_eq_str(f.family, "DejaVu Sans", "family name")
    t.assert_eq_str(f.postscript_name, "DejaVuSans", "PostScript name")
    t.assert_eq_int(f.outline_format(), FONT_TRUETYPE, "outline format")
    t.assert_true(f.has_kerning(), "has kerning")
    t.assert_true(f.has_ligatures(), "has ligatures")
    t.assert_eq_int(f.glyph_index(65), 5, "cmap A")
    t.assert_eq_int(f.glyph_index(0xE9), 17, "cmap e-acute")
    t.assert_eq_int(f.glyph_index(0x3A9), f.glyph_index(937), "cmap Omega")
    t.assert_true(f.glyph_index(0x3A9) > 0, "Omega mapped")
    t.assert_eq_int(f.glyph_index(0x4E2D), 0, "missing glyph is .notdef")
    t.assert_true(f.has_char(0x416), "has Zhe")
    t.assert_true(f.covers("AVo é"), "covers text")
    t.assert_false(f.covers("A中"), "does not cover CJK")
    t.assert_eq_int(f.glyph_advance(5), 1401, "advance A")
    t.assert_eq_int(f.glyph_advance(9), 2025, "advance W")
    t.assert_eq_int(f.kern(5, 8), -131, "kern A V (GPOS)")
    t.assert_eq_int(f.kern(7, f.glyph_index(97)), -339, "kern T a")
    t.assert_eq_int(f.kern(6, 15), 0, "no kern H o")
    mut m = f.glyph_metrics(6)
    t.assert_false(m.empty, "H has an outline")
    t.assert_eq_int(m.x_min, 201, "H xMin")
    t.assert_eq_int(m.y_min, 0, "H yMin")
    t.assert_eq_int(m.y_max, 1493, "H yMax")
    t.assert_true(f.glyph_metrics(f.glyph_index(32)).empty, "space is empty")
    t.assert_eq_float(f.measure_units("AV"), 1401.0 + 1401.0 - 131.0, 0.001, "AV units with kerning")
    f.kerning = false
    t.assert_eq_float(f.measure_units("AV"), 2802.0, 0.001, "AV units without kerning")
    f.kerning = true
    t.assert_eq_float(f.measure("Ho", 20.48), (1540.0 + 1253.0) / 100.0, 0.0001, "measure at size")
    mut sh = f.shape("ffi")
    t.assert_eq_int(len(sh), 1, "ffi becomes one ligature glyph")
    t.assert_eq_int(sh[0].cluster_end, 3, "ligature covers three bytes")
    f.ligatures = false
    t.assert_eq_int(len(f.shape("ffi")), 3, "ligatures off")
    f.ligatures = true
    mut sh2 = f.shape("Aé")
    t.assert_eq_int(sh2[1].cluster, 1, "cluster start of e-acute")
    t.assert_eq_int(sh2[1].cluster_end, 3, "e-acute is two bytes")
    t.assert_eq_float(sh2[1].x, 1401.0 + (f.kern(5, 17) as float), 0.001, "pen position")
    # outline
    mut o = f.glyph_outline(6)
    t.assert_true(len(o.cmds) >= 12, "H outline has commands")
    t.assert_eq_int(o.cmds[0], FONT_MOVE, "starts with a move")
    mut o2 = f.glyph_outline(f.glyph_index(111))
    mut quads = 0
    mut i = 0
    while i < len(o2.cmds):
        if o2.cmds[i] == FONT_QUAD: quads = quads + 1
        i = i + 1
    t.assert_true(quads > 4, "o has quadratic curves")
    # rasterizer (Pillow coverage: H 273.0, o 211.5, e-acute 249.93, Omega 321.8 at 40 px)
    mut img = Image.init(120, 120)
    draw_glyph(img, f, 6, 40.0, 30.0, 80.0, 0, 0, 0, 255)
    near(t, coverage(img), 273.0, 0.05, "H coverage vs Pillow")
    mut img2 = Image.init(120, 120)
    draw_glyph(img2, f, 17, 40.0, 30.0, 80.0, 0, 0, 0, 255)
    near(t, coverage(img2), 249.93, 0.05, "e-acute coverage vs Pillow")
    mut img3 = Image.init(120, 120)
    draw_glyph(img3, f, f.glyph_index(0x3A9), 40.0, 30.0, 80.0, 0, 0, 0, 255)
    near(t, coverage(img3), 321.8, 0.05, "Omega coverage vs Pillow")
    # colour and alpha
    mut px = Image.init(60, 60)
    draw_glyph(px, f, 6, 40.0, 5.0, 50.0, 200, 10, 30, 255)
    mut found = false
    mut y = 0
    while y < 60:
        mut x = 0
        while x < 60:
            mut pr, pg2, pb, pa = px.get_pixel(x, y)
            if pa == 255:
                found = true
                t.assert_eq_int(pr, 200, "opaque pixel keeps red")
                t.assert_eq_int(pb, 30, "opaque pixel keeps blue")
            x = x + 1
        y = y + 1
    t.assert_true(found, "has fully covered pixels")
    mut gb = render_glyph(f, 6, 40.0)
    t.assert_true(gb.image.width > 10 and gb.image.height > 30, "glyph bitmap size")
    t.assert_true(gb.top < 0, "glyph bitmap starts above the baseline")
    mut line = render_text(f, "Hello", 24.0, 0, 0, 0, 255)
    t.assert_true(line.width > 40 and line.height >= 24, "render_text image size")
    mut dx = Image.init(200, 50)
    mut endx = draw_text(dx, f, "AV Ho", 24.0, 10.0, 35.0, 0, 0, 0, 255)
    t.assert_eq_float(endx, 10.0 + f.measure("AV Ho", 24.0), 0.001, "draw_text returns the pen position")
    t.assert_true(coverage(dx) > 100.0, "text drawn")
    mut b0, b1, b2, b3 = f.text_bounds("H", 40.0)
    t.assert_eq_float(b0, 201.0 * 40.0 / 2048.0, 0.01, "text bounds x min")
    t.assert_eq_float(b3, 1493.0 * 40.0 / 2048.0, 0.01, "text bounds y max")
    # line breaking
    mut ls = wrap_text(f, "Hello Ho Ho AV\nHo", 20.0, f.measure("Hello Ho", 20.0) + 0.5)
    t.assert_eq_int(len(ls), 3, "three lines")
    t.assert_eq_str(ls[0], "Hello Ho", "first line")
    t.assert_eq_str(ls[1], "Ho AV", "second line")
    t.assert_eq_str(ls[2], "Ho", "paragraph break")
    mut hard = wrap_text(f, "HoHoHoHoHo", 20.0, f.measure("HoHo", 20.0) + 0.5)
    t.assert_eq_str(hard[0], "HoHo", "over-long word broken between clusters")
    t.assert_eq_int(len(hard), 3, "over-long word lines")
    f.free()

def test_otf(t: TestRunner) throws str:
    t.section("OpenType CFF font")
    mut f = Font.load(otf_bytes())?
    t.assert_eq_int(f.units_per_em, 1000, "unitsPerEm")
    t.assert_eq_int(f.num_glyphs, 21, "glyph count")
    t.assert_eq_int(f.ascent, 729, "ascent")
    t.assert_eq_int(f.descent, -271, "descent")
    t.assert_eq_int(f.line_gap, 200, "line gap")
    t.assert_eq_str(f.family, "Nimbus Sans", "family")
    t.assert_eq_int(f.outline_format(), FONT_CFF, "CFF outlines")
    t.assert_eq_int(f.glyph_index(65), 4, "cmap A")
    t.assert_eq_int(f.glyph_advance(4), 667, "advance A")
    t.assert_eq_int(f.glyph_advance(8), 944, "advance W")
    t.assert_eq_int(f.kern(4, 7), -71, "kern A V")
    t.assert_eq_float(f.measure_units("AV"), 1334.0 - 71.0, 0.001, "kerned width")
    t.assert_eq_float(f.line_height(10.0), 12.0, 0.0001, "line height")
    t.assert_eq_int(len(f.shape("fi")), 1, "fi ligature")
    mut o = f.glyph_outline(f.glyph_index(111))
    mut cubics = 0
    mut i = 0
    while i < len(o.cmds):
        if o.cmds[i] == FONT_CUBIC: cubics = cubics + 1
        i = i + 1
    t.assert_true(cubics >= 4, "o has cubic curves")
    t.assert_eq_int(o.cmds[len(o.cmds) - 1], FONT_CLOSE, "contours are closed")
    mut ra = Image.init(120, 120)
    draw_glyph(ra, f, 4, 40.0, 30.0, 80.0, 0, 0, 0, 255)
    near(t, coverage(ra), 253.81, 0.05, "A coverage vs Pillow")
    mut rh = Image.init(120, 120)
    draw_glyph(rh, f, 5, 40.0, 30.0, 80.0, 0, 0, 0, 255)
    near(t, coverage(rh), 265.73, 0.05, "H coverage vs Pillow")
    mut ro = Image.init(120, 120)
    draw_glyph(ro, f, 14, 40.0, 30.0, 80.0, 0, 0, 0, 255)
    near(t, coverage(ro), 189.35, 0.05, "o coverage vs Pillow")
    f.free()

def test_woff(t: TestRunner) throws str:
    t.section("WOFF 1.0")
    mut f = Font.load(woff_bytes())?
    t.assert_eq_int(f.num_glyphs, 29, "glyphs from WOFF")
    t.assert_eq_str(f.family, "DejaVu Sans", "family from WOFF")
    t.assert_eq_int(f.glyph_advance(5), 1401, "advance from WOFF")
    t.assert_eq_int(Font.collection_count(woff_bytes()), 1, "single font count")
    t.assert_eq_int(Font.collection_count("not a font at all"), 0, "not a font")
    f.free()

def test_errors(t: TestRunner):
    t.section("invalid fonts")
    mut r1: Result[Font, str] = Font.load("hello")
    t.assert_true(r1.is_err, "tiny garbage rejected")
    mut r2: Result[Font, str] = Font.load("OTTO" + "\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
    t.assert_true(r2.is_err, "empty table directory rejected")
    mut r3: Result[Font, str] = Font.load_index(ttf_bytes(), 3)
    t.assert_true(r3.is_err, "collection index on a plain font rejected")
    mut r4: Result[Font, str] = Font.open("/nonexistent/font.ttf")
    t.assert_true(r4.is_err, "missing file")
    t.assert_true(r4.err.starts_with("font:"), "error message prefix")
    mut full = ttf_bytes()
    mut r5: Result[Font, str] = Font.load(full.slice(0, 200))
    t.assert_true(r5.is_err, "truncated font rejected")
    t.assert_eq_str(find_system_font("No Such Family Qwxz"), "", "unknown system font")
    mut dirs = system_font_dirs()
    t.assert_true(len(dirs) >= 0, "system font dirs listed")

# Deterministic corruption: every damaged font must load or fail cleanly, and
# a font that loads must shape, measure and draw without crashing.
def corrupt(data: str, seed: int, nflips: int) -> str:
    mut buf = StringBuilder.init(data.len() + 1)
    mut state = (seed * 2654435761 + 12345) & 0x7FFFFFFF
    mut flips: List[int] = []
    mut flipv: List[int] = []
    mut k = 0
    while k < nflips:
        state = (state * 1103515245 + 12345) & 0x7FFFFFFF
        flips.append((state >> 8) % data.len())
        state = (state * 1103515245 + 12345) & 0x7FFFFFFF
        flipv.append((state >> 11) & 255)
        k = k + 1
    mut p = data as Pointer[char]
    mut i = 0
    while i < data.len():
        mut c = 0
        unsafe: c = (p.offset(i).read() as int) & 255
        mut j = 0
        while j < nflips:
            if flips[j] == i: c = flipv[j]
            j = j + 1
        buf.append_char(c)
        i = i + 1
    mut out = buf.to_owned()
    buf.free()
    return out

def fuzz_one(data: str, t: TestRunner) -> int:
    mut ok = 0
    mut r: Result[Font, str] = Font.load(data)
    if r.is_ok:
        mut f = r.ok
        mut img = Image.init(80, 60)
        f.measure("AVHo é", 12.0)
        draw_text(img, f, "AVHo fi é", 20.0, 2.0, 40.0, 0, 0, 0, 255)
        f.glyph_outline(5)
        f.glyph_metrics(7)
        f.kern(5, 8)
        mut ws = wrap_text(f, "AV Ho Ho", 12.0, 30.0)
        mut sub = FontSubset.init(f)
        sub.add(5)
        sub.add(17)
        mut sr: Result[str, str] = sub.build()
        sub.free()
        f.free()
        ok = 1
    return ok

def test_fuzz(t: TestRunner):
    t.section("corrupted fonts")
    mut ttf = ttf_bytes()
    mut otf = otf_bytes()
    mut woff = woff_bytes()
    mut loaded = 0
    mut seed = 1
    while seed <= 120:
        loaded = loaded + fuzz_one(corrupt(ttf, seed, 1 + seed % 6), t)
        loaded = loaded + fuzz_one(corrupt(otf, seed, 1 + seed % 6), t)
        if seed % 4 == 0: loaded = loaded + fuzz_one(corrupt(woff, seed, 1 + seed % 3), t)
        seed = seed + 1
    t.assert_true(loaded > 0, "some damaged fonts still load")
    # truncations at every 37 bytes
    mut n = 0
    mut cut = 12
    while cut < ttf.len():
        n = n + fuzz_one(ttf.slice(0, cut), t)
        cut = cut + 37
    t.assert_true(true, "truncated fonts did not crash")
    cut = 12
    while cut < otf.len():
        n = n + fuzz_one(otf.slice(0, cut), t)
        cut = cut + 41
    t.assert_true(true, "truncated CFF fonts did not crash")

def test_subset(t: TestRunner) throws str:
    t.section("subsetting")
    mut f = Font.load(ttf_bytes())?
    mut sub = FontSubset.init(f)
    mut ga = sub.add(f.glyph_index(65))
    mut gh = sub.add(f.glyph_index(72))
    t.assert_eq_int(ga, 1, "first glyph gets id 1")
    t.assert_eq_int(gh, 2, "second glyph gets id 2")
    t.assert_eq_int(sub.add(f.glyph_index(65)), 1, "re-adding returns the same id")
    t.assert_eq_int(sub.original(2), f.glyph_index(72), "original id")
    mut data = sub.build()?
    mut s = Font.load(data)?
    t.assert_eq_int(s.num_glyphs, 3, "subset glyph count")
    t.assert_eq_int(s.units_per_em, 2048, "subset upem")
    t.assert_eq_int(s.glyph_advance(1), 1401, "subset advance A")
    t.assert_eq_int(s.glyph_advance(2), 1540, "subset advance H")
    mut mo = f.glyph_metrics(f.glyph_index(72))
    mut ms = s.glyph_metrics(2)
    t.assert_eq_int(ms.x_max, mo.x_max, "subset H bounds")
    t.assert_true(data.len() < ttf_bytes().len(), "subset is smaller")
    mut a = Image.init(100, 100)
    mut b = Image.init(100, 100)
    draw_glyph(a, f, f.glyph_index(72), 40.0, 20.0, 70.0, 0, 0, 0, 255)
    draw_glyph(b, s, 2, 40.0, 20.0, 70.0, 0, 0, 0, 255)
    t.assert_eq_float(coverage(a), coverage(b), 0.01, "subset renders identically")
    s.free()
    sub.free()
    # CFF -> TrueType conversion
    mut c = Font.load(otf_bytes())?
    mut cs = FontSubset.init(c)
    cs.add(c.glyph_index(111))
    cs.add(c.glyph_index(65))
    mut cdata = cs.build()?
    mut c2 = Font.load(cdata)?
    t.assert_eq_int(c2.outline_format(), FONT_TRUETYPE, "CFF subset is TrueType")
    t.assert_eq_int(c2.glyph_advance(1), 556, "converted advance")
    mut r1 = Image.init(100, 100)
    mut r2 = Image.init(100, 100)
    draw_glyph(r1, c, c.glyph_index(111), 40.0, 20.0, 70.0, 0, 0, 0, 255)
    draw_glyph(r2, c2, 1, 40.0, 20.0, 70.0, 0, 0, 0, 255)
    near(t, coverage(r2), coverage(r1), 0.01, "converted outline renders the same")
    c2.free()
    cs.free()
    c.free()
    f.free()

def count_of(hay: str, needle: str) -> int:
    mut n = 0
    mut pos = 0
    while true:
        mut k = hay.slice(pos, hay.len()).find(needle)
        if k < 0: break
        n = n + 1
        pos = pos + k + needle.len()
    return n

def test_pdf(t: TestRunner) throws str:
    t.section("PDF with embedded fonts")
    mut doc = PdfDocument.init()
    mut dv = doc.add_font_ttf(ttf_bytes())?
    mut nm = doc.add_font_ttf(otf_bytes())?
    t.assert_eq_int(dv, 100, "first font id")
    t.assert_eq_int(nm, 101, "second font id")
    mut pg = doc.add_page_a4()
    pg.set_font(dv, 12.0)
    t.assert_eq_float(pg.text_width("AV Ho"), doc.ttf_font(dv).measure("AV Ho", 12.0), 0.0001, "text_width uses font metrics")
    pg.text(72.0, 700.0, "AVoé Ωαβ Жб € fi")
    pg.text_aligned(300.0, 680.0, "Hello", 1)
    mut yend = pg.text_box(72.0, 660.0, 45.0, "Hello Ho Ho AV Hello Ho", PDF_ALIGN_JUSTIFY, 1.2)
    t.assert_true(yend < 660.0 - 3.0 * 12.0, "text box wrapped to several lines")
    mut lines = pg.wrap_text("Hello Ho Ho AV Hello Ho", 45.0)
    t.assert_true(len(lines) >= 3, "wrap_text lines")
    pg.set_font(nm, 10.0)
    pg.text(72.0, 500.0, "AVoHe")
    pg.set_font(PDF_HELVETICA, 10.0)
    pg.text(72.0, 480.0, "standard font still works")
    mut p2 = doc.add_page_a4()
    p2.set_font(dv, 9.0)
    p2.text(72.0, 700.0, "second page AVo")
    mut pdf = doc.to_bytes()
    t.assert_true(pdf.starts_with("%PDF-1.7"), "header")
    t.assert_eq_int(count_of(pdf, "/Subtype /Type0"), 2, "two Type0 fonts")
    t.assert_eq_int(count_of(pdf, "/Subtype /CIDFontType2"), 2, "two CID fonts")
    t.assert_eq_int(count_of(pdf, "/Encoding /Identity-H"), 2, "Identity-H")
    t.assert_eq_int(count_of(pdf, "/FontFile2"), 2, "embedded font programs")
    t.assert_eq_int(count_of(pdf, "/ToUnicode"), 2, "ToUnicode maps")
    t.assert_true(pdf.find("/BaseFont /Helvetica") > 0, "standard font object")
    t.assert_true(count_of(pdf, "/T0 ") >= 2, "font resource used on both pages")
    # xref integrity
    mut sx = pdf.find("startxref\n")
    mut rest = pdf.slice(sx + 10, pdf.len())
    mut xoff = int(rest.slice(0, rest.find("\n")))
    t.assert_eq_str(pdf.slice(xoff, xoff + 4), "xref", "startxref points at xref")
    mut hdr = pdf.slice(xoff + 5, xoff + 40)
    mut nobj = int(hdr.slice(2, hdr.find("\n")))
    mut ok = true
    mut i = 1
    while i < nobj:
        mut eo = xoff + 5 + hdr.find("\n") + 1 + 20 * i
        mut off = int(pdf.slice(eo, eo + 10))
        mut want = f"{i} 0 obj"
        if pdf.slice(off, off + want.len()) != want: ok = false
        i = i + 1
    t.assert_true(ok, "every xref offset hits its object")
    # documents without embedded fonts are unchanged
    mut plain = PdfDocument.init()
    mut pp = plain.add_page_a4()
    pp.text(72.0, 700.0, "x")
    t.assert_eq_int(count_of(plain.to_bytes(), "Type0"), 0, "no CID fonts without add_font_ttf")
    mut bad: Result[int, str] = plain.add_font_ttf("garbage data here")
    t.assert_true(bad.is_err, "invalid font rejected")
    pg.set_font(777, 12.0)
    t.assert_eq_int(pg.font(), 0, "unknown font id falls back")

def main():
    mut t = TestRunner.init("140_font")
    mut r: Result[bool, str] = run_all(t)
    t.assert_true(r.is_ok, "no unexpected error")
    if r.is_err: print(r.err)
    t.summary()

def run_all(t: TestRunner) throws str -> bool:
    test_ttf(t)?
    test_otf(t)?
    test_woff(t)?
    test_errors(t)
    test_fuzz(t)
    test_subset(t)?
    test_pdf(t)?
    return true
