# tests/lang/154_arena_slab.tr - std.collections.arena (bump allocator) and
# std.collections.slab (generational object pool).

from std.test import TestRunner
from std.core.vec import Vec
from std.collections.arena import Arena
from std.collections.slab import Slab

class Node:
    pub id: int
    pub label: str

def mk(id: int) -> Node:
    mut n = Node()
    n.id = id
    n.label = "node-" + id.to_str()
    return n

def addr(p: Pointer[char]) -> int:
    return p as int

# Allocate in a scope so the Arena's compiler-injected free() runs on exit;
# returns a checksum read back through the arena's pointers.
def scoped_arena_work(rounds: int) -> int:
    mut a = Arena.init(1024)
    mut total = 0
    mut r = 0
    while r < rounds:
        mut xs = a.alloc_ints(50)
        mut i = 0
        while i < 50:
            unsafe: xs.offset(i).write(i + r)
            i = i + 1
        unsafe: total = total + xs.offset(49).read()
        r = r + 1
    return total

# An explicit free() is allowed (the compiler's M-6 check then forbids any later
# use of the arena, and the scope-exit drop does not run free() a second time).
def explicit_free() -> int:
    mut d = Arena.init(128)
    d.alloc_raw(500, 1)
    mut blocks = d.block_count()
    d.free()
    return blocks

def main():
    mut t = TestRunner.init("154_arena_slab")

    t.section("arena: allocation, zeroing, alignment")
    mut a = Arena.init(512)
    t.assert_eq_int(a.used(), 0, "fresh arena uses nothing")
    t.assert_eq_int(a.block_count(), 0, "no block until first allocation")
    mut p1: Pointer[char] = a.alloc_raw(10, 1)
    t.assert_eq_int(a.block_count(), 1, "first allocation creates a block")
    t.assert_eq_int(a.used(), 10, "used counts bytes")
    mut zeros = 0
    mut zi = 0
    while zi < 10:
        unsafe:
            if (p1.offset(zi).read() as int) == 0: zeros = zeros + 1
        zi = zi + 1
    t.assert_eq_int(zeros, 10, "memory is zero-filled")
    mut p8: Pointer[char] = a.alloc_raw(8, 8)
    t.assert_eq_int(addr(p8) % 8, 0, "8-byte alignment honoured")
    mut p64: Pointer[char] = a.alloc_raw(1, 64)
    t.assert_eq_int(addr(p64) % 64, 0, "64-byte alignment honoured")
    mut p16: Pointer[char] = a.alloc_raw(24, 16)
    t.assert_eq_int(addr(p16) % 16, 0, "16-byte alignment honoured")
    t.assert_true(addr(p16) >= addr(p64) + 1, "allocations do not overlap")
    t.assert_true(a.used() >= 10 + 8 + 1 + 24, "used includes padding")

    t.section("arena: typed helpers")
    mut xs = a.alloc_ints(40)
    mut i = 0
    while i < 40:
        unsafe: xs.offset(i).write(i * 3)
        i = i + 1
    mut sum = 0
    i = 0
    while i < 40:
        unsafe: sum = sum + xs.offset(i).read()
        i = i + 1
    t.assert_eq_int(sum, 3 * 39 * 40 / 2, "ints written and read back")
    mut fs = a.alloc_floats(4)
    unsafe:
        fs.offset(0).write(1.5)
        fs.offset(3).write(2.25)
    mut fsum = 0.0
    unsafe: fsum = fs.offset(0).read() + fs.offset(1).read() + fs.offset(3).read()
    t.assert_eq_float(fsum, 3.75, 0.0000001, "floats zeroed then written")
    mut ip = a.new_int(424242)
    mut got = 0
    unsafe: got = ip.read()
    t.assert_eq_int(got, 424242, "new_int")
    mut sp: Pointer[char] = a.dup_bytes("hello")
    mut c0 = 0
    mut c4 = 0
    mut c5 = 0
    unsafe:
        c0 = sp.offset(0).read() as int
        c4 = sp.offset(4).read() as int
        c5 = sp.offset(5).read() as int
    t.assert_eq_int(c0, 104, "dup_bytes first byte")
    t.assert_eq_int(c4, 111, "dup_bytes last byte")
    t.assert_eq_int(c5, 0, "dup_bytes is NUL terminated")

    t.section("arena: blocks, large requests")
    mut b = Arena.init(256)
    b.alloc_raw(100, 1)
    b.alloc_raw(100, 1)
    t.assert_eq_int(b.block_count(), 1, "two small allocations share a block")
    b.alloc_raw(100, 1)
    t.assert_eq_int(b.block_count(), 2, "overflow opens a second block")
    mut big: Pointer[char] = b.alloc_raw(10000, 8)
    t.assert_eq_int(b.block_count(), 3, "oversized request gets a dedicated block")
    unsafe:
        big.offset(0).write('x')
        big.offset(9999).write('y')
    mut bb = 0
    unsafe: bb = big.offset(9999).read() as int
    t.assert_eq_int(bb, 121, "whole large block is usable")
    t.assert_true(b.capacity() >= 256 + 256 + 10000, "capacity sums the blocks")
    t.assert_true(b.used() >= 310, "used spans blocks")

    t.section("arena: checkpoint / rollback / reset")
    mut c = Arena.init(1024)
    c.alloc_raw(64, 8)
    mut cp = c.checkpoint()
    mut used_at_cp = c.used()
    mut scratch1: Pointer[char] = c.alloc_raw(200, 8)
    c.alloc_raw(4000, 8)
    t.assert_true(c.used() > used_at_cp + 4000, "scratch allocated")
    c.rollback(cp)
    t.assert_eq_int(c.used(), used_at_cp, "rollback restores used()")
    mut blocks_after = c.block_count()
    mut again: Pointer[char] = c.alloc_raw(200, 8)
    t.assert_eq_int(addr(again), addr(scratch1), "rolled-back space is reused at the same address")
    mut zero_again = 0
    mut zj = 0
    while zj < 200:
        unsafe:
            if (again.offset(zj).read() as int) == 0: zero_again = zero_again + 1
        zj = zj + 1
    t.assert_eq_int(zero_again, 200, "reused memory is re-zeroed")
    c.alloc_raw(4000, 8)
    t.assert_eq_int(c.block_count(), blocks_after, "large block from before the rollback is reused too")
    c.reset()
    t.assert_eq_int(c.used(), 0, "reset")
    t.assert_true(c.block_count() >= 1, "reset keeps the blocks")
    mut cap_before = c.capacity()
    c.alloc_raw(900, 8)
    t.assert_eq_int(c.capacity(), cap_before, "no new memory needed after reset")
    t.assert_true(c.checkpoint() > 0, "checkpoint is positive once allocated")
    mut e = Arena.init(256)
    t.assert_eq_int(e.checkpoint(), 0, "checkpoint of an untouched arena is 0")
    e.rollback(0)
    t.assert_eq_int(e.used(), 0, "rollback(0) on an empty arena is harmless")

    t.section("arena: automatic free at scope exit")
    mut total = 0
    mut round = 0
    while round < 200:
        total = total + scoped_arena_work(5)
        round = round + 1
    t.assert_eq_int(total, 200 * (49 + 50 + 51 + 52 + 53), "200 arenas created, used and dropped by scope exit")
    t.assert_eq_int(explicit_free(), 1, "an explicit free() is accepted and not repeated at scope exit")

    t.section("slab: handles")
    mut s = Slab[int].init()
    t.assert_true(s.is_empty(), "starts empty")
    mut h1 = s.insert(100)
    mut h2 = s.insert(200)
    mut h3 = s.insert(300)
    t.assert_true(h1 > 0 and h2 > 0 and h3 > 0, "handles are positive")
    t.assert_true(h1 != h2 and h2 != h3, "handles are distinct")
    t.assert_eq_int(s.len(), 3, "len")
    t.assert_eq_int(s.get(h2), 200, "get")
    t.assert_true(s.set(h2, 222), "set live handle")
    t.assert_eq_int(s.get(h2), 222, "set took effect")
    t.assert_true(s.remove(h1), "remove")
    t.assert_false(s.remove(h1), "double remove is false")
    t.assert_false(s.contains(h1), "removed handle is stale")
    t.assert_false(s.set(h1, 5), "set on a stale handle fails")
    match s.try_get(h1):
        case Option.Some(v):
            t.fail("try_get on a stale handle returned a value")
        case Option.None:
            t.assert_true(true, "try_get on a stale handle is None")
    match s.try_get(h3):
        case Option.Some(v2):
            t.assert_eq_int(v2, 300, "try_get live")
        case Option.None:
            t.fail("try_get on a live handle returned None")
    t.assert_false(s.contains(-1), "-1 is never a handle")
    t.assert_false(s.contains(0), "0 is never a handle")
    mut h4 = s.insert(400)
    t.assert_eq_int(s.slots(), 3, "freed slot reused: slot count unchanged")
    t.assert_true(h4 != h1, "reused slot gets a new generation => a different handle")
    t.assert_false(s.contains(h1), "the old handle does not alias the new value")
    t.assert_eq_int(s.get(h4), 400, "new value")
    mut hs = s.handles()
    t.assert_eq_int(hs.len, 3, "handles() lists the live values")

    t.section("slab: class values and churn")
    mut ns = Slab[Node].init()
    mut live = Vec[int].init(16)
    mut k = 0
    while k < 100:
        live.push(ns.insert(mk(k)))
        k = k + 1
    t.assert_eq_int(ns.len(), 100, "100 nodes")
    t.assert_eq_str(ns.get(live.get(42)).label, "node-42", "class value by handle")
    mut m = 0
    while m < 100:
        if m - (m / 2) * 2 == 0: ns.remove(live.get(m))
        m = m + 1
    t.assert_eq_int(ns.len(), 50, "removed the even ones")
    t.assert_false(ns.contains(live.get(10)), "even handle stale")
    t.assert_eq_int(ns.get(live.get(11)).id, 11, "odd handle intact")
    mut r = 0
    while r < 50:
        ns.insert(mk(1000 + r))
        r = r + 1
    t.assert_eq_int(ns.len(), 100, "refilled")
    t.assert_eq_int(ns.slots(), 100, "refill reused every freed slot")
    t.assert_eq_int(ns.get(live.get(99)).id, 99, "untouched values survive churn")
    mut stale_alias = 0
    m = 0
    while m < 100:
        if m - (m / 2) * 2 == 0 and ns.contains(live.get(m)): stale_alias = stale_alias + 1
        m = m + 1
    t.assert_eq_int(stale_alias, 0, "no stale handle resolves after slot reuse")
    ns.set(live.get(1), mk(555))
    t.assert_eq_str(ns.get(live.get(1)).label, "node-555", "class value replaced in place")
    ns.clear()
    t.assert_true(ns.is_empty(), "clear")
    t.assert_false(ns.contains(live.get(1)), "clear invalidates handles")
    mut hn = ns.insert(mk(7))
    t.assert_eq_str(ns.get(hn).label, "node-7", "usable after clear")

    t.section("slab: str values")
    mut ss = Slab[str].init()
    mut sa = ss.insert("al" + "pha")
    mut sb = ss.insert("be" + "ta")
    ss.remove(sa)
    mut sc = ss.insert("gam" + "ma")
    t.assert_eq_str(ss.get(sc), "gamma", "str reuse")
    t.assert_eq_str(ss.get(sb), "beta", "str neighbour")
    t.summary()
