# tests/lang/160_jpeg.tr - std.image.jpeg: baseline/progressive JPEG decode and
# baseline encode.
#
# Decoder fixtures are tiny JPEGs written by libjpeg (Pillow): baseline 4:4:4 /
# 4:2:0 (odd size) / 4:2:2, progressive 4:2:0 and 4:4:4 (optimized Huffman),
# grayscale, Adobe CMYK, a 1x1 file, plus one file with restart intervals
# (DRI/RSTn) written by this module's own encoder. For each, the expected value
# is the FNV-1a hash of the RGB bytes that libjpeg(-turbo) itself decodes (taken
# with Pillow when the fixture was made), so a match means the decode is
# bit-identical to libjpeg's. The same decoder was also checked bit-exact on a
# 874x841 progressive photo and on 4:2:0/4:2:2/4:4:4 baseline + progressive
# files at quality 10..100 (see docs/std/image.md).
# Encoder tests round-trip synthetic images and check PSNR/size behaviour; the
# encoder output was cross-checked by decoding it with Pillow/libjpeg.

from std.test import TestRunner
from std.image import Image
from std.image.jpeg import decode_jpeg, encode_jpeg, encode_jpeg_ex, jpeg_info
from std.compress.common import rd8

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

def nib(c: int) -> int:
    if c >= 97: return c - 87
    if c >= 65: return c - 55
    return c - 48

def unhex(h: str) -> str:
    mut n = h.len() / 2
    mut hp = h as Pointer[char]
    mut buf = _tr_c_malloc(n + 1)
    mut i = 0
    while i < n:
        mut b = nib(rd8(hp, 2 * i)) * 16 + nib(rd8(hp, 2 * i + 1))
        unsafe:
            buf.offset(i).write(b as char)
        i = i + 1
    unsafe:
        buf.offset(n).write('\0')
    return _tr_str_wrap_len(buf, n)

def fnv_rgb(img: Image) -> int:
    mut h = 0x811c9dc5
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut c = 0
        while c < 3:
            h = ((h ^ (img.pixels.get(i * 4 + c) as int)) * 0x01000193) & 0xFFFFFFFF
            c = c + 1
        i = i + 1
    return h

def synth(w: int, h: int) -> Image:
    mut img = Image.init(w, h)
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            img.set_pixel(x, y, (x * 255) / (w + 1), (y * 255) / (h + 1), ((x + y) * 3) & 255, 255)
            x = x + 1
        y = y + 1
    return img

def psnr_ok(a: Image, b: Image, min_db10: int) -> bool:
    # compares RGB; true when PSNR >= min_db10/10 dB (integer math: MSE bound)
    mut se = 0
    mut n = a.width * a.height * 3
    mut i = 0
    while i < a.width * a.height:
        mut c = 0
        while c < 3:
            mut d = (a.pixels.get(i * 4 + c) as int) - (b.pixels.get(i * 4 + c) as int)
            se = se + d * d
            c = c + 1
        i = i + 1
    # mse = se / n; psnr = 10 log10(65025/mse) >= x  <=>  mse <= 65025 / 10^(x/10)
    mut lim = 65025.0
    mut k = 0
    while k < min_db10:
        lim = lim / 1.0232929922807541   # 10^(0.01) = 0.1 dB
        k = k + 1
    return (se as float) / (n as float) <= lim

def check(t: TestRunner, name: str, hex_: str, w: int, h: int, want: int):
    mut b = unhex(hex_)
    mut n = b.len()
    mut info = jpeg_info(b, n)
    t.assert_true(info.ok, name + ": jpeg_info ok")
    t.assert_eq_int(info.width, w, name + ": info width")
    t.assert_eq_int(info.height, h, name + ": info height")
    mut img = decode_jpeg(b, n)
    t.assert_eq_int(img.width, w, name + ": width")
    t.assert_eq_int(img.height, h, name + ": height")
    if img.width > 0:
        t.assert_eq_int(fnv_rgb(img), want, name + ": pixels bit-identical to libjpeg")

def main():
    mut t = TestRunner.init("160_jpeg")
    t.section("decode: libjpeg-written fixtures (hash of RGB == libjpeg output)")
    check(t, "base444", "", 24, 16, 1386880493)
    check(t, "base420_odd", "", 21, 13, 852369212)
    check(t, "base422", "", 20, 12, 3059907919)
    check(t, "prog420", "", 19, 17, 2090382766)
    check(t, "prog444_opt", "", 16, 16, 2601593081)
    check(t, "gray", "", 17, 11, 4077029300)
    check(t, "cmyk", "", 12, 12, 3774165876)
    check(t, "one_px", "", 1, 1, 27951730)
    check(t, "restart", "", 24, 20, 3574582297)

    t.section("jpeg_info flags")
    mut pb = unhex("")
    mut pinfo = jpeg_info(pb, pb.len())
    t.assert_true(pinfo.progressive, "prog420 is progressive")
    t.assert_eq_int(pinfo.components, 3, "prog420 has 3 components")
    mut gb = unhex("")
    mut ginfo = jpeg_info(gb, gb.len())
    t.assert_false(ginfo.progressive, "gray is baseline")
    t.assert_eq_int(ginfo.components, 1, "gray has 1 component")
    mut cb = unhex("")
    mut cinfo = jpeg_info(cb, cb.len())
    t.assert_eq_int(cinfo.components, 4, "cmyk has 4 components")
    t.assert_eq_int(cinfo.adobe, 2 - 2, "cmyk adobe transform flag")

    t.section("decode: malformed input is rejected")
    mut good = unhex("")
    mut gl = good.len()
    t.assert_eq_int(decode_jpeg("", 0).width, -1, "empty input")
    t.assert_eq_int(decode_jpeg("not a jpeg at all", 17).width, -1, "garbage")
    t.assert_eq_int(decode_jpeg(good, 2).width, -1, "SOI only")
    t.assert_eq_int(decode_jpeg(good, 40).width, -1, "cut inside the tables")
    t.assert_false(jpeg_info("GIF89a", 6).ok, "jpeg_info rejects non-jpeg")
    # truncated entropy data still yields an image of the right size
    mut part = decode_jpeg(good, gl - 40)
    t.assert_eq_int(part.width, 24, "truncated scan: width kept")

    t.section("encode: round trips")
    mut src = synth(37, 29)
    mut o444, l444 = encode_jpeg_ex(src, 92, 0, false, 0)
    t.assert_true(l444 > 200, "4:4:4 produces data")
    t.assert_eq_int(rd8(o444 as Pointer[char], 0), 0xFF, "SOI byte 0")
    t.assert_eq_int(rd8(o444 as Pointer[char], 1), 0xD8, "SOI byte 1")
    t.assert_eq_int(rd8(o444 as Pointer[char], l444 - 2), 0xFF, "EOI byte 0")
    t.assert_eq_int(rd8(o444 as Pointer[char], l444 - 1), 0xD9, "EOI byte 1")
    mut d444 = decode_jpeg(o444, l444)
    t.assert_eq_int(d444.width, 37, "decoded width")
    t.assert_eq_int(d444.height, 29, "decoded height")
    t.assert_true(psnr_ok(src, d444, 400), "4:4:4 q92 PSNR >= 40 dB")

    mut o420, l420 = encode_jpeg(src, 75)
    mut d420 = decode_jpeg(o420, l420)
    t.assert_eq_int(d420.width, 37, "4:2:0 width")
    t.assert_true(psnr_ok(src, d420, 350), "4:2:0 q75 PSNR >= 35 dB")
    t.assert_true(l420 < l444, "4:2:0 q75 is smaller than 4:4:4 q92")

    mut o422, l422 = encode_jpeg_ex(src, 85, 1, false, 0)
    mut d422 = decode_jpeg(o422, l422)
    t.assert_true(psnr_ok(src, d422, 380), "4:2:2 q85 PSNR >= 38 dB")

    mut lo, llo = encode_jpeg(src, 10)
    mut hi, lhi = encode_jpeg(src, 95)
    t.assert_true(llo < lhi, "higher quality -> bigger file")
    t.assert_eq_int(decode_jpeg(lo, llo).width, 37, "q10 still decodes")

    mut og, lg = encode_jpeg_ex(src, 90, 0, true, 0)
    t.assert_eq_int(jpeg_info(og, lg).components, 1, "gray encode has 1 component")
    mut dg = decode_jpeg(og, lg)
    t.assert_eq_int(dg.width, 37, "gray decode width")
    t.assert_eq_int(dg.pixels.get(0) as int, dg.pixels.get(1) as int, "gray: R == G")
    t.assert_eq_int(dg.pixels.get(1) as int, dg.pixels.get(2) as int, "gray: G == B")

    mut ors, lrs = encode_jpeg_ex(src, 85, 2, false, 3)
    mut drs = decode_jpeg(ors, lrs)
    t.assert_true(psnr_ok(src, drs, 350), "restart interval 3: round trip")
    mut ors2, lrs2 = encode_jpeg_ex(src, 85, 2, false, 0)
    mut drs2 = decode_jpeg(ors2, lrs2)
    t.assert_eq_int(fnv_rgb(drs), fnv_rgb(drs2), "restart markers do not change the pixels")

    mut tiny = synth(1, 1)
    mut ot, lt = encode_jpeg(tiny, 90)
    t.assert_eq_int(decode_jpeg(ot, lt).width, 1, "1x1 image round trips")

    mut flat = Image.init(16, 16)
    mut fy = 0
    while fy < 16:
        mut fx_ = 0
        while fx_ < 16:
            flat.set_pixel(fx_, fy, 200, 100, 50, 255)
            fx_ = fx_ + 1
        fy = fy + 1
    mut of, lf = encode_jpeg(flat, 90)
    mut df = decode_jpeg(of, lf)
    mut fr, fg, fb, fa = df.get_pixel(7, 7)
    t.assert_true(fr > 195 and fr < 205 and fg > 95 and fg < 105 and fb > 45 and fb < 55, "flat colour survives")
    t.assert_eq_int(fa, 255, "decoded alpha is opaque")

    mut tr = Image.init(8, 8)
    mut ty = 0
    while ty < 8:
        mut tx = 0
        while tx < 8:
            tr.set_pixel(tx, ty, 0, 0, 0, 0)
            tx = tx + 1
        ty = ty + 1
    mut ota, lta = encode_jpeg_ex(tr, 90, 0, false, 0)
    mut dta = decode_jpeg(ota, lta)
    mut tr1, tg1, tb1, ta1 = dta.get_pixel(3, 3)
    t.assert_true(tr1 > 250 and tg1 > 250 and tb1 > 250, "transparent pixels are composited over white")

    t.summary()
