# tests/lang/133_ntp.tr
# std.net.ntp: packet codec (cross-checked with Python struct), timestamp / offset
# arithmetic, and the SNTP client against a fake UDP server on loopback (own thread,
# bounded waits, port searched in a small range).

from std.test import TestRunner
from std.sys.time import Clock
from std.string.str import Str
from std.net.udp import UdpSocket
from std.net.wire import wire_hex
from std.net.wire import wire_unhex
from std.net.wire import wire_concat
from std.net.ntp import NtpPacket
from std.net.ntp import NtpClient
from std.net.ntp import NtpResult
from std.net.ntp import ntp_ts_to_unix_ns
from std.net.ntp import ntp_unix_ns_to_sec
from std.net.ntp import ntp_unix_ns_to_frac
from std.net.ntp import ntp_offset
from std.net.ntp import ntp_delay
from std.net.ntp import ntp_server_reply
from std.net.ntp import ntp_check_reply

extern "C":
    def _tr_wall_ns() -> int

class SrvState implements Sendable:
    pub base_port: int
    pub port:      Atomic[int]
    pub stop:      Atomic[int]
    pub behave:    Atomic[int]    # 0 normal(+5s), 1 kiss-o'-death RATE, 2 spoof then valid, 3 silent, 4 wrong source-less garbage then valid
    pub seen:      Atomic[int]

extend SrvState:
    pub def init(base_port: int) -> SrvState:
        mut s = SrvState()
        s.base_port = base_port
        s.port   = Atomic.new(0)
        s.stop   = Atomic.new(0)
        s.behave = Atomic.new(0)
        s.seen   = Atomic.new(0)
        return s

def srv_run(st: Shared[SrvState]):
    mut sock = UdpSocket.bind(st.base_port)
    mut tries = 0
    while not sock.open and tries < 30:
        tries = tries + 1
        sock = UdpSocket.bind(st.base_port + tries)
    if not sock.open:
        st.port.store(-1)
        return
    st.port.store(sock.port)
    mut cap = Clock.now_ms() + 60000
    while st.stop.load() == 0 and Clock.now_ms() < cap:
        mut req = sock.recv_wait(512, 50)
        if req.len() == 0: continue
        st.seen.add(1)
        mut at = Str.index_of(sock.src, ":")
        mut host = sock.src.slice(0, at)
        mut port = sock.src.slice(at + 1, sock.src.len()).parse_int()
        mut b = st.behave.load()
        mut now = _tr_wall_ns()
        if b == 3: continue
        if b == 4:
            sock.send_bytes("garbage", host, port)
        mut rep = ntp_server_reply(req, now + 5000000000, now + 5000000000 + 1000000, 2, "LOCL")
        if b == 1:
            mut pk: Result[NtpPacket, str] = NtpPacket.decode(rep)
            mut q = pk.ok
            q.stratum = 0
            q.ref_id = "RATE"
            rep = q.encode()
        if b == 2:
            mut pk2: Result[NtpPacket, str] = NtpPacket.decode(rep)
            mut q2 = pk2.ok
            q2.orig_frac = q2.orig_frac ^ 1
            sock.send_bytes(q2.encode(), host, port)
        sock.send_bytes(rep, host, port)
    sock.close()

def main():
    mut t = TestRunner.init("133_ntp")

    t.section("packet codec")
    # Built with python3 struct.pack('>BBbbII4sIIIIIIII', ...)
    mut hex = "240206ec00000a3d00001234c0000201e8fe6f8010000000e8fe6f8120000000e8fe6f8240000000e8fe6f8380000000"
    mut wire = wire_unhex(hex)
    t.assert_eq_int(wire.len(), 48, "unhex gives 48 bytes")
    mut r: Result[NtpPacket, str] = NtpPacket.decode(wire)
    t.assert_true(r.is_ok, "decode ok")
    mut p = r.ok
    t.assert_eq_int(p.li, 0, "li")
    t.assert_eq_int(p.vn, 4, "vn")
    t.assert_eq_int(p.mode, 4, "mode")
    t.assert_eq_int(p.stratum, 2, "stratum")
    t.assert_eq_int(p.poll, 6, "poll")
    t.assert_eq_int(p.precision, -20, "precision (signed)")
    t.assert_eq_int(p.root_delay, 0x0a3d, "root delay raw")
    t.assert_eq_int(p.root_disp, 0x1234, "root dispersion raw")
    t.assert_eq_str(p.ref_id_text(), "192.0.2.1", "stratum 2 reference id is an IPv4 address")
    t.assert_eq_int(p.ref_sec, 3908988800, "reference seconds")
    t.assert_eq_int(p.orig_frac, 0x20000000, "originate fraction")
    t.assert_eq_int(p.xmit_sec, 3908988803, "transmit seconds")
    t.assert_eq_int(p.xmit_frac, 0x80000000, "transmit fraction")
    t.assert_eq_str(wire_hex(p.encode()), hex, "encode reproduces the python bytes")
    t.assert_eq_int(p.root_delay_ns(), 0x0a3d * 1000000000 / 65536, "root delay ns")

    mut short: Result[NtpPacket, str] = NtpPacket.decode(wire.slice(0, 47))
    t.assert_true(short.is_err, "47 bytes rejected")
    mut longer: Result[NtpPacket, str] = NtpPacket.decode(wire_concat(wire, "extension-field-and-mac"))
    t.assert_true(longer.is_ok, "trailing bytes (extensions/MAC) ignored")

    mut req = NtpPacket.request(3908988803, 0x80000000, 4)
    t.assert_eq_str(wire_hex(req.encode()).slice(0, 2), "23", "client request first byte 0x23 (li0 vn4 mode3)")
    t.assert_eq_int(req.encode().len(), 48, "request is 48 bytes")
    mut req3 = NtpPacket.request(1, 2, 3)
    t.assert_eq_str(wire_hex(req3.encode()).slice(0, 2), "1b", "version 3 client byte 0x1b")

    mut k = NtpPacket.new()
    k.mode = 4
    k.stratum = 0
    k.ref_id = "DENY"
    t.assert_eq_str(k.ref_id_text(), "DENY", "kiss-o'-death code text")
    k.stratum = 1
    k.ref_id = "GPS\0"
    t.assert_eq_str(k.ref_id_text(), "GPS", "stratum 1 reference id is ASCII")

    t.section("timestamps and offset arithmetic")
    t.assert_eq_int(ntp_ts_to_unix_ns(3908988800, 0), 1700000000000000000, "NTP sec 3908988800 is unix 1700000000")
    t.assert_eq_int(ntp_ts_to_unix_ns(3908988800, 0x80000000), 1700000000500000000, "fraction 0x80000000 is half a second")
    t.assert_eq_int(ntp_ts_to_unix_ns(2208988800, 0), 0, "NTP 2208988800 is the unix epoch")
    t.assert_eq_int(ntp_ts_to_unix_ns(1, 0), (4294967297 - 2208988800) * 1000000000, "era rule: top bit clear => era 1 (2036+)")
    t.assert_eq_int(ntp_unix_ns_to_sec(1700000000000000000), 3908988800, "unix ns -> NTP seconds")
    t.assert_eq_int(ntp_unix_ns_to_frac(1700000000500000000), 0x80000000, "unix ns -> NTP fraction")
    mut rt = 1700000123456789012
    mut back = ntp_ts_to_unix_ns(ntp_unix_ns_to_sec(rt), ntp_unix_ns_to_frac(rt))
    t.assert_in_range(rt - back, 0, 1, "round trip loses at most 1 ns")
    # t1=10.000 t2=10.100 t3=10.101 t4=10.003 (seconds, in ms here): server 100 ms ahead of local
    t.assert_eq_int(ntp_offset(10000, 10100, 10101, 10003), 99, "offset = ((t2-t1)+(t3-t4))/2 = (100+98)/2")
    t.assert_eq_int(ntp_delay(10000, 10100, 10101, 10003), 2, "delay = (t4-t1)-(t3-t2) = 3-1")
    t.assert_eq_int(ntp_offset(100, 90, 91, 105), -12, "negative offset when the server is behind: (-10 + -14)/2 = -12")
    t.assert_eq_int(ntp_delay(100, 90, 91, 105), 4, "delay is independent of the offset")

    t.section("reply validation")
    mut rep = ntp_server_reply(req.encode(), 1700000000000000000, 1700000000001000000, 2, "LOCL")
    t.assert_eq_int(rep.len(), 48, "server reply is 48 bytes")
    mut rr: Result[NtpPacket, str] = NtpPacket.decode(rep)
    mut rp = rr.ok
    t.assert_eq_int(rp.mode, 4, "reply mode 4")
    t.assert_eq_int(rp.orig_sec, 3908988803, "reply echoes the transmit timestamp (sec)")
    t.assert_eq_int(rp.orig_frac, 0x80000000, "reply echoes the transmit timestamp (frac)")
    t.assert_eq_str(ntp_check_reply(3908988803, 0x80000000, rp), "", "valid reply accepted")
    t.assert_true(ntp_check_reply(3908988803, 0x80000001, rp).len() > 0, "mismatched originate timestamp rejected")
    rp.mode = 3
    t.assert_true(ntp_check_reply(3908988803, 0x80000000, rp).len() > 0, "non-server mode rejected")
    rp.mode = 4
    rp.li = 3
    t.assert_true(ntp_check_reply(3908988803, 0x80000000, rp).len() > 0, "unsynchronised server rejected")
    rp.li = 0
    rp.stratum = 16
    t.assert_true(ntp_check_reply(3908988803, 0x80000000, rp).len() > 0, "stratum 16 rejected")
    rp.stratum = 2
    rp.xmit_sec = 0
    rp.xmit_frac = 0
    t.assert_true(ntp_check_reply(3908988803, 0x80000000, rp).len() > 0, "zero transmit timestamp rejected")
    t.assert_eq_str(ntp_server_reply("short", 1, 2, 2, "LOCL"), "", "server refuses a malformed request")

    t.section("client against a fake server on loopback")
    shared st = SrvState.init(19860)
    mut srv_t = Thread.spawn(srv_run, st)
    mut waited = 0
    while st.port.load() == 0 and waited < 3000:
        Clock.sleep_ms(10)
        waited = waited + 10
    mut port = st.port.load()
    t.assert_gt_int(port, 0, "fake NTP server bound a UDP port")
    if port <= 0:
        st.stop.store(1)
        srv_t.join()
        t.summary()
        return

    mut c = NtpClient.new("127.0.0.1", port)
    c.timeout_ms = 4000
    mut q = c.query()
    t.assert_true(q.ok, "query succeeds")
    t.assert_eq_int(q.stratum, 2, "stratum from the server")
    t.assert_eq_str(q.ref_id, "76.79.67.76", "stratum 2 refid shown as dotted quad (LOCL bytes)")
    t.assert_eq_int(q.version, 4, "reply version")
    # server clock was +5 s; the 1 ms server processing time is in t3-t2, not in the delay
    t.assert_in_range(q.offset_ns, 4900000000, 5100000000, "offset is about +5 s")
    t.assert_in_range(q.offset_ms(), 4900, 5100, "offset_ms about 5000")
    t.assert_in_range(q.delay_ns, -1000000, 400000000, "delay is small on loopback")
    t.assert_true(q.t4 >= q.t1, "t4 >= t1")
    t.assert_eq_int(q.t3 - q.t2, 1000000, "server processing time 1 ms visible in t3 - t2")
    mut corrected = q.corrected_now_ns()
    mut wall = _tr_wall_ns()
    t.assert_in_range(corrected - wall, 4900000000, 5100000000, "corrected_now is wall clock + offset")

    st.behave.store(1)
    mut kq = c.query()
    t.assert_false(kq.ok, "kiss-o'-death is not a success")
    t.assert_eq_str(kq.kod, "RATE", "kiss code RATE reported")
    t.assert_contains(kq.err, "RATE", "error mentions the code")

    st.behave.store(2)
    mut sq = c.query()
    t.assert_true(sq.ok, "spoofed reply (wrong originate timestamp) ignored, real reply accepted")

    st.behave.store(4)
    mut gq = c.query()
    t.assert_true(gq.ok, "garbage datagram ignored, real reply accepted")

    st.behave.store(3)
    mut tq = NtpClient.new("127.0.0.1", port)
    tq.timeout_ms = 300
    mut t0 = Clock.now_ms()
    mut silent = tq.query()
    mut spent = Clock.now_ms() - t0
    t.assert_false(silent.ok, "silent server => failure")
    t.assert_contains(silent.err, "timeout", "timeout error")
    t.assert_in_range(spent, 250, 3000, "waited about the timeout (bounded)")

    mut dead = NtpClient.new("127.0.0.1", 9)
    dead.timeout_ms = 200
    mut dq = dead.query()
    t.assert_false(dq.ok, "nothing listening => failure, no hang")

    mut bad = NtpClient.new("no-such-host.invalid", 123)
    bad.timeout_ms = 200
    mut bq = bad.query()
    t.assert_false(bq.ok, "unresolvable host => failure")

    st.stop.store(1)
    srv_t.join()
    t.assert_gt_int(st.seen.load(), 4, "server saw the requests")
    t.summary()
