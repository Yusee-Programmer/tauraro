# tests/lang/106_x509_tls.tr
# std.crypto.aead, std.crypto.pk (RSA / ECDSA / ECDH / PEM), std.crypto.x509
# (parsing, chain + host-name verification) and std.net.tls offline failure
# paths. Keys, signatures and certificates were produced by pyca/cryptography;
# the P-256 key is RFC 6979 appendix A.2.5's. Live TLS handshakes are exercised
# manually against public servers and OpenSSL (no network in the suite).

from std.test import TestRunner
from std.crypto.native import ALG_SHA256, ALG_SHA384, ALG_SHA512, _cn_hex, _cn_unhex
from std.crypto.aead import Aead, AEAD_AES_128_GCM, AEAD_AES_256_GCM, AEAD_CHACHA20_POLY1305
from std.crypto.pk import PKey, Pem, KEY_RSA, KEY_EC_P256, KEY_EC_P384, SIG_PKCS1, SIG_PSS, CURVE_P256, CURVE_P384
from std.crypto.x509 import Certificate, TrustStore, X509, PURPOSE_SERVER, PURPOSE_CLIENT, KU_DIGITAL_SIGNATURE, KU_KEY_CERT_SIGN, EKU_SERVER_AUTH
from std.net.tls import TlsStream, TlsOptions

def unhex(h: str) -> str:
    mut r: Result[str, str] = _cn_unhex(h)
    return r.ok

def hx(s: str) -> str:
    return _cn_hex(s)

