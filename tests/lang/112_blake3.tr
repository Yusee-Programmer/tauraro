# tests/lang/112_blake3.tr
# std.crypto.blake3: hash, keyed_hash, derive_key and extendable output. Official vectors
# (input = repeating bytes 0,1,..,250; key "whats the Elvish word for friend"; context
# "BLAKE3 2019-12-27 16:29:52 test vectors context") for the cases reproducible without the
# test_vectors.json file, plus expectations from a spec-derived Python model (itself checked
# against those official values) for inputs of 1..102400 bytes covering many chunk-tree shapes.

from std.test import TestRunner
from std.crypto.blake3 import Blake3, Blake3Hasher
from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

# the official test-vector input: byte i = i mod 251
def pat(n: int) -> str:
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, i % 251)
        i = i + 1
    return CryptoBytes.wrap(p, n)

def main():
    mut t = TestRunner.init("112_blake3")
    mut key = "whats the Elvish word for friend"
    mut ctx = "BLAKE3 2019-12-27 16:29:52 test vectors context"
    t.section("official vectors (hash)")
    t.assert_eq_str(Blake3.hash_hex("", 32), "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262", "empty input")
    t.assert_eq_str(Blake3.hash_hex(pat(1), 32), "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213", "1 byte")
    t.assert_eq_str(Blake3.hash_hex(pat(3), 32), "e1be4d7a8ab5560aa4199eea339849ba8e293d55ca0a81006726d184519e647f", "3 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(1023), 32), "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11", "1023 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(1024), 32), "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7", "1024 bytes (one full chunk)")
    t.assert_eq_str(Blake3.hash_hex(pat(1025), 32), "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444", "1025 bytes (two chunks)")
    t.section("official vectors (keyed / derive_key)")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, "", 32), "92b2b75604ed3c761f9d6f62392c8a9227ad0ea3f09573e783f1498a4ed60d26", "keyed, empty input")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, "", 32), "2cc39783c223154fea8dfb7c1b1660f2ac2dcbd1c1de8277b0b0dd39b7e50d7d", "derive_key, empty input")

    t.section("hash across chunk-tree shapes")
    t.assert_eq_str(Blake3.hash_hex(pat(0), 32), "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262", "hash len 0")
    t.assert_eq_str(Blake3.hash_hex(pat(1), 32), "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213", "hash len 1")
    t.assert_eq_str(Blake3.hash_hex(pat(2), 32), "7b7015bb92cf0b318037702a6cdd81dee41224f734684c2c122cd6359cb1ee63", "hash len 2")
    t.assert_eq_str(Blake3.hash_hex(pat(3), 32), "e1be4d7a8ab5560aa4199eea339849ba8e293d55ca0a81006726d184519e647f", "hash len 3")
    t.assert_eq_str(Blake3.hash_hex(pat(63), 32), "e9bc37a594daad83be9470df7f7b3798297c3d834ce80ba85d6e207627b7db7b", "hash len 63")
    t.assert_eq_str(Blake3.hash_hex(pat(64), 32), "4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98", "hash len 64")
    t.assert_eq_str(Blake3.hash_hex(pat(65), 32), "de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee", "hash len 65")
    t.assert_eq_str(Blake3.hash_hex(pat(127), 32), "d81293fda863f008c09e92fc382a81f5a0b4a1251cba1634016a0f86a6bd640d", "hash len 127")
    t.assert_eq_str(Blake3.hash_hex(pat(128), 32), "f17e570564b26578c33bb7f44643f539624b05df1a76c81f30acd548c44b45ef", "hash len 128")
    t.assert_eq_str(Blake3.hash_hex(pat(129), 32), "683aaae9f3c5ba37eaaf072aed0f9e30bac0865137bae68b1fde4ca2aebdcb12", "hash len 129")
    t.assert_eq_str(Blake3.hash_hex(pat(1023), 32), "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11", "hash len 1023")
    t.assert_eq_str(Blake3.hash_hex(pat(1024), 32), "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7", "hash len 1024")
    t.assert_eq_str(Blake3.hash_hex(pat(1025), 32), "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444", "hash len 1025")
    t.assert_eq_str(Blake3.hash_hex(pat(2047), 32), "58830fbf51a4423c573b164471690570e544cfe793bead46225664796b4b1467", "hash len 2047")
    t.assert_eq_str(Blake3.hash_hex(pat(2048), 32), "e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a", "hash len 2048")
    t.assert_eq_str(Blake3.hash_hex(pat(2049), 32), "5f4d72f40d7a5f82b15ca2b2e44b1de3c2ef86c426c95c1af0b6879522563030", "hash len 2049")
    t.assert_eq_str(Blake3.hash_hex(pat(3071), 32), "38955dc63aa8e2f7af9e3abf3be7435d91814bb0a511df7f0dd465dfcc6d7275", "hash len 3071")
    t.assert_eq_str(Blake3.hash_hex(pat(3072), 32), "b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2", "hash len 3072")
    t.assert_eq_str(Blake3.hash_hex(pat(3073), 32), "7124b49501012f81cc7f11ca069ec9226cecb8a2c850cfe644e327d22d3e1cd3", "hash len 3073")
    t.assert_eq_str(Blake3.hash_hex(pat(4096), 32), "015094013f57a5277b59d8475c0501042c0b642e531b0a1c8f58d2163229e969", "hash len 4096")
    t.assert_eq_str(Blake3.hash_hex(pat(5120), 32), "9cadc15fed8b5d854562b26a9536d9707cadeda9b143978f319ab34230535833", "hash len 5120")
    t.assert_eq_str(Blake3.hash_hex(pat(7168), 32), "61da957ec2499a95d6b8023e2b0e604ec7f6b50e80a9678b89d2628e99ada77a", "hash len 7168")
    t.assert_eq_str(Blake3.hash_hex(pat(8191), 32), "bae8dc916e8643c6cf024097237cde1cba35c05b5d84c02834cb6b886edb76d9", "hash len 8191")
    t.assert_eq_str(Blake3.hash_hex(pat(8192), 32), "aae792484c8efe4f19e2ca7d371d8c467ffb10748d8a5a1ae579948f718a2a63", "hash len 8192")
    t.assert_eq_str(Blake3.hash_hex(pat(8193), 32), "bab6c09cb8ce8cf459261398d2e7aef35700bf488116ceb94a36d0f5f1b7bc3b", "hash len 8193")
    t.assert_eq_str(Blake3.hash_hex(pat(16384), 32), "f875d6646de28985646f34ee13be9a576fd515f76b5b0a26bb324735041ddde4", "hash len 16384")
    t.assert_eq_str(Blake3.hash_hex(pat(31744), 32), "62b6960e1a44bcc1eb1a611a8d6235b6b4b78f32e7abc4fb4c6cdcce94895c47", "hash len 31744")
    t.assert_eq_str(Blake3.hash_hex(pat(102400), 32), "bc3e3d41a1146b069abffad3c0d44860cf664390afce4d9661f7902e7943e085", "hash len 102400")
    t.section("keyed hash")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(0), 32), "92b2b75604ed3c761f9d6f62392c8a9227ad0ea3f09573e783f1498a4ed60d26", "keyed len 0")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(1), 32), "6d7878dfff2f485635d39013278ae14f1454b8c0a3a2d34bc1ab38228a80c95b", "keyed len 1")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(64), 32), "ba8ced36f327700d213f120b1a207a3b8c04330528586f414d09f2f7d9ccb7e6", "keyed len 64")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(65), 32), "c0a4edefa2d2accb9277c371ac12fcdbb52988a86edc54f0716e1591b4326e72", "keyed len 65")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(1024), 32), "75c46f6f3d9eb4f55ecaaee480db732e6c2105546f1e675003687c31719c7ba4", "keyed len 1024")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(1025), 32), "357dc55de0c7e382c900fd6e320acc04146be01db6a8ce7210b7189bd664ea69", "keyed len 1025")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(2049), 32), "9f29700902f7c86e514ddc4df1e3049f258b2472b6dd5267f61bf13983b78dd5", "keyed len 2049")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(7168), 32), "b42835e40e9d4a7f42ad8cc04f85a963a76e18198377ed84adddeaecacc6f3fc", "keyed len 7168")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(31744), 32), "efa53b389ab67c593dba624d898d0f7353ab99e4ac9d42302ee64cbf9939a419", "keyed len 31744")
    t.section("derive_key")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, pat(0), 32), "2cc39783c223154fea8dfb7c1b1660f2ac2dcbd1c1de8277b0b0dd39b7e50d7d", "derive_key len 0")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, pat(1), 32), "b3e2e340a117a499c6cf2398a19ee0d29cca2bb7404c73063382693bf66cb06c", "derive_key len 1")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, pat(64), 32), "a5c4a7053fa86b64746d4bb688d06ad1f02a18fce9afd3e818fefaa7126bf73e", "derive_key len 64")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, pat(1025), 32), "effaa245f065fbf82ac186839a249707c3bddf6d3fdda22d1b95a3c970379bcb", "derive_key len 1025")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, pat(2049), 32), "2ea477c5515cc3dd606512ee72bb3e0e758cfae7232826f35fb98ca1bcbdf273", "derive_key len 2049")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, pat(7168), 32), "11c37a112765370c94a51415d0d651190c288566e295d505defdad895dae2237", "derive_key len 7168")
    t.assert_eq_str(Blake3.derive_key_hex("another context", "material", 40), "459331d9560b0eb5210c0e52998964249e89fa94c44a20e2f40e1b0b1f2c260f06d63abd3a37424e", "derive_key, other context, 40 bytes")
    t.section("extendable output")
    t.assert_eq_str(Blake3.hash_hex(pat(0), 131), "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262e00f03e7b69af26b7faaf09fcd333050338ddfe085b8cc869ca98b206c08243a26f5487789e8f660afe6c99ef9e0c52b92e7393024a80459cf91f476f9ffdbda7001c22e159b402631f277ca96f2defdf1078282314e763699a31c5363165421cce14d", "hash len 0 -> 131 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(1), 131), "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213c3a6cb8bf623e20cdb535f8d1a5ffb86342d9c0b64aca3bce1d31f60adfa137b358ad4d79f97b47c3d5e79f179df87a3b9776ef8325f8329886ba42f07fb138bb502f4081cbcec3195c5871e6c23e2cc97d3c69a613eba131e5f1351f3f1da786545e5", "hash len 1 -> 131 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(64), 64), "4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98fc9cc56cb831ffe33ea8e7e1d1df09b26efd2767670066aa82d023b1dfe8ab1b", "hash len 64 -> 64 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(65), 200), "", "hash len 65 -> 200 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(1025), 131), "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444f4c4a22b4b399155358a994e52bf255de60035742ec71bd08ac275a1b51cc6bfe332b0ef84b409108cda080e6269ed4b3e2c3f7d722aa4cdc98d16deb554e5627be8f955c98e1d5f9565a9194cad0c4285f93700062d9595adb992ae68ff12800ab67a", "hash len 1025 -> 131 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(7168), 300), "", "hash len 7168 -> 300 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(2048), 1), "e7", "hash len 2048 -> 1 bytes")
    t.assert_eq_str(Blake3.keyed_hash_hex(key, pat(1025), 131), "357dc55de0c7e382c900fd6e320acc04146be01db6a8ce7210b7189bd664ea69362396b77fdc0d2634a552970843722066c3c15902ae5097e00ff53f1e116f1cd5352720113a837ab2452cafbde4d54085d9cf5d21ca613071551b25d52e69d6c81123872b6f19cd3bc1333edf0c52b94de23ba772cf82636cff4542540a7738d5b930", "keyed len 1025 -> 131 bytes")
    t.assert_eq_str(Blake3.derive_key_hex(ctx, pat(3), 131), "440aba35cb006b61fc17c0529255de438efc06a8c9ebf3f2ddac3b5a86705797f27e2e914574f4d87ec04c379e12789eccbfbc15892626042707802dbe4e97c3ff59dca80c1e54246b6d055154f7348a39b7d098b2b4824ebe90e104e763b2a447512132cede16243484a55a4e40a85790038bb0dcf762e8c053cabae41bbe22a5bff7", "derive_key len 3 -> 131 bytes")
    t.assert_eq_str(Blake3.hash_hex(pat(500), 32), CryptoBytes.slice(Blake3.hash_hex(pat(500), 100), 0, 64), "32-byte output is a prefix of the 100-byte output")
    t.assert_eq_int(Blake3.hash("x", 0).len(), 0, "zero-length output")
    t.assert_eq_int(Blake3.hash("x", 77).len(), 77, "output length is exact")
    t.section("incremental API")
    mut big = pat(9000)
    mut want = Blake3.hash_hex(big, 32)
    mut sizes: List[int] = [1, 7, 63, 64, 65, 1000, 1024, 1025, 4096]
    mut si = 0
    while si < 9:
        mut h = Blake3Hasher.new()
        mut sz = sizes[si]
        mut k = 0
        while k < 9000:
            mut pl = sz
            if k + pl > 9000: pl = 9000 - k
            h.update_bytes(CryptoBytes.slice(big, k, pl), pl)
            k = k + pl
        t.assert_eq_str(h.finalize_hex(32), want, f"piece size {sz}")
        h.free()
        si = si + 1
    mut hh = Blake3Hasher.new()
    hh.update(CryptoBytes.slice(big, 0, 4000))
    mut early = hh.finalize_hex(32)
    t.assert_eq_str(early, Blake3.hash_hex(CryptoBytes.slice(big, 0, 4000), 32), "finalize midway")
    t.assert_eq_str(hh.finalize_hex(32), early, "finalize is repeatable")
    hh.update(CryptoBytes.slice(big, 4000, 5000))
    t.assert_eq_str(hh.finalize_hex(32), want, "update after finalize continues the hash")
    hh.free()
    mut kh = Blake3Hasher.new_keyed(key)
    kh.update("hello ")
    kh.update("world")
    t.assert_eq_str(kh.finalize_hex(32), Blake3.keyed_hash_hex(key, "hello world", 32), "incremental keyed")
    kh.free()
    mut dh = Blake3Hasher.new_derive_key(ctx)
    dh.update(pat(5))
    t.assert_eq_str(dh.finalize_hex(32), Blake3.derive_key_hex(ctx, pat(5), 32), "incremental derive_key")
    dh.free()
    t.section("invalid parameters")
    t.assert_eq_str(Blake3.keyed_hash_hex("short key", "x", 32), "", "key must be 32 bytes")
    t.assert_eq_str(Blake3.keyed_hash_hex(CryptoBytes.concat(key, "!"), "x", 32), "", "33-byte key rejected")
    t.assert_eq_str(Blake3.hash_hex("x", -1), "", "negative output length")
    t.assert_true(Blake3.hash_hex("a", 32) != Blake3.keyed_hash_hex(key, "a", 32), "keyed differs from plain")
    t.assert_true(Blake3.hash_hex("a", 32) != Blake3.derive_key_hex("ctx", "a", 32), "derive_key differs from plain")
    mut nz = CryptoBytes.wrap(CryptoBytes.zeroed(70), 70)

    t.assert_eq_str(Blake3.hash_hex(nz, 32), "62166b4e8ab6fbc41fdf09021ea1c48b7316cb585eed0f38820d31c5bc53ab7c", "70 zero bytes (NULs hashed)")
    t.summary()
