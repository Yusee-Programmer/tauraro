# tests/lang/138_crypto_age_ssh.tr
# std.crypto.scrypt (RFC 7914 vectors, PHC strings checked against Python's
# hashlib.scrypt), std.encoding.bech32 (BIP 173/350 vectors), std.crypto.age
# (the small non-post-quantum vectors of the C2SP/CCTV age testkit, embedded
# below, plus round trips that were also decrypted by an independent
# pyca/cryptography implementation) and std.crypto.ssh (keys and SSHSIG
# signatures made by OpenSSH 10.2's ssh-keygen; signatures and keys written
# here were checked with `ssh-keygen -Y verify` / `ssh-keygen -y`).
# Corrupted inputs must raise, never crash.

from std.test import TestRunner
from std.crypto.native import _cn_hex, _cn_unhex
from std.crypto.scrypt import Scrypt, ScryptParams, ScryptHash
from std.encoding.bech32 import Bech32, Bech32Data, BECH32, BECH32M
from std.crypto.age import Age, AgeIdentity, AgeRecipient, AgeEncryptor, AgeDecryptor, AGE_SCRYPT
from std.crypto.ssh import SshKey, SshSig, SshAuthorizedKey
from std.crypto.pk import PKey, CURVE_P256, KEY_EC_P256, KEY_ED25519
from std.crypto.digest import Digest
from std.io.file import read_file, write_file
from std.string.str import Str

def unhex(h: str) -> str:
    mut r: Result[str, str] = _cn_unhex(h)
    return r.ok

def pattern(n: int) -> str:
    mut acc = "The quick brown fox jumps over the lazy dog 0123456789\n"
    while acc.len() < n:
        acc = acc + acc
    return acc.slice(0, n)

# Replace byte i of s with (byte ^ x).
def flip(s: str, i: int, x: int) -> str:
    mut p = s as Pointer[char]
    mut b = 0
    unsafe: b = (p.offset(i).read() as int) & 255
    mut one = unhex(_cn_hex(s.slice(i, i + 1)))
    mut q = one as Pointer[char]
    unsafe: q.offset(0).write(((b ^ x) & 255) as char)
    return s.slice(0, i) + one + s.slice(i + 1, s.len())

# ── scrypt ───────────────────────────────────────────────────────────────────
def test_scrypt(t: TestRunner):
    t.section("scrypt (RFC 7914 section 12)")
    mut a: Result[str, str] = Scrypt.derive("", "", 16, 1, 1, 64)
    t.assert_eq_str(_cn_hex(a.ok), "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906", "vector 1 (N=16, r=1, p=1)")
    mut b: Result[str, str] = Scrypt.derive("password", "NaCl", 1024, 8, 16, 64)
    t.assert_eq_str(_cn_hex(b.ok), "fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640", "vector 2 (N=1024, r=8, p=16)")
    mut c: Result[str, str] = Scrypt.derive("pleaseletmein", "SodiumChloride", 16384, 8, 1, 64)
    t.assert_eq_str(_cn_hex(c.ok), "7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887", "vector 3 (N=16384, r=8, p=1)")

    t.section("scrypt parameter validation and memory cap")
    mut e1: Result[str, str] = Scrypt.derive("", "", 15, 1, 1, 32)
    t.assert_true(e1.is_err, "N not a power of two")
    mut e2: Result[str, str] = Scrypt.derive("", "", 1, 1, 1, 32)
    t.assert_true(e2.is_err, "N = 1")
    mut e3: Result[str, str] = Scrypt.derive("", "", 16, 0, 1, 32)
    t.assert_true(e3.is_err, "r = 0")
    mut e4: Result[str, str] = Scrypt.derive("", "", 16, 1, 0, 32)
    t.assert_true(e4.is_err, "p = 0")
    mut e5: Result[str, str] = Scrypt.derive("", "", 16, 1, 1, 0)
    t.assert_true(e5.is_err, "dklen = 0")
    mut e6: Result[str, str] = Scrypt.derive("", "", 1 << 30, 8, 1, 32)
    t.assert_true(e6.is_err and e6.err.contains("limit"), "1 TiB request refused by the default cap")
    mut e7: Result[str, str] = Scrypt.derive_limited("", "", 1024, 8, 1, 32, 1000000)
    t.assert_true(e7.is_err, "explicit cap below 1 MiB refuses N=1024, r=8")
    mut e8: Result[str, str] = Scrypt.derive("", "", 1 << 20, 1, 1, 32)
    t.assert_true(e8.is_err, "N >= 2^(16 r) is rejected")
    t.assert_eq_int(Scrypt.memory_needed(1024, 8, 1), 128 * 8 * 1024 + 256 * 8 + 128 * 8, "memory_needed")

    t.section("scrypt PHC strings")
    t.assert_true(Scrypt.verify(scrypt_reference(), "password"), "verifies a hashlib.scrypt-made string")
    t.assert_false(Scrypt.verify(scrypt_reference(), "Password"), "wrong password")
    mut params = ScryptParams.init(10, 8, 1)
    mut h: Result[str, str] = Scrypt.hash_with(params_pw(), params)
    t.assert_true(h.ok.starts_with("$scrypt$ln=10,r=8,p=1$"), "hash format")
    t.assert_true(Scrypt.verify(h.ok, params_pw()), "hash/verify round trip")
    t.assert_false(Scrypt.needs_rehash(h.ok, params), "needs_rehash false for the same params")
    t.assert_true(Scrypt.needs_rehash(h.ok, ScryptParams.default()), "needs_rehash true for new params")
    mut d: Result[ScryptHash, str] = Scrypt.decode(h.ok)
    t.assert_true(d.is_ok and d.ok.log_n == 10 and d.ok.salt.len() == 16 and d.ok.hash.len() == 32, "decode")
    t.assert_false(Scrypt.verify("$scrypt$ln=10,r=8$AAAA$AAAAAAAAAAAA", "x"), "missing p")
    t.assert_false(Scrypt.verify("$scrypt$ln=60,r=8,p=1$AAAA$AAAAAAAAAAAA", "x"), "huge ln")
    t.assert_false(Scrypt.verify("$scrypt$ln=10,r=8,p=1$!!$AAAAAAAAAAAA", "x"), "bad base64")
    t.assert_false(Scrypt.verify("$argon2id$v=19$m=8,t=1,p=1$AAAA$AAAA", "x"), "other algorithm")
    t.assert_false(Scrypt.verify("", "x"), "empty string")

def params_pw() -> str: return "correct horse battery staple"

# ── bech32 ───────────────────────────────────────────────────────────────────
def test_bech32(t: TestRunner):
    t.section("Bech32 / Bech32m")
    mut a: Result[Bech32Data, str] = Bech32.decode("A12UEL5L")
    t.assert_true(a.is_ok and a.ok.hrp == "a" and a.ok.data.len() == 0 and a.ok.variant == BECH32, "BIP 173 A12UEL5L")
    mut b: Result[Bech32Data, str] = Bech32.decode("abcdef1qpzry9x8gf2tvdw0s3jn54khce6mua7lmqqqxw")
    t.assert_true(b.is_ok and b.ok.hrp == "abcdef", "BIP 173 full alphabet")
    mut m: Result[Bech32Data, str] = Bech32.decode("a1lqfn3a")
    t.assert_true(m.is_ok and m.ok.variant == BECH32M, "BIP 350 a1lqfn3a")
    mut c: Result[Bech32Data, str] = Bech32.decode("A12uEL5L")
    t.assert_true(c.is_err, "mixed case rejected")
    mut d: Result[Bech32Data, str] = Bech32.decode("a12uel5m")
    t.assert_true(d.is_err, "bad checksum rejected")
    mut e: Result[Bech32Data, str] = Bech32.decode("1qzzfhee")
    t.assert_true(e.is_err, "empty hrp rejected")
    mut raw = unhex("00ff10")
    mut enc: Result[str, str] = Bech32.encode("test", raw)
    mut back: Result[Bech32Data, str] = Bech32.decode(enc.ok)
    t.assert_eq_str(_cn_hex(back.ok.data), "00ff10", "encode/decode round trip with a NUL byte")

# ── age ──────────────────────────────────────────────────────────────────────
def age_category(err: str) -> str:
    if err.starts_with("age: header:"): return "header failure"
    if err.starts_with("age: no identity"): return "no match"
    if err.starts_with("age: bad header MAC"): return "HMAC failure"
    if err.starts_with("age: payload:"): return "payload failure"
    if err.starts_with("age: armor:"): return "armor failure"
    return "unexpected error: " + err

# Run one CCTV vector; "" on success, else a description.
def run_age_vector(rec: str) -> str:
    mut f = Str.split_keep_empty(rec, "|")
    mut name = f.get(0)
    mut expect = f.get(1)
    mut payload = f.get(2)
    mut ids: List[AgeIdentity] = []
    if f.get(3).len() > 0:
        mut il = Str.split_keep_empty(f.get(3), ";")
        mut i = 0
        while i < il.len:
            mut r: Result[AgeIdentity, str] = AgeIdentity.parse(il.get(i))
            if r.is_err: return f"{name}: identity did not parse: {r.err}"
            ids.append(r.ok)
            i = i + 1
    if f.get(4).len() > 0:
        mut pl = Str.split_keep_empty(f.get(4), ";")
        mut j = 0
        while j < pl.len:
            ids.append(AgeIdentity.passphrase(pl.get(j)))
            j = j + 1
    mut body = unhex(f.get(6))
    mut got = "success"
    mut out = ""
    if f.get(5) == "yes":
        mut ar: Result[str, str] = Age.dearmor(body)
        if ar.is_err: got = age_category(ar.err)
        else: body = ar.ok
    if got == "success":
        # Stream in small pieces, keeping whatever authenticated.
        mut d = AgeDecryptor.init(ids)
        mut ok = true
        mut off = 0
        while off < body.len() and ok:
            mut e = off + 97
            if e > body.len(): e = body.len()
            mut r: Result[str, str] = d.update(body.slice(off, e))
            if r.is_err:
                got = age_category(r.err)
                out = out + d.partial()
                ok = false
            else: out = out + r.ok
            off = e
        if ok:
            mut fr: Result[str, str] = d.finish()
            if fr.is_err: got = age_category(fr.err)
            else: out = out + fr.ok
        mut one: Result[str, str] = Age.decrypt_binary(body, ids)
        mut got2 = "success"
        if one.is_err: got2 = age_category(one.err)
        if got2 != got: return f"{name}: streaming says {got}, one-shot says {got2}"
    if got != expect: return f"{name}: expected {expect}, got {got}"
    if payload.len() > 0 and (got == "success" or got == "payload failure"):
        if Digest.sha256_hex(out) != payload: return f"{name}: released plaintext hash mismatch"
    return ""

def test_age_vectors(t: TestRunner):
    t.section("age: C2SP/CCTV testkit vectors")
    mut vs = age_vectors()
    mut i = 0
    mut fails = 0
    while i < len(vs):
        mut msg = run_age_vector(vs[i])
        if msg.len() > 0:
            print(msg)
            fails = fails + 1
        i = i + 1
    t.assert_eq_int(fails, 0, f"all {len(vs)} embedded vectors behave as expected")
    t.assert_gt_int(len(vs), 100, "vector set present")

def one_rcpt(r: AgeRecipient) -> List[AgeRecipient]:
    mut v: List[AgeRecipient] = []
    v.append(r)
    return v

def one_id(i: AgeIdentity) -> List[AgeIdentity]:
    mut v: List[AgeIdentity] = []
    v.append(i)
    return v

def test_age_keys(t: TestRunner):
    t.section("age: keys")
    mut ir: Result[AgeIdentity, str] = AgeIdentity.parse("AGE-SECRET-KEY-1EGTZVFFV20835NWYV6270LXYVK2VKNX2MMDKWYKLMGR48UAWX40Q2P2LM0")
    t.assert_true(ir.is_ok, "parse a testkit identity")
    mut rr: Result[AgeRecipient, str] = ir.ok.recipient()
    t.assert_eq_str(rr.ok.to_string(), "age1xmwwc06ly3ee5rytxm9mflaz2u56jjj36s0mypdrwsvlul66mv4q47ryef", "recipient matches pyca/cryptography")
    t.assert_eq_str(ir.ok.to_string(), "AGE-SECRET-KEY-1EGTZVFFV20835NWYV6270LXYVK2VKNX2MMDKWYKLMGR48UAWX40Q2P2LM0", "identity round trip")
    mut pr: Result[AgeRecipient, str] = AgeRecipient.parse("age1xmwwc06ly3ee5rytxm9mflaz2u56jjj36s0mypdrwsvlul66mv4q47ryef")
    t.assert_true(pr.is_ok, "parse recipient")
    mut bad1: Result[AgeRecipient, str] = AgeRecipient.parse("age1xmwwc06ly3ee5rytxm9mflaz2u56jjj36s0mypdrwsvlul66mv4q47ryeg")
    t.assert_true(bad1.is_err, "recipient checksum")
    mut bad2: Result[AgeRecipient, str] = AgeRecipient.parse("AGE-SECRET-KEY-1EGTZVFFV20835NWYV6270LXYVK2VKNX2MMDKWYKLMGR48UAWX40Q2P2LM0")
    t.assert_true(bad2.is_err, "identity is not a recipient")
    mut bad3: Result[AgeIdentity, str] = AgeIdentity.parse("age1xmwwc06ly3ee5rytxm9mflaz2u56jjj36s0mypdrwsvlul66mv4q47ryef")
    t.assert_true(bad3.is_err, "recipient is not an identity")
    mut file = "# created: 2026\n# public key: age1...\n\nAGE-SECRET-KEY-1EGTZVFFV20835NWYV6270LXYVK2VKNX2MMDKWYKLMGR48UAWX40Q2P2LM0\n"
    mut fl: Result[List[AgeIdentity], str] = AgeIdentity.parse_file(file)
    t.assert_true(fl.is_ok and len(fl.ok) == 1, "identity file with comments")
    mut g: Result[AgeIdentity, str] = AgeIdentity.generate()
    mut gs = g.ok.to_string()
    t.assert_true(gs.starts_with("AGE-SECRET-KEY-1") and gs.len() == 74, "generated identity format")
    mut g2: Result[AgeIdentity, str] = AgeIdentity.parse(gs)
    t.assert_eq_str(g2.ok.to_string(), gs, "generated identity parses back")

def test_age_roundtrip(t: TestRunner):
    t.section("age: encrypt / decrypt")
    mut a: Result[AgeIdentity, str] = AgeIdentity.generate()
    mut b: Result[AgeIdentity, str] = AgeIdentity.generate()
    mut c: Result[AgeIdentity, str] = AgeIdentity.generate()
    mut ra: Result[AgeRecipient, str] = a.ok.recipient()
    mut rb: Result[AgeRecipient, str] = b.ok.recipient()
    mut rs: List[AgeRecipient] = []
    rs.append(ra.ok)
    rs.append(rb.ok)
    mut sizes = [0, 1, 65535, 65536, 65537, 200000]
    mut i = 0
    while i < len(sizes):
        mut pt = pattern(sizes[i])
        mut ct: Result[str, str] = Age.encrypt(pt, rs)
        mut d1: Result[str, str] = Age.decrypt(ct.ok, one_id(b.ok))
        t.assert_true(d1.is_ok and d1.ok == pt, f"{sizes[i]} bytes, second recipient decrypts")
        mut d2: Result[str, str] = Age.decrypt(ct.ok, one_id(c.ok))
        t.assert_true(d2.is_err and d2.err.starts_with("age: no identity"), f"{sizes[i]} bytes, other identity: no match")
        i = i + 1
    mut big = pattern(150000)
    mut arm: Result[str, str] = Age.encrypt_armored(big, one_rcpt(ra.ok))
    t.assert_true(arm.ok.starts_with("-----BEGIN AGE ENCRYPTED FILE-----\n") and Age.is_armored(arm.ok), "armored output")
    mut da: Result[str, str] = Age.decrypt(arm.ok, one_id(a.ok))
    t.assert_true(da.is_ok and da.ok == big, "armored round trip")
    mut crlf = arm.ok.replace("\n", "\r\n")
    mut dc: Result[str, str] = Age.decrypt("\n  " + crlf + "\n\n", one_id(a.ok))
    t.assert_true(dc.is_ok and dc.ok == big, "armor with CRLF and surrounding whitespace")

    mut pw: Result[str, str] = Age.encrypt(pattern(1000), one_rcpt(AgeRecipient.passphrase_with_work_factor("hunter2", 10)))
    mut dp: Result[str, str] = Age.decrypt_passphrase(pw.ok, "hunter2")
    t.assert_true(dp.is_ok and dp.ok == pattern(1000), "passphrase round trip")
    mut dpw: Result[str, str] = Age.decrypt_passphrase(pw.ok, "hunter3")
    t.assert_true(dpw.is_err and dpw.err.starts_with("age: no identity"), "wrong passphrase: no match")
    mut low: Result[str, str] = Age.decrypt(pw.ok, one_id(AgeIdentity.passphrase_with_max_work_factor("hunter2", 9)))
    t.assert_true(low.is_err and low.err.contains("work factor"), "work factor above the identity's limit")
    mut mix: List[AgeRecipient] = []
    mix.append(ra.ok)
    mix.append(AgeRecipient.passphrase("x"))
    mut em: Result[str, str] = Age.encrypt("x", mix)
    t.assert_true(em.is_err, "passphrase recipient must be alone")
    mut none_r: List[AgeRecipient] = []
    mut en: Result[str, str] = Age.encrypt("x", none_r)
    t.assert_true(en.is_err, "no recipients")

    t.section("age: streaming")
    mut data = pattern(300001)
    mut er: Result[AgeEncryptor, str] = AgeEncryptor.init(rs)
    mut enc = er.ok
    mut ctb = ""
    mut off = 0
    mut step = 1
    while off < data.len():
        mut e = off + step
        if e > data.len(): e = data.len()
        mut u: Result[str, str] = enc.update(data.slice(off, e))
        ctb = ctb + u.ok
        off = e
        step = step * 3 + 7
    mut fin: Result[str, str] = enc.finish()
    ctb = ctb + fin.ok
    mut dd: Result[str, str] = Age.decrypt(ctb, one_id(a.ok))
    t.assert_true(dd.is_ok and dd.ok == data, "AgeEncryptor output decrypts in one shot")
    mut dec = AgeDecryptor.init(one_id(b.ok))
    mut ptb = ""
    off = 0
    while off < ctb.len():
        mut e = off + 70001
        if e > ctb.len(): e = ctb.len()
        mut u: Result[str, str] = dec.update(ctb.slice(off, e))
        ptb = ptb + u.ok
        off = e
    mut df: Result[str, str] = dec.finish()
    t.assert_true(df.is_ok and ptb + df.ok == data, "AgeDecryptor round trip")
    mut trunc = AgeDecryptor.init(one_id(a.ok))
    mut tu: Result[str, str] = trunc.update(ctb.slice(0, ctb.len() - 1000))
    mut tf: Result[str, str] = trunc.finish()
    t.assert_true(tu.is_ok and tf.is_err, "truncated stream fails at finish")

    t.section("age: files")
    mut dir = "/tmp/tauraro_138_age"
    mut src = dir + "_in.bin"
    mut mid = dir + "_mid.age"
    mut dst = dir + "_out.bin"
    write_file(src, data)
    mut ef: Result[bool, str] = age_file_enc(src, mid, rs)
    t.assert_true(ef.is_ok, "encrypt_file")
    mut df2: Result[bool, str] = age_file_dec(mid, dst, one_id(a.ok))
    t.assert_true(df2.is_ok and read_file(dst) == data, "decrypt_file round trip")
    mut df3: Result[bool, str] = age_file_dec(mid, dst, one_id(c.ok))
    t.assert_true(df3.is_err, "decrypt_file with the wrong identity")

def age_file_enc(a: str, b: str, rs: List[AgeRecipient]) throws str -> bool:
    Age.encrypt_file(a, b, rs)?
    return true

def age_file_dec(a: str, b: str, ids: List[AgeIdentity]) throws str -> bool:
    Age.decrypt_file(a, b, ids)?
    return true

def test_age_corrupt(t: TestRunner):
    t.section("age: corrupted input never crashes")
    mut id: Result[AgeIdentity, str] = AgeIdentity.generate()
    mut r: Result[AgeRecipient, str] = id.ok.recipient()
    mut pt = pattern(70000)
    mut ct: Result[str, str] = Age.encrypt(pt, one_rcpt(r.ok))
    mut good = ct.ok
    mut ids = one_id(id.ok)
    mut accepted = 0
    mut i = 0
    while i < good.len():
        mut bad = flip(good, i, 1 + (i % 255))
        mut d: Result[str, str] = Age.decrypt(bad, ids)
        if d.is_ok: accepted = accepted + 1
        if i < 300: i = i + 1
        else: i = i + 997
    t.assert_eq_int(accepted, 0, "every single-byte change is rejected")
    mut cut = 0
    mut cut_ok = 0
    while cut < good.len():
        mut d: Result[str, str] = Age.decrypt(good.slice(0, cut), ids)
        if d.is_ok: cut_ok = cut_ok + 1
        if cut < 300: cut = cut + 1
        else: cut = cut + 4099
    t.assert_eq_int(cut_ok, 0, "every truncation is rejected")
    mut tail: Result[str, str] = Age.decrypt(good + "x", ids)
    t.assert_true(tail.is_err, "trailing byte rejected")
    mut arm = Age.armor(good)
    mut aok = 0
    mut j = 0
    while j < arm.len():
        mut d: Result[str, str] = Age.decrypt(flip(arm, j, 32), ids)
        if d.is_ok: aok = aok + 1
        if j < 200: j = j + 1
        else: j = j + 1499
    t.assert_eq_int(aok, 0, "corrupted armor rejected")
    mut junk = ["", "age-encryption.org/v1", "age-encryption.org/v1\n", "age-encryption.org/v1\n---", "age-encryption.org/v1\n-> X25519\n--- AAAA\n", "-----BEGIN AGE ENCRYPTED FILE-----", "-----BEGIN AGE ENCRYPTED FILE-----\n-----END AGE ENCRYPTED FILE-----\n", "\0\0\0\0", "age-encryption.org/v1\n-> " + pattern(5000) + "\n"]
    mut k = 0
    mut jok = 0
    while k < len(junk):
        mut d: Result[str, str] = Age.decrypt(junk[k], ids)
        if d.is_ok: jok = jok + 1
        k = k + 1
    t.assert_eq_int(jok, 0, "junk inputs rejected")

# ── SSH ──────────────────────────────────────────────────────────────────────
def test_ssh_keys(t: TestRunner):
    t.section("ssh: ssh-keygen keys, fingerprints, signatures")
    mut msg = "hello world\n"
    mut fps = ssh_fingerprints()
    mut i = 0
    while i < len(fps):
        mut f = Str.split_keep_empty(fps[i], "|")
        mut n = f.get(0)
        i = i + 1
        mut pr: Result[SshKey, str] = SshKey.parse_public(ssh_file(n + ".pub"))
        t.assert_true(pr.is_ok, f"{n}: public key parses")
        if pr.is_err: continue
        mut pk = pr.ok
        t.assert_eq_str(pk.fingerprint_sha256(), f.get(2), f"{n}: SHA256 fingerprint")
        t.assert_eq_str(pk.fingerprint_md5(), f.get(3), f"{n}: MD5 fingerprint")
        t.assert_eq_str(f"{pk.bits()}", f.get(1), f"{n}: bits")
        t.assert_eq_str(pk.public_line(), ssh_file(n + ".pub").trim(), f"{n}: public line round trip")
        mut pw = ""
        if n == "ed_enc" or n == "rsa_enc": pw = "hunter2"
        if n == "p256_enc": pw = "pw"
        mut kr: Result[SshKey, str] = SshKey.parse_private(ssh_file(n), pw)
        t.assert_true(kr.is_ok and kr.ok.has_private and kr.ok.fingerprint_sha256() == f.get(2), f"{n}: private key parses and matches")
        if kr.is_err:
            print(kr.err)
            continue
        mut k = kr.ok
        if pw.len() > 0:
            mut wrong: Result[SshKey, str] = SshKey.parse_private(ssh_file(n), "wrong")
            t.assert_true(wrong.is_err, f"{n}: wrong passphrase")
            mut nopw: Result[SshKey, str] = SshKey.parse_private(ssh_file(n), "")
            t.assert_true(nopw.is_err, f"{n}: missing passphrase")
        if ssh_file(n + ".sig").len() > 0:
            mut vr: Result[SshKey, str] = SshSig.verify(ssh_file(n + ".sig"), msg, "file")
            t.assert_true(vr.is_ok and vr.ok.fingerprint_sha256() == f.get(2), f"{n}: ssh-keygen -Y sign signature verifies")
            t.assert_false(SshSig.verify_with(ssh_file(n + ".sig"), msg, "email", pk), f"{n}: wrong namespace")
            t.assert_false(SshSig.verify_with(ssh_file(n + ".sig"), "hello world", "file", pk), f"{n}: wrong message")
        mut sr: Result[str, str] = SshSig.sign(k, msg, "file")
        t.assert_true(sr.is_ok and SshSig.verify_with(sr.ok, msg, "file", pk), f"{n}: sign / verify")
        mut raw: Result[str, str] = k.sign_ssh("abc")
        t.assert_true(raw.is_ok and pk.verify_ssh("abc", raw.ok, false) and not pk.verify_ssh("abd", raw.ok, false), f"{n}: raw SSH signature")
        mut p1: Result[str, str] = k.private_pem("", 16)
        mut b1: Result[SshKey, str] = SshKey.parse_private(p1.ok, "")
        t.assert_true(p1.ok.starts_with("-----BEGIN OPENSSH PRIVATE KEY-----\n") and b1.is_ok and b1.ok.comment == k.comment, f"{n}: unencrypted write / read")
        mut p2: Result[str, str] = k.private_pem("s3cret", 2)
        mut b2: Result[SshKey, str] = SshKey.parse_private(p2.ok, "s3cret")
        t.assert_true(b2.is_ok and b2.ok.fingerprint_sha256() == f.get(2), f"{n}: encrypted write / read")
        mut b3: Result[SshKey, str] = SshKey.parse_private(p2.ok, "s3creT")
        t.assert_true(b3.is_err, f"{n}: encrypted key with the wrong passphrase")

def test_ssh_pkey(t: TestRunner):
    t.section("ssh: PKey conversion and generation")
    mut pr: Result[SshKey, str] = SshKey.parse_private(ssh_file("p256"), "")
    mut kp: Result[PKey, str] = pr.ok.to_pkey()
    t.assert_true(kp.is_ok and kp.ok.kind() == KEY_EC_P256 and kp.ok.has_private(), "ECDSA private -> PKey")
    mut back: Result[SshKey, str] = SshKey.from_pkey(kp.ok, "x")
    t.assert_true(back.is_ok and back.ok.has_private and back.ok.fingerprint_sha256() == pr.ok.fingerprint_sha256(), "PKey -> SshKey keeps the private key")
    kp.ok.dispose()
    mut rp: Result[SshKey, str] = SshKey.parse_private(ssh_file("rsa"), "")
    mut rk: Result[PKey, str] = rp.ok.to_pkey()
    t.assert_true(rk.is_ok and rk.ok.has_private() and rk.ok.bits() == 2048, "RSA private -> PKey (CRT exponents rebuilt)")
    mut rpub: Result[SshKey, str] = SshKey.from_pkey(rk.ok, "rsa@test")
    t.assert_eq_str(rpub.ok.public_line(), ssh_file("rsa.pub").trim(), "RSA PKey -> public line")
    rk.ok.dispose()
    mut ep: Result[SshKey, str] = SshKey.parse_public(ssh_file("ed.pub"))
    mut ek: Result[PKey, str] = ep.ok.to_pkey()
    t.assert_true(ek.is_ok and ek.ok.kind() == KEY_ED25519, "Ed25519 public -> PKey")
    mut eb: Result[SshKey, str] = SshKey.from_pkey(ek.ok, "ed@test")
    t.assert_eq_str(eb.ok.public_line(), ssh_file("ed.pub").trim(), "Ed25519 PKey -> public line")
    ek.ok.dispose()
    mut g: Result[SshKey, str] = SshKey.generate_ed25519("me@host")
    mut gs: Result[str, str] = SshSig.sign(g.ok, "data", "git")
    t.assert_true(SshSig.verify_with(gs.ok, "data", "git", g.ok.public_key()), "generated Ed25519 key signs")
    mut ge: Result[SshKey, str] = SshKey.generate_ecdsa(CURVE_P256, "ec@host")
    t.assert_true(ge.ok.key_type == "ecdsa-sha2-nistp256" and ge.ok.has_private, "generated ECDSA key")
    mut ges: Result[str, str] = SshSig.sign(ge.ok, "data", "git")
    t.assert_true(SshSig.verify_with(ges.ok, "data", "git", ge.ok), "generated ECDSA key signs")
    t.assert_false(SshSig.verify_with(ges.ok, "data", "git", g.ok), "signature by a different key")

def test_ssh_authorized(t: TestRunner):
    t.section("ssh: authorized_keys")
    mut ed = ssh_file("ed.pub").trim()
    mut line = "command=\"echo \\\"hi\\\", there\",no-pty,from=\"10.0.0.0/8,192.168.1.*\" " + ed
    mut ar: Result[SshAuthorizedKey, str] = SshAuthorizedKey.parse(line)
    t.assert_true(ar.is_ok, "line with quoted options")
    mut a = ar.ok
    t.assert_eq_int(len(a.options), 3, "three options")
    t.assert_eq_str(a.option("command"), "echo \"hi\", there", "command value unquoted")
    t.assert_eq_str(a.option("from"), "10.0.0.0/8,192.168.1.*", "from value")
    t.assert_true(a.has_option("no-pty") and not a.has_option("no-agent-forwarding"), "has_option")
    t.assert_eq_str(a.key.comment, "ed@test", "comment")
    mut plain: Result[SshAuthorizedKey, str] = SshAuthorizedKey.parse(ssh_file("rsa.pub"))
    t.assert_true(plain.is_ok and len(plain.ok.options) == 0, "line without options")
    mut file = "# keys\n\n" + ed + "\nbogus line here\nno-pty " + ssh_file("p256.pub") + "command=\"unterminated " + ed + "\n"
    mut all = SshAuthorizedKey.parse_file(file)
    t.assert_eq_int(len(all), 2, "parse_file keeps valid lines, skips bad ones")
    mut bad: Result[SshAuthorizedKey, str] = SshAuthorizedKey.parse("ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJO6mSBewktbL+Fs3S6AbDxQDhHG4Mvd1TW6+7/naA== x")
    t.assert_true(bad.is_err, "truncated key blob")
    mut mism: Result[SshKey, str] = SshKey.parse_public("ssh-rsa " + Str.split(ed, " ").get(1))
    t.assert_true(mism.is_err, "type does not match blob")

def test_ssh_corrupt(t: TestRunner):
    t.section("ssh: corrupted input never crashes")
    mut names = ["ed", "p256", "rsa", "ed_enc"]
    mut accepted = 0
    mut i = 0
    while i < len(names):
        mut pem = ssh_file(names[i])
        mut pw = ""
        if names[i] == "ed_enc": pw = "hunter2"
        mut j = 36
        while j < pem.len() - 36:
            mut bad = flip(pem, j, 1)
            mut r: Result[SshKey, str] = SshKey.parse_private(bad, pw)
            if r.is_ok and r.ok.fingerprint_sha256() != SshKey.parse_private(pem, pw).ok.fingerprint_sha256(): accepted = accepted + 1
            j = j + 7
        i = i + 1
    t.assert_eq_int(accepted, 0, "no corrupted private key yields a different key (comment bytes may change)")
    mut sig = ssh_file("p256.sig")
    mut pk: Result[SshKey, str] = SshKey.parse_public(ssh_file("p256.pub"))
    mut sok = 0
    mut k = 30
    while k < sig.len() - 30:
        if SshSig.verify_with(flip(sig, k, 2), "hello world\n", "file", pk.ok): sok = sok + 1
        k = k + 3
    t.assert_eq_int(sok, 0, "corrupted signatures rejected")
    mut junk = ["", "ssh-ed25519", "ssh-ed25519 AAAA", "ssh-ed25519 !!!!", "-----BEGIN OPENSSH PRIVATE KEY-----\nAAAA\n-----END OPENSSH PRIVATE KEY-----\n"]
    mut q = 0
    mut jok = 0
    while q < len(junk):
        mut a: Result[SshKey, str] = SshKey.parse_public(junk[q])
        mut b: Result[SshKey, str] = SshKey.parse_private(junk[q], "")
        mut c: Result[SshKey, str] = SshSig.verify(junk[q], "x", "file")
        if a.is_ok or b.is_ok or c.is_ok: jok = jok + 1
        q = q + 1
    t.assert_eq_int(jok, 0, "junk rejected")

def main():
    mut t = TestRunner.init("138_crypto_age_ssh")
    test_scrypt(t)
    test_bech32(t)
    test_age_keys(t)
    test_age_vectors(t)
    test_age_roundtrip(t)
    test_age_corrupt(t)
    test_ssh_keys(t)
    test_ssh_pkey(t)
    test_ssh_authorized(t)
    test_ssh_corrupt(t)
    t.summary()

