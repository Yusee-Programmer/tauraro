# tests/lang/10_cli.tr - std.cli clap-style argument parser.
#
# Uses synthetic Vec[str] argument lists (not real process argv) so the
# parser can be exercised deterministically.

from std.test import TestRunner
from std.cli import Cli, CLI_INT

def main():
    mut t = TestRunner.init("10_cli")

    # ── Flags ────────────────────────────────────────────────────────────────
    t.section("flags")
    mut app1 = Cli.init("mytool", "does a thing")
    app1.flag("verbose", "v", "enable verbose output")
    mut args1 = Vec[str].init(1)
    args1.push("--verbose")
    mut p1 = app1.parse(args1)
    t.assert_true(p1.ok, "flag parse ok")
    t.assert_true(p1.has_flag("verbose"), "long flag present")
    t.assert_false(p1.has_flag("missing"), "unrelated flag absent")

    mut app1b = Cli.init("mytool", "does a thing")
    app1b.flag("verbose", "v", "enable verbose output")
    mut args1b = Vec[str].init(1)
    args1b.push("-v")
    mut p1b = app1b.parse(args1b)
    t.assert_true(p1b.ok, "short flag parse ok")
    t.assert_true(p1b.has_flag("verbose"), "short flag maps to long name")

    t.section("unknown flag error")
    mut app1c = Cli.init("mytool", "does a thing")
    app1c.flag("verbose", "v", "enable verbose output")
    mut args1c = Vec[str].init(1)
    args1c.push("--bogus")
    mut p1c = app1c.parse(args1c)
    t.assert_false(p1c.ok, "unknown flag rejected")
    t.assert_contains(p1c.error, "bogus", "error names the bad flag")

    # ── Options with values ─────────────────────────────────────────────────
    t.section("options with values")
    mut app2 = Cli.init("mytool", "does a thing")
    app2.option("output", "o", "output path", "a.out")
    mut args2 = Vec[str].init(2)
    args2.push("--output")
    args2.push("build/out.bin")
    mut p2 = app2.parse(args2)
    t.assert_true(p2.ok, "option parse ok")
    t.assert_eq_str(p2.get_option("output"), "build/out.bin", "long option value")

    mut app2b = Cli.init("mytool", "does a thing")
    app2b.option("output", "o", "output path", "a.out")
    mut args2b = Vec[str].init(0)
    mut p2b = app2b.parse(args2b)
    t.assert_true(p2b.ok, "option default parse ok")
    t.assert_eq_str(p2b.get_option("output"), "a.out", "default value used when option absent")

    mut app2c = Cli.init("mytool", "does a thing")
    app2c.option("output", "o", "output path", "a.out")
    mut args2c = Vec[str].init(2)
    args2c.push("-o")
    args2c.push("short.bin")
    mut p2c = app2c.parse(args2c)
    t.assert_true(p2c.ok, "short option parse ok")
    t.assert_eq_str(p2c.get_option("output"), "short.bin", "short option value")

    mut app2d = Cli.init("mytool", "does a thing")
    app2d.option("output", "o", "output path", "a.out")
    mut args2d = Vec[str].init(1)
    args2d.push("--output=inline.bin")
    mut p2d = app2d.parse(args2d)
    t.assert_true(p2d.ok, "--name=value parse ok")
    t.assert_eq_str(p2d.get_option("output"), "inline.bin", "--name=value form")

    # ── Typed options ────────────────────────────────────────────────────────
    t.section("typed options")
    mut app3 = Cli.init("mytool", "does a thing")
    app3.option_typed("port", "p", "port number", "8080", CLI_INT())
    mut args3 = Vec[str].init(2)
    args3.push("--port")
    args3.push("9090")
    mut p3 = app3.parse(args3)
    t.assert_true(p3.ok, "typed int option parse ok")
    t.assert_eq_int(p3.get_option_int("port"), 9090, "typed int value")

    mut app3b = Cli.init("mytool", "does a thing")
    app3b.option_typed("port", "p", "port number", "8080", CLI_INT())
    mut args3b = Vec[str].init(2)
    args3b.push("--port")
    args3b.push("abc")
    mut p3b = app3b.parse(args3b)
    t.assert_false(p3b.ok, "non-integer value rejected for int option")
    t.assert_contains(p3b.error, "port", "type error names the option")
    t.assert_contains(p3b.error, "integer", "type error explains expected type")

    # ── Required option missing ─────────────────────────────────────────────
    t.section("required option missing")
    mut app3c = Cli.init("mytool", "does a thing")
    app3c.option_typed_required("port", "p", "port number", CLI_INT())
    mut args3c = Vec[str].init(0)
    mut p3c = app3c.parse(args3c)
    t.assert_false(p3c.ok, "missing required option rejected")
    t.assert_contains(p3c.error, "port", "required-option error names the option")

    # ── Positionals ──────────────────────────────────────────────────────────
    t.section("positionals: required + optional")
    mut app4 = Cli.init("mytool", "does a thing")
    app4.positional("input", "input file", true)
    app4.positional("output", "output file", false)
    mut args4 = Vec[str].init(2)
    args4.push("in.txt")
    args4.push("out.txt")
    mut p4 = app4.parse(args4)
    t.assert_true(p4.ok, "positionals parse ok")
    t.assert_eq_str(p4.get_positional("input"), "in.txt", "required positional value")
    t.assert_eq_str(p4.get_positional("output"), "out.txt", "optional positional value")

    mut app4b = Cli.init("mytool", "does a thing")
    app4b.positional("input", "input file", true)
    app4b.positional("output", "output file", false)
    mut args4b = Vec[str].init(1)
    args4b.push("in.txt")
    mut p4b = app4b.parse(args4b)
    t.assert_true(p4b.ok, "optional positional may be omitted")
    t.assert_eq_str(p4b.get_positional("input"), "in.txt", "required positional still bound")
    t.assert_eq_str(p4b.get_positional("output"), "", "omitted optional positional is empty")

    t.section("missing required positional error")
    mut app4c = Cli.init("mytool", "does a thing")
    app4c.positional("input", "input file", true)
    mut args4c = Vec[str].init(0)
    mut p4c = app4c.parse(args4c)
    t.assert_false(p4c.ok, "missing required positional rejected")
    t.assert_contains(p4c.error, "input", "missing-positional error names the arg")

    # ── Subcommands ──────────────────────────────────────────────────────────
    t.section("subcommands")
    mut app5 = Cli.init("mytool", "does a thing")
    mut build_cmd = app5.subcommand("build", "build the project")
    build_cmd.flag("release", "r", "build in release mode")
    mut test_cmd = app5.subcommand("test", "run tests")
    test_cmd.positional("name", "test name filter", false)

    mut args5 = Vec[str].init(2)
    args5.push("build")
    args5.push("--release")
    mut p5 = app5.parse(args5)
    t.assert_true(p5.ok, "subcommand parse ok")
    t.assert_eq_str(p5.subcommand_name, "build", "subcommand dispatched to build")
    mut sub5 = p5.subcommand()
    t.assert_true(sub5.has_flag("release"), "subcommand's own flag parsed")

    mut args5b = Vec[str].init(2)
    args5b.push("test")
    args5b.push("mytest")
    mut p5b = app5.parse(args5b)
    t.assert_true(p5b.ok, "second subcommand parse ok")
    t.assert_eq_str(p5b.subcommand_name, "test", "subcommand dispatched to test")
    mut sub5b = p5b.subcommand()
    t.assert_eq_str(sub5b.get_positional("name"), "mytest", "subcommand positional parsed")

    mut args5c = Vec[str].init(1)
    args5c.push("bogus-cmd")
    mut p5c = app5.parse(args5c)
    t.assert_false(p5c.ok, "unknown subcommand rejected")
    t.assert_contains(p5c.error, "bogus-cmd", "unknown-subcommand error names it")

    # ── Help text ────────────────────────────────────────────────────────────
    t.section("generated help text")
    mut app6 = Cli.init("mytool", "does a thing")
    app6.flag("verbose", "v", "enable verbose output")
    app6.option("output", "o", "output path", "a.out")
    app6.positional("input", "input file to read", true)
    mut build6 = app6.subcommand("build", "build the project")
    build6.flag("release", "r", "build in release mode")

    mut help_text = app6.help_text()
    t.assert_contains(help_text, "mytool", "help mentions program name")
    t.assert_contains(help_text, "does a thing", "help mentions about text")
    t.assert_contains(help_text, "--verbose", "help lists the flag")
    t.assert_contains(help_text, "-v", "help lists the short flag")
    t.assert_contains(help_text, "enable verbose output", "help lists flag description")
    t.assert_contains(help_text, "--output", "help lists the option")
    t.assert_contains(help_text, "a.out", "help lists the default value")
    t.assert_contains(help_text, "input", "help lists the positional")
    t.assert_contains(help_text, "build", "help lists the subcommand")
    t.assert_contains(help_text, "build the project", "help lists subcommand description")
    t.assert_contains(help_text, "--help", "help lists the help flag itself")

    mut args6 = Vec[str].init(1)
    args6.push("--help")
    mut p6 = app6.parse(args6)
    t.assert_true(p6.ok, "--help does not error")
    t.assert_true(p6.help_requested, "--help sets help_requested")

    mut args6b = Vec[str].init(1)
    args6b.push("-h")
    mut p6b = app6.parse(args6b)
    t.assert_true(p6b.help_requested, "-h also sets help_requested")

    # ── --version ────────────────────────────────────────────────────────────
    t.section("version flag")
    mut app7 = Cli.init("mytool", "does a thing")
    app7.version("1.2.3")
    mut args7 = Vec[str].init(1)
    args7.push("--version")
    mut p7 = app7.parse(args7)
    t.assert_true(p7.ok, "--version does not error")
    t.assert_true(p7.version_requested, "--version sets version_requested")

    t.summary()
