def test_refs(t: TestRunner):
    t.section("cell references")
    t.assert_eq_str(xlsx_col_name(1), "A", "col 1")
    t.assert_eq_str(xlsx_col_name(26), "Z", "col 26")
    t.assert_eq_str(xlsx_col_name(27), "AA", "col 27")
    t.assert_eq_str(xlsx_col_name(16384), "XFD", "last column")
    t.assert_eq_int(xlsx_col_index("XFD"), 16384, "XFD")
    t.assert_eq_int(xlsx_col_index("ab"), 28, "lower case letters")
    t.assert_eq_int(xlsx_col_index("XFE"), 0, "past the last column")
    t.assert_eq_str(xlsx_ref(3, 2), "B3", "ref B3")
    t.assert_eq_int(xlsx_ref_row("$C$17"), 17, "absolute row")
    t.assert_eq_int(xlsx_ref_col("$C$17"), 3, "absolute col")
    t.assert_false(xlsx_ref_valid("A0"), "row 0 invalid")
    t.assert_false(xlsx_ref_valid("B"), "no row")
    t.assert_false(xlsx_ref_valid("A1B"), "trailing garbage")
    t.assert_false(xlsx_ref_valid("A1048577"), "past the last row")
    mut r: Result[CellRange, str] = CellRange.parse("C10:A1")
    t.assert_true(r.is_ok, "range parses")
    if r.is_ok:
        t.assert_eq_str(r.ok.to_string(), "A1:C10", "range normalised")
        t.assert_eq_str(r.ok.to_abs_string(), "$A$1:$C$10", "absolute form")
        t.assert_eq_int(r.ok.row_count(), 10, "rows")
        t.assert_eq_int(r.ok.col_count(), 3, "cols")
        t.assert_true(r.ok.contains(5, 2), "contains B5")
        t.assert_false(r.ok.contains(11, 1), "not A11")
    mut one: Result[CellRange, str] = CellRange.parse("B2")
    t.assert_true(one.is_ok and one.ok.to_string() == "B2", "single-cell range")
    mut bad: Result[CellRange, str] = CellRange.parse("A1:")
    t.assert_true(bad.is_err, "bad range rejected")
    t.assert_eq_str(xlsx_shift_formula("SUM(A1:$B$2)+LOG10(C3)", 2, 1), "SUM(B3:$B$2)+LOG10(D5)", "shift relative refs, keep absolute and names")
    t.assert_eq_str(xlsx_shift_formula("'My Sheet'!D4&\"A1\"", 1, 0), "'My Sheet'!D5&\"A1\"", "sheet refs move, strings do not")
    t.assert_eq_str(xlsx_shift_formula("A1*2", -1, 0), "#REF!*2", "shift off the sheet")

def test_dates(t: TestRunner):
    t.section("date serials and formats")
    t.assert_eq_float(xlsx_date_serial(2024, 1, 15, 0, 0, 0, false), 45306.0, 0.0, "2024-01-15")
    t.assert_eq_float(xlsx_date_serial(1900, 1, 1, 0, 0, 0, false), 1.0, 0.0, "1900-01-01 is 1")
    t.assert_eq_float(xlsx_date_serial(1900, 2, 28, 0, 0, 0, false), 59.0, 0.0, "1900-02-28 is 59")
    t.assert_eq_float(xlsx_date_serial(1900, 3, 1, 0, 0, 0, false), 61.0, 0.0, "1900-03-01 is 61 (phantom leap day)")
    t.assert_eq_float(xlsx_date_serial(1904, 1, 2, 12, 0, 0, true), 1.5, 0.0, "1904 system")
    mut d = XlsxDate.from_serial(45291.57326388889, false)
    t.assert_eq_str(d.date_string() + " " + d.time_string(), "2023-12-31 13:45:30", "serial to date and time")
    mut d2 = XlsxDate.from_serial(61.0, false)
    t.assert_eq_str(d2.date_string(), "1900-03-01", "serial 61")
    mut d3 = XlsxDate.from_serial(0.0, true)
    t.assert_eq_str(d3.date_string(), "1904-01-01", "1904 epoch")
    mut d4 = XlsxDate.from_serial(0.99999999, false)
    t.assert_eq_str(d4.time_string(), "00:00:00", "rounds up to midnight")
    t.assert_eq_str(d4.date_string(), "1900-01-01", "and the next day")
    t.assert_true(xlsx_is_date_format("yyyy-mm-dd"), "yyyy-mm-dd")
    t.assert_true(xlsx_is_date_format("[$-409]d\\-mmm\\-yyyy;@"), "locale-tagged date")
    t.assert_true(xlsx_is_date_format("[h]:mm:ss"), "elapsed time")
    t.assert_true(xlsx_is_date_format("h:mm AM/PM"), "12-hour time")
    t.assert_false(xlsx_is_date_format("0.00%"), "percent")
    t.assert_false(xlsx_is_date_format("\"Day\" 0.00"), "quoted text is not a date")
    t.assert_false(xlsx_is_date_format("[Red]#,##0"), "colour section")
    t.assert_false(xlsx_is_date_format("0.00E+00"), "scientific")
    t.assert_false(xlsx_is_date_format("General"), "General")
    t.assert_eq_str(xlsx_num_str(42.0), "42", "integral float")
    t.assert_eq_str(xlsx_num_str(0.1), "0.1", "shortest 0.1")
    t.assert_eq_str(xlsx_num_str(1.0 / 3.0), "0.3333333333333333", "round-trip digits")
    t.assert_eq_str(xlsx_num_str(-2.5), "-2.5", "negative")
    t.assert_eq_str(xlsx_unescape_ooxml("a_x000D_b_x005F_x"), "a\rb_x", "_xHHHH_ escapes")

def test_openpyxl(t: TestRunner) throws str:
    t.section("read a workbook written by openpyxl")
    mut data = fixture_a()
    t.assert_eq_int(data.len(), 6843, "fixture decoded")
    mut z = ZipReader.open(data, data.len())
    t.assert_true(z.ok, "zip directory")
    mut si = z.find_entry("xl/worksheets/sheet1.xml")
    t.assert_true(si >= 0 and z.entries.get(si).method == 8, "entries are deflated")
    mut sx = z.read_entry(si)
    t.assert_true(sx.len() == z.entries.get(si).usize and xlsx_xml_well_formed(sx), "deflated entry inflates (built-in codec)")
    mut wb = Workbook.from_bytes(data)?
    t.assert_eq_int(wb.sheet_count(), 3, "three sheets")
    mut names = wb.sheet_names()
    t.assert_eq_str(names[0] + "," + names[1] + "," + names[2], "Data,Hidden,Empty", "sheet names")
    t.assert_eq_str(wb.title, "Fixture A", "docProps title")
    t.assert_false(wb.date1904, "1900 date system")
    mut hid = wb.sheet("Hidden")?
    t.assert_true(hid.is_hidden() and hid.state == "hidden", "hidden sheet")
    mut ws = wb.sheet("data")?
    t.assert_eq_str(ws.name, "Data", "case-insensitive lookup")
    t.assert_eq_str(ws.cell("A1").display(), "Name", "A1")
    mut b2 = ws.cell("B2")
    t.assert_true(b2.is_number(), "B2 is a number")
    t.assert_eq_float(b2.as_float(), 3.141592653589793, 0.0, "B2 exact")
    t.assert_eq_int(ws.cell("B3").as_int(), 42, "B3 int")
    mut b4 = ws.cell("B4")
    t.assert_true(b4.is_bool() and not b4.as_bool(), "B4 FALSE")
    mut b5 = ws.cell("B5")
    t.assert_true(b5.is_date(), "datetime cell is a date")
    t.assert_eq_str(b5.display(), "2024-01-15 13:45:30", "datetime value")
    mut dt = b5.as_datetime()
    t.assert_true(dt.year == 2024 and dt.month == 1 and dt.day == 15 and dt.hour == 13 and dt.minute == 45 and dt.second == 30, "as_datetime")
    t.assert_eq_str(ws.cell("B6").display(), "2023-12-31", "custom date format dd/mm/yyyy")
    t.assert_eq_str(ws.number_format("B6"), "dd/mm/yyyy", "number format code")
    t.assert_eq_str(ws.cell("B7").display(), "06:30:00", "time of day")
    mut b8 = ws.cell("B8")
    t.assert_true(b8.has_formula() and b8.formula == "B3*2" and b8.is_empty(), "formula without a cached value")
    mut b9 = ws.cell("B9")
    t.assert_true(b9.is_error() and b9.display() == "#DIV/0!", "error cell")
    t.assert_true(ws.cell("B10").is_number() and ws.number_format("B10") == "0.0%", "percent stays a number")
    t.assert_eq_str(ws.cell("A11").display(), "héllo – 日本", "UTF-8 text")
    mut b11 = ws.cell("B11")
    t.assert_true(b11.rich and b11.display() == "plain bold end", "rich text concatenated")
    mut runs = ws.rich_runs("B11")
    t.assert_eq_int(runs.len(), 3, "three runs")
    if runs.len() == 3:
        t.assert_true(runs[1].text == "bold" and runs[1].bold and not runs[0].bold, "bold run")
    t.assert_eq_float(ws.cell("B12").as_float(), -1.5e-7, 0.0, "small negative")
    t.assert_eq_str(ws.cell("E20").display(), "far", "sparse cell")
    t.assert_true(ws.cell("C3").is_empty(), "missing cell is empty")
    t.assert_eq_int(ws.max_row(), 20, "max_row")
    t.assert_eq_int(ws.max_col(), 5, "max_col")
    t.assert_eq_str(ws.dimension, "A1:E20", "dimension")
    t.assert_eq_str(ws.merged_range_at(2, 5), "D1:E2", "merged cells")
    t.assert_eq_float(ws.column_width(1), 18.5, 0.0, "column width")
    t.assert_eq_float(ws.column_width(2), 0.0, 0.0, "default width")
    t.assert_eq_float(ws.row_height(3), 30.0, 0.0, "row height")
    t.assert_true(ws.freeze_rows == 1 and ws.freeze_cols == 1, "freeze panes B2")
    t.assert_eq_str(ws.auto_filter, "A1:B12", "auto filter")
    t.assert_eq_str(ws.link_at("A2").target, "https://tauraro.dev/x", "hyperlink")
    mut a1 = ws.style_of("A1")
    t.assert_true(a1.bold and a1.italic and a1.font_color == "00FF0000", "font style")
    mut c1 = ws.style_of("C1")
    t.assert_true(c1.fill_color == "0000FF00" and c1.border_left == "thick" and c1.border_bottom == "dashed", "fill and borders")
    t.assert_true(c1.h_align == "right" and c1.wrap, "alignment")
    mut rows = ws.rows()
    t.assert_eq_int(rows.len(), 20, "rows()")
    # (bound to locals: rows[0].len() on a List[List[T]] miscompiles)
    mut row0 = rows[0]
    t.assert_eq_int(row0.len(), 5, "row width")
    mut row2 = rows[2]
    t.assert_eq_str(row2[1].display(), "42", "rows()[2][1]")
    mut csv = ws.to_csv()
    t.assert_starts_with(csv, "Name,Value,,,\r\npi,3.141592653589793,,,\r\n", "to_csv")
    t.assert_ends_with(csv, ",,,,far\r\n", "to_csv last row")
    mut empty = wb.sheet("Empty")?
    t.assert_true(empty.max_row() == 0 and empty.to_csv() == "", "empty sheet")

def test_excel_style(t: TestRunner) throws str:
    t.section("read an Excel-style package")
    mut wb = Workbook.from_bytes(fixture_b())?
    t.assert_true(wb.date1904, "1904 date system")
    t.assert_eq_int(wb.active, 1, "active tab")
    mut ws = wb.sheet_at(0)?
    t.assert_eq_str(ws.name, "Calc", "first sheet")
    mut b1 = ws.cell("B1")
    t.assert_eq_str(b1.display(), "Red and plain", "rich text without the phonetic run")
    mut runs = ws.rich_runs("B1")
    t.assert_true(runs.len() == 2 and runs[0].bold and runs[0].color == "FFFF0000" and runs[0].font == "Arial" and runs[0].size == 12.0, "run properties")
    t.assert_eq_str(ws.cell("C1").display(), "line1\r\nline2 & more", "_x000D_ and character references")
    mut b2 = ws.cell("B2")
    t.assert_true(b2.formula == "A2*2" and b2.is_number() and b2.as_int() == 20, "formula with cached value")
    t.assert_eq_str(ws.cell("C2").formula, "A2+$A$2+B2", "shared formula master")
    t.assert_eq_str(ws.cell("C3").formula, "A3+$A$2+B3", "shared formula expanded")
    t.assert_eq_str(ws.cell("C4").formula, "A4+$A$2+B4", "shared formula expanded again")
    t.assert_eq_int(ws.cell("C4").as_int(), 46, "shared formula cached value")
    mut d2 = ws.cell("D2")
    t.assert_true(d2.is_string() and d2.display() == "x10" and d2.formula == "\"x\"&A2", "string formula result")
    t.assert_true(ws.cell("D3").is_bool() and ws.cell("D3").as_bool(), "boolean formula result")
    mut b4 = ws.cell("B4")
    t.assert_true(b4.is_error() and b4.display() == "#DIV/0!" and b4.formula == "1/0", "error formula result")
    t.assert_eq_str(ws.cell("D4").display(), "inline <s>", "inline string")
    t.assert_eq_str(ws.cell("A5").display(), "1904-01-01", "built-in date format 14, 1904 epoch")
    t.assert_eq_str(ws.cell("B5").display(), "2027-03-16 12:00:00", "custom date format in 1904")
    t.assert_true(ws.cell("C5").is_number(), "quoted Day text is not a date")
    t.assert_eq_str(ws.cell("D5").display(), "2024-02-29 12:00:00", "t=d ISO date")
    t.assert_eq_str(ws.cell("A6").display() + ws.cell("B6").display() + ws.cell("D6").display(), "124", "cells without r=")
    t.assert_eq_str(ws.merged[0], "A7:B8", "merge")
    mut p = wb.sheet("Prefixed")?
    t.assert_eq_str(p.state, "veryHidden", "veryHidden")
    t.assert_eq_str(p.cell("B2").display(), "pre", "x: prefixed elements")
    t.assert_eq_float(p.cell("C2").as_float(), 0.0015, 0.0, "exponent number")
    t.assert_true(p.freeze_rows == 3 and p.freeze_cols == 2, "frozen pane")
    t.assert_true(p.column_width(3) == 12.75 and p.column_width(5) == 0.0, "column range width")
    t.assert_eq_float(p.row_height(2), 25.0, 0.0, "row height")

def build_book() throws str -> Workbook:
    mut wb = Workbook.init()
    wb.title = "Report & <Summary>"
    mut ws = wb.add_sheet("Sales Q1")?
    ws.set_str("A1", "Item")?
    ws.set_str("B1", "Qty")?
    ws.set_str("C1", "Price")?
    ws.set_str("D1", "When")?
    ws.set_str("E1", "Total")?
    mut hdr = CellStyle.init()
    hdr.bold = true
    hdr.fill_color = "#DDEBF7"
    hdr.set_border("thin")
    hdr.border_color = "333333"
    hdr.h_align = "center"
    ws.set_range_style("A1:E1", hdr)?
    mut money = CellStyle.init()
    money.num_fmt = "#,##0.00"
    mut r = 2
    while r <= 4:
        mut nm = f"item {r - 1}"
        ws.set_str_at(r, 1, nm)
        ws.set_int_at(r, 2, r * 3)
        ws.set_float_at(r, 3, (r as float) * 1.25)
        ws.set_style_at(r, 3, money)
        ws.set_date_at(r, 4, 2024, r, 10)
        mut f = f"=B{r}*C{r}"
        ws.set_formula_at(r, 5, f)
        r = r + 1
    ws.set_bool("A6", true)?
    ws.set_error("B6", "#N/A")?
    mut wrap = CellStyle.init()
    wrap.wrap = true
    wrap.v_align = "top"
    wrap.italic = true
    wrap.font_name = "Arial"
    wrap.font_size = 9.0
    wrap.font_color = "FF0000"
    ws.set_str("A7", "  two\nlines & <tags> _x0041_ \x01")?
    ws.set_style("A7", wrap)?
    mut dt = DateTime.in_zone(2024, 7, 4, 18, 30, 15, TimeZone.utc())
    ws.set_datetime("D7", dt)?
    mut pct = CellStyle.init()
    pct.num_fmt = "0.0%"
    ws.set_float("C7", 0.375)?
    ws.set_style("C7", pct)?
    mut dfmt = CellStyle.init()
    dfmt.num_fmt = "dd mmm yyyy"
    ws.set_date("D8", 1999, 12, 31)?
    ws.set_style("D8", dfmt)?
    ws.set_column_width(1, 24.0)
    ws.set_columns_width(2, 3, 11.5)
    ws.set_row_height(1, 22.5)
    ws.freeze_panes("B2")?
    ws.merge("A10:C11")?
    ws.set_str("A10", "merged")?
    ws.set_auto_filter("A1:E4")?
    ws.add_link("A2", "https://example.com/?q=1&r=2")?
    ws.add_internal_link("A3", "'Other sheet'!B2")?
    ws.set_str("Z30", "sparse")?
    mut o = wb.add_sheet("Other sheet")?
    o.set_str("B2", "Item")?
    o.set_float("A1", 1.0 / 3.0)?
    o.state = "hidden"
    mut e = wb.add_sheet("Notes")?
    e.set_str("A1", "1904?")?
    wb.active = 2
    return wb

def test_write(t: TestRunner) throws str:
    t.section("write and read back")
    mut wb = build_book()?
    mut data = wb.to_bytes()?
    mut z = ZipReader.open(data, data.len())
    t.assert_true(z.ok, "output is a ZIP archive")
    t.assert_eq_str(z.entry_name(0), "[Content_Types].xml", "content types first")
    mut parts = ["[Content_Types].xml", "_rels/.rels", "docProps/core.xml", "docProps/app.xml", "xl/workbook.xml", "xl/_rels/workbook.xml.rels", "xl/styles.xml", "xl/sharedStrings.xml", "xl/worksheets/sheet1.xml", "xl/worksheets/sheet2.xml", "xl/worksheets/sheet3.xml", "xl/worksheets/_rels/sheet1.xml.rels"]
    mut all_ok = true
    for p in parts:
        mut i = z.find_entry(p)
        if i < 0:
            all_ok = false
            t.assert_true(false, "missing part " + p)
        else:
            mut x = z.read_entry(i)
            if not xlsx_xml_well_formed(x):
                all_ok = false
                t.assert_true(false, "malformed XML in " + p)
    t.assert_true(all_ok, "all parts present and well-formed")
    mut s1 = z.read_entry(z.find_entry("xl/worksheets/sheet1.xml"))
    t.assert_contains(s1, "<pane xSplit=\"1\" ySplit=\"1\" topLeftCell=\"B2\" activePane=\"bottomRight\" state=\"frozen\"/>", "freeze pane XML")
    t.assert_contains(s1, "<c r=\"E2\"><f>B2*C2</f></c>", "formula XML")
    t.assert_contains(s1, "<mergeCell ref=\"A10:C11\"/>", "merge XML")
    mut sw = z.read_entry(z.find_entry("xl/workbook.xml"))
    t.assert_contains(sw, "<definedName name=\"_xlnm._FilterDatabase\" localSheetId=\"0\" hidden=\"1\">'Sales Q1'!$A$1:$E$4</definedName>", "filter database name")
    t.assert_contains(sw, "state=\"hidden\"", "hidden sheet")
    mut rels = z.read_entry(z.find_entry("xl/worksheets/_rels/sheet1.xml.rels"))
    t.assert_contains(rels, "Target=\"https://example.com/?q=1&amp;r=2\" TargetMode=\"External\"", "hyperlink relationship")

    mut back = Workbook.from_bytes(data)?
    t.assert_eq_int(back.sheet_count(), 3, "sheets read back")
    t.assert_eq_str(back.title, "Report & <Summary>", "title round trip")
    t.assert_eq_int(back.active, 2, "active sheet")
    mut ws = back.sheet("Sales Q1")?
    t.assert_eq_str(ws.cell("A1").display(), "Item", "header")
    t.assert_eq_int(ws.cell("B4").as_int(), 12, "int")
    t.assert_eq_float(ws.cell("C3").as_float(), 3.75, 0.0, "float")
    t.assert_true(ws.cell("D2").is_date() and ws.cell("D2").display() == "2024-02-10", "date gets a date format")
    t.assert_eq_str(ws.number_format("D2"), "yyyy-mm-dd", "default date format")
    t.assert_eq_str(ws.cell("D7").display(), "2024-07-04 18:30:15", "datetime")
    t.assert_eq_str(ws.number_format("D7"), "yyyy-mm-dd hh:mm:ss", "default datetime format")
    t.assert_true(ws.cell("D8").is_date() and ws.number_format("D8") == "dd mmm yyyy" and ws.cell("D8").display() == "1999-12-31", "custom date format")
    t.assert_eq_str(ws.cell("E3").formula, "B3*C3", "formula")
    t.assert_true(ws.cell("A6").is_bool() and ws.cell("A6").as_bool(), "bool")
    t.assert_true(ws.cell("B6").is_error() and ws.cell("B6").display() == "#N/A", "error")
    t.assert_eq_str(ws.cell("A7").display(), "  two\nlines & <tags> _x0041_ \x01", "escaping round trip")
    mut st = ws.style_of("A7")
    t.assert_true(st.wrap and st.v_align == "top" and st.italic and st.font_name == "Arial" and st.font_size == 9.0 and st.font_color == "FFFF0000", "wrap / font style")
    mut h = ws.style_of("C1")
    t.assert_true(h.bold and h.fill_color == "FFDDEBF7" and h.border_top == "thin" and h.border_color == "FF333333" and h.h_align == "center", "header style")
    t.assert_eq_str(ws.number_format("C2"), "#,##0.00", "built-in number format by code")
    t.assert_eq_str(ws.number_format("C7"), "0.0%", "custom number format")
    t.assert_eq_float(ws.column_width(1), 24.0, 0.0, "width A")
    t.assert_eq_float(ws.column_width(3), 11.5, 0.0, "width C")
    t.assert_eq_float(ws.row_height(1), 22.5, 0.0, "row height")
    t.assert_true(ws.freeze_rows == 1 and ws.freeze_cols == 1, "freeze")
    t.assert_eq_str(ws.merged_range_at(11, 2), "A10:C11", "merged")
    t.assert_eq_str(ws.auto_filter, "A1:E4", "filter")
    t.assert_eq_str(ws.link_at("A2").target, "https://example.com/?q=1&r=2", "external link")
    t.assert_eq_str(ws.link_at("A3").location, "'Other sheet'!B2", "internal link")
    t.assert_eq_str(ws.cell("Z30").display(), "sparse", "sparse cell")
    mut o = back.sheet("Other sheet")?
    t.assert_true(o.is_hidden(), "hidden")
    t.assert_eq_float(o.cell("A1").as_float(), 1.0 / 3.0, 0.0, "full float precision")

    # save to disk, reopen, and re-save what was read
    mut path = "/tmp/tauraro_139_xlsx.xlsx"
    wb.save(path)?
    mut disk = Workbook.open(path)?
    mut dws = disk.sheet("Sales Q1")?
    t.assert_eq_str(dws.to_csv(), ws.to_csv(), "file and in-memory copies agree")
    mut again = disk.to_bytes()?
    mut third = Workbook.from_bytes(again)?
    mut tws = third.sheet("Sales Q1")?
    t.assert_eq_str(tws.to_csv(), ws.to_csv(), "read-modify-write keeps values")
    t.assert_true(tws.style_of("C1").bold and tws.number_format("D8") == "dd mmm yyyy", "and styles")
    Fs.delete(path)

    # the openpyxl workbook re-saved
    mut fa = Workbook.from_bytes(fixture_a())?
    mut fa2 = Workbook.from_bytes(fa.to_bytes()?)?
    mut s_a = fa.sheet("Data")?
    mut s_b = fa2.sheet("Data")?
    t.assert_eq_str(s_b.to_csv(), s_a.to_csv(), "openpyxl workbook survives a re-save")
    t.assert_true(s_b.cell("B5").is_date() and s_b.style_of("A1").bold and s_b.link_at("A2").target == "https://tauraro.dev/x", "dates, styles and links survive")

    # 1904 workbook
    mut w4 = Workbook.init()
    w4.date1904 = true
    mut s4 = w4.add_sheet("D")?
    s4.set_date("A1", 2000, 1, 1)?
    mut b4 = Workbook.from_bytes(w4.to_bytes()?)?
    mut r4 = b4.sheet("D")?
    t.assert_true(b4.date1904 and r4.cell("A1").display() == "2000-01-01" and r4.cell("A1").num == 35064.0, "1904 dates")

def test_errors(t: TestRunner):
    t.section("errors")
    mut wb = Workbook.init()
    mut e1: Result[Worksheet, str] = wb.add_sheet("bad/name")
    t.assert_true(e1.is_err, "forbidden character")
    mut e2: Result[Worksheet, str] = wb.add_sheet("")
    t.assert_true(e2.is_err, "empty name")
    mut ok: Result[Worksheet, str] = wb.add_sheet("One")
    t.assert_true(ok.is_ok, "valid name")
    mut e3: Result[Worksheet, str] = wb.add_sheet("ONE")
    t.assert_true(e3.is_err, "duplicate (ignoring case)")
    mut e4: Result[Worksheet, str] = wb.sheet("Two")
    t.assert_true(e4.is_err and e4.err.contains("no sheet"), "missing sheet")
    if ok.is_ok:
        mut ws = ok.ok
        mut e5: Result[void, str] = ws.set_str("1A", "x")
        t.assert_true(e5.is_err, "invalid reference")
        mut m1: Result[void, str] = ws.merge("A1:B2")
        mut m2: Result[void, str] = ws.merge("B2:C3")
        t.assert_true(m1.is_ok and m2.is_err, "overlapping merges rejected")
        t.assert_true(ws.cell("nonsense").is_empty(), "cell() on a bad reference is empty")
    mut g: Result[Workbook, str] = Workbook.from_bytes("not a zip file at all")
    t.assert_true(g.is_err, "garbage rejected")
    mut z: Result[Workbook, str] = Workbook.from_bytes(fixture_a().slice(0, 3000))
    t.assert_true(z.is_err, "truncated archive rejected")
    mut nf: Result[Workbook, str] = Workbook.open("/nonexistent/x.xlsx")
    t.assert_true(nf.is_err, "missing file")
    mut empty = Workbook.init()
    mut eb: Result[str, str] = empty.to_bytes()
    t.assert_true(eb.is_err, "no sheets")

def main():
    mut t = TestRunner.init("139_xlsx")
    test_refs(t)
    test_dates(t)
    mut a: Result[void, str] = test_openpyxl(t)
    if a.is_err: t.assert_true(false, "openpyxl fixture: " + a.err)
    mut b: Result[void, str] = test_excel_style(t)
    if b.is_err: t.assert_true(false, "Excel-style fixture: " + b.err)
    mut c: Result[void, str] = test_write(t)
    if c.is_err: t.assert_true(false, "write: " + c.err)
    test_errors(t)
    t.summary()
