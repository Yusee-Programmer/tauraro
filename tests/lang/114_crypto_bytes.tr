# tests/lang/114_crypto_bytes.tr
# std.crypto.bytes: constant-time comparison, secure wipe, binary-safe helpers,
# OS randomness. (Timing behaviour itself is not measurable in a unit test; the
# functional contract — exact equality, every-bit sensitivity, NUL safety — is.)

from std.test import TestRunner
from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

def bytes_of(n: int, seed: int) -> str:
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, i * 31 + seed)
        i = i + 1
    return CryptoBytes.wrap(p, n)

# copy of `s` with one bit flipped
def flip(s: str, byte_idx: int, bit: int) -> str:
    mut n = s.len()
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, CryptoBytes.at(s, i))
        i = i + 1
    CryptoBytes.put(p, byte_idx, CryptoBytes.get(p, byte_idx) ^ (1 << bit))
    return CryptoBytes.wrap(p, n)

def main():
    mut t = TestRunner.init("114_crypto_bytes")

    t.section("ct_eq")
    t.assert_true(CryptoBytes.ct_eq("", ""), "empty == empty")
    t.assert_true(CryptoBytes.ct_eq("abc", "abc"), "equal ascii")
    t.assert_true(not CryptoBytes.ct_eq("abc", "abd"), "last byte differs")
    t.assert_true(not CryptoBytes.ct_eq("abc", "ab"), "length differs (shorter)")
    t.assert_true(not CryptoBytes.ct_eq("ab", "abc"), "length differs (longer)")
    t.assert_true(not CryptoBytes.ct_eq("", "a"), "empty vs non-empty")
    mut a = bytes_of(32, 7)
    mut a2 = bytes_of(32, 7)
    t.assert_true(CryptoBytes.ct_eq(a, a2), "32 equal binary bytes")
    mut diffs = 0
    mut bi = 0
    while bi < 32:
        mut bit = 0
        while bit < 8:
            if CryptoBytes.ct_eq(a, flip(a2, bi, bit)): diffs = diffs + 1
            bit = bit + 1
        bi = bi + 1
    t.assert_eq_int(diffs, 0, "every single-bit flip in 32 bytes is detected")
    # embedded NULs / high bytes: bytes 0x00 and 0x80 must not be confused
    mut z1 = Hex.decode("00ff00")
    mut z2 = Hex.decode("00ff00")
    mut z3 = Hex.decode("00ff80")
    mut z4 = Hex.decode("0000ff")
    t.assert_true(CryptoBytes.ct_eq(z1, z2), "embedded NULs equal")
    t.assert_true(not CryptoBytes.ct_eq(z1, z3), "0x00 vs 0x80 last byte")
    t.assert_true(not CryptoBytes.ct_eq(z1, z4), "different NUL placement")
    t.assert_true(not CryptoBytes.ct_eq(Hex.decode("ff"), Hex.decode("7f")), "0xff vs 0x7f")
    t.assert_true(not CryptoBytes.ct_eq(Hex.decode("80"), Hex.decode("00")), "0x80 vs 0x00")

    t.section("ct_eq_n / ct_eq_int")
    mut p1: Pointer[char] = CryptoBytes.zeroed(8)
    mut p2: Pointer[char] = CryptoBytes.zeroed(8)
    mut i = 0
    while i < 8:
        CryptoBytes.put(p1, i, i + 200)
        CryptoBytes.put(p2, i, i + 200)
        i = i + 1
    t.assert_true(CryptoBytes.ct_eq_n(p1, p2, 8), "buffers equal")
    CryptoBytes.put(p2, 7, 0)
    t.assert_true(not CryptoBytes.ct_eq_n(p1, p2, 8), "buffers differ at last byte")
    t.assert_true(CryptoBytes.ct_eq_n(p1, p2, 7), "first 7 bytes still equal")
    t.assert_true(CryptoBytes.ct_eq_n(p1, p2, 0), "n = 0 is equal")
    CryptoBytes.release(p1)
    CryptoBytes.release(p2)
    t.assert_eq_int(CryptoBytes.ct_eq_int(5, 5), 1, "ct_eq_int equal")
    t.assert_eq_int(CryptoBytes.ct_eq_int(5, 6), 0, "ct_eq_int differ")
    t.assert_eq_int(CryptoBytes.ct_eq_int(0, 4294967296), 1, "ct_eq_int ignores bits above 32")
    t.assert_eq_int(CryptoBytes.ct_eq_int(0, 1), 0, "0 vs 1")

    t.section("secure_zero")
    mut w: Pointer[char] = CryptoBytes.zeroed(64)
    i = 0
    while i < 64:
        CryptoBytes.put(w, i, 255 - i)
        i = i + 1
    CryptoBytes.secure_zero(w, 64)
    mut nonzero = 0
    i = 0
    while i < 64:
        if CryptoBytes.get(w, i) != 0: nonzero = nonzero + 1
        i = i + 1
    t.assert_eq_int(nonzero, 0, "all 64 bytes wiped")
    CryptoBytes.put(w, 0, 9)
    CryptoBytes.put(w, 10, 9)
    CryptoBytes.secure_zero(w, 5)
    t.assert_eq_int(CryptoBytes.get(w, 0), 0, "partial wipe clears first bytes")
    t.assert_eq_int(CryptoBytes.get(w, 10), 9, "partial wipe leaves later bytes")
    CryptoBytes.secure_zero(w, 0)
    CryptoBytes.release(w)

    t.section("slice / concat / at")
    mut s = Hex.decode("00112233445566778899")
    t.assert_eq_int(s.len(), 10, "decoded length keeps NUL at the start")
    t.assert_eq_int(CryptoBytes.at(s, 0), 0, "at(0)")
    t.assert_eq_int(CryptoBytes.at(s, 9), 153, "at(9) is unsigned")
    t.assert_eq_str(Hex.encode(CryptoBytes.slice(s, 2, 4)), "22334455", "slice")
    t.assert_eq_str(Hex.encode(CryptoBytes.slice(s, 0, 0)), "", "empty slice")
    t.assert_eq_str(Hex.encode(CryptoBytes.concat(s, Hex.decode("ff00"))), "00112233445566778899ff00", "concat keeps NULs")
    t.assert_eq_int(CryptoBytes.concat("", "").len(), 0, "concat of empties")

    t.section("random")
    mut r1 = CryptoBytes.random(32)
    mut r2 = CryptoBytes.random(32)
    t.assert_eq_int(r1.len(), 32, "random length")
    t.assert_eq_int(CryptoBytes.random(100).len(), 100, "random > 32 bytes")
    t.assert_eq_int(CryptoBytes.random(0).len(), 0, "random 0 bytes")
    t.assert_true(not CryptoBytes.ct_eq(r1, r2), "two random strings differ")
    t.summary()
