# tests/lang/136_webp_tiff.tr
# std.image.webp / std.image.tiff. Fixtures were written by Pillow (libwebp /
# libtiff); expected values are FNV-1a hashes of the RGBA pixels Pillow
# decodes from the same bytes, so a match means bit-identical output.
# The C codecs were also checked against Pillow on 56 WebP files (all
# lossy/lossless/alpha/animation variants, random sizes and qualities) and
# 29 TIFF files (every compression, strips/tiles, chunky/planar, 1-16 bit,
# palette, CMYK, multi-page), and fuzzed under ASan/UBSan.

from std.test import TestRunner
from std.image.mod import Image, decode
from std.image.webp import decode_webp, decode_webp_checked, decode_webp_animation, webp_info, encode_webp, WebpEncoder, WebpAnimation, WebpInfo
from std.image.tiff import decode_tiff, decode_tiff_page, decode_tiff_checked, tiff_page_count, tiff_info, encode_tiff, TiffEncoder, TiffInfo, TIFF_NONE, TIFF_LZW
from std.crypto.native import _cn_unhex

def unhex(h: str) -> str:
    mut r: Result[str, str] = _cn_unhex(h)
    return r.ok

def fnv(img: Image) -> int:
    mut h = 2166136261
    mut n = img.width * img.height * 4
    mut i = 0
    while i < n:
        h = h ^ (img.pixels.get(i) as int & 0xFF)
        h = (h * 16777619) & 0xFFFFFFFF
        i = i + 1
    return h

def same_pixels(a: Image, b: Image) -> bool:
    if a.width != b.width or a.height != b.height: return false
    mut n = a.width * a.height * 4
    mut i = 0
    while i < n:
        if a.pixels.get(i) != b.pixels.get(i): return false
        i = i + 1
    return true

# 37x23 test card with a gradient, noise-like texture and translucent pixels.
def card(alpha: bool) -> Image:
    mut img = Image.init(37, 23)
    mut y = 0
    while y < 23:
        mut x = 0
        while x < 37:
            mut a = 255
            if alpha: a = (x * 7 + y * 11) % 256
            img.set_pixel(x, y, (x * 7) % 256, (y * 11) % 256, (x * y * 13 + 5) % 256, a)
            x = x + 1
        y = y + 1
    return img

def fx_webp_lossy() -> str:
    return unhex("")

def fx_webp_lossy_alpha() -> str:
    return unhex("")

def fx_webp_lossless() -> str:
    return unhex("5249464632000000574542505650384c250000002f0c000210b98ce87fec22a2ff012101e194ffef347d4aa643209b867687209a00c0676d0300")

def fx_webp_lossless_pal() -> str:
    return unhex("5249464628000000574542505650384c1c0000002f094001000f700fdf0b211f4566fe430b028124f0f57788e87fd000")

def fx_webp_anim() -> str:
    return unhex("")

def fx_tiff_raw() -> str:
    return unhex("")

def fx_tiff_lzw_rgba() -> str:
    return unhex("")

def fx_tiff_deflate() -> str:
    return unhex("")

def fx_tiff_packbits_gray() -> str:
    return unhex("")

def fx_tiff_palette() -> str:
    return unhex("")

def fx_tiff_bilevel() -> str:
    return unhex("49492a0008000000080000010400010000000900000001010400010000000700000003010300010000000100000006010300010000000100000011010400010000006e00000016010400010000000700000017010400010000000e0000001c0103000100000001000000000000000200140056805500be8000004a00")

def fx_tiff_gray16_pred_be() -> str:
    return unhex("")

def fx_tiff_multi() -> str:
    return unhex("")

def test_webp_decode(t: TestRunner):
    t.section("WebP decode")

    mut b_webp_lossy = fx_webp_lossy()
    mut i_webp_lossy = decode_webp(b_webp_lossy, b_webp_lossy.len())
    t.assert_eq_int(i_webp_lossy.width, 16, "webp_lossy: width")
    t.assert_eq_int(i_webp_lossy.height, 12, "webp_lossy: height")
    t.assert_eq_int(fnv(i_webp_lossy), 2343756016, "webp_lossy: pixels identical to Pillow")

    mut b_webp_lossy_alpha = fx_webp_lossy_alpha()
    mut i_webp_lossy_alpha = decode_webp(b_webp_lossy_alpha, b_webp_lossy_alpha.len())
    t.assert_eq_int(i_webp_lossy_alpha.width, 12, "webp_lossy_alpha: width")
    t.assert_eq_int(i_webp_lossy_alpha.height, 10, "webp_lossy_alpha: height")
    t.assert_eq_int(fnv(i_webp_lossy_alpha), 2406862224, "webp_lossy_alpha: pixels identical to Pillow")

    mut b_webp_lossless = fx_webp_lossless()
    mut i_webp_lossless = decode_webp(b_webp_lossless, b_webp_lossless.len())
    t.assert_eq_int(i_webp_lossless.width, 13, "webp_lossless: width")
    t.assert_eq_int(i_webp_lossless.height, 9, "webp_lossless: height")
    t.assert_eq_int(fnv(i_webp_lossless), 1956341429, "webp_lossless: pixels identical to Pillow")

    mut b_webp_lossless_pal = fx_webp_lossless_pal()
    mut i_webp_lossless_pal = decode_webp(b_webp_lossless_pal, b_webp_lossless_pal.len())
    t.assert_eq_int(i_webp_lossless_pal.width, 10, "webp_lossless_pal: width")
    t.assert_eq_int(i_webp_lossless_pal.height, 6, "webp_lossless_pal: height")
    t.assert_eq_int(fnv(i_webp_lossless_pal), 1680637445, "webp_lossless_pal: pixels identical to Pillow")

    mut ab = fx_webp_anim()
    mut ar: Result[WebpAnimation, str] = decode_webp_animation(ab, ab.len())
    t.assert_true(ar.is_ok, "animation decodes")
    mut anim = ar.ok
    t.assert_eq_int(anim.frames.len(), 3, "3 frames")
    t.assert_eq_int(anim.width, 8, "canvas width")
    t.assert_eq_int(anim.loop_count, 0, "loop forever")
    t.assert_eq_int(anim.delays[1], 80, "frame 1 duration")
    t.assert_eq_int(fnv(anim.frames[0]), 489485733, "frame 0 composited like libwebp")
    t.assert_eq_int(fnv(anim.frames[1]), 3074541733, "frame 1 composited like libwebp")
    t.assert_eq_int(fnv(anim.frames[2]), 1670297125, "frame 2 composited like libwebp")
    mut ir: Result[WebpInfo, str] = webp_info(ab, ab.len())
    t.assert_true(ir.ok.animated, "info: animated")
    t.assert_true(ir.ok.lossless, "info: lossless")
    mut lb = fx_webp_lossy_alpha()
    mut li: Result[WebpInfo, str] = webp_info(lb, lb.len())
    t.assert_true(li.ok.has_alpha and not li.ok.lossless, "info: lossy with alpha")
    mut sniff = decode(lb, lb.len())
    t.assert_eq_int(sniff.width, 12, "std.image.decode sniffs WebP")


def test_webp_encode(t: TestRunner):
    t.section("WebP lossless encode")
    mut img = card(true)
    mut out, n = encode_webp(img)
    t.assert_true(n > 30, "encodes")
    mut back = decode_webp(out, n)
    t.assert_true(same_pixels(img, back), "RGBA round trip is lossless")
    mut opaque = card(false)
    mut o2, n2 = encode_webp(opaque)
    t.assert_true(same_pixels(opaque, decode_webp(o2, n2)), "opaque round trip")
    t.assert_true(n2 < 37 * 23 * 3, "compresses")
    mut flat = Image.init(40, 30)
    mut y = 0
    while y < 30:
        mut x = 0
        while x < 40:
            if x < 20: flat.set_pixel(x, y, 255, 0, 0, 255)
            else: flat.set_pixel(x, y, 0, 0, 255, 128)
            x = x + 1
        y = y + 1
    mut o3, n3 = encode_webp(flat)
    t.assert_true(same_pixels(flat, decode_webp(o3, n3)), "palette path round trip")
    t.assert_true(n3 < 120, "two-colour image is tiny")
    mut one = Image.init(1, 1)
    one.set_pixel(0, 0, 9, 8, 7, 6)
    mut o4, n4 = encode_webp(one)
    t.assert_true(same_pixels(one, decode_webp(o4, n4)), "1x1 round trip")
    mut enc = WebpEncoder.init(37, 23, 2)
    mut r1: Result[bool, str] = enc.add_frame(img, 120)
    mut r2: Result[bool, str] = enc.add_frame(opaque, 60)
    t.assert_true(r1.is_ok and r2.is_ok, "frames added")
    mut bad: Result[bool, str] = enc.add_frame(one, 10)
    t.assert_true(bad.is_err, "frame size checked")
    mut ao, an = enc.finish()
    mut ar: Result[WebpAnimation, str] = decode_webp_animation(ao, an)
    t.assert_true(ar.is_ok, "animated output decodes")
    t.assert_eq_int(ar.ok.frames.len(), 2, "2 frames")
    t.assert_eq_int(ar.ok.loop_count, 2, "loop count kept")
    t.assert_eq_int(ar.ok.delays[0], 120, "duration kept")
    t.assert_true(same_pixels(ar.ok.frames[1], opaque), "frame pixels kept")

def test_webp_errors(t: TestRunner):
    t.section("WebP errors")
    mut b = fx_webp_lossy()
    t.assert_eq_int(decode_webp(b, 60).width, -1, "truncated file fails cleanly")
    mut r: Result[Image, str] = decode_webp_checked("RIFF\x10\x00\x00\x00WEBPJUNK", 16)
    t.assert_true(r.is_err, "garbage raises")
    t.assert_true(r.err.starts_with("WebP:"), "error message")


def test_tiff_decode(t: TestRunner):
    t.section("TIFF decode")

    mut b_tiff_raw = fx_tiff_raw()
    mut i_tiff_raw = decode_tiff(b_tiff_raw, b_tiff_raw.len())
    t.assert_eq_int(i_tiff_raw.width, 9, "tiff_raw: width")
    t.assert_eq_int(i_tiff_raw.height, 7, "tiff_raw: height")
    t.assert_eq_int(fnv(i_tiff_raw), 1110307782, "tiff_raw: pixels identical to Pillow")

    mut b_tiff_lzw_rgba = fx_tiff_lzw_rgba()
    mut i_tiff_lzw_rgba = decode_tiff(b_tiff_lzw_rgba, b_tiff_lzw_rgba.len())
    t.assert_eq_int(i_tiff_lzw_rgba.width, 9, "tiff_lzw_rgba: width")
    t.assert_eq_int(i_tiff_lzw_rgba.height, 7, "tiff_lzw_rgba: height")
    t.assert_eq_int(fnv(i_tiff_lzw_rgba), 4112300559, "tiff_lzw_rgba: pixels identical to Pillow")

    mut b_tiff_deflate = fx_tiff_deflate()
    mut i_tiff_deflate = decode_tiff(b_tiff_deflate, b_tiff_deflate.len())
    t.assert_eq_int(i_tiff_deflate.width, 9, "tiff_deflate: width")
    t.assert_eq_int(i_tiff_deflate.height, 7, "tiff_deflate: height")
    t.assert_eq_int(fnv(i_tiff_deflate), 1110307782, "tiff_deflate: pixels identical to Pillow")

    mut b_tiff_packbits_gray = fx_tiff_packbits_gray()
    mut i_tiff_packbits_gray = decode_tiff(b_tiff_packbits_gray, b_tiff_packbits_gray.len())
    t.assert_eq_int(i_tiff_packbits_gray.width, 9, "tiff_packbits_gray: width")
    t.assert_eq_int(i_tiff_packbits_gray.height, 7, "tiff_packbits_gray: height")
    t.assert_eq_int(fnv(i_tiff_packbits_gray), 1982188590, "tiff_packbits_gray: pixels identical to Pillow")

    mut b_tiff_palette = fx_tiff_palette()
    mut i_tiff_palette = decode_tiff(b_tiff_palette, b_tiff_palette.len())
    t.assert_eq_int(i_tiff_palette.width, 9, "tiff_palette: width")
    t.assert_eq_int(i_tiff_palette.height, 7, "tiff_palette: height")
    t.assert_eq_int(fnv(i_tiff_palette), 140806317, "tiff_palette: pixels identical to Pillow")

    mut b_tiff_bilevel = fx_tiff_bilevel()
    mut i_tiff_bilevel = decode_tiff(b_tiff_bilevel, b_tiff_bilevel.len())
    t.assert_eq_int(i_tiff_bilevel.width, 9, "tiff_bilevel: width")
    t.assert_eq_int(i_tiff_bilevel.height, 7, "tiff_bilevel: height")
    t.assert_eq_int(fnv(i_tiff_bilevel), 2040118824, "tiff_bilevel: pixels identical to Pillow")

    mut b_tiff_gray16_pred_be = fx_tiff_gray16_pred_be()
    mut i_tiff_gray16_pred_be = decode_tiff(b_tiff_gray16_pred_be, b_tiff_gray16_pred_be.len())
    t.assert_eq_int(i_tiff_gray16_pred_be.width, 5, "tiff_gray16_pred_be: width")
    t.assert_eq_int(i_tiff_gray16_pred_be.height, 3, "tiff_gray16_pred_be: height")
    t.assert_eq_int(fnv(i_tiff_gray16_pred_be), 456247062, "tiff_gray16_pred_be: pixels identical to Pillow")

    mut mb = fx_tiff_multi()
    t.assert_eq_int(tiff_page_count(mb, mb.len()), 2, "page count")
    mut p1: Result[Image, str] = decode_tiff_page(mb, mb.len(), 1)
    t.assert_true(p1.is_ok, "page 1 decodes")
    t.assert_eq_int(p1.ok.width, 5, "page 1 width")
    t.assert_eq_int(fnv(p1.ok), 2508194987, "page 1 pixels")
    mut p9: Result[Image, str] = decode_tiff_page(mb, mb.len(), 9)
    t.assert_true(p9.is_err, "missing page raises")
    mut inf: Result[TiffInfo, str] = tiff_info(mb, mb.len(), 0)
    t.assert_eq_int(inf.ok.compression, 5, "info: LZW")
    t.assert_eq_int(inf.ok.samples_per_pixel, 3, "info: RGB")
    mut g = fx_tiff_gray16_pred_be()
    mut gi: Result[TiffInfo, str] = tiff_info(g, g.len(), 0)
    t.assert_eq_int(gi.ok.bits_per_sample, 16, "info: 16-bit")
    mut sniff = decode(g, g.len())
    t.assert_eq_int(sniff.width, 5, "std.image.decode sniffs TIFF")
    mut bad: Result[Image, str] = decode_tiff_checked("II*\x00\xff\xff\x00\x00", 8)
    t.assert_true(bad.is_err, "bad IFD offset raises")


def test_tiff_encode(t: TestRunner):
    t.section("TIFF encode")
    mut img = card(true)
    mut a, an = encode_tiff(img, TIFF_LZW)
    t.assert_true(same_pixels(img, decode_tiff(a, an)), "LZW RGBA round trip")
    mut b, bn = encode_tiff(img, TIFF_NONE)
    t.assert_true(same_pixels(img, decode_tiff(b, bn)), "uncompressed round trip")
    t.assert_true(bn > 37 * 23 * 4, "uncompressed size")
    mut op = card(false)
    mut c, cn = encode_tiff(op, TIFF_LZW)
    mut ci: Result[TiffInfo, str] = tiff_info(c, cn, 0)
    t.assert_eq_int(ci.ok.samples_per_pixel, 3, "opaque image written as RGB")
    t.assert_true(same_pixels(op, decode_tiff(c, cn)), "RGB round trip")
    mut e = TiffEncoder.init()
    e.add_page(img, TIFF_LZW)
    e.add_page(op, TIFF_NONE)
    mut m, mn = e.finish()
    t.assert_eq_int(tiff_page_count(m, mn), 2, "two pages written")
    mut p1: Result[Image, str] = decode_tiff_page(m, mn, 1)
    t.assert_true(same_pixels(op, p1.ok), "second page round trip")
    mut bad: Result[bool, str] = TiffEncoder.init().add_page(img, 7)
    t.assert_true(bad.is_err, "unknown compression rejected")

def main():
    mut t = TestRunner.init("136_webp_tiff")
    test_webp_decode(t)
    test_webp_encode(t)
    test_webp_errors(t)
    test_tiff_decode(t)
    test_tiff_encode(t)
    t.summary()
