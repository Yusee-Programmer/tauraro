# tests/lang/47_text.tr - std.text: Myers line diff + unified_diff rendering
# (std.text.diff), Levenshtein edit distance + similarity (std.text.distance),
# and greedy word-wrap + indent (std.text.wrap).

from std.test import TestRunner
from std.string.str import Str
from std.string.fmt import Fmt
from std.text.diff import Diff, DiffOp
from std.text.distance import Distance
from std.text.wrap import Wrap

# Count how many ops in an edit script are Equal / Insert / Delete.
def count_ops(ops: List[DiffOp]) -> (int, int, int):
    mut eq = 0
    mut ins = 0
    mut del = 0
    mut i = 0
    while i < len(ops):
        match ops[i]:
            case DiffOp.Equal(_): eq = eq + 1
            case DiffOp.Insert(_): ins = ins + 1
            case DiffOp.Delete(_): del = del + 1
        i = i + 1
    return (eq, ins, del)

def main():
    mut t = TestRunner.init("47_text")

    # ══════════════════════════════════════════════════════════════════════
    t.section("diff: identical inputs -> all Equal, no changes")
    mut a1 = Str.split("one\ntwo\nthree", "\n")
    mut b1 = Str.split("one\ntwo\nthree", "\n")
    mut ops1 = Diff.diff(a1, b1)
    t.assert_eq_int(len(ops1), 3, "identical inputs: 3 ops total")
    mut eq1, ins1, del1 = count_ops(ops1)
    t.assert_eq_int(eq1, 3, "identical inputs: 3 Equal")
    t.assert_eq_int(ins1, 0, "identical inputs: 0 Insert")
    t.assert_eq_int(del1, 0, "identical inputs: 0 Delete")
    t.assert_eq_str(Diff.unified_diff(a1, b1, 3), "", "identical inputs: empty unified diff")

    t.section("diff: pure insertion")
    mut a2 = Str.split("one\ntwo", "\n")
    mut b2 = Str.split("one\ntwo\nthree", "\n")
    mut ops2 = Diff.diff(a2, b2)
    mut eq2, ins2, del2 = count_ops(ops2)
    t.assert_eq_int(eq2, 2, "pure insertion: 2 Equal")
    t.assert_eq_int(ins2, 1, "pure insertion: 1 Insert")
    t.assert_eq_int(del2, 0, "pure insertion: 0 Delete")
    match ops2[2]:
        case DiffOp.Insert(line): t.assert_eq_str(line, "three", "inserted line is 'three'")
        case _: t.fail("expected 3rd op to be Insert")

    t.section("diff: pure deletion")
    mut a3 = Str.split("one\ntwo\nthree", "\n")
    mut b3 = Str.split("one\ntwo", "\n")
    mut ops3 = Diff.diff(a3, b3)
    mut eq3, ins3, del3 = count_ops(ops3)
    t.assert_eq_int(eq3, 2, "pure deletion: 2 Equal")
    t.assert_eq_int(ins3, 0, "pure deletion: 0 Insert")
    t.assert_eq_int(del3, 1, "pure deletion: 1 Delete")
    match ops3[2]:
        case DiffOp.Delete(line): t.assert_eq_str(line, "three", "deleted line is 'three'")
        case _: t.fail("expected 3rd op to be Delete")

    t.section("diff: mixed changes (minimal edit script)")
    mut a4 = Str.split("one\ntwo\nthree", "\n")
    mut b4 = Str.split("one\nTWO\nthree", "\n")
    mut ops4 = Diff.diff(a4, b4)
    t.assert_eq_int(len(ops4), 4, "one-line change -> Equal,Delete,Insert,Equal (4 ops, minimal)")
    mut eq4, ins4, del4 = count_ops(ops4)
    t.assert_eq_int(eq4, 2, "mixed change: 2 Equal (unchanged context lines)")
    t.assert_eq_int(ins4, 1, "mixed change: 1 Insert")
    t.assert_eq_int(del4, 1, "mixed change: 1 Delete")
    match ops4[0]:
        case DiffOp.Equal(line): t.assert_eq_str(line, "one", "first op equal 'one'")
        case _: t.fail("expected Equal first")
    match ops4[3]:
        case DiffOp.Equal(line): t.assert_eq_str(line, "three", "last op equal 'three'")
        case _: t.fail("expected Equal last")

    t.section("unified_diff: exact output format on a worked example")
    mut want = "--- a\n+++ b\n@@ -1,3 +1,3 @@\n one\n-two\n+TWO\n three\n"
    t.assert_eq_str(Diff.unified_diff(a4, b4, 3), want, "unified_diff exact text for one-line change")

    t.section("unified_diff: multiple separated hunks")
    mut a5 = Str.split("L1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10", "\n")
    mut b5 = Str.split("X1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nX10", "\n")
    mut ud5 = Diff.unified_diff(a5, b5, 1)
    mut want5 = "--- a\n+++ b\n@@ -1,2 +1,2 @@\n-L1\n+X1\n L2\n@@ -9,2 +9,2 @@\n L9\n-L10\n+X10\n"
    t.assert_eq_str(ud5, want5, "two far-apart changes produce two separate hunks")

    # ══════════════════════════════════════════════════════════════════════
    t.section("levenshtein: hand-verified distances")
    t.assert_eq_int(Distance.levenshtein("kitten", "sitting"), 3, "kitten -> sitting = 3 (classic example)")
    t.assert_eq_int(Distance.levenshtein("flaw", "lawn"), 2, "flaw -> lawn = 2")
    t.assert_eq_int(Distance.levenshtein("gumbo", "gambol"), 2, "gumbo -> gambol = 2")
    t.assert_eq_int(Distance.levenshtein("abc", "abc"), 0, "identical strings -> 0")
    t.assert_eq_int(Distance.levenshtein("", ""), 0, "two empty strings -> 0")
    t.assert_eq_int(Distance.levenshtein("", "abc"), 3, "empty vs 'abc' -> 3 (all insertions)")
    t.assert_eq_int(Distance.levenshtein("abc", ""), 3, "'abc' vs empty -> 3 (all deletions)")
    t.assert_eq_int(Distance.levenshtein("abc", "xyz"), 3, "completely disjoint same-length strings -> 3")

    t.section("similarity: normalized 0.0-1.0 score")
    t.assert_eq_float(Distance.similarity("abc", "abc"), 1.0, 0.0001, "identical strings -> similarity 1.0")
    t.assert_eq_float(Distance.similarity("", ""), 1.0, 0.0001, "two empty strings -> similarity 1.0")
    t.assert_eq_float(Distance.similarity("abc", "xyz"), 0.0, 0.0001, "fully disjoint same-length -> similarity 0.0")
    t.assert_eq_float(Distance.similarity("kitten", "sitting"), 0.5714, 0.001, "kitten/sitting similarity ~0.571")

    # ══════════════════════════════════════════════════════════════════════
    t.section("wrap: basic greedy word-wrap")
    mut w1 = Wrap.wrap("the quick brown fox jumps over the lazy dog", 15)
    t.assert_eq_int(len(w1), 3, "wraps into 3 lines at width 15")
    t.assert_eq_str(w1[0], "the quick brown", "line 1")
    t.assert_eq_str(w1[1], "fox jumps over", "line 2")
    t.assert_eq_str(w1[2], "the lazy dog", "line 3")
    mut wi = 0
    while wi < len(w1):
        t.assert_le_int(len(w1[wi]), 15, "no output line exceeds width 15")
        wi = wi + 1

    t.section("wrap: empty string")
    mut w2 = Wrap.wrap("", 10)
    t.assert_eq_int(len(w2), 1, "empty input -> 1 (empty) line")
    t.assert_eq_str(w2[0], "", "empty input -> empty line")

    t.section("wrap: single word longer than width is not split")
    mut w3 = Wrap.wrap("supercalifragilisticexpialidocious", 10)
    t.assert_eq_int(len(w3), 1, "one long word stays on one line")
    t.assert_eq_str(w3[0], "supercalifragilisticexpialidocious", "long word left intact")

    t.section("wrap: long word embedded among short words")
    mut w4 = Wrap.wrap("a supercalifragilisticexpialidocious b", 10)
    t.assert_eq_int(len(w4), 3, "long word forces its own line")
    t.assert_eq_str(w4[0], "a", "short word before")
    t.assert_eq_str(w4[1], "supercalifragilisticexpialidocious", "long word alone")
    t.assert_eq_str(w4[2], "b", "short word after")

    t.section("wrap: exact-width boundary does not wrap early")
    mut w5 = Wrap.wrap("12345 67890", 11)
    t.assert_eq_int(len(w5), 1, "line exactly at width stays whole")
    t.assert_eq_str(w5[0], "12345 67890", "exact-width line content")
    t.assert_eq_int(len(w5[0]), 11, "exact-width line length is exactly width")

    mut w6 = Wrap.wrap("aaaaa bbbbb", 5)
    t.assert_eq_int(len(w6), 2, "exact-width word pair still splits into 2 lines")
    t.assert_eq_str(w6[0], "aaaaa", "first exact-width word")
    t.assert_eq_str(w6[1], "bbbbb", "second exact-width word")

    t.section("wrap: multiple paragraphs (blank-line separated)")
    mut w7 = Wrap.wrap("first para here\n\nsecond para now", 10)
    t.assert_eq_int(len(w7), 5, "two short paragraphs -> 5 output lines incl. blank separator")
    t.assert_eq_str(w7[0], "first para", "para1 line1")
    t.assert_eq_str(w7[1], "here", "para1 line2")
    t.assert_eq_str(w7[2], "", "blank separator line")
    t.assert_eq_str(w7[3], "second", "para2 line1")
    t.assert_eq_str(w7[4], "para now", "para2 line2")

    t.section("indent: multi-line input")
    t.assert_eq_str(Wrap.indent("a\nb\nc", "> "), "> a\n> b\n> c", "prefixes every line")
    t.assert_eq_str(Wrap.indent("single line", ">> "), ">> single line", "single-line indent")
    t.assert_eq_str(Wrap.indent("", ">> "), "", "empty input stays empty (no phantom prefixed line)")

    t.summary()
