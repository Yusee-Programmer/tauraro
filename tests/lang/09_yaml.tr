# tests/lang/09_yaml.tr - std.encoding.yaml parse/stringify round-trip.
# Uses the SAFE ARC-node API (YamlValue is an ARC class; no raw pointers, so no
# `.read()` / `unsafe:` needed — memory-safe by default).

from std.test import TestRunner
from std.encoding.yaml import YamlValue, Yaml

def main():
    mut t = TestRunner.init("09_yaml")

    t.section("scalars")
    mut doc = Yaml.parse("title: Tauraro\nport: 8080\nratio: 1.5\nenabled: true\nnothing: null\ntilde: ~\n")
    mut title: str = doc.obj_get("title").get_str()
    t.assert_eq_str(title, "Tauraro", "string value")
    t.assert_eq_int(doc.obj_get("port").get_int(), 8080, "int value")
    t.assert_eq_float(doc.obj_get("ratio").get_float(), 1.5, 0.0001, "float value")
    t.assert_true(doc.obj_get("enabled").get_bool(), "bool value (true)")
    t.assert_true(doc.obj_get("nothing").is_null(), "null keyword")
    t.assert_true(doc.obj_get("tilde").is_null(), "tilde null")

    t.section("YAML 1.1 boolean words")
    mut db = Yaml.parse("a: yes\nb: no\nc: on\nd: off\ne: True\nf: FALSE\n")
    t.assert_true(db.obj_get("a").get_bool(), "yes -> true")
    t.assert_false(db.obj_get("b").get_bool(), "no -> false")
    t.assert_true(db.obj_get("c").get_bool(), "on -> true")
    t.assert_false(db.obj_get("d").get_bool(), "off -> false")
    t.assert_true(db.obj_get("e").get_bool(), "True -> true")
    t.assert_false(db.obj_get("f").get_bool(), "FALSE -> false")

    t.section("quoted strings + escapes")
    mut dq = Yaml.parse("a: \"line1\\nline2\"\nb: 'it''s here'\nc: \"has: colon\"\n")
    mut a_val: str = dq.obj_get("a").get_str()
    t.assert_eq_str(a_val, "line1\nline2", "double-quoted escape")
    mut b_val: str = dq.obj_get("b").get_str()
    t.assert_eq_str(b_val, "it's here", "single-quoted '' escape")
    mut c_val: str = dq.obj_get("c").get_str()
    t.assert_eq_str(c_val, "has: colon", "quoted string containing colon")

    t.section("integer/float forms + negatives")
    mut d2 = Yaml.parse("neg: -42\nfl: -3.5\npos: 7\n")
    t.assert_eq_int(d2.obj_get("neg").get_int(), -42, "negative int")
    t.assert_eq_float(d2.obj_get("fl").get_float(), -3.5, 0.0001, "negative float")
    t.assert_eq_int(d2.obj_get("pos").get_int(), 7, "positive int")

    t.section("block sequences")
    mut d3 = Yaml.parse("nums:\n  - 1\n  - 2\n  - 3\nwords:\n  - a\n  - b\n")
    mut arr = d3.obj_get("nums")
    t.assert_true(arr.is_array(), "nums is array")
    t.assert_eq_int(arr.array_len(), 3, "array length")
    t.assert_eq_int(arr.array_get(0).get_int(), 1, "array elem 0")
    t.assert_eq_int(arr.array_get(2).get_int(), 3, "array elem 2")
    mut warr = d3.obj_get("words")
    mut w0: str = warr.array_get(0).get_str()
    t.assert_eq_str(w0, "a", "string array elem")

    t.section("nested block mappings (multi-depth)")
    mut d4 = Yaml.parse("server:\n  host: localhost\n  port: 9090\n  tls:\n    enabled: false\n    cert:\n      path: /etc/x.pem\n")
    mut server = d4.obj_get("server")
    t.assert_true(server.is_table(), "server is a table")
    mut host: str = server.obj_get("host").get_str()
    t.assert_eq_str(host, "localhost", "nested table string")
    t.assert_eq_int(server.obj_get("port").get_int(), 9090, "nested table int")
    mut tls = server.obj_get("tls")
    t.assert_true(tls.is_table(), "deep table tls")
    t.assert_false(tls.obj_get("enabled").get_bool(), "deep table bool")
    mut cert = tls.obj_get("cert")
    t.assert_true(cert.is_table(), "3-level deep table cert")
    mut certpath: str = cert.obj_get("path").get_str()
    t.assert_eq_str(certpath, "/etc/x.pem", "3-level deep string")

    t.section("sequence of mappings (nested)")
    mut d5 = Yaml.parse("items:\n  - name: apple\n    price: 1\n  - name: pear\n    price: 2\n")
    mut items = d5.obj_get("items")
    t.assert_true(items.is_array(), "items is array")
    t.assert_eq_int(items.array_len(), 2, "2 items")
    mut it0 = items.array_get(0)
    t.assert_true(it0.is_table(), "item 0 is a mapping")
    mut it0name: str = it0.obj_get("name").get_str()
    t.assert_eq_str(it0name, "apple", "item 0 name")
    t.assert_eq_int(it0.obj_get("price").get_int(), 1, "item 0 price")
    mut it1 = items.array_get(1)
    mut it1name: str = it1.obj_get("name").get_str()
    t.assert_eq_str(it1name, "pear", "item 1 name")

    t.section("mapping of sequences")
    mut d6 = Yaml.parse("groups:\n  admins:\n    - alice\n    - bob\n  users:\n    - carol\n")
    mut groups = d6.obj_get("groups")
    mut admins = groups.obj_get("admins")
    t.assert_eq_int(admins.array_len(), 2, "admins length")
    mut a0: str = admins.array_get(0).get_str()
    t.assert_eq_str(a0, "alice", "admins elem 0")
    mut users = groups.obj_get("users")
    t.assert_eq_int(users.array_len(), 1, "users length")

    t.section("flow sequences + flow mappings")
    mut d7 = Yaml.parse("nums: [1, 2, 3]\npoint: {x: 1, y: 2}\nmixed: [a, {k: v}, [1, 2]]\n")
    mut fnums = d7.obj_get("nums")
    t.assert_eq_int(fnums.array_len(), 3, "flow array length")
    t.assert_eq_int(fnums.array_get(1).get_int(), 2, "flow array elem")
    mut pt = d7.obj_get("point")
    t.assert_true(pt.is_table(), "flow mapping parsed as table")
    t.assert_eq_int(pt.obj_get("x").get_int(), 1, "flow mapping x")
    t.assert_eq_int(pt.obj_get("y").get_int(), 2, "flow mapping y")
    mut mixed = d7.obj_get("mixed")
    t.assert_eq_int(mixed.array_len(), 3, "mixed flow array length")
    mut mixed1 = mixed.array_get(1)
    t.assert_true(mixed1.is_table(), "nested flow mapping inside flow array")
    mut mixed2 = mixed.array_get(2)
    t.assert_true(mixed2.is_array(), "nested flow array inside flow array")
    t.assert_eq_int(mixed2.array_get(1).get_int(), 2, "doubly-nested flow array elem")

    t.section("comments")
    mut d8 = Yaml.parse("# a full-line comment\nname: value  # trailing comment\nx: 7\n")
    mut nm: str = d8.obj_get("name").get_str()
    t.assert_eq_str(nm, "value", "comments stripped, value intact")
    t.assert_eq_int(d8.obj_get("x").get_int(), 7, "value after comment")

    t.section("anchors + aliases")
    mut d9 = Yaml.parse("base: &defaults\n  timeout: 30\n  retries: 3\nservice:\n  <<not_merge>>: ignored\n  config: *defaults\n")
    mut svc_cfg = d9.obj_get("service").obj_get("config")
    t.assert_true(svc_cfg.is_table(), "alias resolved to a table")
    t.assert_eq_int(svc_cfg.obj_get("timeout").get_int(), 30, "aliased field timeout")
    t.assert_eq_int(svc_cfg.obj_get("retries").get_int(), 3, "aliased field retries")

    t.section("flow anchors + aliases")
    mut d10 = Yaml.parse("a: &n [1, 2, 3]\nb: *n\n")
    mut bflow = d10.obj_get("b")
    t.assert_eq_int(bflow.array_len(), 3, "flow alias array length")
    t.assert_eq_int(bflow.array_get(2).get_int(), 3, "flow alias array elem")

    t.section("round-trip (parse -> stringify -> parse)")
    mut original = "title: app\ncount: 3\ndb:\n  name: main\nnums:\n  - 1\n  - 2\n"
    mut parsed1 = Yaml.parse(original)
    mut emitted: str = Yaml.stringify(parsed1)
    mut parsed2 = Yaml.parse(emitted)
    mut rt_title: str = parsed2.obj_get("title").get_str()
    t.assert_eq_str(rt_title, "app", "round-trip top-level string")
    t.assert_eq_int(parsed2.obj_get("count").get_int(), 3, "round-trip int")
    mut rt_db: str = parsed2.obj_get("db").obj_get("name").get_str()
    t.assert_eq_str(rt_db, "main", "round-trip nested table")
    mut rt_nums = parsed2.obj_get("nums")
    t.assert_eq_int(rt_nums.array_len(), 2, "round-trip array length")
    t.assert_eq_int(rt_nums.array_get(1).get_int(), 2, "round-trip array elem")

    t.section("round-trip with special-char strings needing quotes")
    mut d11 = Yaml.parse("a: \"yes\"\nb: \"123abc\"\nc: \"has: colon\"\n")
    mut emitted2: str = Yaml.stringify(d11)
    mut d11b = Yaml.parse(emitted2)
    mut a2: str = d11b.obj_get("a").get_str()
    t.assert_eq_str(a2, "yes", "quoted 'yes' stays a string across round-trip")
    t.assert_true(d11b.obj_get("a").is_str(), "quoted 'yes' round-trips as str tag")

    t.section("multi-document stream")
    mut docs = Yaml.parse_multi("---\na: 1\n---\nb: 2\n")
    t.assert_eq_int(docs.len, 2, "two documents parsed")
    mut doc0 = docs.get(0)
    mut doc1 = docs.get(1)
    t.assert_eq_int(doc0.obj_get("a").get_int(), 1, "doc 0 field")
    t.assert_eq_int(doc1.obj_get("b").get_int(), 2, "doc 1 field")

    t.summary()
