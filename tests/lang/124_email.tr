def vec2() -> str:
    return """From: =?ISO-8859-1?Q?Keld_J=F8rn_Simonsen?= <keld@dkuug.dk>
To: "Hans \"Q\" Mueller" <hans@x.de>, mary@x.test (Mary Smith),
 undisclosed-recipients:;, "john doe"@example.com,
 <@route.example:joe@example.com>, Pete(A nice guy) <pete(his account)@silly.test(his host)>
Subject: =?windows-1252?Q?=93smart_quotes=94?= and =?iso-8859-15?B?pA==?= euro
Date: Fri, 21 Nov 97 09:55:06 GMT
Message-ID: <legacy.1@dkuug.dk>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary=outer

preamble text
--outer
Content-Type: text/plain; charset=iso-8859-1
Content-Transfer-Encoding: quoted-printable

Caf=E9 cr=E8me br=FBl=E9e, a soft-=
broken line=20
second line
--outer
Content-Type: multipart/alternative; boundary="inner"

--inner
Content-Type: text/html; charset=windows-1252
Content-Transfer-Encoding: base64

k0hplCCAIDU=
--inner--

--outer
Content-Type: application/pdf; name="=?utf-8?B?4oKsIGxvbmcgbmFtZSDDqS5wZGY=?="
Content-Disposition: attachment;
 filename*0*=utf-8''%E2%82%AC%20long%20;
 filename*1*=name%20%C3%A9;
 filename*2=".pdf"
Content-Transfer-Encoding: base64

JVBERi0xLjQK
--outer
Content-Type: text/plain; charset=koi8-r; name=ru.txt
Content-Disposition: attachment
Content-Transfer-Encoding: base64

8NLJ18XU
--outer
Content-Type: message/rfc822

From: inner@example.com
Subject: inner

inner body
--outer--
epilogue
"""

def check_vec1(t: TestRunner, raw: str, label: str):
    mut m = EmailMessage.parse(raw)
    t.assert_eq_str(m.subject(), "Grüße aus Köln – ein ziemlich langer Betreff, der umgebrochen werden muss", label + ": subject (B word + folded text)")
    mut fr = m.get_from()
    t.assert_eq_int(len(fr), 1, label + ": one From")
    if len(fr) == 1:
        t.assert_eq_str(fr[0].name, "Zoë Ünicode", label + ": From name (Q word)")
        t.assert_eq_str(fr[0].addr, "zoe@example.com", label + ": From addr")
    mut to = m.to()
    t.assert_eq_int(len(to), 3, label + ": To with a group flattened")
    if len(to) == 3:
        t.assert_eq_str(to[0].name, "Bob", label + ": To[0] name")
        t.assert_eq_str(to[0].group, "", label + ": To[0] not in a group")
        t.assert_eq_str(to[1].name, "Ann Lee", label + ": To[1] name")
        t.assert_eq_str(to[1].group, "Team", label + ": To[1] group")
        t.assert_eq_str(to[2].addr, "carl@example.org", label + ": To[2] addr")
        t.assert_eq_str(to[2].group, "Team", label + ": To[2] group")
    mut cc = m.cc()
    if len(cc) == 1: t.assert_eq_str(cc[0].name, "Doe, Jane", label + ": quoted display name with comma")
    else: t.fail(label + ": one Cc")
    t.assert_eq_str(m.message_id(), "20261013090500.1234@example.com", label + ": Message-ID")
    t.assert_eq_str(m.in_reply_to(), "parent@example.com", label + ": In-Reply-To")
    mut refs = m.references()
    t.assert_eq_int(len(refs), 2, label + ": References")
    t.assert_eq_int(m.timestamp(), 1791875100, label + ": Date with +0200")
    t.assert_eq_str(m.content_type(), "multipart/mixed", label + ": root type")
    t.assert_eq_str(m.text_body(), "Hallo Bob,\n\nanbei der Bericht. Schöne Grüße!\n-- \nZoë\n", label + ": text body (8bit)")
    t.assert_eq_str(m.html_body(), "<html><body><p>Hallo <b>Bob</b>,</p><p>Schöne Grüße!</p><img src=\"cid:logo123\"></body></html>\n", label + ": html body (QP soft breaks)")
    mut atts = m.attachments()
    t.assert_eq_int(len(atts), 3, label + ": related image + 2 attachments")
    if len(atts) == 3:
        t.assert_eq_str(atts[0].filename, "logo.png", label + ": image filename")
        t.assert_eq_str(atts[0].content_id, "logo123", label + ": image Content-ID")
        t.assert_eq_str(atts[0].content_type, "image/png", label + ": image type")
        t.assert_eq_int(atts[0].data.len(), 20, label + ": image bytes")
        t.assert_eq_str(atts[1].filename, "Übersicht 2026.csv", label + ": RFC 2231 filename")
        t.assert_eq_str(atts[1].content_type, "text/csv", label + ": csv type")
        t.assert_eq_str(atts[1].data, "col1,col2\n1,2\n", label + ": csv bytes")
        t.assert_eq_str(atts[2].filename, "all-bytes.bin", label + ": bin filename")
        t.assert_eq_int(atts[2].data.len(), 256, label + ": 256 bytes incl. NUL")
        mut ok = atts[2].data.len() == 256
        mut i = 0
        while ok and i < 256:
            if byte_at(atts[2].data, i) != i: ok = false
            i = i + 1
        t.assert_true(ok, label + ": every byte value decoded exactly")
    mut ps = m.parts()
    t.assert_eq_int(len(ps), 8, label + ": walk() part count")

def test_python_vec1(t: TestRunner):
    t.section("parse Python-generated message (LF and CRLF)")
    check_vec1(t, vec1(), "LF")
    check_vec1(t, crlf(vec1()), "CRLF")

def test_legacy_vec2(t: TestRunner):
    t.section("parse legacy message")
    mut m = EmailMessage.parse(vec2())
    t.assert_eq_str(m.subject(), "“smart quotes” and € euro", "windows-1252 Q + iso-8859-15 B words")
    mut fr = m.get_from()
    if len(fr) == 1: t.assert_eq_str(fr[0].name, "Keld Jørn Simonsen", "ISO-8859-1 Q display name")
    else: t.fail("one From")
    mut to = m.to()
    t.assert_eq_int(len(to), 5, "empty group contributes nothing")
    if len(to) == 5:
        t.assert_eq_str(to[0].name, "Hans \"Q\" Mueller", "quoted-pairs in display name")
        t.assert_eq_str(to[0].addr, "hans@x.de", "addr 0")
        t.assert_eq_str(to[1].addr, "mary@x.test", "addr-spec with trailing comment")
        t.assert_eq_str(to[1].name, "Mary Smith", "comment used as display name")
        t.assert_eq_str(to[2].addr, "\"john doe\"@example.com", "quoted local part kept quoted")
        t.assert_eq_str(to[3].addr, "joe@example.com", "obsolete route dropped")
        t.assert_eq_str(to[4].name, "Pete", "name before comment")
        t.assert_eq_str(to[4].addr, "pete@silly.test", "comments inside addr-spec dropped")
        t.assert_eq_str(to[2].local_part(), "\"john doe\"", "local_part")
        t.assert_eq_str(to[2].domain(), "example.com", "domain")
    t.assert_eq_int(m.timestamp(), 880106106, "two-digit year + GMT")
    t.assert_eq_str(m.text_body(), "Café crème brûlée, a soft-broken line \nsecond line", "ISO-8859-1 quoted-printable body")
    t.assert_eq_str(m.html_body(), "“Hi” € 5", "Windows-1252 base64 body in nested alternative")
    t.assert_eq_str(m.root.preamble, "preamble text", "preamble")
    t.assert_eq_str(m.root.epilogue, "epilogue\n", "epilogue")
    mut atts = m.attachments()
    t.assert_eq_int(len(atts), 3, "pdf, koi8-r text, message/rfc822")
    if len(atts) == 3:
        t.assert_eq_str(atts[0].filename, "€ long name é.pdf", "RFC 2231 continuations win over RFC 2047 name")
        t.assert_eq_str(atts[0].data, "%PDF-1.4\n", "pdf bytes")
        t.assert_eq_str(atts[1].filename, "ru.txt", "name from Content-Type")
        t.assert_eq_str(atts[1].data, bytes_of([240, 210, 201, 215, 197, 212]), "koi8-r bytes untouched")
        t.assert_eq_str(atts[2].content_type, "message/rfc822", "attached message")
    mut ps = m.parts()
    t.assert_eq_int(len(ps), 7, "walk() part count")
    if len(ps) == 7:
        t.assert_eq_str(ps[5].charset(), "koi8-r", "charset reported")
        mut st: Result[str, str] = ps[5].text_strict()
        t.assert_true(st.is_err, "text_strict raises for koi8-r")
        if st.is_err: t.assert_eq_str(st.err, "unsupported charset: koi8-r", "error text")
        t.assert_eq_str(ps[5].text(), bytes_of([240, 210, 201, 215, 197, 212]), "lenient text(): raw bytes")
        mut inner = ps[6].as_message()
        t.assert_eq_str(inner.subject(), "inner", "message/rfc822 part parsed")
        t.assert_eq_str(inner.text_body(), "inner body", "inner body (the CRLF before the delimiter is not content)")
        t.assert_eq_str(ps[1].transfer_encoding(), "quoted-printable", "transfer_encoding")
        t.assert_eq_str(ps[4].disposition(), "attachment", "disposition")
    mut sd: Result[str, str] = m.decoded_header_strict("Subject")
    t.assert_true(sd.is_ok, "strict decode ok for supported charsets")
    mut bad: Result[str, str] = decode_header_strict("=?koi8-r?B?8NLJ18XU?=")
    t.assert_true(bad.is_err, "strict decode reports koi8-r")
    t.assert_eq_str(decode_header("x =?koi8-r?B?8NLJ18XU?= y"), "x =?koi8-r?B?8NLJ18XU?= y", "lenient decode keeps it")

def test_rfc2047(t: TestRunner):
    t.section("RFC 2047 encoded words")
    # RFC 2047 section 8 examples
    t.assert_eq_str(decode_header("(=?ISO-8859-1?Q?a?=)"), "(a)", "single word")
    t.assert_eq_str(decode_header("(=?ISO-8859-1?Q?a?= b)"), "(a b)", "word then text")
    t.assert_eq_str(decode_header("(=?ISO-8859-1?Q?a?= =?ISO-8859-1?Q?b?=)"), "(ab)", "space between words dropped")
    t.assert_eq_str(decode_header("(=?ISO-8859-1?Q?a?=  =?ISO-8859-1?Q?b?=)"), "(ab)", "several spaces dropped")
    t.assert_eq_str(decode_header("(=?ISO-8859-1?Q?a?=\r\n    =?ISO-8859-1?Q?b?=)"), "(ab)", "folding between words dropped")
    t.assert_eq_str(decode_header("(=?ISO-8859-1?Q?a_b?=)"), "(a b)", "underscore is space")
    t.assert_eq_str(decode_header("=?US-ASCII?Q?Keith_Moore?= <moore@cs.utk.edu>"), "Keith Moore <moore@cs.utk.edu>", "US-ASCII")
    t.assert_eq_str(decode_header("=?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?= =?ISO-8859-2?B?dSB1bmRlcnN0YW5kIHRoZSBleGFtcGxlLg==?="), "If you can read this yo =?ISO-8859-2?B?dSB1bmRlcnN0YW5kIHRoZSBleGFtcGxlLg==?=", "unsupported charset left encoded")
    t.assert_eq_str(decode_header("=?utf-8*en?q?Hi?="), "Hi", "RFC 2231 language suffix")
    t.assert_eq_str(decode_header("=?utf-8?q?not closed"), "=?utf-8?q?not closed", "malformed left alone")
    t.assert_eq_str(decode_header("plain text"), "plain text", "no words")
    # Encoding
    mut long_s = "Ünïcödé text that is long enough to need more than one encoded word, definitely — yes"
    mut enc = encode_words(long_s)
    t.assert_eq_str(decode_header(enc), long_s, "encode_words round trip")
    mut words = enc.split(" ")
    mut ok = true
    mut i = 0
    while i < len(words):
        if words[i].len() > 75: ok = false
        i = i + 1
    t.assert_true(ok, "every encoded word <= 75 chars")
    t.assert_gt_int(len(words), 1, "split into several words")
    mut cjk = "日本語のテキストは、Bエンコーディングの方が短くなります。とても長い件名です。"
    mut ec = encode_words(cjk)
    t.assert_starts_with(ec, "=?utf-8?b?", "mostly non-ASCII -> B")
    t.assert_eq_str(decode_header(ec), cjk, "B round trip, characters never split")
    t.assert_starts_with(encode_words("Hello Zoë Example"), "=?utf-8?q?", "mostly ASCII -> Q")
    t.assert_eq_str(encode_words("Café"), "=?utf-8?b?Q2Fmw6k=?=", "shorter of B and Q (as Python)")
    t.assert_eq_str(encode_header_text("Plain subject"), "Plain subject", "ASCII left alone")
    t.assert_starts_with(encode_header_text("literal =?x?q?y?= text"), "=?utf-8?", "text that looks encoded gets encoded")
    t.assert_eq_str(format_phrase("Doe, Jane"), "\"Doe, Jane\"", "specials -> quoted")
    t.assert_eq_str(format_phrase("Jane Doe"), "Jane Doe", "atoms stay")
    t.assert_eq_str(format_phrase("J. Doe"), "\"J. Doe\"", "dot quoted")
    t.assert_eq_str(format_phrase("Zoë"), "=?utf-8?q?Zo=C3=AB?=", "non-ASCII name")

def test_fold_and_dates(t: TestRunner):
    t.section("folding and dates")
    mut v = "word "
    mut long_v = v.repeat(40)
    mut f = fold_header("X-Long", long_v.strip())
    t.assert_true(longest_line(f) <= 78, "folded at 78")
    t.assert_true(all_crlf(f), "CRLF line ends")
    t.assert_eq_str(f.replace("\r\n", ""), "X-Long: " + long_v.strip(), "unfolding restores the value")
    t.assert_eq_str(fold_header("A", "b"), "A: b\r\n", "short header")
    t.assert_eq_str(format_date(0, 0), "Thu, 1 Jan 1970 00:00:00 +0000", "epoch")
    t.assert_eq_str(format_date(1791875100, 120), "Tue, 13 Oct 2026 09:05:00 +0200", "positive offset")
    t.assert_eq_str(format_date(1791875100, -330), "Tue, 13 Oct 2026 01:35:00 -0530", "negative offset")
    t.assert_eq_int(parse_date("Tue, 13 Oct 2026 09:05:00 +0200"), 1791875100, "parse with offset")
    t.assert_eq_int(parse_date("13 Oct 2026 07:05 GMT"), 1791875100, "no day name, no seconds")
    t.assert_eq_int(parse_date("Tue, 13 Oct 2026 03:05:00 EDT (Eastern)"), 1791875100, "named zone + comment")
    t.assert_eq_int(parse_date("Thu, 29 Feb 2024 12:00:00 -0000"), 1709208000, "leap day")
    t.assert_eq_int(parse_date("garbage"), -1, "unparseable")

def test_addresses(t: TestRunner):
    t.section("address lists")
    mut l = Address.parse_list("a@x.test, \"Last, First\" <f@x.test>, =?utf-8?q?Ren=C3=A9?= <r@x.test>, Grp: g1@x.test, \"G Two\" <g2@x.test>;, last@x.test")
    t.assert_eq_int(len(l), 6, "six mailboxes")
    if len(l) == 6:
        t.assert_eq_str(l[1].name, "Last, First", "quoted comma")
        t.assert_eq_str(l[2].name, "René", "encoded word name")
        t.assert_eq_str(l[3].group, "Grp", "group member 1")
        t.assert_eq_str(l[4].name, "G Two", "group member 2 name")
        t.assert_eq_str(l[5].group, "", "after the group")
        t.assert_eq_str(l[2].to_str(), "=?utf-8?b?UmVuw6k=?= <r@x.test>", "re-encoded")
        t.assert_eq_str(l[1].display(), "Last, First <f@x.test>", "display()")
    mut one: Result[Address, str] = Address.parse("  <bare@x.test>  ")
    t.assert_true(one.is_ok and one.ok.addr == "bare@x.test", "angle-only address")
    mut none_r: Result[Address, str] = Address.parse("   ")
    t.assert_true(none_r.is_err, "empty -> error")
    mut adj = Address.parse_list("=?utf-8?q?A?= =?utf-8?q?B?= <ab@x.test>")
    if len(adj) == 1: t.assert_eq_str(adj[0].name, "AB", "adjacent encoded words joined")
    mut utf = Address.parse_list("Jörg <jörg@bücher.example>")
    if len(utf) == 1: t.assert_eq_str(utf[0].addr, "jörg@bücher.example", "RFC 6532 UTF-8 address")

def test_qp(t: TestRunner):
    t.section("quoted-printable and transfer encodings")
    # Body round trip through our encoder and decoder, through to_string/parse.
    mut tricky = "line with trailing space \nequals = sign and tab\t\nA very long line " + "x".repeat(200) + " end\n.dot\nFrom the start\nüñï\n"
    mut m = EmailMessage.init()
    m.set_from("a@x.test")
    m.add_to("b@x.test")
    m.set_text(tricky)
    mut w = m.to_string()
    t.assert_contains(w, "Content-Transfer-Encoding: quoted-printable", "mostly ASCII + UTF-8 -> QP")
    t.assert_true(longest_line(w) <= 78, "QP lines <= 76 (+ headers <= 78)")
    t.assert_true(all_crlf(w), "CRLF everywhere")
    mut p = EmailMessage.parse(w)
    t.assert_eq_str(p.text_body(), tricky, "QP round trip exact")
    # Mostly non-ASCII text -> base64
    mut m2 = EmailMessage.init()
    m2.set_text("ελληνικό κείμενο που είναι σχεδόν όλο μη-ASCII")
    mut w2 = m2.to_string()
    t.assert_contains(w2, "Content-Transfer-Encoding: base64", "non-ASCII heavy -> base64")
    t.assert_eq_str(EmailMessage.parse(w2).text_body(), "ελληνικό κείμενο που είναι σχεδόν όλο μη-ASCII", "base64 text round trip")
    # allow_8bit
    mut m3 = EmailMessage.init()
    m3.allow_8bit = true
    m3.set_text("naïve\n")
    t.assert_contains(m3.to_string(), "Content-Transfer-Encoding: 8bit", "allow_8bit")
    # pure ASCII -> 7bit
    mut m4 = EmailMessage.init()
    m4.set_text("ascii only\n")
    t.assert_contains(m4.to_string(), "Content-Transfer-Encoding: 7bit", "ASCII -> 7bit")
    t.assert_contains(m4.to_string(), "Content-Type: text/plain; charset=utf-8", "charset label")
    # Python-generated QP (quopri.encodestring with quotetabs=False on the RFC 2045 rules)
    mut pyqp = "J'interdis aux marchands de vanter trop leurs marchandises. Car ils se font=\r\n vite p=C3=A9dagogues et t'enseignent comme but ce qui n'est par essence qu=\r\n'un moyen, et te trompant ainsi sur la route =C3=A0 suivre les voil=C3=\r\n=A0 bient=C3=B4t qui te d=C3=A9gradent.\r\n"
    mut msg = "Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\n" + pyqp
    t.assert_eq_str(EmailMessage.parse(msg).text_body(), "J'interdis aux marchands de vanter trop leurs marchandises. Car ils se font vite pédagogues et t'enseignent comme but ce qui n'est par essence qu'un moyen, et te trompant ainsi sur la route à suivre les voilà bientôt qui te dégradent.\n", "decode QP split inside a UTF-8 sequence")
    mut msg2 = "Content-Transfer-Encoding: quoted-printable\n\nbad =ZZ and =4 end=  \nnext"
    t.assert_eq_str(EmailMessage.parse(msg2).text_body(), "bad =ZZ and =4 endnext", "malformed = kept, padded soft break")

def build_sample() -> EmailMessage:
    mut m = EmailMessage.init()
    m.boundary_seed = "=_b"
    m.set_from("Zoë Ünicode <zoe@example.com>")
    m.add_to("Bob <bob@example.com>, \"Doe, Jane\" <jane@example.org>")
    m.add_address("Cc", "Ünal Çelik", "unal@example.net")
    m.add_bcc("hidden@example.com")
    m.set_reply_to("replies@example.com")
    m.set_subject("Grüße – a long subject line that has to be folded across several lines, really")
    m.set_date_tz(1791875100, 120)
    m.set_message_id("built.1@example.com")
    m.set_in_reply_to("parent@example.com")
    m.add_reference("root@example.com")
    m.add_reference("parent@example.com")
    m.set_header("X-Mailer", "Tauraro std.net.email")
    m.set_text("Hello Bob,\n\nthe report is attached — Grüße.\n.leading dot line\n")
    m.set_html("<p>Hello <b>Bob</b>,</p><p>Grüße</p><img src=\"cid:logo\">\n")
    m.add_inline("logo", "logo.png", bytes_of([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 0]))
    m.attach("Übersicht 2026.csv", "col1,col2\n1,2\n")
    mut bin = StringBuilder.init(256)
    mut i = 0
    while i < 256:
        bin.append_char(i)
        i = i + 1
    mut data = bin.to_owned()
    bin.free()
    m.attach_as("all-bytes.bin", "application/octet-stream", data)
    return m

def built_wire() -> str:
    return """From: =?utf-8?b?Wm/DqyDDnG5pY29kZQ==?= <zoe@example.com>
To: Bob <bob@example.com>, "Doe, Jane" <jane@example.org>
Cc: =?utf-8?b?w5xuYWwgw4dlbGlr?= <unal@example.net>
Reply-To: replies@example.com
Subject: =?utf-8?q?Gr=C3=BC=C3=9Fe_=E2=80=93_a_long_subject_line_that_has_?=
 =?utf-8?q?to_be_folded_across_several_lines=2C_really?=
Date: Tue, 13 Oct 2026 09:05:00 +0200
Message-ID: <built.1@example.com>
In-Reply-To: <parent@example.com>
References: <root@example.com> <parent@example.com>
X-Mailer: Tauraro std.net.email
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="=_b_3."

--=_b_3.
Content-Type: multipart/alternative; boundary="=_b_2."

--=_b_2.
Content-Type: text/plain; charset=utf-8
Content-Transfer-Encoding: quoted-printable

Hello Bob,

the report is attached =E2=80=94 Gr=C3=BC=C3=9Fe.
.leading dot line

--=_b_2.
Content-Type: multipart/related; boundary="=_b_1."

--=_b_1.
Content-Type: text/html; charset=utf-8
Content-Transfer-Encoding: quoted-printable

<p>Hello <b>Bob</b>,</p><p>Gr=C3=BC=C3=9Fe</p><img src=3D"cid:logo">

--=_b_1.
Content-Type: image/png; name=logo.png
Content-Transfer-Encoding: base64
Content-Disposition: inline; filename=logo.png
Content-ID: <logo>

iVBORw0KGgoAAAAA

--=_b_1.--

--=_b_2.--

--=_b_3.
Content-Type: text/csv; name*=utf-8''%C3%9Cbersicht%202026.csv
Content-Transfer-Encoding: base64
Content-Disposition: attachment; filename*=utf-8''%C3%9Cbersicht%202026.csv

Y29sMSxjb2wyCjEsMgo=

--=_b_3.
Content-Type: application/octet-stream; name=all-bytes.bin
Content-Transfer-Encoding: base64
Content-Disposition: attachment; filename=all-bytes.bin

AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4
OTo7PD0+P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3Bx
cnN0dXZ3eHl6e3x9fn+AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqOkpaanqKmq
q6ytrq+wsbKztLW2t7i5uru8vb6/wMHCw8TFxsfIycrLzM3Oz9DR0tPU1dbX2Nna29zd3t/g4eLj
5OXm5+jp6uvs7e7v8PHy8/T19vf4+fr7/P3+/w==

--=_b_3.--
"""

def test_build(t: TestRunner):
    t.section("build messages")
    mut m = build_sample()
    mut w = m.to_string()
    t.assert_eq_str(w, crlf(built_wire()), "wire form (verified with Python's email parser)")
    t.assert_true(all_crlf(w), "CRLF line endings")
    t.assert_true(longest_line(w) <= 78, "no line over 78 characters")
    t.assert_true(w.find("hidden@example.com") < 0, "Bcc not written")
    t.assert_true(w.find("\r\nBcc:") < 0, "no Bcc header")
    mut rc = m.recipients()
    t.assert_eq_int(len(rc), 4, "To + Cc + Bcc recipients")
    if len(rc) == 4: t.assert_eq_str(rc[3], "hidden@example.com", "Bcc in the envelope")
    t.assert_eq_str(m.envelope_from(), "zoe@example.com", "envelope sender")
    # Round trip through our parser
    mut p = EmailMessage.parse(w)
    t.assert_eq_str(p.subject(), "Grüße – a long subject line that has to be folded across several lines, really", "subject round trip")
    mut cc = p.cc()
    if len(cc) == 1: t.assert_eq_str(cc[0].name, "Ünal Çelik", "Cc name round trip")
    t.assert_eq_str(p.text_body(), "Hello Bob,\n\nthe report is attached — Grüße.\n.leading dot line\n", "text round trip")
    t.assert_eq_str(p.html_body(), "<p>Hello <b>Bob</b>,</p><p>Grüße</p><img src=\"cid:logo\">\n", "html round trip")
    mut atts = p.attachments()
    t.assert_eq_int(len(atts), 3, "inline + 2 attachments")
    if len(atts) == 3:
        t.assert_true(atts[0].is_inline, "logo inline")
        t.assert_eq_str(atts[0].content_id, "logo", "logo cid")
        t.assert_eq_str(atts[1].filename, "Übersicht 2026.csv", "non-ASCII filename round trip")
        t.assert_eq_str(atts[1].content_type, "text/csv", "type from std.net.mime")
        t.assert_eq_int(atts[2].data.len(), 256, "binary round trip length")
        t.assert_true(atts[2].data == m.attachments()[2].data, "binary round trip bytes")
    t.assert_eq_str(p.header("X-Mailer"), "Tauraro std.net.email", "custom header")
    t.assert_eq_int(len(p.references()), 2, "References round trip")
    # Re-serialising a parsed message keeps it byte-identical
    t.assert_eq_str(p.to_string(), w, "parse -> to_string is lossless")
    # Simple shapes
    mut h = EmailMessage.init()
    h.set_html("<b>x</b>")
    t.assert_eq_str(h.content_type(), "text/html", "html only -> text/html")
    mut a = EmailMessage.init()
    a.set_text("x")
    a.attach("n.txt", "note")
    t.assert_eq_str(a.content_type(), "multipart/mixed", "text + attachment -> mixed")
    mut e = EmailMessage.init()
    t.assert_eq_str(e.content_type(), "text/plain", "empty -> text/plain")
    mut auto = EmailMessage.init()
    auto.set_from("x@auto.test")
    auto.set_text("y")
    mut aw = auto.to_string()
    t.assert_contains(aw, "\r\nDate: ", "Date added")
    t.assert_contains(aw, "@auto.test>\r\n", "Message-ID uses the From domain")
    t.assert_contains(aw, "MIME-Version: 1.0\r\n", "MIME-Version")
    # Unique random boundaries
    mut r1 = EmailMessage.init()
    r1.set_text("a")
    r1.attach("a.bin", "1")
    mut r2 = EmailMessage.init()
    r2.set_text("a")
    r2.attach("a.bin", "1")
    r1.build()
    r2.build()
    t.assert_true(r1.root.ctype.param("boundary") != r2.root.ctype.param("boundary"), "boundaries differ between messages")
    t.assert_true(r1.message_id() != r2.message_id(), "message ids differ")

# ── fake SMTP server ────────────────────────────────────────────────────────

class Flags implements Sendable:
    pub port:       int
    pub bad:        Atomic[int]
    pub done:       Atomic[int]
    pub data_len:   Atomic[int]   # length of the un-dot-stuffed DATA payload
    pub dot_ok:     Atomic[int]   # ".leading dot line" arrived dot-stuffed
    pub blank_ok:   Atomic[int]   # header/body separator survived
    pub bcc_leak:   Atomic[int]   # a Bcc header or address appeared in DATA
    pub subject_ok: Atomic[int]   # server-side parse of the received message

extend Flags:
    pub def init(port: int) -> Flags:
        mut f = Flags()
        f.port = port
        f.bad = Atomic.new(0)
        f.done = Atomic.new(0)
        f.data_len = Atomic.new(0)
        f.dot_ok = Atomic.new(0)
        f.blank_ok = Atomic.new(0)
        f.bcc_leak = Atomic.new(0)
        f.subject_ok = Atomic.new(0)
        return f

class LineBuf:
    pub carry: str

extend LineBuf:
    pub def init() -> LineBuf:
        mut b = LineBuf()
        b.carry = ""
        return b

    pub def read_line(self, s: TcpStream) -> str:
        while true:
            mut nl = self.carry.find("\n")
            if nl >= 0:
                mut line = self.carry.slice(0, nl)
                if line.ends_with("\r"): line = line.slice(0, line.len() - 1)
                self.carry = self.carry.slice(nl + 1, self.carry.len())
                return line
            mut chunk = s.recv(4096)
            if chunk.len() == 0:
                mut rest = self.carry
                self.carry = ""
                return rest
            self.carry = self.carry + chunk
        return ""

def step(conn: TcpStream, lb: LineBuf, f: Shared[Flags], expect: str, reply: str):
    mut line = lb.read_line(conn)
    if line != expect:
        print("  server expected: " + expect)
        print("  server got:      " + line)
        f.bad.add(1)
    conn.send(reply + "\r\n")

def smtp_server(f: Shared[Flags]):
    mut l = TcpListener.listen("127.0.0.1", f.port)
    mut c = l.accept()
    mut lb = LineBuf.init()
    c.send("220 fake ESMTP\r\n")
    step(c, lb, f, "EHLO tester", "250-fake\r\n250-8BITMIME\r\n250 SMTPUTF8")
    step(c, lb, f, "MAIL FROM:<zoe@example.com>", "250 ok")
    step(c, lb, f, "RCPT TO:<bob@example.com>", "250 ok")
    step(c, lb, f, "RCPT TO:<jane@example.org>", "250 ok")
    step(c, lb, f, "RCPT TO:<unal@example.net>", "250 ok")
    step(c, lb, f, "RCPT TO:<hidden@example.com>", "250 ok")
    step(c, lb, f, "DATA", "354 go ahead")
    mut sb = StringBuilder.init(8192)
    mut first_blank = false
    while true:
        mut line = lb.read_line(c)
        if line == ".": break
        if line == "..leading dot line": f.dot_ok.store(1)
        if line.len() == 0 and not first_blank:
            first_blank = true
            f.blank_ok.store(1)
        if line.starts_with("Bcc:") or line.find("hidden@") >= 0: f.bcc_leak.store(1)
        if line.starts_with("."): line = line.slice(1, line.len())
        sb.append(line)
        sb.append("\r\n")
    mut got = sb.to_owned()
    sb.free()
    f.data_len.store(got.len())
    mut pm = EmailMessage.parse(got)
    if pm.subject().starts_with("Grüße – a long subject") and len(pm.attachments()) == 3: f.subject_ok.store(1)
    c.send("250 queued as 1\r\n")
    step(c, lb, f, "MAIL FROM:<zoe@example.com> BODY=8BITMIME SMTPUTF8", "250 ok")
    step(c, lb, f, "RCPT TO:<jörg@bücher.example>", "553 no")
    step(c, lb, f, "QUIT", "221 bye")
    c.close()
    l.close()
    f.done.store(1)

def test_smtp(t: TestRunner):
    t.section("send through std.net.smtp")
    shared f = Flags.init(18977)
    mut th = Thread.spawn(smtp_server, f)
    Thread.sleep(200)
    mut c = SmtpClient.connect("127.0.0.1", 18977)
    t.assert_true(c.connected, "connected")
    if not c.connected: return
    c.ehlo("tester")
    t.assert_true(c.supports("8BITMIME"), "8BITMIME advertised")
    mut m = build_sample()
    mut expect = m.to_string()
    mut r = c.send_message(m)
    t.assert_eq_int(r.code, 250, "DATA accepted")
    # 8-bit body + UTF-8 envelope recipient -> BODY=8BITMIME SMTPUTF8
    mut u = EmailMessage.init()
    u.allow_8bit = true
    u.set_from("zoe@example.com")
    u.add_to("Jörg <jörg@bücher.example>")
    u.set_text("Grüße\n")
    mut r2 = c.send_message(u)
    t.assert_eq_int(r2.code, 553, "first failing reply returned")
    c.quit()
    th.join()
    t.assert_eq_int(f.bad.load(), 0, "every SMTP command matched on the wire")
    t.assert_eq_int(f.done.load(), 1, "server finished")
    t.assert_eq_int(f.data_len.load(), expect.len(), "DATA payload equals to_string() byte count")
    t.assert_eq_int(f.dot_ok.load(), 1, "dot-stuffing applied")
    t.assert_eq_int(f.blank_ok.load(), 1, "blank lines preserved")
    t.assert_eq_int(f.bcc_leak.load(), 0, "Bcc never sent in DATA")
    t.assert_eq_int(f.subject_ok.load(), 1, "server parsed the received message")

def main():
    mut t = TestRunner.init("124_email")
    test_python_vec1(t)
    test_legacy_vec2(t)
    test_rfc2047(t)
    test_fold_and_dates(t)
    test_addresses(t)
    test_qp(t)
    test_build(t)
    test_smtp(t)
    t.summary()
