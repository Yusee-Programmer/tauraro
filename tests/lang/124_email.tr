# tests/lang/124_email.tr
# std.net.email: parsing messages generated by Python's `email` package,
# legacy/obsolete syntax, building messages that Python parses back
# identically, RFC 2047 / 2231 / quoted-printable details, and sending a built
# message through a fake SMTP server (std.net.smtp send_message) in a thread.
#
# VEC1 was produced by Python 3.14:
#   m = email.message.EmailMessage(policy=email.policy.SMTP)
#   m['From'] = Address('Zoë Ünicode', 'zoe', 'example.com')
#   m['To'] = [Address('Bob', ...), Group('Team', [Address('Ann Lee', ...), Address('', 'carl', ...)])]
#   m.set_content(...); m.add_alternative(html, subtype='html')
#   html.add_related(png, cid='<logo123>', filename='logo.png')
#   m.add_attachment(csv, filename='Übersicht 2026.csv'); m.add_attachment(bytes(range(256)), ...)
# and the expected values below are what Python's parser reports for it
# (get_body / iter_attachments / headerregistry addresses).
#
# VEC2 is hand-written legacy mail (ISO-8859-1 QP, Windows-1252 base64, RFC
# 2231 filename continuations, obsolete route / comments / group syntax,
# two-digit year, an unsupported charset and a message/rfc822 part); the
# expectations are again Python's (email.policy.default), except that a
# trailing "(Mary Smith)" comment is used as the display name as
# email.utils.getaddresses does.
#
# BUILT_WIRE is this module's output for build_sample(); Python 3.14 parses
# it with no defects and reports the same subject, addresses, bodies and
# attachment bytes that are asserted here for our own parser.

from std.test import TestRunner
from std.net.tcp import TcpStream, TcpListener
from std.net.smtp import SmtpClient, SmtpResponse
from std.net.email import EmailMessage, Address, Attachment, MimePart, decode_header, decode_header_strict, encode_words, encode_header_text, fold_header, parse_date, format_date, format_phrase
from std.net.mime import Mime
from std.core.string import StringBuilder

def bytes_of(vals: List[int]) -> str:
    mut sb = StringBuilder.init(len(vals) + 1)
    mut i = 0
    while i < len(vals):
        sb.append_char(vals[i])
        i = i + 1
    mut out = sb.to_owned()
    sb.free()
    return out

def byte_at(s: str, i: int) -> int:
    mut p = s as Pointer[char]
    unsafe: return (p.offset(i).read() as int) & 255

def crlf(s: str) -> str:
    return s.replace("\n", "\r\n")

# Longest line (without its CR/LF) in s.
def longest_line(s: str) -> int:
    mut best = 0
    mut cur = 0
    mut i = 0
    while i < s.len():
        mut c = byte_at(s, i)
        if c == 10 or c == 13:
            cur = 0
        else:
            cur = cur + 1
            if cur > best: best = cur
        i = i + 1
    return best

# Every '\n' is preceded by '\r' (and no bare '\r').
def all_crlf(s: str) -> bool:
    mut i = 0
    while i < s.len():
        mut c = byte_at(s, i)
        if c == 10 and (i == 0 or byte_at(s, i - 1) != 13): return false
        if c == 13 and (i + 1 >= s.len() or byte_at(s, i + 1) != 10): return false
        i = i + 1
    return true

