# tests/lang/111_blake2.tr
# std.crypto.blake2: BLAKE2b / BLAKE2s (RFC 7693).
# Known answers: RFC 7693 appendix A/B ("abc"), the official BLAKE2 KAT file's
# keyed vectors (key = 00 01 02 .., input = 00 01 02 ..), plus Python hashlib
# (reference) for every block-boundary length, digest sizes, salt/person and
# the incremental API.

from std.test import TestRunner
from std.crypto.blake2 import Blake2b, Blake2s, Blake2bHasher, Blake2sHasher
from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

# bytes 0,1,2,..,n-1 (mod 256)
def seqbytes(n: int) -> str:
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, i)
        i = i + 1
    return CryptoBytes.wrap(p, n)

# byte i = (i*13 + 5) & 255
def pattern(n: int) -> str:
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, i * 13 + 5)
        i = i + 1
    return CryptoBytes.wrap(p, n)

def main():
    mut t = TestRunner.init("111_blake2")
    t.section("RFC 7693 appendix vectors")

    t.assert_eq_str(Blake2b.hash_hex("abc", 64), "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923", "BLAKE2b-512 abc (RFC 7693 A)")
    t.assert_eq_str(Blake2s.hash_hex("abc", 32), "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982", "BLAKE2s-256 abc (RFC 7693 B)")
    t.assert_eq_str(Blake2b.hash_hex("", 64), "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce", "BLAKE2b-512 empty")
    t.assert_eq_str(Blake2s.hash_hex("", 32), "69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9", "BLAKE2s-256 empty")
    t.section("official KAT: keyed, key 00..3f / 00..1f, input 00..n-1")
    mut kb = seqbytes(64)
    mut ks = seqbytes(32)
    mut q0 = seqbytes(0)
    t.assert_eq_str(Blake2b.keyed_hex(q0, kb, 64), "10ebb67700b1868efb4417987acf4690ae9d972fb7a590c2f02871799aaa4786b5e996e8f0f4eb981fc214b005f42d2ff4233499391653df7aefcbc13fc51568", "blake2b keyed len 0")
    t.assert_eq_str(Blake2s.keyed_hex(q0, ks, 32), "48a8997da407876b3d79c0d92325ad3b89cbb754d86ab71aee047ad345fd2c49", "blake2s keyed len 0")
    mut q1 = seqbytes(1)
    t.assert_eq_str(Blake2b.keyed_hex(q1, kb, 64), "961f6dd1e4dd30f63901690c512e78e4b45e4742ed197c3c5e45c549fd25f2e4187b0bc9fe30492b16b0d0bc4ef9b0f34c7003fac09a5ef1532e69430234cebd", "blake2b keyed len 1")
    t.assert_eq_str(Blake2s.keyed_hex(q1, ks, 32), "40d15fee7c328830166ac3f918650f807e7e01e177258cdc0a39b11f598066f1", "blake2s keyed len 1")
    mut q2 = seqbytes(2)
    t.assert_eq_str(Blake2b.keyed_hex(q2, kb, 64), "da2cfbe2d8409a0f38026113884f84b50156371ae304c4430173d08a99d9fb1b983164a3770706d537f49e0c916d9f32b95cc37a95b99d857436f0232c88a965", "blake2b keyed len 2")
    t.assert_eq_str(Blake2s.keyed_hex(q2, ks, 32), "6bb71300644cd3991b26ccd4d274acd1adeab8b1d7914546c1198bbe9fc9d803", "blake2s keyed len 2")
    mut q3 = seqbytes(3)
    t.assert_eq_str(Blake2b.keyed_hex(q3, kb, 64), "33d0825dddf7ada99b0e7e307104ad07ca9cfd9692214f1561356315e784f3e5a17e364ae9dbb14cb2036df932b77f4b292761365fb328de7afdc6d8998f5fc1", "blake2b keyed len 3")
    t.assert_eq_str(Blake2s.keyed_hex(q3, ks, 32), "1d220dbe2ee134661fdf6d9e74b41704710556f2f6e5a091b227697445dbea6b", "blake2s keyed len 3")
    mut q63 = seqbytes(63)
    t.assert_eq_str(Blake2b.keyed_hex(q63, kb, 64), "bd965bf31e87d70327536f2a341cebc4768eca275fa05ef98f7f1b71a0351298de006fba73fe6733ed01d75801b4a928e54231b38e38c562b2e33ea1284992fa", "blake2b keyed len 63")
    t.assert_eq_str(Blake2s.keyed_hex(q63, ks, 32), "c65382513f07460da39833cb666c5ed82e61b9e998f4b0c4287cee56c3cc9bcd", "blake2s keyed len 63")
    mut q64 = seqbytes(64)
    t.assert_eq_str(Blake2b.keyed_hex(q64, kb, 64), "65676d800617972fbd87e4b9514e1c67402b7a331096d3bfac22f1abb95374abc942f16e9ab0ead33b87c91968a6e509e119ff07787b3ef483e1dcdccf6e3022", "blake2b keyed len 64")
    t.assert_eq_str(Blake2s.keyed_hex(q64, ks, 32), "8975b0577fd35566d750b362b0897a26c399136df07bababbde6203ff2954ed4", "blake2s keyed len 64")
    mut q127 = seqbytes(127)
    t.assert_eq_str(Blake2b.keyed_hex(q127, kb, 64), "76d2d819c92bce55fa8e092ab1bf9b9eab237a25267986cacf2b8ee14d214d730dc9a5aa2d7b596e86a1fd8fa0804c77402d2fcd45083688b218b1cdfa0dcbcb", "blake2b keyed len 127")
    t.assert_eq_str(Blake2s.keyed_hex(q127, ks, 32), "ddbfea75cc467882eb3483ce5e2e756a4f4701b76b445519e89f22d60fa86e06", "blake2s keyed len 127")
    mut q128 = seqbytes(128)
    t.assert_eq_str(Blake2b.keyed_hex(q128, kb, 64), "72065ee4dd91c2d8509fa1fc28a37c7fc9fa7d5b3f8ad3d0d7a25626b57b1b44788d4caf806290425f9890a3a2a35a905ab4b37acfd0da6e4517b2525c9651e4", "blake2b keyed len 128")
    t.assert_eq_str(Blake2s.keyed_hex(q128, ks, 32), "0c311f38c35a4fb90d651c289d486856cd1413df9b0677f53ece2cd9e477c60a", "blake2s keyed len 128")
    mut q129 = seqbytes(129)
    t.assert_eq_str(Blake2b.keyed_hex(q129, kb, 64), "64475dfe7600d7171bea0b394e27c9b00d8e74dd1e416a79473682ad3dfdbb706631558055cfc8a40e07bd015a4540dcdea15883cbbf31412df1de1cd4152b91", "blake2b keyed len 129")
    t.assert_eq_str(Blake2s.keyed_hex(q129, ks, 32), "46a73a8dd3e70f59d3942c01df599def783c9da82fd83222cd662b53dce7dbdf", "blake2s keyed len 129")
    mut q200 = seqbytes(200)
    t.assert_eq_str(Blake2b.keyed_hex(q200, kb, 64), "3095a349d245708c7cf550118703d7302c27b60af5d4e67fc978f8a4e60953c7a04f92fcf41aee64321ccb707a895851552b1e37b00bc5e6b72fa5bcef9e3fff", "blake2b keyed len 200")
    t.assert_eq_str(Blake2s.keyed_hex(q200, ks, 32), "13c88480a5d00d6c8c7ad2110d76a82d9b70f4fa6696d4e5dd42a066dcaf9920", "blake2s keyed len 200")
    mut q255 = seqbytes(255)
    t.assert_eq_str(Blake2b.keyed_hex(q255, kb, 64), "142709d62e28fcccd0af97fad0f8465b971e82201dc51070faa0372aa43e92484be1c1e73ba10906d5d1853db6a4106e0a7bf9800d373d6dee2d46d62ef2a461", "blake2b keyed len 255")
    t.assert_eq_str(Blake2s.keyed_hex(q255, ks, 32), "3fb735061abc519dfe979e54c1ee5bfad0a9d858b3315bad34bde999efd724dd", "blake2s keyed len 255")
    t.section("unkeyed, block-boundary lengths")
    mut u1 = pattern(1)
    t.assert_eq_str(Blake2b.hash_hex(u1, 64), "25a56b041ab162d71bbdceef5c62e14dd217b68ed5267ed2c6cf934493deae03190b646c68ad3be94fd9f245c4469e10e8d3e7fa3a927d62b589c80f4dc55caf", "blake2b-512 len 1")
    t.assert_eq_str(Blake2s.hash_hex(u1, 32), "4a65c7f455e91fffa9d44672962567f030babb13183aa95d0e8f0a9cac3d3c37", "blake2s-256 len 1")
    mut u31 = pattern(31)
    t.assert_eq_str(Blake2b.hash_hex(u31, 64), "d193490594227badfb68adfce3f41c3ee701992f06c25e59afb8c146940e323dd2ff65f6e968171029acf714e7b0bc7110462e7eaf11a45267cdfbeb5fcf91dd", "blake2b-512 len 31")
    t.assert_eq_str(Blake2s.hash_hex(u31, 32), "a45e8ba4433fa44a049d88b46e2897f9adbda44bc943388a7f34d9a4f431c0fa", "blake2s-256 len 31")
    mut u32 = pattern(32)
    t.assert_eq_str(Blake2b.hash_hex(u32, 64), "77c38b29e9ae635a44b4d1e6cca5ddf35d729d2f754884dca1d18f33076c0be306f319e391dbbda543b7343079334f97d156a8ac5146b772afea74ca51a8d2f4", "blake2b-512 len 32")
    t.assert_eq_str(Blake2s.hash_hex(u32, 32), "c1d75285d497bff76c71546349f9f7fafbd30ed68a6b0793820c89dd8ba262e1", "blake2s-256 len 32")
    mut u33 = pattern(33)
    t.assert_eq_str(Blake2b.hash_hex(u33, 64), "403b19e7ede1d2082f982324e72fceac05e884b05cdd16d3f3ba9b677576e2df870213f903663a97d50251dcab08f0aba5b87702b7081d6d737c57555cb1234c", "blake2b-512 len 33")
    t.assert_eq_str(Blake2s.hash_hex(u33, 32), "0f475fb586933616946fef4bc971f0447d1569d7e0a06035a83fedc55cab7d3f", "blake2s-256 len 33")
    mut u63 = pattern(63)
    t.assert_eq_str(Blake2b.hash_hex(u63, 64), "683925461eee683cb8e8a1e303fdc1c785422f7bc4b5aa25c99d81d57086fbb7fc74ae8f6831aedd092eb16a7ad2b485490fccd8c6f7f0cf4292b4fecdafa935", "blake2b-512 len 63")
    t.assert_eq_str(Blake2s.hash_hex(u63, 32), "787a547452777ef67a90e102c8b92cbdd11a7b2620ab28c85d3d975811f20d00", "blake2s-256 len 63")
    mut u64 = pattern(64)
    t.assert_eq_str(Blake2b.hash_hex(u64, 64), "990f0022b4ec2e83dea9ae89c4877cdbda6717dca26900d50cab70906a4a6d8359dceaac3c6f42a66f78ad00c6d48b1e888297aab82763f18286cbb806f90d4b", "blake2b-512 len 64")
    t.assert_eq_str(Blake2s.hash_hex(u64, 32), "7c5734e1bdfe80a6d028b3204635d6ade499b0702c20f41b9739f0230ab8b8b3", "blake2s-256 len 64")
    mut u65 = pattern(65)
    t.assert_eq_str(Blake2b.hash_hex(u65, 64), "c0a7dec9c05ed50bfd234e5252ad9474f1653f0e537b4405562de0715bf9e27fe683104c9e01c209af54d0ea2e15fbaed77fdd5d71e66525e01225372e50fb91", "blake2b-512 len 65")
    t.assert_eq_str(Blake2s.hash_hex(u65, 32), "83c631f8d41064a25e65e84a1d99c957f24997392368c62fce4811b0bec4e72a", "blake2s-256 len 65")
    mut u127 = pattern(127)
    t.assert_eq_str(Blake2b.hash_hex(u127, 64), "930f453c4bb76e32b7f12a474d562055b31406fc5470efcc3cce21d75b2b44954b2d2fdab2b03c09b83a95a6d6dcf608564501cab69fffc2c505a0486cff1dc3", "blake2b-512 len 127")
    t.assert_eq_str(Blake2s.hash_hex(u127, 32), "77fce932534fb26856f4cbf791ee2f81bb13e369e82baf7444a070b88d4f3577", "blake2s-256 len 127")
    mut u128 = pattern(128)
    t.assert_eq_str(Blake2b.hash_hex(u128, 64), "cbd4ce342f3806d816b58fd5e5bba5e530083670bbac7d87b62c83819ddccaf41a5855fd4f5d77d215f413278d61c8365d1ec2aa617c0ebb3980b97833db36ab", "blake2b-512 len 128")
    t.assert_eq_str(Blake2s.hash_hex(u128, 32), "77d8832fc20c9969f5d457dae9e5c68a489eeac25e1d379969b638bfb395588d", "blake2s-256 len 128")
    mut u129 = pattern(129)
    t.assert_eq_str(Blake2b.hash_hex(u129, 64), "d3c0f4d636fdb51ba3ca2961a1d166f8f9f87052ae08e8f978d1c3cb2f244e7ba8b4a46f08727d5b5df98c10cf176d55833bcef00685596513f579ab3f9e879a", "blake2b-512 len 129")
    t.assert_eq_str(Blake2s.hash_hex(u129, 32), "74b434c093ec5cfa83c644b062eda50d1db275c477e71ef155914972fc47d3f9", "blake2s-256 len 129")
    mut u191 = pattern(191)
    t.assert_eq_str(Blake2b.hash_hex(u191, 64), "113b0ec3fb9be062a8203c83fa61688d0b78932046d92d57e07f4c44e79ad29d2e79ba189b290458367560b941d23a086aaeb2be5ef4c75967411128586658c3", "blake2b-512 len 191")
    t.assert_eq_str(Blake2s.hash_hex(u191, 32), "a01195068c272b63cd99047fae018a01791ad8a436a6fc9f56b470234126b4c7", "blake2s-256 len 191")
    mut u192 = pattern(192)
    t.assert_eq_str(Blake2b.hash_hex(u192, 64), "9256e9d5a1a71ee04b3466e392944e704c62fa0e65da3ac3699c303da8a30d2bc7e54527273a0f9a72af65cbe9796231fc3fac5db92e66cad514a5a32f320b74", "blake2b-512 len 192")
    t.assert_eq_str(Blake2s.hash_hex(u192, 32), "58c405557eacd8f5d9f714ed9663aede1c840c553347dc850d61f5cde7c87690", "blake2s-256 len 192")
    mut u193 = pattern(193)
    t.assert_eq_str(Blake2b.hash_hex(u193, 64), "3590a05c7682c584749dabbbf8d346a78b3cc973702b854dc45dc184f3ecb44c44d18d8d4af5ac9df9314ba2121b62ee8cfeb404245aa04e2cefb6a4af582e75", "blake2b-512 len 193")
    t.assert_eq_str(Blake2s.hash_hex(u193, 32), "763e1c59e499504238118af44076406b9a9ee7d67ccb663260b30a5ebdfb5a01", "blake2s-256 len 193")
    mut u255 = pattern(255)
    t.assert_eq_str(Blake2b.hash_hex(u255, 64), "cbc6bf2ef087735e5921b7109094cd54e20732dda023e6f996c27b5bb63b9f7aa1dac461559f0753fd08d465746a2a82b420b5876fa15184ba8153c99645f74b", "blake2b-512 len 255")
    t.assert_eq_str(Blake2s.hash_hex(u255, 32), "bd8a670c02f277f00c15d8b4d7edb11807b58bf43662fb9d18229d6e4d268f74", "blake2s-256 len 255")
    mut u256 = pattern(256)
    t.assert_eq_str(Blake2b.hash_hex(u256, 64), "3986ff4540021098da0a1854179f2105b9824e02e5af9ea4bd265f18ecb5c16211cc54090a0e5c0150f3ff2f7b1acb4e63a115d03edb5625da59f29bb776a1d9", "blake2b-512 len 256")
    t.assert_eq_str(Blake2s.hash_hex(u256, 32), "a366e380b686187178394d416a100d3c67b4cc5baf54e7e26f7a989f4653de3b", "blake2s-256 len 256")
    mut u257 = pattern(257)
    t.assert_eq_str(Blake2b.hash_hex(u257, 64), "3a4c8e7023dbc473c498ba14e5672667d6710885531fdf3149b643d3a7a41d19436d47941493cc5762bb777ba95b92e2fefa3fcc1bc2c95b6563d6de5e640b2b", "blake2b-512 len 257")
    t.assert_eq_str(Blake2s.hash_hex(u257, 32), "3dfd988d88dd83c8d3b7ed3028d0543f148701c95523a985d9a0d3c4515f48c1", "blake2s-256 len 257")
    mut u1000 = pattern(1000)
    t.assert_eq_str(Blake2b.hash_hex(u1000, 64), "dc19ee71657d34442b5b3f6e0cfa9217a65f6d55a094c3f9fdd0b2e2dff96efb66a848e03057c0647d2147e7af2efff1a1dc8bca796478cf91a723a5bff6de1b", "blake2b-512 len 1000")
    t.assert_eq_str(Blake2s.hash_hex(u1000, 32), "56e6f0b3bd432cbb71890495415a6ec5378c951a78735c6bf609b8a49d6cc8d5", "blake2s-256 len 1000")
    mut u4096 = pattern(4096)
    t.assert_eq_str(Blake2b.hash_hex(u4096, 64), "b0cc5bb428538b341072aed88674f60a857a5e8df959f77fd04a048ebc0e9903da77c7e1f6ad5f491cbb840bac68b0ca52d14b96e0b8d40e006b00fee0d411ca", "blake2b-512 len 4096")
    t.assert_eq_str(Blake2s.hash_hex(u4096, 32), "7c8079f9e01e1123d344404188430de38dc15e5dc1762ec7d1aa92a5232dcd1c", "blake2s-256 len 4096")
    t.section("digest sizes")
    t.assert_eq_str(Blake2b.hash_hex(pattern(100), 1), "ec", "blake2b digest_size 1")
    t.assert_eq_str(Blake2b.hash_hex(pattern(100), 16), "dc32b86cbb12d2a15f86b3051da4531f", "blake2b digest_size 16")
    t.assert_eq_str(Blake2b.hash_hex(pattern(100), 20), "adba45a880aab937bd366ffef10b22a90effbb20", "blake2b digest_size 20")
    t.assert_eq_str(Blake2b.hash_hex(pattern(100), 28), "c77f7f2c6d0821c7384648a6e076e5fa6591e8e8329d7afa10ba181f", "blake2b digest_size 28")
    t.assert_eq_str(Blake2b.hash_hex(pattern(100), 32), "7cf216e9684dc604012d16f26dda04c155c12c7a7cf2219d59a930f7f1a2cf29", "blake2b digest_size 32")
    t.assert_eq_str(Blake2b.hash_hex(pattern(100), 48), "decbd2f5bd8f01a12906f8cc2992fa9d6d6b05b8b0eaaf71c5df84c250c908e92dba0e7ac49bf4747b8f9a67c0b23427", "blake2b digest_size 48")
    t.assert_eq_str(Blake2b.hash_hex(pattern(100), 64), "a1ee47ce315f26fe04d1c6a11bbb8435be41ed82fe2e9ca76058490ddd780f6b61498fc332c12ed876ed30cc5ed9fd923c440410c162ec16ce32f49a16370f2e", "blake2b digest_size 64")
    t.assert_eq_str(Blake2s.hash_hex(pattern(100), 1), "d7", "blake2s digest_size 1")
    t.assert_eq_str(Blake2s.hash_hex(pattern(100), 16), "5701de5040cc43a8ce13da3743a43ada", "blake2s digest_size 16")
    t.assert_eq_str(Blake2s.hash_hex(pattern(100), 20), "47569c51b81bcb2e24df1ff8b156ea9e9798be2f", "blake2s digest_size 20")
    t.assert_eq_str(Blake2s.hash_hex(pattern(100), 28), "19a23ccd5eaa788683194a0c84ca49a0a87642b3a4520e0922c84358", "blake2s digest_size 28")
    t.assert_eq_str(Blake2s.hash_hex(pattern(100), 32), "0f17bb99604e6ed71dd13cbe9ecaf337addb1ac5847e08c1c03ecf1329454f8c", "blake2s digest_size 32")
    t.section("salt / personalization")
    mut salt16 = seqbytes(16)
    mut per16 = Hex.decode("6465666768696a6b6c6d6e6f70717273")
    mut salt8 = seqbytes(8)
    mut per8 = Hex.decode("6465666768696a6b")
    t.assert_eq_str(Hex.encode(Blake2b.hash_params(pattern(77), 64, "", salt16, per16)), "58b5d626fb97470d5c4427a9707ae54abb9eca7c7782be6e47f41c54833eb324de713c2c3bfbd1f9d9316caeb5fc1550f1561a3191206f8facf68a4d05096f15", "blake2b salt+person")
    t.assert_eq_str(Hex.encode(Blake2b.hash_params(pattern(77), 32, kb, salt16, "")), "da8c418353fffcc568300925c031dd9a86cb7604a2c9ea68dde68cb37571332f", "blake2b key+salt")
    t.assert_eq_str(Hex.encode(Blake2s.hash_params(pattern(77), 32, "", salt8, per8)), "a237cb054d2b8a82739ed6a8de8e72a66360eee47138edf01db38c9db58df7cd", "blake2s salt+person")
    t.assert_eq_str(Hex.encode(Blake2s.hash_params(pattern(77), 16, ks, "", per8)), "577e5fd578e6878e8089772d3e6bf189", "blake2s key+person")
    t.section("invalid parameters")
    t.assert_eq_str(Blake2b.hash_hex("abc", 0), "", "blake2b outlen 0")
    t.assert_eq_str(Blake2b.hash_hex("abc", 65), "", "blake2b outlen 65")
    t.assert_eq_str(Blake2s.hash_hex("abc", 33), "", "blake2s outlen 33")
    t.assert_eq_str(Blake2b.keyed_hex("abc", pattern(65), 32), "", "blake2b key too long")
    t.assert_eq_str(Blake2s.keyed_hex("abc", pattern(33), 32), "", "blake2s key too long")
    t.assert_eq_str(Hex.encode(Blake2b.hash_params("abc", 32, "", "short", "")), "", "blake2b bad salt size")
    t.section("incremental API")
    mut big = pattern(1000)
    mut ib = Blake2bHasher.init(64, "")
    mut isx = Blake2sHasher.init(32, "")
    mut k = 0
    while k < 1000:
        mut pl = 37
        if k + pl > 1000: pl = 1000 - k
        mut piece = CryptoBytes.slice(big, k, pl)
        ib.update(piece)
        isx.update_bytes(piece, pl)
        k = k + pl
    t.assert_eq_str(ib.finalize_hex(), Blake2b.hash_hex(big, 64), "blake2b chunked == one-shot")
    t.assert_eq_str(isx.finalize_hex(), Blake2s.hash_hex(big, 32), "blake2s chunked == one-shot")
    t.assert_eq_str(ib.finalize_hex(), "", "second finalize returns empty")
    ib.free()
    isx.free()
    mut nz = CryptoBytes.wrap(CryptoBytes.zeroed(130), 130)

    t.assert_eq_str(Blake2b.hash_hex(nz, 64), "74252ee1ce7aeb3ffe0694de961432a173d44fd6a39eadf164b454d500688c442b6797d087fd2a73acbb398b701b109257ef8b84b851ed298de7852d7aefc761", "130 zero bytes (NULs hashed)")
    t.assert_eq_int(Blake2b.hash(nz, 64).len(), 64, "raw digest length")
    t.summary()
