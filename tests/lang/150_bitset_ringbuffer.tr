# tests/lang/150_bitset_ringbuffer.tr - std.collections.bitset and
# std.collections.ringbuffer.  Bitset is cross-checked against a plain
# Vec[bool] model under a deterministic pseudo-random workload; RingBuffer is
# checked in both overwrite and refuse modes, and with int / str / class payloads.

from std.test import TestRunner
from std.core.vec import Vec
from std.collections.bitset import Bitset
from std.collections.ringbuffer import RingBuffer

class Lcg:
    pub s: int

extend Lcg:
    pub def next(self, m: int) -> int:
        self.s = (self.s * 1103515245 + 12345) % 2147483648
        mut x = self.s / 16
        return x - (x / m) * m

class Item:
    pub n: int
    pub tag: str

def mk(n: int) -> Item:
    mut it = Item()
    it.n = n
    it.tag = "item-" + n.to_str()
    return it

def model_count(m: Vec[bool]) -> int:
    mut c = 0
    mut i = 0
    while i < m.len:
        if m.get(i): c = c + 1
        i = i + 1
    return c

def main():
    mut t = TestRunner.init("150_bitset_ringbuffer")

    # ── Bitset basics ───────────────────────────────────────────────────────
    t.section("bitset basics")
    mut b = Bitset.init(130)
    t.assert_eq_int(b.len(), 130, "len")
    t.assert_true(b.is_empty(), "starts empty")
    t.assert_eq_int(b.count(), 0, "count 0")
    b.set(0)
    b.set(63)
    b.set(64)
    b.set(129)
    b.set(130)
    b.set(-1)
    t.assert_eq_int(b.count(), 4, "out-of-range set is a no-op on a fixed bitset")
    t.assert_true(b.test(63), "bit 63 (sign bit of word 0)")
    t.assert_true(b.test(64), "bit 64 (first of word 1)")
    t.assert_false(b.test(62), "bit 62 clear")
    t.assert_false(b.test(130), "out-of-range test false")
    t.assert_false(b.test(-5), "negative test false")
    b.clear(63)
    t.assert_false(b.test(63), "clear 63")
    b.flip(63)
    t.assert_true(b.test(63), "flip 63 on")
    b.flip(63)
    t.assert_false(b.test(63), "flip 63 off")
    t.assert_eq_int(b.count(), 3, "count after edits")
    t.assert_eq_int(b.rank(64), 1, "rank(64)")
    t.assert_eq_int(b.rank(65), 2, "rank(65)")
    t.assert_eq_int(b.rank(1000), 3, "rank beyond len")
    t.assert_eq_int(b.select(0), 0, "select(0)")
    t.assert_eq_int(b.select(1), 64, "select(1)")
    t.assert_eq_int(b.select(2), 129, "select(2)")
    t.assert_eq_int(b.select(3), -1, "select past the end")
    t.assert_eq_int(b.next_set(1), 64, "next_set(1)")
    t.assert_eq_int(b.next_set(65), 129, "next_set(65)")
    t.assert_eq_int(b.next_set(130), -1, "next_set at len")
    t.assert_eq_int(b.next_clear(0), 1, "next_clear(0)")
    t.assert_eq_int(b.next_clear(64), 65, "next_clear(64)")
    mut v = b.to_vec()
    t.assert_eq_int(v.len, 3, "to_vec len")
    t.assert_eq_int(v.get(2), 129, "to_vec ascending")

    t.section("bitset set_all / invert / tail invariant")
    mut f = Bitset.init(70)
    f.set_all()
    t.assert_eq_int(f.count(), 70, "set_all counts exactly len bits (tail masked)")
    t.assert_true(f.all(), "all()")
    f.invert()
    t.assert_eq_int(f.count(), 0, "invert of full is empty")
    f.invert()
    t.assert_eq_int(f.count(), 70, "invert of empty is full")
    f.clear_all()
    t.assert_true(f.is_empty(), "clear_all")
    t.assert_eq_int(f.next_clear(0), 0, "next_clear on empty")
    f.set_all()
    t.assert_eq_int(f.next_clear(0), -1, "next_clear on full never reports tail padding")

    t.section("bitset growable / resize")
    mut g = Bitset.growable(0)
    g.set(500)
    t.assert_true(g.len() >= 501, "grows to fit")
    t.assert_true(g.test(500), "set bit after growth")
    t.assert_eq_int(g.count(), 1, "single member")
    g.set(5)
    t.assert_eq_int(g.select(0), 5, "select after growth")
    g.resize(100)
    t.assert_eq_int(g.len(), 100, "shrink resize")
    t.assert_eq_int(g.count(), 1, "shrink drops bit 500, keeps bit 5")
    g.resize(1000)
    t.assert_false(g.test(500), "regrown bits are clear")
    t.assert_eq_int(g.count(), 1, "count after regrow")

    t.section("bitset from_str / to_str / from_indices")
    mut s = Bitset.from_str("0110100011")
    t.assert_eq_int(s.len(), 10, "from_str len")
    t.assert_eq_int(s.count(), 5, "from_str count")
    t.assert_eq_str(s.to_str(), "0110100011", "round trip")
    mut idx = Vec[int].init(4)
    idx.push(3)
    idx.push(70)
    idx.push(3)
    mut fi = Bitset.from_indices(idx)
    t.assert_eq_int(fi.count(), 2, "from_indices dedups")
    t.assert_true(fi.test(70), "from_indices member")

    t.section("bitset set algebra")
    mut x = Bitset.from_str("11001100")
    mut y = Bitset.from_str("10101010")
    t.assert_eq_str(x.union(y).to_str(), "11101110", "union")
    t.assert_eq_str(x.intersection(y).to_str(), "10001000", "intersection")
    t.assert_eq_str(x.difference(y).to_str(), "01000100", "difference")
    t.assert_eq_str(x.sym_diff(y).to_str(), "01100110", "sym_diff")
    t.assert_eq_str(x.complement().to_str(), "00110011", "complement")
    t.assert_true(x.intersects(y), "intersects")
    t.assert_false(x.is_subset_of(y), "not subset")
    t.assert_true(x.intersection(y).is_subset_of(x), "intersection subset of operand")
    mut z = x.clone()
    z.union_with(y)
    t.assert_eq_str(z.to_str(), "11101110", "union_with")
    t.assert_eq_str(x.to_str(), "11001100", "clone is independent")
    t.assert_true(x == x.clone(), "== on equal sets")
    t.assert_true(x != y, "!= on different sets")
    mut small = Bitset.from_str("11")
    mut wide = Bitset.growable(200)
    wide.set(1)
    wide.set(150)
    t.assert_eq_int(small.union(wide).len(), 200, "union length is the longer operand")
    t.assert_true(small.union(wide).test(150), "union keeps bits beyond the shorter operand")
    mut fixed_small = Bitset.init(8)
    fixed_small.union_with(wide)
    t.assert_eq_int(fixed_small.count(), 1, "fixed receiver drops bits beyond its size")
    t.assert_true(Bitset.init(3).eq(Bitset.init(500)), "eq ignores padding length")

    t.section("bitset vs Vec[bool] model (random)")
    mut rng = Lcg()
    rng.s = 12345
    mut bs = Bitset.growable(10)
    mut model = Vec[bool].init(10)
    mut mi = 0
    while mi < 400:
        model.push(false)
        mi = mi + 1
    mut bad = 0
    mut step = 0
    while step < 3000:
        mut op = rng.next(4)
        mut i2 = rng.next(400)
        if op == 0:
            bs.set(i2)
            model.set(i2, true)
        elif op == 1:
            bs.clear(i2)
            model.set(i2, false)
        elif op == 2:
            bs.flip(i2)
            model.set(i2, not model.get(i2))
        else:
            if bs.test(i2) != model.get(i2): bad = bad + 1
        step = step + 1
    t.assert_eq_int(bad, 0, "random test() always agrees with the model")
    t.assert_eq_int(bs.count(), model_count(model), "final popcount agrees")
    mut agree = 0
    mut k = 0
    mut m2 = 0
    while k < 400:
        if model.get(k):
            if bs.select(m2) == k and bs.rank(k) == m2: agree = agree + 1
            m2 = m2 + 1
        k = k + 1
    t.assert_eq_int(agree, m2, "rank/select agree with the model for every member")
    mut walked = 0
    mut cur = bs.next_set(0)
    while cur >= 0:
        walked = walked + 1
        cur = bs.next_set(cur + 1)
    t.assert_eq_int(walked, m2, "next_set walk visits every member once")

    # ── RingBuffer ──────────────────────────────────────────────────────────
    t.section("ringbuffer overwrite mode")
    mut r = RingBuffer[int].init(3, true)
    t.assert_true(r.is_empty(), "starts empty")
    t.assert_eq_int(r.capacity(), 3, "capacity")
    t.assert_true(r.push(1), "push 1")
    t.assert_true(r.push(2), "push 2")
    t.assert_true(r.push(3), "push 3")
    t.assert_true(r.is_full(), "full")
    t.assert_true(r.push(4), "overwrite push succeeds")
    t.assert_eq_int(r.len(), 3, "len stays at capacity")
    t.assert_eq_int(r.dropped(), 1, "dropped counter")
    t.assert_eq_int(r.at(0), 2, "oldest is 2")
    t.assert_eq_int(r.front(), 2, "front")
    t.assert_eq_int(r.back(), 4, "back")
    r.push(5)
    t.assert_eq_int(r.dropped(), 2, "dropped 2")
    mut sn = r.to_vec()
    t.assert_eq_int(sn.get(0), 3, "snapshot[0]")
    t.assert_eq_int(sn.get(1), 4, "snapshot[1]")
    t.assert_eq_int(sn.get(2), 5, "snapshot[2]")
    t.assert_eq_int(r.pop_front(), 3, "pop_front")
    t.assert_eq_int(r.pop_back(), 5, "pop_back")
    t.assert_eq_int(r.len(), 1, "len after pops")
    r.push(6)
    r.push(7)
    t.assert_eq_int(r.at(0), 4, "wraps around correctly")
    t.assert_eq_int(r.at(2), 7, "newest after wrap")
    r.set_at(1, 60)
    t.assert_eq_int(r.at(1), 60, "set_at")
    r.set_at(9, 1)
    t.assert_eq_int(r.len(), 3, "set_at out of range is a no-op")
    r.clear()
    t.assert_true(r.is_empty(), "clear")
    t.assert_eq_int(r.pop_front_or(-1), -1, "pop_front_or on empty")
    t.assert_eq_int(r.pop_back_or(-2), -2, "pop_back_or on empty")
    match r.try_pop_front():
        case Option.Some(q):
            t.fail("try_pop_front on empty returned a value")
        case Option.None:
            t.assert_true(true, "try_pop_front on empty is None")
    r.push(9)
    match r.try_back():
        case Option.Some(q2):
            t.assert_eq_int(q2, 9, "try_back")
        case Option.None:
            t.fail("try_back returned None")

    t.section("ringbuffer refuse mode")
    mut q = RingBuffer[int].init(2, false)
    t.assert_true(q.push(10), "push 10")
    t.assert_true(q.push(20), "push 20")
    t.assert_false(q.push(30), "refused when full")
    t.assert_eq_int(q.len(), 2, "len unchanged by refused push")
    t.assert_eq_int(q.dropped(), 0, "nothing dropped")
    t.assert_eq_int(q.pop_front(), 10, "FIFO order")
    t.assert_true(q.push(40), "room after pop")
    t.assert_eq_int(q.at(0), 20, "order after wrap 0")
    t.assert_eq_int(q.at(1), 40, "order after wrap 1")

    t.section("ringbuffer vs FIFO model (random)")
    mut rr = RingBuffer[int].init(7, false)
    mut fifo = Vec[int].init(16)
    mut bad2 = 0
    mut n = 0
    while n < 2000:
        if rng.next(2) == 0:
            mut val = rng.next(1000)
            mut ok = rr.push(val)
            if fifo.len < 7:
                fifo.push(val)
                if not ok: bad2 = bad2 + 1
            elif ok:
                bad2 = bad2 + 1
        elif fifo.len > 0:
            mut want = fifo.get(0)
            fifo.remove(0)
            if rr.pop_front() != want: bad2 = bad2 + 1
        if rr.len() != fifo.len: bad2 = bad2 + 1
        n = n + 1
    t.assert_eq_int(bad2, 0, "refuse-mode ring matches a bounded FIFO model")

    t.section("ringbuffer with str and class payloads")
    mut rs = RingBuffer[str].init(2, true)
    rs.push("a" + "1")
    rs.push("b" + "2")
    rs.push("c" + "3")
    t.assert_eq_str(rs.at(0), "b2", "str oldest")
    t.assert_eq_str(rs.back(), "c3", "str newest")
    mut ro = RingBuffer[Item].init(3, true)
    mut i3 = 0
    while i3 < 50:
        ro.push(mk(i3))
        i3 = i3 + 1
    t.assert_eq_int(ro.at(0).n, 47, "class oldest survives 47 overwrites")
    t.assert_eq_str(ro.back().tag, "item-49", "class newest")
    t.assert_eq_int(ro.dropped(), 47, "class dropped count")
    mut popped = ro.pop_front()
    t.assert_eq_str(popped.tag, "item-47", "popped class value is intact")
    t.summary()
