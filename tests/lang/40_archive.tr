# tests/lang/40_archive.tr - std.io.archive: CRC32 known-answer vector,
# ZipWriter/ZipReader round-trip (mixed STORED/DEFLATE, incl. an empty
# file), entry lookup, and CRC32 corruption detection.

from std.test import TestRunner
from std.io.archive import ZipWriter, ZipReader, Crc32, METHOD_STORED, METHOD_DEFLATE

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_c_memcpy(dst: Pointer[char], src: Pointer[char], n: int)
    def _tr_str_wrap(s: Pointer[char]) -> str

# Return a copy of `data` (length `len_`) with the byte at `at` flipped —
# used to simulate a corrupted archive.
def flip_byte(data: str, len_: int, at: int) -> str:
    mut buf = _tr_c_malloc(len_ + 1)
    unsafe:
        _tr_c_memcpy(buf, data as Pointer[char], len_)
        mut orig = buf.offset(at).read() as int
        buf.offset(at).write(((orig + 1) & 0xFF) as char)
        buf.offset(len_).write('\0')
    return _tr_str_wrap(buf)

# Read a little-endian u32 out of a raw archive byte string (mirrors the
# reader's own internal helper, duplicated here so the test can locate the
# central directory offset from the EOCD record without any extra API
# surface on ZipReader).
def rd_u32(data: str, off: int) -> int:
    mut p = data as Pointer[char]
    unsafe:
        mut b0 = p.offset(off).read() as int & 0xFF
        mut b1 = p.offset(off + 1).read() as int & 0xFF
        mut b2 = p.offset(off + 2).read() as int & 0xFF
        mut b3 = p.offset(off + 3).read() as int & 0xFF
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

def main():
    mut t = TestRunner.init("40_archive")

    # ── CRC32 known-answer test ─────────────────────────────────────────────
    t.section("CRC32 known-answer vector")
    mut crc_check = Crc32.compute("123456789", 9)
    t.assert_eq_int(crc_check, 0xCBF43926, "CRC32(\"123456789\") == 0xCBF43926 (standard check value)")
    t.assert_eq_int(Crc32.compute("", 0), 0, "CRC32 of empty input is 0")
    t.assert_ne_int(Crc32.compute("a", 1), Crc32.compute("b", 1), "different single bytes give different CRC32")
    t.assert_eq_int(Crc32.compute("abc", 3), Crc32.compute("abc", 3), "CRC32 is deterministic (same input -> same output)")

    # ── Build a multi-entry archive ─────────────────────────────────────────
    t.section("ZipWriter: build a multi-entry archive")
    mut w = ZipWriter.init()

    mut hello = "hello world"
    w.add_file("hello.txt", hello, 11)                       # small -> likely STORED (no gain)

    mut stored_data = "raw bytes, forced STORED"
    w.add_file_stored("raw.bin", stored_data, 24)             # explicit STORED

    mut empty_data = ""
    w.add_file("empty.txt", empty_data, 0)                    # empty file

    mut rep = "abcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabc"
    mut rep_len = 99
    w.add_file("repeat.txt", rep, rep_len)                    # compressible -> DEFLATE if enabled

    mut nested = "nested/dir/file.txt"
    mut nested_data = "content in a nested path"
    w.add_file(nested, nested_data, 24)

    mut zip_bytes = w.finish()
    mut zip_len = w.total_len()
    t.assert_true(zip_len > 0, "finish() produced a non-empty archive")

    # ── Read it back ─────────────────────────────────────────────────────────
    t.section("ZipReader: parse the central directory")
    mut r = ZipReader.open(zip_bytes, zip_len)
    t.assert_true(r.ok, "ZipReader.open successfully parsed the central directory")
    t.assert_eq_int(r.entry_count(), 5, "entry_count matches number of files added")

    t.section("ZipReader: entry names and order")
    t.assert_eq_str(r.entry_name(0), "hello.txt", "entry 0 name")
    t.assert_eq_str(r.entry_name(1), "raw.bin", "entry 1 name")
    t.assert_eq_str(r.entry_name(2), "empty.txt", "entry 2 name")
    t.assert_eq_str(r.entry_name(3), "repeat.txt", "entry 3 name")
    t.assert_eq_str(r.entry_name(4), "nested/dir/file.txt", "entry 4 name (nested path)")
    t.assert_eq_str(r.entry_name(99), "", "out-of-range entry_name returns empty string")

    t.section("ZipReader: find_entry hit and miss")
    t.assert_eq_int(r.find_entry("hello.txt"), 0, "find_entry hits index 0")
    t.assert_eq_int(r.find_entry("repeat.txt"), 3, "find_entry hits index 3")
    t.assert_eq_int(r.find_entry("nested/dir/file.txt"), 4, "find_entry hits nested path")
    t.assert_eq_int(r.find_entry("does_not_exist.txt"), -1, "find_entry miss returns -1")
    t.assert_eq_int(r.find_entry(""), -1, "find_entry miss on empty name returns -1")

    t.section("ZipReader: content round-trip matches exactly, per entry")
    mut i_hello = r.find_entry("hello.txt")
    t.assert_eq_str(r.read_entry(i_hello), hello, "hello.txt content matches exactly")
    t.assert_eq_int(r.entry_size(i_hello), 11, "hello.txt reported uncompressed size")

    mut i_raw = r.find_entry("raw.bin")
    t.assert_eq_str(r.read_entry(i_raw), stored_data, "raw.bin (STORED) content matches exactly")
    t.assert_eq_int(r.entry_size(i_raw), 24, "raw.bin reported uncompressed size")

    mut i_empty = r.find_entry("empty.txt")
    t.assert_eq_str(r.read_entry(i_empty), "", "empty.txt round-trips to an empty string")
    t.assert_eq_int(r.entry_size(i_empty), 0, "empty.txt reported size is 0")

    mut i_rep = r.find_entry("repeat.txt")
    t.assert_eq_str(r.read_entry(i_rep), rep, "repeat.txt (compressible) content matches exactly")
    t.assert_eq_int(r.entry_size(i_rep), rep_len, "repeat.txt reported uncompressed size")

    mut i_nested = r.find_entry("nested/dir/file.txt")
    t.assert_eq_str(r.read_entry(i_nested), nested_data, "nested/dir/file.txt content matches exactly")

    # ── STORED vs DEFLATE mix ────────────────────────────────────────────────
    t.section("compression method bookkeeping")
    mut raw_entry = r.entries.get(i_raw)
    t.assert_eq_int(raw_entry.method, METHOD_STORED(), "raw.bin was written as STORED (add_file_stored)")
    mut rep_entry = r.entries.get(i_rep)
    t.assert_true(rep_entry.method == METHOD_STORED() or rep_entry.method == METHOD_DEFLATE(), "repeat.txt method is a recognized ZIP method (STORED or DEFLATE)")
    # Whichever method was actually used, the CRC32 stored in the header must
    # match the uncompressed content (checked implicitly by read_entry above,
    # verified explicitly here too).
    t.assert_eq_int(rep_entry.crc32, Crc32.compute(rep, rep_len), "repeat.txt stored CRC32 equals CRC32 of the original uncompressed data")
    t.assert_eq_int(raw_entry.crc32, Crc32.compute(stored_data, 24), "raw.bin stored CRC32 equals CRC32 of the original uncompressed data")

    # ── Corruption detection ─────────────────────────────────────────────────
    t.section("CRC32 mismatch detection on a corrupted entry")

    # Corrupt one byte inside hello.txt's compressed/stored payload. Local
    # header is 30 bytes + 9-byte name "hello.txt" = 39 bytes, so byte 39 is
    # the first payload byte (entry 0 sits at archive offset 0).
    mut corrupted_payload = flip_byte(zip_bytes, zip_len, 39)
    mut r_bad = ZipReader.open(corrupted_payload, zip_len)
    t.assert_true(r_bad.ok, "central directory still parses after payload corruption (CD is untouched)")
    mut bad_idx = r_bad.find_entry("hello.txt")
    t.assert_eq_int(bad_idx, 0, "corrupted archive still finds the entry by name")
    mut bad_content = r_bad.read_entry(bad_idx)
    t.assert_eq_str(bad_content, "", "read_entry returns empty string (not wrong data) when CRC32 verification fails")

    # Corrupting a byte in a DIFFERENT entry's payload must not affect
    # other entries' reads.
    mut other_ok = r_bad.find_entry("raw.bin")
    t.assert_eq_str(r_bad.read_entry(other_ok), stored_data, "unaffected entries still read correctly when a different entry is corrupted")

    # Now corrupt the stored CRC32 field itself in the CENTRAL DIRECTORY
    # record for hello.txt (readers trust the central directory's CRC32,
    # not the local header's copy of it — that's the field read_entry()
    # actually compares against). Locate the CD via the EOCD record's
    # "offset of central directory" field (EOCD is the last 22 bytes; that
    # field sits 6 bytes before the very end). hello.txt is the first
    # record written into the CD, and its CRC32 field is 16 bytes into the
    # 46-byte fixed central-directory-record header.
    mut eocd_off = zip_len - 22
    mut cd_offset = rd_u32(zip_bytes, eocd_off + 16)
    mut cd_crc_field_off = cd_offset + 16
    mut corrupted_crc = flip_byte(zip_bytes, zip_len, cd_crc_field_off)
    mut r_bad2 = ZipReader.open(corrupted_crc, zip_len)
    t.assert_true(r_bad2.ok, "central directory still parses after CRC-field corruption")
    mut bad2_idx = r_bad2.find_entry("hello.txt")
    mut bad2_content = r_bad2.read_entry(bad2_idx)
    t.assert_eq_str(bad2_content, "", "read_entry detects a corrupted stored CRC32 field too (mismatch vs recomputed CRC32)")

    # ── STORED-only archive sanity (no compression at all) ──────────────────
    t.section("all-STORED archive round-trip (correctness baseline)")
    mut w2 = ZipWriter.init()
    w2.add_file_stored("a.txt", "AAA", 3)
    w2.add_file_stored("b.txt", "BBBBBB", 6)
    mut zip2 = w2.finish()
    mut r2 = ZipReader.open(zip2, w2.total_len())
    t.assert_eq_int(r2.entry_count(), 2, "all-STORED archive has 2 entries")
    t.assert_eq_str(r2.read_entry(r2.find_entry("a.txt")), "AAA", "all-STORED entry a.txt content matches")
    t.assert_eq_str(r2.read_entry(r2.find_entry("b.txt")), "BBBBBB", "all-STORED entry b.txt content matches")

    # ── Single-empty-archive edge case ───────────────────────────────────────
    t.section("archive containing only an empty file")
    mut w3 = ZipWriter.init()
    w3.add_file("only_empty.txt", "", 0)
    mut zip3 = w3.finish()
    mut r3 = ZipReader.open(zip3, w3.total_len())
    t.assert_true(r3.ok, "archive with a single empty file parses correctly")
    t.assert_eq_int(r3.entry_count(), 1, "single-entry archive reports 1 entry")
    t.assert_eq_str(r3.read_entry(0), "", "the single empty entry reads back as empty string")

    t.summary()
