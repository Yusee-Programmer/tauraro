# tests/lang/151_skiplist.tr - std.collections.skiplist: SkipList[K, V].
# Cross-checked against a sorted Vec[int] model under a deterministic random
# insert/remove/query workload, plus str keys, class values, range queries,
# cursors, node reuse and seed determinism.

from std.test import TestRunner
from std.core.vec import Vec
from std.collections.skiplist import SkipList

class Lcg:
    pub s: int

extend Lcg:
    pub def next(self, m: int) -> int:
        self.s = (self.s * 1103515245 + 12345) % 2147483648
        mut x = self.s / 16
        return x - (x / m) * m

class Rec:
    pub id: int
    pub name: str

def mk(id: int) -> Rec:
    mut r = Rec()
    r.id = id
    r.name = "rec-" + id.to_str()
    return r

# index of key in the sorted model, or -1
def mfind(m: Vec[int], k: int) -> int:
    mut i = 0
    while i < m.len:
        if m.get(i) == k: return i
        i = i + 1
    return -1

def main():
    mut t = TestRunner.init("151_skiplist")

    t.section("basic insert / fetch / has / remove")
    mut s = SkipList[int, str].init(7)
    t.assert_true(s.is_empty(), "starts empty")
    t.assert_true(s.insert(5, "five"), "insert new returns true")
    t.assert_true(s.insert(3, "three"), "insert 3")
    t.assert_true(s.insert(8, "eight"), "insert 8")
    t.assert_false(s.insert(5, "FIVE"), "insert existing returns false (update)")
    t.assert_eq_int(s.len(), 3, "len")
    t.assert_eq_str(s.fetch_or(5, "?"), "FIVE", "update replaced the value")
    t.assert_eq_str(s.fetch_or(4, "?"), "?", "fetch_or default for a missing key")
    t.assert_true(s.has(3), "has(3)")
    t.assert_false(s.has(4), "has(4)")
    match s.fetch(8):
        case Option.Some(v):
            t.assert_eq_str(v, "eight", "fetch(8)")
        case Option.None:
            t.fail("fetch(8) returned None")
    match s.fetch(9):
        case Option.Some(v2):
            t.fail("fetch(9) should be None")
        case Option.None:
            t.assert_true(true, "fetch missing is None")
    t.assert_true(s.remove(5), "remove existing")
    t.assert_false(s.remove(5), "remove missing returns false")
    t.assert_eq_int(s.len(), 2, "len after remove")
    mut ks = s.keys_vec()
    t.assert_eq_int(ks.get(0), 3, "keys ascending [0]")
    t.assert_eq_int(ks.get(1), 8, "keys ascending [1]")

    t.section("ordered queries")
    mut o = SkipList[int, int].init(11)
    mut i = 0
    while i < 50:
        o.insert((i * 13) % 50, i)
        i = i + 1
    t.assert_eq_int(o.len(), 50, "50 distinct keys")
    mut all = o.keys_vec()
    mut sorted_ok = 0
    mut a = 0
    while a < 50:
        if all.get(a) == a: sorted_ok = sorted_ok + 1
        a = a + 1
    t.assert_eq_int(sorted_ok, 50, "keys_vec is 0..49 in order")
    match o.first_key():
        case Option.Some(fk):
            t.assert_eq_int(fk, 0, "first_key")
        case Option.None:
            t.fail("first_key None")
    match o.last_key():
        case Option.Some(lk):
            t.assert_eq_int(lk, 49, "last_key")
        case Option.None:
            t.fail("last_key None")
    o.remove(20)
    match o.floor_key(20):
        case Option.Some(fl):
            t.assert_eq_int(fl, 19, "floor of a removed key")
        case Option.None:
            t.fail("floor None")
    match o.ceil_key(20):
        case Option.Some(ce):
            t.assert_eq_int(ce, 21, "ceil of a removed key")
        case Option.None:
            t.fail("ceil None")
    match o.floor_key(-1):
        case Option.Some(f3):
            t.fail("floor below min should be None")
        case Option.None:
            t.assert_true(true, "floor below min is None")
    match o.ceil_key(50):
        case Option.Some(c3):
            t.fail("ceil above max should be None")
        case Option.None:
            t.assert_true(true, "ceil above max is None")
    mut rk = o.range_keys(10, 15)
    t.assert_eq_int(rk.len, 5, "range [10,15) size")
    t.assert_eq_int(rk.get(0), 10, "range first")
    t.assert_eq_int(rk.get(4), 14, "range last (hi exclusive)")
    t.assert_eq_int(o.range_count(18, 24), 5, "range_count skips the removed key 20")
    t.assert_eq_int(o.range_count(30, 30), 0, "empty range")
    t.assert_eq_int(o.range_count(-100, 1000), 49, "whole-range count")
    mut rv = o.range_values(0, 3)
    t.assert_eq_int(rv.len, 3, "range_values size")
    t.assert_eq_int(rv.get(1), 27, "value for key 1 is i with i*13%50==1, i.e. 27")
    t.assert_eq_int(o.remove_range(40, 50), 10, "remove_range count")
    t.assert_eq_int(o.len(), 39, "len after remove_range")
    t.assert_false(o.has(45), "removed by range")

    t.section("cursors")
    mut c = o.cursor_first()
    mut n = 0
    mut prev = -1
    mut inorder = true
    while c >= 0:
        mut k = o.key_at(c)
        if k <= prev: inorder = false
        prev = k
        n = n + 1
        c = o.cursor_next(c)
    t.assert_eq_int(n, 39, "cursor walk visits every entry")
    t.assert_true(inorder, "cursor walk is strictly ascending")
    mut sc = o.cursor_seek(21)
    t.assert_eq_int(o.key_at(sc), 21, "cursor_seek exact")
    o.set_value_at(sc, 777)
    t.assert_eq_int(o.fetch_or(21, -1), 777, "set_value_at")
    t.assert_eq_int(o.cursor_seek(1000), -1, "cursor_seek past the end")
    t.assert_eq_int(o.key_at(o.cursor_last()), 39, "cursor_last")
    t.assert_eq_int(o.key_at(o.cursor_floor(20)), 19, "cursor_floor")

    t.section("random workload vs sorted model")
    mut rng = Lcg()
    rng.s = 2024
    mut sl = SkipList[int, int].init(99)
    mut model = Vec[int].init(16)
    mut bad = 0
    mut step = 0
    while step < 4000:
        mut op = rng.next(3)
        mut key = rng.next(300)
        if op == 0:
            mut isnew = sl.insert(key, key * 2)
            if isnew != (mfind(model, key) < 0): bad = bad + 1
            if isnew: model.push(key)
        elif op == 1:
            mut had = mfind(model, key) >= 0
            if sl.remove(key) != had: bad = bad + 1
            if had: model.remove(mfind(model, key))
        else:
            if sl.has(key) != (mfind(model, key) >= 0): bad = bad + 1
            if sl.fetch_or(key, -1) != (key * 2 if mfind(model, key) >= 0 else -1): bad = bad + 1
        if sl.len() != model.len: bad = bad + 1
        step = step + 1
    t.assert_eq_int(bad, 0, "inserts/removes/queries agree with the model")
    model.sort()
    mut final = sl.keys_vec()
    t.assert_eq_int(final.len, model.len, "final size")
    mut same = 0
    mut z = 0
    while z < model.len:
        if final.get(z) == model.get(z): same = same + 1
        z = z + 1
    t.assert_eq_int(same, model.len, "final key order equals the sorted model")
    mut fl_bad = 0
    mut q = 0
    while q < 300:
        mut expect_floor = -1
        mut expect_ceil = -1
        mut m = 0
        while m < model.len:
            if model.get(m) <= q: expect_floor = model.get(m)
            if model.get(m) >= q and expect_ceil < 0: expect_ceil = model.get(m)
            m = m + 1
        mut gf = -1
        match sl.floor_key(q):
            case Option.Some(fv):
                gf = fv
            case Option.None:
                gf = -1
        mut gc = -1
        match sl.ceil_key(q):
            case Option.Some(cv):
                gc = cv
            case Option.None:
                gc = -1
        if gf != expect_floor or gc != expect_ceil: fl_bad = fl_bad + 1
        q = q + 1
    t.assert_eq_int(fl_bad, 0, "floor/ceil agree with the model at all 300 probes")

    t.section("node reuse and clear")
    mut r = SkipList[int, int].init(5)
    mut j = 0
    while j < 100:
        r.insert(j, j)
        j = j + 1
    j = 0
    while j < 100:
        r.remove(j)
        j = j + 1
    t.assert_true(r.is_empty(), "emptied")
    mut slots_before = r.keys.len
    j = 0
    while j < 100:
        r.insert(1000 - j, j)
        j = j + 1
    t.assert_eq_int(r.keys.len, slots_before, "freed nodes are reused (no growth)")
    t.assert_eq_int(r.len(), 100, "refilled")
    r.clear()
    t.assert_true(r.is_empty(), "clear empties")
    t.assert_false(r.has(1000), "clear removed keys")
    r.insert(1, 1)
    t.assert_eq_int(r.len(), 1, "usable after clear")

    t.section("str keys, class values")
    mut d = SkipList[str, Rec].init(3)
    d.insert("pear", mk(1))
    d.insert("apple", mk(2))
    d.insert("fig", mk(3))
    d.insert("cherry", mk(4))
    mut dk = d.keys_vec()
    t.assert_eq_str(dk.get(0), "apple", "str order 0")
    t.assert_eq_str(dk.get(1), "cherry", "str order 1")
    t.assert_eq_str(dk.get(2), "fig", "str order 2")
    t.assert_eq_str(dk.get(3), "pear", "str order 3")
    mut dc = d.cursor_seek("d")
    t.assert_eq_str(d.key_at(dc), "fig", "cursor_seek on str")
    t.assert_eq_str(d.value_at(dc).name, "rec-3", "class value via cursor")
    d.insert("fig", mk(30))
    t.assert_eq_str(d.value_at(d.find("fig")).name, "rec-30", "class value replaced")
    mut ri = 0
    while ri < 200:
        d.insert("k" + (ri % 20).to_str(), mk(ri))
        ri = ri + 1
    t.assert_eq_int(d.len(), 24, "class values churn: 4 + 20 distinct keys")
    t.assert_eq_str(d.value_at(d.find("k7")).name, "rec-187", "last write wins")

    t.section("determinism")
    mut a1 = SkipList[int, int].init(4242)
    mut a2 = SkipList[int, int].init(4242)
    mut a3 = SkipList[int, int].init(1)
    mut w = 0
    while w < 200:
        a1.insert((w * 31) % 211, w)
        a2.insert((w * 31) % 211, w)
        a3.insert((w * 31) % 211, w)
        w = w + 1
    t.assert_eq_int(a1.level, a2.level, "same seed => same height")
    mut shape_same = true
    mut sdiff = false
    mut x = 0
    while x < a1.fwd.len:
        if a1.fwd.get(x) != a2.fwd.get(x): shape_same = false
        x = x + 1
    t.assert_true(shape_same, "same seed + ops => identical link structure")
    x = 0
    while x < a1.fwd.len and x < a3.fwd.len:
        if a1.fwd.get(x) != a3.fwd.get(x): sdiff = true
        x = x + 1
    t.assert_true(sdiff, "different seed => different structure")
    t.assert_eq_int(a3.len(), a1.len(), "different shapes hold the same data")
    mut zero = SkipList[int, int].init(0)
    zero.insert(2, 2)
    zero.insert(1, 1)
    t.assert_eq_int(zero.key_at(zero.cursor_first()), 1, "zero seed is replaced, still works")
    t.summary()
