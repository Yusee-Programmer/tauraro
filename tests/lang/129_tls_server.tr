# tests/lang/129_tls_server.tr
# std.net.tls server side (TlsServerConfig / TlsListener / accept_fd) against
# std.net.tls clients on 127.0.0.1, and HTTPS from std.net.http_server
# (enable_tls) to HttpSession. The certificates below are self-signed for
# localhost / 127.0.0.1, valid until 2126 (RSA-2048 and ECDSA P-256).
# Interoperability with OpenSSL (Python ssl, openssl s_client: all three
# cipher suites, HelloRetryRequest, P-384, TLS 1.2 refusal) was checked when
# the server was written.

from std.test import TestRunner
from std.net.tls import TlsStream, TlsOptions, TlsListener, TlsServerConfig
from std.net.http_server import HttpServer, HttpConn
from std.net.client import HttpSession, HttpReply

