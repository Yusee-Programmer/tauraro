# tests/lang/144_acme.tr
# std.net.acme / std.crypto.csr / std.crypto.der.
#
# 1. Known vectors: RFC 7515 A.2 (RS256, exact signature) and A.3 (ES256),
#    RFC 7638 thumbprint, DER encodings; CSRs and certificates were also
#    checked with `openssl req -verify` / `openssl verify` during development.
# 2. TlsServerConfig.add_route (ALPN / SNI certificate selection).
# 3. End to end against a fake ACME server (std.net.http_server, plain HTTP, in
#    a thread) that checks every JWS signature, nonce and URL, External Account
#    Binding, key rollover and CSRs, validates http-01 / dns-01 / tls-alpn-01
#    for real against the client's responders, and issues certificates from a
#    test CA (with an alternate chain). The client was also run against
#    Pebble (Let's Encrypt's test CA) during development.

from std.test import TestRunner
from std.net.acme import AcmeClient, AcmeJws, AcmeCertificate, AcmeOrder, acme_links, acme_json_str, acme_needs_renewal, CHALLENGE_HTTP01, CHALLENGE_DNS01, CHALLENGE_TLS_ALPN01, ACME_TLS_ALPN, OID_ACME_IDENTIFIER, REVOKE_SUPERSEDED, LETSENCRYPT_PRODUCTION, LETSENCRYPT_STAGING
from std.crypto.csr import KeyPair, Csr, CertBuilder, ip_to_bytes, ip_to_text, cert_extension, cert_names, name_der, CertExtension
from std.crypto.der import Der, DerNode, der_byte
from std.crypto.pk import PKey, Pem, CURVE_P256, CURVE_P384, KEY_RSA, KEY_EC_P256
from std.crypto.x509 import Certificate, TrustStore, X509, PURPOSE_SERVER
from std.crypto.native import _cn_hex, ALG_SHA256
from std.crypto.digest import Digest
from std.crypto.hmac import Hmac
from std.encoding.json import Json, JsonDoc, JsonRef
from std.net.client import HttpSession, HttpReply
from std.net.http_server import HttpServer, HttpConn, HttpResponse
from std.net.tcp import TcpStream
from std.net.tls import TlsStream, TlsOptions, TlsListener, TlsServerConfig
from std.io.file import read_file, write_file
from std.sys.fs import Fs
from std.sys.time import Clock

const ACME_PORT = 18990
const HTTP01_PORT = 18991
const TLS01_PORT = 18992
const ROUTE_PORT = 18993
const DNS_FILE = "build/acme144_dns.txt"
const EAB_KID = "kid-1"
const EAB_SECRET = "an eab secret key, 32 bytes long"

