# tests/lang/87_hex_binary.tr - Hex.encode / encode_upper / encode_bytes on binary
# data (bug log #6): they used strlen (truncating at the first 0x00) and did not
# mask bytes >= 0x80 (signed `char` -> negative nibble -> garbage output).

from std.test import TestRunner
from std.encoding.hex import Hex

def main():
    mut t = TestRunner.init("87_hex_binary")

    t.section("high-bit bytes")
    mut hi = Hex.decode("80ff7f00")
    t.assert_eq_str(Hex.encode_bytes(hi as Pointer[char], 4), "80ff7f00", "encode_bytes keeps 0x80/0xff and the trailing NUL byte")
    mut hi2 = Hex.decode("ff80")
    t.assert_eq_str(Hex.encode(hi2), "ff80", "encode of 0xff 0x80")
    t.assert_eq_str(Hex.encode_upper(hi2), "FF80", "encode_upper of 0xff 0x80")

    t.section("text still works")
    t.assert_eq_str(Hex.encode("Hello"), "48656c6c6f", "ASCII")
    t.assert_eq_str(Hex.encode_upper("Hi"), "4869", "ASCII upper")
    t.assert_eq_str(Hex.encode(""), "", "empty")

    t.section("round trip over every byte value (without NUL; decode result is C-string based)")
    mut all = Hex.decode("")
    t.assert_eq_str(Hex.encode(all), "", "all non-NUL byte values survive encode(decode(x))")

    t.summary()
