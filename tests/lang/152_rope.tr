# tests/lang/152_rope.tr - std.collections.rope: Rope text buffer.
# Cross-checked against plain `str` slicing/concatenation under a deterministic
# random edit workload, plus boundary clamping, chunk splitting, compaction,
# find/char_at/replace and large documents.

from std.test import TestRunner
from std.collections.rope import Rope
from std.string.str import Str

class Lcg:
    pub s: int

extend Lcg:
    pub def next(self, m: int) -> int:
        self.s = (self.s * 1103515245 + 12345) % 2147483648
        mut x = self.s / 16
        return x - (x / m) * m

def word(rng: Lcg) -> str:
    mut n = 1 + rng.next(12)
    mut out = ""
    mut i = 0
    while i < n:
        out = out + Str.substr("abcdefghijklmnopqrstuvwxyz ", rng.next(27), 1)
        i = i + 1
    return out

def model_insert(m: str, pos: int, text: str) -> str:
    return Str.substr(m, 0, pos) + text + Str.substr(m, pos, m.len() - pos)

def model_delete(m: str, pos: int, n: int) -> str:
    return Str.substr(m, 0, pos) + Str.substr(m, pos + n, m.len() - pos - n)

def main():
    mut t = TestRunner.init("152_rope")

    t.section("basics")
    mut r = Rope.init()
    t.assert_true(r.is_empty(), "starts empty")
    t.assert_eq_int(r.len(), 0, "len 0")
    t.assert_eq_str(r.to_str(), "", "empty text")
    r.append("Hello world")
    t.assert_eq_str(r.to_str(), "Hello world", "append")
    r.insert(5, ",")
    t.assert_eq_str(r.to_str(), "Hello, world", "insert in the middle")
    r.append("!")
    r.prepend(">> ")
    t.assert_eq_str(r.to_str(), ">> Hello, world!", "prepend + append")
    t.assert_eq_int(r.len(), 16, "len")
    t.assert_eq_str(r.slice(3, 8), "Hello", "slice")
    t.assert_eq_str(r.slice(-5, 2), ">>", "slice clamps a negative start")
    t.assert_eq_str(r.slice(10, 1000), "world!", "slice clamps the end")
    t.assert_eq_str(r.slice(7, 7), "", "empty slice")
    t.assert_eq_str(r.slice(9, 3), "", "inverted slice is empty")
    t.assert_eq_int(r.delete(0, 3), 3, "delete returns the count removed")
    t.assert_eq_str(r.to_str(), "Hello, world!", "after delete")
    t.assert_eq_int(r.delete(7, 100), 6, "delete clamps to the end")
    t.assert_eq_str(r.to_str(), "Hello, ", "after clamped delete")
    t.assert_eq_int(r.delete(50, 3), 0, "delete past the end removes nothing")
    t.assert_eq_int(r.delete(0, 0), 0, "zero-length delete")
    r.insert(100, "END")
    t.assert_eq_str(r.to_str(), "Hello, END", "insert past the end appends")
    r.insert(-4, "^")
    t.assert_eq_str(r.to_str(), "^Hello, END", "insert at a negative position prepends")
    r.replace(1, 5, "Howdy")
    t.assert_eq_str(r.to_str(), "^Howdy, END", "replace")
    r.replace(6, 7, "")
    t.assert_eq_str(r.to_str(), "^Howdy", "replace with empty = delete")
    r.insert(2, "")
    t.assert_eq_str(r.to_str(), "^Howdy", "empty insert is a no-op")
    t.assert_eq_int(r.char_at(0), 94, "char_at(0) = '^'")
    t.assert_eq_int(r.char_at(5), 121, "char_at(5) = 'y'")
    t.assert_eq_int(r.char_at(6), -1, "char_at out of range")
    t.assert_eq_int(r.char_at(-1), -1, "char_at negative")
    t.assert_eq_int(r.find("wd", 0), 3, "find")
    t.assert_eq_int(r.find("wd", 4), -1, "find from offset misses")
    t.assert_eq_int(r.find("y", 2), 5, "find offset result is absolute")
    t.assert_eq_int(r.find("zz", 0), -1, "find absent")
    r.clear()
    t.assert_true(r.is_empty(), "clear")
    r.append("again")
    t.assert_eq_str(r.to_str(), "again", "usable after clear")

    t.section("chunk splitting across many chunks")
    mut big = Rope.init()
    mut text = ""
    mut k = 0
    while k < 100:
        text = text + "0123456789"
        k = k + 1
    big.append(text)
    t.assert_eq_int(big.len(), 1000, "1000 bytes")
    t.assert_true(big.chunk_count() >= 4, "large insert is stored as several chunks")
    t.assert_eq_str(big.to_str(), text, "round trip across chunks")
    t.assert_eq_str(big.slice(250, 270), "01234567890123456789", "slice spanning a chunk boundary")
    t.assert_eq_str(big.slice(253, 258), "34567", "slice inside a chunk")
    big.insert(256, "|")
    t.assert_eq_str(big.slice(254, 259), "45|67", "insert exactly on a chunk boundary")
    big.delete(250, 12)
    t.assert_eq_int(big.len(), 989, "delete spanning chunks")
    t.assert_eq_str(big.slice(248, 254), "891234", "contents after a cross-chunk delete")

    t.section("random edits vs str model")
    mut rng = Lcg()
    rng.s = 777
    mut rp = Rope.with_seed(5)
    mut model = ""
    mut bad = 0
    mut step = 0
    while step < 500:
        mut op = rng.next(10)
        mut len = model.len()
        if op < 5 or len < 30:
            mut w = word(rng)
            mut pos = rng.next(len + 1)
            if op == 9: pos = len
            if op == 8: pos = 0
            rp.insert(pos, w)
            model = model_insert(model, pos, w)
        else:
            mut pos2 = rng.next(len)
            mut cnt = 1 + rng.next(40)
            if pos2 + cnt > len: cnt = len - pos2
            rp.delete(pos2, cnt)
            model = model_delete(model, pos2, cnt)
        if rp.len() != model.len(): bad = bad + 1
        if step - (step / 25) * 25 == 0:
            if rp.to_str() != model: bad = bad + 1
            mut a = rng.next(model.len() + 1)
            mut b = rng.next(model.len() + 1)
            if a > b:
                mut tmp = a
                a = b
                b = tmp
            if rp.slice(a, b) != Str.substr(model, a, b - a): bad = bad + 1
            if model.len() > 0:
                mut ci = rng.next(model.len())
                if rp.char_at(ci) != Str.char_at(model, ci): bad = bad + 1
        step = step + 1
    t.assert_eq_int(bad, 0, "rope matches the str model after 500 random edits")
    t.assert_eq_str(rp.to_str(), model, "final text identical")

    t.section("fragmentation and compaction")
    mut fr = Rope.with_seed(9)
    mut j = 0
    while j < 600:
        fr.insert(j / 2, "x")
        j = j + 1
    t.assert_eq_int(fr.len(), 600, "600 single-byte inserts")
    t.assert_true(fr.chunk_count() < 600 / 4, "auto-compaction / in-chunk inserts keep the chunk count small")
    mut before = fr.to_str()
    fr.compact()
    t.assert_eq_str(fr.to_str(), before, "compact preserves the text")
    t.assert_eq_int(fr.chunk_count(), 3, "compact packs 600 bytes into 256-byte chunks")
    mut d = 0
    while d < 300:
        fr.delete(0, 1)
        d = d + 1
    t.assert_eq_int(fr.len(), 300, "300 single-byte deletes")

    t.section("large document")
    mut doc = Rope.init()
    mut line = 0
    while line < 400:
        doc.append("line " + line.to_str() + ": the quick brown fox\n")
        line = line + 1
    t.assert_true(doc.len() > 8000, "document built")
    t.assert_true(doc.find("line 399", 0) >= 0, "last line present")
    mut at = doc.find("line 200:", 0)
    doc.delete(at, 30)
    t.assert_eq_int(doc.find("line 200:", 0), -1, "line 200 deleted")
    t.assert_true(doc.find("line 201:", 0) >= 0, "neighbour kept")
    doc.insert(doc.find("line 201:", 0), "inserted\n")
    t.assert_true(doc.find("inserted\nline 201:", 0) >= 0, "inserted before line 201")

    t.section("determinism")
    mut s1 = Rope.with_seed(31337)
    mut s2 = Rope.with_seed(31337)
    mut e = 0
    while e < 80:
        s1.insert(e * 3 / 2, "ab" + e.to_str())
        s2.insert(e * 3 / 2, "ab" + e.to_str())
        e = e + 1
    t.assert_eq_str(s1.to_str(), s2.to_str(), "same seed same text")
    t.assert_eq_int(s1.chunk_count(), s2.chunk_count(), "same seed same chunking")
    t.summary()
