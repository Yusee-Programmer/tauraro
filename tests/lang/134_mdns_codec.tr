# tests/lang/134_mdns_codec.tr
# std.net.mdns codec and DNS-SD logic, no network. Reference packets were assembled
# independently with Python struct (hand-placed compression pointers), so the encoder
# is checked byte for byte and the decoder against bytes it did not produce.

from std.test import TestRunner
from std.core.vec import Vec
from std.net.wire import wire_hex
from std.net.wire import wire_unhex
from std.net.wire import wire_slice
from std.net.wire import wire_concat
from std.net.mdns import MdnsMessage
from std.net.mdns import MdnsRecord
from std.net.mdns import MdnsQuestion
from std.net.mdns import DnsSdService
from std.net.mdns import MdnsResponder
from std.net.mdns import dnssd_browse_query
from std.net.mdns import dnssd_resolve_query
from std.net.mdns import dnssd_enumerate_query
from std.net.mdns import dnssd_services
from std.net.mdns import dnssd_announce
from std.net.mdns import dnssd_meta_name
from std.net.mdns import dns_encode_name
from std.net.mdns import dns_name_eq
from std.net.mdns import dns_escape_label
from std.net.mdns import ipv4_to_bytes
from std.net.mdns import ipv4_to_text
from std.net.mdns import ipv6_to_text

def V1() -> str: return "000000000001000000000000055f68747470045f746370056c6f63616c00000c0001"
def V2() -> str: return "12340000000100000000000004686f7374056c6f63616c0000018001"
def V3() -> str: return "000084000000000100000003055f68747470045f746370056c6f63616c00000c0001000000780009064d7920576562c00cc02800218001000000780014000000001f90066d79686f7374056c6f63616c00c0280010800100000078000d06706174683d2f057665723d31c04300018001000000780004c0a80114"
def V4() -> str: return "0000840000000001000000000168056c6f63616c00001c00010000000a001020010db8000000000000000000000001"

def dec(hex: str) -> Result[MdnsMessage, str]:
    return MdnsMessage.decode(wire_unhex(hex))

def bad(t: TestRunner, hex: str, msg: str):
    mut r: Result[MdnsMessage, str] = MdnsMessage.decode(wire_unhex(hex))
    t.assert_true(r.is_err, msg)

def sample_service() -> DnsSdService:
    mut s = DnsSdService.make("My Web", "_http._tcp", "local", "myhost.local", 8080, 120)
    s.add_addr("192.168.1.20")
    s.add_txt("path=/")
    s.add_txt("ver=1")
    return s

def main():
    mut t = TestRunner.init("134_mdns_codec")

    t.section("names")
    t.assert_eq_str(wire_hex(dns_encode_name("a.bc")), "016102626300", "plain name")
    t.assert_eq_str(wire_hex(dns_encode_name("a.bc.")), "016102626300", "trailing dot ignored")
    t.assert_eq_str(wire_hex(dns_encode_name("")), "00", "root name (empty)")
    t.assert_eq_str(wire_hex(dns_encode_name(".")), "00", "root name (dot)")
    t.assert_eq_str(wire_hex(dns_encode_name("My\\.Dot.local")), "064d792e446f74056c6f63616c00", "escaped dot stays inside the label")
    t.assert_eq_str(wire_hex(dns_encode_name("a\\065b.x")), "03614162017800", "\\DDD decimal escape")
    t.assert_eq_str(dns_encode_name("a..b"), "", "empty label rejected")
    t.assert_eq_str(dns_encode_name(".a"), "", "leading dot rejected")
    t.assert_eq_str(dns_encode_name("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.local"), "", "65-byte label rejected")
    t.assert_true(dns_encode_name("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.local").len() > 0, "63-byte label accepted")
    t.assert_eq_str(dns_escape_label("a.b\\c"), "a\\.b\\\\c", "escape dot and backslash")
    t.assert_eq_str(dns_escape_label("My Web"), "My Web", "spaces are kept readable")
    t.assert_true(dns_name_eq("Host.LOCAL", "host.local."), "case-insensitive, trailing dot ignored")
    t.assert_false(dns_name_eq("host.local", "host2.local"), "different names")
    t.assert_false(dns_name_eq("a\\.b", "a.b"), "escaped dot is not a separator")

    t.section("independent reference packets (python struct)")
    mut q1 = dnssd_browse_query("_http._tcp.local")
    t.assert_eq_str(wire_hex(q1.encode()), V1(), "browse query bytes")
    mut q2 = MdnsMessage.query(0x1234)
    q2.add_question("host.local", 1, true)
    t.assert_eq_str(wire_hex(q2.encode()), V2(), "QU A query bytes")
    mut svc = sample_service()
    mut m3 = MdnsMessage.response(0)
    m3.add_answer(MdnsRecord.ptr("_http._tcp.local", "My Web._http._tcp.local", 120))
    mut srv = MdnsRecord.srv("My Web._http._tcp.local", 0, 0, 8080, "myhost.local", 120)
    srv.cache_flush = true
    m3.add_additional(srv)
    mut items = Vec[str].init(2)
    items.push("path=/")
    items.push("ver=1")
    mut txt = MdnsRecord.text("My Web._http._tcp.local", items, 120)
    txt.cache_flush = true
    m3.add_additional(txt)
    mut a = MdnsRecord.a("myhost.local", "192.168.1.20", 120)
    a.cache_flush = true
    m3.add_additional(a)
    t.assert_eq_str(wire_hex(m3.encode()), V3(), "DNS-SD response bytes incl. name compression")
    mut aaaa = MdnsMessage.response(0)
    aaaa.add_answer(MdnsRecord.aaaa("h.local", wire_unhex("20010db8000000000000000000000001"), 10))
    t.assert_eq_str(wire_hex(aaaa.encode()), V4(), "AAAA response bytes")

    mut d1: Result[MdnsMessage, str] = dec(V1())
    t.assert_true(d1.is_ok, "decode V1")
    t.assert_eq_int(d1.ok.questions.len(), 1, "one question")
    t.assert_eq_str(d1.ok.questions.get(0).name, "_http._tcp.local", "question name")
    t.assert_eq_int(d1.ok.questions.get(0).qtype, 12, "PTR")
    t.assert_false(d1.ok.questions.get(0).unicast, "QM question")
    mut d2: Result[MdnsMessage, str] = dec(V2())
    t.assert_eq_int(d2.ok.id, 0x1234, "id")
    t.assert_true(d2.ok.questions.get(0).unicast, "QU bit decoded")
    t.assert_eq_int(d2.ok.questions.get(0).qclass, 1, "class without the QU bit")

    mut d3: Result[MdnsMessage, str] = dec(V3())
    t.assert_true(d3.is_ok, "decode V3 (compressed)")
    mut m = d3.ok
    t.assert_true(m.is_response(), "QR bit")
    t.assert_eq_int(m.flags, 0x8400, "flags")
    t.assert_eq_int(m.answers.len(), 1, "1 answer")
    t.assert_eq_int(m.additional.len(), 3, "3 additional")
    mut p = m.answers.get(0)
    t.assert_eq_str(p.name, "_http._tcp.local", "PTR owner")
    t.assert_eq_str(p.target, "My Web._http._tcp.local", "PTR target through a pointer")
    t.assert_eq_int(p.ttl, 120, "ttl")
    t.assert_false(p.cache_flush, "shared record has no cache-flush bit")
    mut s = m.additional.get(0)
    t.assert_eq_int(s.rtype, 33, "SRV")
    t.assert_true(s.cache_flush, "cache-flush bit")
    t.assert_eq_int(s.rclass, 1, "class without cache-flush")
    t.assert_eq_int(s.port, 8080, "SRV port")
    t.assert_eq_str(s.target, "myhost.local", "SRV target")
    mut x = m.additional.get(1)
    t.assert_eq_int(x.txt.len(), 2, "two TXT strings")
    t.assert_eq_str(x.txt_get("PATH"), "/", "txt_get is case-insensitive on the key")
    t.assert_eq_str(x.txt_get("ver"), "1", "txt ver")
    t.assert_true(x.txt_has("path"), "txt_has")
    t.assert_false(x.txt_has("nothere"), "txt_has absent")
    mut ar = m.additional.get(2)
    t.assert_eq_str(ar.name, "myhost.local", "A owner through a pointer into SRV rdata")
    t.assert_eq_str(ar.addr, "192.168.1.20", "A address text")
    t.assert_eq_str(wire_hex(m.encode()), V3(), "decode then encode reproduces the packet")
    mut d4: Result[MdnsMessage, str] = dec(V4())
    t.assert_eq_str(d4.ok.answers.get(0).addr, "2001:db8::1", "AAAA text form")

    t.section("services from a response")
    mut msgs = Vec[MdnsMessage].init(1)
    msgs.push(m)
    mut found = dnssd_services(msgs, "_http._tcp.local")
    t.assert_eq_int(found.len(), 1, "one service")
    mut f = found.get(0)
    t.assert_eq_str(f.instance, "My Web", "instance")
    t.assert_eq_str(f.service_type, "_http._tcp", "service type")
    t.assert_eq_str(f.domain, "local", "domain")
    t.assert_eq_str(f.host, "myhost.local", "host")
    t.assert_eq_int(f.port, 8080, "port")
    t.assert_eq_int(f.addrs.len(), 1, "one address")
    t.assert_eq_str(f.addrs.get(0), "192.168.1.20", "address")
    t.assert_eq_str(f.txt_get("path"), "/", "txt via the service")
    t.assert_eq_str(f.instance_name(), "My Web._http._tcp.local", "instance_name")
    t.assert_eq_int(dnssd_services(msgs, "_ipp._tcp.local").len(), 0, "other type finds nothing")

    # instance label containing a dot survives encode/decode
    mut dotted = DnsSdService.make("Dr. Who's Mac", "_ssh._tcp", "local", "mac.local", 22, 60)
    dotted.add_addr("10.0.0.7")
    mut ann = dnssd_announce(dotted, false)
    mut ar2: Result[MdnsMessage, str] = MdnsMessage.decode(ann.encode())
    t.assert_true(ar2.is_ok, "announce round trip")
    mut ms2 = Vec[MdnsMessage].init(1)
    ms2.push(ar2.ok)
    mut f2 = dnssd_services(ms2, "_ssh._tcp.local")
    t.assert_eq_int(f2.len(), 1, "dotted instance found")
    t.assert_eq_str(f2.get(0).instance, "Dr. Who's Mac", "instance with a dot is not split")
    t.assert_eq_int(f2.get(0).port, 22, "its port")
    t.assert_eq_str(ar2.ok.answers.get(0).target, "Dr\\. Who's Mac._ssh._tcp.local", "escaped form in the name text")
    mut bye = dnssd_announce(dotted, true)
    t.assert_eq_int(bye.answers.get(0).ttl, 0, "goodbye PTR has TTL 0")
    t.assert_eq_int(bye.additional.get(0).ttl, 0, "goodbye SRV has TTL 0")

    t.section("responder")
    mut resp = MdnsResponder.init()
    resp.add(sample_service())
    mut web2 = DnsSdService.make("Second", "_http._tcp", "local", "other.local", 81, 120)
    web2.add_addr("10.1.1.1")
    resp.add(web2)
    mut ipp = DnsSdService.make("Printer", "_ipp._tcp", "local", "prn.local", 631, 4500)
    ipp.add_addr("10.1.1.2")
    resp.add(ipp)

    mut r1 = resp.answer(dnssd_browse_query("_http._tcp.local"), false)
    t.assert_true(r1.is_response(), "a response")
    t.assert_eq_int(r1.id, 0, "mDNS response id is 0")
    t.assert_eq_int(r1.answers.len(), 2, "PTR for both _http._tcp instances")
    t.assert_true(r1.additional.len() >= 6, "SRV + TXT + A for each instance in additional")
    mut ms3 = Vec[MdnsMessage].init(1)
    ms3.push(r1)
    t.assert_eq_int(dnssd_services(ms3, "_http._tcp.local").len(), 2, "browse result parses back to two services")

    mut kq = dnssd_browse_query("_http._tcp.local")
    kq.answers.push(MdnsRecord.ptr("_http._tcp.local", "My Web._http._tcp.local", 100))
    mut r2 = resp.answer(kq, false)
    t.assert_eq_int(r2.answers.len(), 1, "known answer (ttl 100 >= half of 120) suppressed")
    t.assert_eq_str(r2.answers.get(0).target, "Second._http._tcp.local", "only the unknown instance is sent")
    mut kq2 = dnssd_browse_query("_http._tcp.local")
    kq2.answers.push(MdnsRecord.ptr("_http._tcp.local", "My Web._http._tcp.local", 30))
    t.assert_eq_int(resp.answer(kq2, false).answers.len(), 2, "stale known answer (ttl 30 < half) is NOT suppressed")

    mut r3 = resp.answer(dnssd_enumerate_query(), false)
    t.assert_eq_int(r3.answers.len(), 2, "meta-query lists each service TYPE once (_http._tcp, _ipp._tcp)")
    t.assert_eq_str(r3.answers.get(0).name, dnssd_meta_name(), "meta owner")
    t.assert_eq_str(r3.answers.get(0).target, "_http._tcp.local", "meta target is a service type")

    mut r4 = resp.answer(dnssd_resolve_query("My Web._http._tcp.local"), false)
    t.assert_eq_int(r4.answers.len(), 2, "SRV + TXT answered")
    t.assert_true(r4.additional.len() >= 1, "A record in additional")
    mut aq = MdnsMessage.query(0)
    aq.add_question("MYHOST.local", 1, false)
    mut r5 = resp.answer(aq, false)
    t.assert_eq_int(r5.answers.len(), 1, "A query answered (case-insensitive)")
    t.assert_eq_str(r5.answers.get(0).addr, "192.168.1.20", "A address")
    mut nq = MdnsMessage.query(0)
    nq.add_question("nothing.local", 255, false)
    t.assert_eq_int(resp.answer(nq, false).answers.len(), 0, "no match => empty response")
    mut lq = dnssd_browse_query("_ipp._tcp.local")
    lq.id = 77
    mut r6 = resp.answer(lq, true)
    t.assert_eq_int(r6.id, 77, "legacy unicast copies the query id")
    t.assert_eq_int(r6.questions.len(), 1, "and echoes the question")
    t.assert_eq_int(resp.answer(r1, false).answers.len(), 0, "responses are not answered")

    t.section("malformed input")
    mut e0: Result[MdnsMessage, str] = MdnsMessage.decode("short")
    t.assert_true(e0.is_err, "shorter than the header")
    mut full = wire_unhex(V3())
    mut all_err = true
    mut i = 0
    while i < full.len():
        mut pr: Result[MdnsMessage, str] = MdnsMessage.decode(wire_slice(full, 0, i))
        if pr.is_ok: all_err = false
        i = i + 1
    t.assert_true(all_err, "every proper prefix of a valid packet is rejected (no crash)")
    bad(t, "000000000001000000000000c00c00010001", "name pointer to itself")
    bad(t, "000000000001000000000000c01000010001", "forward name pointer")
    bad(t, "00000000000100000000000040610000010001", "reserved label type 0x40")
    bad(t, "000000000001000000000000c0", "truncated compression pointer")
    bad(t, "0000000000ff000000000000", "counts larger than the packet")
    bad(t, "00008400000000010000000001610000010001000000780003c0a801", "A record with 3 bytes of rdata")
    bad(t, "0000840000000001000000000161000021000100000078000400000000", "SRV rdata too short")
    bad(t, "00008400000000010000000001610000100001000000780003056162", "TXT string longer than its rdata")
    bad(t, "0000840000000001000000000161000c000100000078000401620000", "PTR target runs past its rdata (label overruns)")
    bad(t, "000084000000000100000000016100000100010000007800ff", "rdata length beyond the packet")
    mut loopmsg = "000000000001000000000000" + "0161" + "c00c" + "00010001"
    mut lr: Result[MdnsMessage, str] = MdnsMessage.decode(wire_unhex(loopmsg))
    t.assert_true(lr.is_err, "label followed by a pointer back to itself")
    # bad outgoing data
    mut badq = MdnsMessage.query(0)
    badq.add_question("a..b", 1, false)
    t.assert_eq_str(badq.encode(), "", "encode refuses an invalid name")
    mut longtxt = Vec[str].init(1)
    longtxt.push("x")
    mut big = MdnsMessage.response(0)
    mut sb = ""
    mut k = 0
    while k < 26:
        sb = sb + "0123456789"
        k = k + 1
    longtxt.push(sb)
    big.add_answer(MdnsRecord.text("t.local", longtxt, 1))
    t.assert_eq_str(big.encode(), "", "TXT string > 255 bytes refused")

    t.section("address text")
    t.assert_eq_str(wire_hex(ipv4_to_bytes("192.168.1.20")), "c0a80114", "ipv4 -> bytes")
    t.assert_eq_str(ipv4_to_bytes("256.1.1.1"), "", "octet > 255")
    t.assert_eq_str(ipv4_to_bytes("1.2.3"), "", "too few octets")
    t.assert_eq_str(ipv4_to_bytes("1.2.3.4.5"), "", "too many octets")
    t.assert_eq_str(ipv4_to_bytes("a.b.c.d"), "", "not digits")
    t.assert_eq_str(ipv4_to_text(wire_unhex("0a000001")), "10.0.0.1", "bytes -> ipv4")
    t.assert_eq_str(ipv6_to_text(wire_unhex("00000000000000000000000000000001")), "::1", "::1")
    t.assert_eq_str(ipv6_to_text(wire_unhex("00000000000000000000000000000000")), "::", "::")
    t.assert_eq_str(ipv6_to_text(wire_unhex("fe800000000000000000000000000001")), "fe80::1", "fe80::1")
    t.assert_eq_str(ipv6_to_text(wire_unhex("00010002000300040005000600070008")), "1:2:3:4:5:6:7:8", "no zero run")
    t.assert_eq_str(ipv6_to_text(wire_unhex("20010db8000000010000000000000001")), "2001:db8:0:1::1", "longest zero run compressed (the single zero group is not)")
    t.assert_eq_str(ipv6_to_text(wire_unhex("20010db800000000000100000000000a")), "2001:db8::1:0:0:a", "tie goes to the first longest run (RFC 5952)")
    t.assert_eq_str(ipv6_to_text(wire_unhex("20010db8000000010002000300040005")), "2001:db8:0:1:2:3:4:5", "single zero group is not compressed")
    t.summary()
