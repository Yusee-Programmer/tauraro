# tests/lang/145_ogg_audio.tr
# std.audio Ogg: container (pages, CRC, packets, multiplexed streams, granule
# trimming), Vorbis (stb_vorbis) and Opus (libopus 1.5.2: SILK, hybrid and CELT,
# stereo and 5.1) decoding. The vectors were encoded with libvorbis / libopus
# and the expected samples are from the reference decoders (libvorbis and
# libopus through GStreamer); the whole files were also compared (max error
# 3e-7 for Vorbis, 1.6e-5 = 1/2 LSB of the reference's 16 bit rounding for
# Opus). Also: reader seek, streaming decoder, corruption handling.

from std.test import TestRunner
from std.audio.mod import Audio, AudioBuffer, Ogg, Vorbis, Opus
from std.audio.ogg import OggFile, OggReader, OggDecoder, OggInfo
from std.crypto.native import _cn_unhex

def fabs_(x: float) -> float:
    if x < 0.0: return 0.0 - x
    return x

def unhex(h: str) -> str:
    mut r: Result[str, str] = _cn_unhex(h)
    return r.ok

def vec_v1() -> str:
    return unhex("")

def vec_v2s() -> str:
    return unhex("")

def vec_o1() -> str:
    return unhex("")

def vec_osilk() -> str:
    return unhex("")

def vec_ohyb() -> str:
    return unhex("")

def vec_o6s() -> str:
    return unhex("")

def vec_muxs() -> str:
    return unhex("")

def check_samples(t: TestRunner, b: AudioBuffer, idx: List[int], ref: List[float], eps: float, what: str):
    mut worst = 0.0
    mut i = 0
    while i < len(idx):
        mut d = fabs_(b.samples[idx[i]] - ref[i])
        if d > worst: worst = d
        i = i + 1
    t.assert_true(worst <= eps, f"{what}: samples match the reference (worst {worst})")

def same(a: AudioBuffer, b: AudioBuffer) -> bool:
    if len(a.samples) != len(b.samples): return false
    mut i = 0
    while i < len(a.samples):
        if a.samples[i] != b.samples[i]: return false
        i = i + 1
    return true

# Decode + compare against reference samples, then the reader and the streaming decoder.
def run_vec(t: TestRunner, name: str, d: str, codec: str, ch: int, rate: int, frames: int, idx: List[int], ref: List[float], eps: float):
    t.section(name)
    mut r: Result[AudioBuffer, str] = Audio.decode(d, d.len())
    t.assert_true(r.is_ok, f"{name}: Audio.decode sniffs Ogg")
    mut b = r.ok
    t.assert_eq_int(b.channels, ch, f"{name}: channels")
    t.assert_eq_int(b.sample_rate, rate, f"{name}: rate")
    t.assert_eq_int(b.frames(), frames, f"{name}: exact frame count")
    check_samples(t, b, idx, ref, eps, name)
    mut ir: Result[OggInfo, str] = OggFile.info(d, d.len())
    t.assert_true(ir.is_ok, f"{name}: info")
    mut inf = ir.ok
    t.assert_true(inf.codec == codec, f"{name}: codec {inf.codec}")
    t.assert_eq_int(inf.frames, frames, f"{name}: info frames")
    # reader: whole file, then seeks compared with the one-shot decode
    mut rr: Result[OggReader, str] = OggFile.open(d, d.len())
    t.assert_true(rr.is_ok, f"{name}: open")
    mut rd = rr.ok
    t.assert_eq_int(rd.total, frames, f"{name}: reader total")
    mut all = rd.read(frames + 100)
    t.assert_true(same(all, b), f"{name}: reader equals decode")
    t.assert_eq_int(rd.read(10).frames(), 0, f"{name}: read at end is empty")
    mut targets: List[int] = [0, frames / 3, frames / 2 + 7, frames - 50]
    mut k = 0
    while k < len(targets):
        mut sk: Result[int, str] = rd.seek(targets[k])
        t.assert_eq_int(sk.ok, targets[k], f"{name}: seek({targets[k]}) lands exactly")
        mut got = rd.read(40)
        mut ok = got.frames() == 40
        mut i = 0
        while ok and i < 40 * ch:
            if fabs_(got.samples[i] - b.samples[targets[k] * ch + i]) > 0.0001: ok = false
            i = i + 1
        t.assert_true(ok, f"{name}: samples after seek({targets[k]}) equal the decode")
        k = k + 1
    rd.close()
    # streaming decoder fed in awkward chunk sizes
    mut dec = OggDecoder.init("")
    mut pos = 0
    mut chunk = 97
    mut acc: List[float] = []
    while pos < d.len():
        mut n = chunk
        if pos + n > d.len(): n = d.len() - pos
        mut fr: Result[int, str] = dec.feed(d.slice(pos, pos + n), n)
        pos = pos + n
        chunk = chunk + 61
        if chunk > 1500: chunk = 53
        mut pb = dec.pull(300)
        mut j = 0
        while j < len(pb.samples):
            acc.append(pb.samples[j])
            j = j + 1
    mut fin: Result[int, str] = dec.finish()
    t.assert_true(dec.ready(), f"{name}: stream ready")
    mut rest = dec.pull(-1)
    mut j2 = 0
    while j2 < len(rest.samples):
        acc.append(rest.samples[j2])
        j2 = j2 + 1
    t.assert_eq_int(len(acc), len(b.samples), f"{name}: streaming length")
    mut sok = true
    mut q = 0
    while q < len(acc) and q < len(b.samples):
        if acc[q] != b.samples[q]: sok = false
        q = q + 1
    t.assert_true(sok, f"{name}: streaming equals one-shot")
    dec.close()

def test_vectors(t: TestRunner):
    run_vec(t, "v1", vec_v1(), "vorbis", 1, 22050, 7168, [796, 1592, 2389, 3185, 3982, 4778, 5575, 6371], [-0.43909764, -0.77958417, -0.74837583, -0.37076491, 0.10857113, 0.60022807, 0.80835801, 0.64209378], 0.000001)
    run_vec(t, "v2s", vec_v2s(), "vorbis", 2, 44100, 6144, [1365, 2730, 4096, 5461, 6826, 8192, 9557, 10922], [0.14716032, 0.09219426, -0.07227665, -0.07101862, 0.05116364, 0.05130532, -0.14624001, 0.02945759], 0.000001)
    run_vec(t, "o1", vec_o1(), "opus", 2, 48000, 14400, [3200, 6400, 9600, 12800, 16000, 19200, 22400, 25600], [0.2590332, 0.23590088, 0.25585938, 0.21994019, 0.22286987, 0.26315308, 0.2010498, 0.22937012], 0.00003)
    run_vec(t, "osilk", vec_osilk(), "opus", 1, 48000, 192000, [21333, 42666, 64000, 85333, 106666, 128000, 149333, 170666], [-0.26095581, -0.2350769, -0.02996826, 0.08789062, -0.16555786, 0.14047241, 0.12780762, -0.05841064], 0.00003)
    run_vec(t, "ohyb", vec_ohyb(), "opus", 1, 48000, 96000, [10666, 21333, 32000, 42666, 53333, 64000, 74666, 85333], [-0.13760376, 0.10180664, 0.09048462, -0.03344727, 0.00775146, -0.03326416, 0.04141235, -0.17889404], 0.00003)
    run_vec(t, "o6s", vec_o6s(), "opus", 6, 48000, 7680, [5120, 10240, 15360, 20480, 25600, 30720, 35840, 40960], [-0.2250061, -0.09442139, -0.02099609, 0.06771851, 0.08865356, -0.05865479, -0.07232666, 0.29318237], 0.00003)
    run_vec(t, "muxs", vec_muxs(), "vorbis", 1, 44100, 6615, [746, 1493, 2240, 2986, 3733, 4480, 5226, 5973], [0.40150282, 0.70152819, 0.80223477, 0.72273284, 0.4673143, 0.07962203, -0.29517007, -0.62279505], 0.000001)

def byte_at(d: str, i: int) -> int:
    mut p = d as Pointer[char]
    unsafe:
        return (p.offset(i).read() as int) & 255

# Copy of d with the bits of `mask` toggled in byte `pos`.
def flip(d: str, pos: int, mask: int) -> str:
    mut v = byte_at(d, pos) ^ mask
    mut hx = "0123456789abcdef"
    mut one = unhex(hx.slice(v / 16, v / 16 + 1) + hx.slice(v % 16, v % 16 + 1))
    return d.slice(0, pos) + one + d.slice(pos + 1, d.len())

def test_meta_and_structure(t: TestRunner):
    t.section("metadata")
    mut d = vec_o1()
    mut ir: Result[OggInfo, str] = OggFile.info(d, d.len())
    mut inf = ir.ok
    t.assert_true(inf.tag("title") == "OpusTone", "OpusTags TITLE")
    t.assert_true(inf.tag("Artist") == "Tauraro", "tag lookup is case-insensitive")
    t.assert_true(inf.tag("nope") == "", "missing tag")
    t.assert_true(inf.vendor == "Encoded with GStreamer opusenc", "OpusTags vendor")
    t.assert_true(inf.pre_skip > 0 and inf.channel_family == 0, "OpusHead pre-skip and family")
    t.assert_true(inf.output_gain_db == 0.0, "output gain")
    t.assert_true(inf.duration > 0.299 and inf.duration < 0.301, "duration from granule positions")
    mut v = vec_v1()
    mut vr: Result[OggInfo, str] = OggFile.info(v, v.len())
    t.assert_true(vr.ok.tag("TITLE") == "TestTone" and vr.ok.tag("artist") == "Tauraro", "Vorbis comments")
    t.assert_true(vr.ok.vendor.starts_with("Xiph.Org libVorbis"), "Vorbis vendor")
    t.assert_true(vr.ok.nominal_bitrate > 0, "Vorbis nominal bitrate")
    t.section("container structure")
    mut pg = OggFile.pages(d, d.len())
    t.assert_eq_int(len(pg), 3, "o1 has 3 pages")
    t.assert_true((pg[0].flags & 2) != 0 and (pg[2].flags & 4) != 0, "BOS / EOS flags")
    t.assert_eq_int(pg[2].granule, 14712, "final granule = samples + pre-skip")
    t.assert_eq_int(pg[1].granule, 0, "header page granule")
    t.assert_eq_int(pg[0].offset, 0, "first page offset")
    t.assert_eq_int(pg[1].sequence, 1, "page sequence")
    mut pk = OggFile.packets(d, d.len(), -1)
    t.assert_eq_int(len(pk), 18, "OpusHead + OpusTags + 16 audio packets")
    t.assert_true(pk[0].first and pk[0].length == 19, "OpusHead packet")
    t.assert_true(pk[len(pk) - 1].last and pk[len(pk) - 1].granule == 14712, "last packet carries the granule")
    mut mx = vec_muxs()
    mut mi: Result[OggInfo, str] = OggFile.info(mx, mx.len())
    t.assert_eq_int(len(mi.ok.streams), 2, "two logical streams listed")
    t.assert_true(mi.ok.streams[0].codec == "theora" and mi.ok.streams[1].codec == "vorbis", "stream codecs")
    t.assert_true(mi.ok.serial == mi.ok.streams[1].serial, "the Vorbis stream is the one decoded")
    t.assert_eq_int(len(OggFile.pages(mx, mx.len())), 6, "multiplexed page count")
    t.assert_true(mi.ok.streams[0].serial != mi.ok.streams[1].serial, "distinct serials")
    mut vp = OggFile.packets(mx, mx.len(), mi.ok.serial)
    t.assert_true(vp[0].first and len(vp) > 3, "per-stream packets")
    mut no: Result[AudioBuffer, str] = Opus.decode(mx, mx.len())
    t.assert_true(no.is_err, "Opus.decode refuses a file with only Vorbis audio")
    mut no2: Result[AudioBuffer, str] = Vorbis.decode(d, d.len())
    t.assert_true(no2.is_err, "Vorbis.decode refuses an Opus file")
    mut yes: Result[AudioBuffer, str] = Opus.decode(d, d.len())
    mut yes2: Result[AudioBuffer, str] = Vorbis.decode(v, v.len())
    mut yes3: Result[AudioBuffer, str] = Ogg.decode(v, v.len())
    t.assert_true(yes.is_ok and yes2.is_ok and yes3.is_ok, "codec-specific decoders accept their codec")
    t.assert_eq_str(OggFile.opus_version(), "libopus 1.5.2", "vendored libopus version")

def test_errors(t: TestRunner):
    t.section("errors and damaged input")
    mut a: Result[AudioBuffer, str] = Ogg.decode("OggS garbage that is not a page", 31)
    t.assert_true(a.is_err, "garbage after OggS")
    mut e: Result[AudioBuffer, str] = Ogg.decode("", 0)
    t.assert_true(e.is_err, "empty input")
    mut d = vec_o1()
    mut cut: Result[AudioBuffer, str] = Ogg.decode(d, 100)
    t.assert_true(cut.is_err, "truncated inside the headers")
    mut v = vec_v1()
    mut cutv: Result[AudioBuffer, str] = Ogg.decode(v, 1000)
    t.assert_true(cutv.is_err, "truncated Vorbis setup")
    mut o: Result[OggReader, str] = OggFile.open("RIFF....WAVE", 12)
    t.assert_true(o.is_err, "open rejects non-Ogg")
    # a bad CRC drops exactly that page: the rest of the file still decodes
    mut s = vec_osilk()
    mut pg = OggFile.pages(s, s.len())
    mut hit = pg[len(pg) - 2].offset + 40
    mut dmg = flip(s, hit, 4)
    mut dr: Result[OggInfo, str] = OggFile.info(dmg, dmg.len())
    t.assert_true(dr.is_ok and dr.ok.bad_pages == 1, "corrupt page is skipped and counted")
    t.assert_true(len(OggFile.pages(dmg, dmg.len())) == len(pg) - 1, "pages() skips the CRC-bad page")
    mut dd: Result[AudioBuffer, str] = Ogg.decode(dmg, dmg.len())
    t.assert_true(dd.is_ok and dd.ok.frames() > 0, "damaged file still decodes")
    # many random single-byte corruptions of each codec: never a crash
    mut seed = 12345
    mut crashes_ok = 0
    mut files: List[str] = [vec_o1(), vec_v1(), vec_ohyb(), vec_o6s()]
    mut fi = 0
    while fi < len(files):
        mut n = 0
        while n < 30:
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
            mut pos = (seed >> 4) % files[fi].len()
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
            mut x = flip(files[fi], pos, 1 << ((seed >> 8) % 8))
            mut rr: Result[AudioBuffer, str] = Ogg.decode(x, x.len())
            mut ri: Result[OggReader, str] = OggFile.open(x, x.len())
            if ri.is_ok:
                mut sk: Result[int, str] = ri.ok.seek(ri.ok.total / 2)
                mut gg = ri.ok.read(100)
                ri.ok.close()
            crashes_ok = crashes_ok + 1
            n = n + 1
        fi = fi + 1
    t.assert_eq_int(crashes_ok, 120, "120 corrupted files handled without a crash")

def test_gain_and_trim(t: TestRunner):
    t.section("sniffing")
    mut d = vec_o1()
    mut r: Result[AudioBuffer, str] = Audio.decode(d, d.len())
    t.assert_true(r.is_ok and r.ok.sample_rate == 48000, "Audio.decode -> Opus at 48 kHz")
    t.assert_true(r.ok.peak() > 0.1 and r.ok.peak() <= 1.0, "decoded level")
    mut x: Result[AudioBuffer, str] = Audio.decode("OggS", 4)
    t.assert_true(x.is_err, "OggS stub is an error")

def main():
    mut t = TestRunner.init("145_ogg_audio")
    test_vectors(t)
    test_meta_and_structure(t)
    test_errors(t)
    test_gain_and_trim(t)
    t.summary()
