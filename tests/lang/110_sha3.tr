    mut p1000 = pattern(1000)
    t.assert_eq_str(Sha3.sha3_224_hex(p1000), "56812d3d31242051de174106777f4108c791ab801f1569f73d57fa0b", "sha3_224 len 1000")
    t.assert_eq_str(Sha3.sha3_256_hex(p1000), "bd8b4d76041e0135e53fab1aaf425c7b1c129d8878ffb64cc31230ccafd7dc7c", "sha3_256 len 1000")
    t.assert_eq_str(Sha3.sha3_384_hex(p1000), "01269eed23d8f1c00d333933989211974c16fed038dfde30f8514168ae13e8409f565dbe4d81399b6ed23db9762f7989", "sha3_384 len 1000")
    t.assert_eq_str(Sha3.sha3_512_hex(p1000), "3d71681b54b99f11ddeb233b0a41b65896f7b30dda9e83d52864a4e818a09408e2f306028abe973298f96ee081a06e5ac8156cd7b856f0eb28270e1ca37bd0c6", "sha3_512 len 1000")
    t.assert_eq_str(Sha3.shake128_hex(p1000, 50), "e666e4224e1a10753e9267e04c93764c4380baad17313529724720d9fca679af826492f91bcec4a81f460b694e8ce8366952", "shake128 len 1000")
    t.assert_eq_str(Sha3.shake256_hex(p1000, 50), "980bf59987a720e516297296f92a27bba960e48a40bd01a0415b2e5dee26313d0a3f3ce47abe9e0f73cf74dc4fe68a5d5125", "shake256 len 1000")
    t.section("incremental API")
    mut big = pattern(300)
    mut ih = Sha3Hasher.sha3_256()
    mut k = 0
    while k < 300:
        mut piece_len = 7
        if k + piece_len > 300: piece_len = 300 - k
        ih.update_bytes(CryptoBytes.slice(big, k, piece_len), piece_len)
        k = k + piece_len
    t.assert_eq_str(ih.digest_hex(), Sha3.sha3_256_hex(big), "chunked update == one-shot")
    ih.free()
    mut xh = Sha3Hasher.shake128()
    xh.update(big)
    mut x1 = xh.squeeze(100)
    mut x2 = xh.squeeze(100)
    mut x3 = xh.squeeze(100)
    xh.free()
    t.assert_eq_str(Hex.encode(CryptoBytes.concat(CryptoBytes.concat(x1, x2), x3)), Sha3.shake128_hex(big, 300), "squeeze x3 == one 300B squeeze")
    t.assert_eq_int(x1.len(), 100, "squeeze length")
    mut nul = CryptoBytes.zeroed(5)
    mut nulstr = CryptoBytes.wrap(nul, 5)
    t.assert_eq_str(Sha3.sha3_256_hex(nulstr), "67702a0ed25a50c46fc0a0fb46a6dfbf5333c9dc25451abdb1eeac93f1e968d5", "embedded NULs are hashed (5 zero bytes)")
    t.assert_eq_int(Sha3.sha3_256(nulstr).len(), 32, "raw digest length is 32 despite NULs")

    t.summary()
