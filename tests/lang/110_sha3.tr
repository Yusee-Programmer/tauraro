# tests/lang/110_sha3.tr
# std.crypto.sha3: SHA3-224/256/384/512, SHAKE128/256, Keccak-256/512.
# Known answers: the NIST FIPS 202 / SHA-3 example values ("", "abc", the 448-bit
# and 896-bit messages, one million 'a') and Keccak-256("") / ("abc") (Ethereum);
# the pattern-input vectors were generated with Python hashlib (the reference)
# for lengths straddling every rate boundary (72/104/136/144/168 bytes).

from std.test import TestRunner
from std.crypto.sha3 import Sha3, Sha3Hasher
from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

# deterministic pattern input: byte i = (i*7 + 3) & 255
def pattern(n: int) -> str:
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, i * 7 + 3)
        i = i + 1
    return CryptoBytes.wrap(p, n)

def repeat_a(n: int) -> str:
    mut p: Pointer[char] = CryptoBytes.zeroed(n)
    mut i = 0
    while i < n:
        CryptoBytes.put(p, i, 97)
        i = i + 1
    return CryptoBytes.wrap(p, n)

def main():
    mut t = TestRunner.init("110_sha3")

    t.section("NIST FIPS 202 examples")
    t.assert_eq_str(Sha3.sha3_224_hex(""), "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7", "sha3_224 empty")
    t.assert_eq_str(Sha3.sha3_256_hex(""), "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", "sha3_256 empty")
    t.assert_eq_str(Sha3.sha3_384_hex(""), "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004", "sha3_384 empty")
    t.assert_eq_str(Sha3.sha3_512_hex(""), "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26", "sha3_512 empty")
    t.assert_eq_str(Sha3.sha3_224_hex("abc"), "e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf", "sha3_224 abc")
    t.assert_eq_str(Sha3.sha3_256_hex("abc"), "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", "sha3_256 abc")
    t.assert_eq_str(Sha3.sha3_384_hex("abc"), "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25", "sha3_384 abc")
    t.assert_eq_str(Sha3.sha3_512_hex("abc"), "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0", "sha3_512 abc")
    t.assert_eq_str(Sha3.sha3_224_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "8a24108b154ada21c9fd5574494479ba5c7e7ab76ef264ead0fcce33", "sha3_224 448-bit")
    t.assert_eq_str(Sha3.sha3_256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376", "sha3_256 448-bit")
    t.assert_eq_str(Sha3.sha3_384_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "991c665755eb3a4b6bbdfb75c78a492e8c56a22c5c4d7e429bfdbc32b9d4ad5aa04a1f076e62fea19eef51acd0657c22", "sha3_384 448-bit")
    t.assert_eq_str(Sha3.sha3_512_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "04a371e84ecfb5b8b77cb48610fca8182dd457ce6f326a0fd3d7ec2f1e91636dee691fbe0c985302ba1b0d8dc78c086346b533b49c030d99a27daf1139d6e75e", "sha3_512 448-bit")
    t.assert_eq_str(Sha3.sha3_224_hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"), "543e6868e1666c1a643630df77367ae5a62a85070a51c14cbf665cbc", "sha3_224 896-bit")
    t.assert_eq_str(Sha3.sha3_256_hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"), "916f6061fe879741ca6469b43971dfdb28b1a32dc36cb3254e812be27aad1d18", "sha3_256 896-bit")
    t.assert_eq_str(Sha3.sha3_384_hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"), "79407d3b5916b59c3e30b09822974791c313fb9ecc849e406f23592d04f625dc8c709b98b43b3852b337216179aa7fc7", "sha3_384 896-bit")
    t.assert_eq_str(Sha3.sha3_512_hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"), "afebb2ef542e6579c50cad06d2e578f9f8dd6881d7dc824d26360feebf18a4fa73e3261122948efcfd492e74e82e2189ed0fb440d187f382270cb455f21dd185", "sha3_512 896-bit")
    t.section("one million 'a'")
    mut mil = repeat_a(1000000)
    t.assert_eq_str(Sha3.sha3_256_hex(mil), "5c8875ae474a3634ba4fd55ec85bffd661f32aca75c6d699d0cdcb6c115891c1", "sha3_256 1e6 a")
    t.assert_eq_str(Sha3.sha3_512_hex(mil), "3c3a876da14034ab60627c077bb98f7e120a2a5370212dffb3385a18d4f38859ed311d0a9d5141ce9cc5c66ee689b266a8aa18ace8282a0e0db596c90b0a7b87", "sha3_512 1e6 a")
    t.section("SHAKE")
    t.assert_eq_str(Sha3.shake128_hex("", 32), "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26", "shake128 empty 32B")
    t.assert_eq_str(Sha3.shake128_hex("abc", 32), "5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8", "shake128 abc 32B")
    t.assert_eq_str(Sha3.shake256_hex("", 64), "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be", "shake256 empty 64B")
    t.assert_eq_str(Sha3.shake256_hex("abc", 64), "483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739d5a15bef186a5386c75744c0527e1faa9f8726e462a12a4feb06bd8801e751e4", "shake256 abc 64B")
    t.assert_eq_str(Sha3.shake128_hex("abc", 400), "", "shake128 abc 400B (multi-block squeeze)")
    t.assert_eq_str(Sha3.shake256_hex("abc", 300), "", "shake256 abc 300B (multi-block squeeze)")
    t.assert_eq_str(Sha3.shake128_hex("abc", 0), "", "shake zero length")
    t.section("Keccak-256/512 (original padding)")
    t.assert_eq_str(Sha3.keccak256_hex(""), "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470", "keccak256 empty")
    t.assert_eq_str(Sha3.keccak256_hex("abc"), "4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45", "keccak256 abc")
    t.assert_eq_str(Sha3.keccak512_hex(""), "0eab42de4c3ceb9235fc91acffe746b29c29a8c366b7c60e4e67c466f36a4304c00fa9caf9d87976ba469bcbe06713b435f091ef2769fb160cdab33d3670680e", "keccak512 empty")
    t.section("block-boundary lengths (pattern input)")
    mut p0 = pattern(0)
    t.assert_eq_str(Sha3.sha3_224_hex(p0), "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7", "sha3_224 len 0")
    t.assert_eq_str(Sha3.sha3_256_hex(p0), "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", "sha3_256 len 0")
    t.assert_eq_str(Sha3.sha3_384_hex(p0), "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004", "sha3_384 len 0")
    t.assert_eq_str(Sha3.sha3_512_hex(p0), "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26", "sha3_512 len 0")
    t.assert_eq_str(Sha3.shake128_hex(p0, 50), "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef263cb1eea988004b93103cfb0aeefd2a686e01", "shake128 len 0")
    t.assert_eq_str(Sha3.shake256_hex(p0, 50), "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc82", "shake256 len 0")
    mut p1 = pattern(1)
    t.assert_eq_str(Sha3.sha3_224_hex(p1), "b740a3b446920772a10caf69736eb712d7dab3b380e7c1a2def19b7a", "sha3_224 len 1")
    t.assert_eq_str(Sha3.sha3_256_hex(p1), "e3ed56bd086d8958483a12734fa0ae7f5c8bb160ef9092c67e82ed9b19e4c7b2", "sha3_256 len 1")
    t.assert_eq_str(Sha3.sha3_384_hex(p1), "80fe0aa4889193dd2b9924e34d2170835a0731de3e299e70748c3906f4f0eba35d531e61e4eb318bf8bde6fe3de9436c", "sha3_384 len 1")
    t.assert_eq_str(Sha3.sha3_512_hex(p1), "a63f9712aadceb0fe16f1881719a802294830fa1f7a0e58ff26a45a814309961c5007f43f4e224a82d3f538a6c8af7d87ec71fb6661bfac0dc0cd9367ddb04ce", "sha3_512 len 1")
    t.assert_eq_str(Sha3.shake128_hex(p1, 50), "776915233d1e79097718e09db209efa466affa24d35c78e7a1f80cf4ebb6c28b25dfeba0eb3e63446a1a78662446cccd4e6f", "shake128 len 1")
    t.assert_eq_str(Sha3.shake256_hex(p1, 50), "db4252337900d8ab7f609d170135d459a6798945d5a574d4a9db7b623c754d078fb2239762994969a1f372801817bb304f5b", "shake256 len 1")
    mut p3 = pattern(3)
    t.assert_eq_str(Sha3.sha3_224_hex(p3), "185e494b5fca8365a865a85ba889152d6f83ab8442de25b81a3f6fee", "sha3_224 len 3")
    t.assert_eq_str(Sha3.sha3_256_hex(p3), "fffadd0ae913c0947143ac7c6bf1d512c1b265db8ac52100614bd022ae2412d4", "sha3_256 len 3")
    t.assert_eq_str(Sha3.sha3_384_hex(p3), "5215a317af347b86468acf686b03dfa3dcd003736a1cbf88458725a7335bda618246a8d22ba139abd0f5b37af7192bc4", "sha3_384 len 3")
    t.assert_eq_str(Sha3.sha3_512_hex(p3), "f43b92b1b4647bb487400472178d83c784a8e4cee5a4d95e6aa4931b21cc2f7c5653fc4ce0130914c57aa8cde0516eb8e2d0015cbda1e4d4261e007b1db11411", "sha3_512 len 3")
    t.assert_eq_str(Sha3.shake128_hex(p3, 50), "cf0bd6b206ac4e35ebd4ccce5e014b95dfe78ae19e5cadcc89c725dea6998ae64b55fa061151576aae1f7a2bf6912a3ae981", "shake128 len 3")
    t.assert_eq_str(Sha3.shake256_hex(p3, 50), "43a0b197b976835b9874524272a43a8ecbf2891579772b66e9c32f767014a6d00b03c51dfb29e7799dc45dcce3b7bbf5e0bb", "shake256 len 3")
    mut p55 = pattern(55)
    t.assert_eq_str(Sha3.sha3_224_hex(p55), "35f01d634075939445ee073170ac19eca17ee5d92746afa3aaaf0585", "sha3_224 len 55")
    t.assert_eq_str(Sha3.sha3_256_hex(p55), "7b08ced19b17fcd5e225b1a8b489387e122c18d2d31a5f70325310ca210c7cfa", "sha3_256 len 55")
    t.assert_eq_str(Sha3.sha3_384_hex(p55), "81fff3492217fc76c2fbaa623250712b2df6af73ea84b84177e1a0b828b2af80eb73bbb321380f00cff46cab86cfe06f", "sha3_384 len 55")
    t.assert_eq_str(Sha3.sha3_512_hex(p55), "e0fb9f904a8d3533ed3ae0c035552c204dc0a71656b9279b7cd1ffa9f3d3ce9d3d2435eedf1255174d4e5ffd75bd2793e4cbcdfb970fad0eaae144d90c51d680", "sha3_512 len 55")
    t.assert_eq_str(Sha3.shake128_hex(p55, 50), "b9bfe421760b7e5eb3739b87f5fe1e9a75d815bc90eefc63f18399a7274157372b8ad6ac3acee8ef70be64106282de549b74", "shake128 len 55")
    t.assert_eq_str(Sha3.shake256_hex(p55, 50), "5d220126b7f1650a93414232eb4c66d05ace4568b7940f5af130ba997dacbd841e842e9622c664b48333c25115cd76d542a0", "shake256 len 55")
    mut p56 = pattern(56)
    t.assert_eq_str(Sha3.sha3_224_hex(p56), "676779a38b85088a8b8adbb184039f9267aba25f27c0ff5b1778c371", "sha3_224 len 56")
    t.assert_eq_str(Sha3.sha3_256_hex(p56), "e72d9fadd664156719a0861a4b0786cbf80ac2638bd4e6dd0b473876c78a78f7", "sha3_256 len 56")
    t.assert_eq_str(Sha3.sha3_384_hex(p56), "1dd96d1e434fdde6b3d38624f16ea3395243113ed4f4ebeafadf1210c88112149dddfb46bf1fa19418cf0ea391522892", "sha3_384 len 56")
    t.assert_eq_str(Sha3.sha3_512_hex(p56), "585ee6b4ae1195ea09e07b15809e69a7fefcd9b8f28bf78b2eefcb4353e6285020777cc12a341af5735af617192553750088d7383af14c229f8487f3ef84e187", "sha3_512 len 56")
    t.assert_eq_str(Sha3.shake128_hex(p56, 50), "1f7cc12a0b8221edf01fa93b30d6cab65b65517af432e935d182e623a95405d191e755fe3d6d77486c104253f29553c9d171", "shake128 len 56")
    t.assert_eq_str(Sha3.shake256_hex(p56, 50), "7004d340bf495a0125b014ec46382c1853530e1dbec689f4e763d80dbd99c265dd173be01c9d6187b0e066f967aa6bbe29a8", "shake256 len 56")
    mut p64 = pattern(64)
    t.assert_eq_str(Sha3.sha3_224_hex(p64), "3d1c96b68a5312984a03e3614c45086a4dee65ca6f3a6d5a177af1c7", "sha3_224 len 64")
    t.assert_eq_str(Sha3.sha3_256_hex(p64), "85c576bd8097a119432293d7b09da76d336aff9acda1c0708cf03bdd999911cd", "sha3_256 len 64")
    t.assert_eq_str(Sha3.sha3_384_hex(p64), "b9240ffef3debbe9b930f9f67210ffa0fb33f620fc715ab56845d1b212473d9388709ad46d68afbf1b21a6ef252a2732", "sha3_384 len 64")
    t.assert_eq_str(Sha3.sha3_512_hex(p64), "f37322220063c7eb72c37e9ede7eaa19d20836e3144d7fa26847d2b2234232b942999eadb626ca668d5d9063f353ddc9460186de2e5b0041d9367e6880068ee0", "sha3_512 len 64")
    t.assert_eq_str(Sha3.shake128_hex(p64, 50), "aa2321c769c28f622b98207b45e350fb6a5dbf1816d35e458a1bfd2f8ebe29538016c9e48088ebd67518a21a29a6a658557d", "shake128 len 64")
    t.assert_eq_str(Sha3.shake256_hex(p64, 50), "10ce3270372d08023de3a8fadb26b5e44cad32d568cf7bfcc9179b365bf6e7a9290f49ece47510113a77a798e7f507362b6c", "shake256 len 64")
    mut p71 = pattern(71)
    t.assert_eq_str(Sha3.sha3_224_hex(p71), "a3e5308e10d6ee809f8536760bbf52469dab5169eb2a7b8ab4d0a63b", "sha3_224 len 71")
    t.assert_eq_str(Sha3.sha3_256_hex(p71), "254f2ac1df8eae4233c0c2fe74a03331b856518800936943cdbe57d7d224f224", "sha3_256 len 71")
    t.assert_eq_str(Sha3.sha3_384_hex(p71), "3d3fc62c8617f0400959372bad3c9a7037180a41030fdb222155f4cac81358d8c981b15673461d000f9c714492c7c3bd", "sha3_384 len 71")
    t.assert_eq_str(Sha3.sha3_512_hex(p71), "a02d5795bffd44cb0ac3cc3401ae89056b8017242eaf7e802033e974672ce7945811760c3b0d9578bc51bf90c364636ac87cda9b4f3e45620ea9c030421e9d86", "sha3_512 len 71")
    t.assert_eq_str(Sha3.shake128_hex(p71, 50), "4a7cb3f7fb0004e031fb6317d81da96993227b8e514f19a7e037e7541e5b15112a75a51c337e1143b2fb3273bbdc2ea68629", "shake128 len 71")
    t.assert_eq_str(Sha3.shake256_hex(p71, 50), "c5492c4e150f073fa316ab32f6752abf52914ee2a4207f09e35586b7205948df80ce444e94a78fb65907e0a741c2b1a6d1ab", "shake256 len 71")
    mut p72 = pattern(72)
    t.assert_eq_str(Sha3.sha3_224_hex(p72), "a84dd5afcf2cadf543c08edeb1b8ca9f2a39a32a84009cde3110aaaf", "sha3_224 len 72")
    t.assert_eq_str(Sha3.sha3_256_hex(p72), "f4bb95e698a2c13bd27f089f3762076daa40b629dc5d7ec53dbe163fca4a4bf3", "sha3_256 len 72")
    t.assert_eq_str(Sha3.sha3_384_hex(p72), "9dbaa8e9380eb37b56147db9c374d4b67845756731aaafa31d6637715e32d7a5405d1b51cabe0df44b6a847476684999", "sha3_384 len 72")
    t.assert_eq_str(Sha3.sha3_512_hex(p72), "2ec0da5ff440c192d33033c4257eb39dcbd27edd7e41b5ac8db9daf13db501a2ef938151aaddd82f600335654f77512cbcc926ec5abb05b79282ec716d685618", "sha3_512 len 72")
    t.assert_eq_str(Sha3.shake128_hex(p72, 50), "4bbb1d27936a26de9c41ef1a7014be106ab9ad8f10dd68e8d693d00dbdb89f2b0b68b058fc5ff5b5cf1dd3ddb3e77bbebbca", "shake128 len 72")
    t.assert_eq_str(Sha3.shake256_hex(p72, 50), "f4771493e402a8aa4fc0251ee80b3f142481417b3dd942dcf72d96e26f75ad6a08db744812ddc576111fe99dc5bda94fa058", "shake256 len 72")
    mut p73 = pattern(73)
    t.assert_eq_str(Sha3.sha3_224_hex(p73), "672493b75a3310746e5afbfbcddc05454ed6b4be530b62f35ee2ca53", "sha3_224 len 73")
    t.assert_eq_str(Sha3.sha3_256_hex(p73), "c610c3522f9423c2c706b1e26e532b121b67eb06c897d478ac6bb80ddbc8ae1f", "sha3_256 len 73")
    t.assert_eq_str(Sha3.sha3_384_hex(p73), "f155926106b264866c4a8ef41786610fe04efae9878e26a7a058aeba1ffe4e7b16ee6c8c6f26d5d4b9a490cf1e285c8e", "sha3_384 len 73")
    t.assert_eq_str(Sha3.sha3_512_hex(p73), "d26d1f9fc91b1d6c31405cc4a546f246fa7777f698d956c26a15170bccdd696aab3ee2e0597ee6f33bc7ac0336b1e4bfa0cc4355ab9faf8111cf27312640fd65", "sha3_512 len 73")
    t.assert_eq_str(Sha3.shake128_hex(p73, 50), "d639407b276ee21fdcefe0e178d35b4901e19a0283879943e085d3a05c38f7575320f2341242d16712ffa209a8c637dd0ff1", "shake128 len 73")
    t.assert_eq_str(Sha3.shake256_hex(p73, 50), "8bae34cf4fcbba9c49fd2245431d94598e5596243104c0ec61ea3000cec0720882b8072183b1e65b2222cddca59757eabc63", "shake256 len 73")
    mut p103 = pattern(103)
    t.assert_eq_str(Sha3.sha3_224_hex(p103), "5ce32ebca716936296d5883903d9736a8f7c8ee28751cbc7cbca2668", "sha3_224 len 103")
