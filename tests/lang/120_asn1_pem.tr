# tests/lang/120_asn1_pem.tr
# std.crypto.bn (big-number arithmetic vs. Python reference values), std.crypto.pkutil
# (Bytes / digests / HMAC), std.encoding.asn1 (DER encode/decode, OIDs, times) and
# std.encoding.pem (armor, bundles, error handling).

from std.test import TestRunner
from std.core.vec import Vec
from std.crypto.pkutil import Bytes, PkHash
from std.crypto.bn import bn_from_hex, bn_to_hex, bn_add, bn_sub, bn_mul, bn_divmod, bn_shl, bn_shr, bn_modexp, bn_cmp, bn_bit_len, bn_from_bytes, bn_to_bytes, bn_is_zero, bn_from_int, Mont, BnDivMod
from std.encoding.asn1 import Der, DerNode, DerReader, Oid
from std.encoding.pem import Pem, PemBlock

def hx(s: str) -> Vec[int]:
    return Bytes.from_hex(s)

def check(t: TestRunner, a: str, b: str, m: str, s: int, sum_: str, absdiff: str, prod: str, quo: str, rem: str, shl: str, shr: str, mexp: str):
    mut x = bn_from_hex(a)
    mut y = bn_from_hex(b)
    t.assert_eq_str(bn_to_hex(bn_add(x, y)), sum_, f"add {a}")
    if bn_cmp(x, y) >= 0:
        t.assert_eq_str(bn_to_hex(bn_sub(x, y)), absdiff, f"sub {a}")
    else:
        t.assert_eq_str(bn_to_hex(bn_sub(y, x)), absdiff, f"sub(rev) {a}")
    t.assert_eq_str(bn_to_hex(bn_mul(x, y)), prod, f"mul {a}")
    mut qr = bn_divmod(x, y)
    t.assert_eq_str(bn_to_hex(qr.q), quo, f"div {a}")
    t.assert_eq_str(bn_to_hex(qr.r), rem, f"mod {a}")
    t.assert_eq_str(bn_to_hex(bn_shl(x, s)), shl, f"shl {a}")
    t.assert_eq_str(bn_to_hex(bn_shr(x, s)), shr, f"shr {a}")
    t.assert_eq_str(bn_to_hex(bn_modexp(x, y, bn_from_hex(m))), mexp, f"modexp {a}")

