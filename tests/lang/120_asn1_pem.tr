    check(t, "0fffffff", "0fffbfff", "0fffffff", 9, "1fffbffe", "4000", "fffbffe0004001", "01", "4000", "1ffffffe00", "07ffff", "00")
    check(t, "10000000", "0fffffff", "10000001", 1, "1fffffff", "01", "fffffff0000000", "01", "01", "20000000", "08000000", "10000000")
    check(t, "ffffffe0000001", "0fffffff", "1fffffff", 27, "fffffff0000000", "ffffffd0000002", "0ffffffd0000002fffffff", "0fffffff", "00", "07ffffff00000008000000", "1ffffffc", "01")
    check(t, "ffffffffffffff", "ffffffefffffff", "ffffffffffffff", 18, "01ffffffeffffffe", "10000000", "ffffffeffffffe00000010000001", "01", "10000000", "03fffffffffffffc0000", "3fffffffff", "00")
    check(t, "0100000000000000", "ffffffffffffff", "0100000000000001", 1, "01ffffffffffffff", "01", "ffffffffffffff00000000000000", "01", "01", "0200000000000000", "80000000000000", "0100000000000000")
    check(t, "fffffffffffffe00000000000001", "ffffffffffffff", "01ffffffffffffff", 27, "ffffffffffffff00000000000000", "fffffffffffffd00000000000002", "fffffffffffffd00000000000002ffffffffffffff", "ffffffffffffff", "00", "07fffffffffffff000000000000008000000", "1fffffffffffffc0000000", "08000000000000")
    check(t, "0fffffffffffffffffffff", "0ffffffffffbffffffffff", "0fffffffffffffffffffff", 28, "1ffffffffffbfffffffffe", "040000000000", "ffffffffffbfffffffffe000000000040000000001", "01", "040000000000", "fffffffffffffffffffff0000000", "ffffffffffffff", "00")
    check(t, "1000000000000000000000", "0fffffffffffffffffffff", "1000000000000000000001", 1, "1fffffffffffffffffffff", "01", "fffffffffffffffffffff000000000000000000000", "01", "01", "2000000000000000000000", "0800000000000000000000", "1000000000000000000000")
