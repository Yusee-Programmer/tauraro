# tests/lang/137_qr_color.tr
# std.image.qr (QR Code encoder) and std.color (colour spaces, CSS parsing,
# mixing, WCAG contrast, delta E). Colour expectations come from an
# independent Python implementation (colorsys, Lindbloom matrices, Ottosson's
# OKLab) and the CIEDE2000 values are Sharma, Wu and Dalal's published test
# data (all 34 pairs). QR matrices were verified by decoding them with
# zxing-cpp (every version 1-40 at all four error-correction levels) and the
# data/EC codewords of the ISO 18004 "01234567" example are checked below.

from std.test import TestRunner
from std.color import Color, SPACE_SRGB, SPACE_LINEAR, SPACE_HSL, SPACE_HSV, SPACE_HWB, SPACE_LAB, SPACE_LCH, SPACE_OKLAB, SPACE_OKLCH, SPACE_XYZ
from std.color import delta_e76_lab, delta_e94_lab, delta_e2000_lab
from std.image.qr import QrCode, QR_ECC_L, QR_ECC_M, QR_ECC_Q, QR_ECC_H, QR_MODE_NUMERIC, QR_MODE_ALNUM, QR_MODE_BYTE
from std.image.mod import Image
from std.encoding.pdf import PdfDocument

def parse(s: str) -> Color:
    mut r: Result[Color, str] = Color.parse(s)
    if r.is_err:
        print("parse failed: " + s + ": " + r.err)
        return Color.black()
    return r.ok

def near(t: TestRunner, got: float, want: float, eps: float, msg: str):
    t.assert_eq_float(got, want, eps, msg)

def check3(t: TestRunner, got: (float, float, float), a: float, b: float, c: float, eps: float, msg: str):
    mut g0, g1, g2 = got
    near(t, g0, a, eps, msg + " [0]")
    near(t, g1, b, eps, msg + " [1]")
    near(t, g2, c, eps, msg + " [2]")

def fnv_qr(q: QrCode) -> int:
    mut h = 2166136261
    mut i = 0
    while i < q.size * q.size:
        h = h ^ (q.modules.get(i) as int + 1)
        h = (h * 16777619) & 0xFFFFFFFF
        i = i + 1
    return h

def test_conversions(t: TestRunner):
    t.section("colour space conversions")
    mut c = Color.black()

    c = parse("#3366cc")
    check3(t, c.to_hsl(), 220.000000, 0.600000, 0.500000, 0.0005, "#3366cc hsl")
    check3(t, c.to_hsv(), 220.000000, 0.750000, 0.800000, 0.0005, "#3366cc hsv")
    check3(t, c.to_hwb(), 220.000000, 0.200000, 0.200000, 0.0005, "#3366cc hwb")
    check3(t, c.to_xyz(), 0.170118, 0.145643, 0.590296, 0.001, "#3366cc xyz")
    check3(t, c.to_lab(), 45.03154, 18.71110, -57.85296, 0.02, "#3366cc lab")
    check3(t, c.to_lch(), 45.03154, 60.80353, 287.9225, 0.03, "#3366cc lch")
    check3(t, c.to_oklab(), 0.532483, -0.022512, -0.166349, 0.0005, "#3366cc oklab")
    check3(t, c.to_oklch(), 0.532483, 0.167866, 262.2930, 0.01, "#3366cc oklch")
    c = parse("#ff8800")
    check3(t, c.to_hsl(), 32.000000, 1.000000, 0.500000, 0.0005, "#ff8800 hsl")
    check3(t, c.to_hsv(), 32.000000, 1.000000, 1.000000, 0.0005, "#ff8800 hsv")
    check3(t, c.to_hwb(), 32.000000, 0.000000, 0.000000, 0.0005, "#ff8800 hwb")
    check3(t, c.to_xyz(), 0.500492, 0.388744, 0.048679, 0.001, "#ff8800 xyz")
    check3(t, c.to_lab(), 68.66021, 38.84498, 74.98235, 0.02, "#ff8800 lab")
    check3(t, c.to_lch(), 68.66021, 84.44694, 62.6134, 0.03, "#ff8800 lch")
    check3(t, c.to_oklab(), 0.744202, 0.100104, 0.151003, 0.0005, "#ff8800 oklab")
    check3(t, c.to_oklch(), 0.744202, 0.181171, 56.4585, 0.01, "#ff8800 oklch")
    c = parse("#10a020")
    check3(t, c.to_hsl(), 126.666667, 0.818182, 0.345098, 0.0005, "#10a020 hsl")
    check3(t, c.to_hsv(), 126.666667, 0.900000, 0.627451, 0.0005, "#10a020 hsv")
    check3(t, c.to_hwb(), 126.666667, 0.062745, 0.372549, 0.0005, "#10a020 hwb")
    check3(t, c.to_xyz(), 0.130443, 0.253544, 0.055726, 0.001, "#10a020 xyz")
    check3(t, c.to_lab(), 57.41908, -58.55397, 52.32898, 0.02, "#10a020 lab")
    check3(t, c.to_lch(), 57.41908, 78.52954, 138.2132, 0.03, "#10a020 lch")
    check3(t, c.to_oklab(), 0.613860, -0.158366, 0.116877, 0.0005, "#10a020 oklab")
    check3(t, c.to_oklch(), 0.613860, 0.196825, 143.5721, 0.01, "#10a020 oklch")
    c = parse("#ffffff")
    check3(t, c.to_hsl(), 0.000000, 0.000000, 1.000000, 0.0005, "#ffffff hsl")
    check3(t, c.to_hsv(), 0.000000, 0.000000, 1.000000, 0.0005, "#ffffff hsv")
    check3(t, c.to_hwb(), 0.000000, 1.000000, 0.000000, 0.0005, "#ffffff hwb")
    check3(t, c.to_xyz(), 0.950470, 1.000000, 1.088830, 0.001, "#ffffff xyz")
    check3(t, c.to_lab(), 100.00000, -0.00002, 0.00001, 0.02, "#ffffff lab")
    check3(t, c.to_oklab(), 1.000000, 0.000000, 0.000000, 0.0005, "#ffffff oklab")
    c = parse("#000000")
    check3(t, c.to_hsl(), 0.000000, 0.000000, 0.000000, 0.0005, "#000000 hsl")
    check3(t, c.to_hsv(), 0.000000, 0.000000, 0.000000, 0.0005, "#000000 hsv")
    check3(t, c.to_hwb(), 0.000000, 0.000000, 1.000000, 0.0005, "#000000 hwb")
    check3(t, c.to_xyz(), 0.000000, 0.000000, 0.000000, 0.001, "#000000 xyz")
    check3(t, c.to_lab(), 0.00000, 0.00000, 0.00000, 0.02, "#000000 lab")
    check3(t, c.to_oklab(), 0.000000, 0.000000, 0.000000, 0.0005, "#000000 oklab")
    c = parse("#808080")
    check3(t, c.to_hsl(), 0.000000, 0.000000, 0.501961, 0.0005, "#808080 hsl")
    check3(t, c.to_hsv(), 0.000000, 0.000000, 0.501961, 0.0005, "#808080 hsv")
    check3(t, c.to_hwb(), 0.000000, 0.501961, 0.498039, 0.0005, "#808080 hwb")
    check3(t, c.to_xyz(), 0.205169, 0.215861, 0.235035, 0.001, "#808080 xyz")
    check3(t, c.to_lab(), 53.58502, -0.00001, 0.00000, 0.02, "#808080 lab")
    check3(t, c.to_oklab(), 0.599871, 0.000000, 0.000000, 0.0005, "#808080 oklab")
    c = parse("#c0ffee")
    check3(t, c.to_hsl(), 163.809524, 1.000000, 0.876471, 0.0005, "#c0ffee hsl")
    check3(t, c.to_hsv(), 163.809524, 0.247059, 1.000000, 0.0005, "#c0ffee hsv")
    check3(t, c.to_hwb(), 163.809524, 0.752941, 0.000000, 0.0005, "#c0ffee hwb")
    check3(t, c.to_xyz(), 0.729261, 0.888964, 0.941886, 0.001, "#c0ffee xyz")
    check3(t, c.to_lab(), 95.53712, -23.02421, 1.74055, 0.02, "#c0ffee lab")
    check3(t, c.to_lch(), 95.53712, 23.08990, 175.6769, 0.03, "#c0ffee lch")
    check3(t, c.to_oklab(), 0.953016, -0.066976, 0.004264, 0.0005, "#c0ffee oklab")
    check3(t, c.to_oklch(), 0.953016, 0.067111, 176.3570, 0.01, "#c0ffee oklch")
    c = parse("#ff0000")
    check3(t, c.to_hsl(), 0.000000, 1.000000, 0.500000, 0.0005, "#ff0000 hsl")
    check3(t, c.to_hsv(), 0.000000, 1.000000, 1.000000, 0.0005, "#ff0000 hsv")
    check3(t, c.to_hwb(), 0.000000, 0.000000, 0.000000, 0.0005, "#ff0000 hwb")
    check3(t, c.to_xyz(), 0.412456, 0.212673, 0.019334, 0.001, "#ff0000 xyz")
    check3(t, c.to_lab(), 53.24079, 80.09246, 67.20320, 0.02, "#ff0000 lab")
    check3(t, c.to_lch(), 53.24079, 104.55177, 39.9990, 0.03, "#ff0000 lch")
    check3(t, c.to_oklab(), 0.627955, 0.224863, 0.125846, 0.0005, "#ff0000 oklab")
    check3(t, c.to_oklch(), 0.627955, 0.257683, 29.2339, 0.01, "#ff0000 oklch")
    c = parse("#7f00ff")
    check3(t, c.to_hsl(), 269.882353, 1.000000, 0.500000, 0.0005, "#7f00ff hsl")
    check3(t, c.to_hsv(), 269.882353, 1.000000, 1.000000, 0.0005, "#7f00ff hsv")
    check3(t, c.to_hwb(), 269.882353, 0.000000, 0.000000, 0.0005, "#7f00ff hwb")
    check3(t, c.to_xyz(), 0.267973, 0.117311, 0.954407, 0.001, "#7f00ff xyz")
    check3(t, c.to_lab(), 40.78547, 83.09454, -93.49958, 0.02, "#7f00ff lab")
    check3(t, c.to_lch(), 40.78547, 125.08747, 311.6280, 0.03, "#7f00ff lch")
    check3(t, c.to_oklab(), 0.529356, 0.117381, -0.268542, 0.0005, "#7f00ff oklab")
    check3(t, c.to_oklch(), 0.529356, 0.293075, 293.6103, 0.01, "#7f00ff oklch")

    # published values for sRGB red: Lab(D65) 53.2408 80.0925 67.2032, OKLab 0.62796 0.22486 0.12585
    c = parse("red")
    check3(t, c.to_lab(), 53.2408, 80.0925, 67.2032, 0.01, "red lab D65")
    check3(t, c.to_oklab(), 0.627955, 0.224863, 0.125846, 0.0001, "red oklab")
    check3(t, c.to_lab_d50(), 54.2905, 80.8049, 69.8910, 0.01, "red lab D50 (CSS lab)")

    # every space round-trips
    mut spaces: List[int] = [SPACE_LINEAR, SPACE_HSL, SPACE_HSV, SPACE_HWB, SPACE_LAB, SPACE_LCH, SPACE_OKLAB, SPACE_OKLCH, SPACE_XYZ]
    mut seed = 12345
    mut bad = 0
    mut n = 0
    while n < 120:
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        mut r8 = (seed >> 8) % 256
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        mut g8 = (seed >> 8) % 256
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        mut b8 = (seed >> 8) % 256
        mut src = Color.rgb8(r8, g8, b8)
        mut k = 0
        while k < spaces.len():
            mut x, y, z = src.to_space(spaces[k])
            mut back = Color.from_space(spaces[k], x, y, z, 1.0)
            if back.r8() != r8 or back.g8() != g8 or back.b8() != b8: bad = bad + 1
            k = k + 1
        n = n + 1
    t.assert_eq_int(bad, 0, "120 random colours round-trip through 9 spaces")

    # D50 Lab/LCH round trip
    mut e = parse("#c0ffee")
    mut dl, da, db = e.to_lab_d50()
    mut e2 = Color.lab_d50(dl, da, db, 1.0)
    t.assert_eq_str(e2.to_hex(), "#c0ffee", "lab d50 round trip")
    mut ol, oc, oh = e.to_oklch()
    t.assert_eq_str(Color.oklch(ol, oc, oh, 1.0).to_hex(), "#c0ffee", "oklch round trip")

def test_text(t: TestRunner):
    t.section("hex, names and CSS parsing")
    t.assert_eq_str(parse("#fff").to_hex(), "#ffffff", "#rgb")
    t.assert_eq_str(parse("#3366CC").to_hex(), "#3366cc", "uppercase hex")
    t.assert_eq_str(parse("#1234").to_hex_alpha(), "#11223344", "#rgba")
    t.assert_eq_str(parse("#12345678").to_hex_alpha(), "#12345678", "#rrggbbaa")
    t.assert_eq_str(parse("336699").to_hex(), "#336699", "no leading #")
    t.assert_eq_str(parse("#3366cc").to_hex_short(), "#36c", "short form when nibbles repeat")
    t.assert_eq_str(parse("#336698").to_hex_short(), "#336698", "short form unchanged otherwise")
    t.assert_eq_str(parse("#ff0000").to_hex_short(), "#f00", "short form")
    mut bad: Result[Color, str] = Color.parse("#12")
    t.assert_true(bad.is_err, "bad hex length rejected")
    bad = Color.parse("#12345g")
    t.assert_true(bad.is_err, "bad hex digit rejected")
    bad = Color.parse("nosuchcolor")
    t.assert_true(bad.is_err, "unknown name rejected")
    bad = Color.parse("rgb(1 2)")
    t.assert_true(bad.is_err, "too few args rejected")
    bad = Color.parse("blorp(1 2 3)")
    t.assert_true(bad.is_err, "unknown function rejected")
    t.assert_eq_str(parse("rebeccapurple").to_hex(), "#663399", "rebeccapurple")
    t.assert_eq_str(parse("  AliceBlue ").to_hex(), "#f0f8ff", "case and whitespace")
    t.assert_eq_str(parse("lightgoldenrodyellow").to_hex(), "#fafad2", "long name")
    t.assert_eq_str(parse("transparent").to_hex_alpha(), "#00000000", "transparent")
    t.assert_eq_str(parse("rgb(255, 128, 0)").to_hex(), "#ff8000", "rgb legacy commas")
    t.assert_eq_str(parse("rgb(100% 50% 0%)").to_hex(), "#ff8000", "rgb percentages")
    t.assert_eq_str(parse("rgba(0, 0, 255, 0.5)").to_hex_alpha(), "#0000ff80", "rgba")
    t.assert_eq_str(parse("rgb(0 255 0 / 25%)").to_hex_alpha(), "#00ff0040", "rgb slash alpha")
    t.assert_eq_str(parse("hsl(120 100% 50%)").to_hex(), "#00ff00", "hsl")
    t.assert_eq_str(parse("hsl(240deg, 100%, 50%)").to_hex(), "#0000ff", "hsl deg")
    t.assert_eq_str(parse("hsla(0, 100%, 50%, 0.2)").to_hex_alpha(), "#ff000033", "hsla")
    t.assert_eq_str(parse("hsl(0.5turn 100% 50%)").to_hex(), "#00ffff", "hsl turn")
    t.assert_eq_str(parse("hwb(0 0% 0%)").to_hex(), "#ff0000", "hwb red")
    t.assert_eq_str(parse("hwb(200 100% 0%)").to_hex(), "#ffffff", "hwb white")
    t.assert_eq_str(parse("hwb(90 30% 40%)").to_hex(), "#73994d", "hwb mixed")
    t.assert_eq_str(parse("lab(54.2905% 80.8049 69.891)").to_hex(), "#ff0000", "css lab (D50) red")
    t.assert_eq_str(parse("lch(54.2905 106.8372 40.8577)").to_hex(), "#ff0000", "css lch (D50) red")
    t.assert_eq_str(parse("oklab(62.7955% 0.224863 0.125846)").to_hex(), "#ff0000", "oklab red")
    t.assert_eq_str(parse("oklch(0.627955 0.257683 29.2339)").to_hex(), "#ff0000", "oklch red")
    t.assert_eq_str(parse("oklch(70% 0.15 200 / 0.5)").to_hex_alpha(), "#00b9c380", "oklch with alpha")
    t.assert_eq_str(parse("color(srgb 1 0.5 0)").to_hex(), "#ff8000", "color(srgb)")
    t.assert_eq_str(parse("color(srgb-linear 1 0 0)").to_hex(), "#ff0000", "color(srgb-linear)")
    t.assert_eq_str(parse("color(xyz 0.41239 0.21264 0.01933)").to_hex(), "#ff0000", "color(xyz)")
    t.assert_eq_str(parse("rgb(1e2 0 0)").to_hex(), "#640000", "exponent number")
    t.assert_eq_str(parse("rgb(none 0 0)").to_hex(), "#000000", "none keyword")
    t.assert_eq_str(parse("#3366cc").to_css(), "rgb(51 102 204)", "to_css")
    t.assert_eq_str(parse("rgba(0, 0, 255, 0.5)").to_css(), "rgb(0 0 255 / 0.5)", "to_css alpha")
    t.assert_eq_str(parse("hsl(120 100% 50%)").to_css_hsl(), "hsl(120 100% 50%)", "to_css_hsl")
    t.assert_eq_str(parse("#ff0000").to_css_oklch(), "oklch(62.8% 0.2577 29.23)", "to_css_oklch")
    t.assert_eq_int(parse("#80402010").to_argb32(), 0x10804020, "argb32")
    t.assert_eq_str(Color.from_argb32(0x10804020).to_hex_alpha(), "#80402010", "from_argb32")
    mut rt = parse(parse("#3366cc").to_css_oklch())
    t.assert_true(rt.equals(parse("#3366cc"), 0.003), "oklch text round trip")
    mut rl = parse(parse("#3366cc").to_css_lab())
    t.assert_true(rl.equals(parse("#3366cc"), 0.003), "lab text round trip")

def test_mix(t: TestRunner):
    t.section("mixing, compositing, contrast")
    mut red = parse("#ff0000")
    mut blue = parse("#0000ff")
    mut m = red.mix(blue, 0.5, SPACE_SRGB)
    near(t, m.r, 0.5, 0.0001, "srgb mix r")
    near(t, m.b, 0.5, 0.0001, "srgb mix b")
    t.assert_eq_str(red.mix(blue, 0.5, SPACE_LINEAR).to_hex(), "#bc00bc", "linear-light mix")
    t.assert_eq_str(red.mix(blue, 0.0, SPACE_OKLCH).to_hex(), "#ff0000", "t = 0 gives self")
    t.assert_eq_str(red.mix(blue, 1.0, SPACE_LAB).to_hex(), "#0000ff", "t = 1 gives other")
    t.assert_eq_str(parse("hsl(350 100% 50%)").mix(parse("hsl(10 100% 50%)"), 0.5, SPACE_HSL).to_hex(), "#ff0000", "hue takes the short way round")
    mut hx, hy, hz = parse("hsl(350 100% 50%)").mix(parse("hsl(10 100% 50%)"), 0.25, SPACE_HSL).to_hsl()
    near(t, hx, 355.0, 0.001, "hue 350 -> 10 at 25 percent")
    mut gray = parse("#808080")
    mut mh, mc, ml = parse("#808080").mix(parse("hsl(120 100% 50%)"), 0.5, SPACE_HSL).to_hsl()
    near(t, mh, 120.0, 0.001, "achromatic colour borrows the other hue")
    t.assert_eq_str(red.mix(blue, 0.5, SPACE_OKLAB).to_hex(), "#8c53a2", "oklab mix")
    mut tr = Color.rgba(1.0, 0.0, 0.0, 1.0).mix(Color.rgba(0.0, 0.0, 1.0, 0.0), 0.5, SPACE_SRGB)
    near(t, tr.a, 0.5, 0.0001, "alpha interpolates")
    near(t, tr.r, 1.0, 0.0001, "premultiplied: transparent colour has no pull")
    near(t, tr.b, 0.0, 0.0001, "premultiplied blue")
    mut over = Color.rgba(1.0, 0.0, 0.0, 0.5).over(Color.white())
    t.assert_eq_str(over.to_hex_alpha(), "#ff8080ff", "50% red over white")
    mut ol = Color.rgba(1.0, 0.0, 0.0, 0.5).over_linear(Color.white())
    t.assert_eq_str(ol.to_hex(), "#ffbcbc", "over in linear light")
    mut two = Color.rgba(1.0, 0.0, 0.0, 0.5).over(Color.rgba(0.0, 0.0, 1.0, 0.5))
    near(t, two.a, 0.75, 0.0001, "composite alpha")
    near(t, two.r, 2.0 / 3.0, 0.0001, "composite colour")
    near(t, Color.black().contrast_ratio(Color.white()), 21.0, 0.0001, "black on white")
    near(t, parse("#777777").contrast_ratio(Color.white()), 4.4781, 0.001, "#777 on white")
    near(t, parse("#767676").contrast_ratio(Color.white()), 4.5422, 0.001, "#767676 on white")
    near(t, Color.white().contrast_ratio(Color.white()), 1.0, 0.0001, "same colour")
    t.assert_eq_str(parse("#767676").wcag_level(Color.white()), "AA", "wcag AA")
    t.assert_eq_str(Color.black().wcag_level(Color.white()), "AAA", "wcag AAA")
    t.assert_eq_str(parse("#999999").wcag_level(Color.white()), "Fail", "wcag fail")
    t.assert_eq_str(parse("#888888").wcag_level(Color.white()), "AA Large", "wcag AA large")
    t.assert_eq_str(parse("#222222").readable_text().to_hex(), "#ffffff", "readable text on dark")
    t.assert_eq_str(parse("#eeeeaa").readable_text().to_hex(), "#000000", "readable text on light")
    near(t, Color.white().luminance(), 1.0, 0.0001, "luminance white")
    near(t, parse("#ff0000").luminance(), 0.2126, 0.0001, "luminance red")

def test_delta_e(t: TestRunner):
    t.section("delta E")
    mut z = 0

    near(t, delta_e2000_lab(50.0, 2.6772, -79.7751, 50.0, 0.0, -82.7485), 2.0425, 0.00006, "CIEDE2000 Sharma pair 1")
    near(t, delta_e2000_lab(50.0, 3.1571, -77.2803, 50.0, 0.0, -82.7485), 2.8615, 0.00006, "CIEDE2000 Sharma pair 2")
    near(t, delta_e2000_lab(50.0, 2.8361, -74.02, 50.0, 0.0, -82.7485), 3.4412, 0.00006, "CIEDE2000 Sharma pair 3")
    near(t, delta_e2000_lab(50.0, -1.3802, -84.2814, 50.0, 0.0, -82.7485), 1.0, 0.00006, "CIEDE2000 Sharma pair 4")
    near(t, delta_e2000_lab(50.0, -1.1848, -84.8006, 50.0, 0.0, -82.7485), 1.0, 0.00006, "CIEDE2000 Sharma pair 5")
    near(t, delta_e2000_lab(50.0, -0.9009, -85.5211, 50.0, 0.0, -82.7485), 1.0, 0.00006, "CIEDE2000 Sharma pair 6")
    near(t, delta_e2000_lab(50.0, 0.0, 0.0, 50.0, -1.0, 2.0), 2.3669, 0.00006, "CIEDE2000 Sharma pair 7")
    near(t, delta_e2000_lab(50.0, -1.0, 2.0, 50.0, 0.0, 0.0), 2.3669, 0.00006, "CIEDE2000 Sharma pair 8")
    near(t, delta_e2000_lab(50.0, 2.49, -0.001, 50.0, -2.49, 0.0009), 7.1792, 0.00006, "CIEDE2000 Sharma pair 9")
    near(t, delta_e2000_lab(50.0, 2.49, -0.001, 50.0, -2.49, 0.001), 7.1792, 0.00006, "CIEDE2000 Sharma pair 10")
    near(t, delta_e2000_lab(50.0, 2.49, -0.001, 50.0, -2.49, 0.0011), 7.2195, 0.00006, "CIEDE2000 Sharma pair 11")
    near(t, delta_e2000_lab(50.0, 2.49, -0.001, 50.0, -2.49, 0.0012), 7.2195, 0.00006, "CIEDE2000 Sharma pair 12")
    near(t, delta_e2000_lab(50.0, -0.001, 2.49, 50.0, 0.0009, -2.49), 4.8045, 0.00006, "CIEDE2000 Sharma pair 13")
    near(t, delta_e2000_lab(50.0, -0.001, 2.49, 50.0, 0.001, -2.49), 4.8045, 0.00006, "CIEDE2000 Sharma pair 14")
    near(t, delta_e2000_lab(50.0, -0.001, 2.49, 50.0, 0.0011, -2.49), 4.7461, 0.00006, "CIEDE2000 Sharma pair 15")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 50.0, 0.0, -2.5), 4.3065, 0.00006, "CIEDE2000 Sharma pair 16")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 73.0, 25.0, -18.0), 27.1492, 0.00006, "CIEDE2000 Sharma pair 17")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 61.0, -5.0, 29.0), 22.8977, 0.00006, "CIEDE2000 Sharma pair 18")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 56.0, -27.0, -3.0), 31.903, 0.00006, "CIEDE2000 Sharma pair 19")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 58.0, 24.0, 15.0), 19.4535, 0.00006, "CIEDE2000 Sharma pair 20")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 50.0, 3.1736, 0.5854), 1.0, 0.00006, "CIEDE2000 Sharma pair 21")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 50.0, 3.2972, 0.0), 1.0, 0.00006, "CIEDE2000 Sharma pair 22")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 50.0, 1.8634, 0.5757), 1.0, 0.00006, "CIEDE2000 Sharma pair 23")
    near(t, delta_e2000_lab(50.0, 2.5, 0.0, 50.0, 3.2592, 0.335), 1.0, 0.00006, "CIEDE2000 Sharma pair 24")
    near(t, delta_e2000_lab(60.2574, -34.0099, 36.2677, 60.4626, -34.1751, 39.4387), 1.2644, 0.00006, "CIEDE2000 Sharma pair 25")
    near(t, delta_e2000_lab(63.0109, -31.0961, -5.8663, 62.8187, -29.7946, -4.0864), 1.263, 0.00006, "CIEDE2000 Sharma pair 26")
    near(t, delta_e2000_lab(61.2901, 3.7196, -5.3901, 61.4292, 2.248, -4.962), 1.8731, 0.00006, "CIEDE2000 Sharma pair 27")
    near(t, delta_e2000_lab(35.0831, -44.1164, 3.7933, 35.0232, -40.0716, 1.5901), 1.8645, 0.00006, "CIEDE2000 Sharma pair 28")
    near(t, delta_e2000_lab(22.7233, 20.0904, -46.694, 23.0331, 14.973, -42.5619), 2.0373, 0.00006, "CIEDE2000 Sharma pair 29")
    near(t, delta_e2000_lab(36.4612, 47.858, 18.3852, 36.2715, 50.5065, 21.2231), 1.4146, 0.00006, "CIEDE2000 Sharma pair 30")
    near(t, delta_e2000_lab(90.8027, -2.0831, 1.441, 91.1528, -1.6435, 0.0447), 1.4441, 0.00006, "CIEDE2000 Sharma pair 31")
    near(t, delta_e2000_lab(90.9257, -0.5406, -0.9208, 88.6381, -0.8985, -0.7239), 1.5381, 0.00006, "CIEDE2000 Sharma pair 32")
    near(t, delta_e2000_lab(6.7747, -0.2908, -2.4247, 5.8714, -0.0985, -2.2286), 0.6377, 0.00006, "CIEDE2000 Sharma pair 33")
    near(t, delta_e2000_lab(2.0776, 0.0795, -1.135, 0.9033, -0.0636, -0.5514), 0.9082, 0.00006, "CIEDE2000 Sharma pair 34")
    near(t, delta_e76_lab(50.0, 2.6772, -79.7751, 50.0, 0.0, -82.7485), 4.001063, 0.0001, "CIE76")
    near(t, delta_e94_lab(50.0, 2.6772, -79.7751, 50.0, 0.0, -82.7485, false), 1.395039, 0.0001, "CIE94")
    near(t, delta_e94_lab(50.0, 2.6772, -79.7751, 50.0, 0.0, -82.7485, true), 1.423046, 0.0001, "CIE94 textiles")
    near(t, parse("#ff0000").delta_e76(parse("#ff0000")), 0.0, 0.000001, "identical colours")
    near(t, parse("#ff0000").delta_e2000(parse("#00ff00")), 86.6, 0.5, "red vs green CIEDE2000 (approx)")
    mut a = parse("#3366cc")
    mut b = parse("#3467cc")
    near(t, a.delta_e2000(b), 0.3, 0.2, "one step apart is below 1")
    near(t, a.delta_e_ok(b), 0.003, 0.003, "OKLab distance small")
    t.assert_true(a.delta_e2000(parse("#cc6633")) > 30.0, "very different colours")

def test_palette(t: TestRunner):
    t.section("palette helpers")
    mut c = parse("#3366cc")
    t.assert_eq_str(c.lighten(0.2).to_hex(), "#85a3e0", "lighten")
    t.assert_eq_str(c.darken(0.2).to_hex(), "#1f3d7a", "darken")
    t.assert_true(c.desaturate(0.6).equals(parse("#808080"), 0.005), "desaturate to grey")
    t.assert_eq_str(parse("#668099").saturate(0.5).to_hex(), "#2681d9", "saturate")
    t.assert_eq_str(c.rotate_hue(180.0).to_hex(), "#cc9933", "rotate 180")
    t.assert_eq_str(c.complementary().to_hex(), "#cc9933", "complementary")
    mut tri = parse("#ff0000").triadic()
    t.assert_eq_int(tri.len(), 3, "triadic count")
    t.assert_eq_str(tri[1].to_hex(), "#00ff00", "triadic +120")
    t.assert_eq_str(tri[2].to_hex(), "#0000ff", "triadic +240")
    t.assert_eq_int(parse("#ff0000").tetradic().len(), 4, "tetradic count")
    t.assert_eq_str(parse("#ff0000").split_complementary()[1].to_hex(), "#00ff80", "split complementary")
    mut an = parse("#ff0000").analogous(3, 60.0)
    t.assert_eq_str(an[0].to_hex(), "#ff0080", "analogous -30")
    t.assert_eq_str(an[1].to_hex(), "#ff0000", "analogous 0")
    t.assert_eq_str(an[2].to_hex(), "#ff8000", "analogous +30")
    mut sc = parse("#000000").scale_to(parse("#ffffff"), 5, SPACE_SRGB)
    t.assert_eq_int(sc.len(), 5, "scale count")
    t.assert_eq_str(sc[2].to_hex(), "#808080", "scale midpoint")
    t.assert_eq_int(c.tints(3).len(), 3, "tints")
    t.assert_true(c.tints(1)[0].luminance() > c.luminance(), "tint is lighter")
    t.assert_true(c.shades(1)[0].luminance() < c.luminance(), "shade is darker")
    t.assert_eq_str(parse("#ff8800").grayscale().to_hex(), "#a7a7a7", "grayscale")
    t.assert_eq_str(parse("#ff8800").invert().to_hex(), "#0077ff", "invert")
    mut wide = Color.oklch(0.7, 0.4, 150.0, 1.0)
    t.assert_false(wide.in_gamut(), "oklch(0.7 0.4 150) is outside sRGB")
    mut mapped = wide.gamut_mapped()
    t.assert_true(mapped.in_gamut(), "gamut mapped")
    mut ml, mc, mh = mapped.to_oklch()
    near(t, mh, 150.0, 3.0, "gamut mapping keeps the hue")

def test_integration(t: TestRunner):
    t.section("Image and PDF integration")
    mut img = Image.filled(4, 3, parse("#336699"))
    t.assert_eq_str(img.get_color(2, 1).to_hex_alpha(), "#336699ff", "filled image")
    img.set_color(1, 1, parse("rgba(255, 0, 0, 0.5)"))
    mut px = img.get_color(1, 1)
    t.assert_eq_str(px.to_hex_alpha(), "#ff000080", "set_color / get_color")
    img.fill_color(Color.transparent())
    t.assert_eq_int(img.get_color(3, 2).a8(), 0, "fill_color")
    mut doc = PdfDocument.init()
    mut page = doc.add_page_a4()
    page.set_fill_color_c(parse("#ff8000"))
    page.set_stroke_color_c(parse("rgb(0 0 255 / 50%)"))
    t.assert_true(page.content().contains("1 0.502 0 rg"), "pdf fill colour")
    t.assert_true(page.content().contains("0 0 1 RG"), "pdf stroke colour")

def test_qr(t: TestRunner):
    t.section("QR encoder")

    mut rq0: Result[QrCode, str] = QrCode.encode("HELLO WORLD", QR_ECC_M)
    t.assert_true(rq0.is_ok, "encode 'HELLO WORLD'")
    mut q0: QrCode = rq0.ok
    t.assert_eq_int(q0.version, 1, "version of 'HELLO WORLD'")
    t.assert_eq_int(q0.size, 21, "size")
    t.assert_eq_int(q0.ecc, 2, "ecc after boost")
    t.assert_eq_int(q0.mask, 0, "mask")
    t.assert_eq_int(fnv_qr(q0), 1617489730, "module matrix identical to the verified reference")
    mut rq1: Result[QrCode, str] = QrCode.encode("01234567", QR_ECC_M)
    t.assert_true(rq1.is_ok, "encode '01234567'")
    mut q1: QrCode = rq1.ok
    t.assert_eq_int(q1.version, 1, "version of '01234567'")
    t.assert_eq_int(q1.size, 21, "size")
    t.assert_eq_int(q1.ecc, 3, "ecc after boost")
    t.assert_eq_int(q1.mask, 6, "mask")
    t.assert_eq_int(fnv_qr(q1), 2358451508, "module matrix identical to the verified reference")
    mut rq2: Result[QrCode, str] = QrCode.encode("https://tauraro.dev/docs?x=1", QR_ECC_L)
    t.assert_true(rq2.is_ok, "encode 'https://tauraro.dev")
    mut q2: QrCode = rq2.ok
    t.assert_eq_int(q2.version, 2, "version of 'https://tauraro.dev")
    t.assert_eq_int(q2.size, 25, "size")
    t.assert_eq_int(q2.ecc, 0, "ecc after boost")
    t.assert_eq_int(q2.mask, 7, "mask")
    t.assert_eq_int(fnv_qr(q2), 4124402442, "module matrix identical to the verified reference")
    mut rq3: Result[QrCode, str] = QrCode.encode("Hello, wörld 世界", QR_ECC_Q)
    t.assert_true(rq3.is_ok, "encode 'Hello, wörld 世界'")
    mut q3: QrCode = rq3.ok
    t.assert_eq_int(q3.version, 2, "version of 'Hello, wörld 世界'")
    t.assert_eq_int(q3.size, 25, "size")
    t.assert_eq_int(q3.ecc, 2, "ecc after boost")
    t.assert_eq_int(q3.mask, 2, "mask")
    t.assert_eq_int(fnv_qr(q3), 3785491462, "module matrix identical to the verified reference")
    mut rq4: Result[QrCode, str] = QrCode.encode("A".repeat(100), QR_ECC_H)
    t.assert_true(rq4.is_ok, "encode 'A' * 100")
    mut q4: QrCode = rq4.ok
    t.assert_eq_int(q4.version, 8, "version of 'A' * 100")
    t.assert_eq_int(q4.size, 49, "size")
    t.assert_eq_int(q4.ecc, 3, "ecc after boost")
    t.assert_eq_int(q4.mask, 2, "mask")
    t.assert_eq_int(fnv_qr(q4), 3060663848, "module matrix identical to the verified reference")
    mut rq5: Result[QrCode, str] = QrCode.encode("1234567890".repeat(40), QR_ECC_M)
    t.assert_true(rq5.is_ok, "encode '1234567890' * 40")
    mut q5: QrCode = rq5.ok
    t.assert_eq_int(q5.version, 9, "version of '1234567890' * 40")
    t.assert_eq_int(q5.size, 53, "size")
    t.assert_eq_int(q5.ecc, 1, "ecc after boost")
    t.assert_eq_int(q5.mask, 3, "mask")
    t.assert_eq_int(fnv_qr(q5), 1587823673, "module matrix identical to the verified reference")

    # finder patterns, timing pattern and the dark module of any version 1 symbol
    mut f: QrCode = QrCode.encode("01234567", QR_ECC_M).ok
    t.assert_true(f.get(0, 0) and f.get(6, 0) and f.get(0, 6) and f.get(6, 6) and not f.get(1, 1) and f.get(2, 2), "top-left finder")
    t.assert_true(f.get(20, 0) and f.get(14, 0) and f.get(14, 6) and f.get(20, 6), "top-right finder")
    t.assert_true(f.get(0, 14) and f.get(6, 20) and f.get(0, 20), "bottom-left finder")
    t.assert_true(f.get(8, 6) and not f.get(9, 6) and f.get(10, 6) and f.get(6, 8) and not f.get(6, 9), "timing pattern")
    t.assert_true(f.get(8, 13), "dark module")
    t.assert_false(f.get(-1, 0), "outside is light")
    t.assert_false(f.get(21, 21), "outside is light (far)")

    # explicit options
    mut o1: Result[QrCode, str] = QrCode.encode_opts("hello", 5, QR_ECC_L, 5, 40, 3, false, QR_MODE_BYTE)
    t.assert_eq_int(o1.ok.version, 5, "min_version honoured")
    t.assert_eq_int(o1.ok.mask, 3, "mask honoured")
    t.assert_eq_int(o1.ok.ecc, QR_ECC_L, "no boost")
    mut nb: Result[QrCode, str] = QrCode.encode_opts("HELLO WORLD", 11, QR_ECC_M, 1, 40, -1, false, 0)
    t.assert_eq_int(nb.ok.ecc, QR_ECC_M, "boost off keeps the level")
    mut bad1: Result[QrCode, str] = QrCode.encode_opts("hello", 5, QR_ECC_L, 1, 40, -1, true, QR_MODE_NUMERIC)
    t.assert_true(bad1.is_err, "numeric mode rejects letters")
    mut bad2: Result[QrCode, str] = QrCode.encode_opts("abc", 3, QR_ECC_L, 1, 40, -1, true, QR_MODE_ALNUM)
    t.assert_true(bad2.is_err, "alphanumeric mode rejects lower case")
    mut big = "x".repeat(2954)
    mut b1: Result[QrCode, str] = QrCode.encode(big, QR_ECC_L)
    t.assert_true(b1.is_err, "2954 bytes do not fit at level L")
    mut big2 = "x".repeat(2953)
    mut b2: Result[QrCode, str] = QrCode.encode(big2, QR_ECC_L)
    t.assert_true(b2.is_ok, "2953 bytes fit version 40-L")
    t.assert_eq_int(b2.ok.version, 40, "version 40")
    t.assert_eq_int(b2.ok.size, 177, "177 modules")
    mut bn: Result[QrCode, str] = QrCode.encode("9".repeat(7089), QR_ECC_L)
    t.assert_true(bn.is_ok, "7089 digits fit version 40-L")
    mut bn2: Result[QrCode, str] = QrCode.encode("9".repeat(7090), QR_ECC_L)
    t.assert_true(bn2.is_err, "7090 digits do not")
    mut empty: Result[QrCode, str] = QrCode.encode("", QR_ECC_H)
    t.assert_true(empty.is_ok, "empty text is valid")
    # automatic segmentation: digits embedded in text switch to numeric mode and save space
    mut mixed: Result[QrCode, str] = QrCode.encode_opts("ABCDEF0123456789012345678901234567890123456789", 46, QR_ECC_L, 1, 40, -1, false, 0)
    mut plain: Result[QrCode, str] = QrCode.encode_opts("ABCDEF0123456789012345678901234567890123456789", 46, QR_ECC_L, 1, 40, -1, false, QR_MODE_BYTE)
    t.assert_true(mixed.ok.version < plain.ok.version, "segmentation beats plain byte mode")

    section_render(t, f)

def section_render(t: TestRunner, q: QrCode):
    t.section("QR rendering")
    mut img = q.to_image(3, 4)
    t.assert_eq_int(img.width, (21 + 8) * 3, "image width")
    t.assert_eq_str(img.get_color(0, 0).to_hex(), "#ffffff", "quiet zone is white")
    t.assert_eq_str(img.get_color(12, 12).to_hex(), "#000000", "finder corner is black")
    t.assert_eq_str(img.get_color(15, 15).to_hex(), "#ffffff", "inside finder ring is white")
    mut ci = q.to_image_colors(2, 1, parse("#102030"), parse("#fffbe0"))
    t.assert_eq_str(ci.get_color(2, 2).to_hex(), "#102030", "custom foreground")
    t.assert_eq_str(ci.get_color(0, 0).to_hex(), "#fffbe0", "custom background")
    mut svg = q.to_svg(2)
    t.assert_true(svg.starts_with("<?xml"), "svg header")
    t.assert_true(svg.contains("viewBox=\"0 0 25 25\""), "svg viewBox")
    t.assert_true(svg.contains("fill=\"#000000\""), "svg foreground")
    t.assert_true(svg.contains("M2,2h7v1h-7z"), "svg top finder row")
    mut svg2 = q.to_svg_colors(0, parse("rgb(255 0 0 / 50%)"), Color.white())
    t.assert_true(svg2.contains("fill-opacity=\"0.5\""), "svg opacity")
    mut txt = q.to_text(1)
    mut lines = txt.split_exact("\n")
    t.assert_eq_int(lines.len(), 12 + 1, "terminal text height: 23 module rows / 2 + trailing newline")
    t.assert_true(txt.starts_with("█▀▀▀▀▀▀▀█"), "quiet zone is drawn as filled cells")
    t.assert_true(txt.contains("▀▀▀▀▀▀▀"), "finder pattern top edge")
    mut inv = q.to_text_opts(0, true)
    t.assert_true(inv.starts_with("█▀▀▀▀▀█"), "inverted: dark modules filled")

def main():
    mut t = TestRunner.init("137_qr_color")
    test_conversions(t)
    test_text(t)
    test_mix(t)
    test_delta_e(t)
    test_palette(t)
    test_integration(t)
    test_qr(t)
    t.summary()
