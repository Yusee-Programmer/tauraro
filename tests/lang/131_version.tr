# tests/lang/131_version.tr
# std.version: SemVer 2.0.0 parsing, precedence and bumps; npm/cargo-style
# requirements.
#
# Validity vectors are the official semver.org regex test list
# (https://regex101.com/r/Ly7O1x/3/), the precedence chain is the one from
# semver.org section 11. Range vectors are taken from node-semver's test
# fixtures (range-include.js, range-exclude.js, range-parse.js); only the
# non-`loose` cases are used.

from std.test import TestRunner
from std.version import Version, VersionReq, Comparator
from std.core.vec import Vec

def valid(t: TestRunner, s: str):
    mut r: Result[Version, str] = Version.parse(s)
    t.assert_true(r.is_ok, f"valid: {s}")
    if r.is_ok: t.assert_eq_str(r.ok.to_str(), s, f"round-trip: {s}")

def invalid(t: TestRunner, s: str):
    t.assert_false(Version.is_valid(s), f"invalid: {s}")

def test_parse(t: TestRunner):
    t.section("semver.org valid list")
    valid(t, "0.0.4")
    valid(t, "1.2.3")
    valid(t, "10.20.30")
    valid(t, "1.1.2-prerelease+meta")
    valid(t, "1.1.2+meta")
    valid(t, "1.1.2+meta-valid")
    valid(t, "1.0.0-alpha")
    valid(t, "1.0.0-beta")
    valid(t, "1.0.0-alpha.beta")
    valid(t, "1.0.0-alpha.beta.1")
    valid(t, "1.0.0-alpha.1")
    valid(t, "1.0.0-alpha0.valid")
    valid(t, "1.0.0-alpha.0valid")
    valid(t, "1.0.0-alpha-a.b-c-somethinglong+build.1-aef.1-its-okay")
    valid(t, "1.0.0-rc.1+build.1")
    valid(t, "2.0.0-rc.1+build.123")
    valid(t, "1.2.3-beta")
    valid(t, "10.2.3-DEV-SNAPSHOT")
    valid(t, "1.2.3-SNAPSHOT-123")
    valid(t, "1.0.0")
    valid(t, "2.0.0")
    valid(t, "1.1.7")
    valid(t, "2.0.0+build.1848")
    valid(t, "2.0.1-alpha.1227")
    valid(t, "1.0.0-alpha+beta")
    valid(t, "1.2.3----RC-SNAPSHOT.12.9.1--.12+788")
    valid(t, "1.2.3----R-S.12.9.1--.12+meta")
    valid(t, "1.2.3----RC-SNAPSHOT.12.9.1--.12")
    valid(t, "1.0.0+0.build.1-rc.10000aaa-kk-0.1")
    valid(t, "1.0.0-0A.is.legal")

    t.section("semver.org invalid list")
    invalid(t, "1")
    invalid(t, "1.2")
    invalid(t, "1.2.3-0123")
    invalid(t, "1.2.3-0123.0123")
    invalid(t, "1.1.2+.123")
    invalid(t, "+invalid")
    invalid(t, "-invalid")
    invalid(t, "-invalid+invalid")
    invalid(t, "-invalid.01")
    invalid(t, "alpha")
    invalid(t, "alpha.beta")
    invalid(t, "alpha.beta.1")
    invalid(t, "alpha.1")
    invalid(t, "alpha+beta")
    invalid(t, "alpha_beta")
    invalid(t, "alpha.")
    invalid(t, "alpha..")
    invalid(t, "beta")
    invalid(t, "1.0.0-alpha_beta")
    invalid(t, "-alpha.")
    invalid(t, "1.0.0-alpha..")
    invalid(t, "1.0.0-alpha..1")
    invalid(t, "1.0.0-alpha...1")
    invalid(t, "1.0.0-alpha....1")
    invalid(t, "1.0.0-alpha.....1")
    invalid(t, "1.0.0-alpha......1")
    invalid(t, "1.0.0-alpha.......1")
    invalid(t, "01.1.1")
    invalid(t, "1.01.1")
    invalid(t, "1.1.01")
    invalid(t, "1.2.3.DEV")
    invalid(t, "1.2-SNAPSHOT")
    invalid(t, "1.2.31.2.3----RC-SNAPSHOT.12.09.1--..12+788")
    invalid(t, "1.2-RC-SNAPSHOT")
    invalid(t, "-1.0.3-gamma+b7718")
    invalid(t, "+justmeta")
    invalid(t, "9.8.7+meta+meta")
    invalid(t, "9.8.7-whatever+meta+meta")
    invalid(t, "99999999999999999999999.999999999999999999.99999999999999999----RC-SNAPSHOT.12.09.1--------------------------------..12")
    invalid(t, "")
    invalid(t, "v1.2.3")
    invalid(t, " 1.2.3")
    invalid(t, "99999999999999999999999.999999999999999999.99999999999999999")

    t.section("fields and errors")
    mut r: Result[Version, str] = Version.parse("1.2.3-rc.1+build.5")
    t.assert_true(r.is_ok, "parse ok")
    mut v = r.ok
    t.assert_eq_int(v.major, 1, "major")
    t.assert_eq_int(v.minor, 2, "minor")
    t.assert_eq_int(v.patch, 3, "patch")
    t.assert_eq_int(len(v.pre), 2, "pre count")
    t.assert_eq_str(v.pre_str(), "rc.1", "pre")
    t.assert_eq_str(v.build_str(), "build.5", "build")
    t.assert_true(v.is_prerelease(), "is prerelease")
    t.assert_eq_str(v.to_str_no_build(), "1.2.3-rc.1", "no build")
    mut e: Result[Version, str] = Version.parse("1.02.3")
    t.assert_true(e.is_err, "leading zero rejected")
    if e.is_err: t.assert_contains(e.err, "minor", "error names the part")
    mut e2: Result[Version, str] = Version.parse("1.2.3-a..b")
    if e2.is_err: t.assert_contains(e2.err, "empty pre-release identifier", "empty identifier message")

    t.section("loose / taupkg-compatible parse")
    mut l: Result[Version, str] = Version.parse_loose("  v1.2 ")
    t.assert_true(l.is_ok, "loose ok")
    if l.is_ok: t.assert_eq_str(l.ok.to_str(), "1.2.0", "loose fills patch")
    mut l2: Result[Version, str] = Version.parse_loose("=1.02.3-rc.1")
    if l2.is_ok: t.assert_eq_str(l2.ok.to_str(), "1.2.3-rc.1", "loose leading zero")
    t.assert_eq_str(Version.init("v2").to_str(), "2.0.0", "init lenient")
    t.assert_eq_str(Version.init("garbage").to_str(), "0.0.0", "init garbage")
    t.assert_eq_str(Version.init("1.4.0").to_string(), "1.4.0", "to_string alias")
    t.assert_eq_str(Version.new(3, 1, 4).to_str(), "3.1.4", "new")

def lt(t: TestRunner, a: str, b: str):
    mut va = Version.init(a)
    mut vb = Version.init(b)
    t.assert_eq_int(va.compare(vb), -1, f"{a} < {b}")
    t.assert_eq_int(vb.compare(va), 1, f"{b} > {a}")
    t.assert_true(va.lt(vb) and va.lte(vb) and vb.gt(va) and vb.gte(va) and va.ne(vb), f"ops {a} {b}")

def test_precedence(t: TestRunner):
    t.section("semver.org precedence")
    lt(t, "1.0.0", "2.0.0")
    lt(t, "2.0.0", "2.1.0")
    lt(t, "2.1.0", "2.1.1")
    lt(t, "1.0.0-alpha", "1.0.0")
    lt(t, "1.0.0-alpha", "1.0.0-alpha.1")
    lt(t, "1.0.0-alpha.1", "1.0.0-alpha.beta")
    lt(t, "1.0.0-alpha.beta", "1.0.0-beta")
    lt(t, "1.0.0-beta", "1.0.0-beta.2")
    lt(t, "1.0.0-beta.2", "1.0.0-beta.11")
    lt(t, "1.0.0-beta.11", "1.0.0-rc.1")
    lt(t, "1.0.0-rc.1", "1.0.0")
    lt(t, "1.9.0", "1.10.0")
    lt(t, "1.0.0-1", "1.0.0-a")
    lt(t, "1.0.0-A", "1.0.0-a")
    lt(t, "1.0.0-99999999999999999999", "1.0.0-100000000000000000000")
    mut a = Version.init("1.0.0+build.1")
    mut b = Version.init("1.0.0+build.2")
    t.assert_eq_int(a.compare(b), 0, "build ignored")
    t.assert_true(a.eq(b), "eq ignores build")
    t.assert_eq_int(a.compare_build(b), -1, "compare_build tie-break")
    t.assert_false(a.identical(b), "identical sees build")
    t.assert_eq_int(Version.init("1.0.0").compare_build(a), -1, "no build sorts first")

    t.section("sort")
    mut shuffled: List[str] = ["1.0.0", "1.0.0-rc.1", "1.0.0-beta.11", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-alpha", "1.0.0-beta.2", "1.0.0-alpha.1", "junk", "0.9.9"]
    mut sorted = Version.sort_strs(shuffled)
    t.assert_eq_int(len(sorted), 9, "junk dropped")
    t.assert_eq_str(sorted[0], "0.9.9", "sorted 0")
    t.assert_eq_str(sorted[1], "1.0.0-alpha", "sorted 1")
    t.assert_eq_str(sorted[2], "1.0.0-alpha.1", "sorted 2")
    t.assert_eq_str(sorted[3], "1.0.0-alpha.beta", "sorted 3")
    t.assert_eq_str(sorted[4], "1.0.0-beta", "sorted 4")
    t.assert_eq_str(sorted[5], "1.0.0-beta.2", "sorted 5")
    t.assert_eq_str(sorted[6], "1.0.0-beta.11", "sorted 6")
    t.assert_eq_str(sorted[7], "1.0.0-rc.1", "sorted 7")
    t.assert_eq_str(sorted[8], "1.0.0", "sorted 8")

def bump(t: TestRunner, got: Version, want: str, msg: str):
    t.assert_eq_str(got.to_str(), want, msg)

def test_bump(t: TestRunner):
    t.section("bumps (npm semver.inc)")
    bump(t, Version.init("1.2.3").bump_major(), "2.0.0", "major")
    bump(t, Version.init("1.2.3+b").bump_major(), "2.0.0", "major drops build")
    bump(t, Version.init("2.0.0-rc.1").bump_major(), "2.0.0", "major of major pre")
    bump(t, Version.init("1.2.0-rc.1").bump_major(), "2.0.0", "major of minor pre")
    bump(t, Version.init("1.2.3").bump_minor(), "1.3.0", "minor")
    bump(t, Version.init("1.3.0-rc.1").bump_minor(), "1.3.0", "minor of minor pre")
    bump(t, Version.init("1.3.1-rc.1").bump_minor(), "1.4.0", "minor of patch pre")
    bump(t, Version.init("1.2.3").bump_patch(), "1.2.4", "patch")
    bump(t, Version.init("1.2.4-rc.1").bump_patch(), "1.2.4", "patch of pre")
    bump(t, Version.init("1.2.3").bump_prerelease("rc"), "1.2.4-rc.0", "pre from release")
    bump(t, Version.init("1.2.3").bump_prerelease(""), "1.2.4-0", "pre numeric")
    bump(t, Version.init("1.2.4-rc.0").bump_prerelease("rc"), "1.2.4-rc.1", "pre increments")
    bump(t, Version.init("1.2.4-beta.3").bump_prerelease("rc"), "1.2.4-rc.0", "pre switches tag")
    bump(t, Version.init("1.2.4-rc").bump_prerelease("rc"), "1.2.4-rc.0", "pre appends .0")
    bump(t, Version.init("1.2.4-alpha").bump_prerelease(""), "1.2.4-alpha.0", "pre no tag")
    bump(t, Version.init("1.2.4-1.beta").bump_prerelease(""), "1.2.4-2.beta", "last numeric id")
    mut wp: Result[Version, str] = Version.init("1.0.0").with_pre("beta.1")
    if wp.is_ok: bump(t, wp.ok, "1.0.0-beta.1", "with_pre")
    mut wb: Result[Version, str] = Version.init("1.0.0").with_build("sha.abc")
    if wb.is_ok: bump(t, wb.ok, "1.0.0+sha.abc", "with_build")
    mut bad: Result[Version, str] = Version.init("1.0.0").with_pre("01")
    t.assert_true(bad.is_err, "with_pre validates")

def req(s: str) -> VersionReq:
    mut r: Result[VersionReq, str] = VersionReq.parse(s)
    if r.is_ok: return r.ok
    print(f"unexpected parse error for '{s}': {r.err}")
    return VersionReq.any()

def req_pre(s: str) -> VersionReq:
    mut r: Result[VersionReq, str] = VersionReq.parse_opts(s, true)
    if r.is_ok: return r.ok
    print(f"unexpected parse error for '{s}': {r.err}")
    return VersionReq.any()

def inc(t: TestRunner, r: str, v: str):
    t.assert_true(req(r).matches_str(v), f"'{r}' includes {v}")

def exc(t: TestRunner, r: str, v: str):
    t.assert_false(req(r).matches_str(v), f"'{r}' excludes {v}")

def inc_p(t: TestRunner, r: str, v: str):
    t.assert_true(req_pre(r).matches_str(v), f"'{r}' (includePrerelease) includes {v}")

def exc_p(t: TestRunner, r: str, v: str):
    t.assert_false(req_pre(r).matches_str(v), f"'{r}' (includePrerelease) excludes {v}")

def norm(t: TestRunner, r: str, want: str):
    t.assert_eq_str(req(r).to_str(), want, f"normalize '{r}'")

def test_range_parse(t: TestRunner):
    t.section("node-semver range-parse")
    norm(t, "1.0.0 - 2.0.0", ">=1.0.0 <=2.0.0")
    norm(t, "1 - 2", ">=1.0.0 <3.0.0-0")
    norm(t, "1.0 - 2.0", ">=1.0.0 <2.1.0-0")
    norm(t, "1.0.0", "1.0.0")
    norm(t, ">=*", "*")
    norm(t, "", "*")
    norm(t, "*", "*")
    norm(t, ">=1.0.0", ">=1.0.0")
    norm(t, ">1.0.0", ">1.0.0")
    norm(t, "<=2.0.0", "<=2.0.0")
    norm(t, "1", ">=1.0.0 <2.0.0-0")
    norm(t, "<2.0.0", "<2.0.0")
    norm(t, ">= 1.0.0", ">=1.0.0")
    norm(t, ">=  1.0.0", ">=1.0.0")
    norm(t, "0.1.20 || 1.2.4", "0.1.20||1.2.4")
    norm(t, ">=0.2.3 || <0.0.1", ">=0.2.3||<0.0.1")
    norm(t, "||", "*")
    norm(t, "2.x.x", ">=2.0.0 <3.0.0-0")
    norm(t, "1.2.x", ">=1.2.0 <1.3.0-0")
    norm(t, "1.2.x || 2.x", ">=1.2.0 <1.3.0-0||>=2.0.0 <3.0.0-0")
    norm(t, "x", "*")
    norm(t, "2.*.*", ">=2.0.0 <3.0.0-0")
    norm(t, "1.2.*", ">=1.2.0 <1.3.0-0")
    norm(t, "2", ">=2.0.0 <3.0.0-0")
    norm(t, "2.3", ">=2.3.0 <2.4.0-0")
    norm(t, "~2.4", ">=2.4.0 <2.5.0-0")
    norm(t, "~>3.2.1", ">=3.2.1 <3.3.0-0")
    norm(t, "~1", ">=1.0.0 <2.0.0-0")
    norm(t, "~>1", ">=1.0.0 <2.0.0-0")
    norm(t, "~> 1", ">=1.0.0 <2.0.0-0")
    norm(t, "~1.0", ">=1.0.0 <1.1.0-0")
    norm(t, "~ 1.0", ">=1.0.0 <1.1.0-0")
    norm(t, "^0", "<1.0.0-0")
    norm(t, "^ 1", ">=1.0.0 <2.0.0-0")
    norm(t, "^0.1", ">=0.1.0 <0.2.0-0")
    norm(t, "^1.0", ">=1.0.0 <2.0.0-0")
    norm(t, "^1.2", ">=1.2.0 <2.0.0-0")
    norm(t, "^0.0.1", ">=0.0.1 <0.0.2-0")
    norm(t, "^0.0.1-beta", ">=0.0.1-beta <0.0.2-0")
    norm(t, "^0.1.2", ">=0.1.2 <0.2.0-0")
    norm(t, "^1.2.3", ">=1.2.3 <2.0.0-0")
    norm(t, "^1.2.3-beta.4", ">=1.2.3-beta.4 <2.0.0-0")
    norm(t, "<1", "<1.0.0-0")
    norm(t, "< 1", "<1.0.0-0")
    norm(t, ">=1", ">=1.0.0")
    norm(t, ">= 1", ">=1.0.0")
    norm(t, "<1.2", "<1.2.0-0")
    norm(t, "< 1.2", "<1.2.0-0")
    norm(t, "1", ">=1.0.0 <2.0.0-0")
    norm(t, ">1", ">=2.0.0")
    norm(t, ">1.2", ">=1.3.0")
    norm(t, "<=1.2", "<1.3.0-0")
    norm(t, ">X", "<0.0.0-0")
    norm(t, "<X", "<0.0.0-0")
    norm(t, "<x <* || >* 2.x", "<0.0.0-0")
    norm(t, ">x 2.x || * || <x", "*")
    norm(t, "^1.2.3+build", ">=1.2.3 <2.0.0-0")
    norm(t, "1.2.3-pre+asdf - 2.4.3-pre+asdf", ">=1.2.3-pre <=2.4.3-pre")
    norm(t, "~1.2.1 >=1.2.3 1.2.3", ">=1.2.1 <1.3.0-0 >=1.2.3 1.2.3")
    norm(t, ">=1.2.1 >=1.2.1", ">=1.2.1")
    norm(t, "=1.2.3", "1.2.3")
    norm(t, "v1.2.3", "1.2.3")
    # cargo-style comma AND, and a hyphen range with partial bounds
    norm(t, ">=1.0, <2.0", ">=1.0.0 <2.0.0-0")
    norm(t, "1.2 - 1.4", ">=1.2.0 <1.5.0-0")
    norm(t, "1.2.3 - 2", ">=1.2.3 <3.0.0-0")

def test_range_include(t: TestRunner):
    t.section("node-semver range-include")
    inc(t, "1.0.0 - 2.0.0", "1.2.3")
    inc(t, "^1.2.3+build", "1.2.3")
    inc(t, "^1.2.3+build", "1.3.0")
    inc(t, "1.2.3-pre+asdf - 2.4.3-pre+asdf", "1.2.3")
    inc(t, "1.2.3-pre+asdf - 2.4.3-pre+asdf", "1.2.3-pre.2")
    inc(t, "1.2.3-pre+asdf - 2.4.3-pre+asdf", "2.4.3-alpha")
    inc(t, "1.2.3+asdf - 2.4.3+asdf", "1.2.3")
    inc(t, "1.0.0", "1.0.0")
    inc(t, ">=*", "0.2.4")
    inc(t, "", "1.0.0")
    inc(t, "*", "1.2.3")
    inc(t, ">=1.0.0", "1.0.0")
    inc(t, ">=1.0.0", "1.0.1")
    inc(t, ">=1.0.0", "1.1.0")
    inc(t, ">1.0.0", "1.0.1")
    inc(t, ">1.0.0", "1.1.0")
    inc(t, "<=2.0.0", "2.0.0")
    inc(t, "<=2.0.0", "1.9999.9999")
    inc(t, "<=2.0.0", "0.2.9")
    inc(t, "<2.0.0", "1.9999.9999")
    inc(t, "<2.0.0", "0.2.9")
    inc(t, ">= 1.0.0", "1.0.0")
    inc(t, ">=  1.0.0", "1.0.1")
    inc(t, ">=   1.0.0", "1.1.0")
    inc(t, "> 1.0.0", "1.0.1")
    inc(t, ">  1.0.0", "1.1.0")
    inc(t, "<=   2.0.0", "2.0.0")
    inc(t, "<= 2.0.0", "1.9999.9999")
    inc(t, "<=  2.0.0", "0.2.9")
    inc(t, "<    2.0.0", "1.9999.9999")
    inc(t, "<\t2.0.0", "0.2.9")
    inc(t, ">=0.1.97", "v0.1.97")
    inc(t, ">=0.1.97", "0.1.97")
    inc(t, "0.1.20 || 1.2.4", "1.2.4")
    inc(t, ">=0.2.3 || <0.0.1", "0.0.0")
    inc(t, ">=0.2.3 || <0.0.1", "0.2.3")
    inc(t, ">=0.2.3 || <0.0.1", "0.2.4")
    inc(t, "||", "1.3.4")
    inc(t, "2.x.x", "2.1.3")
    inc(t, "1.2.x", "1.2.3")
    inc(t, "1.2.x || 2.x", "2.1.3")
    inc(t, "1.2.x || 2.x", "1.2.3")
    inc(t, "x", "1.2.3")
    inc(t, "2.*.*", "2.1.3")
    inc(t, "1.2.*", "1.2.3")
    inc(t, "1.2.* || 2.*", "2.1.3")
    inc(t, "1.2.* || 2.*", "1.2.3")
    inc(t, "2", "2.1.2")
    inc(t, "2.3", "2.3.1")
    inc(t, "~0.0.1", "0.0.1")
    inc(t, "~0.0.1", "0.0.2")
    inc(t, "~x", "0.0.9")
    inc(t, "~2", "2.0.9")
    inc(t, "~2.4", "2.4.0")
    inc(t, "~2.4", "2.4.5")
    inc(t, "~>3.2.1", "3.2.2")
    inc(t, "~1", "1.2.3")
    inc(t, "~>1", "1.2.3")
    inc(t, "~> 1", "1.2.3")
    inc(t, "~1.0", "1.0.2")
    inc(t, "~ 1.0", "1.0.2")
    inc(t, "~ 1.0.3", "1.0.12")
    inc(t, ">=1", "1.0.0")
    inc(t, ">= 1", "1.0.0")
    inc(t, "<1.2", "1.1.1")
    inc(t, "< 1.2", "1.1.1")
    inc(t, "~v0.5.4-pre", "0.5.5")
    inc(t, "~v0.5.4-pre", "0.5.4")
    inc(t, "=0.7.x", "0.7.2")
    inc(t, "<=0.7.x", "0.7.2")
    inc(t, ">=0.7.x", "0.7.2")
    inc(t, "<=0.7.x", "0.6.2")
    inc(t, "~1.2.1 >=1.2.3", "1.2.3")
    inc(t, "~1.2.1 =1.2.3", "1.2.3")
    inc(t, "~1.2.1 1.2.3", "1.2.3")
    inc(t, "~1.2.1 >=1.2.3 1.2.3", "1.2.3")
    inc(t, "~1.2.1 1.2.3 >=1.2.3", "1.2.3")
    inc(t, ">=1.2.1 1.2.3", "1.2.3")
    inc(t, "1.2.3 >=1.2.1", "1.2.3")
    inc(t, ">=1.2.3 >=1.2.1", "1.2.3")
    inc(t, ">=1.2.1 >=1.2.3", "1.2.3")
    inc(t, ">=1.2", "1.2.8")
    inc(t, "^1.2.3", "1.8.1")
    inc(t, "^0.1.2", "0.1.2")
    inc(t, "^0.1", "0.1.2")
    inc(t, "^0.0.1", "0.0.1")
    inc(t, "^1.2", "1.4.2")
    inc(t, "^1.2 ^1", "1.4.2")
    inc(t, "^1.2.3-alpha", "1.2.3-pre")
    inc(t, "^1.2.0-alpha", "1.2.0-pre")
    inc(t, "^0.0.1-alpha", "0.0.1-beta")
    inc(t, "^0.0.1-alpha", "0.0.1")
    inc(t, "^0.1.1-alpha", "0.1.1-beta")
    inc(t, "^x", "1.2.3")
    inc(t, "x - 1.0.0", "0.9.7")
    inc(t, "x - 1.x", "0.9.7")
    inc(t, "1.0.0 - x", "1.9.7")
    inc(t, "1.x - x", "1.9.7")
    inc(t, "<=7.x", "7.9.9")
    inc(t, ">=1.0, <2.0", "1.9.9")
    inc(t, "1.2 - 1.4", "1.4.99")

    t.section("node-semver range-include (includePrerelease)")
    inc_p(t, "2.x", "2.0.0-pre.0")
    inc_p(t, "2.x", "2.1.0-pre.0")
    inc_p(t, "1.1.x", "1.1.0-a")
    inc_p(t, "1.1.x", "1.1.1-a")
    inc_p(t, "*", "1.0.0-rc1")
    inc_p(t, "^1.0.0-0", "1.0.1-rc1")
    inc_p(t, "^1.0.0-rc2", "1.0.1-rc1")
    inc_p(t, "^1.0.0", "1.0.1-rc1")
    inc_p(t, "^1.0.0", "1.1.0-rc1")
    inc_p(t, "1 - 2", "2.0.0-pre")
    inc_p(t, "1 - 2", "1.0.0-pre")
    inc_p(t, "1.0 - 2", "1.0.0-pre")
    inc_p(t, "=0.7.x", "0.7.0-asdf")
    inc_p(t, ">=0.7.x", "0.7.0-asdf")
    inc_p(t, "<=0.7.x", "0.7.0-asdf")
    inc_p(t, ">=1.0.0 <=1.1.0", "1.1.0-pre")

def test_range_exclude(t: TestRunner):
    t.section("node-semver range-exclude")
    exc(t, "1.0.0 - 2.0.0", "2.2.3")
    exc(t, "1.2.3+asdf - 2.4.3+asdf", "1.2.3-pre.2")
    exc(t, "1.2.3+asdf - 2.4.3+asdf", "2.4.3-alpha")
    exc(t, "^1.2.3+build", "2.0.0")
    exc(t, "^1.2.3+build", "1.2.0")
    exc(t, "^1.2.3", "1.2.3-pre")
    exc(t, "^1.2", "1.2.0-pre")
    exc(t, ">1.2", "1.3.0-beta")
    exc(t, "<=1.2.3", "1.2.3-beta")
    exc(t, "^1.2.3", "1.2.3-beta")
    exc(t, "=0.7.x", "0.7.0-asdf")
    exc(t, ">=0.7.x", "0.7.0-asdf")
    exc(t, "<=0.7.x", "0.7.0-asdf")
    exc(t, "1.0.0", "1.0.1")
    exc(t, ">=1.0.0", "0.0.0")
    exc(t, ">=1.0.0", "0.0.1")
    exc(t, ">=1.0.0", "0.1.0")
    exc(t, ">1.0.0", "0.0.1")
    exc(t, ">1.0.0", "0.1.0")
    exc(t, "<=2.0.0", "3.0.0")
    exc(t, "<=2.0.0", "2.9999.9999")
    exc(t, "<=2.0.0", "2.2.9")
    exc(t, "<2.0.0", "2.9999.9999")
    exc(t, "<2.0.0", "2.2.9")
    exc(t, ">=0.1.97", "v0.1.93")
    exc(t, ">=0.1.97", "0.1.93")
    exc(t, "0.1.20 || 1.2.4", "1.2.3")
    exc(t, ">=0.2.3 || <0.0.1", "0.0.3")
    exc(t, ">=0.2.3 || <0.0.1", "0.2.2")
    exc(t, "2.x.x", "1.1.3")
    exc(t, "2.x.x", "3.1.3")
    exc(t, "1.2.x", "1.3.3")
    exc(t, "1.2.x || 2.x", "3.1.3")
    exc(t, "1.2.x || 2.x", "1.1.3")
    exc(t, "2.*.*", "1.1.3")
    exc(t, "2.*.*", "3.1.3")
    exc(t, "1.2.*", "1.3.3")
    exc(t, "1.2.* || 2.*", "3.1.3")
    exc(t, "1.2.* || 2.*", "1.1.3")
    exc(t, "2", "1.1.2")
    exc(t, "2.3", "2.4.1")
    exc(t, "~0.0.1", "0.1.0-alpha")
    exc(t, "~0.0.1", "0.1.0")
    exc(t, "~2.4", "2.5.0")
    exc(t, "~2.4", "2.3.9")
    exc(t, "~>3.2.1", "3.3.2")
    exc(t, "~>3.2.1", "3.2.0")
    exc(t, "~1", "0.2.3")
    exc(t, "~>1", "2.2.3")
    exc(t, "~1.0", "1.1.0")
    exc(t, "<1", "1.0.0")
    exc(t, ">=1.2", "1.1.1")
    exc(t, "=0.7.x", "0.8.2")
    exc(t, ">=0.7.x", "0.6.2")
    exc(t, "<0.7.x", "0.7.2")
    exc(t, "<1.2.3", "1.2.3-beta")
    exc(t, "=1.2.3", "1.2.3-beta")
    exc(t, ">1.2", "1.2.8")
    exc(t, "^0.0.1", "0.0.2")
    exc(t, "^1.2.3", "2.0.0-alpha")
    exc(t, "^1.2.3", "1.2.2")
    exc(t, "^1.2", "1.1.9")
    exc(t, "^1.0.0", "2.0.0-rc1")
    exc(t, "1 - 2", "2.0.0-pre")
    exc(t, "1 - 2", "1.0.0-pre")
    exc(t, "1.0 - 2", "1.0.0-pre")
    exc(t, "1.1.x", "1.0.0-a")
    exc(t, "1.1.x", "1.1.0-a")
    exc(t, "1.1.x", "1.2.0-a")
    exc(t, "1.x", "1.0.0-a")
    exc(t, "1.x", "1.1.0-a")
    exc(t, "1.x", "1.2.0-a")
    exc(t, ">=1.0.0 <1.1.0", "1.1.0")
    exc(t, ">=1.0.0 <1.1.0", "1.1.0-pre")
    exc(t, ">=1.0.0 <1.1.0-pre", "1.1.0-pre")
    exc(t, "*", "1.0.0-rc1")
    exc(t, ">=1.0, <2.0", "2.0.0")
    exc(t, "1.2 - 1.4", "1.5.0")

    t.section("node-semver range-exclude (includePrerelease)")
    exc_p(t, "^1.0.0", "2.0.0-rc1")
    exc_p(t, "1 - 2", "3.0.0-pre")
    exc_p(t, "1.1.x", "1.2.0-a")
    exc_p(t, "1.1.x", "1.0.0-a")
    exc_p(t, "1.x", "0.0.0-a")
    exc_p(t, "1.x", "2.0.0-a")
    exc_p(t, ">=1.0.0 <1.1.0-pre", "1.1.0-pre")

def test_req_api(t: TestRunner):
    t.section("requirement API")
    mut bad: List[str] = ["foo", ">=", "1.2.3.4", "^1.2.x-pre", "1.x.3", ">=01.2.3", "1.2.3 - ", "- 1.2.3"]
    mut i = 0
    while i < len(bad):
        t.assert_false(VersionReq.is_valid(bad[i]), f"invalid requirement '{bad[i]}'")
        i = i + 1
    mut e: Result[VersionReq, str] = VersionReq.parse("^1.2 || foo")
    t.assert_true(e.is_err, "bad OR set rejected")
    if e.is_err: t.assert_contains(e.err, "foo", "error names the token")

    mut versions: List[str] = ["1.0.0", "1.2.0", "1.2.9", "1.3.0-beta.1", "1.10.1", "2.0.0", "2.0.0-rc.1", "bogus"]
    mut r = req("^1.2")
    t.assert_eq_str(r.max_satisfying(versions), "1.10.1", "max_satisfying")
    t.assert_eq_str(r.min_satisfying(versions), "1.2.0", "min_satisfying")
    t.assert_eq_int(len(r.filter(versions)), 3, "filter")
    t.assert_eq_str(req("^3").max_satisfying(versions), "", "nothing satisfies")
    t.assert_eq_str(req(">=2.0.0-rc.0").max_satisfying(versions), "2.0.0", "release beats rc")
    t.assert_eq_str(req("~2.0.0-rc.0 <2.0.0").max_satisfying(versions), "2.0.0-rc.1", "pre of same tuple")
    mut vr: Result[Version, str] = Version.parse("1.2.5")
    t.assert_true(r.matches(vr.ok), "matches(Version)")

    t.section("cargo dialect")
    mut c: Result[VersionReq, str] = VersionReq.parse_cargo("1.2.3")
    t.assert_true(c.is_ok, "cargo parse")
    if c.is_ok:
        t.assert_eq_str(c.ok.to_str(), ">=1.2.3 <2.0.0-0", "bare means caret")
        t.assert_true(c.ok.matches_str("1.9.0"), "cargo bare matches minor bump")
    mut c2: Result[VersionReq, str] = VersionReq.parse_cargo(">=1.2.3, <1.5.0")
    if c2.is_ok: t.assert_eq_str(c2.ok.to_str(), ">=1.2.3 <1.5.0", "cargo comma list")
    mut c3: Result[VersionReq, str] = VersionReq.parse_cargo("=1.2.3")
    if c3.is_ok: t.assert_eq_str(c3.ok.to_str(), "1.2.3", "cargo = is exact")

    t.section("taupkg compatibility")
    mut v = Version.init("1.4.2")
    t.assert_true(v.satisfies("^1.2.3"), "satisfies caret")
    t.assert_true(v.satisfies("~1.4.0"), "satisfies tilde")
    t.assert_true(v.satisfies(">=1.4.2"), "satisfies >=")
    t.assert_false(v.satisfies(">1.4.2"), "not >")
    t.assert_true(v.satisfies("<=1.4.2"), "satisfies <=")
    t.assert_true(v.satisfies("*"), "satisfies *")
    t.assert_true(v.satisfies("1.4.2"), "satisfies exact")
    t.assert_false(v.satisfies("not a range"), "garbage never matches")
    t.assert_false(Version.init("0.3.0").satisfies("^0.2.3"), "^0.x is npm-style (differs from taupkg)")
    mut vv = Vec[str].init(4)
    vv.push("1.0.0")
    vv.push("1.2.0")
    vv.push("1.1.5")
    vv.push("2.0.0")
    t.assert_eq_str(Version.best_match(vv, "^1.0.0"), "1.2.0", "best_match")
    t.assert_eq_str(Version.best_match(vv, "^3.0.0"), "", "best_match none")

def main():
    mut t = TestRunner.init("131_version")
    test_parse(t)
    test_precedence(t)
    test_bump(t)
    test_range_parse(t)
    test_range_include(t)
    test_range_exclude(t)
    test_req_api(t)
    t.summary()
