# tests/lang/146_geo.tr
# std.geo: sphere and ellipsoid geodesics (Vincenty and Karney), area,
# point-in-polygon, Douglas-Peucker, WKT and GeoJSON, geohash, plus codes,
# UTM/MGRS, Web Mercator, tiles/quadkeys, ECEF and ENU.
#
# Reference vectors: GeographicLib 2.1 (Python) for inverse/direct/areas,
# PROJ 9 via pyproj 3.8 for UTM/Web Mercator/ECEF, the `mgrs` package for
# MGRS strings, a table-based geohash neighbour implementation, and the
# open-location-code repository's test_data CSVs (encoding, decoding,
# shortCodeTests, validityTests). The Flinders Peak example is Geoscience
# Australia's published Vincenty worked example.

from std.test import TestRunner
from std.geo.geodesy import Geo, Ellipsoid, LatLon, GeoInverse, BBox
from std.geo.encode import Geohash, GeohashCell, PlusCode, Utm, UtmCoord, Mgrs
from std.geo.proj import WebMercator, Tiles, Tile, Ecef, Enu
from std.geo.geometry import Geometry, Wkt, GeoJson, Feature, FeatureCollection, Simplify, GEOM_POLYGON, GEOM_LINESTRING

extern "C":
    def _tr_str_to_float(s: str) -> float
    def fabs(x: float) -> float
    def fmod(x: float, y: float) -> float

