# tests/lang/121_tz.tr
# std.sys.tz: TZif parsing, POSIX TZ rules, the embedded zone table, local
# <-> UTC conversion with gap/overlap policies, and DateTime integration.
#
# The per-zone vectors were generated with Python's zoneinfo (tzdata 2026c)
# by scripts/gen_tz_vectors.py: for transitions spread over each zone's
# history and in 2038-2040 / 2100 (POSIX footer rule), the offset, DST flag
# and abbreviation at t-1, t, t+1, and the instants of wall times around each
# gap/overlap with fold=0 and fold=1.
#
# Without a zoneinfo directory (Windows CI) the TZif-file checks are skipped,
# but POSIX strings, the embedded table (checked against the same vectors
# past each zone's last listed transition) and TZif parsing of two embedded
# files (Pacific/Apia, Asia/Kathmandu) still run.

from std.test import TestRunner
from std.sys.tz import Tz, TzRule, TZ_EARLIER, TZ_LATER, TZ_RAISE, TZ_LOCAL_UNIQUE, TZ_LOCAL_AMBIGUOUS, TZ_LOCAL_NONEXISTENT, tz_embedded_rule, tz_embedded_names, tz_format_offset
from std.sys.datetime import DateTime, TimeZone, TimeDelta
from std.sys.env import Env
from std.encoding.hex import Hex

const APIA_HEX = ""
const KATHMANDU_HEX = ""

# Checks UTC and local vectors against `z`. With `after` >= 0 only vectors
# strictly after that instant (+2 days for wall times) are used.
def check_vectors(t: TestRunner, z: Tz, label: str, after: int, u_ts: List[int], u_off: List[int], u_dst: List[int], u_ab: str, l_wall: List[int], l_u0: List[int], l_u1: List[int]) -> int:
    mut abbrs = u_ab.split(" ")
    # Zones that tzdata encodes with "negative DST" (Morocco, Ireland) carry an
    # is_dst flag that depends on how the system's zoneinfo was built (vanguard
    # vs rearguard data; distributions differ from Python's tzdata package).
    # Offsets and abbreviations agree everywhere, so only the flag is skipped.
    mut dst_varies = label.find("Casablanca") >= 0 or label.find("Dublin") >= 0
    mut bad = 0
    mut n = 0
    mut i = 0
    while i < len(u_ts):
        if after < 0 or u_ts[i] > after:
            n = n + 1
            mut off, dst, ab = z.offset_at(u_ts[i])
            mut want_dst = u_dst[i] != 0
            if off != u_off[i] or (dst != want_dst and not dst_varies) or ab != abbrs.get(i):
                bad = bad + 1
                if bad <= 5:
                    mut wd = u_dst[i]
                    mut wa = abbrs.get(i)
                    t.fail(f"{label} offset_at({u_ts[i]}) = ({off}, {dst}, {ab}), want ({u_off[i]}, {wd}, {wa})")
        i = i + 1
    i = 0
    while i < len(l_wall):
        if after < 0 or l_wall[i] > after + 172800:
            n = n + 1
            mut dt = DateTime.from_timestamp_utc(l_wall[i])
            mut r0: Result[int, str] = z.local_to_unix(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, TZ_EARLIER)
            mut r1: Result[int, str] = z.local_to_unix(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, TZ_LATER)
            mut g0 = r0.ok
            mut g1 = r1.ok
            mut kind = z.classify_local(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second)
            mut want_kind = TZ_LOCAL_UNIQUE
            if l_u0[i] < l_u1[i]: want_kind = TZ_LOCAL_AMBIGUOUS
            if l_u0[i] > l_u1[i]: want_kind = TZ_LOCAL_NONEXISTENT
            mut f0 = z.from_local(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second).timestamp()
            mut f1 = z.from_local_later(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second).timestamp()
            if g0 != l_u0[i] or g1 != l_u1[i] or kind != want_kind or f0 != l_u0[i] or f1 != l_u1[i]:
                bad = bad + 1
                if bad <= 5:
                    mut ws = dt.to_string()
                    t.fail(f"{label} local {ws}: fold0 {g0} fold1 {g1} kind {kind}, want {l_u0[i]} {l_u1[i]} {want_kind}")
        i = i + 1
    t.assert_eq_int(bad, 0, f"{label}: {n} vectors match Python zoneinfo")
    return n

def check_zone(t: TestRunner, name: str, last: int, u_ts: List[int], u_off: List[int], u_dst: List[int], u_ab: str, l_wall: List[int], l_u0: List[int], l_u1: List[int]):
    if Tz.zoneinfo_dir().len() > 0:
        mut r: Result[Tz, str] = Tz.load(name)
        if r.is_ok:
            mut z = r.ok
            t.assert_eq_str(z.source, "tzif", f"{name} loaded from TZif")
            check_vectors(t, z, name, -1, u_ts, u_off, u_dst, u_ab, l_wall, l_u0, l_u1)
        else:
            t.fail(f"Tz.load({name}): {r.err}")
    else:
        t.skip(f"{name}: no zoneinfo directory")
    mut e: Result[Tz, str] = Tz.embedded(name)
    if e.is_ok:
        mut n = check_vectors(t, e.ok, name + " (embedded)", last, u_ts, u_off, u_dst, u_ab, l_wall, l_u0, l_u1)
        t.assert_gt_int(n, 0, f"{name} (embedded): some vectors past the last transition")
    else:
        t.fail(f"Tz.embedded({name}): {e.err}")
    mut hex = ""
    if name == "Pacific/Apia": hex = APIA_HEX
    if name == "Asia/Kathmandu": hex = KATHMANDU_HEX
    if hex.len() > 0:
        mut fr: Result[Tz, str] = Tz.from_tzif(name, Hex.decode(hex))
        if fr.is_ok: check_vectors(t, fr.ok, name + " (embedded TZif)", -1, u_ts, u_off, u_dst, u_ab, l_wall, l_u0, l_u1)
        else: t.fail(f"from_tzif({name}): {fr.err}")

