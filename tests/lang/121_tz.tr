def python_vectors(t: TestRunner):
    vec_new_york(t)
    vec_london(t)
    vec_lord_howe(t)
    vec_kathmandu(t)
    vec_sao_paulo(t)
    vec_casablanca(t)
    vec_apia(t)
    vec_sydney(t)

def posix_rules(t: TestRunner):
    t.section("POSIX TZ strings")
    mut r: Result[TzRule, str] = TzRule.parse("EST5EDT,M3.2.0,M11.1.0")
    t.assert_true(r.is_ok, "EST5EDT parses")
    mut ru = r.ok
    t.assert_eq_str(ru.std_abbr, "EST", "std abbr")
    t.assert_eq_int(ru.std_off, -18000, "std offset east")
    t.assert_true(ru.has_dst, "has dst")
    t.assert_eq_int(ru.dst_off, -14400, "dst offset defaults to std + 1h")
    mut s0, e0 = ru.transitions(2024)
    t.assert_eq_int(s0, 1710054000, "2024 DST start 2024-03-10 07:00Z")
    t.assert_eq_int(e0, 1730613600, "2024 DST end 2024-11-03 06:00Z")

    mut q: Result[Tz, str] = Tz.posix("<+0330>-3:30")
    t.assert_true(q.is_ok, "<+0330>-3:30 parses")
    mut off, dst, ab = q.ok.offset_at(1748736000)
    t.assert_eq_int(off, 12600, "+03:30 offset")
    t.assert_false(dst, "no dst")
    t.assert_eq_str(ab, "+0330", "quoted abbreviation")

    # Julian Jn (Feb 29 never counted) vs zero-based n (counted)
    mut j = TzRule.parse("XXX0YYY,J60/0,J300/0").ok
    mut js, je = j.transitions(2024)
    t.assert_eq_int(js, 1709251200, "J60 in a leap year is Mar 1")
    t.assert_eq_int(je, 1729983600, "J300 in a leap year is Oct 27")
    mut js2, je2 = j.transitions(2023)
    t.assert_eq_int(js2, 1677628800, "J60 in 2023 is Mar 1")
    t.assert_eq_int(je2, 1698361200, "J300 in 2023 is Oct 27")
    mut nn = TzRule.parse("XXX0YYY,59/0,299/0").ok
    mut ns, ne = nn.transitions(2024)
    t.assert_eq_int(ns, 1709164800, "zero-based 59 in a leap year is Feb 29")
    t.assert_eq_int(ne, 1729897200, "zero-based 299 in a leap year is Oct 26")
    mut ns3, ne3 = nn.transitions(2023)
    t.assert_eq_int(ns3, 1677628800, "zero-based 59 in 2023 is Mar 1")

    # negative transition times (America/Nuuk)
    mut nuuk = Tz.posix("<-02>2<-01>,M3.5.0/-1,M10.5.0/0").ok
    mut a1, b1 = nuuk._rule.transitions(2025)
    t.assert_eq_int(a1, 1743296400, "Nuuk 2025 DST start (/-1)")
    t.assert_eq_int(b1, 1761440400, "Nuuk 2025 DST end")
    mut o2, d2, ab2 = nuuk.offset_at(1743296400)
    t.assert_eq_int(o2, -3600, "Nuuk summer offset")
    t.assert_eq_str(ab2, "-01", "Nuuk summer abbreviation")
    mut o3, d3, ab3 = nuuk.offset_at(1743296399)
    t.assert_eq_int(o3, -7200, "Nuuk winter offset one second before")

    # southern hemisphere rule + 30-minute DST (Lord Howe)
    mut lh = Tz.posix("<+1030>-10:30<+11>-11,M10.1.0,M4.1.0").ok
    mut lo, ld, la = lh.offset_at(1735689600)
    t.assert_eq_int(lo, 39600, "Lord Howe January = +11")
    t.assert_true(ld, "Lord Howe January is DST")
    mut lo2, ld2, la2 = lh.offset_at(1751328000)
    t.assert_eq_int(lo2, 37800, "Lord Howe July = +10:30")

    mut fixed = Tz.posix("UTC0").ok
    t.assert_eq_int(fixed.utc_offset_at(0), 0, "UTC0")
    mut m: Result[Tz, str] = Tz.posix(":JST-9")
    t.assert_eq_int(m.ok.utc_offset_at(0), 32400, "leading ':' ignored")
    mut dd: Result[Tz, str] = Tz.posix("PST8PDT")
    t.assert_true(dd.is_ok, "DST without dates uses US rules")
    t.assert_eq_int(dd.ok.utc_offset_at(1720000000), -25200, "PST8PDT July = PDT")

    mut bad: Result[TzRule, str] = TzRule.parse("EST5EDT,M3.2.0")
    t.assert_false(bad.is_ok, "missing end rule rejected")
    bad = TzRule.parse("EST5EDT,M13.1.0,M11.1.0")
    t.assert_false(bad.is_ok, "month 13 rejected")
    bad = TzRule.parse("<+03")
    t.assert_false(bad.is_ok, "unterminated <> rejected")
    bad = TzRule.parse("EST")
    t.assert_false(bad.is_ok, "missing offset rejected")
    bad = TzRule.parse("EST99")
    t.assert_false(bad.is_ok, "offset hour out of range rejected")
    bad = TzRule.parse("EST5EDT,J0,J100")
    t.assert_false(bad.is_ok, "J0 rejected")

def embedded_table(t: TestRunner):
    t.section("embedded table")
    t.assert_eq_str(tz_embedded_rule("America/New_York"), "EST5EDT,M3.2.0,M11.1.0", "New York rule")
    t.assert_eq_str(tz_embedded_rule("Asia/Kathmandu"), "<+0545>-5:45", "Kathmandu rule")
    t.assert_eq_str(tz_embedded_rule("Europe/London"), "GMT0BST,M3.5.0/1,M10.5.0", "London rule")
    t.assert_eq_str(tz_embedded_rule("UTC"), "UTC0", "UTC")
    t.assert_eq_str(tz_embedded_rule("Nowhere/Land"), "", "unknown name")
    t.assert_eq_str(tz_embedded_rule("York"), "", "no partial matches")
    mut names = tz_embedded_names()
    t.assert_gt_int(len(names), 400, "embedded table has 400+ zones")
    t.assert_true(names.contains("Pacific/Apia"), "Pacific/Apia listed")
    t.assert_eq_str(names[0], "Africa/Abidjan", "names are sorted")
    mut e: Result[Tz, str] = Tz.embedded("Asia/Tokyo")
    t.assert_eq_str(e.ok.source, "embedded", "Tz.embedded source")
    t.assert_eq_int(e.ok.utc_offset_at(0), 32400, "Tokyo +9")

def api(t: TestRunner):
    t.section("Tz API and DateTime integration")
    mut u = Tz.utc()
    t.assert_eq_str(u.name, "UTC", "Tz.utc name")
    t.assert_eq_int(u.utc_offset_at(1700000000), 0, "UTC offset")
    t.assert_eq_str(u.to_local(0).isoformat(), "1970-01-01T00:00:00+00:00", "UTC isoformat")
    mut f = Tz.fixed(19800, "")
    t.assert_eq_str(f.name, "+05:30", "fixed name")
    t.assert_eq_str(tz_format_offset(-35100), "-09:45", "tz_format_offset")
    t.assert_eq_str(tz_format_offset(-17762), "-04:56:02", "offset with seconds")

    # Tz.load works with or without a zoneinfo dir (embedded fallback)
    mut ny = Tz.load("America/New_York").ok
    mut tk = Tz.load("Asia/Tokyo").ok
    mut ldn = Tz.load("Europe/London").ok
    mut dt = ny.to_local(1710054000)
    t.assert_eq_str(dt.to_string(), "2024-03-10 03:00:00", "to_local wall fields")
    t.assert_eq_str(dt.isoformat(), "2024-03-10T03:00:00-04:00", "isoformat with offset")
    t.assert_eq_str(dt.to_string_tz(), "2024-03-10 03:00:00 EDT", "to_string_tz")
    t.assert_eq_str(dt.tz.zone, "America/New_York", "DateTime carries the zone name")
    t.assert_true(dt.tz.is_dst, "DateTime carries the DST flag")
    t.assert_eq_int(dt.timestamp(), 1710054000, "instant preserved")
    mut before = ny.to_local(1710053999)
    t.assert_eq_str(before.isoformat(), "2024-03-10T01:59:59-05:00", "one second before the gap")

    mut in_tokyo = tk.convert(dt)
    t.assert_eq_str(in_tokyo.isoformat(), "2024-03-10T16:00:00+09:00", "convert New York -> Tokyo")
    mut in_london = ldn.convert(in_tokyo)
    t.assert_eq_str(in_london.to_string_tz(), "2024-03-10 07:00:00 GMT", "convert Tokyo -> London")
    t.assert_eq_int(in_london.timestamp(), dt.timestamp(), "conversions keep the instant")

    # DST-aware arithmetic: Tz.add re-resolves the offset
    mut sat = ny.from_local(2024, 3, 9, 12, 0, 0)
    mut sun = ny.add(sat, TimeDelta.from_hours(24))
    t.assert_eq_str(sun.isoformat(), "2024-03-10T13:00:00-04:00", "24h across spring-forward")

    # gaps and overlaps
    t.assert_eq_int(ny.classify_local(2024, 3, 10, 2, 30, 0), TZ_LOCAL_NONEXISTENT, "02:30 skipped")
    t.assert_eq_int(ny.classify_local(2024, 11, 3, 1, 30, 0), TZ_LOCAL_AMBIGUOUS, "01:30 repeated")
    t.assert_eq_int(ny.classify_local(2024, 7, 1, 12, 0, 0), TZ_LOCAL_UNIQUE, "noon unique")
    t.assert_eq_str(ny.from_local(2024, 3, 10, 2, 30, 0).isoformat(), "2024-03-10T03:30:00-04:00", "gap, earlier policy")
    t.assert_eq_str(ny.from_local_later(2024, 3, 10, 2, 30, 0).isoformat(), "2024-03-10T01:30:00-05:00", "gap, later policy")
    t.assert_eq_str(ny.from_local(2024, 11, 3, 1, 30, 0).isoformat(), "2024-11-03T01:30:00-04:00", "overlap, earlier")
    t.assert_eq_str(ny.from_local_later(2024, 11, 3, 1, 30, 0).isoformat(), "2024-11-03T01:30:00-05:00", "overlap, later")
    mut g: Result[int, str] = ny.local_to_unix(2024, 3, 10, 2, 30, 0, TZ_RAISE)
    t.assert_false(g.is_ok, "TZ_RAISE on a gap")
    t.assert_contains(g.err, "does not exist", "gap message")
    mut a: Result[int, str] = ny.local_to_unix(2024, 11, 3, 1, 30, 0, TZ_RAISE)
    t.assert_false(a.is_ok, "TZ_RAISE on an overlap")
    t.assert_contains(a.err, "ambiguous", "overlap message")
    mut ok: Result[int, str] = ny.local_to_unix(2024, 7, 1, 12, 0, 0, TZ_RAISE)
    t.assert_eq_int(ok.ok, 1719849600, "TZ_RAISE on a normal time")

    t.assert_eq_int(ny.next_transition(1710054000), 1730613600, "next transition (Nov 2024)")
    t.assert_eq_int(ny.next_transition(4102444800), 4108690800, "next transition in 2100 (rule)")
    t.assert_eq_int(tk.next_transition(1700000000), -1, "Tokyo has no future transitions")

    mut bad: Result[Tz, str] = Tz.load("Nowhere/Atlantis")
    t.assert_false(bad.is_ok, "unknown zone raises")
    bad = Tz.load("../../etc/passwd")
    t.assert_false(bad.is_ok, "path traversal rejected")
    mut px: Result[Tz, str] = Tz.load("CET-1CEST,M3.5.0,M10.5.0/3")
    t.assert_eq_str(px.ok.source, "posix", "Tz.load falls back to POSIX strings")
    t.assert_eq_int(px.ok.utc_offset_at(1720000000), 7200, "CEST in July")

def local_zone(t: TestRunner):
    t.section("Tz.local and Tz.available")
    mut env = Env.init()
    mut saved = env.get_var("TZ")
    mut had = env.has_var("TZ")
    env.set_var("TZ", "Europe/London")
    mut l1: Result[Tz, str] = Tz.local()
    t.assert_eq_str(l1.ok.name, "Europe/London", "TZ=Europe/London")
    env.set_var("TZ", ":Asia/Tokyo")
    mut l2: Result[Tz, str] = Tz.local()
    t.assert_eq_int(l2.ok.utc_offset_at(0), 32400, "TZ=:Asia/Tokyo")
    env.set_var("TZ", "<+0330>-3:30")
    mut l3: Result[Tz, str] = Tz.local()
    t.assert_eq_int(l3.ok.utc_offset_at(0), 12600, "TZ as a POSIX string")
    env.set_var("TZ", "Bogus/Zone")
    mut l4: Result[Tz, str] = Tz.local()
    t.assert_false(l4.is_ok, "unusable TZ raises")
    if Tz.zoneinfo_dir().len() > 0:
        env.set_var("TZ", Tz.zoneinfo_dir() + "/Asia/Kathmandu")
        mut l5: Result[Tz, str] = Tz.local()
        t.assert_eq_str(l5.ok.name, "Asia/Kathmandu", "TZ as an absolute path")
        t.assert_eq_int(l5.ok.utc_offset_at(1700000000), 20700, "Kathmandu +5:45")
    if had: env.set_var("TZ", saved)
    else: env.unset_var("TZ")
    mut l6: Result[Tz, str] = Tz.local()
    t.assert_true(l6.is_ok, "system local zone loads")
    if l6.is_ok: print("  local zone: " + l6.ok.name + " (" + l6.ok.source + ")")

    mut av = Tz.available()
    t.assert_gt_int(len(av), 300, "Tz.available lists zones")
    t.assert_true(av.contains("America/New_York"), "available contains New York")
    t.assert_false(av.contains("posixrules"), "posixrules excluded")

def main():
    mut t = TestRunner.init("121_tz")
    posix_rules(t)
    embedded_table(t)
    api(t)
    local_zone(t)
    t.section("Python zoneinfo vectors")
    python_vectors(t)
    t.summary()
