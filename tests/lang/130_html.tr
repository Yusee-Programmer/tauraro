    v.append("#document\n|  <!DOCTYPE html>\n|  <html>\n|    <head>\n|      <title>\n|        \"<b>x</b>&\"\n|      <style>\n|        \"<!--\"\n|    <body>\n|      \"-->\"")
    v.append("<!doctype html><script><!--<script></script>--></script>x")
    v.append("#document\n|  <!DOCTYPE html>\n|  <html>\n|    <head>\n|      <script>\n|        \"<!--<script></script>-->\"\n|    <body>\n|      \"x\"")
    v.append("<!DOCTYPE html><html lang=en><head><meta charset=utf-8><title>Page</title><link rel=stylesheet href=s.css><script src=a.js></script></head><body><header><nav><ul><li><a href=\"/\">Home</a><li><a href=\"/about\">About</a></ul></nav></header><main><article><h1>Title</h1><p>Some <em>text</em> &mdash; here.<p>More<table><thead><tr><th>A<th>B<tbody><tr><td>1<td>2</table></article></main><footer>&copy; 2026</footer></body></html>\n")
    v.append("#document\n|  <!DOCTYPE html>\n|  <html>\n|    lang=\"en\"\n|    <head>\n|      <meta>\n|        charset=\"utf-8\"\n|      <title>\n|        \"Page\"\n|      <link>\n|        href=\"s.css\"\n|        rel=\"stylesheet\"\n|      <script>\n|        src=\"a.js\"\n|    <body>\n|      <header>\n|        <nav>\n|          <ul>\n|            <li>\n|              <a>\n|                href=\"/\"\n|                \"Home\"\n|            <li>\n|              <a>\n|                href=\"/about\"\n|                \"About\"\n|      <main>\n|        <article>\n|          <h1>\n|            \"Title\"\n|          <p>\n|            \"Some \"\n|            <em>\n|              \"text\"\n|            \" — here.\"\n|          <p>\n|            \"More\"\n|          <table>\n|            <thead>\n|              <tr>\n|                <th>\n|                  \"A\"\n|                <th>\n|                  \"B\"\n|            <tbody>\n|              <tr>\n|                <td>\n|                  \"1\"\n|                <td>\n|                  \"2\"\n|      <footer>\n|        \"© 2026\"\n|      \"\n\"")
    return v

def texts(nodes: List[HtmlNode]) -> str:
    mut out = ""
    mut i = 0
    while i < len(nodes):
        if i > 0: out = out + "|"
        out = out + nodes[i].normalized_text()
        i = i + 1
    return out

def test_entities(t: TestRunner):
    t.section("character references")
    t.assert_eq_int(html_entity_count(), 2231, "entity table size")
    t.assert_eq_str(html_unescape("&amp;&lt;&gt;&quot;&apos;"), "&<>\"'", "basic")
    t.assert_eq_str(html_unescape("&notit; &notin; &not"), "¬it; ∉ ¬", "longest legacy match")
    t.assert_eq_str(html_unescape("&ampx &amp &AMP;"), "&x & &", "legacy without semicolon")
    t.assert_eq_str(html_unescape("&#65;&#x42;&#X43;&#67"), "ABCC", "numeric forms")
    t.assert_eq_str(html_unescape("&#; &#x; &#xZ"), "&#; &#x; &#xZ", "bad numerics stay")
    t.assert_eq_str(html_unescape("&#0; &#128; &#x80; &#xD800; &#x110000; &#99999999999;"), "� € € � � �", "numeric fix-ups")
    t.assert_eq_str(html_unescape("&NotEqualTilde; &nosuch; &"), "≂̸ &nosuch; &", "two code point entity")
    t.assert_eq_str(html_unescape("&eacute&eacutex &copy2025"), "ééx ©2025", "legacy prefix")
    t.assert_eq_str(html_unescape("x&#9;y &#x1F600;"), "x\ty \U0001F600", "tab and astral")
    t.assert_eq_str(html_unescape_attr("?a=1&copy=2&amp;b&notit;"), "?a=1&copy=2&b&notit;", "attribute rule")
    t.assert_eq_str(html_escape("<a href=\"x\">'&'</a>"), "&lt;a href=&quot;x&quot;&gt;&#x27;&amp;&#x27;&lt;/a&gt;", "escape")
    t.assert_eq_str(html_unescape(html_escape("a<b>&\"'é")), "a<b>&\"'é", "escape roundtrip")
    mut e = html_entity("&hearts;")
    t.assert_eq_int(len(e), 1, "html_entity one")
    t.assert_eq_int(e[0], 9829, "hearts")
    t.assert_eq_int(len(html_entity("nosuchthing")), 0, "unknown entity")

def test_tokenizer(t: TestRunner):
    t.section("tokenizer edge cases")
    mut d = html_parse("<div a=1 A=2 b='x&amp;y' c=\"q\"d e =f g>t</div>")
    mut dv = d.select_one("div")
    t.assert_eq_str(dv.attr("a"), "1", "first duplicate wins")
    t.assert_eq_str(dv.attr("b"), "x&y", "entity in attr")
    t.assert_eq_str(dv.attr("c"), "q", "dquoted")
    t.assert_true(dv.has_attr("d"), "attr after quote")
    t.assert_eq_str(dv.attr("e"), "f", "spaces around =")
    t.assert_true(dv.has_attr("g"), "valueless attr")
    mut c = html_parse("<!-->a<!--->b<!-- x --!>c<!----->")
    mut cs = c.body().children()
    t.assert_eq_int(len(cs), 6, "abrupt comments")
    t.assert_true(cs[1].is_comment(), "empty comment")
    t.assert_eq_str(cs[3].data(), " x ", "--!> closes")
    t.assert_eq_str(cs[5].data(), "-", "comment dashes")
    mut dt = html_parse("<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\"><p>x")
    t.assert_eq_str(dt.doctype().data(), "html", "doctype name")
    t.assert_eq_str(dt.doctype().doctype_public_id(), "-//W3C//DTD XHTML 1.0 Strict//EN", "public id")
    t.assert_false(dt.quirks, "no quirks for XHTML strict")
    mut q = html_parse("<p>x")
    t.assert_true(q.quirks, "quirks without doctype")
    mut s = html_parse("<script>if (a<b && x) document.write('</p>');</script><style>a>b{}</style><textarea>&lt;b&gt;</textarea><title>&amp;<b></title>")
    t.assert_eq_str(s.select_one("script").text(), "if (a<b && x) document.write('</p>');", "script raw")
    t.assert_eq_str(s.select_one("style").text(), "a>b{}", "style raw")
    t.assert_eq_str(s.select_one("textarea").text(), "<b>", "textarea rcdata")
    t.assert_eq_str(s.title(), "&<b>", "title rcdata")
    mut sc = html_parse("<script><!--<script></script>--></script><p>after")
    t.assert_eq_str(sc.select_one("script").text(), "<!--<script></script>-->", "script escaped state")
    t.assert_eq_str(sc.select_one("p").text(), "after", "after script")
    mut cr = html_parse("<p>a\r\nb\rc</p>")
    t.assert_eq_str(cr.select_one("p").text(), "a\nb\nc", "newline normalisation")
    mut eof = html_parse("<p>ok<div class=\"unterminated")
    t.assert_eq_str(eof.body().inner_html(), "<p>ok</p>", "tag cut by EOF dropped")
    mut cd = html_parse("<svg><![CDATA[a<b]]></svg><p><![CDATA[x]]>y")
    t.assert_eq_str(cd.select_one("svg").text(), "a<b", "cdata in foreign content")
    t.assert_eq_str(cd.select_one("p").inner_html(), "<!--[CDATA[x]]-->y", "cdata in html is a comment")

def test_tree(t: TestRunner):
    t.section("tree builder vs html5lib")
    mut v = tree_cases()
    mut i = 0
    mut bad = 0
    while i < len(v):
        mut d = html_parse(v[i])
        mut got = d.debug_tree()
        if got != v[i + 1]:
            bad = bad + 1
            print(f"MISMATCH for input: {v[i]}")
            print(got)
            print("-- want --")
            print(v[i + 1])
        i = i + 2
    t.assert_eq_int(bad, 0, "all html5lib trees match")
    t.assert_eq_int(len(v) / 2, 74, "tree case count")

def test_serialize(t: TestRunner):
    t.section("serialization")
    mut d = html_parse("<!DOCTYPE html><html><head><title>t</title></head><body><p class=\"a b\" title='say \"hi\" &amp; <go>'>x &lt; y &amp; z&nbsp;w<br><img src=a.png alt=\"\"></p><pre>\n\nline</pre><script>if(a<b){}</script><!-- c --></body></html>")
    mut html = d.to_html()
    t.assert_eq_str(html, "<!DOCTYPE html><html><head><title>t</title></head><body><p class=\"a b\" title=\"say &quot;hi&quot; &amp; &lt;go&gt;\">x &lt; y &amp; z&nbsp;w<br><img src=\"a.png\" alt=\"\"></p><pre>\n\nline</pre><script>if(a<b){}</script><!-- c --></body></html>", "document serialization")
    mut d2 = html_parse(html)
    t.assert_eq_str(d2.to_html(), html, "reparse is a fixed point")
    t.assert_eq_str(d2.debug_tree(), d.debug_tree(), "same tree after roundtrip")
    mut p = d.select_one("p")
    t.assert_eq_str(p.inner_html(), "x &lt; y &amp; z&nbsp;w<br><img src=\"a.png\" alt=\"\">", "inner_html")
    t.assert_true(p.outer_html().starts_with("<p class="), "outer_html")
    t.assert_eq_str(p.text(), "x < y & z w", "text decodes")
    t.assert_eq_str(p.attr("title"), "say \"hi\" & <go>", "attr decoded")
    mut tricky = html_parse("<p><b>1<i>2</b>3</i>4<table><tr><td>x</table><a href=1>l<a href=2>m")
    mut once = tricky.to_html()
    mut twice = html_parse(once).to_html()
    t.assert_eq_str(twice, once, "misnested markup serializes to a fixed point")

def test_dom(t: TestRunner):
    t.section("DOM navigation and mutation")
    mut d = html_parse("<ul id=l><li class='a b'>one<li>two<!--c--><li class=b>three</ul>")
    mut ul = d.select_one("#l")
    t.assert_eq_str(ul.tag(), "ul", "tag")
    mut kids = ul.child_elements()
    t.assert_eq_int(len(kids), 3, "child_elements")
    t.assert_true(kids[0].has_class("a"), "has_class a")
    t.assert_true(kids[0].has_class("b"), "has_class b")
    t.assert_false(kids[0].has_class("c"), "has_class c")
    t.assert_false(kids[0].has_class("ab"), "has_class substring")
    t.assert_true(kids[1].parent().same(ul), "parent")
    t.assert_true(kids[0].next_sibling().same(kids[1]), "next_sibling")
    t.assert_true(kids[1].prev_element().same(kids[0]), "prev_element")
    t.assert_true(kids[1].last_child().is_comment(), "comment inside li")
    t.assert_true(kids[2].next_sibling().is_null(), "no next")
    t.assert_true(d.document().parent().is_null(), "document has no parent")
    t.assert_eq_str(d.root().tag(), "html", "root")
    t.assert_eq_str(d.head().tag(), "head", "head")
    t.assert_eq_str(d.body().tag(), "body", "body")
    t.assert_eq_int(len(ul.children()), 3, "children")
    t.assert_eq_int(len(ul.attrs()), 1, "attrs")
    mut at = ul.attrs()
    t.assert_eq_str(at[0].name, "id", "attr name")
    kids[1].set_attr("data-x", "1&2")
    t.assert_eq_str(kids[1].outer_html(), "<li data-x=\"1&amp;2\">two<!--c--></li>", "set_attr")
    kids[1].remove_attr("data-x")
    kids[1].remove()
    t.assert_eq_int(len(ul.child_elements()), 2, "remove")
    mut n = d.create_element("LI")
    n.set_text("new <b>")
    ul.append_child(n)
    ul.insert_before(d.create_text("T"), kids[0])
    t.assert_eq_str(ul.inner_html(), "T<li class=\"a b\">one</li><li class=\"b\">three</li><li>new &lt;b&gt;</li>", "append and insert_before")
    mut f = html_parse_fragment("<p>a<p>b")
    t.assert_eq_str(f.inner_html(), "<p>a</p><p>b</p>", "fragment")
    ul.set_inner_html("<li>x<li>y")
    t.assert_eq_str(ul.outer_html(), "<ul id=\"l\"><li>x</li><li>y</li></ul>", "set_inner_html")
    t.assert_eq_int(len(d.root().find_all("LI")), 2, "find_all case-insensitive")
    mut empty = html_parse("")
    t.assert_eq_str(empty.to_html(), "<html><head></head><body></body></html>", "empty input still yields a skeleton")

def test_select(t: TestRunner):
    t.section("CSS selectors")
    mut d = html_parse("<div id=main class='box wide'><h1>T</h1><p class=intro>One</p><p lang=en-US data-k='abc-def'>Two <a href='http://x.org/a.pdf' rel='nofollow external'>A</a></p><p>Three</p><span>S</span><ul><li>1<li class=sel>2<li>3<li>4<li>5</ul></div><div id=other><p>Four</p></div>")
    t.assert_eq_int(len(d.select("p")), 4, "type")
    t.assert_eq_int(len(d.select("P")), 4, "type case-insensitive")
    t.assert_eq_int(len(d.select("*")), len(d.root().descendants()) + 1, "universal")
    t.assert_eq_str(d.select_one("#main").tag(), "div", "id")
    t.assert_eq_int(len(d.select(".box")), 1, "class")
    t.assert_eq_int(len(d.select("div.box.wide")), 1, "compound class")
    t.assert_eq_int(len(d.select("div.box.narrow")), 0, "missing class")
    t.assert_eq_int(len(d.select("[lang]")), 1, "attr exists")
    t.assert_eq_int(len(d.select("[lang=en-US]")), 1, "attr =")
    t.assert_eq_int(len(d.select("[lang='en-US']")), 1, "attr = quoted")
    t.assert_eq_int(len(d.select("[lang|=en]")), 1, "attr |=")
    t.assert_eq_int(len(d.select("[data-k^=abc]")), 1, "attr ^=")
    t.assert_eq_int(len(d.select("[data-k$=def]")), 1, "attr $=")
    t.assert_eq_int(len(d.select("[data-k*=c-d]")), 1, "attr *=")
    t.assert_eq_int(len(d.select("[rel~=external]")), 1, "attr ~=")
    t.assert_eq_int(len(d.select("[rel~=extern]")), 0, "attr ~= whole word")
    t.assert_eq_int(len(d.select("[data-k^=ABC i]")), 1, "attr i flag")
    t.assert_eq_int(len(d.select("[data-k^=ABC]")), 0, "attr case-sensitive")
    t.assert_eq_int(len(d.select("a[href$='.pdf']")), 1, "link by extension")
    t.assert_eq_str(texts(d.select("div > p")), "One|Two A|Three|Four", "child")
    t.assert_eq_str(texts(d.select("#main > a")), "", "child needs direct")
    t.assert_eq_str(texts(d.select("#main p a")), "A", "deep descendant")
    t.assert_eq_str(texts(d.select("h1 + p")), "One", "adjacent")
    t.assert_eq_str(texts(d.select("h1 + span")), "", "adjacent only next")
    t.assert_eq_str(texts(d.select("h1 ~ p")), "One|Two A|Three", "general sibling")
    t.assert_eq_str(texts(d.select("p.intro ~ span")), "S", "general sibling span")
    t.assert_eq_str(texts(d.select("li:first-child")), "1", "first-child")
    t.assert_eq_str(texts(d.select("li:last-child")), "5", "last-child")
    t.assert_eq_str(texts(d.select("li:nth-child(2)")), "2", "nth-child(2)")
    t.assert_eq_str(texts(d.select("li:nth-child(odd)")), "1|3|5", "odd")
    t.assert_eq_str(texts(d.select("li:nth-child(even)")), "2|4", "even")
    t.assert_eq_str(texts(d.select("li:nth-child(2n+1)")), "1|3|5", "2n+1")
    t.assert_eq_str(texts(d.select("li:nth-child(3n)")), "3", "3n")
    t.assert_eq_str(texts(d.select("li:nth-child(-n+2)")), "1|2", "-n+2")
    t.assert_eq_str(texts(d.select("li:nth-child(n+4)")), "4|5", "n+4")
    t.assert_eq_str(texts(d.select("li:nth-last-child(1)")), "5", "nth-last-child")
    t.assert_eq_str(texts(d.select("p:nth-of-type(2)")), "Two A", "nth-of-type")
    t.assert_eq_str(texts(d.select("li:not(.sel)")), "1|3|4|5", ":not")
    t.assert_eq_str(texts(d.select("li:not(:first-child):not(:last-child)")), "2|3|4", "stacked :not")
    t.assert_eq_str(texts(d.select("h1, span, li.sel")), "T|S|2", "selector list in document order")
    t.assert_eq_int(len(d.select("div:has(h1)")), 1, ":has")
    t.assert_eq_str(texts(d.select("p:only-child")), "Four", ":only-child")
    t.assert_eq_int(len(d.select("span:empty")), 0, ":empty")
    t.assert_eq_str(d.select_one("html:root").tag(), "html", ":root")
    t.assert_true(d.select_one("nothing").is_null(), "select_one miss")
    mut li = d.select_one("li.sel")
    t.assert_true(li.matches("ul > li"), "matches")
    t.assert_true(li.closest("div").same(d.select_one("#main")), "closest")
    mut a = d.select_one("#main").select("div")
    t.assert_eq_int(len(a), 0, "select excludes the scope itself")
    mut bad = HtmlSelector.parse_lenient("p[")
    t.assert_false(bad.ok, "invalid selector flagged")
    t.assert_eq_int(len(d.select("p[")), 0, "invalid selector matches nothing")
    mut r: Result[HtmlSelector, str] = HtmlSelector.parse("div >")
    t.assert_false(r.is_ok, "parse error")
    mut ok: Result[HtmlSelector, str] = HtmlSelector.parse("div > p.a, a:not([href])")
    t.assert_true(ok.is_ok, "parse ok")
    t.assert_eq_int(len(html_parse("<p class='a:b'>x").select("p.a\\:b")), 1, "escaped class")

def test_text(t: TestRunner):
    t.section("text extraction")
    mut d = html_parse("<body><h1> Title </h1><p>Para   one\n continues <b>bold</b>, <i>it</i>.</p><p>Two<br>lines</p><ul><li>a<li>b <em>c</em></ul><ol start=3><li>x<li>y</ol><table><tr><th>H1<th>H2<tr><td>1<td>2</table><pre>  p\n   q</pre><script>no()</script><style>x{}</style><!-- c --><img alt=\"pic\" src=x><div>d1</div><div>d2</div></body>")
    mut want = "Title\n\nPara one continues bold, it.\n\nTwo\nlines\n\n- a\n- b c\n\n3. x\n4. y\n\nH1\tH2\n1\t2\n\n  p\n   q\n\npic\nd1\nd2"
    t.assert_eq_str(html_to_text(d.body()), want, "to_text layout")
    t.assert_eq_str(html_strip_tags("<div>a<br>b</div><p>c &amp; d<script>x</script>"), "a\nb\n\nc & d", "strip_tags")
    t.assert_eq_str(html_strip_tags("plain &lt;text&gt;"), "plain <text>", "strip plain")
    t.assert_eq_str(html_strip_tags("<p>x</p><!-- hidden --><p>y</p>"), "x\n\ny", "comment skipped")
    t.assert_eq_str(d.select_one("p").text_ws(true), "Para one continues bold, it.", "normalized text")

def test_links(t: TestRunner):
    t.section("links")
    mut d = html_parse("<head><base href='/dir/'></head><body><a href='page.html'>rel</a> <a href='/abs?x=1#f'>abs</a> <a href='../up'>up</a> <a href='https://other.org/x'>full</a> <a href='//cdn.org/s.js'>proto</a> <a href='mailto:a@b.c'>mail</a> <a href='#frag'>frag</a> <a name=anchor>none</a> <area href='map.html'></body>")
    mut ls = html_links(d, "http://example.com/a/b/c.html?q=1")
    t.assert_eq_int(len(ls), 8, "link count")
    t.assert_eq_str(ls[0].url, "http://example.com/dir/page.html", "relative against <base>")
    t.assert_eq_str(ls[1].url, "http://example.com/abs?x=1#f", "absolute path")
    t.assert_eq_str(ls[2].url, "http://example.com/up", "dot-dot")
    t.assert_eq_str(ls[3].url, "https://other.org/x", "absolute url")
    t.assert_eq_str(ls[4].url, "http://cdn.org/s.js", "scheme-relative")
    t.assert_eq_str(ls[5].url, "mailto:a@b.c", "mailto untouched")
    t.assert_eq_str(ls[0].text, "rel", "link text")
    t.assert_eq_str(ls[7].url, "http://example.com/dir/map.html", "area")
    mut d2 = html_parse("<a href='x/y'>l</a>")
    mut l2 = html_links(d2, "http://h.org/a/b")
    t.assert_eq_str(l2[0].url, "http://h.org/a/x/y", "no <base>")

def test_sanitize(t: TestRunner):
    t.section("sanitizer")
    t.assert_eq_str(html_sanitize_default("<p onclick=\"evil()\" class=x>Hi <b>there</b></p>"), "<p class=\"x\">Hi <b>there</b></p>", "event handler removed")
    t.assert_eq_str(html_sanitize_default("a<script>alert(1)</script>b"), "ab", "script dropped with content")
    t.assert_eq_str(html_sanitize_default("<style>p{}</style><p>x"), "<p>x</p>", "style dropped")
    t.assert_eq_str(html_sanitize_default("<a href=\"javascript:alert(1)\">x</a>"), "<a>x</a>", "javascript: dropped")
    t.assert_eq_str(html_sanitize_default("<a href=\" JaVa\tScript:alert(1)\">x</a>"), "<a>x</a>", "obfuscated javascript:")
    t.assert_eq_str(html_sanitize_default("<a href=\"&#106;avascript:alert(1)\">x</a>"), "<a>x</a>", "entity-encoded javascript:")
    t.assert_eq_str(html_sanitize_default("<a href=\"vbscript:x\">x</a><a href=\"data:text/html,<b>\">y</a>"), "<a>x</a><a>y</a>", "other schemes")
    t.assert_eq_str(html_sanitize_default("<a href=\"https://ok.org/p?a=1&b=2\" target=_blank>x</a>"), "<a href=\"https://ok.org/p?a=1&amp;b=2\">x</a>", "https kept, target dropped")
    t.assert_eq_str(html_sanitize_default("<a href=\"/rel\">x</a><a href=\"mailto:a@b.c\">m</a>"), "<a href=\"/rel\">x</a><a href=\"mailto:a@b.c\">m</a>", "relative and mailto")
    t.assert_eq_str(html_sanitize_default("<img src=\"data:image/png;base64,AAAA\" onerror=x>"), "<img>", "data: images off by default")
    t.assert_eq_str(html_sanitize_default("<iframe src=\"http://x\"></iframe><object data=x></object><embed src=x><form action=x><input name=a><button>b</button></form>"), "b", "dangerous elements gone")
    t.assert_eq_str(html_sanitize_default("<svg><script>x()</script><circle/></svg>t"), "t", "svg dropped")
    t.assert_eq_str(html_sanitize_default("<p style=\"color:red\" id=a>x</p>"), "<p>x</p>", "style and id dropped")
    t.assert_eq_str(html_sanitize_default("<div><span>keep</span><custom-el>unwrapped</custom-el></div>"), "<div><span>keep</span>unwrapped</div>", "unknown element unwrapped")
    t.assert_eq_str(html_sanitize_default("<b>unclosed <i>tags"), "<b>unclosed <i>tags</i></b>", "balanced output")
    t.assert_eq_str(html_sanitize_default("1 < 2 & 3 > 2 <3"), "1 &lt; 2 &amp; 3 &gt; 2 &lt;3", "text escaped")
    t.assert_eq_str(html_sanitize_default("<!-- c --><p>x"), "<p>x</p>", "comments dropped")
    t.assert_eq_str(html_sanitize_default("<img src=\"x.png\" alt=\"a\" width=3 onload=y>"), "<img src=\"x.png\" alt=\"a\" width=\"3\">", "img attrs")
    t.assert_eq_str(html_sanitize_default("<math><mi xlink:href=\"javascript:1\">x</mi></math>"), "", "math dropped")
    t.assert_eq_str(html_sanitize_default("<p>a</p><noscript><img src=x onerror=1></noscript>"), "<p>a</p>", "noscript dropped")
    mut pol = HtmlPolicy.default()
    pol.allow_data_images = true
    t.assert_eq_str(html_sanitize("<img src=\"data:image/png;base64,AAAA\"><img src=\"data:image/svg+xml;base64,AAAA\"><a href=\"data:image/png;base64,AAAA\">x</a>", pol), "<img src=\"data:image/png;base64,AAAA\"><img><a>x</a>", "data: only for images when allowed")
    mut basic = HtmlPolicy.basic()
    t.assert_eq_str(html_sanitize("<h1>T</h1><p>a <b>b</b> <img src=x> <a href=\"http://x.org\" title=t>l</a>", basic), "T<p>a <b>b</b>  <a href=\"http://x.org\">l</a></p>", "basic policy")
    mut custom = HtmlPolicy.empty()
    custom.allow_tags("em, strong")
    custom.allow_tags("a")
    custom.allow_attrs("a", "href")
    custom.allow_schemes("ftp")
    custom.link_rel = "nofollow noopener"
    t.assert_eq_str(html_sanitize("<em>e</em><u>u</u><a href=\"ftp://f.org/x\">f</a><a href=\"gopher://h.org\">h</a>", custom), "<em>e</em>u<a href=\"ftp://f.org/x\" rel=\"nofollow noopener\">f</a><a>h</a>", "custom policy")
    mut empty = HtmlPolicy.empty()
    t.assert_eq_str(html_sanitize("<p>just <b>text</b> &amp; more</p>", empty), "just text &amp; more", "empty policy is text only")
    t.assert_eq_str(html_sanitize_default(html_sanitize_default("<p onclick=a>x<script>y</script><a href=javascript:z>q</a>")), "<p>x<a>q</a></p>", "idempotent")

def test_page(t: TestRunner):
    t.section("real-world style page")
    mut src = PAGE_PART1 + PAGE_PART2
    mut d = html_parse(src)
    t.assert_eq_str(d.title(), "Example Shop - Home & Deals", "title")
    t.assert_eq_str(d.select_one("meta[charset]").attr("charset"), "utf-8", "meta charset")
    t.assert_eq_str(d.select_one("html").attr("lang"), "en", "html lang")
    t.assert_eq_int(len(d.select("nav a")), 3, "nav links")
    t.assert_eq_str(texts(d.select("nav li.active a")), "Home", "active nav")
    t.assert_eq_int(len(d.select("table#specs tbody tr")), 4, "implied tbody rows")
    t.assert_eq_str(texts(d.select("table#specs tr td:nth-child(2)")), "1.2 kg|Blue", "second column")
    t.assert_eq_str(texts(d.select("ul.prices > li")), "$9.99|$19.50|$100", "unclosed li")
    t.assert_eq_str(d.select_one("select[name=qty] option[selected]").attr("value"), "2", "selected option")
    t.assert_eq_int(len(d.select("select option")), 3, "unclosed options")
    t.assert_eq_str(d.select_one("footer small").text(), "© 2026 Example & Co.", "footer entities")
    t.assert_eq_str(d.select_one("article h2 + p").text_ws(true), "First paragraph with bold, a link and emphasis.", "inline mixture")
    t.assert_eq_int(len(d.select("script")), 2, "scripts kept in tree")
    t.assert_false(html_to_text(d.body()).contains("track("), "script text not in readable text")
    mut ls = html_links(d, "https://shop.example.com/store/")
    t.assert_eq_str(ls[0].url, "https://shop.example.com/", "root link")
    t.assert_eq_str(ls[1].url, "https://shop.example.com/store/products?cat=1&page=2", "query with entity")
    mut again = html_parse(d.to_html())
    t.assert_eq_str(again.to_html(), d.to_html(), "page roundtrip is stable")
    t.assert_eq_str(again.debug_tree(), d.debug_tree(), "page tree stable")

def main():
    mut t = TestRunner.init("html")
    test_entities(t)
    test_tokenizer(t)
    test_tree(t)
    test_serialize(t)
    test_dom(t)
    test_select(t)
    test_text(t)
    test_links(t)
    test_sanitize(t)
    test_page(t)
    t.summary()
