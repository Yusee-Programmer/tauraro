# tests/lang/153_intervaltree.tr - std.collections.intervaltree: IntervalTree[T].
# Stabbing and overlap queries cross-checked against brute force under a
# deterministic random insert/remove workload; closed-interval edge cases,
# duplicates, id reuse, class payloads and seed determinism.

from std.test import TestRunner
from std.core.vec import Vec
from std.collections.intervaltree import IntervalTree

class Lcg:
    pub s: int

extend Lcg:
    pub def next(self, m: int) -> int:
        self.s = (self.s * 1103515245 + 12345) % 2147483648
        mut x = self.s / 16
        return x - (x / m) * m

class Job:
    pub name: str
    pub prio: int

def mk(name: str, prio: int) -> Job:
    mut j = Job()
    j.name = name
    j.prio = prio
    return j

def contains_id(v: Vec[int], id: int) -> bool:
    mut i = 0
    while i < v.len:
        if v.get(i) == id: return true
        i = i + 1
    return false

def main():
    mut t = TestRunner.init("153_intervaltree")

    t.section("basics")
    mut it = IntervalTree[str].init()
    t.assert_true(it.is_empty(), "starts empty")
    mut a = it.insert(1, 5, "a")
    mut b = it.insert(4, 9, "b")
    mut c = it.insert(10, 12, "c")
    mut d = it.insert(3, 3, "d")
    t.assert_eq_int(it.len(), 4, "len")
    t.assert_eq_int(it.lo_of(b), 4, "lo_of")
    t.assert_eq_int(it.hi_of(b), 9, "hi_of")
    t.assert_eq_str(it.value_of(c), "c", "value_of")
    t.assert_true(it.contains(a), "contains live id")
    t.assert_false(it.contains(99), "contains unknown id")
    t.assert_false(it.contains(-1), "contains negative id")
    mut s4 = it.stab(4)
    t.assert_eq_int(s4.len, 2, "stab(4) hits a and b")
    t.assert_true(contains_id(s4, a) and contains_id(s4, b), "stab(4) ids")
    t.assert_eq_int(it.stab_count(3), 2, "stab(3): a and the point interval d (b starts at 4)")
    t.assert_eq_int(it.stab_count(5), 2, "closed upper bound: a and b both contain 5")
    t.assert_eq_int(it.stab_count(6), 1, "stab(6): only b")
    t.assert_eq_int(it.stab_count(0), 0, "stab below everything")
    t.assert_eq_int(it.stab_count(13), 0, "stab above everything")
    t.assert_eq_int(it.stab_count(10), 1, "stab at the lower bound of c")
    t.assert_eq_int(it.stab_count(12), 1, "stab at the upper bound of c")
    t.assert_eq_int(it.overlap_count(9, 10), 2, "overlap touching both b's hi and c's lo")
    t.assert_eq_int(it.overlap_count(6, 9), 1, "overlap [6,9] only b")
    t.assert_eq_int(it.overlap_count(13, 20), 0, "overlap beyond all")
    t.assert_true(it.any_overlap(12, 20), "any_overlap touching c")
    t.assert_false(it.any_overlap(13, 20), "no overlap")
    t.assert_eq_int(it.overlap_count(20, 0), 4, "swapped query bounds are normalised")
    t.assert_eq_int(it.span_lo(), 1, "span_lo")
    t.assert_eq_int(it.span_hi(), 12, "span_hi")

    t.section("results are ordered by lo; values helpers")
    mut ov = it.overlap(0, 100)
    t.assert_eq_int(ov.len, 4, "all four")
    t.assert_eq_int(it.lo_of(ov.get(0)), 1, "ordered 0")
    t.assert_eq_int(it.lo_of(ov.get(1)), 3, "ordered 1")
    t.assert_eq_int(it.lo_of(ov.get(2)), 4, "ordered 2")
    t.assert_eq_int(it.lo_of(ov.get(3)), 10, "ordered 3")
    mut vals = it.stab_values(4)
    t.assert_eq_str(vals.get(0), "a", "stab_values[0]")
    t.assert_eq_str(vals.get(1), "b", "stab_values[1]")
    mut ovv = it.overlap_values(9, 11)
    t.assert_eq_int(ovv.len, 2, "overlap_values size")
    t.assert_eq_str(ovv.get(1), "c", "overlap_values order")
    mut idl = it.ids()
    t.assert_eq_int(idl.len, 4, "ids() lists live intervals")

    t.section("remove / reuse / clear")
    t.assert_true(it.remove(b), "remove b")
    t.assert_false(it.remove(b), "second remove is false")
    t.assert_false(it.contains(b), "b is gone")
    t.assert_eq_int(it.stab_count(7), 0, "b no longer found")
    t.assert_eq_int(it.span_hi(), 12, "span_hi after removal")
    t.assert_true(it.remove(c), "remove c")
    t.assert_eq_int(it.span_hi(), 5, "span_hi shrinks (augmentation maintained)")
    mut e = it.insert(100, 200, "e")
    t.assert_eq_int(e, c, "freed slot is reused (most recently freed first)")
    t.assert_eq_str(it.value_of(e), "e", "reused slot holds the new payload")
    t.assert_eq_int(it.stab_count(150), 1, "new interval queryable")
    t.assert_eq_int(it.stab_count(7), 0, "old interval does not reappear")
    it.clear()
    t.assert_true(it.is_empty(), "clear")
    t.assert_eq_int(it.stab_count(150), 0, "nothing after clear")
    mut f = it.insert(1, 2, "f")
    t.assert_eq_int(it.stab_count(1), 1, "usable after clear")
    t.assert_true(it.contains(f), "new id live")

    t.section("duplicates and point intervals")
    mut dup = IntervalTree[int].init()
    dup.insert(5, 5, 1)
    dup.insert(5, 5, 2)
    dup.insert(5, 9, 3)
    dup.insert(9, 5, 4)
    t.assert_eq_int(dup.len(), 4, "duplicates allowed")
    t.assert_eq_int(dup.stab_count(5), 4, "all four contain 5 (last one normalised from (9,5))")
    mut dv = dup.stab_values(5)
    t.assert_eq_int(dv.get(0), 1, "equal-lo ties keep insertion order 0")
    t.assert_eq_int(dv.get(1), 2, "equal-lo ties keep insertion order 1")
    t.assert_eq_int(dv.get(2), 3, "equal-lo ties keep insertion order 2")
    t.assert_eq_int(dv.get(3), 4, "equal-lo ties keep insertion order 3")
    t.assert_eq_int(dup.stab_count(9), 2, "stab(9): the two [5,9]")

    t.section("random workload vs brute force")
    mut rng = Lcg()
    rng.s = 424242
    mut tr = IntervalTree[int].with_seed(17)
    mut live_ids = Vec[int].init(64)
    mut bad = 0
    mut step = 0
    while step < 1500:
        mut op = rng.next(10)
        if op < 6 or live_ids.len == 0:
            mut lo = rng.next(500)
            mut hi = lo + rng.next(60)
            mut id = tr.insert(lo, hi, lo * 1000 + hi)
            live_ids.push(id)
        else:
            mut which = rng.next(live_ids.len)
            mut victim = live_ids.get(which)
            if not tr.remove(victim): bad = bad + 1
            live_ids.remove(which)
        if tr.len() != live_ids.len: bad = bad + 1
        if step - (step / 10) * 10 == 0:
            mut qlo = rng.next(520)
            mut qhi = qlo + rng.next(40)
            mut brute = 0
            mut bi = 0
            while bi < live_ids.len:
                mut cid = live_ids.get(bi)
                if tr.lo_of(cid) <= qhi and tr.hi_of(cid) >= qlo: brute = brute + 1
                bi = bi + 1
            if tr.overlap_count(qlo, qhi) != brute: bad = bad + 1
            mut got = tr.overlap(qlo, qhi)
            if got.len != brute: bad = bad + 1
            if (tr.any_overlap(qlo, qhi)) != (brute > 0): bad = bad + 1
            mut gi = 0
            while gi < got.len:
                mut gid = got.get(gi)
                if not (tr.lo_of(gid) <= qhi and tr.hi_of(gid) >= qlo): bad = bad + 1
                if tr.value_of(gid) != tr.lo_of(gid) * 1000 + tr.hi_of(gid): bad = bad + 1
                if gi > 0 and tr.lo_of(got.get(gi - 1)) > tr.lo_of(gid): bad = bad + 1
                gi = gi + 1
            if tr.stab_count(qlo) != tr.overlap_count(qlo, qlo): bad = bad + 1
        step = step + 1
    t.assert_eq_int(bad, 0, "stab/overlap/any_overlap agree with brute force after 1500 operations")
    t.assert_eq_int(tr.ids().len, live_ids.len, "ids() size equals the live count")

    t.section("class payloads")
    mut jobs = IntervalTree[Job].init()
    mut j1 = jobs.insert(0, 10, mk("build", 1))
    jobs.insert(5, 15, mk("test", 2))
    jobs.insert(20, 30, mk("deploy", 3))
    mut hit = jobs.stab_values(7)
    t.assert_eq_int(hit.len, 2, "two jobs run at t=7")
    t.assert_eq_str(hit.get(0).name, "build", "first payload")
    t.assert_eq_int(hit.get(1).prio, 2, "second payload field")
    jobs.set_value_of(j1, mk("build2", 9))
    t.assert_eq_str(jobs.value_of(j1).name, "build2", "set_value_of replaces a class payload")
    mut churn = 0
    while churn < 300:
        mut jid = jobs.insert(churn, churn + 1, mk("tmp-" + churn.to_str(), churn))
        jobs.remove(jid)
        churn = churn + 1
    t.assert_eq_int(jobs.len(), 3, "churn leaves the original three")
    t.assert_eq_str(jobs.stab_values(25).get(0).name, "deploy", "payload intact after churn")

    t.section("determinism")
    mut p1 = IntervalTree[int].with_seed(99)
    mut p2 = IntervalTree[int].with_seed(99)
    mut w = 0
    while w < 100:
        p1.insert((w * 37) % 101, (w * 37) % 101 + w % 7, w)
        p2.insert((w * 37) % 101, (w * 37) % 101 + w % 7, w)
        w = w + 1
    mut same = true
    mut x = 0
    while x < p1.lft.len:
        if p1.lft.get(x) != p2.lft.get(x) or p1.rgt.get(x) != p2.rgt.get(x): same = false
        x = x + 1
    t.assert_true(same, "same seed + ops => identical tree shape")
    t.assert_eq_int(p1.root, p2.root, "same root")
    t.summary()
