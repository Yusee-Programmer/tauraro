# tests/lang/172_fmt_corpus.tr
# `tauraroc fmt` on real code: a spread of standard-library and compiler-test files
# must format successfully (the formatter itself verifies, per file, that the output
# re-lexes to the identical token stream, parses and is a fixed point), must keep every
# comment, and a second pass over the output must change nothing. The exhaustive
# whole-tree + compiled-program-equivalence check is scripts/fmt_guarantee.sh.

from std.test import TestRunner
from std.core.io import read_file, write_file, file_exists
from std.sys.process import Process
from std.sys.platform import Platform
from std.sys.fs import Fs

def tc_bin() -> str:
    if Platform.is_windows():
        return ".\\tauraroc.exe"
    return "./tauraroc"

def tc_present() -> bool:
    if Platform.is_windows():
        return file_exists("tauraroc.exe")
    return file_exists("tauraroc")

def count_comment_lines(s: str) -> int:
    mut n = 0
    mut parts = s.split("\n")
    mut i = 0
    while i < parts.len:
        if parts.get(i).trim().starts_with("#"):
            n = n + 1
        i = i + 1
    return n

def check_file(t: TestRunner, path: str):
    mut src = read_file(path)
    t.assert_true(src.len() > 0, "readable: " + path)
    mut st = Process.system(tc_bin() + " fmt " + path + " > _t172_out.tr 2>&1")
    t.assert_eq_int(st, 0, "formats: " + path)
    mut once = read_file("_t172_out.tr").replace("\r", "")
    t.assert_true(once.len() > 0, "output not empty: " + path)
    t.assert_eq_int(count_comment_lines(once), count_comment_lines(src.replace("\r", "")), "all standalone comments kept: " + path)
    st = Process.system(tc_bin() + " fmt --check _t172_out.tr > _t172_chk.txt 2>&1")
    t.assert_eq_int(st, 0, "second pass is a no-op: " + path)

def main():
    mut t = TestRunner.init("172_fmt_corpus")
    if not tc_present():
        t.skip("tauraroc binary not found in the working directory")
        t.summary()
        return
    check_file(t, "std/collections/set.tr")
    check_file(t, "std/async/retry.tr")
    check_file(t, "std/net/http.tr")
    check_file(t, "std/encoding/json.tr")
    check_file(t, "std/compress/zstd.tr")
    check_file(t, "std/core/string.tr")
    check_file(t, "tests/lang/01_core_language.tr")
    check_file(t, "tests/lang/58_cache.tr")
    check_file(t, "src/lexer.tr")
    check_file(t, "src/srclex.tr")
    check_file(t, "examples/20_closures.tr")
    Fs.delete("_t172_out.tr")
    Fs.delete("_t172_chk.txt")
    t.summary()
