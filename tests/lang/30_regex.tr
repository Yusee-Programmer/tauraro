# tests/lang/30_regex.tr - std.regex (POSIX ERE wrapper): capture groups,
# named groups, Match objects, backreference replace, and every pre-existing
# whole-match method (match/find/find_all/replace/count/contains/split).

from std.test import TestRunner
from std.regex import Regex, Captures, Match

def main():
    mut t = TestRunner.init("30_regex")

    t.section("pre-existing: match/contains")
    mut re1 = Regex.compile("^[a-z]+$")
    t.assert_true(re1.match("hello"), "match: whole-string match")
    t.assert_false(re1.match("Hello"), "match: case-sensitive rejects capital")
    t.assert_true(re1.contains("hello"), "contains: substring present")
    re1.free()

    t.section("pre-existing: compile_icase")
    mut ci = Regex.compile_icase("hello")
    t.assert_true(ci.match("HELLO"), "compile_icase: case-insensitive match")
    ci.free()

    t.section("pre-existing: find / find_start / find_len")
    mut re2 = Regex.compile("[0-9]+")
    mut start = re2.find_start("abc123def", 0)
    t.assert_eq_int(start, 3, "find_start locates digits")
    mut len_ = re2.find_len("abc123def", start)
    t.assert_eq_int(len_, 3, "find_len measures digit run")
    t.assert_eq_str(re2.find("abc123def", 0), "123", "find returns matched substring")
    re2.free()

    t.section("pre-existing: find_all")
    mut words_re = Regex.compile("[A-Za-z]+")
    mut words = words_re.find_all("hello, world! foo")
    t.assert_eq_int(words.len, 3, "find_all: three words found")
    t.assert_eq_str(words.get(0), "hello", "find_all word 0")
    t.assert_eq_str(words.get(1), "world", "find_all word 1")
    t.assert_eq_str(words.get(2), "foo", "find_all word 2")
    words_re.free()

    t.section("pre-existing: replace_first / replace_all")
    mut email_re = Regex.compile("[a-z]+@[a-z]+\\.[a-z]+")
    mut redacted = email_re.replace_all("contact alice@example.com or bob@test.org", "[email]")
    t.assert_eq_str(redacted, "contact [email] or [email]", "replace_all redacts both emails")
    mut redacted1 = email_re.replace_first("contact alice@example.com or bob@test.org", "[email]")
    t.assert_eq_str(redacted1, "contact [email] or bob@test.org", "replace_first redacts only first")
    email_re.free()

    t.section("pre-existing: count")
    mut digit_re = Regex.compile("[0-9]+")
    t.assert_eq_int(digit_re.count("a1 b22 c333"), 3, "count: three digit runs")
    digit_re.free()

    t.section("pre-existing: split")
    mut ws = Regex.compile("[ \t]+")
    mut parts = ws.split("one   two\tthree")
    t.assert_eq_int(parts.len, 3, "split: three pieces")
    t.assert_eq_str(parts.get(0), "one", "split piece 0")
    t.assert_eq_str(parts.get(1), "two", "split piece 1")
    t.assert_eq_str(parts.get(2), "three", "split piece 2")
    ws.free()

    t.section("new: numbered capture groups")
    mut pair_re = Regex.compile("([0-9]+)-([0-9]+)")
    mut caps = pair_re.captures("range 12-34 end", 0)
    t.assert_true(caps.matched(), "captures: match succeeded")
    t.assert_eq_int(caps.len(), 3, "captures: group0 + 2 groups = 3 slots")
    t.assert_eq_str(caps.group(0), "12-34", "captures: group 0 is whole match")
    t.assert_eq_str(caps.group(1), "12", "captures: group 1")
    t.assert_eq_str(caps.group(2), "34", "captures: group 2")
    t.assert_true(caps.has(1), "captures: group 1 participated")
    caps.free()

    t.section("new: capture group that did not participate")
    mut alt_re = Regex.compile("(abc)|([0-9]+)")
    mut caps2 = alt_re.captures("999", 0)
    t.assert_true(caps2.matched(), "alternation: match succeeded")
    t.assert_false(caps2.has(1), "alternation: group 1 (abc) did not participate")
    t.assert_true(caps2.has(2), "alternation: group 2 (digits) participated")
    t.assert_eq_str(caps2.group(1), "", "alternation: unmatched group is empty string")
    t.assert_eq_str(caps2.group(2), "999", "alternation: matched group has value")
    caps2.free()
    alt_re.free()

    t.section("new: no match")
    mut caps3 = pair_re.captures("no digits here", 0)
    t.assert_false(caps3.matched(), "captures: no match reports matched()==false")
    caps3.free()
    pair_re.free()

    t.section("new: named capture groups (?<name>...)")
    mut date_re = Regex.compile("(?<year>[0-9]{4})-(?<month>[0-9]{2})-(?<day>[0-9]{2})")
    mut dcaps = date_re.captures("date: 2026-09-16!", 0)
    t.assert_true(dcaps.matched(), "named groups: match succeeded")
    t.assert_eq_str(dcaps.get("year"), "2026", "named group: year")
    t.assert_eq_str(dcaps.get("month"), "09", "named group: month")
    t.assert_eq_str(dcaps.get("day"), "16", "named group: day")
    t.assert_eq_str(dcaps.group(1), "2026", "named group also reachable by number")
    t.assert_eq_str(dcaps.get("nope"), "", "unknown name returns empty string")
    dcaps.free()
    date_re.free()

    t.section("new: named capture groups (?P<name>...) Python-style")
    mut py_re = Regex.compile("(?P<key>[a-z]+)=(?P<val>[0-9]+)")
    mut pcaps = py_re.captures("width=42", 0)
    t.assert_true(pcaps.matched(), "python-style named groups: match succeeded")
    t.assert_eq_str(pcaps.get("key"), "width", "python-style named group: key")
    t.assert_eq_str(pcaps.get("val"), "42", "python-style named group: val")
    pcaps.free()
    py_re.free()

    t.section("new: mixed named + unnamed groups")
    mut mix_re = Regex.compile("([a-z]+)-(?<num>[0-9]+)")
    mut mcaps = mix_re.captures("item-77", 0)
    t.assert_eq_str(mcaps.group(1), "item", "mixed: unnamed group 1 by number")
    t.assert_eq_str(mcaps.get("num"), "77", "mixed: named group by name")
    t.assert_eq_str(mcaps.group(2), "77", "mixed: named group still reachable by number")
    mcaps.free()
    mix_re.free()

    t.section("new: Match-based find")
    mut m_re = Regex.compile("([a-z]+)@([a-z]+)")
    mut m = m_re.find_match("contact alice@example end", 0)
    t.assert_eq_str(m.text(), "alice@example", "find_match: whole match text")
    t.assert_eq_int(m.start(), 8, "find_match: start offset")
    t.assert_eq_str(m.group(1), "alice", "find_match: group 1")
    t.assert_eq_str(m.group(2), "example", "find_match: group 2")
    m.free()

    t.section("new: find_all_matches")
    mut all_re = Regex.compile("([0-9]+)")
    mut matches = all_re.find_all_matches("a1 b22 c333")
    t.assert_eq_int(matches.len, 3, "find_all_matches: three matches")
    t.assert_eq_str(matches.get(0).text(), "1", "find_all_matches: match 0 text")
    t.assert_eq_str(matches.get(1).text(), "22", "find_all_matches: match 1 text")
    t.assert_eq_str(matches.get(2).group(1), "333", "find_all_matches: match 2 group 1")
    mut mi = 0
    while mi < matches.len:
        matches.get(mi).free()
        mi = mi + 1
    all_re.free()
    m_re.free()

    t.section("new: backreference replace ($1, $2)")
    mut swap_re = Regex.compile("([a-z]+)-([a-z]+)")
    mut swapped = swap_re.replace_first_expand("foo-bar end", "$2-$1")
    t.assert_eq_str(swapped, "bar-foo end", "replace_first_expand: swapped groups")
    mut swapped_all = swap_re.replace_all_expand("foo-bar baz-qux", "$2-$1")
    t.assert_eq_str(swapped_all, "bar-foo qux-baz", "replace_all_expand: swapped both pairs")
    swap_re.free()

    t.section("new: backreference replace with named groups ($name)")
    mut nm_re = Regex.compile("(?<first>[a-z]+)-(?<second>[a-z]+)")
    mut nm_out = nm_re.replace_first_expand("alpha-beta", "$second then $first")
    t.assert_eq_str(nm_out, "beta then alpha", "replace_first_expand: named backreferences")
    nm_re.free()

    t.section("new: literal $$ in replacement")
    mut dollar_re = Regex.compile("([0-9]+)")
    mut dollar_out = dollar_re.replace_first_expand("cost 42", "$$$1")
    t.assert_eq_str(dollar_out, "cost $42", "replace_first_expand: literal $$ then group")
    dollar_re.free()

    t.summary()
