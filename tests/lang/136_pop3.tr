# tests/lang/136_pop3.tr
# std.net.pop3 against a scripted in-process fake POP3 server on 127.0.0.1 (own thread,
# port searched in a small range, every wait bounded). No real network.

from std.test import TestRunner
from std.core.vec import Vec
from std.core.string import StringBuilder
from std.sys.time import Clock
from std.crypto.hash import Hash
from std.net.tcp import TcpListener
from std.net.tcp import TcpStream
from std.net.mailio import MailConn
from std.net.mailio import mail_header
from std.net.mailio import mail_header_block
from std.net.mailio import mail_body_part
from std.net.wire import wire_u8
from std.net.wire import wire_slice
from std.net.pop3 import Pop3Client
from std.net.pop3 import Pop3Entry

class SrvState implements Sendable:
    pub base_port: int
    pub port:      Atomic[int]
    pub stop:      Atomic[int]
    pub mode:      Atomic[int]     # 0 normal, 1 truncate RETR 1, 2 silent after greeting, 3 -ERR greeting
    pub committed: Atomic[int]     # messages deleted by a QUIT
    pub conns:     Atomic[int]

extend SrvState:
    pub def init(base_port: int) -> SrvState:
        mut s = SrvState()
        s.base_port = base_port
        s.port      = Atomic.new(0)
        s.stop      = Atomic.new(0)
        s.mode      = Atomic.new(0)
        s.committed = Atomic.new(0)
        s.conns     = Atomic.new(0)
        return s

def message(i: int) -> str:
    mut sb = StringBuilder.init(256)
    if i == 1:
        sb.append("From: alice@example.com\r\nTo: bob@example.com\r\nSubject: Hello there\r\n\r\nline one\r\n.dot line\r\n..two dots\r\nlast line\r\n")
    elif i == 2:
        sb.append("From: carol@example.com\r\nSubject: A very\r\n long folded\r\n\ttitle\r\nX-Bin: yes\r\n\r\n")
        mut k = 0
        while k < 300:
            if k % 256 != 10 and k % 256 != 13: sb.append_char(k % 256)
            k = k + 1
        sb.append("\r\n.\r\nend\r\n")
    else:
        sb.append("Subject: big\r\n\r\n")
        mut j = 0
        while j < 3000:
            sb.append("0123456789 0123456789 0123456789 line ")
            sb.append(j.to_string())
            sb.append("\r\n")
            j = j + 1
    mut out = sb.to_owned()
    sb.free()
    return out

def same(a: str, b: str) -> bool:
    if a.len() != b.len(): return false
    mut i = 0
    while i < a.len():
        if wire_u8(a, i) != wire_u8(b, i): return false
        i = i + 1
    return true

# dot-stuff a CRLF text and terminate with ".\r\n"
def multiline(msg: str, max_lines: int) -> str:
    mut sb = StringBuilder.init(msg.len() + 64)
    mut pos = 0
    mut n = msg.len()
    mut lines = 0
    while pos < n:
        if max_lines >= 0 and lines >= max_lines: break
        mut e = pos
        while e < n and wire_u8(msg, e) != 10: e = e + 1
        mut line = wire_slice(msg, pos, e + 1 - pos)
        if wire_u8(line, 0) == 46: sb.append(".")
        sb.append(line)
        pos = e + 1
        lines = lines + 1
    sb.append(".\r\n")
    mut out = sb.to_owned()
    sb.free()
    return out

def body_lines_limit(msg: str, lines: int) -> str:
    # headers + blank line + first `lines` body lines
    mut hb = mail_header_block(msg)
    mut rest = mail_body_part(msg)
    mut sb = StringBuilder.init(msg.len())
    sb.append(hb)
    sb.append("\r\n")
    mut pos = 0
    mut k = 0
    while pos < rest.len() and k < lines:
        mut e = pos
        while e < rest.len() and wire_u8(rest, e) != 10: e = e + 1
        sb.append(wire_slice(rest, pos, e + 1 - pos))
        pos = e + 1
        k = k + 1
    mut out = sb.to_owned()
    sb.free()
    return multiline(out, -1)

def handle(st: Shared[SrvState], c: MailConn, mode: int):
    if mode == 3:
        c.send("-ERR server busy\r\n")
        c.close()
        return
    mut stamp = "<1896.697170952@test.local>"
    c.send("+OK POP3 test server ready " + stamp + "\r\n")
    mut authed = false
    mut user_ok = false
    mut gone1 = false
    mut gone2 = false
    mut gone3 = false
    mut cap = Clock.now_ms() + 20000
    while Clock.now_ms() < cap and st.stop.load() == 0:
        mut r: Result[str, str] = c.read_line()
        if r.is_err:
            if r.err == "timeout": continue
            break
        mut line = r.ok
        if mode == 2: continue
        if line.starts_with("USER "):
            user_ok = line == "USER alice"
            if user_ok: c.send("+OK\r\n")
            else: c.send("-ERR no such user\r\n")
        elif line.starts_with("PASS "):
            if user_ok and line == "PASS s3cret":
                authed = true
                c.send("+OK logged in\r\n")
            else:
                c.send("-ERR bad password\r\n")
        elif line.starts_with("APOP "):
            mut want = "APOP alice " + Hash.md5(stamp + "s3cret")
            if line == want:
                authed = true
                c.send("+OK apop ok\r\n")
            else:
                c.send("-ERR apop failed\r\n")
        elif line == "CAPA":
            c.send("+OK capabilities\r\nTOP\r\nUIDL\r\nUSER\r\nPIPELINING\r\n.\r\n")
        elif not authed and line != "QUIT":
            c.send("-ERR not authenticated\r\n")
        elif line == "STAT":
            mut cnt = 0
            mut tot = 0
            if not gone1:
                cnt = cnt + 1
                tot = tot + message(1).len()
            if not gone2:
                cnt = cnt + 1
                tot = tot + message(2).len()
            if not gone3:
                cnt = cnt + 1
                tot = tot + message(3).len()
            c.send("+OK " + cnt.to_string() + " " + tot.to_string() + "\r\n")
        elif line == "LIST":
            mut sb = StringBuilder.init(128)
            sb.append("+OK scan listing follows\r\n")
            if not gone1: sb.append("1 " + message(1).len().to_string() + "\r\n")
            if not gone2: sb.append("2 " + message(2).len().to_string() + "\r\n")
            if not gone3: sb.append("3 " + message(3).len().to_string() + "\r\n")
            sb.append(".\r\n")
            c.send(sb.to_owned())
            sb.free()
        elif line.starts_with("LIST "):
            mut n = line.slice(5, line.len()).parse_int()
            if n >= 1 and n <= 3: c.send("+OK " + n.to_string() + " " + message(n).len().to_string() + "\r\n")
            else: c.send("-ERR no such message\r\n")
        elif line == "UIDL":
            c.send("+OK\r\n1 uid-aaa\r\n2 uid-bbb\r\n3 uid-ccc\r\n.\r\n")
        elif line.starts_with("RETR "):
            mut n2 = line.slice(5, line.len()).parse_int()
            if n2 < 1 or n2 > 3 or (n2 == 1 and gone1) or (n2 == 2 and gone2) or (n2 == 3 and gone3):
                c.send("-ERR no such message\r\n")
            elif mode == 1 and n2 == 1:
                c.send("+OK\r\nFrom: cut@off\r\n\r\nhalf a mess")
                c.close()
                return
            else:
                mut m = message(n2)
                c.send("+OK " + m.len().to_string() + " octets\r\n" + multiline(m, -1))
        elif line.starts_with("TOP "):
            mut sp = line.slice(4, line.len())
            mut at = sp.index_of(" ")
            mut n3 = sp.slice(0, at).parse_int()
            mut k = sp.slice(at + 1, sp.len()).parse_int()
            if n3 < 1 or n3 > 3:
                c.send("-ERR no such message\r\n")
            else:
                c.send("+OK top of message follows\r\n" + body_lines_limit(message(n3), k))
        elif line.starts_with("DELE "):
            mut n4 = line.slice(5, line.len()).parse_int()
            if n4 == 1 and not gone1:
                gone1 = true
                c.send("+OK deleted\r\n")
            elif n4 == 2 and not gone2:
                gone2 = true
                c.send("+OK deleted\r\n")
            elif n4 == 3 and not gone3:
                gone3 = true
                c.send("+OK deleted\r\n")
            else:
                c.send("-ERR no such message\r\n")
        elif line == "RSET":
            gone1 = false
            gone2 = false
            gone3 = false
            c.send("+OK reset\r\n")
        elif line == "NOOP":
            c.send("+OK\r\n")
        elif line == "QUIT":
            mut del = 0
            if gone1: del = del + 1
            if gone2: del = del + 1
            if gone3: del = del + 1
            st.committed.add(del)
            c.send("+OK bye\r\n")
            break
        else:
            c.send("-ERR unknown command\r\n")
    c.close()

def srv_run(st: Shared[SrvState]):
    mut lst = TcpListener.listen("127.0.0.1", st.base_port)
    mut tries = 0
    while not lst.is_listening() and tries < 30:
        tries = tries + 1
        lst = TcpListener.listen("127.0.0.1", st.base_port + tries)
    if not lst.is_listening():
        st.port.store(-1)
        return
    lst.set_nonblocking()
    st.port.store(st.base_port + tries)
    mut cap = Clock.now_ms() + 90000
    while st.stop.load() == 0 and Clock.now_ms() < cap:
        mut s = lst.accept_nb()
        if s.fd < 0:
            Clock.sleep_ms(5)
            continue
        st.conns.add(1)
        mut conn = MailConn.from_stream(s, 300)
        handle(st, conn, st.mode.load())
    lst.close()

def main():
    mut t = TestRunner.init("136_pop3")

    t.section("header helpers")
    mut raw = "Subject: A very\r\n long folded\r\n\ttitle\r\nFrom:  x@y \r\nsubject: second\r\n\r\nSubject: in body\r\n"
    t.assert_eq_str(mail_header(raw, "subject"), "A very long folded title", "unfolds continuation lines, case-insensitive name")
    t.assert_eq_str(mail_header(raw, "FROM"), "x@y", "trims whitespace")
    t.assert_eq_str(mail_header(raw, "Cc"), "", "absent header is empty")
    t.assert_eq_str(mail_body_part(raw), "Subject: in body\r\n", "body part")
    t.assert_eq_str(mail_header_block("A: b\n\nbody"), "A: b\n", "bare LF header block")
    t.assert_eq_str(mail_body_part("A: b\n\nbody"), "body", "bare LF body")

    shared st = SrvState.init(19850)
    mut srv_t = Thread.spawn(srv_run, st)
    mut waited = 0
    while st.port.load() == 0 and waited < 3000:
        Clock.sleep_ms(10)
        waited = waited + 10
    mut port = st.port.load()
    t.assert_gt_int(port, 0, "fake POP3 server bound a loopback port")
    if port <= 0:
        st.stop.store(1)
        srv_t.join()
        t.summary()
        return

    t.section("login and mailbox")
    mut c = Pop3Client.connect("127.0.0.1", port)
    t.assert_true(c.ok, "connected")
    t.assert_contains(c.greeting, "ready", "greeting text")
    c.set_timeout(5000)
    mut bad: Result[bool, str] = c.login("alice", "wrong")
    t.assert_true(bad.is_err, "wrong password rejected")
    t.assert_contains(bad.err, "bad password", "server -ERR text is in the error")
    mut cap: Result[Vec[str], str] = c.capa()
    t.assert_true(cap.is_ok, "CAPA")
    t.assert_eq_int(cap.ok.len(), 4, "four capability lines")
    t.assert_eq_str(cap.ok.get(0), "TOP", "first capability")
    mut lg: Result[bool, str] = c.login("alice", "s3cret")
    t.assert_true(lg.is_ok, "login")
    mut stt: Result[bool, str] = c.stat()
    t.assert_true(stt.is_ok, "STAT")
    t.assert_eq_int(c.count, 3, "3 messages")
    t.assert_eq_int(c.octets, message(1).len() + message(2).len() + message(3).len(), "total octets")
    mut ls: Result[Vec[Pop3Entry], str] = c.list()
    t.assert_true(ls.is_ok, "LIST")
    t.assert_eq_int(ls.ok.len(), 3, "three entries")
    t.assert_eq_int(ls.ok.get(1).num, 2, "entry number")
    t.assert_eq_int(ls.ok.get(1).size, message(2).len(), "entry size")
    mut one: Result[Pop3Entry, str] = c.list_one(3)
    t.assert_eq_int(one.ok.size, message(3).len(), "LIST 3 size")
    mut missing: Result[Pop3Entry, str] = c.list_one(9)
    t.assert_true(missing.is_err, "LIST 9 -> -ERR")
    mut ul: Result[Vec[Pop3Entry], str] = c.uidl()
    t.assert_eq_str(ul.ok.get(2).uid, "uid-ccc", "UIDL")
    t.assert_eq_int(ul.ok.get(0).num, 1, "UIDL numbering")

    t.section("retrieve")
    mut m1: Result[str, str] = c.retr(1)
    t.assert_true(m1.is_ok, "RETR 1")
    t.assert_true(same(m1.ok, message(1)), "message 1 byte-identical (dot-stuffing undone)")
    t.assert_eq_str(mail_header(m1.ok, "Subject"), "Hello there", "Subject")
    mut m2: Result[str, str] = c.retr(2)
    t.assert_true(same(m2.ok, message(2)), "binary message 2 byte-identical (NUL, high bytes, lone dot line)")
    t.assert_eq_str(mail_header(m2.ok, "subject"), "A very long folded title", "folded subject of message 2")
    mut m3: Result[str, str] = c.retr(3)
    t.assert_true(m3.is_ok, "RETR 3 (large)")
    t.assert_eq_int(m3.ok.len(), message(3).len(), "large message length")
    t.assert_true(same(m3.ok, message(3)), "large message byte-identical")
    mut tp: Result[str, str] = c.top(1, 2)
    t.assert_true(tp.is_ok, "TOP 1 2")
    t.assert_true(same(tp.ok, "From: alice@example.com\r\nTo: bob@example.com\r\nSubject: Hello there\r\n\r\nline one\r\n.dot line\r\n"), "TOP returns headers + 2 body lines")
    mut t0: Result[str, str] = c.top(1, 0)
    t.assert_eq_str(mail_body_part(t0.ok), "", "TOP 1 0 has no body")
    mut nomsg: Result[str, str] = c.retr(7)
    t.assert_true(nomsg.is_err, "RETR 7 -> -ERR")

    t.section("delete, reset, quit")
    mut d1: Result[bool, str] = c.dele(1)
    t.assert_true(d1.is_ok, "DELE 1")
    mut d1b: Result[bool, str] = c.dele(1)
    t.assert_true(d1b.is_err, "DELE 1 again -> -ERR")
    mut gone: Result[str, str] = c.retr(1)
    t.assert_true(gone.is_err, "deleted message cannot be retrieved")
    mut rs: Result[bool, str] = c.rset()
    t.assert_true(rs.is_ok, "RSET")
    mut back: Result[str, str] = c.retr(1)
    t.assert_true(back.is_ok, "message is back after RSET")
    c.dele(2)
    c.dele(3)
    mut np: Result[bool, str] = c.noop()
    t.assert_true(np.is_ok, "NOOP")
    t.assert_true(c.quit(), "QUIT answered +OK")
    mut w2 = 0
    while st.committed.load() < 2 and w2 < 2000:
        Clock.sleep_ms(10)
        w2 = w2 + 10
    t.assert_eq_int(st.committed.load(), 2, "server committed the two deletions on QUIT")

    t.section("APOP and auth failures")
    mut c2 = Pop3Client.connect("127.0.0.1", port)
    mut ap: Result[bool, str] = c2.apop("alice", "s3cret")
    t.assert_true(ap.is_ok, "APOP with the greeting timestamp")
    mut st2: Result[bool, str] = c2.stat()
    t.assert_true(st2.is_ok, "STAT after APOP")
    c2.quit()
    mut c3 = Pop3Client.connect("127.0.0.1", port)
    mut ap2: Result[bool, str] = c3.apop("alice", "nope")
    t.assert_true(ap2.is_err, "APOP with a wrong password rejected")
    mut un: Result[bool, str] = c3.stat()
    t.assert_true(un.is_err, "STAT before login rejected by the server")
    c3.quit()

    t.section("failure modes")
    st.mode.store(3)
    mut cb = Pop3Client.connect("127.0.0.1", port)
    t.assert_false(cb.ok, "-ERR greeting => not ok")
    t.assert_contains(cb.err, "busy", "greeting error text")
    cb.quit()
    st.mode.store(1)
    mut ct = Pop3Client.connect("127.0.0.1", port)
    ct.set_timeout(2000)
    ct.login("alice", "s3cret")
    mut cut: Result[str, str] = ct.retr(1)
    t.assert_true(cut.is_err, "connection closed mid-message => error, no hang")
    t.assert_contains(cut.err, "closed", "error says the connection closed")
    ct.quit()
    st.mode.store(2)
    mut cs = Pop3Client.connect("127.0.0.1", port)
    cs.set_timeout(250)
    mut t0ms = Clock.now_ms()
    mut sil: Result[bool, str] = cs.login("alice", "s3cret")
    mut spent = Clock.now_ms() - t0ms
    t.assert_true(sil.is_err, "silent server => error")
    t.assert_eq_str(sil.err, "timeout", "timeout reported")
    t.assert_in_range(spent, 200, 3000, "waited about the timeout (bounded)")
    cs.quit()
    mut refused = Pop3Client.connect("127.0.0.1", 9)
    t.assert_false(refused.ok, "nothing listening => ok=false")

    st.stop.store(1)
    srv_t.join()
    t.summary()
