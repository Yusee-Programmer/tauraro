def rfc_check(t: TestRunner, curve: EcCurve, d: str, alg: str, text: str, r_hex: str, s_hex: str) throws str:
    mut k = Ecdsa.private_from_scalar(curve, hx(d))?
    mut m = Bytes.from_str(text)
    mut sg = Ecdsa.sign_digest_sig(k, alg, PkHash.digest(alg, m))?
    t.assert_eq_str(bn_to_hex(sg.r), r_hex, f"RFC 6979 r ({curve.name}/{alg}/{text})")
    t.assert_eq_str(bn_to_hex(sg.s), s_hex, f"RFC 6979 s ({curve.name}/{alg}/{text})")
    t.assert_true(Ecdsa.verify(k.public_key(), alg, m, Ecdsa.sig_to_der(sg.r, sg.s)), f"verify RFC vector {text}")

def rfc_test(t: TestRunner) throws str -> int:
    t.section("ecdsa: RFC 6979 deterministic vectors")
    mut x256 = "C9AFA9D845BA75166B5C215767B1D6934E50C3DB36E89B127B8A622B120F6721"
    rfc_check(t, Ecdsa.p256(), x256, "sha256", "sample", "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716", "f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")?
    rfc_check(t, Ecdsa.p256(), x256, "sha256", "test", "f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367", "019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083")?
    mut x384 = "6B9D3DAD2E1B8C1C05B19875B6659F4DE23C3B667BF297BA9AA47740787137D896D5724E4C70A825F872C9EA60D2EDF5"
    rfc_check(t, Ecdsa.p384(), x384, "sha384", "sample", "94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe46", "99ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8")?
    rfc_check(t, Ecdsa.p384(), x384, "sha256", "sample", "21b13d1e013c7fa1392d03c5f99af8b30c570c6f98d4ea8e354b63a21d3daa33bde1e888e63355d92fa2b3c36d8fb2cd", "f3aa443fb107745bf4bd77cb3891674632068a10ca67e3d45db2266fa7d1feebefdc63eccd1ac42ec0cb8668a4fa0ab0")?
    # public point of the RFC key (RFC 6979 A.2.5)
    mut k = Ecdsa.private_from_scalar(Ecdsa.p256(), hx(x256))?
    t.assert_eq_str(Bytes.to_hex(k.public_key().to_point(false)), "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299", "RFC 6979 public key")
    # the nonce from the RFC drives sign_with_k to the same r
    mut kk = hx("A6E3C57DD01ABE90086538398355DD4C3B17AA873382B0F24D6129493D8AAD60")
    mut sg = Ecdsa.sign_with_k(k, PkHash.digest("sha256", Bytes.from_str("sample")), bn_of(kk))
    t.assert_eq_str(bn_to_hex(sg.r), "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716", "sign_with_k r")
    return 0

def bn_of(b: Vec[int]) -> Vec[int]:
    return bn_from_bytes(b)

def bn_bytes(v: Vec[int], n: int) -> Vec[int]:
    return bn_to_bytes(v, n)

def pick(n: str, what: str) -> str:
    if n == "a256":
        if what == "sec1": return a256_sec1()
        if what == "p8": return a256_p8()
        if what == "pub": return a256_pub()
        if what == "d": return a256_d()
        if what == "x": return a256_x()
        return a256_y()
    if n == "b256":
        if what == "sec1": return b256_sec1()
        if what == "p8": return b256_p8()
        if what == "pub": return b256_pub()
        if what == "d": return b256_d()
        if what == "x": return b256_x()
        return b256_y()
    if n == "a384":
        if what == "sec1": return a384_sec1()
        if what == "p8": return a384_p8()
        if what == "pub": return a384_pub()
        if what == "d": return a384_d()
        if what == "x": return a384_x()
        return a384_y()
    if what == "sec1": return b384_sec1()
    if what == "p8": return b384_p8()
    if what == "pub": return b384_pub()
    if what == "d": return b384_d()
    if what == "x": return b384_x()
    return b384_y()

def keys_test(t: TestRunner) throws str -> int:
    t.section("ecdsa: key formats")
    mut names = ["a256", "b256", "a384", "b384"]
    mut i = 0
    while i < 4:
        mut n = names[i]
        mut sec1 = Ecdsa.private_from_pem(pick(n, "sec1"))?
        mut p8 = Ecdsa.private_from_pem(pick(n, "p8"))?
        mut pk = Ecdsa.public_from_pem(pick(n, "pub"))?
        t.assert_eq_str(Bytes.to_hex(bn_bytes(sec1.d, sec1.curve.nbytes)), pick(n, "d"), f"{n}: SEC1 scalar")
        t.assert_eq_str(Bytes.to_hex(bn_bytes(p8.d, p8.curve.nbytes)), pick(n, "d"), f"{n}: PKCS#8 scalar")
        t.assert_eq_str(Bytes.to_hex(bn_bytes(sec1.public_key().x, sec1.curve.nbytes)), pick(n, "x"), f"{n}: derived public X matches OpenSSL")
        t.assert_eq_str(Bytes.to_hex(bn_bytes(sec1.public_key().y, sec1.curve.nbytes)), pick(n, "y"), f"{n}: derived public Y matches OpenSSL")
        t.assert_eq_str(Bytes.to_hex(bn_bytes(pk.x, pk.curve.nbytes)), pick(n, "x"), f"{n}: SPKI X")
        t.assert_eq_str(Ecdsa.public_to_pem(pk), pick(n, "pub").strip() + "\n", f"{n}: SPKI re-encodes identically")
        # compressed / uncompressed points
        mut unc = pk.to_point(false)
        mut comp = pk.to_point(true)
        t.assert_eq_int(unc.len, 2 * pk.curve.nbytes + 1, f"{n}: uncompressed length")
        t.assert_eq_int(comp.len, pk.curve.nbytes + 1, f"{n}: compressed length")
        mut pc = Ecdsa.public_from_point(pk.curve, comp)?
        t.assert_eq_str(Bytes.to_hex(pc.to_point(false)), Bytes.to_hex(unc), f"{n}: compressed point decodes to the same key")
        mut pu = Ecdsa.public_from_point(pk.curve, unc)?
        t.assert_eq_str(Bytes.to_hex(pu.to_point(true)), Bytes.to_hex(comp), f"{n}: uncompressed point re-compresses")
        # our SEC1 export is accepted by itself and has the same scalar
        mut re = Ecdsa.private_from_pem(Ecdsa.private_to_pem(sec1))?
        t.assert_eq_str(Bytes.to_hex(bn_bytes(re.d, re.curve.nbytes)), pick(n, "d"), f"{n}: private re-export round trip")
        i = i + 1
    mut a = Ecdsa.private_from_pem(pick("a256", "sec1"))?
    t.assert_eq_str(Ecdsa.private_to_pem(a), pick("a256", "sec1").strip() + "\n", "P-256 SEC1 re-encodes identically to OpenSSL")
    mut a3 = Ecdsa.private_from_pem(pick("a384", "sec1"))?
    t.assert_eq_str(Ecdsa.private_to_pem(a3), pick("a384", "sec1").strip() + "\n", "P-384 SEC1 re-encodes identically to OpenSSL")
    t.section("ecdsa: invalid keys are rejected")
    mut c = Ecdsa.p256()
    mut off = hx("04" + a256_x() + a256_x())
    mut r1: Result[EcPublicKey, str] = Ecdsa.public_from_point(c, off)
    t.assert_true(r1.is_err, "point not on curve")
    mut bad_y = hx("04" + a256_x() + b256_y())
    mut r2: Result[EcPublicKey, str] = Ecdsa.public_from_point(c, bad_y)
    t.assert_true(r2.is_err, "mismatched X/Y")
    mut r3: Result[EcPublicKey, str] = Ecdsa.public_from_point(c, hx("0400"))
    t.assert_true(r3.is_err, "short point")
    mut r4: Result[EcPublicKey, str] = Ecdsa.public_from_point(c, hx("05" + a256_x()))
    t.assert_true(r4.is_err, "unknown point format")
    mut inf = Bytes.zeros(65)
    inf.set(0, 4)
    mut r5: Result[EcPublicKey, str] = Ecdsa.public_from_point(c, inf)
    t.assert_true(r5.is_err, "(0,0) is not on the curve")
    mut r6: Result[EcPrivateKey, str] = Ecdsa.private_from_scalar(c, Bytes.zeros(32))
    t.assert_true(r6.is_err, "zero scalar")
    mut r7: Result[EcPrivateKey, str] = Ecdsa.private_from_scalar(c, hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"))
    t.assert_true(r7.is_err, "scalar == n")
    mut r8: Result[EcPublicKey, str] = Ecdsa.public_from_pem("junk")
    t.assert_true(r8.is_err, "garbage PEM")
    mut r9: Result[EcPrivateKey, str] = Ecdsa.private_from_pem(pick("a256", "pub"))
    t.assert_true(r9.is_err, "public PEM is not a private key")
    mut x = hx("04" + a256_x() + a256_y())
    x.set(40, x.get(40) ^ 1)
    mut r10: Result[EcPublicKey, str] = Ecdsa.public_from_point(c, x)
    t.assert_true(r10.is_err, "bit-flipped coordinate")
    return 0

def sig_test(t: TestRunner) throws str -> int:
    t.section("ecdsa: OpenSSL signatures verify")
    mut pa = Ecdsa.public_from_pem(a256_pub())?
    mut pa3 = Ecdsa.public_from_pem(a384_pub())?
    t.assert_true(Ecdsa.verify(pa, "sha256", msg(), osig("a256_sha256")), "P-256 sha256")
    t.assert_true(Ecdsa.verify(pa, "sha384", msg(), osig("a256_sha384")), "P-256 sha384")
    t.assert_true(Ecdsa.verify(pa, "sha512", msg(), osig("a256_sha512")), "P-256 sha512")
    t.assert_true(Ecdsa.verify(pa, "sha1", msg(), osig("a256_sha1")), "P-256 sha1")
    t.assert_true(Ecdsa.verify(pa3, "sha384", msg(), osig("a384_sha384")), "P-384 sha384")
    t.assert_true(Ecdsa.verify(pa3, "sha256", msg(), osig("a384_sha256")), "P-384 sha256")
    t.assert_true(Ecdsa.verify(pa3, "sha512", msg(), osig("a384_sha512")), "P-384 sha512 (digest longer than the order)")
    t.section("ecdsa: tampering and wrong keys")
    t.assert_false(Ecdsa.verify(pa, "sha256", flip(msg(), 2), osig("a256_sha256")), "modified message")
    t.assert_false(Ecdsa.verify(pa, "sha256", msg(), flip(osig("a256_sha256"), 10)), "modified signature")
    t.assert_false(Ecdsa.verify(pa, "sha384", msg(), osig("a256_sha256")), "wrong hash")
    t.assert_false(Ecdsa.verify(Ecdsa.public_from_pem(b256_pub())?, "sha256", msg(), osig("a256_sha256")), "wrong key")
    t.assert_false(Ecdsa.verify(pa, "sha256", msg(), Bytes.slice(osig("a256_sha256"), 0, 60)), "truncated DER")
    t.assert_false(Ecdsa.verify(pa, "sha256", msg(), hx("")), "empty signature")
    t.assert_false(Ecdsa.verify(pa, "md5", msg(), osig("a256_sha256")), "unsupported hash")
    t.assert_false(Ecdsa.verify(pa, "sha256", msg(), hx("3006020100020100")), "r = s = 0")
    t.assert_false(Ecdsa.verify_raw(pa, "sha256", msg(), Bytes.zeros(64)), "raw zero signature")
    t.assert_false(Ecdsa.verify_raw(pa, "sha256", msg(), Bytes.zeros(63)), "raw wrong length")
    mut big = hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    t.assert_false(Ecdsa.verify_raw(pa, "sha256", msg(), Bytes.concat(big, big)), "r, s >= n")
    t.section("ecdsa: our deterministic signatures equal Python's")
    mut ka = Ecdsa.private_from_pem(a256_sec1())?
    mut ka3 = Ecdsa.private_from_pem(a384_sec1())?
    mut algs = ["sha256", "sha384", "sha512", "sha1"]
    mut i = 0
    while i < 4:
        mut h = algs[i]
        mut mine = Ecdsa.sign_raw(ka, h, msg())?
        t.assert_eq_str(Bytes.to_hex(mine), Bytes.to_hex(det_sig("a256_" + h)), f"P-256/{h} deterministic signature")
        t.assert_true(Ecdsa.verify_raw(ka.public_key(), h, msg(), mine), f"P-256/{h} verifies")
        mut mine3 = Ecdsa.sign_raw(ka3, h, msg())?
        t.assert_eq_str(Bytes.to_hex(mine3), Bytes.to_hex(det_sig("a384_" + h)), f"P-384/{h} deterministic signature")
        t.assert_true(Ecdsa.verify_raw(ka3.public_key(), h, msg(), mine3), f"P-384/{h} verifies")
        i = i + 1
    mut der1 = Ecdsa.sign(ka, "sha256", msg())?
    mut der2 = Ecdsa.sign(ka, "sha256", msg())?
    t.assert_eq_str(Bytes.to_hex(der1), Bytes.to_hex(der2), "signing is deterministic")
    t.assert_true(Ecdsa.verify(ka.public_key(), "sha256", msg(), der1), "DER signature verifies")
    mut sg = Ecdsa.sig_from_der(der1)?
    t.assert_eq_str(Bytes.to_hex(Ecdsa.sig_to_der(sg.r, sg.s)), Bytes.to_hex(der1), "DER round trip")
    # generated keys
    mut gk = Ecdsa.generate(Ecdsa.p256())
    mut gs = Ecdsa.sign(gk, "sha256", msg())?
    t.assert_true(Ecdsa.verify(gk.public_key(), "sha256", msg(), gs), "generated P-256 key signs and verifies")
    mut gk3 = Ecdsa.generate(Ecdsa.p384())
    mut gs3 = Ecdsa.sign(gk3, "sha384", msg())?
    t.assert_true(Ecdsa.verify(gk3.public_key(), "sha384", msg(), gs3), "generated P-384 key signs and verifies")
    t.assert_false(Ecdsa.verify(gk.public_key(), "sha256", msg(), gs3), "P-384 signature does not verify under a P-256 key")
    return 0

def ecdh_test(t: TestRunner) throws str -> int:
    t.section("ecdsa: ECDH")
    mut a = Ecdsa.private_from_pem(a256_sec1())?
    mut b = Ecdsa.private_from_pem(b256_sec1())?
    t.assert_eq_str(Bytes.to_hex(Ecdsa.ecdh(a, b.public_key())?), ecdh_p256(), "P-256 secret equals `openssl pkeyutl -derive`")
    t.assert_eq_str(Bytes.to_hex(Ecdsa.ecdh(b, a.public_key())?), ecdh_p256(), "P-256 symmetric")
    mut a3 = Ecdsa.private_from_pem(a384_sec1())?
    mut b3 = Ecdsa.private_from_pem(b384_sec1())?
    t.assert_eq_str(Bytes.to_hex(Ecdsa.ecdh(a3, b3.public_key())?), ecdh_p384(), "P-384 secret equals `openssl pkeyutl -derive`")
    mut mix: Result[Vec[int], str] = Ecdsa.ecdh(a, b3.public_key())
    t.assert_true(mix.is_err, "ECDH across different curves rejected")
    return 0

def run(name: str, t: TestRunner, r: Result[int, str]):
    if r.is_err: t.fail(f"{name}: {r.err}")

def main():
    mut t = TestRunner.init("122_ecdsa")
    run("rfc6979", t, rfc_test(t))
    run("keys", t, keys_test(t))
    run("sig", t, sig_test(t))
    run("ecdh", t, ecdh_test(t))
    t.summary()
