def osig(name: str) -> Vec[int]:
    if name == "a256_sha256": return hx("3044022058d3caac513c74ea230b394ac770639ca1cd049697525398dbe1a7eae75ba648022076f4448acb1203f4cac00ed3f2b52d715a3ab3def84170d8fa8d9b4cd49456d7")
    if name == "a256_sha384": return hx("3046022100a413684caba4258c2ba1dc6180ce3819d02aaccae88e7102743ce15c594f76de022100e2b9041548a5fd8b40b2a3d1e37e2845ecf1e932676c83fa0325ee9062ea335e")
    if name == "a256_sha512": return hx("3044022072f57045e838e007a799344339592582f54702eb44c2e4f4ad200b25d6190eff02207d0ba5bf0d6a42a72b7cdb61ea501abaafab609c33cb3cce6334b4499db81bf5")
    if name == "a256_sha1": return hx("304402202e9946a093e40a19994535a5e708622e2601cdf6fdabd37a159d57437d3316e8022053b1be8e44cf9d64e6b1430cc6302e7afd9056200a6cb9f36c34f5d333fd63ce")
