# tests/lang/122_ecdsa.tr
# std.crypto.ecdsa: P-256 / P-384 ECDSA (RFC 6979 deterministic signing, verification of
# OpenSSL signatures), ECDH (compared with `openssl pkeyutl -derive`), key formats
# (SEC1 / PKCS#8 / SPKI, compressed and uncompressed points) and invalid-input handling.
# Fixtures come from the `openssl` CLI; deterministic expectations from the RFC 6979
# appendix and from Python `cryptography` (deterministic_signing=True).

from std.test import TestRunner
from std.core.vec import Vec
from std.crypto.pkutil import Bytes, PkHash
from std.crypto.bn import bn_to_hex, bn_from_bytes, bn_to_bytes
from std.crypto.ecdsa import Ecdsa, EcCurve, EcPublicKey, EcPrivateKey, EcSignature
from std.encoding.pem import Pem

def hx(s: str) -> Vec[int]:
    return Bytes.from_hex(s)

def msg() -> Vec[int]:
    return hx("5461757261726f2045434453412074657374206d657373616765200001ff")

def flip(v: Vec[int], i: int) -> Vec[int]:
    mut c = Bytes.clone(v)
    c.set(i, c.get(i) ^ 1)
    return c

