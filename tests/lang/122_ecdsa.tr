    if name == "a384_sha256": return hx("3065023100af4a4045171308002935306502682fd8bba26a948f48e907d65afa0a0aab71b985cec0f0a43d170a1e1802c2b7e014d00230372ad12db50c07154176ad83767502eb2bcfcabf325f72f92373fd21e4520e0826165504692bc8768f297cf73da18099")
