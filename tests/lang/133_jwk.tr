def no_algs() -> List[str]:
    mut l: List[str] = []
    return l

def one_alg(a: str) -> List[str]:
    mut l: List[str] = []
    l.append(a)
    return l

def key_of(json: str) -> Jwk:
    mut r: Result[Jwk, str] = Jwk.parse(json)
    if r.is_err: print("  key parse error: " + r.err)
    return r.ok

def opts_at(now: int) -> JwtOptions:
    mut o = JwtOptions.init()
    o.now = now
    return o

def test_rfc7515(t: TestRunner):
    t.section("RFC 7515 appendix A")
    mut hs = key_of(k7515_hs())
    t.assert_eq_str(hs.kty, "oct", "A.1 oct key")
    t.assert_eq_int(hs.k.len(), 64, "A.1 key is 64 bytes")
    mut o = opts_at(1300819000)
    mut c: Result[JwtClaims, str] = Jwt.verify_jwk(t7515_hs(), hs, o)
    t.assert_true(c.is_ok, "A.1 HS256 token verifies")
    if c.is_ok:
        t.assert_eq_str(c.ok.issuer(), "joe", "A.1 iss")
        t.assert_eq_int(c.ok.expires_at(), 1300819380, "A.1 exp")
        t.assert_true(c.ok.get_bool("http://example.com/is_root"), "A.1 boolean claim")
        t.assert_eq_str(c.ok.alg, "HS256", "A.1 alg")
    mut late = opts_at(0)
    mut ex: Result[JwtClaims, str] = Jwt.verify_jwk(t7515_hs(), hs, late)
    t.assert_true(ex.is_err, "A.1 token is expired today")
    if ex.is_err: t.assert_contains(ex.err, "expired", "expiry message")
    mut rs = key_of(k7515_rs())
    t.assert_true(rs.is_private(), "A.2 RSA private key")
    mut v: Result[JwsParts, str] = Jws.verify(t7515_rs(), rs, no_algs())
    t.assert_true(v.is_ok, "A.2 RS256 signature verifies")
    if v.is_ok:
        mut again: Result[str, str] = Jws.sign_with_header("{\"alg\":\"RS256\"}", v.ok.payload, rs)
        t.assert_true(again.is_ok and again.ok == t7515_rs(), "A.2 RS256 signing reproduces the RFC token")
    mut pubrs: Result[Jwk, str] = rs.to_public()
    t.assert_true(pubrs.is_ok and not pubrs.ok.is_private(), "A.2 public half")
    if pubrs.is_ok:
        mut pv: Result[JwsParts, str] = Jws.verify(t7515_rs(), pubrs.ok, one_alg("RS256"))
        t.assert_true(pv.is_ok, "A.2 verifies with the public key alone")
        mut wrong: Result[JwsParts, str] = Jws.verify(t7515_rs(), pubrs.ok, one_alg("PS256"))
        t.assert_true(wrong.is_err, "A.2 rejected when RS256 is not allowed")
    mut ec = key_of(k7515_ec())
    mut tok = "eyJhbGciOiJFUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.DtEhU3ljbEg8L38VWAfUAqOyKAM6-Xx-F4GawxaepmXFCgfTjDxw5djxLa8ISlSApmWQxfKTUJqPP3-Kg6NU1Q"
    mut ev: Result[JwsParts, str] = Jws.verify(tok, ec, no_algs())
    t.assert_true(ev.is_ok, "A.3 ES256 signature verifies")
    mut bad = tok.slice(0, tok.len() - 2) + "Q"
    mut bv: Result[JwsParts, str] = Jws.verify(bad, ec, no_algs())
    t.assert_true(bv.is_err, "A.3 modified signature rejected")
    mut own: Result[str, str] = Jws.sign("hello", ec, "ES256", "")
    t.assert_true(own.is_ok, "ES256 signing")
    if own.is_ok:
        mut ov: Result[JwsParts, str] = Jws.verify(own.ok, ec, no_algs())
        t.assert_true(ov.is_ok and ov.ok.payload == "hello", "ES256 round trip")

def test_rfc7517(t: TestRunner):
    t.section("RFC 7517 appendix A / RFC 7638")
    mut r: Result[JwkSet, str] = JwkSet.parse(j7517_pub())
    t.assert_true(r.is_ok, "A.1 public set parses")
    mut set = r.ok
    t.assert_eq_int(set.len(), 2, "A.1 two keys")
    t.assert_true(set.has("1") and set.has("2011-04-29"), "A.1 kids")
    mut f: Result[Jwk, str] = set.find("2011-04-29")
    t.assert_true(f.is_ok and f.ok.kty == "RSA" and f.ok.alg == "RS256", "find(kid)")
    mut nf: Result[Jwk, str] = set.find("nope")
    t.assert_true(nf.is_err, "find of an unknown kid fails")
    mut e1: Result[Jwk, str] = set.find("1")
    t.assert_eq_str(e1.ok.key_use, "enc", "use member")
    t.assert_eq_str(f.ok.thumbprint_b64(), "NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs", "RFC 7638 3.1 thumbprint")
    t.assert_starts_with(f.ok.thumbprint_input(), "{\"e\":\"AQAB\",\"kty\":\"RSA\",\"n\":\"0vx7", "RFC 7638 canonical form")
    t.assert_eq_str(f.ok.thumbprint_uri(), "urn:ietf:params:oauth:jwk-thumbprint:sha-256:NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs", "RFC 9278 URI")
    mut enc_cands = set.candidates("1", "ES256")
    t.assert_eq_int(enc_cands.len(), 0, "an enc key is never used for signatures")
    mut pr: Result[JwkSet, str] = JwkSet.parse(j7517_priv())
    t.assert_true(pr.is_ok and pr.ok.len() == 2, "A.2 private set")
    for k in pr.ok.keys:
        t.assert_true(k.is_private(), f"A.2 key {k.kid} is private")
        mut pk: Result[PKey, str] = k.to_pkey()
        t.assert_true(pk.is_ok and pk.ok.has_private(), f"A.2 key {k.kid} -> PKey")
        if pk.is_ok:
            mut back: Result[Jwk, str] = Jwk.from_pkey(pk.ok)
            t.assert_true(back.is_ok and back.ok.thumbprint_b64() == k.thumbprint_b64(), f"A.2 key {k.kid} PKey -> JWK keeps the thumbprint")
            if back.is_ok:
                t.assert_true(back.ok.d == k.d, f"A.2 key {k.kid} private exponent survives")
                if k.kty == "RSA":
                    t.assert_true(back.ok.p == k.p and back.ok.qi == k.qi, "RSA CRT members survive")
            pk.ok.dispose()
    mut pubjson = pr.ok.to_public_json()
    t.assert_false(pubjson.contains("\"d\""), "to_public_json drops private members")
    mut again: Result[JwkSet, str] = JwkSet.parse(pubjson)
    t.assert_true(again.is_ok and again.ok.len() == 2, "public JSON re-parses")
    mut sy: Result[JwkSet, str] = JwkSet.parse(j7517_sym())
    t.assert_true(sy.is_ok and sy.ok.len() == 2, "A.3 symmetric set")
    mut hk: Result[Jwk, str] = sy.ok.find("HMAC key used in JWS spec Appendix A.1 example")
    t.assert_true(hk.is_ok, "kid with spaces")
    mut o = opts_at(1300819000)
    mut c: Result[JwtClaims, str] = Jwt.verify_jwks(t7515_hs(), sy.ok, o)
    t.assert_true(c.is_ok, "A.1 token verifies against the A.3 set (no kid: candidates tried)")
    mut pub_oct: Result[str, str] = hk.ok.to_public_json()
    t.assert_true(pub_oct.is_err, "oct keys have no public form")
    mut js = hk.ok.to_json()
    mut rt: Result[Jwk, str] = Jwk.parse(js)
    t.assert_true(rt.is_ok and rt.ok.k == hk.ok.k and rt.ok.kid == hk.ok.kid, "to_json round trip")

def test_rfc8037(t: TestRunner):
    t.section("RFC 8037 appendix A (Ed25519, X25519)")
    mut ed = key_of(k8037_priv())
    t.assert_eq_str(Hex.encode(ed.d), "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "A.1 private key bytes")
    t.assert_eq_str(ed.thumbprint_b64(), "kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k", "A.3 thumbprint")
    mut s: Result[str, str] = Jws.sign("Example of Ed25519 signing", ed, "EdDSA", "")
    t.assert_true(s.is_ok and s.ok == t8037(), "A.4 EdDSA signature matches")
    mut pubkey: Result[Jwk, str] = ed.to_public()
    mut v: Result[JwsParts, str] = Jws.verify(t8037(), pubkey.ok, no_algs())
    t.assert_true(v.is_ok and v.ok.payload == "Example of Ed25519 signing", "A.5 validation")
    mut seeded: Result[Jwk, str] = Jwk.ed25519_from_seed(ed.d)
    t.assert_true(seeded.is_ok and seeded.ok.x == ed.x, "public key derived from the seed")
    mut pk: Result[PKey, str] = pubkey.ok.to_pkey()
    t.assert_true(pk.is_ok and pk.ok.kind() == KEY_ED25519 and pk.ok.public_bytes() == ed.x, "Ed25519 JWK -> PKey")
    if pk.is_ok:
        mut back: Result[Jwk, str] = Jwk.from_pkey(pk.ok)
        t.assert_true(back.is_ok and back.ok.x == ed.x and back.ok.crv == "Ed25519", "PKey -> Ed25519 JWK")
    mut priv = Hex.decode("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    mut xk: Result[Jwk, str] = Jwk.x25519_from_private(priv)
    t.assert_true(xk.is_ok, "X25519 JWK")
    if xk.is_ok:
        t.assert_eq_str(Hex.encode(xk.ok.x), "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a", "X25519 public key (RFC 7748)")
        mut xj = xk.ok.to_json()
        t.assert_contains(xj, "\"crv\":\"X25519\"", "X25519 serialization")
        mut xs: Result[str, str] = Jws.sign("m", xk.ok, "EdDSA", "")
        t.assert_true(xs.is_err, "X25519 keys cannot sign")
    mut gen: Result[Jwk, str] = Jwk.generate_ed25519()
    if gen.is_ok:
        mut gs: Result[str, str] = Jwt.sign_jwk("{\"sub\":\"x\",\"exp\":4000000000}", gen.ok, "EdDSA")
        mut gv: Result[JwtClaims, str] = Jwt.verify_jwk(gs.ok, gen.ok, JwtOptions.init())
        t.assert_true(gv.is_ok and gv.ok.subject() == "x", "generated Ed25519 JWT round trip")

def test_rfc7520(t: TestRunner):
    t.section("RFC 7520 section 4")
    mut rsa = key_of(k7520_rsa())
    t.assert_eq_str(rsa.kid, "bilbo.baggins@hobbiton.example", "3.4 kid")
    mut payload = "It\xe2\x80\x99s a dangerous business, Frodo, going out your door. You step onto the road, and if you don't keep your feet, there\xe2\x80\x99s no knowing where you might be swept off to."
    mut s1: Result[str, str] = Jws.sign(payload, rsa, "RS256", "")
    t.assert_true(s1.is_ok and s1.ok == t7520_rs256(), "4.1 RS256 output matches (header with kid)")
    mut v2: Result[JwsParts, str] = Jws.verify(t7520_ps384(), rsa, one_alg("PS384"))
    t.assert_true(v2.is_ok and v2.ok.payload == payload, "4.2 PS384 signature verifies")
    mut s3: Result[str, str] = Jws.sign(payload, rsa, "PS256", "")
    t.assert_true(s3.is_ok, "PS256 signing")
    if s3.is_ok:
        mut v3: Result[JwsParts, str] = Jws.verify(s3.ok, rsa, no_algs())
        t.assert_true(v3.is_ok, "PS256 round trip")
    mut s5: Result[str, str] = Jws.sign(payload, rsa, "RS512", "")
    mut v5: Result[JwsParts, str] = Jws.verify(s5.ok, rsa, no_algs())
    t.assert_true(v5.is_ok, "RS512 round trip")
    mut oct = key_of(k7520_oct())
    mut s4: Result[str, str] = Jws.sign(payload, oct, "HS256", "")
    t.assert_true(s4.is_ok and s4.ok == t7520_hs256(), "4.4 HS256 output matches")
    mut s6: Result[str, str] = Jws.sign(payload, oct, "HS512", "")
    t.assert_true(s6.is_err, "key restricted to HS256 (and too short for HS512)")
    mut p521: Result[Jwk, str] = Jwk.parse(k7520_p521())
    t.assert_true(p521.is_err, "P-521 is reported as unsupported")
    if p521.is_err: t.assert_contains(p521.err, "P-521", "names the curve")
    mut setjson = "{\"keys\":[" + k7520_p521() + "," + k7520_rsa() + "]}"
    mut set: Result[JwkSet, str] = JwkSet.parse(setjson)
    t.assert_true(set.is_ok and set.ok.len() == 1 and set.ok.skipped == 1, "unsupported keys are skipped in a set")
    mut vs: Result[JwsParts, str] = Jws.verify_set(t7520_rs256(), set.ok, no_algs())
    t.assert_true(vs.is_ok, "verify_set picks the RSA key by kid (shared with the P-521 key)")

def test_pkey_roundtrip(t: TestRunner):
    t.section("PKey <-> JWK")
    mut g: Result[Jwk, str] = Jwk.generate_ec(CURVE_P384)
    t.assert_true(g.is_ok and g.ok.crv == "P-384" and g.ok.d.len() == 48, "generated P-384 JWK")
    mut j = g.ok.to_json()
    mut back = key_of(j)
    mut s: Result[str, str] = Jws.sign("data", back, "ES384", "")
    mut pubk: Result[Jwk, str] = g.ok.to_public()
    mut v: Result[JwsParts, str] = Jws.verify(s.ok, pubk.ok, no_algs())
    t.assert_true(v.is_ok, "ES384 with a re-parsed key")
    mut es256: Result[str, str] = Jws.sign("data", back, "ES256", "")
    t.assert_true(es256.is_err, "ES256 refused for a P-384 key")
    mut bad = "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4\",\"y\":\"4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyQ\"}"
    mut bk = key_of(bad)
    mut bp: Result[PKey, str] = bk.to_pkey()
    t.assert_true(bp.is_err, "a point off the curve is rejected")
    mut mism = "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4\",\"y\":\"4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM\",\"d\":\"jpsQnnGQmL-YBIffH1136cspYG6-0iY7X1fCE9-E9LI\"}"
    mut mk = key_of(mism)
    mut mp: Result[PKey, str] = mk.to_pkey()
    t.assert_true(mp.is_err, "EC private key that does not match x/y is rejected")
    mut rsa = key_of(k7515_rs())
    mut bkr = key_of(k7515_rs())
    bkr.qi = bkr.dp
    mut brp: Result[PKey, str] = bkr.to_pkey()
    t.assert_true(brp.is_err, "inconsistent RSA CRT values are rejected")
    mut n64 = b64url_encode(rsa.n)
    mut d64 = b64url_encode(rsa.d)
    mut donly_json = "{\"kty\":\"RSA\",\"n\":\"" + n64 + "\",\"e\":\"AQAB\",\"d\":\"" + d64 + "\"}"
    mut donly: Result[Jwk, str] = Jwk.parse(donly_json)
    t.assert_true(donly.is_err, "RSA private JWK without CRT members is refused")
    mut badb64: Result[Jwk, str] = Jwk.parse("{\"kty\":\"oct\",\"k\":\"ab+/\"}")
    t.assert_true(badb64.is_err, "standard base64 is not base64url")
    mut nokty: Result[Jwk, str] = Jwk.parse("{\"k\":\"abc\"}")
    t.assert_true(nokty.is_err, "kty is required")

def test_jwks_verify(t: TestRunner):
    t.section("JWT verification with a JWKS")
    mut ec: Result[Jwk, str] = Jwk.generate_ec(256)
    mut eck = ec.ok
    eck.kid = "ec-1"
    mut ed: Result[Jwk, str] = Jwk.generate_ed25519()
    mut edk = ed.ok
    edk.kid = "ed-1"
    mut rsa = key_of(k7515_rs())
    rsa.kid = "rsa-1"
    rsa.alg = "RS256"
    mut hm = Jwk.oct("0123456789abcdef0123456789abcdef0123456789abcdef")
    hm.kid = "hmac-1"
    mut priv = JwkSet.init()
    priv.add(eck)
    priv.add(edk)
    priv.add(rsa)
    mut pubr: Result[JwkSet, str] = JwkSet.parse(priv.to_public_json())
    mut pubkey = pubr.ok
    t.assert_eq_int(pubkey.len(), 3, "public JWKS")
    pubkey.add(hm)
    mut claims = "{\"iss\":\"https://issuer.test\",\"sub\":\"ann\",\"aud\":[\"api\",\"other\"],\"iat\":1000,\"nbf\":1000,\"exp\":2000}"
    mut o = opts_at(1500)
    o.issuer = "https://issuer.test"
    o.audience = "api"
    mut t1: Result[str, str] = Jwt.sign_jwk(claims, eck, "ES256")
    mut c1: Result[JwtClaims, str] = Jwt.verify_jwks(t1.ok, pubkey, o)
    t.assert_true(c1.is_ok and c1.ok.kid == "ec-1" and c1.ok.subject() == "ann", "ES256 by kid")
    if c1.is_ok:
        t.assert_eq_int(c1.ok.audiences().len(), 2, "aud array")
        t.assert_contains(c1.ok.header_json, "\"typ\":\"JWT\"", "typ header")
    mut t2: Result[str, str] = Jwt.sign_jwk(claims, edk, "EdDSA")
    mut c2: Result[JwtClaims, str] = Jwt.verify_jwks(t2.ok, pubkey, o)
    t.assert_true(c2.is_ok, "EdDSA by kid")
    mut t3: Result[str, str] = Jwt.sign_jwk(claims, rsa, "RS256")
    mut c3: Result[JwtClaims, str] = Jwt.verify_jwks(t3.ok, pubkey, o)
    t.assert_true(c3.is_ok, "RS256 by kid")
    mut t4: Result[str, str] = Jwt.sign_jwk(claims, hm, "HS384")
    mut c4: Result[JwtClaims, str] = Jwt.verify_jwks(t4.ok, pubkey, o)
    t.assert_true(c4.is_ok, "HS384 by kid")
    mut ps: Result[str, str] = Jwt.sign_jwk(claims, rsa, "PS256")
    t.assert_true(ps.is_err, "a key with alg RS256 does not sign PS256")
    mut o2 = opts_at(1500)
    o2.algorithms.append("RS256")
    mut c5: Result[JwtClaims, str] = Jwt.verify_jwks(t1.ok, pubkey, o2)
    t.assert_true(c5.is_err, "ES256 rejected when only RS256 is allowed")
    mut anon = Jwk.oct(hm.k)
    mut t6: Result[str, str] = Jwt.sign_jwk(claims, anon, "HS256")
    mut c6: Result[JwtClaims, str] = Jwt.verify_jwks(t6.ok, pubkey, o)
    t.assert_true(c6.is_ok, "token without kid")
    mut other: Result[Jwk, str] = Jwk.generate_ec(256)
    mut ok2 = other.ok
    ok2.kid = "ghost"
    mut t7: Result[str, str] = Jwt.sign_jwk(claims, ok2, "ES256")
    mut c7: Result[JwtClaims, str] = Jwt.verify_jwks(t7.ok, pubkey, o)
    t.assert_true(c7.is_err, "unknown kid")
    if c7.is_err: t.assert_contains(c7.err, "ghost", "names the kid")
    ok2.kid = "ec-1"
    mut t8: Result[str, str] = Jwt.sign_jwk(claims, ok2, "ES256")
    mut c8: Result[JwtClaims, str] = Jwt.verify_jwks(t8.ok, pubkey, o)
    t.assert_true(c8.is_err, "foreign signature under a known kid")

def test_attacks(t: TestRunner):
    t.section("algorithm confusion and malformed tokens")
    mut rsa = key_of(k7515_rs())
    mut pubr: Result[Jwk, str] = rsa.to_public()
    mut pubkey = pubr.ok
    pubkey.kid = "r"
    mut set = JwkSet.init()
    set.add(pubkey)
    mut h64 = b64url_encode("{\"alg\":\"HS256\",\"kid\":\"r\"}")
    mut p64 = b64url_encode("{\"sub\":\"evil\",\"exp\":4000000000}")
    mut input = h64 + "." + p64
    mut secret = pubkey.to_json()
    mut mac = Hmac.sha256_raw(secret, input)
    mut mac64 = b64url_encode(mac)
    mut forged = input + "." + mac64
    mut r1: Result[JwtClaims, str] = Jwt.verify_jwks(forged, set, JwtOptions.init())
    t.assert_true(r1.is_err, "RSA public key used as an HMAC secret is rejected")
    mut nh = b64url_encode("{\"alg\":\"none\"}")
    mut none_tok = nh + "." + p64 + "."
    mut r2: Result[JwtClaims, str] = Jwt.verify_jwks(none_tok, set, JwtOptions.init())
    t.assert_true(r2.is_err, "alg none is rejected")
    mut hm = Jwk.oct("0123456789abcdef0123456789abcdef")
    mut crit: Result[str, str] = Jws.sign_with_header("{\"alg\":\"HS256\",\"crit\":[\"exp\"],\"exp\":1}", "{}", hm)
    mut r3: Result[JwsParts, str] = Jws.verify(crit.ok, hm, no_algs())
    t.assert_true(r3.is_err, "crit header is rejected")
    mut short = Jwk.oct("short")
    mut r4: Result[str, str] = Jws.sign("x", short, "HS256", "")
    t.assert_true(r4.is_err, "HMAC keys shorter than the hash are refused")
    mut r5: Result[JwsParts, str] = Jws.verify("a.b", hm, no_algs())
    t.assert_true(r5.is_err, "two segments")
    mut r6: Result[JwsParts, str] = Jws.verify("e30.e30.!!!", hm, no_algs())
    t.assert_true(r6.is_err, "bad base64url signature")
    mut ok: Result[str, str] = Jws.sign("{}", hm, "HS256", "")
    mut segs = ok.ok.split_exact(".")
    mut p2 = b64url_encode("{\"a\":1}")
    mut tampered = segs[0] + "." + p2 + "." + segs[2]
    mut r7: Result[JwsParts, str] = Jws.verify(tampered, hm, no_algs())
    t.assert_true(r7.is_err, "tampered payload")
    mut sigkey = Jwk.oct("0123456789abcdef0123456789abcdef")
    sigkey.key_use = "enc"
    mut r8: Result[str, str] = Jws.sign("x", sigkey, "HS256", "")
    t.assert_true(r8.is_err, "use=enc keys do not sign")
    mut opk = Jwk.oct("0123456789abcdef0123456789abcdef")
    opk.key_ops.append("verify")
    mut r9: Result[str, str] = Jws.sign("x", opk, "HS256", "")
    t.assert_true(r9.is_err, "key_ops without sign")

def test_claims(t: TestRunner):
    t.section("registered claims")
    mut k = Jwk.oct("0123456789abcdef0123456789abcdef")
    mut tok: Result[str, str] = Jwt.sign_jwk("{\"iss\":\"me\",\"aud\":\"api\",\"iat\":1000,\"nbf\":1100,\"exp\":2000}", k, "HS256")
    mut tk = tok.ok
    mut o = opts_at(1050)
    o.leeway = 0
    mut r1: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o)
    t.assert_true(r1.is_err, "nbf in the future")
    if r1.is_err: t.assert_contains(r1.err, "nbf", "nbf message")
    o.leeway = 60
    mut r2: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o)
    t.assert_true(r2.is_ok, "nbf within leeway")
    mut o3 = opts_at(2030)
    mut r3: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o3)
    t.assert_true(r3.is_ok, "exp within leeway")
    o3.leeway = 0
    mut r4: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o3)
    t.assert_true(r4.is_err, "exp without leeway")
    mut o5 = opts_at(1500)
    o5.audience = "api"
    o5.issuer = "me"
    mut r5: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o5)
    t.assert_true(r5.is_ok, "aud string + iss")
    o5.audience = "web"
    mut r6: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o5)
    t.assert_true(r6.is_err, "foreign audience")
    o5.audience = "api"
    o5.issuer = "you"
    mut r7: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o5)
    t.assert_true(r7.is_err, "wrong issuer")
    mut o8 = opts_at(900)
    o8.leeway = 10
    mut r8: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o8)
    t.assert_true(r8.is_err, "iat in the future")
    mut o9 = opts_at(1500)
    o9.max_age = 100
    mut r9: Result[JwtClaims, str] = Jwt.verify_jwk(tk, k, o9)
    t.assert_true(r9.is_err, "max_age exceeded")
    mut noexp: Result[str, str] = Jwt.sign_jwk("{\"sub\":\"a\"}", k, "HS256")
    mut r10: Result[JwtClaims, str] = Jwt.verify_jwk(noexp.ok, k, opts_at(1500))
    t.assert_true(r10.is_err, "exp required by default")
    mut o11 = opts_at(1500)
    o11.require_exp = false
    o11.typ = "jwt"
    mut r11: Result[JwtClaims, str] = Jwt.verify_jwk(noexp.ok, k, o11)
    t.assert_true(r11.is_ok, "exp optional; typ matched case-insensitively")
    o11.typ = "at+jwt"
    mut r12: Result[JwtClaims, str] = Jwt.verify_jwk(noexp.ok, k, o11)
    t.assert_true(r12.is_err, "typ mismatch")
    mut un: Result[JwtClaims, str] = Jwt.decode_unverified(tk)
    t.assert_true(un.is_ok and un.ok.get_int("exp") == 2000, "decode_unverified")
    mut fl: Result[str, str] = Jwt.sign_jwk("{\"exp\":2.0e3,\"name\":\"\\u00e9\"}", k, "HS256")
    mut r13: Result[JwtClaims, str] = Jwt.verify_jwk(fl.ok, k, opts_at(1500))
    t.assert_true(r13.is_ok and r13.ok.get_int("exp") == 2000, "float exp")
    if r13.is_ok: t.assert_eq_str(r13.ok.get_str("name"), "\xc3\xa9", "u-escapes decode to UTF-8")

def main():
    mut t = TestRunner.init("133_jwk")
    test_rfc7515(t)
    test_rfc7517(t)
    test_rfc8037(t)
    test_rfc7520(t)
    test_pkey_roundtrip(t)
    test_jwks_verify(t)
    test_attacks(t)
    test_claims(t)
    t.summary()
