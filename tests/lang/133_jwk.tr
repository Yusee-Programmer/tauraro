# tests/lang/133_jwk.tr
# std.crypto.jwk (JWK / JWK Set / JWS / RFC 7638 thumbprints) and the
# JWK-based JWT API in std.crypto.jwt, checked against the example vectors of
# RFC 7515 (appendix A), RFC 7517 (appendix A), RFC 7520 (section 4),
# RFC 7638 (section 3.1) and RFC 8037 (appendix A).

from std.test import TestRunner
from std.crypto.jwk import Jwk, JwkSet, Jws, JwsParts, b64url_encode, b64url_decode
from std.crypto.jwt import Jwt, JwtOptions, JwtClaims
from std.crypto.pk import PKey, KEY_RSA, KEY_EC_P384, KEY_ED25519, CURVE_P384
from std.crypto.hmac import Hmac
from std.crypto.native import ALG_SHA256
from std.encoding.hex import Hex

