# tests/lang/161_gif.tr - std.image.gif: GIF87a/89a decode (LZW, interlace,
# transparency, disposal methods, animation) and encode (palette quantisation,
# LZW, GifWriter animations).
#
# Decoder fixtures were written by Pillow/libgif; the expected value for each
# frame is the FNV-1a hash of the RGBA canvas that Pillow itself composes for
# that frame (RGB of fully transparent pixels zeroed). The decoder was also run
# against a 184-frame real-world animation and 17 other files with 0 differing
# pixels. Encoder output is verified here by decoding it with our own decoder
# and (when this test was written) by Pillow/libgif.

from std.test import TestRunner
from std.image import Image
from std.image.gif import decode_gif, decode_gif_anim, encode_gif, encode_gif_ex, GifWriter, GifAnim
from std.compress.common import rd8

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

def nib(c: int) -> int:
    if c >= 97: return c - 87
    if c >= 65: return c - 55
    return c - 48

def unhex(h: str) -> str:
    mut n = h.len() / 2
    mut hp = h as Pointer[char]
    mut buf = _tr_c_malloc(n + 1)
    mut i = 0
    while i < n:
        mut b = nib(rd8(hp, 2 * i)) * 16 + nib(rd8(hp, 2 * i + 1))
        unsafe:
            buf.offset(i).write(b as char)
        i = i + 1
    unsafe:
        buf.offset(n).write('\0')
    return _tr_str_wrap_len(buf, n)

# FNV-1a of an RGBA image, with the RGB of fully transparent pixels zeroed.
def fnv_rgba(img: Image) -> int:
    mut h = 0x811c9dc5
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut a = img.pixels.get(i * 4 + 3) as int
        mut c = 0
        while c < 4:
            mut v = img.pixels.get(i * 4 + c) as int
            if a == 0 and c < 3:
                v = 0
            h = ((h ^ v) * 0x01000193) & 0xFFFFFFFF
            c = c + 1
        i = i + 1
    return h

def same(a: Image, b: Image) -> bool:
    if a.width != b.width or a.height != b.height: return false
    mut n = a.width * a.height * 4
    mut i = 0
    while i < n:
        if (a.pixels.get(i) as int) != (b.pixels.get(i) as int): return false
        i = i + 1
    return true

def check(t: TestRunner, name: str, hex_: str, w: int, h: int, lp: int, hashes: List[int], delays: List[int]):
    mut b = unhex(hex_)
    mut n = b.len()
    mut a = decode_gif_anim(b, n)
    t.assert_true(a.ok, name + ": decodes")
    t.assert_eq_int(a.width, w, name + ": width")
    t.assert_eq_int(a.height, h, name + ": height")
    t.assert_eq_int(a.frame_count, len(hashes), name + ": frame count")
    t.assert_eq_int(a.loop_count, lp, name + ": loop count")
    mut i = 0
    while i < len(hashes) and i < a.frame_count:
        mut f = a.frame(i)
        t.assert_eq_int(fnv_rgba(f), hashes[i], name + ": frame " + i.to_str() + " pixels match Pillow")
        t.assert_eq_int(a.delay_cs(i), delays[i], name + ": frame " + i.to_str() + " delay")
        f.free()
        i = i + 1
    a.free()

def grad(w: int, h: int) -> Image:
    mut img = Image.init(w, h)
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            img.set_pixel(x, y, (x * 255) / w, (y * 255) / h, ((x * 3 + y * 5) * 2) & 255, 255)
            x = x + 1
        y = y + 1
    return img

def few_colours(w: int, h: int, k: int) -> Image:
    mut img = Image.init(w, h)
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            mut c = (x / 3 + y / 2 + (x * y) % 3) % k
            img.set_pixel(x, y, (c * 53) & 255, (c * 97 + 11) & 255, (c * 29 + 200) & 255, 255)
            x = x + 1
        y = y + 1
    return img

def noise(w: int, h: int, seed: int) -> Image:
    mut img = Image.init(w, h)
    mut s = seed
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            s = (s * 1103515245 + 12345) & 0x7FFFFFFF
            mut c = (s >> 8) & 255
            img.set_pixel(x, y, c, (c * 7) & 255, (255 - c), 255)
            x = x + 1
        y = y + 1
    return img

def main():
    mut t = TestRunner.init("161_gif")
    t.section("decode: Pillow/libgif-written fixtures")
    check(t, "p2", "", 33, 21, -1, [3531176924], [0])
    check(t, "interlace", "", 24, 17, -1, [4056084426], [0])
    check(t, "p256", "", 40, 30, -1, [76965395], [0])
    check(t, "trans", "", 20, 12, -1, [436581296], [0])
    check(t, "noise", "", 48, 36, -1, [781219345], [0])
    check(t, "anim_d0", "", 32, 24, 3, [2008291930, 3498316340, 2829705994, 2245639897], [5, 6, 7, 8])
    check(t, "anim_d1", "", 32, 24, 3, [2008291930, 3498316340, 2829705994, 2245639897], [5, 6, 7, 8])
    check(t, "anim_d2", "", 32, 24, 3, [2008291930, 2631723235, 2110750522, 429393515], [5, 6, 7, 8])
    check(t, "anim_d3", "", 32, 24, 3, [2008291930, 300661179, 2229306431, 886656855], [5, 6, 7, 8])
    check(t, "anim_local_palettes", "", 24, 16, 0, [2044801299, 172762861, 929759037], [4, 4, 4])

    t.section("decode: malformed input")
    t.assert_eq_int(decode_gif("", 0).width, -1, "empty")
    t.assert_eq_int(decode_gif("GIF89a", 6).width, -1, "header only")
    t.assert_eq_int(decode_gif("PNG89a-not-a-gif-at-all", 23).width, -1, "bad signature")
    mut gd = unhex("")
    t.assert_eq_int(decode_gif(gd, 20).width, -1, "cut inside the header/palette")
    mut half = decode_gif_anim(gd, gd.len() - 30)
    t.assert_true(half.frame_count == 0 or half.ok, "truncated data is handled")
    half.free()

    t.section("decode(): sniffing dispatches GIF")
    mut sn = unhex("")
    t.assert_eq_int(decode_gif(sn, sn.len()).width, 33, "decode_gif first frame")

    t.section("encode: exact palettes round-trip losslessly")
    mut fc = few_colours(45, 31, 7)
    mut e1, l1 = encode_gif(fc)
    t.assert_eq_int(rd8(e1 as Pointer[char], 0), 0x47, "starts with GIF")
    t.assert_eq_int(rd8(e1 as Pointer[char], 4), 0x39, "GIF89a")
    t.assert_eq_int(rd8(e1 as Pointer[char], l1 - 1), 0x3B, "trailer")
    mut d1 = decode_gif(e1, l1)
    t.assert_true(same(fc, d1), "7 colours round trip")

    mut fc2 = few_colours(60, 50, 256)
    mut e2, l2 = encode_gif(fc2)
    mut d2 = decode_gif(e2, l2)
    t.assert_true(same(fc2, d2), "256 colours round trip")

    mut nz = noise(70, 60, 5)
    mut e3, l3 = encode_gif_ex(nz, false)
    mut d3 = decode_gif(e3, l3)
    t.assert_eq_int(d3.width, 70, "noise image decodes")

    mut one = Image.init(1, 1)
    one.set_pixel(0, 0, 9, 8, 7, 255)
    mut e4, l4 = encode_gif(one)
    t.assert_true(same(one, decode_gif(e4, l4)), "1x1 round trip")

    mut two = Image.init(3, 2)
    two.set_pixel(0, 0, 0, 0, 0, 255)
    two.set_pixel(1, 0, 255, 255, 255, 255)
    two.set_pixel(2, 0, 0, 0, 0, 255)
    two.set_pixel(0, 1, 255, 255, 255, 255)
    two.set_pixel(1, 1, 255, 255, 255, 255)
    two.set_pixel(2, 1, 0, 0, 0, 255)
    mut e5, l5 = encode_gif(two)
    t.assert_true(same(two, decode_gif(e5, l5)), "2-colour image (min code size 2)")

    t.section("encode: transparency")
    mut tr = few_colours(20, 14, 5)
    tr.set_pixel(3, 3, 1, 2, 3, 0)
    tr.set_pixel(4, 3, 9, 9, 9, 100)
    tr.set_pixel(5, 3, 9, 9, 9, 200)
    mut e6, l6 = encode_gif(tr)
    mut d6 = decode_gif(e6, l6)
    mut r6, g6, b6, a6 = d6.get_pixel(3, 3)
    t.assert_eq_int(a6, 0, "alpha 0 stays transparent")
    mut r7, g7, b7, a7 = d6.get_pixel(4, 3)
    t.assert_eq_int(a7, 0, "alpha < 128 becomes transparent")
    mut r8, g8, b8, a8 = d6.get_pixel(5, 3)
    t.assert_eq_int(a8, 255, "alpha >= 128 becomes opaque")
    mut r9, g9, b9, a9 = d6.get_pixel(6, 6)
    mut er, eg, eb, ea = tr.get_pixel(6, 6)
    t.assert_true(r9 == er and g9 == eg and b9 == eb and a9 == 255, "opaque pixel kept exactly")

    t.section("encode: more than 256 colours -> median cut")
    mut gr = grad(64, 48)
    mut e10, l10 = encode_gif(gr)
    mut d10 = decode_gif(e10, l10)
    t.assert_eq_int(d10.width, 64, "quantised image decodes")
    mut tot = 0
    mut i = 0
    while i < 64 * 48 * 4:
        mut df = (gr.pixels.get(i) as int) - (d10.pixels.get(i) as int)
        if df < 0:
            df = 0 - df
        tot = tot + df
        i = i + 1
    t.assert_true(tot / (64 * 48 * 4) < 8, "mean absolute error < 8 levels (is " + (tot / (64 * 48 * 4)).to_str() + ")")
    mut e11, l11 = encode_gif_ex(gr, true)
    mut d11 = decode_gif(e11, l11)
    t.assert_eq_int(d11.height, 48, "dithered image decodes")
    mut tot2 = 0
    i = 0
    while i < 64 * 48 * 4:
        mut df = (gr.pixels.get(i) as int) - (d11.pixels.get(i) as int)
        if df < 0:
            df = 0 - df
        tot2 = tot2 + df
        i = i + 1
    t.assert_true(tot2 / (64 * 48 * 4) < 16, "dithered mean absolute error is bounded")

    mut trg = grad(40, 40)
    trg.set_pixel(0, 0, 0, 0, 0, 0)
    mut e12, l12 = encode_gif(trg)
    mut d12 = decode_gif(e12, l12)
    mut q0, q1, q2, qa = d12.get_pixel(0, 0)
    t.assert_eq_int(qa, 0, "transparent pixel survives quantisation")
    mut q3, q4, q5, qb = d12.get_pixel(1, 0)
    t.assert_eq_int(qb, 255, "neighbour stays opaque")

    t.section("GifWriter: animations")
    mut w = GifWriter.init(30, 20, 0)
    mut fa = few_colours(30, 20, 4)
    mut fb = few_colours(30, 20, 5)
    mut fcc = few_colours(30, 20, 6)
    w.add_frame(fa, 12)
    w.add_frame(fb, 34)
    w.add_frame(fcc, 5)
    mut eanim, lanim = w.finish()
    mut an = decode_gif_anim(eanim, lanim)
    t.assert_true(an.ok, "animation decodes")
    t.assert_eq_int(an.frame_count, 3, "3 frames")
    t.assert_eq_int(an.loop_count, 0, "loop forever")
    t.assert_eq_int(an.delay_cs(0), 12, "delay 0")
    t.assert_eq_int(an.delay_cs(1), 34, "delay 1")
    t.assert_eq_int(an.delay_cs(2), 5, "delay 2")
    mut f0 = an.frame(0)
    mut f1 = an.frame(1)
    mut f2 = an.frame(2)
    t.assert_true(same(fa, f0), "frame 0 pixels")
    t.assert_true(same(fb, f1), "frame 1 pixels")
    t.assert_true(same(fcc, f2), "frame 2 pixels")

    # optimised animation: a small square moves over a static background
    mut wo = GifWriter.init(48, 32, 2)
    wo.set_optimize(true)
    mut wn = GifWriter.init(48, 32, 2)
    mut bg = few_colours(48, 32, 4)
    mut k = 0
    mut srcs = 0
    while k < 5:
        mut fr = few_colours(48, 32, 4)
        mut yy = 0
        while yy < 6:
            mut xx = 0
            while xx < 6:
                fr.set_pixel(k * 7 + xx, 10 + yy, 250, 10, 10, 255)
                xx = xx + 1
            yy = yy + 1
        wo.add_frame(fr, 10)
        wn.add_frame(fr, 10)
        fr.free()
        k = k + 1
    mut eo, lo = wo.finish()
    mut en, ln = wn.finish()
    t.assert_true(lo < ln, "optimised animation is smaller (" + lo.to_str() + " < " + ln.to_str() + ")")
    mut ao = decode_gif_anim(eo, lo)
    mut an2 = decode_gif_anim(en, ln)
    t.assert_eq_int(ao.frame_count, 5, "optimised: 5 frames")
    t.assert_eq_int(ao.loop_count, 2, "optimised: loop count 2")
    mut allsame = true
    k = 0
    while k < 5 and k < ao.frame_count:
        mut x1 = ao.frame(k)
        mut x2 = an2.frame(k)
        if not same(x1, x2):
            allsame = false
        x1.free()
        x2.free()
        k = k + 1
    t.assert_true(allsame, "optimised frames show the same canvases as full frames")
    mut rx, ry, rw, rh = ao.frame_rect(2)
    t.assert_true(rw < 48 and rh < 32, "optimised frame stores a sub-rectangle")

    # animation with transparency: frames are cleared between frames
    mut wt = GifWriter.init(24, 16, -1)
    mut ta = Image.init(24, 16)
    ta.set_pixel(2, 2, 200, 0, 0, 255)
    mut tb = Image.init(24, 16)
    tb.set_pixel(10, 5, 0, 200, 0, 255)
    wt.add_frame(ta, 3)
    wt.add_frame(tb, 3)
    mut et, lt = wt.finish()
    mut at = decode_gif_anim(et, lt)
    t.assert_eq_int(at.loop_count, -1, "no loop extension -> -1")
    mut tf1 = at.frame(1)
    mut u0, u1, u2, ua = tf1.get_pixel(2, 2)
    t.assert_eq_int(ua, 0, "previous frame's pixel is cleared (disposal 2)")
    mut v0, v1, v2, va = tf1.get_pixel(10, 5)
    t.assert_eq_int(va, 255, "new frame's pixel is shown")
    t.summary()
