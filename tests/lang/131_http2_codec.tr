# tests/lang/131_http2_codec.tr
# std.net.http2 without sockets: frame codec, and two H2Conn state machines wired
# back to back (handshake, requests/responses, trailers, header continuation,
# flow control with tiny windows, PING/GOAWAY/RST_STREAM) plus a catalogue of
# protocol violations fed to a server connection by hand.

from std.test import TestRunner
from std.core.string import StringBuilder
from std.net.hpack import HpackEncoder, HpackHeaders
from std.net.http2 import H2Conn, H2Settings, H2FrameReader, H2Stream, h2_frame, h2_preface, h2_settings_payload, h2_error_name

def tohex(s: str) -> str:
    mut sb = StringBuilder.init(s.len() * 2 + 2)
    mut p = s as Pointer[char]
    mut i = 0
    while i < s.len():
        mut b = 0
        unsafe:
            b = (p.offset(i).read() as int) & 255
        mut hi = b >> 4
        mut lo = b & 15
        if hi < 10: sb.append_char(48 + hi)
        else: sb.append_char(87 + hi)
        if lo < 10: sb.append_char(48 + lo)
        else: sb.append_char(87 + lo)
        i = i + 1
    mut out = sb.to_owned()
    sb.free()
    return out

# Deterministic binary payload of n bytes (contains NULs and high bytes).
def payload(n: int, seed: int) -> str:
    mut sb = StringBuilder.init(n + 8)
    mut x = seed
    mut i = 0
    while i < n:
        x = (x * 1103515245 + 12345) & 0x7FFFFFFF
        sb.append_char((x >> 8) & 255)
        i = i + 1
    mut out = sb.to_owned()
    sb.free()
    return out

# Move bytes between two connections until both are quiet.
def shuttle(a: H2Conn, b: H2Conn) -> bool:
    mut ok = true
    mut rounds = 0
    while rounds < 10000:
        rounds = rounds + 1
        mut moved = false
        if a.has_output():
            mut x = a.take_output()
            mut r: Result[bool, str] = b.receive(x)
            if r.is_err: ok = false
            moved = true
        if b.has_output():
            mut y = b.take_output()
            mut r2: Result[bool, str] = a.receive(y)
            if r2.is_err: ok = false
            moved = true
        if not moved: return ok
    return false

# Binary-safe concatenation (`a + b` stops at the first NUL byte, see bug N1-1).
def cat(a: str, b: str) -> str:
    mut sb = StringBuilder.init(a.len() + b.len() + 8)
    sb.append(a)
    sb.append(b)
    mut o = sb.to_owned()
    sb.free()
    return o

def cat3(a: str, b: str, c: str) -> str:
    return cat(cat(a, b), c)

def reqh(hs: HpackHeaders):
    hs.add(":method", "GET")
    hs.add(":scheme", "http")
    hs.add(":path", "/")
    hs.add(":authority", "example.test")

# A server connection that already completed the handshake with a hand-made client.
def mk_server(local: H2Settings) -> H2Conn:
    mut s = H2Conn.with_settings(false, local)
    s.start()
    mut boot = cat(h2_preface(), h2_frame(4, 0, 0, ""))
    mut r: Result[bool, str] = s.receive(boot)
    return s

def feed(c: H2Conn, bytes: str) -> bool:
    mut r: Result[bool, str] = c.receive(bytes)
    return r.is_ok

def hdr_block(enc: HpackEncoder, hs: HpackHeaders) -> str:
    return enc.encode(hs)

# Bytes from a list of ints (string literals have no \x escapes).
def bytes(xs: List[int]) -> str:
    mut sb = StringBuilder.init(len(xs) + 4)
    mut i = 0
    while i < len(xs):
        sb.append_char(xs[i])
        i = i + 1
    mut o = sb.to_owned()
    sb.free()
    return o

def zeros(n: int) -> str:
    mut sb = StringBuilder.init(n + 4)
    mut i = 0
    while i < n:
        sb.append_char(0)
        i = i + 1
    mut o = sb.to_owned()
    sb.free()
    return o

# One 6-byte SETTINGS entry.
def sett(id: int, v: int) -> str:
    mut sb = StringBuilder.init(8)
    sb.append_char((id >> 8) & 255)
    sb.append_char(id & 255)
    sb.append(be32(v))
    mut o = sb.to_owned()
    sb.free()
    return o

def be32(v: int) -> str:
    mut sb = StringBuilder.init(8)
    sb.append_char((v >> 24) & 255)
    sb.append_char((v >> 16) & 255)
    sb.append_char((v >> 8) & 255)
    sb.append_char(v & 255)
    mut o = sb.to_owned()
    sb.free()
    return o

def main():
    mut t = TestRunner.init("131_http2_codec")

    t.section("frame codec")
    t.assert_eq_str(tohex(h2_frame(4, 0, 0, "")), "000000040000000000", "empty SETTINGS frame")
    t.assert_eq_str(tohex(h2_frame(4, 1, 0, "")), "000000040100000000", "SETTINGS ACK")
    t.assert_eq_str(tohex(h2_frame(6, 1, 0, "abcdefgh")), "000008060100000000" + "6162636465666768", "PING ACK")
    t.assert_eq_str(tohex(h2_frame(0, 1, 5, "hi")), "000002000100000005" + "6869", "DATA END_STREAM on stream 5")
    t.assert_eq_str(tohex(h2_frame(0, 0, 0x80000003, "")), "000000000000000003", "reserved bit of the stream id is cleared")
    mut ids: List[int] = [3, 4]
    mut vals: List[int] = [100, 65535]
    t.assert_eq_str(tohex(h2_settings_payload(ids, vals)), "00030000006400040000ffff", "settings payload")
    t.assert_eq_str(h2_preface(), "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", "preface text")
    t.assert_eq_int(h2_preface().len(), 24, "preface is 24 octets")
    # incremental reader: one byte at a time
    mut big = payload(300, 7)
    mut wire = cat(h2_frame(0, 1, 1, big), h2_frame(6, 0, 0, "12345678"))
    mut rd = H2FrameReader.init(16384)
    mut got = 0
    mut ok_rd = true
    mut i = 0
    while i < wire.len():
        rd.feed(wire.slice(i, i + 1))
        mut more = true
        while more:
            mut r: Result[bool, str] = rd.next()
            if r.is_err:
                ok_rd = false
                more = false
            elif r.ok:
                got = got + 1
                if got == 1:
                    if rd.ftype != 0 or rd.flags != 1 or rd.stream_id != 1 or tohex(rd.payload) != tohex(big): ok_rd = false
                if got == 2:
                    if rd.ftype != 6 or rd.stream_id != 0 or rd.payload != "12345678": ok_rd = false
            else:
                more = false
        i = i + 1
    t.assert_true(ok_rd, "byte-at-a-time parsing is exact")
    t.assert_eq_int(got, 2, "two frames parsed")
    t.assert_eq_int(rd.pending(), 0, "nothing left over")
    mut rd2 = H2FrameReader.init(100)
    rd2.feed(h2_frame(0, 0, 1, payload(101, 1)))
    mut r2: Result[bool, str] = rd2.next()
    t.assert_true(r2.is_err, "frame above max_frame_size is an error")
    mut rd3 = H2FrameReader.init(100)
    rd3.feed(zeros(2))
    mut r3: Result[bool, str] = rd3.next()
    t.assert_true(r3.is_ok and not r3.ok, "partial header: wait for more")
    t.assert_eq_str(h2_error_name(9), "COMPRESSION_ERROR", "error name")

    t.section("handshake and a request/response pair")
    mut cl = H2Conn.client()
    mut sv = H2Conn.server()
    t.assert_true(shuttle(cl, sv), "handshake exchanges cleanly")
    t.assert_true(cl.got_settings and sv.got_settings, "both sides saw SETTINGS")
    t.assert_eq_int(cl.settings_acked, 1, "client's SETTINGS acknowledged")
    t.assert_eq_int(sv.settings_acked, 1, "server's SETTINGS acknowledged")
    t.assert_eq_int(cl.remote.initial_window_size, 262144, "client learned the server's initial window")
    t.assert_eq_int(sv.remote.max_concurrent_streams, 100, "server learned the client's stream limit")
    mut rh = HpackHeaders.init()
    rh.add("User-Agent", "unit")
    rh.add("Accept", "*/*")
    mut sid = cl.send_request("GET", "http", "example.test", "/a?b=1", rh, "")
    t.assert_eq_int(sid, 1, "first client stream id is 1")
    t.assert_true(shuttle(cl, sv), "request delivered")
    t.assert_eq_int(sv.next_ready(), 1, "server has a complete request")
    mut sst = sv.stream(1)
    t.assert_eq_str(sst.headers.get(":method"), "GET", "method")
    t.assert_eq_str(sst.headers.get(":path"), "/a?b=1", "path")
    t.assert_eq_str(sst.headers.get(":authority"), "example.test", "authority")
    t.assert_eq_str(sst.headers.get("user-agent"), "unit", "header names are lower-cased on the wire")
    t.assert_eq_str(sst.headers.get("accept"), "*/*", "second header")
    sst.taken = true
    mut resp_h = HpackHeaders.init()
    resp_h.add("content-type", "text/plain")
    t.assert_true(sv.respond(1, 200, resp_h, "hello", HpackHeaders.init()), "respond queued")
    t.assert_true(shuttle(cl, sv), "response delivered")
    mut cst = cl.stream(1)
    t.assert_true(cst.recv_done, "client has the whole response")
    t.assert_eq_int(cst.status, 200, "status")
    t.assert_eq_str(cst.body_str(), "hello", "body")
    t.assert_eq_str(cst.headers.get("content-type"), "text/plain", "response header")
    t.assert_eq_int(cst.state, 4, "stream closed on both ends")
    t.assert_eq_int(sv.stream(1).state, 4, "server side closed too")
    cl.release(1)
    sv.release(1)
    t.assert_false(cl.has_stream(1), "released")
    t.assert_eq_int(sv.next_ready(), -1, "nothing pending")

    t.section("POST body, trailers, empty response")
    mut body = payload(50000, 3)
    mut ph = HpackHeaders.init()
    ph.add("content-type", "application/octet-stream")
    mut s2 = cl.send_request("POST", "http", "example.test", "/up", ph, body)
    t.assert_eq_int(s2, 3, "second stream id is 3")
    t.assert_true(shuttle(cl, sv), "upload delivered")
    t.assert_eq_int(sv.next_ready(), 3, "upload complete on the server")
    mut ust = sv.stream(3)
    t.assert_eq_int(ust.body_len(), 50000, "all 50000 bytes arrived")
    t.assert_eq_str(tohex(ust.body_str()), tohex(body), "binary body intact (NULs, high bytes)")
    t.assert_eq_str(ust.headers.get("content-length"), "50000", "content-length added automatically")
    ust.taken = true
    mut tr = HpackHeaders.init()
    tr.add("x-checksum", "abc123")
    mut noh = HpackHeaders.init()
    t.assert_true(sv.respond(3, 201, noh, "created", tr), "response with trailers")
    t.assert_true(shuttle(cl, sv), "response+trailers delivered")
    mut ct = cl.stream(3)
    t.assert_eq_int(ct.status, 201, "status 201")
    t.assert_eq_str(ct.body_str(), "created", "body before trailers")
    t.assert_true(ct.got_trailers, "trailers present")
    t.assert_eq_str(ct.trailers.get("x-checksum"), "abc123", "trailer value")
    cl.release(3)
    sv.release(3)
    mut s3 = cl.send_request("HEAD", "http", "example.test", "/e", noh, "")
    t.assert_true(shuttle(cl, sv), "HEAD delivered")
    sv.stream(s3).taken = true
    t.assert_true(sv.respond(s3, 204, noh, "", HpackHeaders.init()), "empty response (HEADERS+END_STREAM only)")
    t.assert_true(shuttle(cl, sv), "empty response delivered")
    t.assert_true(cl.stream(s3).recv_done, "client finished")
    t.assert_eq_int(cl.stream(s3).body_len(), 0, "no body")
    cl.release(s3)
    sv.release(s3)

    t.section("large header block uses CONTINUATION")
    mut lh = HpackHeaders.init()
    lh.add("cookie", payload(0, 1))
    mut sbb = StringBuilder.init(40100)
    mut ci = 0
    while ci < 40000:
        sbb.append_char(97 + (ci * 7 + ci / 13) % 26)
        ci = ci + 1
    mut longv = sbb.to_owned()
    sbb.free()
    mut lh2 = HpackHeaders.init()
    lh2.add("x-long", longv)
    mut s4 = cl.send_request("GET", "http", "example.test", "/long", lh2, "")
    t.assert_true(shuttle(cl, sv), "40 KB header block delivered")
    t.assert_eq_int(sv.next_ready(), s4, "request complete")
    t.assert_eq_str(sv.stream(s4).headers.get("x-long"), longv, "long header value intact")
    sv.stream(s4).taken = true
    sv.send_rst(s4, 8)
    shuttle(cl, sv)
    cl.release(s4)
    sv.release(s4)

    t.section("flow control with tiny windows")
    mut tiny = H2Settings.local_defaults()
    tiny.initial_window_size = 100
    mut cl2 = H2Conn.client()
    mut sv2 = H2Conn.with_settings(false, tiny)
    sv2.start()
    t.assert_true(shuttle(cl2, sv2), "handshake with a 100-byte window")
    t.assert_eq_int(cl2.remote.initial_window_size, 100, "client sees window 100")
    mut up = payload(5000, 11)
    mut s5 = cl2.send_request("POST", "http", "x", "/small", noh, up)
    t.assert_true(shuttle(cl2, sv2), "5000 bytes pass through a 100-byte window")
    t.assert_eq_int(sv2.next_ready(), s5, "upload complete")
    t.assert_eq_str(tohex(sv2.stream(s5).body_str()), tohex(up), "bytes intact after many window updates")
    # server -> client direction: the client's window is 262144, send 600000 bytes
    sv2.stream(s5).taken = true
    mut down = payload(600000, 5)
    sv2.respond(s5, 200, noh, down, HpackHeaders.init())
    t.assert_true(shuttle(cl2, sv2), "600000 bytes pass a 262144-byte stream window and 1 MiB connection window")
    t.assert_eq_int(cl2.stream(s5).body_len(), 600000, "all bytes received")
    t.assert_eq_str(tohex(cl2.stream(s5).body_str()), tohex(down), "download intact")
    # a sender must stop at zero window: freeze the receiver, observe a stall
    mut cl3 = H2Conn.client()
    mut sv3 = H2Conn.with_settings(false, tiny)
    sv3.start()
    shuttle(cl3, sv3)
    mut s6 = cl3.send_request("POST", "http", "x", "/stall", noh, payload(1000, 2))
    mut first = cl3.take_output()
    t.assert_true(first.len() > 0, "client emitted its first flight")
    feed(sv3, first)
    # deliver nothing back: the client may only have sent ~100 body bytes
    t.assert_true(cl3.stream(s6).out_has, "client still holds unsent body (window exhausted)")
    t.assert_eq_int(cl3.stream(s6).send_window, 0, "stream send window is exactly used up")
    t.assert_eq_int(sv3.stream(s6).body_len(), 100, "server got exactly one window of data")

    t.section("PING, GOAWAY, RST_STREAM")
    cl.send_ping("12345678")
    shuttle(cl, sv)
    t.assert_eq_int(cl.ping_acks, 1, "PING acknowledged")
    t.assert_eq_str(cl.ping_last, "12345678", "ACK echoes the payload")
    mut s7 = cl.send_request("GET", "http", "x", "/cancel", noh, "")
    shuttle(cl, sv)
    cl.send_rst(s7, 8)
    shuttle(cl, sv)
    t.assert_eq_int(sv.stream(s7).rst_code, 8, "server saw RST_STREAM CANCEL")
    t.assert_true(sv.stream(s7).rst_by_peer, "flagged as peer reset")
    t.assert_eq_int(sv.stream(s7).state, 4, "reset stream is closed")
    t.assert_eq_int(sv.next_ready(), -1, "a reset request is never handed out")
    cl.release(s7)
    sv.release(s7)
    sv.send_goaway(0, "bye")
    shuttle(cl, sv)
    t.assert_true(cl.goaway_recv, "client saw GOAWAY")
    t.assert_eq_str(cl.goaway_debug, "bye", "debug data")
    t.assert_eq_int(cl.send_request("GET", "http", "x", "/", noh, ""), -1, "no new requests after GOAWAY")

    t.section("protocol violations (server side)")
    mut dflt = H2Settings.local_defaults()
    mut v1 = H2Conn.with_settings(false, dflt)
    v1.start()
    t.assert_false(feed(v1, "GET / HTTP/1.1\r\nHost: x\r\n\r\n"), "HTTP/1.1 text instead of the preface")
    t.assert_eq_int(v1.err_code, 1, "bad preface -> PROTOCOL_ERROR")
    t.assert_true(v1.has_output(), "GOAWAY queued")
    mut v1b = v1.take_output()
    t.assert_eq_int(v1b.len() > 9, true as int, "server SETTINGS + GOAWAY in output")
    mut v2 = H2Conn.with_settings(false, dflt)
    v2.start()
    t.assert_false(feed(v2, cat(h2_preface(), h2_frame(6, 0, 0, "12345678"))), "first frame must be SETTINGS")
    t.assert_eq_int(v2.err_code, 1, "-> PROTOCOL_ERROR")
    mut v3 = mk_server(dflt)
    t.assert_false(feed(v3, h2_frame(0, 0, 0, "x")), "DATA on stream 0")
    t.assert_eq_int(v3.err_code, 1, "-> PROTOCOL_ERROR")
    mut v4 = mk_server(dflt)
    t.assert_false(feed(v4, h2_frame(1, 5, 0, "x")), "HEADERS on stream 0")
    t.assert_eq_int(v4.err_code, 1, "-> PROTOCOL_ERROR")
    mut v5 = mk_server(dflt)
    t.assert_false(feed(v5, h2_frame(4, 0, 0, "12345")), "SETTINGS length not a multiple of 6")
    t.assert_eq_int(v5.err_code, 6, "-> FRAME_SIZE_ERROR")
    mut v6 = mk_server(dflt)
    t.assert_false(feed(v6, h2_frame(4, 1, 0, "123456")), "SETTINGS ACK with payload")
    t.assert_eq_int(v6.err_code, 6, "-> FRAME_SIZE_ERROR")
    mut v7 = mk_server(dflt)
    t.assert_false(feed(v7, h2_frame(4, 0, 0, sett(4, 2147483648))), "INITIAL_WINDOW_SIZE above 2^31-1")
    t.assert_eq_int(v7.err_code, 3, "-> FLOW_CONTROL_ERROR")
    mut v8 = mk_server(dflt)
    t.assert_false(feed(v8, h2_frame(4, 0, 0, sett(5, 100))), "MAX_FRAME_SIZE below 16384")
    t.assert_eq_int(v8.err_code, 1, "-> PROTOCOL_ERROR")
    mut v9 = mk_server(dflt)
    t.assert_false(feed(v9, h2_frame(4, 0, 0, sett(2, 2))), "ENABLE_PUSH = 2")
    t.assert_eq_int(v9.err_code, 1, "-> PROTOCOL_ERROR")
    mut v10 = mk_server(dflt)
    t.assert_false(feed(v10, h2_frame(8, 0, 0, be32(0))), "connection WINDOW_UPDATE of 0")
    t.assert_eq_int(v10.err_code, 1, "-> PROTOCOL_ERROR")
    mut v11 = mk_server(dflt)
    t.assert_false(feed(v11, h2_frame(8, 0, 0, be32(2147483647))), "connection window overflow")
    t.assert_eq_int(v11.err_code, 3, "-> FLOW_CONTROL_ERROR")
    mut v12 = mk_server(dflt)
    t.assert_false(feed(v12, h2_frame(6, 0, 0, "1234567")), "PING with 7 bytes")
    t.assert_eq_int(v12.err_code, 6, "-> FRAME_SIZE_ERROR")
    mut v13 = mk_server(dflt)
    t.assert_false(feed(v13, h2_frame(0, 0, 1, payload(16385, 1))), "frame above MAX_FRAME_SIZE")
    t.assert_eq_int(v13.err_code, 6, "-> FRAME_SIZE_ERROR")
    mut v14 = mk_server(dflt)
    t.assert_false(feed(v14, h2_frame(5, 4, 1, be32(2))), "PUSH_PROMISE sent to a server")
    t.assert_eq_int(v14.err_code, 1, "-> PROTOCOL_ERROR")
    mut enc = HpackEncoder.init(4096)
    mut good = HpackHeaders.init()
    reqh(good)
    mut gb = hdr_block(enc, good)
    mut v15 = mk_server(dflt)
    t.assert_false(feed(v15, cat(h2_frame(1, 1, 1, gb), h2_frame(0, 0, 1, "x"))), "HEADERS without END_HEADERS then DATA")
    t.assert_eq_int(v15.err_code, 1, "-> PROTOCOL_ERROR")
    mut v16 = mk_server(dflt)
    t.assert_false(feed(v16, h2_frame(1, 5, 2, gb)), "client stream with an even id")
    t.assert_eq_int(v16.err_code, 1, "-> PROTOCOL_ERROR")
    mut v17 = mk_server(dflt)
    mut enc17 = HpackEncoder.init(4096)
    mut b17 = hdr_block(enc17, good)
    t.assert_true(feed(v17, h2_frame(1, 5, 5, b17)), "stream 5 opens")
    t.assert_false(feed(v17, h2_frame(1, 5, 3, hdr_block(enc17, good))), "stream 3 after stream 5 (closed)")
    t.assert_eq_int(v17.err_code, 5, "-> STREAM_CLOSED")
    mut v18 = mk_server(dflt)
    t.assert_false(feed(v18, h2_frame(1, 5, 1, bytes([255, 255, 255]))), "undecodable header block")
    t.assert_eq_int(v18.err_code, 9, "-> COMPRESSION_ERROR")
    mut v19 = mk_server(dflt)
    t.assert_false(feed(v19, h2_frame(0, 0, 7, "x")), "DATA on an idle stream")
    t.assert_eq_int(v19.err_code, 1, "-> PROTOCOL_ERROR")
    mut v20 = mk_server(dflt)
    t.assert_true(feed(v20, cat(h2_frame(99, 0, 0, "ignored"), h2_frame(2, 0, 1, cat(be32(0), bytes([16]))))), "unknown frame type and PRIORITY are ignored")
    t.assert_false(v20.closed, "connection stays up")
    t.assert_true(feed(v20, h2_frame(6, 0, 0, "abcdefgh")), "PING still works")

    t.section("stream errors keep the connection alive")
    mut e1 = mk_server(dflt)
    mut enc1 = HpackEncoder.init(4096)
    mut nopath = HpackHeaders.init()
    nopath.add(":method", "GET")
    nopath.add(":scheme", "http")
    mut out0 = e1.take_output()
    t.assert_true(feed(e1, h2_frame(1, 5, 1, hdr_block(enc1, nopath))), "missing :path accepted at connection level")
    t.assert_false(e1.closed, "connection alive")
    t.assert_eq_int(e1.stream(1).rst_code, 1, "stream reset with PROTOCOL_ERROR")
    t.assert_eq_int(e1.next_ready(), -1, "invalid request never handed out")
    mut up1 = HpackHeaders.init()
    reqh(up1)
    up1.add("X-Upper", "1")
    t.assert_true(feed(e1, h2_frame(1, 5, 3, hdr_block(enc1, up1))), "upper-case name accepted at connection level")
    t.assert_eq_int(e1.stream(3).rst_code, 1, "upper-case header name -> stream error")
    mut cs1 = HpackHeaders.init()
    reqh(cs1)
    cs1.add("connection", "close")
    t.assert_true(feed(e1, h2_frame(1, 5, 5, hdr_block(enc1, cs1))), "connection header accepted at connection level")
    t.assert_eq_int(e1.stream(5).rst_code, 1, "connection-specific header -> stream error")
    mut te1 = HpackHeaders.init()
    reqh(te1)
    te1.add("te", "gzip")
    t.assert_true(feed(e1, h2_frame(1, 5, 7, hdr_block(enc1, te1))), "TE: gzip accepted at connection level")
    t.assert_eq_int(e1.stream(7).rst_code, 1, "TE other than trailers -> stream error")
    mut te2 = HpackHeaders.init()
    reqh(te2)
    te2.add("te", "trailers")
    t.assert_true(feed(e1, h2_frame(1, 5, 9, hdr_block(enc1, te2))), "TE: trailers accepted")
    t.assert_eq_int(e1.stream(9).rst_code, -1, "TE: trailers is fine")
    t.assert_eq_int(e1.next_ready(), 9, "valid request handed out")
    # zero WINDOW_UPDATE on a stream is a stream error
    t.assert_true(feed(e1, h2_frame(8, 0, 9, be32(0))), "stream WINDOW_UPDATE 0 accepted at connection level")
    t.assert_eq_int(e1.stream(9).rst_code, 1, "-> RST_STREAM PROTOCOL_ERROR")
    # flow-control violation by the peer
    mut small = H2Settings.local_defaults()
    small.initial_window_size = 100
    mut e2 = mk_server(small)
    mut enc2 = HpackEncoder.init(4096)
    mut p2 = HpackHeaders.init()
    reqh(p2)
    t.assert_true(feed(e2, h2_frame(1, 4, 1, hdr_block(enc2, p2))), "POST headers (no END_STREAM)")
    t.assert_true(feed(e2, h2_frame(0, 0, 1, payload(200, 1))), "200 bytes into a 100-byte window")
    t.assert_eq_int(e2.stream(1).rst_code, 3, "-> RST_STREAM FLOW_CONTROL_ERROR")
    t.assert_false(e2.closed, "connection alive")
    # padding
    mut e3 = mk_server(dflt)
    mut enc3 = HpackEncoder.init(4096)
    mut p3 = HpackHeaders.init()
    reqh(p3)
    feed(e3, h2_frame(1, 4, 1, hdr_block(enc3, p3)))
    mut padok: Result[bool, str] = e3.receive(h2_frame(0, 9, 1, cat(bytes([3]), cat("hello", zeros(3)))))
    if padok.is_err: print("    err: " + padok.err)
    t.assert_true(padok.is_ok, "padded DATA with END_STREAM")
    t.assert_eq_str(e3.stream(1).body_str(), "hello", "padding stripped")
    t.assert_eq_int(e3.next_ready(), 1, "padded request complete")
    mut e4 = mk_server(dflt)
    mut enc4 = HpackEncoder.init(4096)
    feed(e4, h2_frame(1, 4, 1, hdr_block(enc4, p3)))
    t.assert_false(feed(e4, h2_frame(0, 9, 1, cat(bytes([9]), "hi"))), "pad length longer than the frame")
    t.assert_eq_int(e4.err_code, 1, "-> PROTOCOL_ERROR")
    # concurrent stream limit
    mut lim = H2Settings.local_defaults()
    lim.max_concurrent_streams = 2
    mut e5 = mk_server(lim)
    mut enc5 = HpackEncoder.init(4096)
    feed(e5, h2_frame(1, 4, 1, hdr_block(enc5, p3)))
    feed(e5, h2_frame(1, 4, 3, hdr_block(enc5, p3)))
    t.assert_true(feed(e5, h2_frame(1, 4, 5, hdr_block(enc5, p3))), "third concurrent stream")
    t.assert_eq_int(e5.stream(5).rst_code, 7, "-> RST_STREAM REFUSED_STREAM")
    t.assert_eq_int(e5.stream(3).rst_code, -1, "second stream unaffected")
    # trailers must end the stream
    mut e6 = mk_server(dflt)
    mut enc6 = HpackEncoder.init(4096)
    feed(e6, h2_frame(1, 4, 1, hdr_block(enc6, p3)))
    mut tt = HpackHeaders.init()
    tt.add("x-t", "1")
    t.assert_true(feed(e6, h2_frame(1, 4, 1, hdr_block(enc6, tt))), "trailers without END_STREAM accepted at connection level")
    t.assert_eq_int(e6.stream(1).rst_code, 1, "-> stream error")
    # DATA after END_STREAM on the same stream
    mut e7 = mk_server(dflt)
    mut enc7 = HpackEncoder.init(4096)
    feed(e7, h2_frame(1, 5, 1, hdr_block(enc7, p3)))
    t.assert_true(feed(e7, h2_frame(0, 0, 1, "late")), "DATA on a half-closed(remote) stream")
    t.assert_eq_int(e7.stream(1).rst_code, 5, "-> RST_STREAM STREAM_CLOSED")

    t.section("client side checks")
    mut cc = H2Conn.client()
    mut srv_enc = HpackEncoder.init(4096)
    feed(cc, h2_frame(4, 0, 0, ""))
    t.assert_false(feed(cc, h2_frame(5, 4, 2, be32(2))), "server PUSH_PROMISE refused")
    t.assert_eq_int(cc.err_code, 1, "-> PROTOCOL_ERROR")
    mut cc2 = H2Conn.client()
    feed(cc2, h2_frame(4, 0, 0, ""))
    mut r1 = cc2.send_request("GET", "http", "x", "/", noh, "")
    mut srv_enc2 = HpackEncoder.init(4096)
    mut interim = HpackHeaders.init()
    interim.add(":status", "103")
    mut finalh = HpackHeaders.init()
    finalh.add(":status", "200")
    finalh.add("x-a", "1")
    t.assert_true(feed(cc2, cat3(h2_frame(1, 4, r1, hdr_block(srv_enc2, interim)), h2_frame(1, 4, r1, hdr_block(srv_enc2, finalh)), h2_frame(0, 1, r1, "ok"))), "interim 1xx response then final response")
    t.assert_eq_int(cc2.stream(r1).status, 200, "final status wins")
    t.assert_eq_str(cc2.stream(r1).body_str(), "ok", "body")
    t.assert_eq_str(cc2.stream(r1).headers.get("x-a"), "1", "final headers kept")
    mut cc3 = H2Conn.client()
    feed(cc3, h2_frame(4, 0, 0, ""))
    mut r3b = cc3.send_request("GET", "http", "x", "/", noh, "")
    mut badresp = HpackHeaders.init()
    badresp.add("x-no-status", "1")
    mut senc3 = HpackEncoder.init(4096)
    t.assert_true(feed(cc3, h2_frame(1, 5, r3b, hdr_block(senc3, badresp))), "response without :status accepted at connection level")
    t.assert_eq_int(cc3.stream(r3b).rst_code, 1, "-> stream error")
    mut cc4 = H2Conn.client()
    feed(cc4, h2_frame(4, 0, 0, ""))
    mut senc4 = HpackEncoder.init(4096)
    t.assert_false(feed(cc4, h2_frame(1, 5, 1, hdr_block(senc4, finalh))), "HEADERS on a stream we never opened")
    t.assert_eq_int(cc4.err_code, 1, "-> PROTOCOL_ERROR")
    # concurrency limit announced by the peer
    mut cc5 = H2Conn.client()
    feed(cc5, h2_frame(4, 0, 0, sett(3, 1)))
    t.assert_eq_int(cc5.send_request("GET", "http", "x", "/1", noh, ""), 1, "first stream fits")
    t.assert_eq_int(cc5.send_request("GET", "http", "x", "/2", noh, ""), -2, "second stream exceeds MAX_CONCURRENT_STREAMS=1")
    # SETTINGS_INITIAL_WINDOW_SIZE change adjusts open streams
    mut cc6 = H2Conn.client()
    feed(cc6, h2_frame(4, 0, 0, ""))
    mut r6 = cc6.send_request("POST", "http", "x", "/", noh, payload(70000, 4))
    t.assert_eq_int(cc6.stream(r6).send_window, 0, "default 65535-byte window used up by the first flight")
    t.assert_true(cc6.stream(r6).out_has, "rest of the body is waiting")
    feed(cc6, h2_frame(4, 0, 0, sett(4, 70000)))
    t.assert_eq_int(cc6.stream(r6).send_window, 4465, "stream window grows by the SETTINGS delta (70000 - 65535)")
    t.assert_true(cc6.stream(r6).out_has, "but the exhausted connection window still blocks sending")
    t.assert_eq_int(cc6.send_window, 0, "connection window still exhausted")
    feed(cc6, h2_frame(8, 0, 0, be32(10000)))
    t.assert_false(cc6.stream(r6).out_has, "after a connection WINDOW_UPDATE the rest of the body is sent")
    t.assert_eq_int(cc6.stream(r6).state, 2, "request fully sent: half-closed (local)")

    t.summary()
