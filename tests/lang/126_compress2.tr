# tests/lang/126_compress2.tr
# std.compress.bzip2 / xz / brotli: the vendored libbzip2, XZ Embedded and
# Google brotli decoders plus the LZMA-alone decoder. Every vector below was
# produced by Python's bz2 and lzma modules, the `xz` CLI and the `brotli`
# Python package (1.2.0); the 5 MiB vectors decode to the big_data() rows.
# Covers multi-stream input, all xz check types, BCJ, multiple blocks, empty
# input, streaming in small chunks, corrupt / truncated input and max_out.

from std.test import TestRunner
from std.compress.bzip2 import Bzip2, Bzip2Decoder, Bzip2Encoder
from std.compress.xz import Xz, XzDecoder, Lzma, LzmaDecoder
from std.compress.brotli import Brotli, BrotliDecoder
from std.compress import Compress
from std.encoding.hex import Hex
from std.io.archive import Crc32
from std.core.string import StringBuilder
from std.io.tar import TarWriter, TarReader

const T1_HEX = "68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c64"
const BIN_HEX = ""
const T2 = "The information in this document is provided for the purpose of international development. Please contact the government office for more details about the application process, the available services and the following requirements."
const BIG_LEN = 5242880
const BIG_CRC = 1897977516
const BZ_T1 = "425a6839314159265359c91bd5b700000491804000064490802000310c081281ea08286646e820773e2ee48a70a1219237ab6e"
const BZ_BIN_1 = ""
const BZ_EMPTY = "425a683917724538509000000000"
const BZ_MULTI = ""
const BZ_BIG_LEN = 26690
const XZ_T2_NONE = ""
const XZ_T2_CRC32 = ""
const XZ_T2_CRC64 = ""
const XZ_T2_SHA256 = ""
const XZ_EMPTY = "fd377a585a000004e6d6b446000000001cdf44211fb6f37d010000000004595a"
const XZ_MULTI = ""
const XZ_X86 = ""
const XZ_BLOCKS = ""
const XZ_BIG = ""
const LZ_T2 = ""
const LZ_T1_SIZED = "5d00008000ffffffffffffffff00341949ee8de9560c612a6f6bd329a6215fffef720000"
const LZ_BIN_LC0 = ""
const LZ_BIG = ""
# T2 as t2.txt, made by `tar --format=ustar -cJf`
const TAR_XZ = ""
const BR_T1_Q0 = "0b0e8068656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c6403"
const BR_T2_Q11 = "1be500401d89b18d8a7d734825be442ba34a9036ba647149031d9c06ea75090a2ce21a51a0277e4f49e621c6cf7600cc6e546e8f1f501c006c6f71418b1e8a53fc4062e90a21c725a988b99d2b594619213f27d60c"
const BR_T2_Q5 = "1be5000004fedb66aa8f2eb66428a2a77ed0ddf0d8ce1dc101d3175dcfd61626b59d45813c946046c1fbbb7273973e6f65c785b72c6374f35fc44941f7660a43411e43fbb93c3c43e0f3ddd7c3f0c19d645c5febc685d44b06dfe98005025b1f6ab6ec387e0d22059c0bb6c84280dea7c9f6576da9898c45c419a2dcf44c920fb45f8e0c"
const BR_BIN_Q9 = ""
const BR_EMPTY = "3b"
const BR_BIG = ""


def hx(s: str) -> str:
    return Hex.decode(s)

# 5 MiB of table rows (the same generator produced the Python vectors).
def big_data() -> str:
    mut sb = StringBuilder.init(5300000)
    mut i = 0
    while sb.len() < BIG_LEN:
        sb.append("row ")
        sb.append_int(i % 1000)
        sb.append(" of the table, value ")
        sb.append_int((i * 37) % 100)
        sb.append("\n")
        i = i + 1
    mut s = sb.to_owned()
    sb.free()
    return s.slice(0, BIG_LEN)

# `s` with the byte at `i` XOR-ed with `mask`.
def flip(s: str, i: int, mask: int) -> str:
    mut h = Hex.encode(s)
    mut b = Hex.decode(h)
    mut p = b as Pointer[char]
    unsafe:
        mut v = p.offset(i).read() as int & 0xFF
        p.offset(i).write(((v ^ mask) & 0xFF) as char)
    return b

def test_bzip2(t: TestRunner) throws str:
    t.section("bzip2")
    mut t1 = hx(T1_HEX)
    mut bin = hx(BIN_HEX)
    t.assert_eq_str(Bzip2.decompress(hx(BZ_T1))?, t1, "decode Python bz2 level 9")
    t.assert_eq_str(Hex.encode(Bzip2.decompress(hx(BZ_BIN_1))?), BIN_HEX, "decode binary level 1")
    t.assert_eq_str(Hex.encode(Bzip2.compress(t1, 9)?), BZ_T1, "encoder output is byte-identical to Python bz2")
    t.assert_eq_str(Hex.encode(Bzip2.compress(bin, 1)?), BZ_BIN_1, "level 1 identical too")
    t.assert_eq_str(Hex.encode(Bzip2.decompress(hx(BZ_MULTI))?), T1_HEX + BIN_HEX, "two concatenated streams")
    t.assert_eq_int(Bzip2.decompress(hx(BZ_EMPTY))?.len(), 0, "stream of empty data")
    t.assert_eq_str(Hex.encode(Bzip2.compress("", 9)?), BZ_EMPTY, "compress empty")
    t.assert_eq_int(Bzip2.decompress("")?.len(), 0, "empty input decodes to empty (like Python)")
    t.assert_true(Bzip2.is_bzip2(hx(BZ_T1)), "is_bzip2")
    t.assert_false(Bzip2.is_bzip2(t1), "is_bzip2 on text")

    mut bad: Result[str, str] = Bzip2.decompress("not bzip2 at all")
    t.assert_true(bad.is_err, "bad magic raises")
    if bad.is_err: t.assert_contains(bad.err, "bad header magic", "bad magic message")
    mut c = hx(BZ_T1)
    mut tr: Result[str, str] = Bzip2.decompress(c.slice(0, c.len() - 5))
    t.assert_true(tr.is_err, "truncated raises")
    if tr.is_err: t.assert_contains(tr.err, "truncated", "truncated message")
    mut cr: Result[str, str] = Bzip2.decompress(flip(c, 20, 0x10))
    t.assert_true(cr.is_err, "corrupt block raises (CRC)")
    mut trail: Result[str, str] = Bzip2.decompress(c + "garbage")
    t.assert_true(trail.is_err, "trailing garbage raises")
    mut lim: Result[str, str] = Bzip2.decompress_max(c, 10)
    t.assert_true(lim.is_err, "max_out limit raises")
    if lim.is_err: t.assert_contains(lim.err, "max_out", "limit message")
    t.assert_eq_int(Bzip2.decompress_max(c, t1.len())?.len(), t1.len(), "limit equal to the size is fine")

    # streaming: one byte at a time
    mut d = Bzip2Decoder.init(0)?
    mut sb = StringBuilder.init(64)
    mut m = hx(BZ_MULTI)
    mut i = 0
    while i < m.len():
        sb.append(d.feed(m.slice(i, i + 1))?)
        i = i + 1
    t.assert_eq_int(d.streams(), 2, "decoder counted two streams")
    sb.append(d.finish()?)
    t.assert_eq_str(Hex.encode(sb.to_owned()), T1_HEX + BIN_HEX, "byte-at-a-time decode")
    sb.free()
    mut d2 = Bzip2Decoder.init(0)?
    d2.feed(c.slice(0, 10))?
    mut fin: Result[str, str] = d2.finish()
    t.assert_true(fin.is_err, "finish on a partial stream raises")
    mut again: Result[str, str] = d2.feed("x")
    t.assert_true(again.is_err, "feed after close raises")

    mut e = Bzip2Encoder.init(9)?
    mut enc = e.feed("hello hello ")?
    enc = enc + e.feed("hello hello world")?
    enc = enc + e.finish()?
    t.assert_eq_str(Hex.encode(enc), BZ_T1, "streaming encoder")

def test_bzip2_big(t: TestRunner, big: str) throws str:
    t.section("bzip2 5 MiB")
    mut c = Bzip2.compress(big, 9)?
    t.assert_eq_int(c.len(), BZ_BIG_LEN, "same size as Python's bz2 (6 blocks)")
    mut d = Bzip2.decompress(c)?
    t.assert_eq_int(d.len(), BIG_LEN, "round trip length")
    t.assert_true(d == big, "round trip content")
    # streaming in 64 KiB pieces
    mut dec = Bzip2Decoder.init(0)?
    mut total = 0
    mut i = 0
    while i < c.len():
        mut part = dec.feed(c.slice(i, i + 65536))?
        total = total + part.len()
        i = i + 65536
    total = total + dec.finish()?.len()
    t.assert_eq_int(total, BIG_LEN, "streamed output size")
    mut lim: Result[str, str] = Bzip2.decompress_max(c, 1000000)
    t.assert_true(lim.is_err, "bomb limit on the 5 MiB stream")

def test_xz(t: TestRunner) throws str:
    t.section("xz")
    mut t1 = hx(T1_HEX)
    t.assert_eq_str(Xz.decompress(hx(XZ_T2_NONE))?, T2, "check none")
    t.assert_eq_str(Xz.decompress(hx(XZ_T2_CRC32))?, T2, "check CRC32")
    t.assert_eq_str(Xz.decompress(hx(XZ_T2_CRC64))?, T2, "check CRC64")
    t.assert_eq_str(Xz.decompress(hx(XZ_T2_SHA256))?, T2, "check SHA-256")
    t.assert_eq_int(Xz.decompress(hx(XZ_EMPTY))?.len(), 0, "stream of empty data")
    t.assert_eq_str(Hex.encode(Xz.decompress(hx(XZ_MULTI))?), T1_HEX + BIN_HEX, "two streams with padding")
    t.assert_eq_str(Hex.encode(Xz.decompress(hx(XZ_X86))?), BIN_HEX, "BCJ x86 filter")
    t.assert_eq_str(Hex.encode(Xz.decompress(hx(XZ_BLOCKS))?), BIN_HEX + BIN_HEX + BIN_HEX, "multiple blocks (xz --block-size)")
    t.assert_true(Xz.is_xz(hx(XZ_EMPTY)), "is_xz")
    t.assert_false(Xz.is_xz(t1), "is_xz on text")

    mut e0: Result[str, str] = Xz.decompress("")
    t.assert_true(e0.is_err, "empty input raises")
    mut bad: Result[str, str] = Xz.decompress("plain text, not xz")
    t.assert_true(bad.is_err, "bad magic raises")
    if bad.is_err: t.assert_contains(bad.err, "bad header magic", "bad magic message")
    mut c = hx(XZ_T2_SHA256)
    mut tr: Result[str, str] = Xz.decompress(c.slice(0, c.len() - 20))
    t.assert_true(tr.is_err, "truncated raises")
    if tr.is_err: t.assert_contains(tr.err, "truncated", "truncated message")
    # corrupt one byte of the SHA-256 check value (just before the index)
    mut cks: Result[str, str] = Xz.decompress(flip(c, c.len() - 40, 1))
    t.assert_true(cks.is_err, "SHA-256 mismatch raises")
    mut c32 = hx(XZ_T2_CRC32)
    mut payload: Result[str, str] = Xz.decompress(flip(c32, 40, 0x40))
    t.assert_true(payload.is_err, "corrupt payload raises")
    mut trail: Result[str, str] = Xz.decompress(c32 + "junk")
    t.assert_true(trail.is_err, "trailing junk raises")
    mut lim: Result[str, str] = Xz.decompress_max(c32, 100)
    t.assert_true(lim.is_err, "max_out limit raises")
    t.assert_eq_str(Xz.decompress_max(c32, T2.len())?, T2, "limit equal to the size is fine")

    mut d = XzDecoder.init(0)?
    mut sb = StringBuilder.init(64)
    mut m = hx(XZ_MULTI)
    mut i = 0
    while i < m.len():
        sb.append(d.feed(m.slice(i, i + 3))?)
        i = i + 3
    sb.append(d.finish()?)
    t.assert_eq_str(Hex.encode(sb.to_owned()), T1_HEX + BIN_HEX, "streaming, 3-byte chunks")
    sb.free()

def test_lzma(t: TestRunner) throws str:
    t.section("lzma (LZMA alone)")
    mut t1 = hx(T1_HEX)
    t.assert_eq_str(Lzma.decompress(hx(LZ_T2))?, T2, "Python FORMAT_ALONE")
    t.assert_eq_str(Lzma.decompress(hx(LZ_T1_SIZED))?, t1, "xz --format=lzma")
    t.assert_eq_str(Hex.encode(Lzma.decompress(hx(LZ_BIN_LC0))?), BIN_HEX, "lc=0 lp=2 pb=0")
    # the same stream with its size written into the header (size + end marker)
    mut c = hx(LZ_T2)
    mut sized = c.slice(0, 5) + hx("e600000000000000") + c.slice(13, c.len())
    t.assert_eq_str(Lzma.decompress(sized)?, T2, "known size followed by an end marker")
    mut wrong = c.slice(0, 5) + hx("e500000000000000") + c.slice(13, c.len())
    mut ws: Result[str, str] = Lzma.decompress(wrong)
    t.assert_true(ws.is_err, "wrong declared size raises")
    mut e0: Result[str, str] = Lzma.decompress("")
    t.assert_true(e0.is_err, "empty input raises")
    mut hdr: Result[str, str] = Lzma.decompress(hx("ff00008000ffffffffffffffff00"))
    t.assert_true(hdr.is_err, "invalid properties byte raises")
    mut tr: Result[str, str] = Lzma.decompress(c.slice(0, c.len() - 4))
    t.assert_true(tr.is_err, "truncated raises")
    mut lim: Result[str, str] = Lzma.decompress_max(c, 50)
    t.assert_true(lim.is_err, "max_out limit raises")
    mut d = LzmaDecoder.init(0)?
    mut sb = StringBuilder.init(64)
    mut i = 0
    while i < c.len():
        sb.append(d.feed(c.slice(i, i + 5))?)
        i = i + 5
    sb.append(d.finish()?)
    t.assert_eq_str(sb.to_owned(), T2, "streaming, 5-byte chunks")
    sb.free()

def test_brotli(t: TestRunner) throws str:
    t.section("brotli")
    mut t1 = hx(T1_HEX)
    t.assert_eq_str(Brotli.decompress(hx(BR_T1_Q0))?, t1, "quality 0")
    t.assert_eq_str(Brotli.decompress(hx(BR_T2_Q11))?, T2, "quality 11 (static dictionary + transforms)")
    t.assert_eq_str(Brotli.decompress(hx(BR_T2_Q5))?, T2, "quality 5 text mode")
    t.assert_eq_str(Hex.encode(Brotli.decompress(hx(BR_BIN_Q9))?), BIN_HEX, "binary quality 9")
    t.assert_eq_int(Brotli.decompress(hx(BR_EMPTY))?.len(), 0, "stream of empty data")
    mut e0: Result[str, str] = Brotli.decompress("")
    t.assert_true(e0.is_err, "empty input raises")
    mut c = hx(BR_T2_Q11)
    mut tr: Result[str, str] = Brotli.decompress(c.slice(0, c.len() - 3))
    t.assert_true(tr.is_err, "truncated raises")
    if tr.is_err: t.assert_contains(tr.err, "truncated", "truncated message")
    mut trail: Result[str, str] = Brotli.decompress(c + "x")
    t.assert_true(trail.is_err, "trailing data raises")
    mut junk: Result[str, str] = Brotli.decompress("this is not brotli data, honestly")
    t.assert_true(junk.is_err, "garbage raises")
    mut lim: Result[str, str] = Brotli.decompress_max(c, 64)
    t.assert_true(lim.is_err, "max_out limit raises")
    mut d = BrotliDecoder.init(0)?
    mut sb = StringBuilder.init(64)
    mut i = 0
    while i < c.len():
        sb.append(d.feed(c.slice(i, i + 1))?)
        i = i + 1
    t.assert_true(d.done, "decoder saw the end of the stream")
    sb.append(d.finish()?)
    t.assert_eq_str(sb.to_owned(), T2, "byte-at-a-time decode")
    sb.free()

def test_big(t: TestRunner, big: str) throws str:
    t.section("5 MiB vectors")
    mut x = Xz.decompress(hx(XZ_BIG))?
    t.assert_eq_int(x.len(), BIG_LEN, "xz length")
    t.assert_true(x == big, "xz content")
    mut l = Lzma.decompress(hx(LZ_BIG))?
    t.assert_true(l == big, "lzma content")
    mut b = Brotli.decompress(hx(BR_BIG))?
    t.assert_true(b == big, "brotli content")
    t.assert_eq_int(Crc32.compute(b, b.len()), BIG_CRC, "CRC32 matches Python's zlib.crc32")
    mut lx: Result[str, str] = Xz.decompress_max(hx(XZ_BIG), 4194304)
    t.assert_true(lx.is_err, "xz bomb limit")
    mut lb: Result[str, str] = Brotli.decompress_max(hx(BR_BIG), 4194304)
    t.assert_true(lb.is_err, "brotli bomb limit")
    mut ll: Result[str, str] = Lzma.decompress_max(hx(LZ_BIG), 4194304)
    t.assert_true(ll.is_err, "lzma bomb limit")

# The docs' example: open a .tar.bz2 / .tar.xz by name.
def open_tarball(data: str, name: str) throws str -> TarReader:
    mut raw = data
    if name.ends_with(".tar.bz2") or name.ends_with(".tbz2"):
        raw = Bzip2.decompress(data)?
    elif name.ends_with(".tar.xz") or name.ends_with(".txz"):
        raw = Xz.decompress(data)?
    return TarReader.open(raw, raw.len())

def test_tarball(t: TestRunner) throws str:
    t.section("tar.bz2 / tar.xz")
    mut w = TarWriter.init()
    w.add_entry("a.txt", T2, T2.len())
    mut bin = hx(BIN_HEX)
    w.add_entry("b.bin", bin, bin.len())
    mut tarb = w.finish()
    mut r = open_tarball(Bzip2.compress(tarb, 9)?, "x.tar.bz2")?
    t.assert_eq_int(r.entry_count(), 2, "tar.bz2 entries")
    t.assert_eq_str(r.read_entry(r.find_entry("a.txt")), T2, "tar.bz2 text entry")
    t.assert_eq_str(Hex.encode(r.read_entry(r.find_entry("b.bin"))), BIN_HEX, "tar.bz2 binary entry")
    mut rx = open_tarball(hx(TAR_XZ), "y.tar.xz")?
    t.assert_eq_int(rx.entry_count(), 1, "tar.xz from the tar + xz CLIs")
    t.assert_eq_str(rx.entry_name(0), "t2.txt", "tar.xz entry name")
    t.assert_eq_str(rx.read_entry(0), T2, "tar.xz entry content")

def test_by_name(t: TestRunner):
    t.section("Compress by name")
    t.assert_eq_str(Compress.detect(hx(BZ_T1)), "bzip2", "detect bzip2")
    t.assert_eq_str(Compress.detect(hx(XZ_EMPTY)), "xz", "detect xz")
    t.assert_eq_str(Compress.detect(hx(BR_T1_Q0)), "", "brotli has no magic")
    t.assert_true(Compress.supports("brotli"), "supports brotli")
    mut c = hx(XZ_T2_CRC64)
    mut r = Compress.decompress("xz", c, c.len(), 1 << 20)
    t.assert_true(r.ok, "by-name xz")
    t.assert_eq_str(r.to_str(), T2, "by-name xz output")
    r.free()
    mut b = Compress.compress("bzip2", T2, T2.len())
    t.assert_true(b.ok, "by-name bzip2 compress")
    mut bs = b.to_str()
    mut back = Compress.decompress("bzip2", bs, bs.len(), 1 << 20)
    t.assert_eq_str(back.to_str(), T2, "by-name bzip2 round trip")
    b.free()
    back.free()
    mut bad = Compress.decompress("brotli", "zz", 2, 100)
    t.assert_false(bad.ok, "by-name failure")
    t.assert_contains(bad.err, "brotli", "failure names the codec")

def main():
    mut t = TestRunner.init("126_compress2")
    mut r1: Result[bool, str] = run_all(t)
    t.assert_true(r1.is_ok, "no unexpected error")
    if r1.is_err: print(r1.err)
    test_by_name(t)
    t.summary()

def run_all(t: TestRunner) throws str -> bool:
    test_bzip2(t)?
    test_xz(t)?
    test_lzma(t)?
    test_brotli(t)?
    test_tarball(t)?
    mut big = big_data()
    t.assert_eq_int(Crc32.compute(big, big.len()), BIG_CRC, "generator matches Python")
    test_big(t, big)?
    test_bzip2_big(t, big)?
    return true
