# tests/lang/162_transform.tr - std.image.transform: resize (nearest/bilinear/
# bicubic/lanczos), crop, flips/rotations, convolution filters, colour
# adjustments and alpha compositing.
#
# Expected pixels for resize / arbitrary-angle rotate / grayscale come from
# Pillow (PIL.Image.resize / rotate / convert("L")) on the same 10x8 source:
# resizing matches within +-1 level (exactly for nearest/bicubic/lanczos on the
# opaque source). Everything else is checked against independent per-pixel
# definitions.

from std.test import TestRunner
from std.image import Image
from std.image.buf import new_image
from std.image.transform import *
from std.compress.common import rd8

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

def nib(c: int) -> int:
    if c >= 97: return c - 87
    if c >= 65: return c - 55
    return c - 48

# hex string -> RGBA image of w x h
def from_hex(h: str, w: int, ht: int) -> Image:
    mut img = new_image(w, ht)
    mut hp = h as Pointer[char]
    mut i = 0
    while i < w * ht * 4:
        img.pixels.set(i, (nib(rd8(hp, 2 * i)) * 16 + nib(rd8(hp, 2 * i + 1))) as u8)
        i = i + 1
    return img

def maxdiff(a: Image, b: Image) -> int:
    if a.width != b.width or a.height != b.height:
        return 9999
    mut m = 0
    mut n = a.width * a.height * 4
    mut i = 0
    while i < n:
        mut d = (a.pixels.get(i) as int) - (b.pixels.get(i) as int)
        if d < 0:
            d = 0 - d
        if d > m:
            m = d
        i = i + 1
    return m

def px(img: Image, x: int, y: int, c: int) -> int:
    mut r, g, b, a = img.get_pixel(x, y)
    if c == 0: return r
    if c == 1: return g
    if c == 2: return b
    return a

def source(alpha: bool) -> Image:
    mut im = Image.init(10, 8)
    mut y = 0
    while y < 8:
        mut x = 0
        while x < 10:
            mut a = 255
            if alpha and (x + y) % 3 != 0:
                a = (x * 28 + y * 9) % 256
            im.set_pixel(x, y, (x * 25 + y * 3) % 256, (x * x * 3 + y * 40) % 256, (x * y * 9 + 17) % 256, a)
            x = x + 1
        y = y + 1
    return im

def chk_resize(t: TestRunner, src: Image, hex_: str, w: int, h: int, filter: int, tol: int, name: str):
    mut e = from_hex(hex_, w, h)
    mut r = resize_image(src, w, h, filter)
    t.assert_true(maxdiff(r, e) <= tol, name)
    e.free()
    r.free()

def chk_rot(t: TestRunner, src: Image, hex_: str, w: int, h: int, deg: float, expand: bool, smooth: bool, tol: int, name: str):
    mut e = from_hex(hex_, w, h)
    mut r = rotate(src, deg, expand, smooth)
    t.assert_eq_int(r.width, w, name + ": width")
    t.assert_eq_int(r.height, h, name + ": height")
    t.assert_true(maxdiff(r, e) <= tol, name + ": pixels")
    e.free()
    r.free()

def chk_gray(t: TestRunner, src: Image, hex_: str):
    mut e = from_hex(hex_, 10, 8)
    mut r = grayscale(src)
    t.assert_true(maxdiff(r, e) <= 1, "grayscale within 1 of Pillow L")
    e.free()
    r.free()

def solid(w: int, h: int, r: int, g: int, b: int, a: int) -> Image:
    mut im = Image.init(w, h)
    fill_rect(im, 0, 0, w, h, r, g, b, a)
    return im

def main():
    mut t = TestRunner.init("162_transform")
    mut s = source(false)
    mut sa = source(true)
    t.assert_eq_int(px(s, 3, 2, 0), 81, "source sanity")

    t.section("resize vs Pillow (opaque 10x8 source)")
    chk_resize(t, s, "1c2b1aff4e432cff80733effb2bb50ffe41b62ff227b2cff549362ff86c398ffb80bceffea6b04ff28cb3eff5ae398ff8c13f2ffbe5b4cfff0bba6ff2e1b50ff6033ceff92634cffc4abcafff60b48ff", 5, 4, FILTER_NEAREST, 0, "nearest 5x4 within 0 of Pillow")
    chk_resize(t, s, "", 16, 12, FILTER_NEAREST, 0, "nearest 16x12 within 0 of Pillow")
    chk_resize(t, s, "032811ff353423ff4e432cff80733eff999447ffb2bb50ffe41b62ff0ca011ff3eac59ff57bb7dff89ebc5ffa20ce9ffbb330dffed9355ff12f011ff44fc7dff5d0bb3ff8f3b1fffa85c55ffc1838bfff3e3f7ff", 7, 3, FILTER_NEAREST, 0, "nearest 7x3 within 0 of Pillow")
    chk_resize(t, s, "142015ff413221ff735c2effa5993bffd19e46ff1a6721ff47794aff799f77ffab8d94ffd75382ff20b72eff4db977ff7f97acffb15175ffdd8373ff25913aff526c91ff844d74ffb67c78ffe29c88ff", 5, 4, FILTER_BILINEAR, 1, "bilinear 5x4 within 1 of Pillow")
    chk_resize(t, s, "", 16, 12, FILTER_BILINEAR, 1, "bilinear 16x12 within 1 of Pillow")
    chk_resize(t, s, "0c2d14ff2c3521ff504930ff746a3eff97944cffbba45affdb7a5aff148d1cff349544ff58a472ff7caf9cff9f7c98ffc3527cffe36f6eff1ba324ff3ba768ff5f6aa3ff835c83ffa65b6bffca907bffea9c92ff", 7, 3, FILTER_BILINEAR, 1, "bilinear 7x3 within 1 of Pillow")
    chk_resize(t, s, "101714ff3f291dff735327ffa6a032ffd5a642ff15631dff447747ff78ab78ffab96a2ffda4287ff1cc127ff4bc979ff7fa1c1ffb23b6bffe18c6fff219232ff50659eff843d6bffb78477ffe6a28cff", 5, 4, FILTER_BICUBIC, 2, "bicubic 5x4 within 2 of Pillow")
    chk_resize(t, s, "", 16, 12, FILTER_BICUBIC, 2, "bicubic 16x12 within 2 of Pillow")
    chk_resize(t, s, "092413ff2b2c1eff50412aff736435ff979946ffbcad5affde7859ff109319ff329b43ff57af74ff7abaa7ff9e7ca1ffc3457effe56e70ff18a21fff3aaa6bff5f66b0ff825582ffa65164ffcb9778ffeda193ff", 7, 3, FILTER_BICUBIC, 2, "bicubic 7x3 within 2 of Pillow")
    chk_resize(t, s, "0f1513ff40261cff724b24ffa5a62dffd6a945ff145f1dff457146ff77b677ffaa9aacffdb3684ff1bc724ff4cd379ff7ea2ccffb12e67ffe2936eff20922eff5164a5ff833068ffb68b6fffe7a694ff", 5, 4, FILTER_LANCZOS, 3, "lanczos 5x4 within 3 of Pillow")
    chk_resize(t, s, "", 16, 12, FILTER_LANCZOS, 3, "lanczos 16x12 within 3 of Pillow")
    chk_resize(t, s, "071d13ff2b261dff4f3927ff73612eff96a146ffbab15effde7356ff0f9918ff33a044ff57b474ff7bbfb0ff9e7ca0ffc23f81ffe66d78ff18a21cff3caa6dff6069b5ff845481ffa74763ffcb9b71ffefa88fff", 7, 3, FILTER_LANCZOS, 3, "lanczos 7x3 within 3 of Pillow")
    t.section("resize with alpha (premultiplied)")
    chk_resize(t, sa, "0202127032271d604c2918a476562697957b25d3bab62ed8d6e120b6155d1a5f2c4e2a8b55724a8f76885cc09bb27ac8bd8a92efd557747b0f821873379d4b8055a66fac7dc8a3b59e84b0dfc33a7cebde5d4dac1cd6267d36cc56965ea0a3a77f8dbecea54465ddc05f50abe9b8b55318a31f7b415980975e2ca4bc86484dc9a56c67d8ccab4f84ebbe8692", 7, 5, FILTER_BILINEAR, 6, "bilinear with alpha within 6 of Pillow")
    chk_resize(t, sa, "0000106d31261e5c492115aa75502494947420d7bbbd27dad7ec1cb41366195a2949258f56704c88738458c49ac278c3c2909df7d943806d0b78117237a24e7c55ab69b17bdaacb19e8abee3c42b7df4e05b42b01ae2247d32d6509860a6afa47e8dcad1a5345ae7c05f43abf7e7ef4015ae1779415385955e21adc0854244caa46c69e1d1b84c7beec28897", 7, 5, FILTER_BICUBIC, 6, "bicubic with alpha within 6 of Pillow")
    chk_resize(t, sa, "00000f63382a205f461d13ab76532292926c1dd8bbc11fdbd9f61baf156f1d5e2842239158715285737c55c699d477bcc695acf8db42866c0969106f39a2547c54ad62b37ee7b3af9b8ac2e2c6247df7e35a3bb11cec267d31d74b9b60abb4a17c90d3cfac2c57ebbf6135acffffff3010b00e7c424e88925b1fb2c5893d39c7a8716dddcfbe5377edc085a0", 7, 5, FILTER_LANCZOS, 6, "lanczos with alpha within 6 of Pillow")

    t.section("rotate")
    chk_rot(t, s, "", 14, 12, 30.0, true, false, 0, "nearest 30 deg expand vs Pillow")
    chk_rot(t, s, "", 10, 8, 20.0, false, true, 2, "bilinear 20 deg same-size vs Pillow")

    t.section("colour adjustments")
    chk_gray(t, s, "")
    mut gg = grayscale(s)
    t.assert_eq_int(px(gg, 4, 4, 0), px(gg, 4, 4, 1), "gray R == G")
    t.assert_eq_int(px(gg, 4, 4, 1), px(gg, 4, 4, 2), "gray G == B")
    mut sat0 = saturation(s, 0.0)
    t.assert_true(maxdiff(sat0, gg) <= 1, "saturation 0 == grayscale")
    mut sat1 = saturation(s, 1.0)
    t.assert_eq_int(maxdiff(sat1, s), 0, "saturation 1 is identity")
    mut inv = invert(s)
    t.assert_eq_int(px(inv, 3, 2, 0), 255 - 81, "invert")
    t.assert_eq_int(px(inv, 3, 2, 3), 255, "invert keeps alpha")
    mut inv2 = invert(inv)
    t.assert_eq_int(maxdiff(inv2, s), 0, "invert twice")
    mut br = brightness(s, 40)
    t.assert_eq_int(px(br, 3, 2, 0), 121, "brightness +40")
    mut br2 = brightness(s, -200)
    t.assert_eq_int(px(br2, 3, 2, 0), 0, "brightness clamps at 0")
    mut ct1 = contrast(s, 1.0)
    t.assert_eq_int(maxdiff(ct1, s), 0, "contrast 1.0 identity")
    mut ct0 = contrast(s, 0.0)
    t.assert_eq_int(px(ct0, 7, 1, 1), 128, "contrast 0 -> mid grey")
    mut ct2 = contrast(s, 2.0)
    t.assert_eq_int(px(ct2, 3, 2, 0), 34, "contrast x2 about 128: (81-128)*2+128")
    mut gm1 = gamma(s, 1.0)
    t.assert_eq_int(maxdiff(gm1, s), 0, "gamma 1.0 identity")
    mut gm2 = gamma(s, 2.0)
    t.assert_eq_int(px(gm2, 3, 2, 0), 144, "gamma 2.0: 255*sqrt(81/255) = 143.7")
    mut th = threshold(s, 100)
    t.assert_true(px(th, 3, 2, 0) == 0 or px(th, 3, 2, 0) == 255, "threshold is binary")
    mut sp = sepia(solid(2, 2, 100, 100, 100, 255))
    t.assert_eq_int(px(sp, 0, 0, 0), 135, "sepia R of grey 100 (393+769+189)/10")
    t.assert_eq_int(px(sp, 0, 0, 2), 93, "sepia B")
    mut op = with_opacity(solid(2, 2, 9, 9, 9, 200), 0.5)
    t.assert_eq_int(px(op, 0, 0, 3), 100, "with_opacity 0.5")

    t.section("crop / flip / rotate90 / transpose")
    mut cr = crop(s, 2, 1, 4, 3)
    t.assert_eq_int(cr.width, 4, "crop width")
    t.assert_eq_int(cr.height, 3, "crop height")
    t.assert_eq_int(px(cr, 0, 0, 0), px(s, 2, 1, 0), "crop origin pixel")
    t.assert_eq_int(px(cr, 3, 2, 2), px(s, 5, 3, 2), "crop last pixel")
    mut co = crop(s, -2, -1, 4, 3)
    t.assert_eq_int(px(co, 0, 0, 3), 0, "out-of-bounds crop is transparent")
    t.assert_eq_int(px(co, 2, 1, 0), px(s, 0, 0, 0), "in-bounds part of the crop")
    t.assert_eq_int(crop(s, 0, 0, 0, 5).width, -1, "zero-width crop fails")
    mut fh = flip_h(s)
    mut fv = flip_v(s)
    t.assert_eq_int(px(fh, 0, 0, 0), px(s, 9, 0, 0), "flip_h")
    t.assert_eq_int(px(fv, 0, 0, 1), px(s, 0, 7, 1), "flip_v")
    mut fhh = flip_h(fh)
    t.assert_eq_int(maxdiff(fhh, s), 0, "flip_h twice")
    mut r1 = rotate90(s, 1)
    t.assert_eq_int(r1.width, 8, "rotate90 swaps dimensions")
    t.assert_eq_int(r1.height, 10, "rotate90 height")
    t.assert_eq_int(px(r1, 7, 0, 0), px(s, 0, 0, 0), "rotate90 cw: top-left goes to top-right")
    t.assert_eq_int(px(r1, 0, 0, 0), px(s, 0, 7, 0), "rotate90 cw: bottom-left goes to top-left")
    mut r3 = rotate90(s, 3)
    t.assert_eq_int(px(r3, 0, 9, 0), px(s, 0, 0, 0), "rotate90 ccw: top-left goes to bottom-left")
    mut r2 = rotate90(s, 2)
    t.assert_eq_int(px(r2, 9, 7, 2), px(s, 0, 0, 2), "rotate180")
    mut r4 = rotate90(s, 4)
    t.assert_eq_int(maxdiff(r4, s), 0, "four quarter turns")
    mut r13 = rotate90(r1, 3)
    t.assert_eq_int(maxdiff(r13, s), 0, "cw then ccw")
    mut rm = rotate90(s, -1)
    t.assert_eq_int(maxdiff(rm, r3), 0, "negative turns go anticlockwise")
    mut tp = transpose(s)
    t.assert_eq_int(tp.width, 8, "transpose width")
    t.assert_eq_int(px(tp, 2, 5, 1), px(s, 5, 2, 1), "transpose pixel")
    mut rd = rotate(s, 90.0, true, true)
    t.assert_eq_int(maxdiff(rd, r1), 0, "rotate(90) == rotate90(1)")
    mut rdd = rotate(s, 180.0, false, false)
    t.assert_eq_int(maxdiff(rdd, r2), 0, "rotate(180) == rotate90(2)")

    t.section("convolution / blur / edges")
    mut flat = solid(9, 7, 90, 120, 30, 255)
    mut bb = box_blur(flat, 2)
    t.assert_eq_int(maxdiff(bb, flat), 0, "box blur keeps a flat image")
    mut gb = gaussian_blur(flat, 1.7)
    t.assert_eq_int(maxdiff(gb, flat), 0, "gaussian keeps a flat image")
    mut sh = sharpen(flat, 1.0)
    t.assert_eq_int(maxdiff(sh, flat), 0, "sharpen keeps a flat image")
    mut ed = edge_detect(flat)
    t.assert_eq_int(px(ed, 4, 3, 0) + px(ed, 4, 3, 1) + px(ed, 4, 3, 2), 0, "edge detect of flat is black")
    mut so = sobel(flat)
    t.assert_eq_int(px(so, 4, 3, 0), 0, "sobel of flat is 0")
    mut imp = solid(11, 11, 0, 0, 0, 255)
    imp.set_pixel(5, 5, 255, 255, 255, 255)
    mut ib = box_blur(imp, 1)
    t.assert_eq_int(px(ib, 5, 5, 0), 28, "box blur impulse centre = 255/9")
    t.assert_eq_int(px(ib, 4, 4, 0), 28, "box blur impulse corner of window")
    t.assert_eq_int(px(ib, 7, 5, 0), 0, "box blur impulse outside window")
    mut ig = gaussian_blur(imp, 1.0)
    t.assert_true(px(ig, 5, 5, 0) > px(ig, 6, 5, 0), "gaussian peaks at the impulse")
    t.assert_eq_int(px(ig, 4, 5, 0), px(ig, 6, 5, 0), "gaussian is symmetric (x)")
    t.assert_eq_int(px(ig, 5, 4, 0), px(ig, 5, 6, 0), "gaussian is symmetric (y)")
    t.assert_eq_int(px(ig, 6, 5, 0), px(ig, 5, 6, 0), "gaussian is isotropic")
    mut kid = Kernel.init(3)
    kid.set(1, 1, 1.0)
    mut cid = convolve(s, kid)
    t.assert_eq_int(maxdiff(cid, s), 0, "identity kernel")
    mut ksh = Kernel.init(3)
    ksh.set(0, 1, 1.0)
    mut csh = convolve(s, ksh)
    t.assert_eq_int(px(csh, 5, 3, 0), px(s, 4, 3, 0), "kernel [1 0 0] shifts right")
    t.assert_eq_int(px(csh, 0, 3, 0), px(s, 0, 3, 0), "edge clamps")
    mut step = Image.init(8, 8)
    mut yy = 0
    while yy < 8:
        mut xx = 0
        while xx < 8:
            mut v = 0
            if xx >= 4:
                v = 200
            step.set_pixel(xx, yy, v, v, v, 255)
            xx = xx + 1
        yy = yy + 1
    mut se = edge_detect(step)
    t.assert_eq_int(px(se, 4, 4, 0), 255, "laplacian lights the edge")
    t.assert_eq_int(px(se, 1, 4, 0), 0, "and not the flat area")
    mut sb = sobel(step)
    t.assert_true(px(sb, 4, 4, 0) > 150, "sobel responds at the edge")
    t.assert_eq_int(px(sb, 1, 4, 0), 0, "sobel is 0 in the flat area")
    mut stp = sharpen(step, 1.0)
    t.assert_true(px(stp, 3, 4, 0) == 0 and px(stp, 4, 4, 0) > 200, "sharpen overshoots at an edge")
    mut emb = emboss(flat)
    t.assert_true(px(emb, 4, 3, 0) >= 0, "emboss runs")

    t.section("compositing")
    mut dst = solid(6, 6, 0, 0, 200, 255)
    composite(dst, solid(2, 2, 255, 0, 0, 255), 1, 1)
    t.assert_eq_int(px(dst, 1, 1, 0), 255, "opaque over: red")
    t.assert_eq_int(px(dst, 2, 2, 2), 0, "opaque over: blue gone")
    t.assert_eq_int(px(dst, 3, 3, 2), 200, "outside untouched")
    composite(dst, solid(2, 2, 255, 255, 255, 128), 4, 4)
    t.assert_eq_int(px(dst, 4, 4, 0), 128, "50% white over blue: R")
    t.assert_eq_int(px(dst, 4, 4, 2), 228, "50% white over blue: B")
    t.assert_eq_int(px(dst, 4, 4, 3), 255, "dst stays opaque")
    composite(dst, solid(2, 2, 9, 9, 9, 0), 0, 4)
    t.assert_eq_int(px(dst, 0, 4, 2), 200, "alpha 0 changes nothing")
    composite(dst, solid(4, 4, 1, 2, 3, 255), 4, 4)
    t.assert_eq_int(px(dst, 5, 5, 0), 1, "clipped at the right/bottom edge")
    composite(dst, solid(3, 3, 7, 7, 7, 255), -2, -2)
    t.assert_eq_int(px(dst, 0, 0, 0), 7, "clipped at the top-left")
    t.assert_eq_int(px(dst, 1, 1, 0), 255, "outside the clipped source")
    mut tdst = Image.init(3, 3)
    composite(tdst, solid(1, 1, 50, 60, 70, 100), 1, 1)
    t.assert_eq_int(px(tdst, 1, 1, 0), 50, "over transparent: colour copied")
    t.assert_eq_int(px(tdst, 1, 1, 3), 100, "over transparent: alpha copied")
    composite(tdst, solid(1, 1, 250, 0, 0, 100), 1, 1)
    t.assert_eq_int(px(tdst, 1, 1, 3), 161, "two 100-alpha layers: 100 + 100*(1-100/255)")
    t.assert_true(px(tdst, 1, 1, 0) > 150 and px(tdst, 1, 1, 0) < 200, "colours blended by alpha weight")
    mut od = solid(2, 1, 0, 0, 0, 255)
    composite_ex(od, solid(2, 1, 200, 200, 200, 255), 0, 0, 128)
    t.assert_true(px(od, 0, 0, 0) >= 99 and px(od, 0, 0, 0) <= 101, "composite_ex opacity 128")
    mut pd = solid(4, 4, 1, 1, 1, 255)
    paste(pd, solid(2, 2, 9, 8, 7, 0), 1, 1)
    t.assert_eq_int(px(pd, 1, 1, 3), 0, "paste copies alpha without blending")
    mut fl = flatten(solid(2, 2, 100, 100, 100, 0), 10, 20, 30)
    t.assert_eq_int(px(fl, 0, 0, 0), 10, "flatten transparent -> background")
    t.assert_eq_int(px(fl, 0, 0, 3), 255, "flatten is opaque")

    t.section("other")
    t.assert_eq_int(resize_image(s, 0, 4, 1).width, -1, "resize to zero fails")
    t.assert_eq_int(resize_image(s, 4, 4, 9).width, -1, "unknown filter fails")
    mut fit = resize_fit(s, 5, 5, FILTER_BILINEAR, false)
    t.assert_eq_int(fit.width, 5, "fit width")
    t.assert_eq_int(fit.height, 4, "fit keeps aspect ratio")
    mut fit2 = resize_fit(s, 50, 50, FILTER_BILINEAR, true)
    t.assert_eq_int(fit2.width, 10, "shrink_only does not enlarge")
    mut same = resize_image(s, 10, 8, FILTER_LANCZOS)
    t.assert_eq_int(maxdiff(same, s), 0, "resize to same size is a copy")
    mut cp = copy_image(s)
    cp.set_pixel(0, 0, 1, 2, 3, 4)
    t.assert_true(px(s, 0, 0, 0) != 1, "copy_image is independent")
    mut big = resize_image(source(false), 300, 200, FILTER_LANCZOS)
    t.assert_eq_int(big.width, 300, "upscale 30x")
    mut tiny = resize_image(big, 3, 2, FILTER_BICUBIC)
    t.assert_eq_int(tiny.height, 2, "downscale 100x")
    t.summary()
