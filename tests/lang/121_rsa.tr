# tests/lang/121_rsa.tr
# std.crypto.rsa: key parsing (PKCS#1 / PKCS#8 / SPKI / PKCS#1-public, PEM+DER),
# PKCS#1 v1.5 + RSASSA-PSS sign/verify, RSAES-OAEP. Fixtures were generated with
# the system `openssl` CLI (signatures/ciphertexts made by OpenSSL are verified /
# decrypted here; our deterministic outputs are compared with OpenSSL's and with an
# independent Python RFC 8017 implementation; our PSS signatures were verified with
# `openssl dgst -verify`).

from std.test import TestRunner
from std.crypto.rsa import Rsa, RsaPublicKey, RsaPrivateKey
from std.crypto.pkutil import Bytes, PkHash
from std.crypto.bn import bn_to_hex
from std.core.vec import Vec
from std.encoding.pem import Pem

def hx(s: str) -> Vec[int]:
    return Bytes.from_hex(s)

def msg() -> Vec[int]:
    return hx("5461757261726f205253412074657374206d657373616765200001ff202862696e6172792d7361666529")

def flip(v: Vec[int], i: int) -> Vec[int]:
    mut c = Bytes.clone(v)
    c.set(i, c.get(i) ^ 1)
    return c

