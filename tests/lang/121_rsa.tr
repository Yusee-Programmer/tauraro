def keys_test(t: TestRunner) throws str -> int:
    t.section("rsa: key parsing")
    mut k8 = Rsa.private_from_pem(KEY2048_PKCS8())?
    mut k1 = Rsa.private_from_pem(KEY2048_PKCS1())?
    mut pu = Rsa.public_from_pem(PUB2048_SPKI())?
    mut pu1 = Rsa.public_from_pem(PUB2048_PKCS1())?
    t.assert_eq_int(k8.bits, 2048, "PKCS#8 bits")
    t.assert_eq_int(k8.nbytes, 256, "PKCS#8 bytes")
    t.assert_true(k8.has_crt, "PKCS#8 has CRT params")
    t.assert_eq_str(bn_to_hex(k8.n), mod2048_hex(), "PKCS#8 modulus")
    t.assert_eq_str(bn_to_hex(k1.n), mod2048_hex(), "PKCS#1 modulus")
    t.assert_eq_str(bn_to_hex(pu.n), mod2048_hex(), "SPKI modulus")
    t.assert_eq_str(bn_to_hex(pu1.n), mod2048_hex(), "PKCS#1 public modulus")
    t.assert_eq_str(bn_to_hex(pu.e), "010001", "exponent 65537")
    t.assert_eq_str(bn_to_hex(k8.public_key().n), mod2048_hex(), "public_key() modulus")
    t.assert_eq_str(bn_to_hex(k8.d), bn_to_hex(k1.d), "same d from both formats")
    # serialization round-trips are byte-identical to OpenSSL's output
    t.assert_eq_str(Rsa.private_to_pem(k1), KEY2048_PKCS1().strip() + "\n", "PKCS#1 private re-encodes identically")
    t.assert_eq_str(Rsa.public_to_pem(pu), PUB2048_SPKI().strip() + "\n", "SPKI re-encodes identically")
    mut k25 = Rsa.private_from_pem(KEY1025())?
    t.assert_eq_int(k25.bits, 1025, "1025-bit key")
    t.assert_eq_str(bn_to_hex(k25.n), mod1025_hex(), "1025-bit modulus")
    # DER entry points
    mut der = Pem.decode(PUB2048_SPKI())?
    mut pud = Rsa.public_from_der(der.data)?
    t.assert_eq_int(pud.bits, 2048, "public_from_der")
    # bad inputs
    mut r1: Result[RsaPublicKey, str] = Rsa.public_from_pem("not a pem")
    t.assert_true(r1.is_err, "garbage public pem rejected")
    mut r2: Result[RsaPrivateKey, str] = Rsa.private_from_pem(PUB2048_SPKI())
    t.assert_true(r2.is_err, "public pem is not a private key")
    mut r3: Result[RsaPublicKey, str] = Rsa.public_from_der(Bytes.slice(der.data, 0, 100))
    t.assert_true(r3.is_err, "truncated SPKI rejected")
    mut r4: Result[RsaPublicKey, str] = Rsa.public_from_der(hx("3003020101"))
    t.assert_true(r4.is_err, "tiny structure rejected")
    return 0

def pkcs1_test(t: TestRunner) throws str -> int:
    t.section("rsa: PKCS#1 v1.5 signatures")
    mut k = Rsa.private_from_pem(KEY2048_PKCS8())?
    mut pu = Rsa.public_from_pem(PUB2048_SPKI())?
    mut algs = ["sha1", "sha256", "sha384", "sha512"]
    mut i = 0
    while i < 4:
        mut a = algs[i]
        mut s = sig("p1_" + a)
        t.assert_true(Rsa.verify_pkcs1(pu, a, msg(), s), f"verify OpenSSL {a} signature")
        t.assert_false(Rsa.verify_pkcs1(pu, a, flip(msg(), 3), s), f"{a}: modified message rejected")
        t.assert_false(Rsa.verify_pkcs1(pu, a, msg(), flip(s, 100)), f"{a}: modified signature rejected")
        t.assert_false(Rsa.verify_pkcs1(pu, a, msg(), Bytes.slice(s, 0, 255)), f"{a}: short signature rejected")
        mut mine = Rsa.sign_pkcs1(k, a, msg())?
        t.assert_eq_str(Bytes.to_hex(mine), Bytes.to_hex(s), f"{a}: our deterministic signature equals OpenSSL's")
        t.assert_true(Rsa.verify_pkcs1(pu, a, msg(), mine), f"{a}: verify own signature")
        i = i + 1
    t.assert_false(Rsa.verify_pkcs1(pu, "sha256", msg(), sig("p1_sha384")), "hash mismatch rejected")
    t.assert_false(Rsa.verify_pkcs1(pu, "md5", msg(), sig("p1_sha256")), "unsupported hash is false")
    # signature >= n
    mut big = Bytes.zeros(256)
    mut j = 0
    while j < 256:
        big.set(j, 255)
        j = j + 1
    t.assert_false(Rsa.verify_pkcs1(pu, "sha256", msg(), big), "signature >= modulus rejected")
    t.assert_false(Rsa.verify_pkcs1(pu, "sha256", msg(), Bytes.zeros(256)), "zero signature rejected")
    # pre-hashed variant
    mut d = PkHash.digest("sha256", msg())
    t.assert_true(Rsa.verify_pkcs1_digest(pu, "sha256", d, sig("p1_sha256")), "verify_pkcs1_digest")
    # odd-sized keys
    mut p1024 = Rsa.public_from_pem(PUB1024())?
    mut p1025 = Rsa.public_from_pem(PUB1025())?
    t.assert_true(Rsa.verify_pkcs1(p1024, "sha256", msg(), sig("k1024_p1")), "1024-bit key verifies")
    t.assert_true(Rsa.verify_pkcs1(p1025, "sha256", msg(), sig("k1025_p1")), "1025-bit key verifies")
    mut k1025 = Rsa.private_from_pem(KEY1025())?
    t.assert_eq_str(Bytes.to_hex(Rsa.sign_pkcs1(k1025, "sha256", msg())?), Bytes.to_hex(sig("k1025_p1")), "1025-bit deterministic signature equals OpenSSL's")
    # key too small for the hash
    mut k1024 = Rsa.private_from_pem(KEY1024())?
    mut rr: Result[Vec[int], str] = Rsa.sign_pkcs1(k1024, "sha512", msg())
    t.assert_false(rr.is_err, "1024-bit key can sign sha512 PKCS#1 (needs 83 bytes of 128)")
    return 0

def pss_test(t: TestRunner) throws str -> int:
    t.section("rsa: RSASSA-PSS")
    mut k = Rsa.private_from_pem(KEY2048_PKCS8())?
    mut pu = Rsa.public_from_pem(PUB2048_SPKI())?
    t.assert_true(Rsa.verify_pss(pu, "sha256", msg(), sig("pss256_32"), 32), "OpenSSL sha256/salt32, exact salt")
    t.assert_true(Rsa.verify_pss(pu, "sha256", msg(), sig("pss256_32"), -1), "OpenSSL sha256/salt32, any salt")
    t.assert_false(Rsa.verify_pss(pu, "sha256", msg(), sig("pss256_32"), 20), "wrong expected salt length rejected")
    t.assert_true(Rsa.verify_pss(pu, "sha256", msg(), sig("pss256_0"), 0), "OpenSSL sha256/salt0")
    t.assert_true(Rsa.verify_pss(pu, "sha384", msg(), sig("pss384_max"), -1), "OpenSSL sha384/max salt")
    t.assert_true(Rsa.verify_pss(pu, "sha512", msg(), sig("pss512_64"), 64), "OpenSSL sha512/salt64")
    t.assert_false(Rsa.verify_pss(pu, "sha256", flip(msg(), 0), sig("pss256_32"), 32), "modified message rejected")
    t.assert_false(Rsa.verify_pss(pu, "sha256", msg(), flip(sig("pss256_32"), 7), 32), "modified signature rejected")
    t.assert_false(Rsa.verify_pss(pu, "sha384", msg(), sig("pss256_32"), -1), "wrong hash rejected")
    t.assert_false(Rsa.verify_pss(pu, "sha256", msg(), sig("p1_sha256"), -1), "PKCS#1 signature is not a PSS signature")
    t.assert_false(Rsa.verify_pkcs1(pu, "sha256", msg(), sig("pss256_32")), "PSS signature is not a PKCS#1 signature")
    # signing
    mut mine = Rsa.sign_pss_with_salt(k, "sha256", msg(), salt32())?
    t.assert_eq_str(Bytes.to_hex(mine), Bytes.to_hex(pss_expected()), "sign_pss_with_salt equals the independent Python implementation")
    t.assert_true(Rsa.verify_pss(pu, "sha256", msg(), mine, 32), "verify own PSS signature")
    mut rnd = Rsa.sign_pss(k, "sha384", msg(), 48)?
    t.assert_true(Rsa.verify_pss(pu, "sha384", msg(), rnd, 48), "random-salt signature verifies")
    mut rnd2 = Rsa.sign_pss(k, "sha384", msg(), 48)?
    t.assert_false(Bytes.eq(rnd, rnd2), "two random-salt signatures differ")
    # key sizes whose emBits is a multiple of 8 (1025) / not (1024)
    mut p1024 = Rsa.public_from_pem(PUB1024())?
    mut p1025 = Rsa.public_from_pem(PUB1025())?
    t.assert_true(Rsa.verify_pss(p1024, "sha256", msg(), sig("k1024_pss"), 32), "1024-bit PSS verifies")
    t.assert_true(Rsa.verify_pss(p1025, "sha256", msg(), sig("k1025_pss"), 32), "1025-bit PSS verifies")
    t.assert_true(Rsa.verify_pss(p1025, "sha256", msg(), sig("k1025_pss_max"), -1), "1025-bit PSS max salt verifies")
    mut k1025 = Rsa.private_from_pem(KEY1025())?
    mut m25 = Rsa.sign_pss_with_salt(k1025, "sha256", msg(), salt32())?
    t.assert_eq_str(Bytes.to_hex(m25), Bytes.to_hex(pss1025_expected()), "1025-bit sign_pss_with_salt equals Python")
    t.assert_true(Rsa.verify_pss(p1025, "sha256", msg(), m25, 32), "1025-bit own PSS verifies")
    # salt too long for key
    mut k1024 = Rsa.private_from_pem(KEY1024())?
    mut rr: Result[Vec[int], str] = Rsa.sign_pss(k1024, "sha512", msg(), 64)
    t.assert_true(rr.is_err, "1024-bit key cannot do sha512 with a 64-byte salt")
    return 0

def oaep_test(t: TestRunner) throws str -> int:
    t.section("rsa: RSAES-OAEP")
    mut k = Rsa.private_from_pem(KEY2048_PKCS8())?
    mut pu = k.public_key()
    mut empty = Bytes.zeros(0)
    t.assert_eq_str(Bytes.to_hex(Rsa.oaep_decrypt(k, "sha1", oaep_openssl_sha1(), empty)?), Bytes.to_hex(oaep_msg()), "decrypt OpenSSL OAEP-SHA1")
    t.assert_eq_str(Bytes.to_hex(Rsa.oaep_decrypt(k, "sha256", oaep_openssl_sha256(), oaep_label())?), Bytes.to_hex(oaep_msg()), "decrypt OpenSSL OAEP-SHA256 with label")
    mut bad1: Result[Vec[int], str] = Rsa.oaep_decrypt(k, "sha256", oaep_openssl_sha256(), empty)
    t.assert_true(bad1.is_err, "wrong label rejected")
    mut bad2: Result[Vec[int], str] = Rsa.oaep_decrypt(k, "sha256", oaep_openssl_sha1(), empty)
    t.assert_true(bad2.is_err, "wrong hash rejected")
    mut bad3: Result[Vec[int], str] = Rsa.oaep_decrypt(k, "sha1", flip(oaep_openssl_sha1(), 50), empty)
    t.assert_true(bad3.is_err, "corrupted ciphertext rejected")
    mut bad4: Result[Vec[int], str] = Rsa.oaep_decrypt(k, "sha1", Bytes.slice(oaep_openssl_sha1(), 0, 255), empty)
    t.assert_true(bad4.is_err, "short ciphertext rejected")
    mut e1 = Rsa.oaep_encrypt_with_seed(pu, "sha1", oaep_msg(), empty, oaep_seed20())?
    t.assert_eq_str(Bytes.to_hex(e1), Bytes.to_hex(oaep_expected_sha1()), "OAEP-SHA1 with fixed seed equals Python")
    mut e2 = Rsa.oaep_encrypt_with_seed(pu, "sha256", oaep_msg(), oaep_label(), oaep_seed32())?
    t.assert_eq_str(Bytes.to_hex(e2), Bytes.to_hex(oaep_expected_sha256()), "OAEP-SHA256+label with fixed seed equals Python")
    mut rt = Rsa.oaep_encrypt(pu, "sha256", oaep_msg(), empty)?
    t.assert_eq_str(Bytes.to_hex(Rsa.oaep_decrypt(k, "sha256", rt, empty)?), Bytes.to_hex(oaep_msg()), "random-seed round trip")
    mut nothing = Bytes.zeros(0)
    mut rt0 = Rsa.oaep_encrypt(pu, "sha256", nothing, empty)?
    t.assert_eq_int(Rsa.oaep_decrypt(k, "sha256", rt0, empty)?.len, 0, "empty message round trip")
    t.assert_eq_int(Rsa.oaep_max_message(pu, "sha256"), 190, "max OAEP message for 2048/sha256")
    mut big = Bytes.zeros(191)
    mut rb: Result[Vec[int], str] = Rsa.oaep_encrypt(pu, "sha256", big, empty)
    t.assert_true(rb.is_err, "message too long rejected")
    return 0

def run(name: str, t: TestRunner, r: Result[int, str]):
    if r.is_err: t.fail(f"{name}: {r.err}")

def main():
    mut t = TestRunner.init("121_rsa")
    run("keys", t, keys_test(t))
    run("pkcs1", t, pkcs1_test(t))
    run("pss", t, pss_test(t))
    run("oaep", t, oaep_test(t))
    t.summary()
