def cat2(a: str, b: str) -> str:
    return a + "\n" + b + "\n"

def vc(leaf: str, inters: str, roots: str, host: str) throws str -> ChainResult:
    mut st = X509Store.init()
    st.add_pem(roots)
    mut l = X509.parse_pem(leaf)?
    return X509.verify_chain(l, X509.parse_pem_all(inters), st, host, NOW(), X509.default_options())

def expect_ok(t: TestRunner, what: str, r: ChainResult):
    if not r.ok: t.fail(f"{what}: expected success, got error: {r.error}")
    else: t.assert_true(true, what)

def expect_fail(t: TestRunner, what: str, r: ChainResult, frag: str):
    if r.ok: t.fail(f"{what}: expected failure containing '{frag}', but the chain verified")
    else: t.assert_true(r.error.find(frag) >= 0, f"{what} (error: {r.error})")

def parse_test(t: TestRunner) throws str -> int:
    t.section("x509: parse RSA leaf")
    mut l = X509.parse_pem(c_rsa_leaf())?
    t.assert_eq_int(l.version, 3, "version 3")
    t.assert_eq_str(Bytes.to_hex(l.serial), "03eb", "serial")
    t.assert_eq_str(l.subject.text, "O=Tauraro Test, CN=www.example.test", "subject text")
    t.assert_eq_str(l.subject.cn, "www.example.test", "subject CN")
    t.assert_eq_str(l.issuer.text, "O=Tauraro Test, CN=RSA Intermediate CA", "issuer text")
    t.assert_eq_int(l.not_before, 1577836800, "notBefore 2020-01-01")
    t.assert_eq_int(l.not_after, 2840140800, "notAfter 2060-01-01")
    t.assert_eq_str(l.sig_alg_oid, "1.2.840.113549.1.1.11", "sha256WithRSAEncryption")
    t.assert_eq_str(l.key_alg, "rsa", "key alg")
    t.assert_true(l.has_san, "has SAN")
    t.assert_eq_int(l.san_dns.len(), 3, "3 DNS SANs")
    t.assert_eq_int(l.san_ips.len(), 2, "2 IP SANs")
    t.assert_eq_str(l.san_ips[0], "0a010203", "IPv4 SAN bytes")
    t.assert_eq_str(l.san_ips[1], "20010db8000000000000000000000001", "IPv6 SAN bytes")
    t.assert_true(l.has_bc and not l.bc_ca, "basicConstraints CA:FALSE")
    t.assert_false(l.is_ca(), "not a CA")
    t.assert_true(l.has_ku and l.key_usage_has(0), "keyUsage digitalSignature")
    t.assert_false(l.key_usage_has(5), "keyUsage no keyCertSign")
    t.assert_false(l.can_sign_certs(), "cannot sign certs")
    t.assert_true(l.has_eku and l.eku.len() == 1 and l.eku[0] == "1.3.6.1.5.5.7.3.1", "EKU serverAuth")
    t.assert_eq_str(l.fingerprint_sha256(), "e5836d177ab8ac5d481788a7478ca4acbaa5df1283bd4331d51e0700238295e8", "fingerprint matches openssl")
    t.assert_true(l.is_valid_at(NOW()), "valid at NOW")
    t.assert_false(l.is_valid_at(1500000000), "not valid in 2017")
    t.assert_false(l.is_valid_at(2840140801), "not valid after notAfter")
    t.assert_eq_int(l.public_key_rsa()?.bits, 2048, "RSA 2048 SPKI")
    t.assert_true(l.describe().find("www.example.test") >= 0, "describe mentions subject")
    t.section("x509: parse CA certificates")
    mut r = X509.parse_pem(c_rsa_root())?
    t.assert_true(r.is_ca() and r.bc_pathlen == -1, "root is a CA, no path length limit")
    t.assert_true(r.can_sign_certs() and r.key_usage_has(5), "root keyCertSign")
    t.assert_true(r.is_self_issued() and r.is_self_signed(), "root self-signed")
    mut i = X509.parse_pem(c_rsa_inter())?
    t.assert_true(i.is_ca() and i.bc_pathlen == 0, "intermediate pathlen 0")
    t.assert_false(i.is_self_issued(), "intermediate is not self-issued")
    t.assert_eq_str(Bytes.to_hex(l.aki), Bytes.to_hex(i.ski), "leaf AKI == intermediate SKI")
    t.section("x509: parse EC / Ed25519")
    mut e = X509.parse_pem(c_ec_leaf())?
    t.assert_eq_str(e.key_alg, "ec", "EC leaf key")
    t.assert_eq_str(e.key_curve_oid, "1.2.840.10045.3.1.7", "P-256 leaf key")
    t.assert_eq_str(e.sig_alg_oid, "1.2.840.10045.4.3.3", "ecdsa-with-SHA384")
    mut ei = X509.parse_pem(c_ec_inter())?
    t.assert_eq_str(ei.key_curve_oid, "1.3.132.0.34", "P-384 intermediate key")
    t.assert_eq_str(ei.fingerprint_sha256(), "17ab44f0378a3ea6d47041d525f9150af337bee218c866b4369dd4e388 82d41d".replace(" ", ""), "EC intermediate fingerprint")
    t.assert_eq_str(e.public_key_ec()?.curve.name, "P-256", "public_key_ec")
    mut ed = X509.parse_pem(c_ed_root())?
    t.assert_eq_str(ed.key_alg, "ed25519", "Ed25519 key")
    t.assert_true(ed.is_self_signed(), "Ed25519 root self-signed")
    t.section("x509: PEM bundles and errors")
    mut bundle = "junk before\n" + c_rsa_root() + "\nmore junk\n" + c_rsa_inter() + "\n" + c_ec_root() + "\n"
    t.assert_eq_int(X509.parse_pem_all(bundle).len, 3, "bundle with surrounding text has 3 certs")
    mut st = X509Store.init()
    t.assert_eq_int(st.add_pem(bundle), 3, "store.add_pem returns count")
    t.assert_eq_int(st.len(), 3, "store size")
    t.assert_true(st.contains(r), "store contains root")
    t.assert_false(st.contains(l), "store does not contain leaf")
    mut bad = X509.parse_pem("not a pem")
    t.assert_true(bad.is_err, "garbage PEM rejected")
    mut blk = Pem.decode(c_rsa_leaf())?
    mut trunc = X509.parse_der(Bytes.slice(blk.data, 0, 200))
    t.assert_true(trunc.is_err, "truncated DER rejected")
    mut notseq = X509.parse_der(Bytes.from_hex("0201050000"))
    t.assert_true(notseq.is_err, "non-SEQUENCE rejected")
    return 0

def sig_test(t: TestRunner) throws str -> int:
    t.section("x509: signature checks")
    mut root = X509.parse_pem(c_rsa_root())?
    mut inter = X509.parse_pem(c_rsa_inter())?
    mut leaf = X509.parse_pem(c_rsa_leaf())?
    t.assert_true(leaf.verify_signed_by(inter), "leaf signed by intermediate (RSA sha256)")
    t.assert_false(leaf.verify_signed_by(root), "leaf not signed by root")
    t.assert_true(inter.verify_signed_by(root), "intermediate signed by root")
    t.assert_true(X509.parse_pem(c_rsa_leaf_sha384())?.verify_signed_by(inter), "RSA sha384")
    t.assert_true(X509.parse_pem(c_rsa_leaf_pss())?.verify_signed_by(root), "RSASSA-PSS")
    t.assert_false(X509.parse_pem(c_rsa_leaf_pss())?.verify_signed_by(inter), "PSS under wrong issuer")
    mut eroot = X509.parse_pem(c_ec_root())?
    mut einter = X509.parse_pem(c_ec_inter())?
    t.assert_true(einter.verify_signed_by(eroot), "P-384 intermediate signed by P-256 root (ecdsa sha256)")
    t.assert_true(X509.parse_pem(c_ec_leaf())?.verify_signed_by(einter), "P-256 leaf signed by P-384 intermediate (ecdsa sha384)")
    t.assert_false(X509.parse_pem(c_ec_leaf())?.verify_signed_by(eroot), "EC leaf not signed by root")
    t.assert_false(leaf.verify_signed_by(einter), "RSA signature checked against an EC key fails")
    mut edr = X509.parse_pem(c_ed_root())?
    t.assert_true(X509.parse_pem(c_ed_leaf())?.verify_signed_by(edr), "Ed25519 signature")
    t.assert_false(X509.parse_pem(c_ed_leaf())?.verify_signed_by(eroot), "Ed25519 cert under EC key")
    # flip one bit inside the TBS (the subject common name) and check the signature breaks
    mut blk = Pem.decode(c_rsa_leaf())?
    mut der = Bytes.clone(blk.data)
    mut pos = 0
    mut found = -1
    while pos + 4 < der.len:
        if der.get(pos) == 119 and der.get(pos + 1) == 119 and der.get(pos + 2) == 119 and der.get(pos + 3) == 46:
            found = pos
            break
        pos = pos + 1
    t.assert_true(found > 0, "found 'www.' inside the DER")
    der.set(found, 118)
    mut tam = X509.parse_der(der)?
    t.assert_eq_str(tam.subject.cn, "vww.example.test", "tampered subject parses")
    t.assert_false(tam.verify_signed_by(inter), "tampered certificate fails signature")
    return 0

def chain_test(t: TestRunner) throws str -> int:
    mut rsa_roots = c_rsa_root()
    mut ec_roots = c_ec_root()
    t.section("x509: RSA chain validation")
    mut r = vc(c_rsa_leaf(), c_rsa_inter(), rsa_roots, "www.example.test")?
    expect_ok(t, "leaf -> intermediate -> root", r)
    t.assert_eq_int(r.depth, 3, "depth 3")
    t.assert_true(r.anchor.find("RSA Root CA") >= 0, "anchor is the RSA root")
    expect_fail(t, "missing intermediate", vc(c_rsa_leaf(), "", rsa_roots, "www.example.test")?, "unable to find")
    expect_fail(t, "wrong host", vc(c_rsa_leaf(), c_rsa_inter(), rsa_roots, "other.example.test")?, "not valid for")
    expect_ok(t, "no host check when host is empty", vc(c_rsa_leaf(), c_rsa_inter(), rsa_roots, "")?)
    expect_ok(t, "wildcard host", vc(c_rsa_leaf(), c_rsa_inter(), rsa_roots, "a.wild.example.test")?)
    expect_ok(t, "IPv4 literal host", vc(c_rsa_leaf(), c_rsa_inter(), rsa_roots, "10.1.2.3")?)
    expect_ok(t, "IPv6 literal host", vc(c_rsa_leaf(), c_rsa_inter(), rsa_roots, "2001:db8::1")?)
    expect_ok(t, "sha384 leaf", vc(c_rsa_leaf_sha384(), c_rsa_inter(), rsa_roots, "sha384.example.test")?)
    mut rp = vc(c_rsa_leaf_pss(), "", rsa_roots, "pss.example.test")?
    expect_ok(t, "RSASSA-PSS leaf straight under the root", rp)
    t.assert_eq_int(rp.depth, 2, "depth 2")
    expect_fail(t, "untrusted root", vc(c_rsa_leaf(), c_rsa_inter(), ec_roots, "www.example.test")?, "")
    expect_fail(t, "root of a different key type", vc(c_rsa_leaf(), c_rsa_inter(), c_ed_root(), "www.example.test")?, "")
    mut partial = vc(c_rsa_leaf(), "", c_rsa_inter(), "www.example.test")?
    expect_ok(t, "an intermediate in the store acts as trust anchor", partial)
    expect_fail(t, "serverAuth required", vc(c_rsa_leaf_client(), c_rsa_inter(), rsa_roots, "client.example.test")?, "server authentication")
    mut st = X509Store.init()
    st.add_pem(rsa_roots)
    mut copts = X509.default_options()
    copts.purpose = "client"
    mut cl = X509.parse_pem(c_rsa_leaf_client())?
    expect_ok(t, "clientAuth leaf under purpose=client", X509.verify_chain(cl, X509.parse_pem_all(c_rsa_inter()), st, "client.example.test", NOW(), copts))
    t.section("x509: EC / Ed25519 chains")
    expect_ok(t, "P-256 leaf -> P-384 intermediate -> P-256 root", vc(c_ec_leaf(), c_ec_inter(), ec_roots, "ec.example.test")?)
    expect_ok(t, "Ed25519 leaf -> Ed25519 root", vc(c_ed_leaf(), "", c_ed_root(), "ed.example.test")?)
    t.section("x509: validity")
    expect_fail(t, "expired leaf", vc(c_ec_expired(), "", ec_roots, "old.example.test")?, "expired")
    expect_fail(t, "not yet valid leaf", vc(c_ec_future(), "", ec_roots, "future.example.test")?, "not yet valid")
    mut st2 = X509Store.init()
    st2.add_pem(ec_roots)
    mut nt = X509.default_options()
    nt.check_time = false
    mut old = X509.parse_pem(c_ec_expired())?
    expect_ok(t, "expired leaf with check_time=false", X509.verify_chain(old, Vec[X509Cert].init(1), st2, "old.example.test", NOW(), nt))
    mut late = X509.verify_chain(X509.parse_pem(c_ec_leaf())?, X509.parse_pem_all(c_ec_inter()), st2, "ec.example.test", 2900000000, X509.default_options())
    expect_fail(t, "everything expired in 2061", late, "expired")
    t.section("x509: CA constraints")
    expect_fail(t, "pathLenConstraint exceeded", vc(c_pl_leaf(), cat2(c_pl_b(), c_pl_a()), ec_roots, "deep.example.test")?, "path")
    expect_fail(t, "issuer that is not a CA", vc(c_nca_leaf(), c_nca_inter(), ec_roots, "vialeaf.example.test")?, "CA")
    expect_fail(t, "unknown critical extension", vc(c_ec_unknown_crit(), "", ec_roots, "crit.example.test")?, "critical")
    expect_fail(t, "self-signed, not in the store", vc(c_self(), "", ec_roots, "self.example.test")?, "not trusted")
    expect_ok(t, "self-signed certificate pinned in the store", vc(c_self(), "", c_self(), "self.example.test")?)
    t.section("x509: name constraints")
    expect_ok(t, "name inside permitted subtree", vc(c_nc_ok(), c_nc_ca(), ec_roots, "a.corp.test")?)
    expect_fail(t, "name outside permitted subtree", vc(c_nc_bad_outside(), c_nc_ca(), ec_roots, "evil.test")?, "constraint")
    expect_fail(t, "name inside excluded subtree", vc(c_nc_bad_excluded(), c_nc_ca(), ec_roots, "x.secret.corp.test")?, "constraint")
    t.section("x509: verify_server_chain (current time)")
    mut ch = Vec[X509Cert].init(2)
    ch.push(X509.parse_pem(c_rsa_leaf())?)
    ch.push(X509.parse_pem(c_rsa_inter())?)
    mut st3 = X509Store.init()
    st3.add_pem(rsa_roots)
    t.assert_true(X509.verify_server_chain(ch, st3, "www.example.test").ok, "server chain verifies now")
    t.assert_false(X509.verify_server_chain(ch, st3, "nope.example.test").ok, "server chain wrong host")
    t.assert_false(X509.verify_server_chain(Vec[X509Cert].init(1), st3, "x").ok, "empty chain")
    return 0

def host_test(t: TestRunner) throws str -> int:
    t.section("x509: hostname matching (RFC 6125)")
    mut l = X509.parse_pem(c_rsa_leaf())?
    t.assert_true(l.matches_hostname("www.example.test"), "exact")
    t.assert_true(l.matches_hostname("WWW.Example.TEST"), "case-insensitive host")
    t.assert_true(l.matches_hostname("mixed.example.test"), "case-insensitive SAN")
    t.assert_true(l.matches_hostname("a.wild.example.test"), "wildcard label")
    t.assert_false(l.matches_hostname("wild.example.test"), "wildcard needs a label")
    t.assert_false(l.matches_hostname("a.b.wild.example.test"), "wildcard covers one label only")
    t.assert_false(l.matches_hostname("example.test"), "parent domain")
    t.assert_false(l.matches_hostname(""), "empty host")
    t.assert_true(l.matches_hostname("10.1.2.3"), "IPv4 SAN")
    t.assert_false(l.matches_hostname("10.1.2.4"), "other IPv4")
    t.assert_true(l.matches_hostname("2001:db8::1"), "IPv6 SAN")
    t.assert_false(l.matches_hostname("2001:db8::2"), "other IPv6")
    t.section("x509: DNS pattern rules")
    t.assert_true(X509.match_dns("example.com", "example.com"), "literal")
    t.assert_true(X509.match_dns("example.com", "EXAMPLE.com."), "trailing dot on host")
    t.assert_true(X509.match_dns("*.example.com", "foo.example.com"), "*.example.com")
    t.assert_false(X509.match_dns("*.example.com", "example.com"), "no empty label")
    t.assert_false(X509.match_dns("*.example.com", "a.b.example.com"), "one label only")
    t.assert_false(X509.match_dns("*.com", "example.com"), "no wildcard over a TLD")
    t.assert_false(X509.match_dns("*", "example"), "bare *")
    t.assert_false(X509.match_dns("f*.example.com", "foo.example.com"), "partial-label wildcard rejected")
    t.assert_false(X509.match_dns("foo.*.example.com", "foo.bar.example.com"), "wildcard not leftmost")
    t.assert_false(X509.match_dns("*.*.example.com", "a.b.example.com"), "two wildcards")
    t.assert_false(X509.match_dns("*.example.com", ".example.com"), "empty leftmost label")
    t.assert_false(X509.match_dns("*.example.com", "foo.example.org"), "different domain")
    t.assert_false(X509.match_dns("", "example.com"), "empty pattern")
    return 0

def system_test(t: TestRunner) throws str -> int:
    t.section("x509: system CA bundle")
    mut st = X509Store.init()
    mut n = st.load_system()
    t.assert_eq_int(st.len(), n, "load_system returns the number of roots added")
    if n > 0:
        mut i = 0
        mut ok = 0
        mut checked = 0
        while i < st.roots.len and checked < 6:
            mut c = st.roots.get(i)
            if c.key_alg == "rsa" or c.key_alg == "ec":
                checked = checked + 1
                if c.is_self_signed(): ok = ok + 1
            i = i + 1
        t.assert_eq_int(ok, checked, f"first {checked} system roots are valid self-signed certificates")
    else:
        t.assert_true(true, "no system bundle on this machine (skipped)")
    return 0

def run(name: str, t: TestRunner, r: Result[int, str]):
    if r.is_err: t.fail(f"{name}: {r.err}")

def main():
    mut t = TestRunner.init("124_x509")
    run("parse", t, parse_test(t))
    run("sig", t, sig_test(t))
    run("chain", t, chain_test(t))
    run("host", t, host_test(t))
    run("system", t, system_test(t))
    t.summary()
