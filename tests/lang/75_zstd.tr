# tests/lang/75_zstd.tr - std.compress.zstd: Zstandard (RFC 8878) decoder +
# encoder in pure Tauraro. Decoder is validated against frames produced by the
# reference zstd library (Huffman 1- and 4-stream literals, treeless reuse,
# FSE-compressed / RLE / repeat / predefined sequence tables, repeat offsets,
# raw / RLE / multi-block frames, with and without content size + checksum),
# the encoder against the reference decoder (bytes verified with `zstd -d`),
# plus round-trips and malformed-input rejection.

from std.test import TestRunner
from std.compress.zstd import Zstd
from std.compress.xxhash import Xxh64
from std.compress.common import CBuf, CResult, rd8
from std.string.str import Str

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

def nib(c: int) -> int:
    if c >= 97: return c - 87
    if c >= 65: return c - 55
    return c - 48

def unhex(h: str) -> str:
    mut n = Str.len(h) / 2
    mut hp = h as Pointer[char]
    mut buf = _tr_c_malloc(n + 1)
    mut i = 0
    while i < n:
        mut b = nib(rd8(hp, 2 * i)) * 16 + nib(rd8(hp, 2 * i + 1))
        unsafe:
            buf.offset(i).write(b as char)
        i = i + 1
    unsafe:
        buf.offset(n).write('\0')
    return _tr_str_wrap_len(buf, n)

def same(a: str, an: int, b: str, bn: int) -> bool:
    if an != bn: return false
    mut ap = a as Pointer[char]
    mut bp = b as Pointer[char]
    mut i = 0
    while i < an:
        if rd8(ap, i) != rd8(bp, i): return false
        i = i + 1
    return true

def patched(s: str, n: int, idx: int, val: int) -> str:
    mut buf = _tr_c_malloc(n + 1)
    mut sp = s as Pointer[char]
    mut i = 0
    while i < n:
        mut b = rd8(sp, i)
        if i == idx: b = val
        unsafe:
            buf.offset(i).write(b as char)
        i = i + 1
    unsafe:
        buf.offset(n).write('\0')
    return _tr_str_wrap_len(buf, n)

# ── deterministic generators (must match the vector generator exactly) ──

def textgen(n: int, seed: int) -> str:
    mut words: List[str] = ["the", "tauraro", "compiler", "emits", "portable", "c", "code", "for", "every", "platform", "zstandard", "entropy"]
    mut b = CBuf.init(n + 32)
    mut x = seed
    while b.len < n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        mut w = words[(x >> 16) % 12]
        b.push_str(w, Str.len(w))
        b.push_u8(32)
    b.len = n
    mut s = b.to_str()
    b.free()
    return s

def pat(n: int) -> str:
    mut b = CBuf.init(n + 8)
    mut i = 0
    while i < n:
        if (i / 5000) % 2 == 0:
            b.push_u8(((i % 97) * 3) & 0xFF)
        else:
            b.push_u8(0x41)
        i = i + 1
    mut s = b.to_str()
    b.free()
    return s

def lcg(n: int, seed: int) -> str:
    mut b = CBuf.init(n + 8)
    mut x = seed
    mut i = 0
    while i < n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        b.push_u8((x >> 16) & 0xFF)
        i = i + 1
    mut s = b.to_str()
    b.free()
    return s

def skewgen(n: int, seed: int) -> str:
    mut pool = unhex("6161616161616161626262626363646465656666676800ff0a")
    mut b = CBuf.init(n + 8)
    mut x = seed
    mut i = 0
    while i < n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        b.push_u8(rd8(pool as Pointer[char], (x >> 16) % 25))
        i = i + 1
    mut s = b.to_str()
    b.free()
    return s

def check_dec(t: TestRunner, name: str, frame_hex: str, want: str, wn: int):
    mut f = unhex(frame_hex)
    mut r = Zstd.decompress(f, Str.len(frame_hex) / 2, wn + 1024)
    t.assert_true(r.ok, name + ": decodes " + r.err)
    t.assert_true(same(r.to_str(), r.len(), want, wn), name + ": content matches (" + str(wn) + " bytes)")
    r.free()

def roundtrip(t: TestRunner, name: str, data: str, n: int, chk: bool):
    mut c = Zstd.compress(data, n, chk)
    mut d = Zstd.decompress(c.to_str(), c.len(), n + 16)
    t.assert_true(c.ok and d.ok, "encode " + name + ": ok " + d.err)
    t.assert_true(same(d.to_str(), d.len(), data, n), "encode " + name + ": round-trips (" + str(n) + " -> " + str(c.len()) + ")")
    c.free()
    d.free()

def main():
    mut t = TestRunner.init("75_zstd")

    t.section("xxHash64 (zstd content checksum)")
    t.assert_eq_int(Xxh64.low32("hello hello hello hello world", 29, 0), 0xD4935FD7, "xxh64 low32 == checksum stored by the reference encoder")

    t.section("decoder: reference-library frames")
    check_dec(t, "predefined tables, raw literals, 1 sequence", "28b52ffd241d8d00005868656c6c6f20776f726c640100f14a11d75f93d4", "hello hello hello hello world", 29)
    check_dec(t, "Huffman 1-stream literals + FSE offsets", "28b52ffd24c8fd020092840e12b0b901609b2caf101da362fb86612a63110196ab0243600bc6fa2c6563647dc6245bf47e38fa98c09a757f9a94fb5d31267c61156db96715010d201034e91d2b1b68172c484c37d00dac888f3760c6f1df6136bb266d224007de04f9c5a6b0", textgen(200, 5), 200)
    check_dec(t, "Huffman literals + FSE-compressed LL/OF/ML tables", "", textgen(3000, 7), 3000)
    mut ptxt = pat(150000)
    check_dec(t, "2 blocks, FSE tables + repeat mode (level 19)", "", ptxt, 150000)
    check_dec(t, "streaming frame (no content size, no checksum)", "", ptxt, 150000)
    mut rle = _tr_c_malloc(200001)
    mut ri = 0
    while ri < 200000:
        unsafe:
            rle.offset(ri).write('z')
        ri = ri + 1
    unsafe:
        rle.offset(200000).write('\0')
    mut rles = _tr_str_wrap_len(rle, 200000)
    check_dec(t, "multi-block frame with an RLE block", "28b52ffda4400d0300540000107a7a0100fbff39c002036a087af15a5275", rles, 200000)
    check_dec(t, "empty frame", "28b52ffd240001000099e9d851", "", 0)
    check_dec(t, "Raw block (incompressible)", "", lcg(300, 12345), 300)
    mut mb = skewgen(2500, 3) + skewgen(2500, 4) + skewgen(2500, 5)
    check_dec(t, "3 blocks: 4-stream Huffman + treeless literals + repeat tables (level 19)", "", mb, 7500)
    check_dec(t, "3 blocks: literals-only block, treeless, RLE sequence table (level 1)", "", mb, 7500)
    check_dec(t, "4-stream Huffman literals, all FSE tables (level 3)", "", skewgen(4000, 3), 4000)

    t.section("decoder: concatenated and skippable frames")
    mut hf = "28b52ffd241d8d00005868656c6c6f20776f726c640100f14a11d75f93d4"
    mut skipframe = unhex("5a2a4d18" + "03000000" + "78797a")
    mut cb = CBuf.init(256)
    cb.push_raw(skipframe as Pointer[char], 11)
    cb.push_raw(unhex(hf) as Pointer[char], 30)
    cb.push_raw(unhex("28b52ffd240001000099e9d851") as Pointer[char], 13)
    cb.push_raw(unhex(hf) as Pointer[char], 30)
    mut cr = Zstd.decompress(cb.to_str(), cb.len, 1000)
    t.assert_true(cr.ok and same(cr.to_str(), cr.len(), "hello hello hello hello worldhello hello hello hello world", 58), "skippable + 3 frames: " + cr.err)

    t.section("encoder: output accepted by the reference decoder")
    mut he = Zstd.compress("hello hello hello hello world", 29, true)
    t.assert_true(same(he.to_str(), he.len(), unhex("28b52ffd241d8d00005868656c6c6f20776f726c640100f14a11d75f93d4"), 30), "bytes for 'hello hello hello hello world' (verified with zstd -d)")
    mut ee = Zstd.compress("", 0, true)
    t.assert_true(same(ee.to_str(), ee.len(), unhex("28b52ffd240001000099e9d851"), 13), "empty input: single empty Raw block + checksum (bytes identical to zstd CLI)")
    mut e0 = Zstd.compress("hello hello hello hello world", 29, false)
    t.assert_true(same(e0.to_str(), e0.len(), unhex("28b52ffd201d8d00005868656c6c6f20776f726c640100f14a11"), 26), "no-checksum variant")

    t.section("encoder: round trips")
    roundtrip(t, "text 77 bytes", "Tauraro compresses compresses compresses compresses data data data data data!", 77, true)
    roundtrip(t, "empty", "", 0, true)
    roundtrip(t, "1 byte", "a", 1, false)
    roundtrip(t, "3 bytes (below min match)", "abc", 3, true)
    mut t3 = textgen(3000, 7)
    roundtrip(t, "text 3000", t3, 3000, true)
    roundtrip(t, "pattern 150000 (2 blocks, non-single-segment frame)", ptxt, 150000, true)
    roundtrip(t, "random 5000 (Raw block)", lcg(5000, 77), 5000, false)
    roundtrip(t, "200000 x 'z' (RLE blocks)", rles, 200000, true)
    roundtrip(t, "skewed 4000", skewgen(4000, 3), 4000, true)
    mut c1 = Zstd.compress(t3, 3000, true)
    t.assert_true(c1.len() < 3000 / 2, "text compresses to < 50% (" + str(c1.len()) + " bytes)")
    mut c2 = Zstd.compress(ptxt, 150000, false)
    t.assert_true(c2.len() < 5000, "pattern compresses well (" + str(c2.len()) + " bytes)")
    mut c3 = Zstd.compress(rles, 200000, false)
    t.assert_true(c3.len() < 40, "RLE input -> tiny frame (" + str(c3.len()) + " bytes)")
    c1.free()
    c2.free()
    c3.free()

    t.section("malformed / hostile input is rejected (never crashes)")
    mut good = unhex("")
    mut gl = 639
    t.assert_false(Zstd.decompress(patched(good, gl, 0, 0x00), gl, 100000).ok, "bad magic")
    t.assert_false(Zstd.decompress(good, 3, 100000).ok, "truncated magic")
    t.assert_false(Zstd.decompress(good, 7, 100000).ok, "truncated header")
    t.assert_false(Zstd.decompress(good, 100, 100000).ok, "truncated block")
    t.assert_false(Zstd.decompress(good, gl - 2, 100000).ok, "truncated checksum")
    t.assert_false(Zstd.decompress(patched(good, gl, gl - 1, rd8(good as Pointer[char], gl - 1) ^ 1), gl, 100000).ok, "checksum mismatch")
    t.assert_false(Zstd.decompress(good, gl, 100).ok, "output limit (max_out) enforced")
    t.assert_false(Zstd.decompress("", 0, 100).ok, "empty input")
    t.assert_false(Zstd.decompress(unhex("28b52ffd2400070000"), 9, 100).ok, "reserved block type 3")
    t.assert_false(Zstd.decompress(unhex("28b52ffd25000100000000"), 11, 100).ok, "dictionary id not supported")
    t.assert_false(Zstd.decompress(unhex("28b52ffd2c00010000"), 9, 100).ok, "reserved header bit")
    # Flip every byte of the compressed body in turn: decoding must never
    # crash; either it fails or (e.g. flip inside literals) it yields data
    # that differs from the original (checksum off => may decode).
    mut survived = 0
    mut fi = 8
    while fi < 80:
        mut bad = Zstd.decompress(patched(good, gl, fi, rd8(good as Pointer[char], fi) ^ 0xA5), gl, 100000)
        if bad.ok and same(bad.to_str(), bad.len(), t3, 3000):
            survived = survived + 1
        bad.free()
        fi = fi + 1
    t.assert_eq_int(survived, 0, "no single-byte corruption of the header/tables decodes to the original")

    t.summary()
