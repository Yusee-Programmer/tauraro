# EXTRA-FLAGS: --checked-pointers
# EXPECT-EXIT: nonzero
# EXPECT-STDOUT: 2
# EXPECT-STDERR: out of bounds
# --checked-pointers range-checks raw Pointer index in a RELEASE build (also --strict).
def main():
    mut n = 4
    unsafe:
        mut a: Pointer[int] = alloc[int](n)
        mut b: Pointer[int] = alloc[int](n)
        mut k = 10
        mut i = 0
        while i < n:
            a[i] = i
            i += 1
        print(a[2])
        a[k] = 7
        dealloc(a)
        dealloc(b)
