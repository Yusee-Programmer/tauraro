from geo import geo_add, geo_length
def main():
    mut a = Vec3()
    a.x = 1.0; a.y = 2.0; a.z = 3.0        # construct a by-value struct in Tauraro
    mut b = Vec3()
    b.x = 10.0; b.y = 20.0; b.z = 30.0
    mut c = geo_add(a, b)                   # Vec3 by value in AND out
    print("sum.x = " + (c.x as float).to_str())
    print("len(a) = " + (geo_length(a) as float).to_str())
    print("ok")
