# std.version — Semantic Versioning 2.0.0 versions and npm/cargo-style
# version requirements (ranges).
#
# VERSIONS
#   mut v = Version.parse("1.2.3-rc.1+build.5")?   # strict SemVer 2.0.0
#   v.major / v.minor / v.patch                      # ints
#   v.pre    # List[str] ["rc", "1"]     v.build  # List[str] ["build", "5"]
#   v.to_str()                                       # "1.2.3-rc.1+build.5"
#   v.compare(w)          # -1 / 0 / 1, SemVer precedence (build ignored)
#   v.lt(w) v.lte(w) v.gt(w) v.gte(w) v.eq(w)
#   v.bump_major() v.bump_minor() v.bump_patch() v.bump_prerelease("rc")
#
# `Version.parse` is exactly the SemVer 2.0.0 grammar: three numeric parts
# without leading zeros, optional `-pre.release` identifiers ([0-9A-Za-z-],
# numeric ones without leading zeros) and optional `+build` identifiers.
# Numeric parts are limited to 18 digits (they are stored as int).
# `Version.parse_loose` additionally accepts surrounding whitespace, a leading
# `v`/`V`/`=`, missing minor/patch ("1.2" -> 1.2.0) and leading zeros.
#
# PRECEDENCE (semver.org section 11): compare major, minor, patch
# numerically; a version with a pre-release is LOWER than the same version
# without one; pre-release identifiers compare left to right: numeric ones
# numerically, alphanumeric ones in ASCII order, numeric < alphanumeric, and
# a shorter list wins when all preceding identifiers are equal. Build
# metadata is ignored (`compare_build` adds it as a final tie-break for a
# deterministic sort order, like npm's compareBuild).
#
# REQUIREMENTS
#   mut r = VersionReq.parse(">=1.2.0, <2.0.0 || ^3.1")?
#   r.matches(v)  r.matches_str("1.4.0")  r.max_satisfying(["1.0.0", "1.5.2"])
#   r.to_str()    # normalized comparator form, e.g. ">=1.2.0 <2.0.0||>=3.1.0 <4.0.0-0"
#
# Operator dialects (everything is node-semver ("npm") semantics, including
# the exact desugaring, unless noted):
#   1.2.3 / =1.2.3   exact (npm). VersionReq.parse_cargo treats a bare
#                    version as a caret requirement instead (cargo).
#   >, >=, <, <=     plain comparators (npm and cargo agree). With a partial
#                    version: >1.2 means >=1.3.0, <=1.2 means <1.3.0-0 (npm).
#   ^1.2.3           >=1.2.3 <2.0.0-0; ^0.2.3 -> <0.3.0-0; ^0.0.3 -> <0.0.4-0
#                    (npm == cargo).
#   ~1.2.3, ~>1.2.3  >=1.2.3 <1.3.0-0; ~1 -> >=1.0.0 <2.0.0-0 (npm; cargo
#                    agrees, `~>` is the Ruby/npm spelling).
#   1.2.x 1.2.* 1.2  X-ranges / partial versions (npm; cargo writes 1.2.*).
#   * x X ""         any version (npm).
#   A - B            inclusive hyphen range (npm); a partial B is an
#                    exclusive bound on the next minor/major ("1.2 - 1.4" is
#                    >=1.2.0 <1.5.0-0).
#   ","  or spaces   AND between comparators (comma is cargo's spelling,
#                    whitespace is npm's; both work).
#   ||               OR between comparator sets (npm).
#
# Pre-release handling (npm, also cargo): a version with a pre-release tag
# only satisfies a comparator set if at least one comparator in that set has
# a pre-release on the SAME major.minor.patch, so ">=1.2.3-beta" accepts
# 1.2.3-rc.1 but not 1.3.0-alpha. VersionReq.parse_opts(s, true) opts in
# to npm's includePrerelease behaviour (pre-releases match like any other
# version, and desugared lower bounds become X.Y.Z-0).
#
# taupkg compatibility: `Version.init(s)` (lenient, never fails, garbage ->
# 0.0.0), `to_string()`, `satisfies(constraint)` and the static
# `Version.best_match(Vec[str], constraint)` mirror taupkg's private semver
# module. Differences: `^0.x.y` is npm-style (taupkg kept only the major), a
# pre-release suffix is parsed rather than mangled, constraints may combine
# comparators with AND/OR, and pre-release versions are excluded by the
# rule above.

from std.core.vec import Vec
from std.core.string import StringBuilder

# ─── small helpers ──────────────────────────────────────────────────────────

def _sv_byte(s: str, i: int) -> int:
    return (s[i] as int) & 255

def _sv_is_digit(c: int) -> bool:
    return c >= 48 and c <= 57

def _sv_is_alpha(c: int) -> bool:
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

def _sv_all_digits(s: str) -> bool:
    mut n = s.len()
    if n == 0: return false
    mut i = 0
    while i < n:
        if not _sv_is_digit(_sv_byte(s, i)): return false
        i = i + 1
    return true

def _sv_join(parts: List[str], sep: str) -> str:
    mut sb = StringBuilder.init(32)
    mut i = 0
    while i < len(parts):
        if i > 0: sb.append(sep)
        sb.append(parts[i])
        i = i + 1
    mut out = sb.to_owned()
    sb.free()
    return out

def _sv_copy_list(a: List[str]) -> List[str]:
    mut out: List[str] = []
    mut i = 0
    while i < len(a):
        out.append(a[i])
        i = i + 1
    return out

# Byte-wise (ASCII) string comparison: -1 / 0 / 1.
def _sv_cmp_ascii(a: str, b: str) -> int:
    mut na = a.len()
    mut nb = b.len()
    mut i = 0
    while i < na and i < nb:
        mut ca = _sv_byte(a, i)
        mut cb = _sv_byte(b, i)
        if ca < cb: return -1
        if ca > cb: return 1
        i = i + 1
    if na < nb: return -1
    if na > nb: return 1
    return 0

# Compare two digit strings numerically without overflow.
def _sv_cmp_numstr(a: str, b: str) -> int:
    mut x = a
    mut y = b
    while x.len() > 1 and _sv_byte(x, 0) == 48: x = x.slice(1, x.len())
    while y.len() > 1 and _sv_byte(y, 0) == 48: y = y.slice(1, y.len())
    if x.len() < y.len(): return -1
    if x.len() > y.len(): return 1
    return _sv_cmp_ascii(x, y)

def _sv_cmp_ident(a: str, b: str) -> int:
    mut an = _sv_all_digits(a)
    mut bn = _sv_all_digits(b)
    if an and bn: return _sv_cmp_numstr(a, b)
    if an: return -1
    if bn: return 1
    return _sv_cmp_ascii(a, b)

# Pre-release precedence: an empty list (release) is HIGHER than any list.
def _sv_cmp_pre(a: List[str], b: List[str]) -> int:
    mut na = len(a)
    mut nb = len(b)
    if na == 0 and nb == 0: return 0
    if na == 0: return 1
    if nb == 0: return -1
    mut i = 0
    while i < na and i < nb:
        mut c = _sv_cmp_ident(a[i], b[i])
        if c != 0: return c
        i = i + 1
    if na < nb: return -1
    if na > nb: return 1
    return 0

def _sv_cmp_int(a: int, b: int) -> int:
    if a < b: return -1
    if a > b: return 1
    return 0

# A numeric version component. `strict` forbids leading zeros.
def _sv_num(s: str, what: str, src: str, strict: bool) throws str -> int:
    if not _sv_all_digits(s):
        raise(f"version: invalid {what} '{s}' in '{src}'")
    if strict and s.len() > 1 and _sv_byte(s, 0) == 48:
        raise(f"version: {what} '{s}' has a leading zero in '{src}'")
    if s.len() > 18:
        raise(f"version: {what} '{s}' is too large in '{src}'")
    return s.parse_int()

# Dot-separated identifiers. kind 1 = pre-release (numeric identifiers must
# not have leading zeros when `strict`), kind 2 = build metadata.
def _sv_idents(s: str, kind: int, src: str, strict: bool) throws str -> List[str]:
    mut what = "pre-release"
    if kind == 2: what = "build metadata"
    if s.len() == 0:
        raise(f"version: empty {what} in '{src}'")
    mut parts: List[str] = s.split_exact(".")
    mut i = 0
    while i < len(parts):
        mut id = parts[i]
        if id.len() == 0:
            raise(f"version: empty {what} identifier in '{src}'")
        mut j = 0
        while j < id.len():
            mut c = _sv_byte(id, j)
            if not (_sv_is_digit(c) or _sv_is_alpha(c) or c == 45):
                raise(f"version: invalid character in {what} identifier '{id}' in '{src}'")
            j = j + 1
        if kind == 1 and strict and _sv_all_digits(id) and id.len() > 1 and _sv_byte(id, 0) == 48:
            raise(f"version: numeric pre-release identifier '{id}' has a leading zero in '{src}'")
        i = i + 1
    return parts

# ─── Version ────────────────────────────────────────────────────────────────

pub class Version:
    pub major: int
    pub minor: int
    pub patch: int
    pub pre:   List[str]      # pre-release identifiers ([] = release)
    pub build: List[str]      # build-metadata identifiers

extend Version:
    pub def new(major: int, minor: int, patch: int) -> Version:
        mut v = Version()
        v.major = major
        v.minor = minor
        v.patch = patch
        v.pre = []
        v.build = []
        return v

    # Shared parser. strict = exact SemVer 2.0.0 grammar.
    pub def _parse(text: str, strict: bool) throws str -> Version:
        mut s = text
        if not strict:
            s = s.trim()
            while s.len() > 0 and (_sv_byte(s, 0) == 61 or _sv_byte(s, 0) == 118 or _sv_byte(s, 0) == 86 or _sv_byte(s, 0) == 32):
                s = s.slice(1, s.len())
        if s.len() == 0:
            raise(f"version: empty version string")
        mut core = s
        mut build_s = ""
        mut has_build = false
        mut plus = s.index_of("+")
        if plus >= 0:
            core = s.slice(0, plus)
            build_s = s.slice(plus + 1, s.len())
            has_build = true
        mut pre_s = ""
        mut has_pre = false
        mut dash = core.index_of("-")
        mut nums = core
        if dash >= 0:
            nums = core.slice(0, dash)
            pre_s = core.slice(dash + 1, core.len())
            has_pre = true
        mut parts: List[str] = nums.split_exact(".")
        if strict and len(parts) != 3:
            raise(f"version: '{text}' must have exactly three parts MAJOR.MINOR.PATCH")
        if len(parts) > 3:
            raise(f"version: '{text}' has more than three numeric parts")
        mut v = Version.new(0, 0, 0)
        mut maj: int = _sv_num(parts[0], "major version", text, strict)?
        v.major = maj
        if len(parts) > 1:
            mut mi: int = _sv_num(parts[1], "minor version", text, strict)?
            v.minor = mi
        if len(parts) > 2:
            mut pa: int = _sv_num(parts[2], "patch version", text, strict)?
            v.patch = pa
        if has_pre:
            mut pl: List[str] = _sv_idents(pre_s, 1, text, strict)?
            v.pre = pl
        if has_build:
            mut bl: List[str] = _sv_idents(build_s, 2, text, strict)?
            v.build = bl
        return v

    # Strict SemVer 2.0.0 parse.
    pub def parse(s: str) throws str -> Version:
        mut v = Version._parse(s, true)?
        return v

    # Lenient parse: whitespace, leading v/=, "1" / "1.2", leading zeros.
    pub def parse_loose(s: str) throws str -> Version:
        mut v = Version._parse(s, false)?
        return v

    pub def is_valid(s: str) -> bool:
        mut r: Result[Version, str] = Version.parse(s)
        return r.is_ok

    # taupkg-compatible lenient constructor: never fails (garbage -> 0.0.0).
    pub def init(s: str) -> Version:
        mut r: Result[Version, str] = Version.parse_loose(s)
        if r.is_ok: return r.ok
        return Version.new(0, 0, 0)

    pub def is_prerelease(self) -> bool:
        return len(self.pre) > 0

    pub def pre_str(self) -> str:
        return _sv_join(self.pre, ".")

    pub def build_str(self) -> str:
        return _sv_join(self.build, ".")

    # Canonical text, including pre-release and build metadata.
    pub def to_str(self) -> str:
        mut out = f"{self.major}.{self.minor}.{self.patch}"
        if len(self.pre) > 0: out = out + "-" + _sv_join(self.pre, ".")
        if len(self.build) > 0: out = out + "+" + _sv_join(self.build, ".")
        return out

    pub def to_string(self) -> str:
        return self.to_str()

    # Text without build metadata (what precedence looks at).
    pub def to_str_no_build(self) -> str:
        mut out = f"{self.major}.{self.minor}.{self.patch}"
        if len(self.pre) > 0: out = out + "-" + _sv_join(self.pre, ".")
        return out

    pub def clone(self) -> Version:
        mut v = Version.new(self.major, self.minor, self.patch)
        v.pre = _sv_copy_list(self.pre)
        v.build = _sv_copy_list(self.build)
        return v

    # SemVer precedence: -1 (self < other), 0, 1. Build metadata ignored.
    pub def compare(self, other: Version) -> int:
        mut c = _sv_cmp_int(self.major, other.major)
        if c != 0: return c
        c = _sv_cmp_int(self.minor, other.minor)
        if c != 0: return c
        c = _sv_cmp_int(self.patch, other.patch)
        if c != 0: return c
        return _sv_cmp_pre(self.pre, other.pre)

    # Precedence, then build metadata (identifier by identifier) as a
    # tie-break: a total order for sorting.
    pub def compare_build(self, other: Version) -> int:
        mut c = self.compare(other)
        if c != 0: return c
        mut na = len(self.build)
        mut nb = len(other.build)
        if na == 0 and nb == 0: return 0
        if na == 0: return -1
        if nb == 0: return 1
        mut i = 0
        while i < na and i < nb:
            c = _sv_cmp_ident(self.build[i], other.build[i])
            if c != 0: return c
            i = i + 1
        return _sv_cmp_int(na, nb)

    pub def eq(self, other: Version) -> bool:  return self.compare(other) == 0
    pub def ne(self, other: Version) -> bool:  return self.compare(other) != 0
    pub def lt(self, other: Version) -> bool:  return self.compare(other) < 0
    pub def gt(self, other: Version) -> bool:  return self.compare(other) > 0
    pub def lte(self, other: Version) -> bool: return self.compare(other) <= 0
    pub def gte(self, other: Version) -> bool: return self.compare(other) >= 0

    # Identical including build metadata.
    pub def identical(self, other: Version) -> bool:
        return self.compare_build(other) == 0

    # ── bumps (npm `semver.inc` semantics; build metadata is dropped) ──

    # 1.2.3 -> 2.0.0; 2.0.0-rc.1 -> 2.0.0 (a pre-release of a major release
    # bumps to that release).
    pub def bump_major(self) -> Version:
        if len(self.pre) > 0 and self.minor == 0 and self.patch == 0:
            return Version.new(self.major, 0, 0)
        return Version.new(self.major + 1, 0, 0)

    # 1.2.3 -> 1.3.0; 1.3.0-rc.1 -> 1.3.0.
    pub def bump_minor(self) -> Version:
        if len(self.pre) > 0 and self.patch == 0:
            return Version.new(self.major, self.minor, 0)
        return Version.new(self.major, self.minor + 1, 0)

    # 1.2.3 -> 1.2.4; 1.2.4-rc.1 -> 1.2.4.
    pub def bump_patch(self) -> Version:
        if len(self.pre) > 0:
            return Version.new(self.major, self.minor, self.patch)
        return Version.new(self.major, self.minor, self.patch + 1)

    # Next pre-release. `tag` "" -> numeric only. Examples:
    #   1.2.3 ("rc")        -> 1.2.4-rc.0     1.2.3 ("") -> 1.2.4-0
    #   1.2.4-rc.0 ("rc")   -> 1.2.4-rc.1     1.2.4-beta.3 ("rc") -> 1.2.4-rc.0
    #   1.2.4-rc ("rc")     -> 1.2.4-rc.0     1.2.4-alpha ("") -> 1.2.4-alpha.0
    pub def bump_prerelease(self, tag: str) -> Version:
        mut v = Version.new(self.major, self.minor, self.patch)
        if len(self.pre) == 0:
            v.patch = self.patch + 1
            if tag.len() > 0: v.pre.append(tag)
            v.pre.append("0")
            return v
        mut p = _sv_copy_list(self.pre)
        if tag.len() > 0 and p[0] != tag:
            v.pre.append(tag)
            v.pre.append("0")
            return v
        # increment the last numeric identifier, or append ".0"
        mut i = len(p) - 1
        mut done = false
        while i >= 0 and not done:
            if _sv_all_digits(p[i]):
                p[i] = f"{p[i].parse_int() + 1}"
                done = true
            i = i - 1
        if not done:
            p.append("0")
        v.pre = p
        return v

    # A copy with different pre-release / build identifiers (validated).
    pub def with_pre(self, pre: str) throws str -> Version:
        mut v = self.clone()
        if pre.len() == 0:
            v.pre = []
        else:
            mut pl: List[str] = _sv_idents(pre, 1, pre, true)?
            v.pre = pl
        return v

    pub def with_build(self, build: str) throws str -> Version:
        mut v = self.clone()
        if build.len() == 0:
            v.build = []
        else:
            mut bl: List[str] = _sv_idents(build, 2, build, true)?
            v.build = bl
        return v

    # ── taupkg-compatible helpers ──

    # True when this version satisfies the requirement string (false when
    # the requirement does not parse).
    pub def satisfies(self, constraint: str) -> bool:
        mut r: Result[VersionReq, str] = VersionReq.parse(constraint)
        if r.is_err: return false
        mut req = r.ok
        return req.matches(self)

    # Highest version string in `versions` satisfying `constraint` ("" if none).
    pub def best_match(versions: Vec[str], constraint: str) -> str:
        mut r: Result[VersionReq, str] = VersionReq.parse(constraint)
        if r.is_err: return ""
        mut req = r.ok
        mut l: List[str] = []
        mut i = 0
        while i < versions.len:
            l.append(versions.get(i))
            i = i + 1
        return req.max_satisfying(l)

    # Sort ascending by precedence (build metadata as tie-break). Stable.
    pub def sort(vs: List[Version]) -> List[Version]:
        # Insertion sort over indices (element-wise reassignment of a
        # List[Version] slot is avoided: see the compiler note in the docs).
        mut idx: List[int] = []
        mut i = 0
        while i < len(vs):
            mut j = len(idx)
            idx.append(i)
            while j > 0 and vs[idx[j - 1]].compare_build(vs[i]) > 0:
                idx[j] = idx[j - 1]
                j = j - 1
            idx[j] = i
            i = i + 1
        mut out: List[Version] = []
        i = 0
        while i < len(idx):
            out.append(vs[idx[i]])
            i = i + 1
        return out

    # Parse (loosely) and sort version strings; unparsable entries are dropped.
    pub def sort_strs(vs: List[str]) -> List[str]:
        mut parsed: List[Version] = []
        mut i = 0
        while i < len(vs):
            mut r: Result[Version, str] = Version.parse_loose(vs[i])
            if r.is_ok: parsed.append(r.ok)
            i = i + 1
        mut sorted = Version.sort(parsed)
        mut out: List[str] = []
        i = 0
        while i < len(sorted):
            out.append(sorted[i].to_str())
            i = i + 1
        return out

# ─── Comparator / VersionReq ────────────────────────────────────────────────

# One primitive comparator. op is "=", "<", "<=", ">", ">=" or "*" (any).
pub class Comparator:
    pub op:  str
    pub ver: Version
    pub grp: int          # index of the OR-set it belongs to

extend Comparator:
    pub def make(op: str, v: Version, grp: int) -> Comparator:
        mut c = Comparator()
        c.op = op
        c.ver = v
        c.grp = grp
        return c

    pub def is_any(self) -> bool:
        return self.op == "*"

    # The "matches nothing" comparator <0.0.0-0.
    pub def is_null(self) -> bool:
        return self.op == "<" and self.ver.major == 0 and self.ver.minor == 0 and self.ver.patch == 0 and len(self.ver.pre) == 1 and self.ver.pre[0] == "0"

    pub def test(self, v: Version) -> bool:
        if self.op == "*": return true
        mut c = v.compare(self.ver)
        if self.op == "=": return c == 0
        if self.op == "<": return c < 0
        if self.op == "<=": return c <= 0
        if self.op == ">": return c > 0
        if self.op == ">=": return c >= 0
        return false

    pub def to_str(self) -> str:
        if self.op == "*": return "*"
        if self.op == "=": return self.ver.to_str_no_build()
        return self.op + self.ver.to_str_no_build()

# A parsed partial version: any of M/m/p may be a wildcard.
class _SvPartial:
    pub M: int
    pub m: int
    pub p: int
    pub xM: bool
    pub xm: bool
    pub xp: bool
    pub pre: List[str]

def _sv_is_x(s: str) -> bool:
    return s == "x" or s == "X" or s == "*"

def _sv_partial(text: str, src: str) throws str -> _SvPartial:
    mut s = text.trim()
    while s.len() > 0 and (_sv_byte(s, 0) == 118 or _sv_byte(s, 0) == 86 or _sv_byte(s, 0) == 61):
        s = s.slice(1, s.len())
    mut pt = _SvPartial()
    pt.M = 0
    pt.m = 0
    pt.p = 0
    pt.xM = false
    pt.xm = false
    pt.xp = false
    pt.pre = []
    if s.len() == 0:
        pt.xM = true
        pt.xm = true
        pt.xp = true
        return pt
    mut core = s
    mut plus = s.index_of("+")
    if plus >= 0:
        mut bl: List[str] = _sv_idents(s.slice(plus + 1, s.len()), 2, src, true)?
        core = s.slice(0, plus)
    mut dash = core.index_of("-")
    mut nums = core
    mut pre_s = ""
    if dash >= 0:
        nums = core.slice(0, dash)
        pre_s = core.slice(dash + 1, core.len())
    mut parts: List[str] = nums.split_exact(".")
    if len(parts) > 3:
        raise(f"version: invalid requirement '{src}': '{text}' has more than three parts")
    mut seen_x = false
    mut k = 0
    while k < 3:
        mut is_x = true
        mut val = 0
        if k < len(parts):
            mut part = parts[k]
            if _sv_is_x(part):
                is_x = true
            else:
                if seen_x:
                    raise(f"version: invalid requirement '{src}': number after a wildcard in '{text}'")
                mut n: int = _sv_num(part, "version number", src, true)?
                val = n
                is_x = false
        if is_x: seen_x = true
        if k == 0:
            pt.M = val
            pt.xM = is_x
        elif k == 1:
            pt.m = val
            pt.xm = is_x
        else:
            pt.p = val
            pt.xp = is_x
        k = k + 1
    if dash >= 0:
        if seen_x:
            raise(f"version: invalid requirement '{src}': pre-release on a partial version '{text}'")
        mut pl: List[str] = _sv_idents(pre_s, 1, src, true)?
        pt.pre = pl
    return pt

pub class VersionReq:
    pub source: str
    pub comps:  List[Comparator]
    pub nsets:  int
    pub include_prerelease: bool
    pub cargo:  bool

def _sv_zero_pre(on: bool) -> List[str]:
    mut l: List[str] = []
    if on: l.append("0")
    return l

def _sv_ver(M: int, m: int, p: int, pre: List[str]) -> Version:
    mut v = Version.new(M, m, p)
    v.pre = _sv_copy_list(pre)
    return v

extend VersionReq:
    pub def parse(s: str) throws str -> VersionReq:
        mut r = VersionReq._parse(s, false, false)?
        return r

    # Cargo dialect: a bare version ("1.2.3") means ^1.2.3.
    pub def parse_cargo(s: str) throws str -> VersionReq:
        mut r = VersionReq._parse(s, false, true)?
        return r

    # npm `includePrerelease`: pre-releases match like any other version.
    pub def parse_opts(s: str, include_prerelease: bool) throws str -> VersionReq:
        mut r = VersionReq._parse(s, include_prerelease, false)?
        return r

    pub def is_valid(s: str) -> bool:
        mut r: Result[VersionReq, str] = VersionReq.parse(s)
        return r.is_ok

    # A requirement matching every (release) version.
    pub def any() -> VersionReq:
        mut q = VersionReq()
        q.source = "*"
        q.comps = []
        q.comps.append(Comparator.make("*", Version.new(0, 0, 0), 0))
        q.nsets = 1
        q.include_prerelease = false
        q.cargo = false
        return q

    def _add(self, op: str, v: Version, grp: int):
        self.comps.append(Comparator.make(op, v, grp))

    # Desugar one operator + partial into primitive comparators.
    def _emit(self, op: str, pt: _SvPartial, grp: int):
        mut z = _sv_zero_pre(self.include_prerelease)
        mut lo0 = _sv_zero_pre(true)
        mut M = pt.M
        mut m = pt.m
        mut p = pt.p
        if op == "" or op == "=":
            if op == "" and self.cargo and not pt.xM:
                self._emit("^", pt, grp)
                return
            if pt.xM:
                self._add("*", Version.new(0, 0, 0), grp)
            elif pt.xm:
                self._add(">=", _sv_ver(M, 0, 0, z), grp)
                self._add("<", _sv_ver(M + 1, 0, 0, lo0), grp)
            elif pt.xp:
                self._add(">=", _sv_ver(M, m, 0, z), grp)
                self._add("<", _sv_ver(M, m + 1, 0, lo0), grp)
            else:
                self._add("=", _sv_ver(M, m, p, pt.pre), grp)
            return
        if op == "~" or op == "~>":
            if pt.xM:
                self._add("*", Version.new(0, 0, 0), grp)
            elif pt.xm:
                self._add(">=", _sv_ver(M, 0, 0, z), grp)
                self._add("<", _sv_ver(M + 1, 0, 0, lo0), grp)
            elif pt.xp:
                self._add(">=", _sv_ver(M, m, 0, z), grp)
                self._add("<", _sv_ver(M, m + 1, 0, lo0), grp)
            else:
                if len(pt.pre) > 0:
                    self._add(">=", _sv_ver(M, m, p, pt.pre), grp)
                else:
                    self._add(">=", _sv_ver(M, m, p, z), grp)
                self._add("<", _sv_ver(M, m + 1, 0, lo0), grp)
            return
        if op == "^":
            if pt.xM:
                self._add("*", Version.new(0, 0, 0), grp)
            elif pt.xm:
                self._add(">=", _sv_ver(M, 0, 0, z), grp)
                self._add("<", _sv_ver(M + 1, 0, 0, lo0), grp)
            elif pt.xp:
                self._add(">=", _sv_ver(M, m, 0, z), grp)
                if M == 0:
                    self._add("<", _sv_ver(M, m + 1, 0, lo0), grp)
                else:
                    self._add("<", _sv_ver(M + 1, 0, 0, lo0), grp)
            else:
                if len(pt.pre) > 0:
                    self._add(">=", _sv_ver(M, m, p, pt.pre), grp)
                else:
                    self._add(">=", _sv_ver(M, m, p, z), grp)
                if M == 0:
                    if m == 0:
                        self._add("<", _sv_ver(M, m, p + 1, lo0), grp)
                    else:
                        self._add("<", _sv_ver(M, m + 1, 0, lo0), grp)
                else:
                    self._add("<", _sv_ver(M + 1, 0, 0, lo0), grp)
            return
        # >, >=, <, <=
        if pt.xM:
            if op == ">" or op == "<":
                self._add("<", _sv_ver(0, 0, 0, lo0), grp)     # matches nothing
            else:
                self._add("*", Version.new(0, 0, 0), grp)
            return
        if pt.xm or pt.xp:
            mut gop = op
            if pt.xm: m = 0
            p = 0
            if gop == ">":
                gop = ">="
                if pt.xm:
                    M = M + 1
                    m = 0
                else:
                    m = m + 1
            elif gop == "<=":
                gop = "<"
                if pt.xm:
                    M = M + 1
                else:
                    m = m + 1
            if gop == "<":
                self._add("<", _sv_ver(M, m, p, lo0), grp)
            else:
                self._add(gop, _sv_ver(M, m, p, z), grp)
            return
        self._add(op, _sv_ver(M, m, p, pt.pre), grp)

    # Hyphen range A - B.
    def _emit_hyphen(self, a: _SvPartial, b: _SvPartial, grp: int):
        mut z = _sv_zero_pre(self.include_prerelease)
        mut lo0 = _sv_zero_pre(true)
        mut n = 0
        if not a.xM:
            if a.xm:
                self._add(">=", _sv_ver(a.M, 0, 0, z), grp)
            elif a.xp:
                self._add(">=", _sv_ver(a.M, a.m, 0, z), grp)
            else:
                self._add(">=", _sv_ver(a.M, a.m, a.p, a.pre), grp)
            n = n + 1
        if not b.xM:
            if b.xm:
                self._add("<", _sv_ver(b.M + 1, 0, 0, lo0), grp)
            elif b.xp:
                self._add("<", _sv_ver(b.M, b.m + 1, 0, lo0), grp)
            else:
                self._add("<=", _sv_ver(b.M, b.m, b.p, b.pre), grp)
            n = n + 1
        if n == 0:
            self._add("*", Version.new(0, 0, 0), grp)

    # Split a token into (operator, rest).
    def _split_op(tok: str) -> (str, str):
        mut ops: List[str] = [">=", "<=", "~>", ">", "<", "=", "~", "^"]
        mut i = 0
        while i < len(ops):
            if tok.starts_with(ops[i]):
                return (ops[i], tok.slice(ops[i].len(), tok.len()))
            i = i + 1
        return ("", tok)

    def _is_op(tok: str) -> bool:
        return tok == ">=" or tok == "<=" or tok == "~>" or tok == ">" or tok == "<" or tok == "=" or tok == "~" or tok == "^"

    pub def _parse(s: str, incl: bool, cargo: bool) throws str -> VersionReq:
        mut q = VersionReq()
        q.source = s
        q.comps = []
        q.nsets = 0
        q.include_prerelease = incl
        q.cargo = cargo
        mut sets: List[str] = s.split_exact("||")
        mut si = 0
        mut all: List[Comparator] = []
        while si < len(sets):
            q.comps = []
            mut grp = si
            # whitespace / comma tokenization
            mut body = sets[si].replace(",", " ").replace("\t", " ").replace("\n", " ").replace("\r", " ")
            mut raw: List[str] = body.split(" ")
            # glue a lone operator to the following token
            mut toks: List[str] = []
            mut i = 0
            while i < len(raw):
                mut t = raw[i]
                while VersionReq._is_op(t) and i + 1 < len(raw):
                    i = i + 1
                    t = t + raw[i]
                if VersionReq._is_op(t):
                    raise(f"version: invalid requirement '{s}': operator '{t}' without a version")
                toks.append(t)
                i = i + 1
            if len(toks) == 0:
                q._add("*", Version.new(0, 0, 0), grp)
            i = 0
            while i < len(toks):
                if i + 2 < len(toks) and toks[i + 1] == "-":
                    mut a: _SvPartial = _sv_partial(toks[i], s)?
                    mut b: _SvPartial = _sv_partial(toks[i + 2], s)?
                    q._emit_hyphen(a, b, grp)
                    i = i + 3
                    continue
                if toks[i] == "-":
                    raise(f"version: invalid requirement '{s}': misplaced '-'")
                mut op, rest = VersionReq._split_op(toks[i])
                mut c0 = 0
                if rest.len() > 0: c0 = _sv_byte(rest, 0)
                if rest.len() > 0 and not (_sv_is_digit(c0) or c0 == 120 or c0 == 88 or c0 == 42 or c0 == 118 or c0 == 86):
                    raise(f"version: invalid requirement '{s}': unexpected '{toks[i]}'")
                mut pt: _SvPartial = _sv_partial(rest, s)?
                q._emit(op, pt, grp)
                i = i + 1
            # set-level normalisation (node-semver parseRange)
            mut set_c: List[Comparator] = []
            mut has_null = false
            mut k = 0
            while k < len(q.comps):
                mut c = q.comps[k]
                if c.op == ">=" and c.ver.major == 0 and c.ver.minor == 0 and c.ver.patch == 0 and (len(c.ver.pre) == 0 or (len(c.ver.pre) == 1 and c.ver.pre[0] == "0" and incl)):
                    c = Comparator.make("*", Version.new(0, 0, 0), grp)
                if c.is_null(): has_null = true
                set_c.append(c)
                k = k + 1
            mut fin: List[Comparator] = []
            if has_null:
                fin.append(Comparator.make("<", _sv_ver(0, 0, 0, _sv_zero_pre(true)), grp))
            else:
                mut nonany = 0
                k = 0
                while k < len(set_c):
                    if not set_c[k].is_any(): nonany = nonany + 1
                    k = k + 1
                k = 0
                while k < len(set_c):
                    mut c = set_c[k]
                    mut keep = true
                    if c.is_any() and nonany > 0: keep = false
                    if keep:
                        mut d = 0
                        while d < len(fin):
                            if fin[d].to_str() == c.to_str(): keep = false
                            d = d + 1
                    if keep: fin.append(c)
                    k = k + 1
            k = 0
            while k < len(fin):
                all.append(fin[k])
                k = k + 1
            si = si + 1
        q.comps = all
        q.nsets = len(sets)
        q._normalize_sets()
        return q

    # Range-level normalisation: drop null sets (unless all are null) and
    # collapse to a lone "*" set when one exists.
    def _normalize_sets(self):
        if self.nsets <= 1: return
        mut keep_sets: List[int] = []
        mut g = 0
        while g < self.nsets:
            if not self._set_is_null(g): keep_sets.append(g)
            g = g + 1
        if len(keep_sets) == 0: keep_sets.append(0)
        mut any_set = -1
        mut i = 0
        while i < len(keep_sets):
            if self._set_is_any(keep_sets[i]) and any_set < 0: any_set = keep_sets[i]
            i = i + 1
        if any_set >= 0 and len(keep_sets) > 1:
            keep_sets = []
            keep_sets.append(any_set)
        mut out: List[Comparator] = []
        i = 0
        while i < len(keep_sets):
            mut k = 0
            while k < len(self.comps):
                mut c = self.comps[k]
                if c.grp == keep_sets[i]:
                    out.append(Comparator.make(c.op, c.ver, i))
                k = k + 1
            i = i + 1
        self.comps = out
        self.nsets = len(keep_sets)

    def _set_is_null(self, g: int) -> bool:
        mut k = 0
        while k < len(self.comps):
            if self.comps[k].grp == g: return self.comps[k].is_null()
            k = k + 1
        return false

    def _set_is_any(self, g: int) -> bool:
        mut n = 0
        mut any = false
        mut k = 0
        while k < len(self.comps):
            if self.comps[k].grp == g:
                n = n + 1
                if self.comps[k].is_any(): any = true
            k = k + 1
        return n == 1 and any

    def _test_set(self, g: int, v: Version) -> bool:
        mut k = 0
        while k < len(self.comps):
            mut c = self.comps[k]
            if c.grp == g and not c.test(v): return false
            k = k + 1
        if len(v.pre) > 0 and not self.include_prerelease:
            k = 0
            while k < len(self.comps):
                mut c = self.comps[k]
                if c.grp == g and not c.is_any() and len(c.ver.pre) > 0:
                    if c.ver.major == v.major and c.ver.minor == v.minor and c.ver.patch == v.patch:
                        return true
                k = k + 1
            return false
        return true

    pub def matches(self, v: Version) -> bool:
        mut g = 0
        while g < self.nsets:
            if self._test_set(g, v): return true
            g = g + 1
        return false

    # Parse `s` loosely and match; an unparsable version never matches.
    pub def matches_str(self, s: str) -> bool:
        mut r: Result[Version, str] = Version.parse_loose(s)
        if r.is_err: return false
        return self.matches(r.ok)

    # Highest matching version string ("" if none); unparsable entries skipped.
    pub def max_satisfying(self, versions: List[str]) -> str:
        mut best = ""
        mut best_v = Version.new(0, 0, 0)
        mut i = 0
        while i < len(versions):
            mut r: Result[Version, str] = Version.parse_loose(versions[i])
            if r.is_ok:
                mut v = r.ok
                if self.matches(v):
                    if best.len() == 0 or v.gt(best_v):
                        best = versions[i]
                        best_v = v
            i = i + 1
        return best

    pub def min_satisfying(self, versions: List[str]) -> str:
        mut best = ""
        mut best_v = Version.new(0, 0, 0)
        mut i = 0
        while i < len(versions):
            mut r: Result[Version, str] = Version.parse_loose(versions[i])
            if r.is_ok:
                mut v = r.ok
                if self.matches(v):
                    if best.len() == 0 or v.lt(best_v):
                        best = versions[i]
                        best_v = v
            i = i + 1
        return best

    # All matching version strings, in input order.
    pub def filter(self, versions: List[str]) -> List[str]:
        mut out: List[str] = []
        mut i = 0
        while i < len(versions):
            if self.matches_str(versions[i]): out.append(versions[i])
            i = i + 1
        return out

    # Normalized comparator form (node-semver `Range.range` format): sets
    # joined by "||", comparators by a space, "*" for any.
    pub def to_str(self) -> str:
        mut sb = StringBuilder.init(64)
        mut g = 0
        while g < self.nsets:
            if g > 0: sb.append("||")
            mut first = true
            mut k = 0
            while k < len(self.comps):
                mut c = self.comps[k]
                if c.grp == g:
                    if not first: sb.append(" ")
                    sb.append(c.to_str())
                    first = false
                k = k + 1
            g = g + 1
        mut out = sb.to_owned()
        sb.free()
        return out
