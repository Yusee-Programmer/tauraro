# std.sys.datetime — DateTime, Date, Time, TimeDelta classes (like Python datetime module).

from std.core.string import StringBuilder
from std.string.fmt import Fmt

extern "C":
    def _tr_timestamp() -> int
    def _tr_tm_year(ts: int) -> int
    def _tr_tm_month(ts: int) -> int
    def _tr_tm_day(ts: int) -> int
    def _tr_tm_hour(ts: int) -> int
    def _tr_tm_min(ts: int) -> int
    def _tr_tm_sec(ts: int) -> int
    def _tr_tm_weekday(ts: int) -> int
    def _tr_tm_yearday(ts: int) -> int
    def _tr_tm_make(year: int, month: int, day: int, hour: int, mi: int, sec: int) -> int
    def _tr_strftime(ts: int, fmt: str) -> str
    # Timezone support: the SYSTEM's current local-zone offset/DST/abbreviation.
    # Fixed-offset zones (TimeZone.fixed/.utc) are pure arithmetic and never
    # call these. See runtime/tauraro_rt.h's "Timezone support" section.
    def _tr_tz_utc_offset_seconds() -> int
    def _tr_tz_is_dst() -> bool
    def _tr_tz_name() -> str

# ─── TimeDelta ────────────────────────────────────────────────────────────────

@value_type
pub class TimeDelta:
    pub days:    int
    pub seconds: int

extend TimeDelta:
    # Create a TimeDelta from explicit components (all optional, default 0).
    pub def init(days: int, seconds: int) -> TimeDelta:
        mut d = TimeDelta()
        mut total_s = days * 86400 + seconds
        if total_s < 0:
            mut neg = 0 - total_s
            d.days    = 0 - (neg / 86400)
            d.seconds = 0 - (neg - (neg / 86400) * 86400)
        else:
            d.days    = total_s / 86400
            d.seconds = total_s - (total_s / 86400) * 86400
        return d

    pub def from_seconds(s: int) -> TimeDelta:
        return TimeDelta.init(0, s)

    pub def from_minutes(m: int) -> TimeDelta:
        return TimeDelta.init(0, m * 60)

    pub def from_hours(h: int) -> TimeDelta:
        return TimeDelta.init(0, h * 3600)

    pub def from_days(d: int) -> TimeDelta:
        return TimeDelta.init(d, 0)

    # Total duration expressed purely in seconds.
    pub def total_seconds(self) -> int:
        return self.days * 86400 + self.seconds

    pub def to_string(self) -> str:
        mut sb = StringBuilder.init(32)
        if self.days != 0:
            sb.append(Fmt.int_to_str(self.days))
            sb.append("d ")
        mut h   = self.seconds / 3600
        mut rem = self.seconds - h * 3600
        mut mi  = rem / 60
        mut s   = rem - mi * 60
        sb.append(Fmt.zero_pad(h, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(mi, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(s, 2))
        mut out = sb.to_owned()
        sb.free()
        return out


# ─── TimeZone ─────────────────────────────────────────────────────────────────
#
# Scope: fixed UTC offsets (arithmetic only, works everywhere incl. bare-metal)
# plus the host system's current local timezone (offset/DST/abbreviation, via
# new runtime primitives — see runtime/tauraro_rt.h's "Timezone support"
# section). This is NOT a full IANA tzdata implementation: there is no table
# of named zones ("America/New_York") and no historical DST rule engine. For
# a fixed offset there is no DST to compute; for the system zone, "now"'s
# offset/DST state is read live from the OS each time .local() is called
# (mirrors what the OS itself currently believes, same caveat as C's
# localtime()).

@value_type
pub class TimeZone:
    pub offset_seconds: int   # seconds EAST of UTC (negative = west)
    pub is_dst:          bool
    pub name:            str  # best-effort abbreviation, e.g. "UTC", "+05:30", "PST"

extend TimeZone:
    # The UTC timezone: zero offset, never DST.
    pub def utc() -> TimeZone:
        mut tz = TimeZone()
        tz.offset_seconds = 0
        tz.is_dst = false
        tz.name = "UTC"
        return tz

    # An arbitrary fixed UTC offset with no DST. Pure arithmetic — no OS call,
    # works identically on every target including bare-metal/freestanding.
    # `offset_minutes` lets you express odd offsets like UTC+5:30 or UTC-9:45;
    # pass 0 for whole-hour zones.
    pub def fixed(offset_hours: int, offset_minutes: int) -> TimeZone:
        mut tz = TimeZone()
        mut total_min = offset_hours * 60 + offset_minutes
        tz.offset_seconds = total_min * 60
        tz.is_dst = false
        tz.name = TimeZone._format_offset(tz.offset_seconds)
        return tz

    # The system's current local timezone: UTC offset, whether DST is
    # currently in effect, and a best-effort zone abbreviation/name — all read
    # live from the OS (new _tr_tz_* runtime primitives). On a bare/no-RTC
    # target this degrades to a fixed UTC+0 zone, matching how _tr_timestamp
    # itself degrades (see runtime/tauraro_rt.h).
    pub def local() -> TimeZone:
        mut tz = TimeZone()
        tz.offset_seconds = _tr_tz_utc_offset_seconds()
        tz.is_dst = _tr_tz_is_dst()
        mut nm = _tr_tz_name()
        if nm.len() == 0:
            nm = TimeZone._format_offset(tz.offset_seconds)
        tz.name = nm
        return tz

    # Format a seconds-east-of-UTC offset as "+HH:MM" / "-HH:MM".
    def _format_offset(offset_seconds: int) -> str:
        mut secs = offset_seconds
        mut sign = "+"
        if secs < 0:
            sign = "-"
            secs = 0 - secs
        mut h = secs / 3600
        mut mi = (secs - h * 3600) / 60
        mut sb = StringBuilder.init(6)
        sb.append(sign)
        sb.append(Fmt.zero_pad(h, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(mi, 2))
        mut out = sb.to_owned()
        sb.free()
        return out

    # This zone's UTC offset as a TimeDelta (positive = east of UTC).
    pub def utc_offset(self) -> TimeDelta:
        return TimeDelta.from_seconds(self.offset_seconds)

    pub def eq(self, other: TimeZone) -> bool:
        return self.offset_seconds == other.offset_seconds

    pub def to_string(self) -> str:
        return self.name


# ─── DateTime ─────────────────────────────────────────────────────────────────

@value_type
pub class DateTime:
    pub year:   int
    pub month:  int
    pub day:    int
    pub hour:   int
    pub minute: int
    pub second: int
    pub tz:     TimeZone
    pub _ts:    int

extend DateTime:
    # Construct a DateTime with explicit components, in the system's local
    # timezone (matches the historical behavior of this constructor, which
    # builds _ts via the system's mktime()). Use `.in_zone(...)` to construct
    # explicit components against a specific TimeZone instead.
    pub def init(year: int, month: int, day: int, hour: int, minute: int, second: int) -> DateTime:
        mut dt = DateTime()
        dt.year   = year
        dt.month  = month
        dt.day    = day
        dt.hour   = hour
        dt.minute = minute
        dt.second = second
        dt.tz     = TimeZone.local()
        dt._ts    = _tr_tm_make(year, month, day, hour, minute, second)
        return dt

    # Current local date and time (wall-clock fields in the system's local
    # timezone, tagged with that zone).
    pub def now() -> DateTime:
        mut ts = _tr_timestamp()
        return DateTime._from_ts(ts)

    # Current date and time in UTC.
    pub def utc_now() -> DateTime:
        return DateTime._from_ts_in_zone(_tr_timestamp(), TimeZone.utc())

    # Build a DateTime from a Unix timestamp, rendered in the system's local
    # timezone (matches historical behavior: wall-clock fields via localtime).
    pub def from_timestamp(ts: int) -> DateTime:
        return DateTime._from_ts(ts)

    # Build a DateTime from a Unix timestamp, rendered in UTC (tz defaults to
    # UTC — avoids the silent-local-time footgun other constructors carry for
    # historical-compatibility reasons).
    pub def from_timestamp_utc(ts: int) -> DateTime:
        return DateTime._from_ts_in_zone(ts, TimeZone.utc())

    # Build a DateTime from explicit wall-clock components interpreted as
    # already being in the given TimeZone (no OS call — pure arithmetic).
    pub def in_zone(year: int, month: int, day: int, hour: int, minute: int, second: int, tz: TimeZone) -> DateTime:
        mut dt = DateTime()
        dt.year   = year
        dt.month  = month
        dt.day    = day
        dt.hour   = hour
        dt.minute = minute
        dt.second = second
        dt.tz     = tz
        mut days = DateTime._days_from_civil(year, month, day)
        mut secs_in_day = hour * 3600 + minute * 60 + second
        dt._ts = days * 86400 + secs_in_day - tz.offset_seconds
        return dt

    # System-local rendering (unchanged historical behavior: uses the OS's
    # own localtime() so it stays correct across any local DST transitions
    # the OS itself knows about).
    def _from_ts(ts: int) -> DateTime:
        mut dt = DateTime()
        dt._ts    = ts
        dt.year   = _tr_tm_year(ts)
        dt.month  = _tr_tm_month(ts)
        dt.day    = _tr_tm_day(ts)
        dt.hour   = _tr_tm_hour(ts)
        dt.minute = _tr_tm_min(ts)
        dt.second = _tr_tm_sec(ts)
        dt.tz     = TimeZone.local()
        return dt

    # Render a Unix timestamp's wall-clock fields in an arbitrary TimeZone via
    # pure arithmetic (no OS call — works for any fixed-offset zone, and for
    # TimeZone.local() too since by this point its offset has already been
    # read from the OS once).
    def _from_ts_in_zone(ts: int, tz: TimeZone) -> DateTime:
        mut dt = DateTime()
        dt._ts = ts
        dt.tz  = tz
        mut local_secs = ts + tz.offset_seconds
        mut days = local_secs / 86400
        mut rem  = local_secs - days * 86400
        if rem < 0:
            rem = rem + 86400
            days = days - 1
        dt.hour   = rem / 3600
        dt.minute = (rem - dt.hour * 3600) / 60
        dt.second = rem - dt.hour * 3600 - dt.minute * 60
        # civil_from_days: inverse of _days_from_civil (Howard Hinnant's
        # well-known constant-time algorithm — proleptic Gregorian, no tables).
        mut z = days + 719468
        mut era = z
        if z < 0: era = z - 146096
        era = era / 146097
        mut doe = z - era * 146097                                  # [0, 146096]
        mut yoe = (doe - doe/1460 + doe/36524 - doe/146096) / 365    # [0, 399]
        mut y = yoe + era * 400
        mut doy = doe - (365 * yoe + yoe / 4 - yoe / 100)            # [0, 365]
        mut mp = (5 * doy + 2) / 153                                  # [0, 11] (0=Mar .. 11=Feb)
        dt.day = doy - (153 * mp + 2) / 5 + 1                        # [1, 31]
        if mp < 10:
            dt.month = mp + 3
        else:
            dt.month = mp - 9
            y = y + 1
        dt.year = y
        return dt

    # Days since the Unix epoch (1970-01-01) for a given proleptic-Gregorian
    # civil date. Howard Hinnant's well-known constant-time algorithm — valid
    # for all years representable in a 64-bit `int`, no lookup tables.
    def _days_from_civil(year: int, month: int, day: int) -> int:
        mut y = year
        if month <= 2: y = y - 1
        mut era = y
        if y < 0: era = y - 399
        era = era / 400
        mut yoe = y - era * 400                                    # [0, 399]
        mut m_adj = month - 3
        if month <= 2: m_adj = month + 9                            # Mar=0 .. Feb=11
        mut doy = (153 * m_adj + 2) / 5 + day - 1                   # [0, 365]
        mut doe = yoe * 365 + yoe / 4 - yoe / 100 + doy              # [0, 146096]
        return era * 146097 + doe - 719468

    # Unix timestamp (seconds since 1970-01-01 00:00:00 UTC) — invariant
    # across timezone: the same instant regardless of which zone its
    # wall-clock fields are expressed in.
    pub def timestamp(self) -> int:
        return self._ts

    # Convert to the same instant rendered in a different TimeZone (wall-clock
    # fields change; the underlying instant/timestamp does not).
    pub def to_zone(self, tz: TimeZone) -> DateTime:
        return DateTime._from_ts_in_zone(self._ts, tz)

    # This DateTime's associated timezone's UTC offset.
    pub def utc_offset(self) -> TimeDelta:
        return self.tz.utc_offset()

    # 0=Monday … 6=Sunday (same convention as Python).
    pub def weekday(self) -> int:
        mut w = _tr_tm_weekday(self._ts)
        if w == 0: return 6
        return w - 1

    # 0=Sunday … 6=Saturday (C convention).
    pub def isoweekday(self) -> int:
        return _tr_tm_weekday(self._ts)

    # Day of year 1–366.
    pub def yearday(self) -> int:
        return _tr_tm_yearday(self._ts)

    # Name of the weekday.
    pub def weekday_name(self) -> str:
        mut w = self.weekday()
        if w == 0: return "Monday"
        if w == 1: return "Tuesday"
        if w == 2: return "Wednesday"
        if w == 3: return "Thursday"
        if w == 4: return "Friday"
        if w == 5: return "Saturday"
        return "Sunday"

    # Abbreviated weekday name.
    pub def weekday_abbr(self) -> str:
        mut w = self.weekday()
        if w == 0: return "Mon"
        if w == 1: return "Tue"
        if w == 2: return "Wed"
        if w == 3: return "Thu"
        if w == 4: return "Fri"
        if w == 5: return "Sat"
        return "Sun"

    # Full month name.
    pub def month_name(self) -> str:
        if self.month == 1:  return "January"
        if self.month == 2:  return "February"
        if self.month == 3:  return "March"
        if self.month == 4:  return "April"
        if self.month == 5:  return "May"
        if self.month == 6:  return "June"
        if self.month == 7:  return "July"
        if self.month == 8:  return "August"
        if self.month == 9:  return "September"
        if self.month == 10: return "October"
        if self.month == 11: return "November"
        return "December"

    # True when the year is a leap year.
    pub def is_leap_year(self) -> bool:
        mut y = self.year
        if (y - (y / 400) * 400) == 0: return true
        if (y - (y / 100) * 100) == 0: return false
        if (y - (y / 4) * 4) == 0: return true
        return false

    # Return a new DateTime offset by the given TimeDelta (keeps self's zone).
    pub def add(self, delta: TimeDelta) -> DateTime:
        return DateTime._from_ts_in_zone(self._ts + delta.total_seconds(), self.tz)

    # Return a new DateTime moved back by the given TimeDelta (keeps self's zone).
    pub def sub(self, delta: TimeDelta) -> DateTime:
        return DateTime._from_ts_in_zone(self._ts - delta.total_seconds(), self.tz)

    # Difference between two DateTimes as a TimeDelta.
    pub def diff(self, other: DateTime) -> TimeDelta:
        return TimeDelta.from_seconds(self._ts - other._ts)

    # True when this moment is before other.
    pub def before(self, other: DateTime) -> bool:
        return self._ts < other._ts

    # True when this moment is after other.
    pub def after(self, other: DateTime) -> bool:
        return self._ts > other._ts

    # True when both moments represent the same second.
    pub def eq(self, other: DateTime) -> bool:
        return self._ts == other._ts

    # strftime-style formatting string.  e.g. "%Y-%m-%d %H:%M:%S"
    pub def strftime(self, fmt: str) -> str:
        return _tr_strftime(self._ts, fmt)

    # ISO 8601 string: "YYYY-MM-DD HH:MM:SS"
    pub def to_string(self) -> str:
        mut sb = StringBuilder.init(20)
        sb.append(Fmt.zero_pad(self.year, 4))
        sb.append("-")
        sb.append(Fmt.zero_pad(self.month, 2))
        sb.append("-")
        sb.append(Fmt.zero_pad(self.day, 2))
        sb.append(" ")
        sb.append(Fmt.zero_pad(self.hour, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(self.minute, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(self.second, 2))
        mut out = sb.to_owned()
        sb.free()
        return out

    # ISO 8601 date-only string: "YYYY-MM-DD"
    pub def date_str(self) -> str:
        mut sb = StringBuilder.init(11)
        sb.append(Fmt.zero_pad(self.year, 4))
        sb.append("-")
        sb.append(Fmt.zero_pad(self.month, 2))
        sb.append("-")
        sb.append(Fmt.zero_pad(self.day, 2))
        mut out = sb.to_owned()
        sb.free()
        return out

    # Time-only string: "HH:MM:SS"
    pub def time_str(self) -> str:
        mut sb = StringBuilder.init(9)
        sb.append(Fmt.zero_pad(self.hour, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(self.minute, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(self.second, 2))
        mut out = sb.to_owned()
        sb.free()
        return out

    # Human-friendly relative-time string compared against the current real
    # moment, e.g. "3 hours ago", "in 2 days", "just now". Falls back to
    # `to_string()` beyond 30 days in either direction (relative phrasing
    # stops being useful at that range). Timezone-independent: compares
    # absolute instants (self._ts vs "now"), not wall-clock fields.
    pub def format_relative(self) -> str:
        mut now = _tr_timestamp()
        mut delta = self._ts - now           # positive = future, negative = past
        mut future = delta >= 0
        mut mag = delta
        if not future: mag = 0 - delta

        if mag < 60:
            return "just now"

        if mag < 3600:
            mut n = mag / 60
            return DateTime._relative_phrase(n, "minute", future)

        if mag < 86400:
            mut n = mag / 3600
            return DateTime._relative_phrase(n, "hour", future)

        if mag < 2592000:                     # 30 days
            mut n = mag / 86400
            return DateTime._relative_phrase(n, "day", future)

        return self.to_string()

    # "N unit(s) ago" / "in N unit(s)", with correct singular/plural.
    def _relative_phrase(n: int, unit: str, future: bool) -> str:
        mut sb = StringBuilder.init(24)
        if future:
            sb.append("in ")
            sb.append(Fmt.int_to_str(n))
            sb.append(" ")
            sb.append(unit)
            if n != 1: sb.append("s")
        else:
            sb.append(Fmt.int_to_str(n))
            sb.append(" ")
            sb.append(unit)
            if n != 1: sb.append("s")
            sb.append(" ago")
        mut out = sb.to_owned()
        sb.free()
        return out


# ─── Date ─────────────────────────────────────────────────────────────────────

@value_type
pub class Date:
    pub year:  int
    pub month: int
    pub day:   int

extend Date:
    pub def init(year: int, month: int, day: int) -> Date:
        mut d = Date()
        d.year  = year
        d.month = month
        d.day   = day
        return d

    # Today's local date.
    pub def today() -> Date:
        mut ts = _tr_timestamp()
        mut d  = Date()
        d.year  = _tr_tm_year(ts)
        d.month = _tr_tm_month(ts)
        d.day   = _tr_tm_day(ts)
        return d

    pub def to_string(self) -> str:
        mut sb = StringBuilder.init(11)
        sb.append(Fmt.zero_pad(self.year, 4))
        sb.append("-")
        sb.append(Fmt.zero_pad(self.month, 2))
        sb.append("-")
        sb.append(Fmt.zero_pad(self.day, 2))
        mut out = sb.to_owned()
        sb.free()
        return out

    pub def to_datetime(self) -> DateTime:
        return DateTime.init(self.year, self.month, self.day, 0, 0, 0)

    pub def eq(self, other: Date) -> bool:
        return self.year == other.year and self.month == other.month and self.day == other.day

    pub def before(self, other: Date) -> bool:
        if self.year != other.year: return self.year < other.year
        if self.month != other.month: return self.month < other.month
        return self.day < other.day

    pub def after(self, other: Date) -> bool:
        return other.before(self)


# ─── Time ─────────────────────────────────────────────────────────────────────

@value_type
pub class Time:
    pub hour:   int
    pub minute: int
    pub second: int

extend Time:
    pub def init(hour: int, minute: int, second: int) -> Time:
        mut t = Time()
        t.hour   = hour
        t.minute = minute
        t.second = second
        return t

    # Current local time of day.
    pub def now() -> Time:
        mut ts = _tr_timestamp()
        mut t  = Time()
        t.hour   = _tr_tm_hour(ts)
        t.minute = _tr_tm_min(ts)
        t.second = _tr_tm_sec(ts)
        return t

    pub def to_string(self) -> str:
        mut sb = StringBuilder.init(9)
        sb.append(Fmt.zero_pad(self.hour, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(self.minute, 2))
        sb.append(":")
        sb.append(Fmt.zero_pad(self.second, 2))
        mut out = sb.to_owned()
        sb.free()
        return out

    pub def total_seconds(self) -> int:
        return self.hour * 3600 + self.minute * 60 + self.second

    pub def eq(self, other: Time) -> bool:
        return self.hour == other.hour and self.minute == other.minute and self.second == other.second

    pub def before(self, other: Time) -> bool:
        return self.total_seconds() < other.total_seconds()

