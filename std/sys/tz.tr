# std.sys.tz -- IANA time zones: TZif files, POSIX TZ rules, DST-aware
# conversion between UTC instants and wall-clock time.
# tauraro-cpp-shim: tz_native.c
#
# `Tz.load("America/New_York")` reads the zone's TZif file (RFC 8536,
# versions 1-4; the 64-bit section is used when present, leap-second records
# are skipped) from the first zoneinfo directory found: $TZDIR,
# /usr/share/zoneinfo, /usr/lib/zoneinfo, /usr/share/lib/zoneinfo,
# /etc/zoneinfo. Instants after the file's last transition follow its POSIX TZ
# footer. Where no zoneinfo directory exists (Windows, minimal containers) the
# name is looked up in an embedded table of every IANA zone's CURRENT POSIX
# rule (std/sys/tz_table.tr, generated by scripts/gen_tz_table.py); such zones
# are exact for present-day rules but do not know historical offsets.
#
# Anywhere a zone name is accepted, a POSIX TZ string works too:
# "EST5EDT,M3.2.0,M11.1.0", "<+0330>-3:30", "CET-1CEST,M3.5.0,M10.5.0/3",
# Julian "Jn" (1-365, Feb 29 never counted) and zero-based "n" day forms,
# transition times from -167 to 167 hours.
#
# Local wall time -> instant: a wall time can be skipped (spring-forward gap)
# or repeated (fall-back overlap). `local_to_unix(y, m, d, h, mi, s, policy)`
# picks with
#   TZ_EARLIER  the offset in effect BEFORE the transition (Python fold=0;
#               an overlap gives the first occurrence, a gap is pushed forward)
#   TZ_LATER    the offset in effect AFTER the transition (Python fold=1;
#               the second occurrence / pushed backward)
#   TZ_RAISE    raise on both gaps and overlaps
# `from_local` (a DateTime) uses TZ_EARLIER, matching Python's zoneinfo with
# fold=0; `from_local_later` uses TZ_LATER; `classify_local` tells which case
# a wall time is. (There is no raising DateTime variant: a `throws` function
# cannot yet return a @value_type such as DateTime -- use
# `tz.to_local(tz.local_to_unix(..., TZ_RAISE)?)`.)
#
# Usage:
#   from std.sys.tz import Tz, TZ_RAISE
#   mut ny = Tz.load("America/New_York")?
#   mut off, dst, abbr = ny.offset_at(1710054000)       # (-14400, true, "EDT")
#   mut dt = ny.to_local(1710054000)                    # 2024-03-10 03:00:00, dt.tz.name == "EDT"
#   print(dt.isoformat())                               # 2024-03-10T03:00:00-04:00
#   mut t = ny.local_to_unix(2024, 3, 10, 2, 30, 0, TZ_RAISE)?   # raises: nonexistent
#   mut tokyo = Tz.load("Asia/Tokyo")?
#   print(tokyo.convert(dt).to_string())                # same instant in Tokyo

from std.core.string import StringBuilder
from std.io.file import File
from std.io.dir import Dir
from std.sys.datetime import DateTime, TimeZone, TimeDelta
from std.sys.tz_table import tz_table_chunks, tz_table_chunk, TZ_TABLE_VERSION

extern "C":
    def trc_tz_readlink(path: Pointer[char], buf: Pointer[char], cap: int) -> int
    def trc_tz_win_local(buf: Pointer[char], cap: int) -> int
    def _tr_getenv(name: str) -> Pointer[char]
    def _tr_dir_exists(path: str) -> bool
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

# Policies for local_to_unix.
pub const TZ_EARLIER = 0
pub const TZ_LATER = 1
pub const TZ_RAISE = 2

# Results of classify_local.
pub const TZ_LOCAL_UNIQUE = 0
pub const TZ_LOCAL_AMBIGUOUS = 1
pub const TZ_LOCAL_NONEXISTENT = 2

# ── small helpers ────────────────────────────────────────────────────────────

def _tzb(s: str, i: int) -> int:
    mut p = s as Pointer[char]
    unsafe:
        return (p.offset(i).read() as int) & 255

def _tz_u32(s: str, i: int) -> int:
    return (_tzb(s, i) << 24) | (_tzb(s, i + 1) << 16) | (_tzb(s, i + 2) << 8) | _tzb(s, i + 3)

def _tz_s32(s: str, i: int) -> int:
    mut v = _tz_u32(s, i)
    if v >= 2147483648: v = v - 4294967296
    return v

def _tz_s64(s: str, i: int) -> int:
    return (_tz_u32(s, i) << 32) | _tz_u32(s, i + 4)

# Floor division / modulo for possibly negative a (b > 0).
def _tz_fdiv(a: int, b: int) -> int:
    mut q = a / b
    if q * b > a: q = q - 1
    return q

def _tz_fmod(a: int, b: int) -> int:
    return a - _tz_fdiv(a, b) * b

def _tz_is_leap(y: int) -> bool:
    if _tz_fmod(y, 400) == 0: return true
    if _tz_fmod(y, 100) == 0: return false
    return _tz_fmod(y, 4) == 0

def _tz_month_days(y: int, m: int) -> int:
    if m == 2:
        if _tz_is_leap(y): return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11: return 30
    return 31

# Days since 1970-01-01 of a proleptic-Gregorian date (Hinnant).
def _tz_days(year: int, month: int, day: int) -> int:
    mut y = year
    if month <= 2: y = y - 1
    mut era = _tz_fdiv(y, 400)
    mut yoe = y - era * 400
    mut mp = month - 3
    if month <= 2: mp = month + 9
    mut doy = (153 * mp + 2) / 5 + day - 1
    mut doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

# Civil year of a seconds-since-epoch value (UTC or naive local).
def _tz_year_of(secs: int) -> int:
    mut z = _tz_fdiv(secs, 86400) + 719468
    mut era = _tz_fdiv(z, 146097)
    mut doe = z - era * 146097
    mut yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    mut y = yoe + era * 400
    mut doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mut mp = (5 * doy + 2) / 153
    if mp >= 10: y = y + 1
    return y

def _tz_is_digit(c: int) -> bool: return c >= 48 and c <= 57
def _tz_is_alpha(c: int) -> bool: return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

def _tz_env(name: str) -> str:
    mut p = _tr_getenv(name)
    if p as int == 0: return ""
    return p as str

# "+HH:MM" (or "+HH:MM:SS" when seconds are non-zero) for seconds east of UTC.
pub def tz_format_offset(offset_seconds: int) -> str:
    mut a = offset_seconds
    mut sb = StringBuilder.init(10)
    if a < 0:
        sb.append("-")
        a = 0 - a
    else:
        sb.append("+")
    mut h = a / 3600
    mut m = (a - h * 3600) / 60
    mut s = a - h * 3600 - m * 60
    if h < 10: sb.append("0")
    sb.append_int(h)
    sb.append(":")
    if m < 10: sb.append("0")
    sb.append_int(m)
    if s != 0:
        sb.append(":")
        if s < 10: sb.append("0")
        sb.append_int(s)
    mut out = sb.to_owned()
    sb.free()
    return out

# ── POSIX TZ rule strings ────────────────────────────────────────────────────

class _TzPx:
    pub s: str
    pub i: int
    pub n: int

extend _TzPx:
    pub def init(s: str) -> _TzPx:
        mut p = _TzPx()
        p.s = s
        p.i = 0
        p.n = s.len()
        return p

    pub def peek(self) -> int:
        if self.i >= self.n: return -1
        return _tzb(self.s, self.i)

    pub def expect(self, c: int, what: str) throws str:
        if self.peek() != c: raise(f"TZ string '{self.s}': expected {what} at offset {self.i}")
        self.i = self.i + 1

    pub def abbr(self) throws str -> str:
        mut c = self.peek()
        if c == 60:   # '<'
            mut j = self.i + 1
            while j < self.n and _tzb(self.s, j) != 62: j = j + 1
            if j >= self.n: raise(f"TZ string '{self.s}': unterminated <abbreviation>")
            mut a = self.s.slice(self.i + 1, j)
            if a.len() == 0: raise(f"TZ string '{self.s}': empty <abbreviation>")
            self.i = j + 1
            return a
        mut st = self.i
        while _tz_is_alpha(self.peek()): self.i = self.i + 1
        if self.i == st: raise(f"TZ string '{self.s}': expected a zone abbreviation at offset {st}")
        return self.s.slice(st, self.i)

    pub def num(self) throws str -> int:
        if not _tz_is_digit(self.peek()): raise(f"TZ string '{self.s}': expected a number at offset {self.i}")
        mut v = 0
        while _tz_is_digit(self.peek()):
            v = v * 10 + (self.peek() - 48)
            if v > 100000: raise(f"TZ string '{self.s}': number too large")
            self.i = self.i + 1
        return v

    # [+|-]hh[:mm[:ss]] in seconds (sign as written).
    pub def hms(self, max_hours: int) throws str -> int:
        mut sign = 1
        mut c = self.peek()
        if c == 43: self.i = self.i + 1
        elif c == 45:
            sign = -1
            self.i = self.i + 1
        mut h = self.num()?
        if h > max_hours: raise(f"TZ string '{self.s}': hour {h} out of range")
        mut total = h * 3600
        if self.peek() == 58:
            self.i = self.i + 1
            mut m = self.num()?
            if m > 59: raise(f"TZ string '{self.s}': minutes out of range")
            total = total + m * 60
            if self.peek() == 58:
                self.i = self.i + 1
                mut sec = self.num()?
                if sec > 59: raise(f"TZ string '{self.s}': seconds out of range")
                total = total + sec
        return sign * total

    # One ",start[/time]" or ",end[/time]" date: [kind, a, b, c, time].
    pub def rule_date(self) throws str -> List[int]:
        mut c = self.peek()
        mut kind = 0
        mut a = 0
        mut b = 0
        mut d = 0
        if c == 74:   # 'J'
            self.i = self.i + 1
            a = self.num()?
            if a < 1 or a > 365: raise(f"TZ string '{self.s}': Julian day J{a} out of range")
        elif c == 77:  # 'M'
            self.i = self.i + 1
            kind = 2
            a = self.num()?
            self.expect(46, "'.'")?
            b = self.num()?
            self.expect(46, "'.'")?
            d = self.num()?
            if a < 1 or a > 12 or b < 1 or b > 5 or d > 6: raise(f"TZ string '{self.s}': bad M{a}.{b}.{d} rule")
        else:
            kind = 1
            a = self.num()?
            if a > 365: raise(f"TZ string '{self.s}': day {a} out of range")
        mut t = 7200
        if self.peek() == 47:   # '/'
            self.i = self.i + 1
            t = self.hms(167)?
        mut r: List[int] = [kind, a, b, d, t]
        return r

# A parsed POSIX TZ rule: standard time, optional daylight time and the two
# yearly switch dates. Offsets are seconds EAST of UTC (the string itself
# writes them west-positive). Date kinds: 0 = Jn, 1 = n, 2 = Mm.w.d.
pub class TzRule:
    pub text:     str
    pub std_abbr: str
    pub std_off:  int
    pub has_dst:  bool
    pub dst_abbr: str
    pub dst_off:  int
    pub s_kind: int
    pub s_a:    int
    pub s_b:    int
    pub s_c:    int
    pub s_time: int
    pub e_kind: int
    pub e_a:    int
    pub e_b:    int
    pub e_c:    int
    pub e_time: int

extend TzRule:
    # Parse "std offset [dst [offset] [,start[/time],end[/time]]]". A leading
    # ':' is ignored. With a DST name but no dates, the US rules
    # (M3.2.0,M11.1.0) are assumed, as glibc does.
    pub def parse(text: str) throws str -> TzRule:
        mut s = text
        if s.starts_with(":"): s = s.slice(1, s.len())
        mut r = TzRule()
        r.text = s
        r.has_dst = false
        r.dst_abbr = ""
        r.dst_off = 0
        r.s_kind = 2
        r.s_a = 3
        r.s_b = 2
        r.s_c = 0
        r.s_time = 7200
        r.e_kind = 2
        r.e_a = 11
        r.e_b = 1
        r.e_c = 0
        r.e_time = 7200
        mut px = _TzPx.init(s)
        r.std_abbr = px.abbr()?
        r.std_off = 0
        if px.peek() == -1:
            if r.std_abbr != "UTC" and r.std_abbr != "GMT" and r.std_abbr != "UT" and r.std_abbr != "Z":
                raise(f"TZ string '{s}': missing UTC offset")
            return r
        r.std_off = 0 - px.hms(24)?
        if px.peek() == -1: return r
        r.has_dst = true
        r.dst_abbr = px.abbr()?
        r.dst_off = r.std_off + 3600
        mut c = px.peek()
        if c != 44 and c != -1: r.dst_off = 0 - px.hms(24)?
        if px.peek() == -1: return r
        px.expect(44, "','")?
        mut st = px.rule_date()?
        px.expect(44, "','")?
        mut en = px.rule_date()?
        if px.peek() != -1: raise(f"TZ string '{s}': trailing characters at offset {px.i}")
        r.s_kind = st[0]
        r.s_a = st[1]
        r.s_b = st[2]
        r.s_c = st[3]
        r.s_time = st[4]
        r.e_kind = en[0]
        r.e_a = en[1]
        r.e_b = en[2]
        r.e_c = en[3]
        r.e_time = en[4]
        return r

    # Naive local seconds (date + rule time, in the zone's wall clock) of a
    # rule date in `year`.
    def _date(kind: int, a: int, b: int, c: int, time: int, year: int) -> int:
        mut days = 0
        if kind == 0:
            mut d = a - 1
            if d >= 59 and _tz_is_leap(year): d = d + 1
            days = _tz_days(year, 1, 1) + d
        elif kind == 1:
            days = _tz_days(year, 1, 1) + a
        else:
            mut first = _tz_days(year, a, 1)
            mut wd = _tz_fmod(first + 4, 7)        # 0 = Sunday
            mut day = 1 + _tz_fmod(c - wd + 7, 7) + (b - 1) * 7
            mut md = _tz_month_days(year, a)
            while day > md: day = day - 7
            days = first + day - 1
        return days * 86400 + time

    pub def start_local(self, year: int) -> int:
        return TzRule._date(self.s_kind, self.s_a, self.s_b, self.s_c, self.s_time, year)

    pub def end_local(self, year: int) -> int:
        return TzRule._date(self.e_kind, self.e_a, self.e_b, self.e_c, self.e_time, year)

    # DST in force at a UTC instant?
    pub def is_dst_utc(self, ts: int) -> bool:
        if not self.has_dst: return false
        mut year = _tz_year_of(ts)
        mut st = self.start_local(year) - self.std_off
        mut en = self.end_local(year) - self.dst_off
        if st < en: return st <= ts and ts < en
        return not (en <= ts and ts < st)

    # DST in force at naive local seconds `wall` (fold 0 = offset before a
    # transition, 1 = offset after).
    pub def is_dst_local(self, wall: int, fold: int) -> bool:
        if not self.has_dst: return false
        mut year = _tz_year_of(wall)
        mut st = self.start_local(year)
        mut en = self.end_local(year)
        mut diff = self.dst_off - self.std_off
        if (fold == 1) == (diff >= 0): en = en - diff
        else: st = st + diff
        if st < en: return st <= wall and wall < en
        return not (en <= wall and wall < st)

    # UTC instants of the DST start and end in `year`.
    pub def transitions(self, year: int) -> (int, int):
        return (self.start_local(year) - self.std_off, self.end_local(year) - self.dst_off)

# ── the embedded table ──────────────────────────────────────────────────────

# POSIX rule for an IANA name from the embedded table ("" if absent).
pub def tz_embedded_rule(name: str) -> str:
    if name.len() == 0 or name.contains(" ") or name.contains(";"): return ""
    mut key = " " + name + " "
    mut i = 0
    while i < tz_table_chunks():
        mut ch = tz_table_chunk(i)
        mut pos = ch.index_of(key)
        if pos >= 0:
            mut st = pos
            while st > 0 and _tzb(ch, st - 1) != 59: st = st - 1   # back to the group start after ';'
            mut en = st
            while _tzb(ch, en) != 32: en = en + 1
            return ch.slice(st, en)
        i = i + 1
    return ""

# Every zone name in the embedded table, sorted.
pub def tz_embedded_names() -> List[str]:
    mut out: List[str] = []
    mut i = 0
    while i < tz_table_chunks():
        mut ch = tz_table_chunk(i)
        mut n = ch.len()
        mut p = 0
        while p < n:
            # skip the rule
            while p < n and _tzb(ch, p) != 32: p = p + 1
            p = p + 1
            while p < n and _tzb(ch, p) != 59:
                mut q = p
                while _tzb(ch, q) != 32: q = q + 1
                out.append(ch.slice(p, q))
                p = q + 1
            p = p + 1
        i = i + 1
    out.sort()
    return out

# tzdata release the embedded table was generated from.
pub def tz_embedded_version() -> str: return TZ_TABLE_VERSION

# ── Tz ───────────────────────────────────────────────────────────────────────

pub class Tz:
    pub name:       str   # IANA key ("Europe/London"), TZ string, or "UTC"
    pub source:     str   # "tzif", "embedded", "posix", "fixed" or "windows"
    pub posix_rule: str   # rule used after the last transition ("" if none)
    pub _trans: List[int]   # transition instants (UTC seconds), ascending
    pub _tidx:  List[int]   # local-time type after each transition
    pub _off:   List[int]   # per type: seconds east of UTC
    pub _dst:   List[int]   # per type: 1 if DST
    pub _abbr:  List[str]   # per type: abbreviation
    pub _wall0: List[int]   # transitions in wall time, fold 0
    pub _wall1: List[int]   # transitions in wall time, fold 1
    pub _before: int        # type before the first transition
    pub _after:  int        # type after the last one when there is no rule
    pub _has_rule: bool
    pub _rule: TzRule

extend Tz:
    def _blank(name: str, source: str) -> Tz:
        mut z = Tz()
        z.name = name
        z.source = source
        z.posix_rule = ""
        z._trans = []
        z._tidx = []
        z._off = []
        z._dst = []
        z._abbr = []
        z._wall0 = []
        z._wall1 = []
        z._before = 0
        z._after = 0
        z._has_rule = false
        z._rule = TzRule()
        return z

    def _from_rule(name: str, rule: TzRule, source: str) -> Tz:
        mut z = Tz._blank(name, source)
        z.posix_rule = rule.text
        z._off.append(rule.std_off)
        z._dst.append(0)
        z._abbr.append(rule.std_abbr)
        z._has_rule = rule.has_dst
        z._rule = rule
        return z

    # Coordinated Universal Time.
    pub def utc() -> Tz:
        mut z = Tz._blank("UTC", "fixed")
        z.posix_rule = "UTC0"
        z._off.append(0)
        z._dst.append(0)
        z._abbr.append("UTC")
        return z

    # A fixed offset (seconds east of UTC) with the given abbreviation ("" ->
    # "+05:30" style). Its name is the abbreviation.
    pub def fixed(offset_seconds: int, abbr: str) -> Tz:
        mut a = abbr
        if a.len() == 0: a = tz_format_offset(offset_seconds)
        mut z = Tz._blank(a, "fixed")
        z._off.append(offset_seconds)
        z._dst.append(0)
        z._abbr.append(a)
        return z

    # A zone from a POSIX TZ string such as "CET-1CEST,M3.5.0,M10.5.0/3".
    pub def posix(text: str) throws str -> Tz:
        mut r = TzRule.parse(text)?
        return Tz._from_rule(r.text, r, "posix")

    # Parse TZif bytes (RFC 8536 v1-v4). `name` becomes tz.name.
    pub def from_tzif(name: str, data: str) throws str -> Tz:
        mut n = data.len()
        if n < 44 or data.slice(0, 4) != "TZif": raise(f"{name}: not a TZif file")
        mut ver = _tzb(data, 4)
        mut p = 0
        mut tsize = 4
        if ver >= 50:
            # skip the v1 (32-bit) block
            mut timecnt1 = _tz_u32(data, 32)
            mut v1 = timecnt1 * 5 + _tz_u32(data, 36) * 6 + _tz_u32(data, 40) + _tz_u32(data, 28) * 8 + _tz_u32(data, 24) + _tz_u32(data, 20)
            p = 44 + v1
            if p + 44 > n or data.slice(p, p + 4) != "TZif": raise(f"{name}: bad TZif v2+ header")
            tsize = 8
        mut isutcnt = _tz_u32(data, p + 20)
        mut isstdcnt = _tz_u32(data, p + 24)
        mut leapcnt = _tz_u32(data, p + 28)
        mut timecnt = _tz_u32(data, p + 32)
        mut typecnt = _tz_u32(data, p + 36)
        mut charcnt = _tz_u32(data, p + 40)
        p = p + 44
        if typecnt == 0 or typecnt > 256: raise(f"{name}: bad TZif type count")
        mut need = timecnt * (tsize + 1) + typecnt * 6 + charcnt + leapcnt * (tsize + 4) + isstdcnt + isutcnt
        if p + need > n: raise(f"{name}: truncated TZif data")
        mut z = Tz._blank(name, "tzif")
        mut k = 0
        while k < timecnt:
            if tsize == 8: z._trans.append(_tz_s64(data, p + k * 8))
            else: z._trans.append(_tz_s32(data, p + k * 4))
            k = k + 1
        p = p + timecnt * tsize
        k = 0
        while k < timecnt:
            mut ix = _tzb(data, p + k)
            if ix >= typecnt: raise(f"{name}: transition type index out of range")
            z._tidx.append(ix)
            k = k + 1
        p = p + timecnt
        mut chars = p + typecnt * 6
        k = 0
        while k < typecnt:
            mut q = p + k * 6
            z._off.append(_tz_s32(data, q))
            z._dst.append(_tzb(data, q + 4))
            mut ai = _tzb(data, q + 5)
            if ai >= charcnt: raise(f"{name}: abbreviation index out of range")
            mut e = chars + ai
            while e < chars + charcnt and _tzb(data, e) != 0: e = e + 1
            z._abbr.append(data.slice(chars + ai, e))
            k = k + 1
        p = chars + charcnt + leapcnt * (tsize + 4) + isstdcnt + isutcnt
        # footer: "\n<POSIX TZ>\n"
        if tsize == 8 and p < n and _tzb(data, p) == 10:
            mut e = p + 1
            while e < n and _tzb(data, e) != 10: e = e + 1
            mut foot = data.slice(p + 1, e)
            if foot.len() > 0:
                mut rr: Result[TzRule, str] = TzRule.parse(foot)
                if rr.is_ok:
                    mut rule = rr.ok
                    z.posix_rule = foot
                    if rule.has_dst:
                        z._has_rule = true
                        z._rule = rule
                    else:
                        z._off.append(rule.std_off)
                        z._dst.append(0)
                        z._abbr.append(rule.std_abbr)
                        z._after = typecnt
        if z.posix_rule.len() == 0 or z._has_rule:
            if timecnt > 0: z._after = z._tidx[timecnt - 1]
            else: z._after = typecnt - 1
        # before the first transition: the first standard-time type (as
        # Python's zoneinfo does; RFC 8536 type 0 in practice).
        z._before = -1
        k = 0
        while k < typecnt and z._before < 0:
            if z._dst[k] == 0: z._before = k
            k = k + 1
        if z._before < 0:
            if timecnt > 0: z._before = z._tidx[0]
            else: z._before = 0
        # wall-clock transition lists for local -> UTC lookups
        k = 0
        while k < timecnt:
            mut o_prev = z._off[0]
            if k > 0: o_prev = z._off[z._tidx[k - 1]]
            mut o_cur = z._off[z._tidx[k]]
            mut hi = o_prev
            mut lo = o_cur
            if o_cur > o_prev:
                hi = o_cur
                lo = o_prev
            z._wall0.append(z._trans[k] + hi)
            z._wall1.append(z._trans[k] + lo)
            k = k + 1
        return z

    # A zone from the embedded current-rule table only (never reads files);
    # what Tz.load falls back to without a zoneinfo directory.
    pub def embedded(name: str) throws str -> Tz:
        mut rule = tz_embedded_rule(name)
        if rule.len() == 0: raise(f"time zone not in the embedded table: '{name}'")
        mut r = TzRule.parse(rule)?
        return Tz._from_rule(name, r, "embedded")

    # Load a TZif file from an explicit path.
    pub def load_file(path: str, name: str) throws str -> Tz:
        if not File.file_exists(path): raise(f"time zone file not found: {path}")
        mut data = File.read_text(path)
        return Tz.from_tzif(name, data)?

    # The first zoneinfo directory that exists ("" when none does).
    pub def zoneinfo_dir() -> str:
        mut env = _tz_env("TZDIR")
        if env.len() > 0 and _tr_dir_exists(env): return env
        if _tr_dir_exists("/usr/share/zoneinfo"): return "/usr/share/zoneinfo"
        if _tr_dir_exists("/usr/lib/zoneinfo"): return "/usr/lib/zoneinfo"
        if _tr_dir_exists("/usr/share/lib/zoneinfo"): return "/usr/share/lib/zoneinfo"
        if _tr_dir_exists("/etc/zoneinfo"): return "/etc/zoneinfo"
        return ""

    def _valid_key(name: str) -> bool:
        if name.len() == 0 or name.starts_with("/") or name.ends_with("/"): return false
        if name.contains("\\") or name.contains("//"): return false
        if name == ".." or name.starts_with("../") or name.ends_with("/..") or name.contains("/../"): return false
        if name == "." or name.starts_with("./") or name.contains("/./"): return false
        return true

    # Load a zone by IANA name: the TZif file from the zoneinfo directory,
    # else the embedded current-rule table, else (if `name` parses as one) a
    # POSIX TZ string.
    pub def load(name: str) throws str -> Tz:
        if Tz._valid_key(name):
            mut dir = Tz.zoneinfo_dir()
            if dir.len() > 0:
                mut path = dir + "/" + name
                if File.file_exists(path) and not _tr_dir_exists(path):
                    mut data = File.read_text(path)
                    if data.starts_with("TZif"): return Tz.from_tzif(name, data)?
            if tz_embedded_rule(name).len() > 0: return Tz.embedded(name)?
            if name == "UTC": return Tz.utc()
        mut pr: Result[TzRule, str] = TzRule.parse(name)
        if pr.is_ok: return Tz._from_rule(name, pr.ok, "posix")
        raise(f"unknown time zone: '{name}'")

    # The system's local zone: $TZ (a zone name, ":name", an absolute TZif
    # path or a POSIX string), then the Windows zone settings, then
    # /etc/localtime (its symlink target or /etc/timezone gives the name).
    # With nothing configured the result is UTC. An unusable $TZ raises.
    pub def local() throws str -> Tz:
        mut tzv = _tz_env("TZ")
        if tzv.len() > 0:
            mut v = tzv
            if v.starts_with(":"): v = v.slice(1, v.len())
            if v.starts_with("/"):
                return Tz.load_file(v, Tz._name_from_path(v))?
            return Tz.load(v)?
        mut wbuf = _tr_c_malloc(1024)
        mut wn = trc_tz_win_local(wbuf, 1000)
        if wn >= 0:
            unsafe: wbuf.offset(wn).write('\0')
            mut w = _tr_str_wrap_len(wbuf, wn)
            mut nl = w.index_of("\n")
            if nl > 0:
                mut key = w.slice(0, nl)
                mut wr: Result[TzRule, str] = TzRule.parse(w.slice(nl + 1, w.len()))
                if wr.is_ok: return Tz._from_rule(key, wr.ok, "windows")
        if File.file_exists("/etc/localtime"):
            mut name = ""
            mut lbuf = _tr_c_malloc(4100)
            mut ln = trc_tz_readlink("/etc/localtime" as Pointer[char], lbuf, 4096)
            if ln < 0: ln = 0
            unsafe: lbuf.offset(ln).write('\0')
            mut target = _tr_str_wrap_len(lbuf, ln)
            if target.len() > 0: name = Tz._name_from_path(target)
            if name.len() == 0 or name.starts_with("/"):
                mut tzf = File.read_text("/etc/timezone").trim()
                if tzf.len() > 0 and Tz._valid_key(tzf): name = tzf
            if name.len() == 0 or name.starts_with("/"): name = "localtime"
            return Tz.from_tzif(name, File.read_text("/etc/localtime"))?
        return Tz.utc()

    # ".../zoneinfo/Europe/Paris" -> "Europe/Paris" (else the path itself).
    def _name_from_path(path: str) -> str:
        mut i = path.last_index_of("zoneinfo/")
        if i >= 0: return path.slice(i + 9, path.len())
        return path

    # Names of all zones: from the zoneinfo directory when there is one
    # (files starting with the TZif magic, minus right/, posix/, posixrules
    # and localtime), else the embedded table. Sorted.
    pub def available() -> List[str]:
        mut root = Tz.zoneinfo_dir()
        if root.len() == 0: return tz_embedded_names()
        mut out: List[str] = []
        mut stack: List[str] = [""]
        while len(stack) > 0:
            mut rel = stack.pop()
            mut dpath = root
            if rel.len() > 0: dpath = root + "/" + rel
            mut d = Dir.init(dpath)
            mut ents = d.list()
            mut i = 0
            while i < ents.len:
                mut e = ents.get(i)
                i = i + 1
                mut key = e
                if rel.len() > 0: key = rel + "/" + e
                if rel.len() == 0 and (e == "right" or e == "posix" or e == "posixrules" or e == "localtime"): continue
                mut full = root + "/" + key
                if _tr_dir_exists(full):
                    stack.append(key)
                    continue
                mut data = File.read_text(full)
                if data.starts_with("TZif"): out.append(key)
        out.sort()
        return out

    # ── instant -> local ─────────────────────────────────────────────────────

    def _type(self, k: int) -> (int, bool, str):
        return (self._off[k], self._dst[k] != 0, self._abbr[k])

    def _rule_at(self, is_dst: bool) -> (int, bool, str):
        if is_dst: return (self._rule.dst_off, true, self._rule.dst_abbr)
        return (self._rule.std_off, false, self._rule.std_abbr)

    # (offset seconds east of UTC, DST?, abbreviation) at a UTC instant.
    pub def offset_at(self, ts: int) -> (int, bool, str):
        mut n = len(self._trans)
        if n > 0 and ts < self._trans[0]: return self._type(self._before)
        if n == 0 or ts > self._trans[n - 1]:
            if self._has_rule: return self._rule_at(self._rule.is_dst_utc(ts))
            return self._type(self._after)
        # bisect_right
        mut lo = 0
        mut hi = n
        while lo < hi:
            mut mid = (lo + hi) / 2
            if self._trans[mid] <= ts: lo = mid + 1
            else: hi = mid
        return self._type(self._tidx[lo - 1])

    # The offset at `ts` as a std.sys.datetime TimeZone (name = abbreviation,
    # zone = this zone's name).
    pub def zone_at(self, ts: int) -> TimeZone:
        mut off, dst, abbr = self.offset_at(ts)
        mut z = TimeZone.fixed(0, 0)
        z.offset_seconds = off
        z.is_dst = dst
        z.name = abbr
        z.zone = self.name
        return z

    pub def utc_offset_at(self, ts: int) -> int:
        mut off, dst, abbr = self.offset_at(ts)
        return off

    pub def is_dst_at(self, ts: int) -> bool:
        mut off, dst, abbr = self.offset_at(ts)
        return dst

    pub def abbr_at(self, ts: int) -> str:
        mut off, dst, abbr = self.offset_at(ts)
        return abbr

    # Wall-clock DateTime of a UTC instant in this zone (its .tz carries the
    # offset, DST flag and abbreviation in force then).
    pub def to_local(self, ts: int) -> DateTime:
        return DateTime.from_timestamp_utc(ts).to_zone(self.zone_at(ts))

    # The same instant as `dt` (any zone), on this zone's clock.
    pub def convert(self, dt: DateTime) -> DateTime:
        return self.to_local(dt.timestamp())

    # `dt` moved by an exact duration, re-resolved in this zone (crossing a
    # DST change updates the offset, unlike DateTime.add).
    pub def add(self, dt: DateTime, delta: TimeDelta) -> DateTime:
        return self.to_local(dt.timestamp() + delta.total_seconds())

    # The current time in this zone.
    pub def now(self) -> DateTime:
        return self.convert(DateTime.utc_now())

    # ── local -> instant ─────────────────────────────────────────────────────

    def _wall(self, fold: int, k: int) -> int:
        if fold == 1: return self._wall1[k]
        return self._wall0[k]

    # Offset for naive local seconds `wall`; fold 0 takes the offset before a
    # transition, fold 1 the one after.
    def _local_off(self, wall: int, fold: int) -> int:
        mut n = len(self._trans)
        if n > 0 and wall < self._wall(fold, 0): return self._off[self._before]
        if n == 0 or wall > self._wall(fold, n - 1):
            if self._has_rule:
                if self._rule.is_dst_local(wall, fold): return self._rule.dst_off
                return self._rule.std_off
            return self._off[self._after]
        mut lo = 0
        mut hi = n
        while lo < hi:
            mut mid = (lo + hi) / 2
            if self._wall(fold, mid) <= wall: lo = mid + 1
            else: hi = mid
        return self._off[self._tidx[lo - 1]]

    # Whether a wall-clock time occurs once, twice (TZ_LOCAL_AMBIGUOUS) or
    # never (TZ_LOCAL_NONEXISTENT) in this zone.
    pub def classify_local(self, y: int, m: int, d: int, h: int, mi: int, s: int) -> int:
        mut wall = _tz_days(y, m, d) * 86400 + h * 3600 + mi * 60 + s
        mut o0 = self._local_off(wall, 0)
        mut o1 = self._local_off(wall, 1)
        if o0 == o1: return TZ_LOCAL_UNIQUE
        if o0 > o1: return TZ_LOCAL_AMBIGUOUS
        return TZ_LOCAL_NONEXISTENT

    # UTC instant of a wall-clock time, resolving gaps/overlaps by `policy`.
    pub def local_to_unix(self, y: int, m: int, d: int, h: int, mi: int, s: int, policy: int) throws str -> int:
        mut wall = _tz_days(y, m, d) * 86400 + h * 3600 + mi * 60 + s
        mut o0 = self._local_off(wall, 0)
        mut o1 = self._local_off(wall, 1)
        if o0 == o1: return wall - o0
        if policy == TZ_RAISE:
            mut when = DateTime.from_timestamp_utc(wall).to_string()
            if o0 > o1: raise(f"{when} is ambiguous in {self.name} (occurs twice)")
            raise(f"{when} does not exist in {self.name} (skipped by a transition)")
        if policy == TZ_LATER: return wall - o1
        return wall - o0

    # DateTime for a wall-clock time; gaps/overlaps use TZ_EARLIER (Python's
    # fold=0). A time inside a gap comes back normalized (02:30 on a
    # spring-forward night -> 03:30).
    pub def from_local(self, y: int, m: int, d: int, h: int, mi: int, s: int) -> DateTime:
        mut wall = _tz_days(y, m, d) * 86400 + h * 3600 + mi * 60 + s
        return self.to_local(wall - self._local_off(wall, 0))

    # DateTime for a wall-clock time; gaps/overlaps use TZ_LATER (Python's
    # fold=1): the second occurrence of a repeated time, and a skipped time
    # pushed backward (02:30 on a spring-forward night -> 01:30).
    pub def from_local_later(self, y: int, m: int, d: int, h: int, mi: int, s: int) -> DateTime:
        mut wall = _tz_days(y, m, d) * 86400 + h * 3600 + mi * 60 + s
        return self.to_local(wall - self._local_off(wall, 1))

    # ── transitions ─────────────────────────────────────────────────────────

    # First instant > ts at which the offset, DST flag or abbreviation
    # changes; -1 if none within 400 years.
    pub def next_transition(self, ts: int) -> int:
        mut o, d, a = self.offset_at(ts)
        mut n = len(self._trans)
        mut k = 0
        while k < n:
            mut t = self._trans[k]
            if t > ts:
                mut o2, d2, a2 = self.offset_at(t)
                if o2 != o or d2 != d or a2 != a: return t
            k = k + 1
        if not self._has_rule: return -1
        mut base = ts
        if n > 0 and self._trans[n - 1] > base: base = self._trans[n - 1]
        mut y = _tz_year_of(base) - 1
        mut stop = y + 400
        while y < stop:
            mut st, en = self._rule.transitions(y)
            mut first = st
            mut second = en
            if en < st:
                first = en
                second = st
            if first > base and first > ts: return first
            if second > base and second > ts: return second
            y = y + 1
        return -1

    pub def to_string(self) -> str:
        return self.name
