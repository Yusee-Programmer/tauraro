# std.math.rational -- exact fractions of arbitrary-precision integers.
#
# A `Rational` is num/den in lowest terms with den > 0. Arithmetic is exact
# (1/3 + 1/6 == 1/2); use it where rounding must never happen: probabilities,
# unit conversions, exact geometry, parsing "3/4" or "0.125" losslessly.
#
# Usage:
#   from std.math.rational import Rational
#   mut a = Rational.parse("1/3")?
#   mut b = Rational.parse("0.5")?               # 1/2
#   mut c = a.add(b)                             # 5/6
#   c.to_str()                                   # "5/6"
#   c.to_decimal_str(4)                          # "0.8333"
#   Rational.from_float_str("3.14159").limit_denominator(1000)   # 355/113

from std.math.bigint import BigInt
from std.math.decimal import Decimal, ROUND_HALF_EVEN, ROUND_FLOOR, ROUND_CEILING, ROUND_DOWN, _dc_round_div, _dc_pow10

def _rt_gcd(a: BigInt, b: BigInt) -> BigInt:
    mut x = a.abs()
    mut y = b.abs()
    while not y.is_zero():
        mut t = x.rem(y)
        x = y
        y = t
    return x

pub class Rational:
    pub num: BigInt
    pub den: BigInt

extend Rational:
    # num/den normalized (raises when den is zero).
    pub def make(num: BigInt, den: BigInt) throws str -> Rational:
        if den.is_zero(): raise("Rational: zero denominator")
        return Rational._norm(num, den)

    def _norm(num: BigInt, den: BigInt) -> Rational:
        mut n = num
        mut d = den
        if d.is_negative():
            n = n.negate()
            d = d.negate()
        mut g = _rt_gcd(n, d)
        if not g.is_zero() and not (g.cmp(BigInt.from_int(1)) == 0):
            n = n.div(g)
            d = d.div(g)
        if n.is_zero(): d = BigInt.from_int(1)
        mut r = Rational()
        r.num = n
        r.den = d
        return r

    pub def from_int(n: int) -> Rational:
        mut r = Rational()
        r.num = BigInt.from_int(n)
        r.den = BigInt.from_int(1)
        return r

    pub def of(n: int, d: int) throws str -> Rational:
        return Rational.make(BigInt.from_int(n), BigInt.from_int(d))?

    pub def zero() -> Rational: return Rational.from_int(0)
    pub def one() -> Rational: return Rational.from_int(1)

    # Exact value of a Decimal.
    pub def from_decimal(d: Decimal) -> Rational:
        if d.exp >= 0: return Rational._norm(d.coef.mul(_dc_pow10(d.exp)), BigInt.from_int(1))
        return Rational._norm(d.coef, _dc_pow10(0 - d.exp))

    # Parse "3/4", "-7", "0.125", "1.5e-3" (decimal forms are exact).
    pub def parse(text: str) throws str -> Rational:
        mut s = text.trim()
        mut slash = s.find("/")
        if slash >= 0:
            mut a = s.slice(0, slash).trim()
            mut b = s.slice(slash + 1, s.len()).trim()
            mut na = Decimal.parse(a)?
            mut nb = Decimal.parse(b)?
            mut ra = Rational.from_decimal(na)
            mut rb = Rational.from_decimal(nb)
            return ra.div(rb)?
        mut d = Decimal.parse(s)?
        return Rational.from_decimal(d)

    # Exact value of a decimal string written for a float (e.g. "%.17g" output).
    pub def from_float_str(text: str) -> Rational:
        mut r: Result[Rational, str] = Rational.parse(text)
        if r.is_err: return Rational.zero()
        return r.ok

    pub def add(self, o: Rational) -> Rational:
        return Rational._norm(self.num.mul(o.den).add(o.num.mul(self.den)), self.den.mul(o.den))

    pub def sub(self, o: Rational) -> Rational:
        return Rational._norm(self.num.mul(o.den).sub(o.num.mul(self.den)), self.den.mul(o.den))

    pub def mul(self, o: Rational) -> Rational:
        return Rational._norm(self.num.mul(o.num), self.den.mul(o.den))

    pub def div(self, o: Rational) throws str -> Rational:
        if o.num.is_zero(): raise("Rational: division by zero")
        return Rational._norm(self.num.mul(o.den), self.den.mul(o.num))

    pub def neg(self) -> Rational:
        mut r = Rational()
        r.num = self.num.negate()
        r.den = self.den
        return r

    pub def abs(self) -> Rational:
        mut r = Rational()
        r.num = self.num.abs()
        r.den = self.den
        return r

    # 1 / self.
    pub def inv(self) throws str -> Rational:
        if self.num.is_zero(): raise("Rational: inverse of zero")
        return Rational._norm(self.den, self.num)

    # self^n for any integer n (negative n inverts).
    pub def pow(self, n: int) throws str -> Rational:
        if n == 0: return Rational.one()
        if n > 0: return Rational._norm(self.num.pow(n), self.den.pow(n))
        if self.num.is_zero(): raise("Rational: zero to a negative power")
        return Rational._norm(self.den.pow(0 - n), self.num.pow(0 - n))

    pub def cmp(self, o: Rational) -> int:
        return self.num.mul(o.den).cmp(o.num.mul(self.den))

    pub def eq(self, o: Rational) -> bool: return self.cmp(o) == 0
    pub def lt(self, o: Rational) -> bool: return self.cmp(o) < 0
    pub def gt(self, o: Rational) -> bool: return self.cmp(o) > 0
    pub def le(self, o: Rational) -> bool: return self.cmp(o) <= 0
    pub def ge(self, o: Rational) -> bool: return self.cmp(o) >= 0

    pub def is_zero(self) -> bool: return self.num.is_zero()
    pub def is_integer(self) -> bool: return self.den.cmp(BigInt.from_int(1)) == 0

    pub def sign(self) -> int:
        if self.num.is_zero(): return 0
        if self.num.is_negative(): return -1
        return 1

    # Integer part toward -infinity / +infinity / nearest (ties to even).
    pub def floor(self) -> BigInt: return _dc_round_div(self.num, self.den, ROUND_FLOOR)
    pub def ceil(self) -> BigInt: return _dc_round_div(self.num, self.den, ROUND_CEILING)
    pub def round(self) -> BigInt: return _dc_round_div(self.num, self.den, ROUND_HALF_EVEN)
    pub def trunc(self) -> BigInt: return _dc_round_div(self.num, self.den, ROUND_DOWN)

    # Fractional part, self - floor(self), in [0, 1).
    pub def frac(self) -> Rational:
        mut f = Rational._norm(self.floor(), BigInt.from_int(1))
        return self.sub(f)

    # Rounded to `places` decimals as a Decimal.
    pub def to_decimal(self, places: int, mode: int) -> Decimal:
        mut n = self.num.mul(_dc_pow10(places))
        return Decimal.make(_dc_round_div(n, self.den, mode), 0 - places)

    pub def to_decimal_str(self, places: int) -> str:
        mut d = self.to_decimal(places, ROUND_HALF_EVEN)
        return d.to_str()

    pub def to_float(self) -> float:
        mut d = self.to_decimal(20, ROUND_HALF_EVEN).round_sig(18, ROUND_HALF_EVEN)
        return d.to_float()

    # "n/d", or "n" for integers.
    pub def to_str(self) -> str:
        mut ns = self.num.to_str()
        if self.is_integer(): return ns
        mut ds = self.den.to_str()
        return ns + "/" + ds

    pub def __str__(self) -> str: return self.to_str()

    # The closest fraction with denominator <= max_den (continued fractions,
    # same result as Python's Fraction.limit_denominator).
    pub def limit_denominator(self, max_den: int) -> Rational:
        mut md = BigInt.from_int(max_den)
        if self.den.cmp(md) <= 0: return self
        mut p0 = BigInt.from_int(0)
        mut q0 = BigInt.from_int(1)
        mut p1 = BigInt.from_int(1)
        mut q1 = BigInt.from_int(0)
        mut n = self.num
        mut d = self.den
        while true:
            mut a = _dc_round_div(n, d, ROUND_FLOOR)
            mut q2 = q0.add(a.mul(q1))
            if q2.cmp(md) > 0: break
            mut np0 = p1
            mut nq0 = q1
            p1 = p0.add(a.mul(p1))
            q1 = q2
            p0 = np0
            q0 = nq0
            mut nn = d
            d = n.sub(a.mul(d))
            n = nn
            if d.is_zero(): break
        # candidates: p1/q1 and the semiconvergent
        mut k = _dc_round_div(md.sub(q0), q1, ROUND_FLOOR)
        mut b1 = Rational._norm(p0.add(k.mul(p1)), q0.add(k.mul(q1)))
        mut b2 = Rational._norm(p1, q1)
        mut d1 = b1.sub(self).abs()
        mut d2 = b2.sub(self).abs()
        if d2.cmp(d1) <= 0: return b2
        return b1
