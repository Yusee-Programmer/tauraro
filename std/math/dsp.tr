# std.math.dsp -- signal processing on top of std.math.fft.
#
# Signals are List[float]; complex spectra are interleaved (re, im) like
# std.math.fft. Semantics follow NumPy / SciPy where a counterpart exists.
#
#   windows        hann hamming blackman blackman_harris flattop kaiser tukey
#                  boxcar general_cosine get_window (sym=true: filter design,
#                  sym=false: periodic, for spectral analysis)
#   convolution    convolve / correlate ("full" | "same" | "valid", NumPy
#                  conventions); FFT for long inputs, direct for short kernels
#   filtering      lfilter, lfilter_zi, filtfilt (zero phase), freqz
#   FIR design     firwin (windowed sinc), fir_lowpass/highpass/bandpass/bandstop
#   IIR biquads    Biquad.lowpass/highpass/bandpass/notch/peaking/lowshelf/
#                  highshelf/allpass (RBJ Audio EQ Cookbook); filter, filtfilt,
#                  streaming process, response
#   spectra        stft / istft, spectrogram (magnitude | power | db, ->Tensor),
#                  welch PSD, goertzel
#   misc           resample_poly (polyphase, Kaiser FIR like SciPy), find_peaks,
#                  peak_prominences
#
# Usage:
#   from std.math.dsp import hann, stft, istft, Biquad, firwin, convolve
#   mut bq = Biquad.lowpass(48000.0, 1000.0, 0.7071)
#   mut y = bq.filter(x)
#   mut taps = firwin(101, [3000.0], true, 48000.0, "hamming")?
#   mut z = convolve(x, taps, "same")?
#   mut s = stft(x, hann(512, false), 128, 512, true)?
#   mut back = istft(s, len(x))?

from std.math.fft import fft_zeros, trc_dsp_convolve, trc_dsp_lfilter, trc_dsp_lfilter_zi, trc_dsp_filtfilt
from std.math.fft import trc_dsp_goertzel, trc_dsp_stft, trc_dsp_istft, trc_dsp_welch, rfftfreq
from std.math.tensor import Tensor

extern "C":
    def sin(x: float) -> float
    def cos(x: float) -> float
    def sqrt(x: float) -> float
    def pow(base: float, exp: float) -> float
    def log10(x: float) -> float
    def fabs(x: float) -> float
    def floor(x: float) -> float
    def ceil(x: float) -> float
    def tan(x: float) -> float

const _DSP_PI = 3.141592653589793

# ── windows ─────────────────────────────────────────────────────────────────

# sum_k (-1)^k a_k cos(2 pi k i / (M-1)); sym=false gives the periodic
# variant (computed for n+1 points, last dropped) used for spectral analysis.
pub def general_cosine(n: int, a: List[float], sym: bool) -> List[float]:
    mut out = fft_zeros(n)
    if n <= 0: return out
    if n == 1:
        out[0] = 1.0
        return out
    mut m = n
    if not sym: m = n + 1
    mut i = 0
    while i < n:
        mut x = 2.0 * _DSP_PI * (i as float) / ((m - 1) as float)
        mut v = 0.0
        mut k = 0
        mut sgn = 1.0
        while k < len(a):
            v = v + sgn * a[k] * cos((k as float) * x)
            sgn = 0.0 - sgn
            k = k + 1
        out[i] = v
        i = i + 1
    return out

pub def hann(n: int, sym: bool) -> List[float]:
    mut a: List[float] = [0.5, 0.5]
    return general_cosine(n, a, sym)

pub def hamming(n: int, sym: bool) -> List[float]:
    mut a: List[float] = [0.54, 0.46]
    return general_cosine(n, a, sym)

pub def blackman(n: int, sym: bool) -> List[float]:
    mut a: List[float] = [0.42, 0.5, 0.08]
    return general_cosine(n, a, sym)

# 4-term Blackman-Harris (-92 dB side lobes).
pub def blackman_harris(n: int, sym: bool) -> List[float]:
    mut a: List[float] = [0.35875, 0.48829, 0.14128, 0.01168]
    return general_cosine(n, a, sym)

# Flat-top (SciPy coefficients): accurate amplitudes of sinusoids.
pub def flattop(n: int, sym: bool) -> List[float]:
    mut a: List[float] = [0.21557895, 0.41663158, 0.277263158, 0.083578947, 0.006947368]
    return general_cosine(n, a, sym)

pub def boxcar(n: int) -> List[float]:
    mut out = fft_zeros(n)
    mut i = 0
    while i < n:
        out[i] = 1.0
        i = i + 1
    return out

# Modified Bessel function of the first kind, order 0 (power series).
pub def bessel_i0(x: float) -> float:
    mut s = 1.0
    mut term = 1.0
    mut q = x * x / 4.0
    mut k = 1
    while k < 500:
        term = term * q / ((k * k) as float)
        s = s + term
        if term < s * 0.00000000000000001: return s
        k = k + 1
    return s

pub def kaiser(n: int, beta: float, sym: bool) -> List[float]:
    mut out = fft_zeros(n)
    if n <= 0: return out
    if n == 1:
        out[0] = 1.0
        return out
    mut m = n
    if not sym: m = n + 1
    mut alpha = ((m - 1) as float) / 2.0
    mut den = bessel_i0(beta)
    mut i = 0
    while i < n:
        mut r = ((i as float) - alpha) / alpha
        mut t = 1.0 - r * r
        if t < 0.0: t = 0.0
        out[i] = bessel_i0(beta * sqrt(t)) / den
        i = i + 1
    return out

# Tapered cosine: alpha = 0 is a boxcar, alpha = 1 a Hann window.
pub def tukey(n: int, alpha: float, sym: bool) -> List[float]:
    if n <= 0: return fft_zeros(0)
    if alpha <= 0.0: return boxcar(n)
    if alpha >= 1.0: return hann(n, sym)
    if n == 1: return boxcar(1)
    mut m = n
    if not sym: m = n + 1
    mut out = fft_zeros(n)
    mut width = floor(alpha * ((m - 1) as float) / 2.0) as int
    mut i = 0
    while i < n:
        mut fi = i as float
        mut fm = (m - 1) as float
        if i <= width:
            out[i] = 0.5 * (1.0 + cos(_DSP_PI * (-1.0 + 2.0 * fi / alpha / fm)))
        elif i < m - width - 1:
            out[i] = 1.0
        else:
            out[i] = 0.5 * (1.0 + cos(_DSP_PI * (-2.0 / alpha + 1.0 + 2.0 * fi / alpha / fm)))
        i = i + 1
    return out

# Window by name: boxcar (rect), hann, hamming, blackman, blackmanharris,
# flattop. (kaiser and tukey take a parameter: call them directly.)
pub def get_window(name: str, n: int, sym: bool) throws str -> List[float]:
    if name == "hann" or name == "hanning": return hann(n, sym)
    if name == "hamming": return hamming(n, sym)
    if name == "blackman": return blackman(n, sym)
    if name == "blackmanharris" or name == "blackman_harris": return blackman_harris(n, sym)
    if name == "flattop": return flattop(n, sym)
    if name == "boxcar" or name == "rect" or name == "rectangular": return boxcar(n)
    raise(f"get_window: unknown window '{name}'")

# ── convolution ─────────────────────────────────────────────────────────────

def _conv_full(a: List[float], b: List[float], method: int) throws str -> List[float]:
    if len(a) == 0 or len(b) == 0: raise("convolve: inputs must not be empty")
    mut out = fft_zeros(len(a) + len(b) - 1)
    mut ap = a as Pointer[float]
    mut bp = b as Pointer[float]
    mut op = out as Pointer[float]
    if trc_dsp_convolve(ap, len(a), bp, len(b), op, method) < 0: raise("convolve: out of memory")
    return out

def _conv_mode(full: List[float], la: int, lb: int, mode: str) throws str -> List[float]:
    if mode == "full": return full
    mut big = la
    mut small = lb
    if lb > la:
        big = lb
        small = la
    mut start = 0
    mut n = 0
    if mode == "same":
        start = (small - 1) / 2
        n = big
    elif mode == "valid":
        start = small - 1
        n = big - small + 1
    else:
        raise(f"convolve: unknown mode '{mode}' (use full, same or valid)")
    mut out = fft_zeros(n)
    mut i = 0
    while i < n:
        out[i] = full[start + i]
        i = i + 1
    return out

# Linear convolution with an explicit method: "auto", "direct" or "fft".
pub def convolve_method(a: List[float], b: List[float], mode: str, method: str) throws str -> List[float]:
    mut m = 0
    if method == "direct": m = 1
    elif method == "fft": m = 2
    elif method != "auto": raise(f"convolve: unknown method '{method}' (use auto, direct or fft)")
    mut full = _conv_full(a, b, m)?
    return _conv_mode(full, len(a), len(b), mode)?

# Linear convolution (numpy.convolve modes). FFT-based when that is cheaper.
pub def convolve(a: List[float], b: List[float], mode: str) throws str -> List[float]:
    return convolve_method(a, b, mode, "auto")?

pub def reversed_floats(x: List[float]) -> List[float]:
    mut out = fft_zeros(len(x))
    mut i = 0
    while i < len(x):
        out[i] = x[len(x) - 1 - i]
        i = i + 1
    return out

# Cross-correlation c[k] = sum_n a[n+k] v[n] (numpy.correlate for real data
# with len(a) >= len(v)); computed as convolve(a, reversed(v)).
pub def correlate(a: List[float], v: List[float], mode: str) throws str -> List[float]:
    return convolve(a, reversed_floats(v), mode)?

# ── IIR / FIR filtering ─────────────────────────────────────────────────────

def _state_len(b: List[float], a: List[float]) -> int:
    mut m = len(b)
    if len(a) > m: m = len(a)
    return m - 1

# Filter x with the rational transfer function b(z)/a(z) (scipy.signal.lfilter,
# zero initial state).
pub def lfilter(b: List[float], a: List[float], x: List[float]) throws str -> List[float]:
    mut zi = fft_zeros(_state_len(b, a) + 1)
    mut r = lfilter_state(b, a, x, zi)?
    return r

# lfilter with an explicit state `zi` (max(len(a),len(b))-1 values, plus
# slack is fine); zi is updated in place to the final state, so successive
# blocks can be filtered as one stream.
pub def lfilter_state(b: List[float], a: List[float], x: List[float], zi: List[float]) throws str -> List[float]:
    if len(b) == 0 or len(a) == 0: raise("lfilter: b and a must not be empty")
    if a[0] == 0.0: raise("lfilter: a[0] must be nonzero")
    if len(zi) < _state_len(b, a): raise("lfilter: zi is too short")
    mut y = fft_zeros(len(x))
    if len(x) == 0: return y
    mut bp = b as Pointer[float]
    mut ap = a as Pointer[float]
    mut xp = x as Pointer[float]
    mut zp = zi as Pointer[float]
    mut yp = y as Pointer[float]
    if trc_dsp_lfilter(bp, len(b), ap, len(a), xp, len(x), zp, yp) != 0: raise("lfilter: out of memory")
    return y

# Steady-state state for a unit-step input (scipy.signal.lfilter_zi).
pub def lfilter_zi(b: List[float], a: List[float]) throws str -> List[float]:
    if len(b) == 0 or len(a) == 0: raise("lfilter_zi: b and a must not be empty")
    if a[0] == 0.0: raise("lfilter_zi: a[0] must be nonzero")
    mut zi = fft_zeros(_state_len(b, a) + 1)
    mut bp = b as Pointer[float]
    mut ap = a as Pointer[float]
    mut zp = zi as Pointer[float]
    if trc_dsp_lfilter_zi(bp, len(b), ap, len(a), zp) != 0: raise("lfilter_zi: singular system (pole at z = 1?)")
    mut out = fft_zeros(_state_len(b, a))
    mut i = 0
    while i < len(out):
        out[i] = zi[i]
        i = i + 1
    return out

# Zero-phase forward-backward filtering with odd extension of `padlen`
# samples at each end (scipy.signal.filtfilt, padtype="odd").
pub def filtfilt_pad(b: List[float], a: List[float], x: List[float], padlen: int) throws str -> List[float]:
    if len(b) == 0 or len(a) == 0: raise("filtfilt: b and a must not be empty")
    if a[0] == 0.0: raise("filtfilt: a[0] must be nonzero")
    if len(x) <= padlen: raise(f"filtfilt: the signal must be longer than padlen ({padlen})")
    mut y = fft_zeros(len(x))
    mut bp = b as Pointer[float]
    mut ap = a as Pointer[float]
    mut xp = x as Pointer[float]
    mut yp = y as Pointer[float]
    if trc_dsp_filtfilt(bp, len(b), ap, len(a), xp, len(x), padlen, yp) != 0: raise("filtfilt: filter failed (singular initial-state system)")
    return y

# filtfilt with SciPy's default padlen = 3 * max(len(a), len(b)).
pub def filtfilt(b: List[float], a: List[float], x: List[float]) throws str -> List[float]:
    return filtfilt_pad(b, a, x, 3 * (_state_len(b, a) + 1))?

# Complex frequency response of b/a at `n` frequencies 0, fs/(2n), ...
# (scipy.signal.freqz(b, a, worN=n, fs=fs)).
pub class FreqResponse:
    pub freqs: List[float]
    pub h:     List[float]     # interleaved complex

extend FreqResponse:
    pub def magnitude(self) -> List[float]:
        mut n = len(self.freqs)
        mut out = fft_zeros(n)
        mut i = 0
        while i < n:
            out[i] = sqrt(self.h[2 * i] * self.h[2 * i] + self.h[2 * i + 1] * self.h[2 * i + 1])
            i = i + 1
        return out

    pub def magnitude_db(self) -> List[float]:
        mut m = self.magnitude()
        mut i = 0
        while i < len(m):
            mut v = m[i]
            if v < 0.0000000001: v = 0.0000000001
            m[i] = 20.0 * log10(v)
            i = i + 1
        return m

def _poly_at(c: List[float], w: float) -> List[float]:
    # sum c_k e^{-i w k}
    mut re = 0.0
    mut im = 0.0
    mut k = 0
    while k < len(c):
        re = re + c[k] * cos(w * (k as float))
        im = im - c[k] * sin(w * (k as float))
        k = k + 1
    mut out: List[float] = [re, im]
    return out

# Complex response of b/a at one frequency.
pub def response_at(b: List[float], a: List[float], freq: float, fs: float) -> List[float]:
    mut w = 2.0 * _DSP_PI * freq / fs
    mut nb = _poly_at(b, w)
    mut da = _poly_at(a, w)
    mut den = da[0] * da[0] + da[1] * da[1]
    mut out: List[float] = [(nb[0] * da[0] + nb[1] * da[1]) / den, (nb[1] * da[0] - nb[0] * da[1]) / den]
    return out

pub def freqz(b: List[float], a: List[float], n: int, fs: float) -> FreqResponse:
    mut r = FreqResponse()
    r.freqs = fft_zeros(n)
    r.h = fft_zeros(2 * n)
    mut i = 0
    while i < n:
        mut f = (i as float) * fs / (2.0 * (n as float))
        r.freqs[i] = f
        mut v = response_at(b, a, f, fs)
        r.h[2 * i] = v[0]
        r.h[2 * i + 1] = v[1]
        i = i + 1
    return r

# ── FIR design ──────────────────────────────────────────────────────────────

def _sinc(x: float) -> float:
    if x == 0.0: return 1.0
    mut y = _DSP_PI * x
    return sin(y) / y

# Windowed-sinc FIR (scipy.signal.firwin with scale=True). cutoffs in Hz,
# increasing, between 0 and fs/2. pass_zero=true: the band at DC passes
# (lowpass / bandstop); false: highpass / bandpass. A filter that passes
# Nyquist needs an odd tap count. `win` is the (symmetric) window.
pub def firwin_window(numtaps: int, cutoffs: List[float], pass_zero: bool, fs: float, win: List[float]) throws str -> List[float]:
    if numtaps < 1: raise("firwin: numtaps must be positive")
    if len(cutoffs) == 0: raise("firwin: at least one cutoff is required")
    if len(win) != numtaps: raise("firwin: window length must equal numtaps")
    mut nyq = fs / 2.0
    mut edges: List[float] = []
    if pass_zero: edges.append(0.0)
    mut i = 0
    while i < len(cutoffs):
        mut c = cutoffs[i] / nyq
        if c <= 0.0 or c >= 1.0: raise("firwin: cutoffs must lie strictly between 0 and fs/2")
        if i > 0 and cutoffs[i] <= cutoffs[i - 1]: raise("firwin: cutoffs must be increasing")
        edges.append(c)
        i = i + 1
    mut odd_count = len(cutoffs) % 2 == 1
    mut pass_nyquist = odd_count != pass_zero
    if pass_nyquist:
        if numtaps % 2 == 0: raise("firwin: a filter with a passband at Nyquist needs an odd number of taps")
        edges.append(1.0)
    mut alpha = 0.5 * ((numtaps - 1) as float)
    mut h = fft_zeros(numtaps)
    mut n = 0
    while n < numtaps:
        mut m = (n as float) - alpha
        mut v = 0.0
        mut k = 0
        while k + 1 < len(edges):
            mut left = edges[k]
            mut right = edges[k + 1]
            v = v + right * _sinc(right * m) - left * _sinc(left * m)
            k = k + 2
        h[n] = v * win[n]
        n = n + 1
    # unit gain at the centre of the first passband
    mut sf = 0.0
    if edges[0] == 0.0: sf = 0.0
    elif edges[1] == 1.0: sf = 1.0
    else: sf = 0.5 * (edges[0] + edges[1])
    mut s = 0.0
    n = 0
    while n < numtaps:
        s = s + h[n] * cos(_DSP_PI * ((n as float) - alpha) * sf)
        n = n + 1
    n = 0
    while n < numtaps:
        h[n] = h[n] / s
        n = n + 1
    return h

# firwin with a named window ("hamming" is SciPy's default).
pub def firwin(numtaps: int, cutoffs: List[float], pass_zero: bool, fs: float, window: str) throws str -> List[float]:
    mut w = get_window(window, numtaps, true)?
    return firwin_window(numtaps, cutoffs, pass_zero, fs, w)?

pub def fir_lowpass(numtaps: int, cutoff: float, fs: float) throws str -> List[float]:
    mut c: List[float] = [cutoff]
    return firwin(numtaps, c, true, fs, "hamming")?

pub def fir_highpass(numtaps: int, cutoff: float, fs: float) throws str -> List[float]:
    mut c: List[float] = [cutoff]
    return firwin(numtaps, c, false, fs, "hamming")?

pub def fir_bandpass(numtaps: int, low: float, high: float, fs: float) throws str -> List[float]:
    mut c: List[float] = [low, high]
    return firwin(numtaps, c, false, fs, "hamming")?

pub def fir_bandstop(numtaps: int, low: float, high: float, fs: float) throws str -> List[float]:
    mut c: List[float] = [low, high]
    return firwin(numtaps, c, true, fs, "hamming")?

# ── RBJ biquads ─────────────────────────────────────────────────────────────

# Second-order section y = (b0 + b1 z^-1 + b2 z^-2) / (1 + a1 z^-1 + a2 z^-2) x,
# coefficients from Robert Bristow-Johnson's Audio EQ Cookbook (Q form).
# z1 / z2 hold the streaming state used by process().
pub class Biquad:
    pub b0: float
    pub b1: float
    pub b2: float
    pub a1: float
    pub a2: float
    pub z1: float
    pub z2: float

def _bq(b0: float, b1: float, b2: float, a0: float, a1: float, a2: float) -> Biquad:
    mut q = Biquad()
    q.b0 = b0 / a0
    q.b1 = b1 / a0
    q.b2 = b2 / a0
    q.a1 = a1 / a0
    q.a2 = a2 / a0
    q.z1 = 0.0
    q.z2 = 0.0
    return q

def _w0(fs: float, f0: float) -> float: return 2.0 * _DSP_PI * f0 / fs

extend Biquad:
    pub def from_coeffs(b0: float, b1: float, b2: float, a0: float, a1: float, a2: float) -> Biquad:
        return _bq(b0, b1, b2, a0, a1, a2)

    pub def lowpass(fs: float, f0: float, q: float) -> Biquad:
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        return _bq((1.0 - c) / 2.0, 1.0 - c, (1.0 - c) / 2.0, 1.0 + al, -2.0 * c, 1.0 - al)

    pub def highpass(fs: float, f0: float, q: float) -> Biquad:
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        return _bq((1.0 + c) / 2.0, 0.0 - (1.0 + c), (1.0 + c) / 2.0, 1.0 + al, -2.0 * c, 1.0 - al)

    # Band-pass with 0 dB peak gain.
    pub def bandpass(fs: float, f0: float, q: float) -> Biquad:
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        return _bq(al, 0.0, 0.0 - al, 1.0 + al, -2.0 * c, 1.0 - al)

    pub def notch(fs: float, f0: float, q: float) -> Biquad:
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        return _bq(1.0, -2.0 * c, 1.0, 1.0 + al, -2.0 * c, 1.0 - al)

    pub def allpass(fs: float, f0: float, q: float) -> Biquad:
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        return _bq(1.0 - al, -2.0 * c, 1.0 + al, 1.0 + al, -2.0 * c, 1.0 - al)

    # Peaking EQ: gain_db at f0, bandwidth set by q.
    pub def peaking(fs: float, f0: float, q: float, gain_db: float) -> Biquad:
        mut A = pow(10.0, gain_db / 40.0)
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        return _bq(1.0 + al * A, -2.0 * c, 1.0 - al * A, 1.0 + al / A, -2.0 * c, 1.0 - al / A)

    pub def lowshelf(fs: float, f0: float, q: float, gain_db: float) -> Biquad:
        mut A = pow(10.0, gain_db / 40.0)
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        mut sa = 2.0 * sqrt(A) * al
        return _bq(A * ((A + 1.0) - (A - 1.0) * c + sa), 2.0 * A * ((A - 1.0) - (A + 1.0) * c), A * ((A + 1.0) - (A - 1.0) * c - sa), (A + 1.0) + (A - 1.0) * c + sa, -2.0 * ((A - 1.0) + (A + 1.0) * c), (A + 1.0) + (A - 1.0) * c - sa)

    pub def highshelf(fs: float, f0: float, q: float, gain_db: float) -> Biquad:
        mut A = pow(10.0, gain_db / 40.0)
        mut w = _w0(fs, f0)
        mut c = cos(w)
        mut al = sin(w) / (2.0 * q)
        mut sa = 2.0 * sqrt(A) * al
        return _bq(A * ((A + 1.0) + (A - 1.0) * c + sa), -2.0 * A * ((A - 1.0) + (A + 1.0) * c), A * ((A + 1.0) + (A - 1.0) * c - sa), (A + 1.0) - (A - 1.0) * c + sa, 2.0 * ((A - 1.0) - (A + 1.0) * c), (A + 1.0) - (A - 1.0) * c - sa)

    # Numerator / denominator for lfilter / filtfilt / freqz.
    pub def coeffs_b(self) -> List[float]:
        mut out: List[float] = [self.b0, self.b1, self.b2]
        return out

    pub def coeffs_a(self) -> List[float]:
        mut out: List[float] = [1.0, self.a1, self.a2]
        return out

    # Filter a whole signal from zero state (does not touch the streaming state).
    pub def filter(self, x: List[float]) -> List[float]:
        mut b = self.coeffs_b()
        mut a = self.coeffs_a()
        mut r: Result[List[float], str] = lfilter(b, a, x)
        return r.ok

    # Zero-phase (forward-backward) filtering; the signal must be longer than 9 samples.
    pub def filtfilt(self, x: List[float]) throws str -> List[float]:
        mut b = self.coeffs_b()
        mut a = self.coeffs_a()
        return filtfilt(b, a, x)?

    # Streaming: filter one block, carrying state between calls.
    pub def process(self, x: List[float]) -> List[float]:
        mut y = fft_zeros(len(x))
        mut z1 = self.z1
        mut z2 = self.z2
        mut i = 0
        while i < len(x):
            mut xi = x[i]
            mut yi = self.b0 * xi + z1
            z1 = self.b1 * xi + z2 - self.a1 * yi
            z2 = self.b2 * xi - self.a2 * yi
            y[i] = yi
            i = i + 1
        self.z1 = z1
        self.z2 = z2
        return y

    pub def reset(self):
        self.z1 = 0.0
        self.z2 = 0.0

    # |H(f)| and |H(f)| in dB.
    pub def magnitude_at(self, freq: float, fs: float) -> float:
        mut v = response_at(self.coeffs_b(), self.coeffs_a(), freq, fs)
        return sqrt(v[0] * v[0] + v[1] * v[1])

    pub def gain_db_at(self, freq: float, fs: float) -> float:
        mut m = self.magnitude_at(freq, fs)
        if m < 0.0000000001: m = 0.0000000001
        return 20.0 * log10(m)

# ── STFT / spectrogram / Welch ──────────────────────────────────────────────

# Short-time Fourier transform: frames x bins complex values, row-major
# interleaved (frame t, bin k at data[2*(t*bins+k)]).
pub class Stft:
    pub frames: int
    pub bins:   int
    pub nfft:   int
    pub hop:    int
    pub pad:    int          # zeros added before the signal (center=true)
    pub window: List[float]
    pub data:   List[float]

extend Stft:
    # bin k of frame t as [re, im]
    pub def get(self, t: int, k: int) -> List[float]:
        mut i = 2 * (t * self.bins + k)
        mut out: List[float] = [self.data[i], self.data[i + 1]]
        return out

    # Centre time (seconds) of each frame.
    pub def times(self, fs: float) -> List[float]:
        mut out = fft_zeros(self.frames)
        mut t = 0
        while t < self.frames:
            out[t] = ((t * self.hop + len(self.window) / 2 - self.pad) as float) / fs
            t = t + 1
        return out

    pub def freqs(self, fs: float) -> List[float]: return rfftfreq(self.nfft, 1.0 / fs)

# STFT of x. Frame t starts at t*hop (minus len(window)/2 when center, with
# zeros outside the signal); each frame is windowed, zero-padded to nfft and
# real-FFT'd (unscaled). The last frame is padded so every sample is covered.
pub def stft(x: List[float], window: List[float], hop: int, nfft: int, center: bool) throws str -> Stft:
    mut nwin = len(window)
    if nwin < 1: raise("stft: window must not be empty")
    if hop < 1: raise("stft: hop must be positive")
    if nfft < nwin: raise("stft: nfft must be >= the window length")
    mut pad = 0
    if center: pad = nwin / 2
    mut total = len(x) + 2 * pad
    mut frames = 1
    if total > nwin: frames = 1 + (total - nwin + hop - 1) / hop
    mut s = Stft()
    s.frames = frames
    s.bins = nfft / 2 + 1
    s.nfft = nfft
    s.hop = hop
    s.pad = pad
    s.window = window.clone()
    s.data = fft_zeros(2 * frames * s.bins)
    mut xp = x as Pointer[float]
    mut wp = s.window as Pointer[float]
    mut op = s.data as Pointer[float]
    if trc_dsp_stft(xp, len(x), wp, nwin, hop, nfft, pad, frames, op) != 0: raise("stft: out of memory")
    return s

# Inverse STFT by weighted overlap-add; `length` output samples. Exact when
# the window satisfies the NOLA condition (e.g. Hann with hop <= nwin/2).
pub def istft(s: Stft, length: int) throws str -> List[float]:
    if len(s.data) != 2 * s.frames * s.bins: raise("istft: data size does not match frames x bins")
    mut out = fft_zeros(length)
    mut dp = s.data as Pointer[float]
    mut wp = s.window as Pointer[float]
    mut op = out as Pointer[float]
    if trc_dsp_istft(dp, s.frames, wp, len(s.window), s.hop, s.nfft, s.pad, op, length) != 0: raise("istft: out of memory")
    return out

# Real-valued time-frequency image: frames x bins, row-major.
pub class Spectrogram:
    pub frames: int
    pub bins:   int
    pub data:   List[float]
    pub times:  List[float]
    pub freqs:  List[float]

extend Spectrogram:
    pub def get(self, t: int, k: int) -> float: return self.data[t * self.bins + k]

    # Shape [frames, bins] tensor (std.math.tensor).
    pub def to_tensor(self) -> Tensor:
        mut sh: List[int] = [self.frames, self.bins]
        mut r: Result[Tensor, str] = Tensor.from_list(self.data, sh)
        return r.ok

# Spectrogram of x (no centring: frame t covers x[t*hop .. t*hop+nwin)).
# mode "magnitude" |X|, "power" |X|^2, "db" 10*log10(|X|^2) (floored at -200 dB).
# times are frame centres.
pub def spectrogram(x: List[float], fs: float, window: List[float], hop: int, nfft: int, mode: str) throws str -> Spectrogram:
    if mode != "magnitude" and mode != "power" and mode != "db": raise(f"spectrogram: unknown mode '{mode}' (use magnitude, power or db)")
    mut s = stft(x, window, hop, nfft, false)?
    mut sp = Spectrogram()
    sp.frames = s.frames
    sp.bins = s.bins
    sp.data = fft_zeros(s.frames * s.bins)
    mut i = 0
    while i < s.frames * s.bins:
        mut p = s.data[2 * i] * s.data[2 * i] + s.data[2 * i + 1] * s.data[2 * i + 1]
        if mode == "magnitude": sp.data[i] = sqrt(p)
        elif mode == "power": sp.data[i] = p
        else:
            if p < 1e-20: p = 1e-20
            sp.data[i] = 10.0 * log10(p)
        i = i + 1
    sp.times = s.times(fs)
    sp.freqs = s.freqs(fs)
    return sp

pub class Psd:
    pub freqs:  List[float]
    pub values: List[float]
    pub segments: int

extend Psd:
    # Frequency of the largest value.
    pub def peak_freq(self) -> float:
        mut best = 0
        mut i = 1
        while i < len(self.values):
            if self.values[i] > self.values[best]: best = i
            i = i + 1
        return self.freqs[best]

# Welch's averaged periodogram (scipy.signal.welch: one-sided, mean of
# segments of len(window) with `noverlap` overlap, constant detrend when
# detrend is true). scaling "density" (V^2/Hz) or "spectrum" (V^2).
pub def welch_window(x: List[float], fs: float, window: List[float], noverlap: int, nfft: int, detrend: bool, scaling: str) throws str -> Psd:
    mut nwin = len(window)
    if nwin < 1: raise("welch: window must not be empty")
    if len(x) < nwin: raise("welch: signal is shorter than the window")
    if noverlap < 0 or noverlap >= nwin: raise("welch: noverlap must be in [0, len(window))")
    if nfft < nwin: raise("welch: nfft must be >= the window length")
    mut sc = 0
    if scaling == "spectrum": sc = 1
    elif scaling != "density": raise(f"welch: unknown scaling '{scaling}' (use density or spectrum)")
    mut dt = 0
    if detrend: dt = 1
    mut p = Psd()
    p.values = fft_zeros(nfft / 2 + 1)
    mut xp = x as Pointer[float]
    mut wp = window as Pointer[float]
    mut op = p.values as Pointer[float]
    mut segs = trc_dsp_welch(xp, len(x), wp, nwin, nwin - noverlap, nfft, dt, sc, fs, op)
    if segs < 0: raise("welch: out of memory")
    p.segments = segs
    p.freqs = rfftfreq(nfft, 1.0 / fs)
    return p

# SciPy defaults: periodic Hann of nperseg, 50% overlap, density, detrend.
pub def welch(x: List[float], fs: float, nperseg: int) throws str -> Psd:
    mut n = nperseg
    if n > len(x): n = len(x)
    return welch_window(x, fs, hann(n, false), n / 2, n, true, "density")?

# DFT of x at one frequency (Hz) with the Goertzel recurrence: [re, im],
# equal to sum_m x[m] exp(-2 pi i freq m / fs). freq need not be a bin.
pub def goertzel(x: List[float], freq: float, fs: float) -> List[float]:
    mut out: List[float] = [0.0, 0.0]
    mut xp = x as Pointer[float]
    mut op = out as Pointer[float]
    trc_dsp_goertzel(xp, len(x), 2.0 * _DSP_PI * freq / fs, op)
    return out

pub def goertzel_power(x: List[float], freq: float, fs: float) -> float:
    mut v = goertzel(x, freq, fs)
    return v[0] * v[0] + v[1] * v[1]

# ── resampling ──────────────────────────────────────────────────────────────

def _gcd(a: int, b: int) -> int:
    mut x = a
    mut y = b
    while y != 0:
        mut t = x % y
        x = y
        y = t
    return x

def _upfirdn_len(lh: int, n_in: int, up: int, down: int) -> int:
    return ((n_in - 1) * up + lh - 1) / down + 1

# Polyphase resampling by up/down (scipy.signal.resample_poly with the
# default Kaiser(5.0) anti-aliasing FIR of 20*max(up,down)+1 taps).
pub def resample_poly(x: List[float], up: int, down: int) throws str -> List[float]:
    if up < 1 or down < 1: raise("resample_poly: up and down must be positive")
    if len(x) == 0: return fft_zeros(0)
    mut g = _gcd(up, down)
    mut u = up / g
    mut d = down / g
    if u == 1 and d == 1:
        mut same = fft_zeros(len(x))
        mut i0 = 0
        while i0 < len(x):
            same[i0] = x[i0]
            i0 = i0 + 1
        return same
    mut n_in = len(x)
    mut n_out = n_in * u
    mut rem = n_out % d
    n_out = n_out / d
    if rem != 0: n_out = n_out + 1
    mut max_rate = u
    if d > u: max_rate = d
    mut half_len = 10 * max_rate
    mut ntaps = 2 * half_len + 1
    mut cut: List[float] = [1.0 / (max_rate as float)]
    mut h0 = firwin_window(ntaps, cut, true, 2.0, kaiser(ntaps, 5.0, true))?
    mut n_pre_pad = d - half_len % d
    mut n_post_pad = 0
    mut n_pre_remove = (half_len + n_pre_pad) / d
    while _upfirdn_len(ntaps + n_pre_pad + n_post_pad, n_in, u, d) < n_out + n_pre_remove:
        n_post_pad = n_post_pad + 1
    mut lh = ntaps + n_pre_pad + n_post_pad
    mut h = fft_zeros(lh)
    mut i = 0
    while i < ntaps:
        h[n_pre_pad + i] = h0[i] * (u as float)
        i = i + 1
    # upfirdn: y[j] = sum_k h[k] * xu[j*d - k], xu = x upsampled by u (zeros between)
    mut out = fft_zeros(n_out)
    mut j = 0
    while j < n_out:
        mut pos = (j + n_pre_remove) * d
        # k such that (pos - k) % u == 0 and 0 <= (pos-k)/u < n_in
        mut acc = 0.0
        mut k = pos % u
        while k < lh:
            mut idx = (pos - k) / u
            if idx < 0: break
            if idx < n_in: acc = acc + h[k] * x[idx]
            k = k + u
        out[j] = acc
        j = j + 1
    return out

# ── peaks ───────────────────────────────────────────────────────────────────

# Local maxima (plateaus report their middle sample, as scipy.signal.find_peaks).
pub def local_maxima(x: List[float]) -> List[int]:
    mut peaks: List[int] = []
    mut n = len(x)
    mut i = 1
    while i < n - 1:
        if x[i - 1] < x[i]:
            mut ahead = i + 1
            while ahead < n - 1 and x[ahead] == x[i]: ahead = ahead + 1
            if x[ahead] < x[i]:
                peaks.append((i + ahead - 1) / 2)
                i = ahead
        i = i + 1
    return peaks

# Prominence of each peak (scipy.signal.peak_prominences, unlimited window).
pub def peak_prominences(x: List[float], peaks: List[int]) -> List[float]:
    mut out = fft_zeros(len(peaks))
    mut p = 0
    while p < len(peaks):
        mut pk = peaks[p]
        mut v = x[pk]
        mut left_min = v
        mut i = pk
        while i >= 0 and x[i] <= v:
            if x[i] < left_min: left_min = x[i]
            i = i - 1
        mut right_min = v
        i = pk
        while i < len(x) and x[i] <= v:
            if x[i] < right_min: right_min = x[i]
            i = i + 1
        mut base = left_min
        if right_min > base: base = right_min
        out[p] = v - base
        p = p + 1
    return out

# Peaks of x with height >= min_height, at least `distance` samples apart
# (higher peaks win) and prominence >= min_prominence. Pass a very negative
# min_height, distance <= 1 or min_prominence <= 0 to skip a criterion.
pub def find_peaks(x: List[float], min_height: float, distance: int, min_prominence: float) -> List[int]:
    mut cand = local_maxima(x)
    mut peaks: List[int] = []
    mut i = 0
    while i < len(cand):
        if x[cand[i]] >= min_height: peaks.append(cand[i])
        i = i + 1
    if distance > 1 and len(peaks) > 1:
        # order by height (stable), strongest first
        mut order: List[int] = []
        i = 0
        while i < len(peaks):
            order.append(i)
            i = i + 1
        i = 1
        while i < len(order):
            mut cur = order[i]
            mut j = i - 1
            while j >= 0 and x[peaks[order[j]]] > x[peaks[cur]]:
                order[j + 1] = order[j]
                j = j - 1
            order[j + 1] = cur
            i = i + 1
        mut keep: List[bool] = []
        i = 0
        while i < len(peaks):
            keep.append(true)
            i = i + 1
        mut r = len(order) - 1
        while r >= 0:
            mut jj = order[r]
            if keep[jj]:
                mut k = jj - 1
                while k >= 0 and peaks[jj] - peaks[k] < distance:
                    keep[k] = false
                    k = k - 1
                k = jj + 1
                while k < len(peaks) and peaks[k] - peaks[jj] < distance:
                    keep[k] = false
                    k = k + 1
            r = r - 1
        mut kept: List[int] = []
        i = 0
        while i < len(peaks):
            if keep[i]: kept.append(peaks[i])
            i = i + 1
        peaks = kept
    if min_prominence > 0.0:
        mut prom = peak_prominences(x, peaks)
        mut kept2: List[int] = []
        i = 0
        while i < len(peaks):
            if prom[i] >= min_prominence: kept2.append(peaks[i])
            i = i + 1
        peaks = kept2
    return peaks
