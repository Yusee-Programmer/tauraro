# std.image.transform — resize, crop, rotate/flip, convolution filters, colour
# adjustments and alpha compositing for std.image.Image (RGBA8), pure Tauraro.
#
#   from std.image.transform import resize_image, crop, flip_h, rotate90, gaussian_blur,
#                                   sharpen, grayscale, composite, FILTER_LANCZOS
#
#   mut small = resize_image(img, 64, 48, FILTER_LANCZOS)
#   mut part  = crop(img, 10, 10, 100, 50)
#   mut blur  = gaussian_blur(img, 2.0)
#   composite(canvas, sprite, 5, 5)        # alpha "over", in place on `canvas`
#
# Conventions
#   * Every function that produces a new picture returns a NEW owned Image and
#     leaves its argument untouched; functions whose name says "in place"
#     (composite, fill_rect, paste, adjust_*_inplace) modify their first argument.
#   * Pixels are straight (non-premultiplied) RGBA8. Resampling (bilinear,
#     bicubic, lanczos, rotate) works on premultiplied colour when an image has
#     any non-opaque pixel, so transparent edges don't bleed their hidden RGB.
#   * Invalid sizes (w <= 0 / h <= 0) return an Image with width == -1, the same
#     failure sentinel the decoders use.
#   * Resize uses Pillow's separable "support grows with the down-scale factor"
#     algorithm (so down-scaling is properly anti-aliased): results are within
#     +-1 level of Pillow's resize for the same filter.

from std.image.mod import Image
from std.image.buf import FloatBuf, IntBuf, new_image, bad_image, put_rgba, get_ch, clamp255

extern "C":
    def sin(x: float) -> float
    def cos(x: float) -> float
    def sqrt(x: float) -> float
    def pow(base: float, exp: float) -> float
    def floor(x: float) -> float
    def fabs(x: float) -> float
    def _tr_c_memcpy(dst: Pointer[char], src: Pointer[char], n: int) -> Pointer[char]

pub const FILTER_NEAREST  = 0
pub const FILTER_BILINEAR = 1
pub const FILTER_BICUBIC  = 2
pub const FILTER_LANCZOS  = 3

# ── small helpers ───────────────────────────────────────────────────────────

def _pi() -> float:
    return 3.14159265358979323846

def _fl(v: float) -> int:
    mut f = floor(v)
    return f as int

def _round(v: float) -> int:
    return _fl(v + 0.5)

def _clampf(v: float, lo: float, hi: float) -> float:
    if v < lo: return lo
    if v > hi: return hi
    return v

def _has_alpha(img: Image) -> bool:
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        if get_ch(img, i, 3) != 255:
            return true
        i = i + 1
    return false

# Copy of an image (owned).
pub def copy_image(img: Image) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height * 4
    if n > 0:
        _tr_c_memcpy(out.pixels.data as Pointer[char], img.pixels.data as Pointer[char], n)
    return out

# ── resize ──────────────────────────────────────────────────────────────────

def _filt(kind: int, x: float) -> float:
    mut ax = fabs(x)
    if kind == 1:
        if ax < 1.0:
            return 1.0 - ax
        return 0.0
    if kind == 2:
        mut a = -0.5
        if ax < 1.0:
            return ((a + 2.0) * ax - (a + 3.0)) * ax * ax + 1.0
        if ax < 2.0:
            return (((ax - 5.0) * ax + 8.0) * ax - 4.0) * a
        return 0.0
    # lanczos, a = 3
    if ax >= 3.0:
        return 0.0
    if ax < 0.0000000001:
        return 1.0
    mut px = _pi() * ax
    return (sin(px) / px) * (sin(px / 3.0) / (px / 3.0))

def _support(kind: int) -> float:
    if kind == 1: return 1.0
    if kind == 2: return 2.0
    return 3.0

# Per-output-pixel resampling coefficients for one axis.
class _Coeffs:
    pub start: IntBuf      # first source index
    pub count: IntBuf      # number of taps
    pub w:     FloatBuf    # out * maxk weights (normalised)
    pub maxk:  int

extend _Coeffs:
    pub def free(self):
        self.start.free()
        self.count.free()
        self.w.free()

def _coeffs(insz: int, outsz: int, kind: int) -> _Coeffs:
    mut c = _Coeffs()
    mut scale = (insz as float) / (outsz as float)
    mut fscale = scale
    if fscale < 1.0:
        fscale = 1.0
    mut sup = _support(kind) * fscale
    mut maxk = (sup as int) * 2 + 3
    c.maxk = maxk
    c.start = IntBuf.init(outsz)
    c.count = IntBuf.init(outsz)
    c.w = FloatBuf.init(outsz * maxk)
    mut xx = 0
    while xx < outsz:
        mut center = ((xx as float) + 0.5) * scale
        mut xmin = _fl(center - sup + 0.5)
        if xmin < 0: xmin = 0
        mut xmax = _fl(center + sup + 0.5)
        if xmax > insz: xmax = insz
        mut n = xmax - xmin
        if n > maxk: n = maxk
        mut sum = 0.0
        mut k = 0
        while k < n:
            mut v = _filt(kind, (((k + xmin) as float) - center + 0.5) / fscale)
            c.w.set(xx * maxk + k, v)
            sum = sum + v
            k = k + 1
        if sum != 0.0:
            k = 0
            while k < n:
                c.w.set(xx * maxk + k, c.w.get(xx * maxk + k) / sum)
                k = k + 1
        c.start.set(xx, xmin)
        c.count.set(xx, n)
        xx = xx + 1
    return c

def _premul(img: Image) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut a = get_ch(img, i, 3)
        put_rgba(out, i, (get_ch(img, i, 0) * a + 127) / 255, (get_ch(img, i, 1) * a + 127) / 255,
                 (get_ch(img, i, 2) * a + 127) / 255, a)
        i = i + 1
    return out

def _unpremul(img: Image):
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut a = get_ch(img, i, 3)
        if a != 0 and a != 255:
            put_rgba(img, i, clamp255((get_ch(img, i, 0) * 255 + a / 2) / a), clamp255((get_ch(img, i, 1) * 255 + a / 2) / a),
                     clamp255((get_ch(img, i, 2) * 255 + a / 2) / a), a)
        else:
            if a == 0:
                put_rgba(img, i, 0, 0, 0, 0)
        i = i + 1

def _resize_nearest(img: Image, w: int, h: int) -> Image:
    mut out = new_image(w, h)
    # Pillow's affine-nearest walks the source coordinate by repeated addition
    # of the scale, starting at scale / 2; do the same so ties land identically.
    mut xscale = (img.width as float) / (w as float)
    mut yscale = (img.height as float) / (h as float)
    mut yy = 0.5 * yscale
    mut y = 0
    while y < h:
        mut sy = _fl(yy)
        if sy >= img.height: sy = img.height - 1
        mut xx = 0.5 * xscale
        mut x = 0
        while x < w:
            mut sx = _fl(xx)
            if sx >= img.width: sx = img.width - 1
            mut si = sy * img.width + sx
            put_rgba(out, y * w + x, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
            xx = xx + xscale
            x = x + 1
        yy = yy + yscale
        y = y + 1
    return out

def _resize_filtered(src: Image, w: int, h: int, kind: int) -> Image:
    # horizontal pass -> w x src.height intermediate, then vertical pass
    mut ch = _coeffs(src.width, w, kind)
    mut mid = new_image(w, src.height)
    mut y = 0
    while y < src.height:
        mut x = 0
        while x < w:
            mut st = ch.start.get(x)
            mut n = ch.count.get(x)
            mut r = 0.0
            mut g = 0.0
            mut b = 0.0
            mut a = 0.0
            mut k = 0
            while k < n:
                mut wt = ch.w.get(x * ch.maxk + k)
                mut si = y * src.width + st + k
                r = r + wt * (get_ch(src, si, 0) as float)
                g = g + wt * (get_ch(src, si, 1) as float)
                b = b + wt * (get_ch(src, si, 2) as float)
                a = a + wt * (get_ch(src, si, 3) as float)
                k = k + 1
            put_rgba(mid, y * w + x, clamp255(_round(r)), clamp255(_round(g)), clamp255(_round(b)), clamp255(_round(a)))
            x = x + 1
        y = y + 1
    ch.free()
    mut cv = _coeffs(src.height, h, kind)
    mut out = new_image(w, h)
    y = 0
    while y < h:
        mut st = cv.start.get(y)
        mut n = cv.count.get(y)
        mut x = 0
        while x < w:
            mut r = 0.0
            mut g = 0.0
            mut b = 0.0
            mut a = 0.0
            mut k = 0
            while k < n:
                mut wt = cv.w.get(y * cv.maxk + k)
                mut si = (st + k) * w + x
                r = r + wt * (get_ch(mid, si, 0) as float)
                g = g + wt * (get_ch(mid, si, 1) as float)
                b = b + wt * (get_ch(mid, si, 2) as float)
                a = a + wt * (get_ch(mid, si, 3) as float)
                k = k + 1
            put_rgba(out, y * w + x, clamp255(_round(r)), clamp255(_round(g)), clamp255(_round(b)), clamp255(_round(a)))
            x = x + 1
        y = y + 1
    cv.free()
    mid.free()
    return out

# Resize to w x h with FILTER_NEAREST / FILTER_BILINEAR / FILTER_BICUBIC /
# FILTER_LANCZOS. Returns a new image (width == -1 for invalid sizes).
pub def resize_image(img: Image, w: int, h: int, filter: int) -> Image:
    if w <= 0 or h <= 0 or img.width <= 0 or img.height <= 0:
        return bad_image()
    if filter == 0:
        return _resize_nearest(img, w, h)
    if filter < 0 or filter > 3:
        return bad_image()
    if img.width == w and img.height == h:
        return copy_image(img)
    if _has_alpha(img):
        mut p = _premul(img)
        mut r = _resize_filtered(p, w, h, filter)
        p.free()
        _unpremul(r)
        return r
    return _resize_filtered(img, w, h, filter)

pub def resize_nearest(img: Image, w: int, h: int) -> Image:
    return resize_image(img, w, h, 0)

pub def resize_bilinear(img: Image, w: int, h: int) -> Image:
    return resize_image(img, w, h, 1)

pub def resize_bicubic(img: Image, w: int, h: int) -> Image:
    return resize_image(img, w, h, 2)

pub def resize_lanczos(img: Image, w: int, h: int) -> Image:
    return resize_image(img, w, h, 3)

# Scale so the picture fits inside max_w x max_h, keeping the aspect ratio
# (never enlarges when `shrink_only`).
pub def resize_fit(img: Image, max_w: int, max_h: int, filter: int, shrink_only: bool) -> Image:
    if max_w <= 0 or max_h <= 0 or img.width <= 0 or img.height <= 0:
        return bad_image()
    mut w = max_w
    mut h = (img.height * max_w + img.width / 2) / img.width
    if h > max_h:
        h = max_h
        w = (img.width * max_h + img.height / 2) / img.height
    if shrink_only and (w >= img.width or h >= img.height):
        return copy_image(img)
    if w < 1: w = 1
    if h < 1: h = 1
    return resize_image(img, w, h, filter)

# ── crop / flip / rotate ────────────────────────────────────────────────────

# The w x h rectangle at (x, y); parts outside the source are transparent.
pub def crop(img: Image, x: int, y: int, w: int, h: int) -> Image:
    if w <= 0 or h <= 0:
        return bad_image()
    mut out = new_image(w, h)
    mut yy = 0
    while yy < h:
        mut sy = y + yy
        if sy >= 0 and sy < img.height:
            mut xx = 0
            while xx < w:
                mut sx = x + xx
                if sx >= 0 and sx < img.width:
                    mut si = sy * img.width + sx
                    put_rgba(out, yy * w + xx, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
                xx = xx + 1
        yy = yy + 1
    return out

pub def flip_h(img: Image) -> Image:
    mut out = new_image(img.width, img.height)
    mut y = 0
    while y < img.height:
        mut x = 0
        while x < img.width:
            mut si = y * img.width + (img.width - 1 - x)
            put_rgba(out, y * img.width + x, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
            x = x + 1
        y = y + 1
    return out

pub def flip_v(img: Image) -> Image:
    mut out = new_image(img.width, img.height)
    mut y = 0
    while y < img.height:
        mut x = 0
        while x < img.width:
            mut si = (img.height - 1 - y) * img.width + x
            put_rgba(out, y * img.width + x, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
            x = x + 1
        y = y + 1
    return out

# Rotate by a multiple of 90 degrees clockwise: quarter_turns = 1, 2 or 3
# (0 and multiples of 4 give a copy; negatives turn anticlockwise).
pub def rotate90(img: Image, quarter_turns: int) -> Image:
    mut q = quarter_turns % 4
    if q < 0:
        q = q + 4
    if q == 0:
        return copy_image(img)
    mut w = img.width
    mut h = img.height
    if q == 2:
        mut o2 = new_image(w, h)
        mut i = 0
        while i < w * h:
            mut si = w * h - 1 - i
            put_rgba(o2, i, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
            i = i + 1
        return o2
    mut out = new_image(h, w)      # new width = old height
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            mut si = y * w + x
            mut dx = 0
            mut dy = 0
            if q == 1:           # clockwise: (x, y) -> (h-1-y, x)
                dx = h - 1 - y
                dy = x
            else:                # anticlockwise: (x, y) -> (y, w-1-x)
                dx = y
                dy = w - 1 - x
            put_rgba(out, dy * h + dx, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
            x = x + 1
        y = y + 1
    return out

pub def rotate180(img: Image) -> Image:
    return rotate90(img, 2)

# Swap rows and columns (reflect across the main diagonal).
pub def transpose(img: Image) -> Image:
    mut out = new_image(img.height, img.width)
    mut y = 0
    while y < img.height:
        mut x = 0
        while x < img.width:
            mut si = y * img.width + x
            put_rgba(out, x * img.height + y, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
            x = x + 1
        y = y + 1
    return out

# Rotate by `degrees` clockwise about the centre. `expand` grows the canvas to
# hold the whole rotated picture, otherwise the size is kept and corners are
# cut. Uncovered area is transparent. `smooth` selects bilinear sampling
# (otherwise nearest). Multiples of 90 degrees are exact.
pub def rotate(img: Image, degrees: float, expand: bool, smooth: bool) -> Image:
    mut turns = degrees / 90.0
    mut tr = _round(turns)
    if fabs(turns - (tr as float)) < 0.0000001:
        mut r = rotate90(img, tr)
        if expand or (tr % 2 == 0):
            return r
        # same-size request for an odd quarter turn: centre-crop/pad
        mut cx = (r.width - img.width) / 2
        mut cy = (r.height - img.height) / 2
        mut c = crop(r, cx, cy, img.width, img.height)
        r.free()
        return c
    mut rad = degrees * _pi() / 180.0
    mut ca = cos(rad)
    mut sa = sin(rad)
    mut w = img.width
    mut h = img.height
    mut nw = w
    mut nh = h
    if expand:
        # Pillow's rule: bounding box of the rotated corners
        mut mx = (fabs((w as float) * ca) + fabs((h as float) * sa)) / 2.0
        mut my = (fabs((w as float) * sa) + fabs((h as float) * ca)) / 2.0
        mut hw = (w as float) / 2.0
        mut hh = (h as float) / 2.0
        nw = (0 - _fl(0.0 - (hw + mx - 0.000000001))) - _fl(hw - mx + 0.000000001)
        nh = (0 - _fl(0.0 - (hh + my - 0.000000001))) - _fl(hh - my + 0.000000001)
        if nw < 1: nw = 1
        if nh < 1: nh = 1
    mut out = new_image(nw, nh)
    mut use_pm = smooth and _has_alpha(img)
    mut pmi = img
    if use_pm:
        pmi = _premul(img)
    mut ocx = ((nw as float) - 1.0) / 2.0
    mut ocy = ((nh as float) - 1.0) / 2.0
    mut icx = ((w as float) - 1.0) / 2.0
    mut icy = ((h as float) - 1.0) / 2.0
    mut y = 0
    while y < nh:
        mut x = 0
        while x < nw:
            mut dx = (x as float) - ocx
            mut dy = (y as float) - ocy
            # inverse (counter-clockwise) mapping back into the source
            mut sx = dx * ca + dy * sa + icx
            mut sy = 0.0 - dx * sa + dy * ca + icy
            mut oi = y * nw + x
            if smooth:
                if sx > -0.5 and sy > -0.5 and sx < (w as float) - 0.5 and sy < (h as float) - 0.5:
                    mut x0 = _fl(sx)
                    mut y0 = _fl(sy)
                    mut fx = sx - (x0 as float)
                    mut fy = sy - (y0 as float)
                    mut r = 0.0
                    mut g = 0.0
                    mut b = 0.0
                    mut a = 0.0
                    mut j = 0
                    while j < 2:
                        mut i = 0
                        while i < 2:
                            mut px = x0 + i
                            mut py = y0 + j
                            if px < 0: px = 0
                            if py < 0: py = 0
                            if px >= w: px = w - 1
                            if py >= h: py = h - 1
                            mut wx = fx
                            if i == 0: wx = 1.0 - fx
                            mut wy = fy
                            if j == 0: wy = 1.0 - fy
                            mut wt = wx * wy
                            mut si = py * w + px
                            r = r + wt * (get_ch(pmi, si, 0) as float)
                            g = g + wt * (get_ch(pmi, si, 1) as float)
                            b = b + wt * (get_ch(pmi, si, 2) as float)
                            a = a + wt * (get_ch(pmi, si, 3) as float)
                            i = i + 1
                        j = j + 1
                    put_rgba(out, oi, clamp255(_round(r)), clamp255(_round(g)), clamp255(_round(b)), clamp255(_round(a)))
            else:
                mut px = _round(sx)
                mut py = _round(sy)
                if px >= 0 and py >= 0 and px < w and py < h:
                    mut si = py * w + px
                    put_rgba(out, oi, get_ch(img, si, 0), get_ch(img, si, 1), get_ch(img, si, 2), get_ch(img, si, 3))
            x = x + 1
        y = y + 1
    if use_pm:
        pmi.free()
        _unpremul(out)
    return out

# ── convolution ─────────────────────────────────────────────────────────────

# A square convolution kernel of odd size n (n x n), row-major.
pub class Kernel:
    pub n:       int
    pub v:       FloatBuf
    pub divisor: float
    pub offset:  float

extend Kernel:
    pub def init(n: int) -> Kernel:
        mut k = Kernel()
        k.n = n
        k.v = FloatBuf.init(n * n)
        k.divisor = 1.0
        k.offset = 0.0
        return k

    pub def set(self, x: int, y: int, val: float):
        self.v.set(y * self.n + x, val)

    pub def get(self, x: int, y: int) -> float:
        return self.v.get(y * self.n + x)

    pub def free(self):
        self.v.free()

# Convolve the colour channels with `k` (edges clamp to the border pixel);
# result = sum / divisor + offset, clamped to 0..255. Alpha is copied unchanged.
pub def convolve(img: Image, k: Kernel) -> Image:
    mut out = new_image(img.width, img.height)
    mut w = img.width
    mut h = img.height
    mut r = k.n / 2
    mut dv = k.divisor
    if dv == 0.0:
        dv = 1.0
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            mut sr = 0.0
            mut sg = 0.0
            mut sb = 0.0
            mut j = 0
            while j < k.n:
                mut yy = y + j - r
                if yy < 0: yy = 0
                if yy >= h: yy = h - 1
                mut i = 0
                while i < k.n:
                    mut xx = x + i - r
                    if xx < 0: xx = 0
                    if xx >= w: xx = w - 1
                    mut kv = k.v.get(j * k.n + i)
                    mut si = yy * w + xx
                    sr = sr + kv * (get_ch(img, si, 0) as float)
                    sg = sg + kv * (get_ch(img, si, 1) as float)
                    sb = sb + kv * (get_ch(img, si, 2) as float)
                    i = i + 1
                j = j + 1
            mut oi = y * w + x
            put_rgba(out, oi, clamp255(_round(sr / dv + k.offset)), clamp255(_round(sg / dv + k.offset)),
                     clamp255(_round(sb / dv + k.offset)), get_ch(img, oi, 3))
            x = x + 1
        y = y + 1
    return out

# Separable 1-D pass (horizontal when `horiz`), taps in `wts` (odd length n).
def _sep_pass(img: Image, wts: FloatBuf, n: int, horiz: bool) -> Image:
    mut out = new_image(img.width, img.height)
    mut w = img.width
    mut h = img.height
    mut r = n / 2
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            mut sr = 0.0
            mut sg = 0.0
            mut sb = 0.0
            mut i = 0
            while i < n:
                mut xx = x
                mut yy = y
                if horiz:
                    xx = x + i - r
                    if xx < 0: xx = 0
                    if xx >= w: xx = w - 1
                else:
                    yy = y + i - r
                    if yy < 0: yy = 0
                    if yy >= h: yy = h - 1
                mut kv = wts.get(i)
                mut si = yy * w + xx
                sr = sr + kv * (get_ch(img, si, 0) as float)
                sg = sg + kv * (get_ch(img, si, 1) as float)
                sb = sb + kv * (get_ch(img, si, 2) as float)
                i = i + 1
            mut oi = y * w + x
            put_rgba(out, oi, clamp255(_round(sr)), clamp255(_round(sg)), clamp255(_round(sb)), get_ch(img, oi, 3))
            x = x + 1
        y = y + 1
    return out

# Box blur with the given pixel radius (window 2*radius+1).
pub def box_blur(img: Image, radius: int) -> Image:
    if radius <= 0:
        return copy_image(img)
    mut n = radius * 2 + 1
    mut wts = FloatBuf.init(n)
    mut i = 0
    while i < n:
        wts.set(i, 1.0 / (n as float))
        i = i + 1
    mut a = _sep_pass(img, wts, n, true)
    mut b = _sep_pass(a, wts, n, false)
    a.free()
    wts.free()
    return b

# Gaussian blur with standard deviation `sigma` (pixels), kernel radius
# ceil(3 sigma).
pub def gaussian_blur(img: Image, sigma: float) -> Image:
    if sigma <= 0.0:
        return copy_image(img)
    mut r = _fl(sigma * 3.0 + 0.9999)
    if r < 1: r = 1
    mut n = r * 2 + 1
    mut wts = FloatBuf.init(n)
    mut sum = 0.0
    mut i = 0
    while i < n:
        mut d = ((i - r) as float)
        mut v = pow(2.718281828459045, 0.0 - (d * d) / (2.0 * sigma * sigma))
        wts.set(i, v)
        sum = sum + v
        i = i + 1
    i = 0
    while i < n:
        wts.set(i, wts.get(i) / sum)
        i = i + 1
    mut a = _sep_pass(img, wts, n, true)
    mut b = _sep_pass(a, wts, n, false)
    a.free()
    wts.free()
    return b

def _kernel3(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int, div: float, off: float) -> Kernel:
    mut k = Kernel.init(3)
    k.set(0, 0, a as float)
    k.set(1, 0, b as float)
    k.set(2, 0, c as float)
    k.set(0, 1, d as float)
    k.set(1, 1, e as float)
    k.set(2, 1, f as float)
    k.set(0, 2, g as float)
    k.set(1, 2, h as float)
    k.set(2, 2, i as float)
    k.divisor = div
    k.offset = off
    return k

# Sharpen (unsharp-style 3x3). `amount` 1.0 is the classic [0 -1 0; -1 5 -1; 0 -1 0].
pub def sharpen(img: Image, amount: float) -> Image:
    mut k = Kernel.init(3)
    k.set(1, 0, 0.0 - amount)
    k.set(0, 1, 0.0 - amount)
    k.set(2, 1, 0.0 - amount)
    k.set(1, 2, 0.0 - amount)
    k.set(1, 1, 1.0 + 4.0 * amount)
    mut o = convolve(img, k)
    k.free()
    return o

# Laplacian edge detection, 8-neighbour: flat areas -> black, edges bright
# ([-1 -1 -1; -1 8 -1; -1 -1 -1]).
pub def edge_detect(img: Image) -> Image:
    mut k = _kernel3(-1, -1, -1, -1, 8, -1, -1, -1, -1, 1.0, 0.0)
    mut o = convolve(img, k)
    k.free()
    return o

# Sobel gradient magnitude of the luma, as a grayscale image (alpha kept).
pub def sobel(img: Image) -> Image:
    mut g = grayscale(img)
    mut w = img.width
    mut h = img.height
    mut out = new_image(w, h)
    mut y = 0
    while y < h:
        mut x = 0
        while x < w:
            mut gx = 0
            mut gy = 0
            mut j = -1
            while j <= 1:
                mut i = -1
                while i <= 1:
                    mut xx = x + i
                    mut yy = y + j
                    if xx < 0: xx = 0
                    if yy < 0: yy = 0
                    if xx >= w: xx = w - 1
                    if yy >= h: yy = h - 1
                    mut v = get_ch(g, yy * w + xx, 0)
                    mut wx = i * (2 - j * j)
                    mut wy = j * (2 - i * i)
                    gx = gx + wx * v
                    gy = gy + wy * v
                    i = i + 1
                j = j + 1
            mut m = _round(sqrt(((gx * gx + gy * gy) as float)) / 4.0)
            m = clamp255(m)
            put_rgba(out, y * w + x, m, m, m, get_ch(img, y * w + x, 3))
            x = x + 1
        y = y + 1
    g.free()
    return out

pub def emboss(img: Image) -> Image:
    mut k = _kernel3(-2, -1, 0, -1, 1, 1, 0, 1, 2, 1.0, 0.0)
    mut o = convolve(img, k)
    k.free()
    return o

# ── colour adjustments ──────────────────────────────────────────────────────

def _luma(r: int, g: int, b: int) -> int:
    # Rec.601, rounded, same weights as Pillow's "L" conversion
    return (r * 299 + g * 587 + b * 114 + 500) / 1000

# Grayscale (Rec.601 luma) as an RGBA image with R = G = B.
pub def grayscale(img: Image) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut l = _luma(get_ch(img, i, 0), get_ch(img, i, 1), get_ch(img, i, 2))
        put_rgba(out, i, l, l, l, get_ch(img, i, 3))
        i = i + 1
    return out

pub def invert(img: Image) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        put_rgba(out, i, 255 - get_ch(img, i, 0), 255 - get_ch(img, i, 1), 255 - get_ch(img, i, 2), get_ch(img, i, 3))
        i = i + 1
    return out

# Add `amount` (-255..255) to every colour channel.
pub def brightness(img: Image, amount: int) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        put_rgba(out, i, clamp255(get_ch(img, i, 0) + amount), clamp255(get_ch(img, i, 1) + amount),
                 clamp255(get_ch(img, i, 2) + amount), get_ch(img, i, 3))
        i = i + 1
    return out

# Scale contrast about mid-grey: factor 1.0 = unchanged, 0.0 = flat grey, 2.0 = double.
pub def contrast(img: Image, factor: float) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut c = 0
        mut v = IntBuf.init(3)
        while c < 3:
            v.set(c, clamp255(_round((((get_ch(img, i, c) as float) - 128.0) * factor) + 128.0)))
            c = c + 1
        put_rgba(out, i, v.get(0), v.get(1), v.get(2), get_ch(img, i, 3))
        v.free()
        i = i + 1
    return out

# Gamma correction: out = 255 * (in / 255) ^ (1 / gamma). gamma > 1 brightens.
pub def gamma(img: Image, g: float) -> Image:
    mut lut = IntBuf.init(256)
    mut v = 0
    mut inv = 1.0
    if g > 0.0:
        inv = 1.0 / g
    while v < 256:
        lut.set(v, clamp255(_round(255.0 * pow((v as float) / 255.0, inv))))
        v = v + 1
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        put_rgba(out, i, lut.get(get_ch(img, i, 0)), lut.get(get_ch(img, i, 1)), lut.get(get_ch(img, i, 2)), get_ch(img, i, 3))
        i = i + 1
    lut.free()
    return out

# Saturation: 0.0 = grayscale, 1.0 = unchanged, >1 = more vivid.
pub def saturation(img: Image, factor: float) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut r = get_ch(img, i, 0)
        mut g = get_ch(img, i, 1)
        mut b = get_ch(img, i, 2)
        mut l = (_luma(r, g, b)) as float
        put_rgba(out, i, clamp255(_round(l + ((r as float) - l) * factor)), clamp255(_round(l + ((g as float) - l) * factor)),
                 clamp255(_round(l + ((b as float) - l) * factor)), get_ch(img, i, 3))
        i = i + 1
    return out

# Black/white by luma threshold (>= t -> white).
pub def threshold(img: Image, t: int) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut l = _luma(get_ch(img, i, 0), get_ch(img, i, 1), get_ch(img, i, 2))
        mut v = 0
        if l >= t:
            v = 255
        put_rgba(out, i, v, v, v, get_ch(img, i, 3))
        i = i + 1
    return out

pub def sepia(img: Image) -> Image:
    mut out = new_image(img.width, img.height)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut r = get_ch(img, i, 0)
        mut g = get_ch(img, i, 1)
        mut b = get_ch(img, i, 2)
        put_rgba(out, i, clamp255((r * 393 + g * 769 + b * 189) / 1000), clamp255((r * 349 + g * 686 + b * 168) / 1000),
                 clamp255((r * 272 + g * 534 + b * 131) / 1000), get_ch(img, i, 3))
        i = i + 1
    return out

# Multiply every alpha value by `opacity` (0.0 .. 1.0).
pub def with_opacity(img: Image, opacity: float) -> Image:
    mut out = copy_image(img)
    mut n = img.width * img.height
    mut i = 0
    while i < n:
        mut a = _round((get_ch(img, i, 3) as float) * _clampf(opacity, 0.0, 1.0))
        put_rgba(out, i, get_ch(img, i, 0), get_ch(img, i, 1), get_ch(img, i, 2), a)
        i = i + 1
    return out

# ── compositing ─────────────────────────────────────────────────────────────

# Porter-Duff "source over" of straight-alpha pixels, in place on `dst`.
# `src` is drawn with its top-left corner at (x, y); anything outside `dst`
# is clipped. `opacity` (0..255) scales the source alpha.
pub def composite_ex(dst: Image, src: Image, x: int, y: int, opacity: int):
    mut sy = 0
    while sy < src.height:
        mut dy = y + sy
        if dy >= 0 and dy < dst.height:
            mut sx = 0
            while sx < src.width:
                mut dx = x + sx
                if dx >= 0 and dx < dst.width:
                    mut si = sy * src.width + sx
                    mut di = dy * dst.width + dx
                    mut sa = (get_ch(src, si, 3) * opacity + 127) / 255
                    if sa == 255:
                        put_rgba(dst, di, get_ch(src, si, 0), get_ch(src, si, 1), get_ch(src, si, 2), 255)
                    else:
                        if sa > 0:
                            mut da = get_ch(dst, di, 3)
                            # out alpha = sa + da * (1 - sa)
                            mut oa = sa * 255 + da * (255 - sa)    # scaled by 255
                            if oa > 0:
                                mut c = 0
                                mut res = IntBuf.init(3)
                                while c < 3:
                                    mut num = get_ch(src, si, c) * sa * 255 + get_ch(dst, di, c) * da * (255 - sa)
                                    res.set(c, clamp255((num + oa / 2) / oa))
                                    c = c + 1
                                put_rgba(dst, di, res.get(0), res.get(1), res.get(2), (oa + 127) / 255)
                                res.free()
                sx = sx + 1
        sy = sy + 1

# Draw `src` over `dst` at (x, y), in place (see composite_ex).
pub def composite(dst: Image, src: Image, x: int, y: int):
    composite_ex(dst, src, x, y, 255)

# Copy `src` (including its alpha) into `dst` at (x, y), no blending, in place.
pub def paste(dst: Image, src: Image, x: int, y: int):
    mut sy = 0
    while sy < src.height:
        mut dy = y + sy
        if dy >= 0 and dy < dst.height:
            mut sx = 0
            while sx < src.width:
                mut dx = x + sx
                if dx >= 0 and dx < dst.width:
                    mut si = sy * src.width + sx
                    put_rgba(dst, dy * dst.width + dx, get_ch(src, si, 0), get_ch(src, si, 1), get_ch(src, si, 2), get_ch(src, si, 3))
                sx = sx + 1
        sy = sy + 1

# Fill a rectangle with a colour (clipped), in place, no blending.
pub def fill_rect(img: Image, x: int, y: int, w: int, h: int, r: int, g: int, b: int, a: int):
    mut yy = y
    while yy < y + h:
        if yy >= 0 and yy < img.height:
            mut xx = x
            while xx < x + w:
                if xx >= 0 and xx < img.width:
                    put_rgba(img, yy * img.width + xx, r, g, b, a)
                xx = xx + 1
        yy = yy + 1

# Composite over an opaque background colour -> a fully opaque copy.
pub def flatten(img: Image, r: int, g: int, b: int) -> Image:
    mut out = new_image(img.width, img.height)
    fill_rect(out, 0, 0, img.width, img.height, r, g, b, 255)
    composite(out, img, 0, 0)
    return out
