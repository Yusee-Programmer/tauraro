# std.image.qoi — "Quite OK Image" format decode/encode.
#
# Pure Tauraro implementation of the QOI spec (https://qoiformat.org/qoi-specification.pdf).
# No external compression library needed — QOI's byte-oriented RLE + diff
# scheme is simple enough to implement directly.
#
# File layout (big-endian for the header's multi-byte fields):
#   HEADER (14 bytes):
#     bytes 0-3  magic "qoif"
#     bytes 4-7  width  (u32, big-endian)
#     bytes 8-11 height (u32, big-endian)
#     byte  12   channels (3 = RGB, 4 = RGBA; informational only here —
#                this codec always decodes/encodes full RGBA8)
#     byte  13   colorspace (0 = sRGB with linear alpha, 1 = all linear;
#                informational only, not applied as a transform)
#   BODY: a stream of chunks (see _OP_* below), one per pixel's worth of
#         output (OP_RUN encodes several identical pixels in one chunk).
#   END MARKER: 7 bytes of 0x00 followed by one byte of 0x01.
#
# Chunk tags (high bits of the first chunk byte):
#   QOI_OP_RGB    0b11111110 (0xFE) + raw r,g,b                 (alpha unchanged)
#   QOI_OP_RGBA   0b11111111 (0xFF) + raw r,g,b,a
#   QOI_OP_INDEX  0b00xxxxxx         6-bit index into a 64-entry running
#                                    color cache (index = hash(px) % 64)
#   QOI_OP_DIFF   0b01xxxxxx         2-bit signed diffs (bias +2) for dr,dg,db
#                                    vs. the previous pixel; alpha unchanged
#   QOI_OP_LUMA   0b10xxxxxx         6-bit dg (bias +32) + a second byte with
#                                    4-bit (dr-dg) and 4-bit (db-dg) (bias +8)
#   QOI_OP_RUN    0b11xxxxxx         6-bit run length (bias -1, so 1..62) of
#                                    the previous pixel repeated
#
# Note on binary strings: `str` here is always used as a raw byte buffer
# with an explicit length — never via C strlen — since QOI bytes routinely
# contain embedded NUL bytes.

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]

from std.image.mod import Image
from std.core.vec import Vec
from std.io.archive import ByteBuf

def _rd_u32be(data: str, off: int) -> int:
    mut p = data as Pointer[char]
    mut b0 = 0
    mut b1 = 0
    mut b2 = 0
    mut b3 = 0
    unsafe:
        b0 = p.offset(off).read()     as int & 0xFF
        b1 = p.offset(off + 1).read() as int & 0xFF
        b2 = p.offset(off + 2).read() as int & 0xFF
        b3 = p.offset(off + 3).read() as int & 0xFF
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

def _bad_image() -> Image:
    mut bad = Image()
    bad.width  = -1
    bad.height = -1
    bad.pixels = Vec[u8].init(1)
    return bad

def _qoi_hash(r: int, g: int, b: int, a: int) -> int:
    return (r * 3 + g * 5 + b * 7 + a * 11) & 63

# Decode `len_` bytes of QOI data into a canonical RGBA8 Image. Returns an
# Image with width == -1 on malformed input (too short, bad magic, or a
# body that runs out of bytes before producing width*height pixels).
pub def decode_qoi(data: str, len_: int) -> Image:
    if len_ < 14 + 8:
        return _bad_image()

    mut p = data as Pointer[char]
    mut m0 = 0
    mut m1 = 0
    mut m2 = 0
    mut m3 = 0
    unsafe:
        m0 = p.offset(0).read() as int & 0xFF
        m1 = p.offset(1).read() as int & 0xFF
        m2 = p.offset(2).read() as int & 0xFF
        m3 = p.offset(3).read() as int & 0xFF
    if m0 != 0x71 or m1 != 0x6F or m2 != 0x69 or m3 != 0x66:   # "qoif"
        return _bad_image()

    mut width  = _rd_u32be(data, 4)
    mut height = _rd_u32be(data, 8)
    if width <= 0 or height <= 0:
        return _bad_image()

    mut n_pixels = width * height
    mut img = Image.init(width, height)

    # 64-entry running color cache, index = _qoi_hash(px) % 64. Stored as
    # four flat int arrays (r/g/b/a) for simplicity.
    mut cache_r: List[int] = []
    mut cache_g: List[int] = []
    mut cache_b: List[int] = []
    mut cache_a: List[int] = []
    mut ci = 0
    while ci < 64:
        cache_r.append(0)
        cache_g.append(0)
        cache_b.append(0)
        cache_a.append(0)
        ci = ci + 1

    mut r = 0
    mut g = 0
    mut b = 0
    mut a = 255

    mut off = 14
    mut px_i = 0
    mut run = 0

    while px_i < n_pixels:
        if run > 0:
            run = run - 1
        else:
            if off >= len_:
                return _bad_image()   # truncated body
            mut tag_byte = 0
            unsafe:
                tag_byte = p.offset(off).read() as int & 0xFF
            off = off + 1

            if tag_byte == 0xFE:        # QOI_OP_RGB
                if off + 3 > len_:
                    return _bad_image()
                unsafe:
                    r = p.offset(off).read()     as int & 0xFF
                    g = p.offset(off + 1).read() as int & 0xFF
                    b = p.offset(off + 2).read() as int & 0xFF
                off = off + 3
            elif tag_byte == 0xFF:      # QOI_OP_RGBA
                if off + 4 > len_:
                    return _bad_image()
                unsafe:
                    r = p.offset(off).read()     as int & 0xFF
                    g = p.offset(off + 1).read() as int & 0xFF
                    b = p.offset(off + 2).read() as int & 0xFF
                    a = p.offset(off + 3).read() as int & 0xFF
                off = off + 4
            else:
                mut tag2 = (tag_byte >> 6) & 0x03
                if tag2 == 0:            # QOI_OP_INDEX
                    mut idx = tag_byte & 0x3F
                    r = cache_r[idx]
                    g = cache_g[idx]
                    b = cache_b[idx]
                    a = cache_a[idx]
                elif tag2 == 1:          # QOI_OP_DIFF
                    mut dr = ((tag_byte >> 4) & 0x03) - 2
                    mut dg = ((tag_byte >> 2) & 0x03) - 2
                    mut db = (tag_byte & 0x03) - 2
                    r = (r + dr) & 0xFF
                    g = (g + dg) & 0xFF
                    b = (b + db) & 0xFF
                elif tag2 == 2:          # QOI_OP_LUMA
                    if off + 1 > len_:
                        return _bad_image()
                    mut byte2 = 0
                    unsafe:
                        byte2 = p.offset(off).read() as int & 0xFF
                    off = off + 1
                    mut dg = (tag_byte & 0x3F) - 32
                    mut dr_dg = ((byte2 >> 4) & 0x0F) - 8
                    mut db_dg = (byte2 & 0x0F) - 8
                    g = (g + dg) & 0xFF
                    r = (r + dg + dr_dg) & 0xFF
                    b = (b + dg + db_dg) & 0xFF
                else:                    # QOI_OP_RUN
                    run = (tag_byte & 0x3F)   # already biased: run of (value+1) total, value more after this pixel
                    # Spec: run length = (tag & 0x3F) + 1 pixels total,
                    # INCLUDING the current one. We've already "produced"
                    # this one pixel at the bottom of the loop, so the
                    # remaining repeats is (run_total - 1) = tag & 0x3F.

                mut cidx = _qoi_hash(r, g, b, a)
                cache_r[cidx] = r
                cache_g[cidx] = g
                cache_b[cidx] = b
                cache_a[cidx] = a

        mut y = px_i / width
        mut x = px_i % width
        img.set_pixel(x, y, r, g, b, a)
        px_i = px_i + 1

    return img

# Encode `img` as QOI bytes (always emitted as 4-channel RGBA, sRGB
# colorspace byte). Returns (bytes, length) directly since QOI output can
# contain embedded NUL bytes.
pub def encode_qoi(img: Image) -> (str, int):
    mut width  = img.width
    mut height = img.height

    mut buf = ByteBuf.init(14 + width * height * 2 + 8)

    # Header
    buf.push_u8(0x71)   # 'q'
    buf.push_u8(0x6F)   # 'o'
    buf.push_u8(0x69)   # 'i'
    buf.push_u8(0x66)   # 'f'
    buf.push_u8((width >> 24) & 0xFF)
    buf.push_u8((width >> 16) & 0xFF)
    buf.push_u8((width >> 8) & 0xFF)
    buf.push_u8(width & 0xFF)
    buf.push_u8((height >> 24) & 0xFF)
    buf.push_u8((height >> 16) & 0xFF)
    buf.push_u8((height >> 8) & 0xFF)
    buf.push_u8(height & 0xFF)
    buf.push_u8(4)   # channels = RGBA
    buf.push_u8(0)   # colorspace = sRGB

    mut cache_r: List[int] = []
    mut cache_g: List[int] = []
    mut cache_b: List[int] = []
    mut cache_a: List[int] = []
    mut ci = 0
    while ci < 64:
        cache_r.append(0)
        cache_g.append(0)
        cache_b.append(0)
        cache_a.append(0)
        ci = ci + 1

    mut prev_r = 0
    mut prev_g = 0
    mut prev_b = 0
    mut prev_a = 255

    mut n_pixels = width * height
    mut px_i = 0
    mut run = 0

    while px_i < n_pixels:
        mut y = px_i / width
        mut x = px_i % width
        mut r, g, b, a = img.get_pixel(x, y)

        if r == prev_r and g == prev_g and b == prev_b and a == prev_a:
            run = run + 1
            if run == 62 or px_i == n_pixels - 1:
                buf.push_u8(0xC0 | (run - 1))
                run = 0
        else:
            if run > 0:
                buf.push_u8(0xC0 | (run - 1))
                run = 0

            mut idx = _qoi_hash(r, g, b, a)
            if cache_r[idx] == r and cache_g[idx] == g and cache_b[idx] == b and cache_a[idx] == a:
                buf.push_u8(idx & 0x3F)
            else:
                cache_r[idx] = r
                cache_g[idx] = g
                cache_b[idx] = b
                cache_a[idx] = a

                if a == prev_a:
                    mut dr = r - prev_r
                    mut dg = g - prev_g
                    mut db = b - prev_b
                    # Wrap diffs into signed [-128,127] range (mod 256) so a
                    # wraparound-equal channel (e.g. 0 -> 255) is seen as -1.
                    if dr > 127: dr = dr - 256
                    if dr < -128: dr = dr + 256
                    if dg > 127: dg = dg - 256
                    if dg < -128: dg = dg + 256
                    if db > 127: db = db - 256
                    if db < -128: db = db + 256

                    if dr >= -2 and dr <= 1 and dg >= -2 and dg <= 1 and db >= -2 and db <= 1:
                        buf.push_u8(0x40 | ((dr + 2) << 4) | ((dg + 2) << 2) | (db + 2))
                    else:
                        mut dr_dg = dr - dg
                        mut db_dg = db - dg
                        if dr_dg > 127: dr_dg = dr_dg - 256
                        if dr_dg < -128: dr_dg = dr_dg + 256
                        if db_dg > 127: db_dg = db_dg - 256
                        if db_dg < -128: db_dg = db_dg + 256

                        if dg >= -32 and dg <= 31 and dr_dg >= -8 and dr_dg <= 7 and db_dg >= -8 and db_dg <= 7:
                            buf.push_u8(0x80 | (dg + 32))
                            buf.push_u8(((dr_dg + 8) << 4) | (db_dg + 8))
                        else:
                            buf.push_u8(0xFE)
                            buf.push_u8(r)
                            buf.push_u8(g)
                            buf.push_u8(b)
                else:
                    buf.push_u8(0xFF)
                    buf.push_u8(r)
                    buf.push_u8(g)
                    buf.push_u8(b)
                    buf.push_u8(a)

        prev_r = r
        prev_g = g
        prev_b = b
        prev_a = a
        px_i = px_i + 1

    # End marker: 7 zero bytes + one 0x01 byte.
    mut ei = 0
    while ei < 7:
        buf.push_u8(0)
        ei = ei + 1
    buf.push_u8(1)

    mut out_len = buf.len
    mut result = buf.to_str()
    buf.free()
    return (result, out_len)
