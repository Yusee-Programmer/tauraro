# std.net.mailio -- shared line/byte transport for the mail protocol clients
# (std.net.pop3, std.net.imap) plus a few RFC 5322 header helpers.
#
# MailConn is a buffered, bounded-wait wrapper over a TcpStream (or the runtime's
# implicit-TLS client handle): read_line() / read_exact() never block longer than
# `timeout_ms` per call on plain TCP (non-blocking socket polled with 1 ms sleeps),
# data is binary safe (NUL and high bytes survive), and a line is limited to
# `max_line` bytes so a hostile server cannot make the client buffer forever.
#
# TLS note: connect_tls() uses the same OpenSSL client primitive as std.net.smtp /
# std.net.https. It does NOT verify certificates (the runtime has no verification
# hooks) and its reads are blocking (no timeout); sending is NUL-terminated
# (strlen-based), so NUL bytes in a message cannot be sent over TLS. STARTTLS upgrade in
# place is not possible with the runtime (see std.net.smtp); use implicit TLS ports (993 / 995)
# and treat the connection as unauthenticated against active attackers.

from std.core.string import StringBuilder
from std.net.tcp import TcpStream
from std.net.wire import wire_u8
from std.net.wire import wire_slice
from std.net.wire import wire_slice_ptr
from std.sys.time import Clock

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_tcp_recv_nb(fd: int, buf: Pointer[char], cap: int) -> int
    def _tr_tcp_send_raw(fd: int, buf: Pointer[char], len: int) -> int
    def _tr_tls_connect(host: str, port: int) -> Pointer[char]
    def _tr_tls_send(handle: Pointer[char], data: str) -> int
    def _tr_tls_recv(handle: Pointer[char], cap: int) -> str
    def _tr_tls_close(handle: Pointer[char])

pub class MailConn:
    pub tcp:        TcpStream
    pub ok:         bool
    pub err:        str
    pub timeout_ms: int       # max wait for one line / one read (default 10000)
    pub max_line:   int       # longest accepted line in bytes (default 1 MiB)
    tls:            Pointer[char]
    use_tls:        bool
    buf:            StringBuilder
    rpos:           int
    rbuf:           Pointer[char]

extend MailConn:
    pub def connect(host: str, port: int, timeout_ms: int) -> MailConn:
        mut c = MailConn()
        c.timeout_ms = timeout_ms
        c.max_line = 1048576
        c.err = ""
        c.use_tls = false
        c.tls = 0 as Pointer[char]
        c.buf = StringBuilder.init(4096)
        c.rpos = 0
        c.rbuf = _tr_c_malloc(8193)
        c.tcp = TcpStream.connect(host, port)
        c.ok = c.tcp.is_connected()
        if not c.ok:
            c.err = "connect to " + host + ":" + port.to_string() + " failed"
            return c
        c.tcp.set_nonblocking()
        return c

    # Wrap an already connected stream (e.g. one returned by TcpListener.accept) --
    # for servers and test doubles. The stream is switched to non-blocking mode.
    pub def from_stream(tcp: TcpStream, timeout_ms: int) -> MailConn:
        mut c = MailConn()
        c.timeout_ms = timeout_ms
        c.max_line = 1048576
        c.err = ""
        c.use_tls = false
        c.tls = 0 as Pointer[char]
        c.buf = StringBuilder.init(4096)
        c.rpos = 0
        c.rbuf = _tr_c_malloc(8193)
        c.tcp = tcp
        c.ok = tcp.is_connected()
        if c.ok: c.tcp.set_nonblocking()
        return c

    # Implicit TLS (certificates NOT verified; blocking reads; see the module note).
    pub def connect_tls(host: str, port: int, timeout_ms: int) -> MailConn:
        mut c = MailConn()
        c.timeout_ms = timeout_ms
        c.max_line = 1048576
        c.err = ""
        c.use_tls = true
        c.buf = StringBuilder.init(4096)
        c.rpos = 0
        c.rbuf = _tr_c_malloc(8193)
        c.tcp = TcpStream()
        c.tls = _tr_tls_connect(host, port)
        c.ok = (c.tls as usize) != 0
        if not c.ok: c.err = "TLS connect to " + host + ":" + port.to_string() + " failed"
        return c

    # Unread bytes currently buffered.
    pub def pending(self) -> int:
        return self.buf.len() - self.rpos

    # Read once from the transport into the buffer, waiting until `deadline`
    # (absolute Clock.now_ms()). >0 bytes added, 0 = peer closed, -1 = error, -3 = timeout.
    def fill(self, deadline: int) -> int:
        if self.use_tls:
            mut chunk = _tr_tls_recv(self.tls, 4096)
            if chunk.len() == 0: return 0
            self.buf.append(chunk)
            return chunk.len()
        while true:
            mut n = _tr_tcp_recv_nb(self.tcp.fd, self.rbuf, 8192)
            if n == -2:
                if Clock.now_ms() >= deadline: return -3
                Clock.sleep_ms(1)
            elif n < 0:
                return -1
            elif n == 0:
                return 0
            else:
                self.buf.append(wire_slice_ptr(self.rbuf, n))
                return n
        return -1

    def compact(self):
        if self.rpos > 0 and self.rpos >= self.buf.len():
            self.buf.clear()
            self.rpos = 0

    # One line without its CRLF (a bare LF also ends a line).
    pub def read_line(self) throws str -> str:
        mut deadline = Clock.now_ms() + self.timeout_ms
        mut scan = self.rpos
        while true:
            mut total = self.buf.len()
            mut i = scan
            while i < total:
                unsafe:
                    if (self.buf.buf.data.offset(i).read() as int) == 10:
                        mut end = i
                        if end > self.rpos and (self.buf.buf.data.offset(end - 1).read() as int) == 13: end = end - 1
                        mut line = wire_slice_ptr(self.buf.buf.data.offset(self.rpos), end - self.rpos)
                        self.rpos = i + 1
                        self.compact()
                        return line
                i = i + 1
            scan = total
            if total - self.rpos > self.max_line:
                self.ok = false
                raise("line longer than " + self.max_line.to_string() + " bytes")
            mut r = self.fill(deadline)
            if r == -3: raise("timeout")
            if r == 0:
                self.ok = false
                raise("connection closed by the server")
            if r < 0:
                self.ok = false
                raise("read error")
        return ""

    # Exactly n bytes (binary safe).
    pub def read_exact(self, n: int) throws str -> str:
        if n < 0: raise("negative length")
        mut deadline = Clock.now_ms() + self.timeout_ms
        while self.buf.len() - self.rpos < n:
            mut r = self.fill(deadline)
            if r == -3: raise("timeout")
            if r == 0:
                self.ok = false
                raise("connection closed by the server")
            if r < 0:
                self.ok = false
                raise("read error")
        mut out = ""
        unsafe:
            out = wire_slice_ptr(self.buf.buf.data.offset(self.rpos), n)
        self.rpos = self.rpos + n
        self.compact()
        return out

    # Send all bytes (a trailing CRLF is the caller's job). False on failure.
    pub def send(self, data: str) -> bool:
        if not self.ok: return false
        if self.use_tls: return _tr_tls_send(self.tls, data) >= 0
        mut n = data.len()
        mut deadline = Clock.now_ms() + self.timeout_ms
        mut sent = 0
        while sent < n:
            mut r = 0
            unsafe:
                r = _tr_tcp_send_raw(self.tcp.fd, (data as Pointer[char]).offset(sent), n - sent)
            if r == -2:
                if Clock.now_ms() >= deadline: return false
                Clock.sleep_ms(1)
            elif r <= 0:
                self.ok = false
                return false
            else:
                sent = sent + r
        return true

    pub def close(self):
        if self.use_tls:
            if (self.tls as usize) != 0:
                _tr_tls_close(self.tls)
                self.tls = 0 as Pointer[char]
        else:
            self.tcp.close()
        self.ok = false

# ---------------------------------------------------------------------------
# RFC 5322 helpers
# ---------------------------------------------------------------------------

# The header block of a message (everything before the first empty line), without
# the empty line. A message with no body returns all of it.
pub def mail_header_block(msg: str) -> str:
    mut n = msg.len()
    mut i = 0
    while i < n:
        mut c = wire_u8(msg, i)
        if c == 10:
            if i + 1 < n and wire_u8(msg, i + 1) == 10: return wire_slice(msg, 0, i + 1)
            if i + 2 < n and wire_u8(msg, i + 1) == 13 and wire_u8(msg, i + 2) == 10: return wire_slice(msg, 0, i + 1)
        i = i + 1
    return msg

# Everything after the first empty line ("" if there is none).
pub def mail_body_part(msg: str) -> str:
    mut n = msg.len()
    mut i = 0
    while i < n:
        if wire_u8(msg, i) == 10:
            if i + 1 < n and wire_u8(msg, i + 1) == 10: return wire_slice(msg, i + 2, n - i - 2)
            if i + 2 < n and wire_u8(msg, i + 1) == 13 and wire_u8(msg, i + 2) == 10: return wire_slice(msg, i + 3, n - i - 3)
        i = i + 1
    return ""

def _lc(c: int) -> int:
    if c >= 65 and c <= 90: return c + 32
    return c

# Value of the first header called `name` (case-insensitive), with folded
# continuation lines unfolded (CRLF + leading whitespace -> one space) and surrounding
# whitespace trimmed. "" if absent. Works on a header block or a whole message.
pub def mail_header(msg: str, name: str) -> str:
    mut hb = mail_header_block(msg)
    mut n = hb.len()
    mut nl = name.len()
    mut i = 0
    while i < n:
        # start of a header line at i
        mut j = i
        while j < n and wire_u8(hb, j) != 10: j = j + 1
        mut hit = false
        if j - i > nl and wire_u8(hb, i + nl) == 58:
            hit = true
            mut k = 0
            while k < nl:
                if _lc(wire_u8(hb, i + k)) != _lc(wire_u8(name, k)): hit = false
                k = k + 1
        if hit:
            mut sb = StringBuilder.init(80)
            mut p = i + nl + 1
            mut e = j
            while true:
                # append hb[p..e) without trailing CR
                mut q = e
                if q > p and wire_u8(hb, q - 1) == 13: q = q - 1
                sb.append(wire_slice(hb, p, q - p))
                # continuation?
                if e + 1 < n and (wire_u8(hb, e + 1) == 32 or wire_u8(hb, e + 1) == 9):
                    sb.append_char(32)
                    p = e + 1
                    while p < n and (wire_u8(hb, p) == 32 or wire_u8(hb, p) == 9): p = p + 1
                    e = p
                    while e < n and wire_u8(hb, e) != 10: e = e + 1
                else:
                    break
            mut raw = sb.to_owned()
            sb.free()
            return _trim(raw)
        i = j + 1
    return ""

def _trim(s: str) -> str:
    mut a = 0
    mut b = s.len()
    while a < b and (wire_u8(s, a) == 32 or wire_u8(s, a) == 9): a = a + 1
    while b > a and (wire_u8(s, b - 1) == 32 or wire_u8(s, b - 1) == 9): b = b - 1
    return wire_slice(s, a, b - a)
