# std.net.url — URL parsing and building.

from std.core.string import StringBuilder
from std.core.vec import Vec
from std.string.str import Str
from std.string.fmt import Fmt

pub class Url:
    pub scheme:   str
    pub host:     str
    pub port:     int
    pub path:     str
    pub query:    str
    pub fragment: str

extend Url:
    pub def init(host: str, port: int, path: str) -> Url:
        mut u = Url()
        u.scheme   = "http"
        u.host     = host
        u.port     = port
        u.path     = path
        u.query    = ""
        u.fragment = ""
        return u

    pub def with_scheme(self, scheme: str) -> Url:
        self.scheme = scheme
        return self

    pub def with_query(self, query: str) -> Url:
        self.query = query
        return self

    pub def with_fragment(self, fragment: str) -> Url:
        self.fragment = fragment
        return self

    pub def free(self):
        unsafe: _tr_c_free(self as Pointer[char])

    # ── Parsing ───────────────────────────────────────────────────────────────

    # Parse a full URL string into a Url.  Unrecognised parts are left empty.
    pub def parse(url_str: str) -> Url:
        mut u      = Url()
        u.scheme   = ""
        u.host     = ""
        u.port     = 0
        u.path     = "/"
        u.query    = ""
        u.fragment = ""
        mut slen   = Str.len(url_str)
        mut sep    = Str.index_of(url_str, "://")
        if sep < 0: return u
        u.scheme = Str.slice(url_str, 0, sep)
        mut rest = Str.slice(url_str, sep + 3, slen)
        mut rlen = Str.len(rest)
        # Isolate authority (before first '/')
        mut slash_pos = Str.index_of(rest, "/")
        mut authority = rest
        mut after_auth = "/"
        # "http://host?x=1" / "http://host#frag": no '/' before the query or
        # fragment, so the authority ends at the first '?' or '#'.
        mut cut_q = Str.index_of(rest, "?")
        mut cut_h = Str.index_of(rest, "#")
        mut cut   = cut_q
        if cut < 0 or (cut_h >= 0 and cut_h < cut): cut = cut_h
        if cut >= 0 and (slash_pos < 0 or cut < slash_pos):
            authority  = Str.slice(rest, 0, cut)
            mut tail   = Str.slice(rest, cut, rlen)
            after_auth = "/" + tail
        elif slash_pos >= 0:
            authority  = Str.slice(rest, 0, slash_pos)
            after_auth = Str.slice(rest, slash_pos, rlen)
        unsafe: _tr_c_free(rest as Pointer[char])
        # Split authority by ':' for port
        mut colon = Str.index_of(authority, ":")
        if colon >= 0:
            u.host = Str.slice(authority, 0, colon)
            u.port = Str.parse_int(Str.slice(authority, colon + 1, Str.len(authority)))
        else:
            u.host = authority
            u.port = Url._default_port_for(u.scheme)
        # Separate path, query, fragment from after_auth
        mut alen  = Str.len(after_auth)
        mut q_pos = Str.index_of(after_auth, "?")
        mut h_pos = Str.index_of(after_auth, "#")
        if q_pos >= 0:
            u.path       = Str.slice(after_auth, 0, q_pos)
            mut after_q  = Str.slice(after_auth, q_pos + 1, alen)
            mut aq_len   = Str.len(after_q)
            mut h_in_q   = Str.index_of(after_q, "#")
            if h_in_q >= 0:
                u.query    = Str.slice(after_q, 0, h_in_q)
                u.fragment = Str.slice(after_q, h_in_q + 1, aq_len)
            else:
                u.query = after_q
            unsafe: _tr_c_free(after_q as Pointer[char])
        elif h_pos >= 0:
            u.path     = Str.slice(after_auth, 0, h_pos)
            u.fragment = Str.slice(after_auth, h_pos + 1, alen)
        else:
            if alen == 0:
                u.path = "/"
            else:
                u.path = after_auth
        unsafe:
            _tr_c_free(authority as Pointer[char])
            _tr_c_free(after_auth as Pointer[char])
        return u

    # ── Info ──────────────────────────────────────────────────────────────────

    # Return the conventional port for the scheme (0 if unknown).
    pub def default_port(self) -> int:
        return Url._default_port_for(self.scheme)

    def _default_port_for(scheme: str) -> int:
        if Str.eq(scheme, "https"): return 443
        if Str.eq(scheme, "http"):  return 80
        if Str.eq(scheme, "ftp"):   return 21
        if Str.eq(scheme, "ssh"):   return 22
        if Str.eq(scheme, "smtp"):  return 25
        return 0

    pub def is_https(self) -> bool:
        return Str.eq(self.scheme, "https")

    # True when scheme and host are both non-empty.
    pub def is_valid(self) -> bool:
        return Str.len(self.scheme) > 0 and Str.len(self.host) > 0

    # ── Serialisation ─────────────────────────────────────────────────────────

    pub def to_string(self) -> str:
        mut sb = StringBuilder.init(128)
        sb.append(self.scheme)
        sb.append("://")
        sb.append(self.host)
        mut def_port = Url._default_port_for(self.scheme)
        if self.port != 0 and self.port != def_port:
            sb.append(":")
            sb.append(Fmt.int_to_str(self.port))
        sb.append(self.path)
        if Str.len(self.query) > 0:
            sb.append("?")
            sb.append(self.query)
        if Str.len(self.fragment) > 0:
            sb.append("#")
            sb.append(self.fragment)
        mut out = sb.to_owned()
        sb.free()
        return out

    # ── Percent-encoding ──────────────────────────────────────────────────────

    # Percent-encode a URL component value (keeps unreserved chars as-is).
    pub def encode_component(s: str) -> str:
        mut slen = Str.len(s)
        mut sb   = StringBuilder.init(slen * 3 + 1)
        mut p    = s as Pointer[char]
        mut i    = 0
        while i < slen:
            mut c          = p.offset(i).read() as int
            mut unreserved = false
            if c >= 65 and c <= 90:  unreserved = true
            if c >= 97 and c <= 122: unreserved = true
            if c >= 48 and c <= 57:  unreserved = true
            if c == 45 or c == 95 or c == 46 or c == 126: unreserved = true
            if unreserved:
                sb.append_char(c)
            else:
                sb.append_char(37)
                mut hi = c / 16
                mut lo = c - hi * 16
                if hi < 10: sb.append_char(hi + 48)
                else:       sb.append_char(hi - 10 + 65)
                if lo < 10: sb.append_char(lo + 48)
                else:       sb.append_char(lo - 10 + 65)
            i = i + 1
        mut out = sb.to_owned()
        sb.free()
        return out

    # Decode a percent-encoded URL component.
    pub def decode_component(s: str) -> str:
        mut slen = Str.len(s)
        mut sb   = StringBuilder.init(slen + 1)
        mut p    = s as Pointer[char]
        mut i    = 0
        while i < slen:
            mut c = p.offset(i).read() as int
            if c == 37 and i + 2 < slen:
                mut h1 = p.offset(i + 1).read() as int
                mut h2 = p.offset(i + 2).read() as int
                mut v1 = 0
                mut v2 = 0
                if h1 >= 48 and h1 <= 57:   v1 = h1 - 48
                elif h1 >= 65 and h1 <= 70: v1 = h1 - 55
                elif h1 >= 97 and h1 <= 102: v1 = h1 - 87
                if h2 >= 48 and h2 <= 57:   v2 = h2 - 48
                elif h2 >= 65 and h2 <= 70: v2 = h2 - 55
                elif h2 >= 97 and h2 <= 102: v2 = h2 - 87
                sb.append_char(v1 * 16 + v2)
                i = i + 3
            else:
                sb.append_char(c)
                i = i + 1
        mut out = sb.to_owned()
        sb.free()
        return out

    # ── Client helpers (redirects, request lines) ─────────────────────────────

    # The request-target for an HTTP request line: path plus "?query" if any.
    pub def request_target(self) -> str:
        mut p = self.path
        if Str.len(p) == 0: p = "/"
        if Str.len(self.query) > 0:
            return p + "?" + self.query
        return p

    # The value for a Host header: host, plus ":port" when it is not the
    # scheme's default port.
    pub def host_header(self) -> str:
        mut def_port = Url._default_port_for(self.scheme)
        if self.port != 0 and self.port != def_port:
            return self.host + ":" + Fmt.int_to_str(self.port)
        return self.host

    # Lowercased "scheme://host:port" identity, used to compare origins.
    pub def origin(self) -> str:
        mut h = Str.to_lower(self.host)
        mut sc = Str.to_lower(self.scheme)
        return sc + "://" + h + ":" + Fmt.int_to_str(self.port)

    # Collapse "." and ".." segments of an absolute path (RFC 3986 5.2.4).
    pub def remove_dot_segments(path: str) -> str:
        if Str.len(path) == 0: return "/"
        mut segs = Str.split_to_vec(path, "/")
        mut out  = Vec[str].init(8)
        mut n    = segs.len
        mut i    = 0
        while i < n:
            mut seg = segs.get(i)
            mut last = i == n - 1
            if i == 0 and Str.len(seg) == 0:
                i = i + 1
                continue
            if Str.eq(seg, "."):
                if last: out.push("")
            elif Str.eq(seg, ".."):
                if out.len > 0: out.pop()
                if last: out.push("")
            else:
                out.push(seg)
            i = i + 1
        mut sb = StringBuilder.init(Str.len(path) + 2)
        mut j  = 0
        while j < out.len:
            sb.append("/")
            mut part = out.get(j)
            sb.append(part)
            j = j + 1
        if out.len == 0: sb.append("/")
        mut res = sb.to_owned()
        sb.free()
        return res

    # Resolve a (possibly relative) reference such as a Location header against
    # this URL (RFC 3986 section 5.2, without userinfo/IPv6 handling):
    #   "http://x/y"  absolute      "//h/p"  scheme-relative
    #   "/p?q"        absolute-path "p/q"    relative path (merged, dots removed)
    #   "?q"          same path, new query    "#f"  same URL, new fragment
    pub def resolve(self, rel: str) -> Url:
        mut rlen = Str.len(rel)
        mut out  = Url.init(self.host, self.port, self.path)
        out.scheme   = self.scheme
        out.query    = self.query
        out.fragment = ""
        if rlen == 0: return out
        # Absolute URL: a scheme (letters only) followed by "://".
        mut sep = Str.index_of(rel, "://")
        if sep > 0:
            mut pre_ok = true
            mut k = 0
            while k < sep:
                mut ch = Str.char_at(rel, k)
                mut is_l = (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122)
                if not is_l: pre_ok = false
                k = k + 1
            if pre_ok: return Url.parse(rel)
        if rlen >= 2 and Str.char_at(rel, 0) == 47 and Str.char_at(rel, 1) == 47:
            mut abs_text = self.scheme + ":" + rel
            return Url.parse(abs_text)
        # Split the reference into path / query / fragment.
        mut body = rel
        mut frag = ""
        mut hpos = Str.index_of(body, "#")
        if hpos >= 0:
            frag = Str.slice(body, hpos + 1, Str.len(body))
            body = Str.slice(body, 0, hpos)
        mut qry     = ""
        mut has_q   = false
        mut qpos    = Str.index_of(body, "?")
        if qpos >= 0:
            qry   = Str.slice(body, qpos + 1, Str.len(body))
            body  = Str.slice(body, 0, qpos)
            has_q = true
        out.fragment = frag
        if Str.len(body) == 0:
            # "?q" / "#f" only: keep the base path.
            if has_q: out.query = qry
            return out
        out.query = qry
        if Str.char_at(body, 0) == 47:
            out.path = Url.remove_dot_segments(body)
            return out
        mut base_path = self.path
        if Str.len(base_path) == 0: base_path = "/"
        mut ls = Str.last_index_of(base_path, "/")
        mut dir = "/"
        if ls >= 0: dir = Str.slice(base_path, 0, ls + 1)
        mut merged = dir + body
        out.path = Url.remove_dot_segments(merged)
        return out
