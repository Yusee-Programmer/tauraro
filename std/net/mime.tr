# std.net.mime — media (MIME) types: extension table, content sniffing,
# media-type parsing/formatting and charset conversion to UTF-8.
#
#   from std.net.mime import Mime, MediaType
#
#   Mime.type_for_path("site/app.wasm")        # "application/wasm"
#   Mime.type_for_path("notes")                # "application/octet-stream"
#   Mime.guess_type("x.unknown")               # "" (no default)
#   Mime.content_type_for("index.html")        # "text/html; charset=utf-8"
#   Mime.extension_for_type("image/jpeg")      # "jpg"
#   Mime.extensions_for_type("image/jpeg")     # ["jpg", "jfif", "jpe", ...]
#   Mime.sniff(first_bytes)                    # "image/png", "text/html", ...
#   Mime.matches("image/webp", "image/*")      # true
#
#   mut mt = Mime.parse("Text/HTML; Charset=\"UTF-8\"")?   # throws str
#   mt.essence()                               # "text/html"
#   mt.param("charset")                        # "UTF-8"
#   mt.charset()                               # "utf-8" (normalised)
#   mt.set_param("q", "a b")
#   mt.to_str()                                # "text/html; charset=UTF-8; q=\"a b\""
#
#   Mime.to_utf8(bytes, "windows-1252")?       # transcode to UTF-8 (throws on unknown)
#   Mime.decode_text(bytes, "iso-8859-1")      # lenient: unknown charset -> bytes unchanged
#
# The extension table (~420 extensions, ~320 types) is Python 3.14's built-in
# `mimetypes` table merged with the Debian media-types list (IANA + Apache
# mime.types) and hand-picked modern types (wasm, avif, jxl, woff2, mjs,
# jsonld, webmanifest, toml, yaml, heic, ...). Each type's first extension is
# its preferred one. ".tr" maps to text/x-tauraro (not troff).
#
# Sniffing follows the WHATWG MIME Sniffing standard's "identify an unknown
# MIME type" (HTML/XML/PDF/PostScript, BOMs, image, audio/video, font and
# archive signatures, binary-byte test) with additions: wasm, FLAC, MP4/HEIC/
# AVIF brands, OGG codecs, ZIP containers that name their type (EPUB, ODF),
# 7z/xz/bzip2/zstd/tar, ELF/PE, SQLite, TIFF and a JSON heuristic.
#
# Parsing follows RFC 2045 §5.1 / RFC 9110 §8.3.1 (token / quoted-string
# parameters, case-insensitive type and parameter names) and decodes RFC 2231
# extended parameters (name*=utf-8''%E2%82%AC, name*0*=..., name*1=...),
# converting the declared charset to UTF-8. Values that are not valid tokens or
# quoted strings are accepted leniently up to the next ';'.

from std.core.string import StringBuilder

# ─── byte helpers ─────────────────────────────────────────────────────────────

def _mb(s: str, i: int) -> int:
    mut p = s as Pointer[char]
    unsafe: return (p.offset(i).read() as int) & 255

def _hexv(c: int) -> int:
    if c >= 48 and c <= 57: return c - 48
    if c >= 65 and c <= 70: return c - 55
    if c >= 97 and c <= 102: return c - 87
    return -1

def _hexd(v: int) -> int:
    if v < 10: return 48 + v
    return 55 + v

# RFC 9110 tchar.
def _is_tchar(c: int) -> bool:
    if c >= 48 and c <= 57: return true
    if c >= 65 and c <= 90: return true
    if c >= 97 and c <= 122: return true
    if c == 33 or c == 35 or c == 36 or c == 37 or c == 38 or c == 39 or c == 42: return true
    if c == 43 or c == 45 or c == 46 or c == 94 or c == 95 or c == 96 or c == 124 or c == 126: return true
    return false

def _is_ws(c: int) -> bool:
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 12

# Append the UTF-8 encoding of code point cp.
def _put_utf8(sb: StringBuilder, cp: int):
    if cp < 128:
        sb.append_char(cp)
    elif cp < 2048:
        sb.append_char(192 | (cp >> 6))
        sb.append_char(128 | (cp & 63))
    elif cp < 65536:
        sb.append_char(224 | (cp >> 12))
        sb.append_char(128 | ((cp >> 6) & 63))
        sb.append_char(128 | (cp & 63))
    else:
        sb.append_char(240 | (cp >> 18))
        sb.append_char(128 | ((cp >> 12) & 63))
        sb.append_char(128 | ((cp >> 6) & 63))
        sb.append_char(128 | (cp & 63))

# Windows-1252 0x80..0x9F -> Unicode (undefined slots map to the C1 control,
# as in the WHATWG index).
def _cp1252_hi(b: int) -> int:
    if b == 128: return 8364
    if b == 130: return 8218
    if b == 131: return 402
    if b == 132: return 8222
    if b == 133: return 8230
    if b == 134: return 8224
    if b == 135: return 8225
    if b == 136: return 710
    if b == 137: return 8240
    if b == 138: return 352
    if b == 139: return 8249
    if b == 140: return 338
    if b == 142: return 381
    if b == 145: return 8216
    if b == 146: return 8217
    if b == 147: return 8220
    if b == 148: return 8221
    if b == 149: return 8226
    if b == 150: return 8211
    if b == 151: return 8212
    if b == 152: return 732
    if b == 153: return 8482
    if b == 154: return 353
    if b == 155: return 8250
    if b == 156: return 339
    if b == 158: return 382
    if b == 159: return 376
    return b

def _latin9(b: int) -> int:
    if b == 164: return 8364
    if b == 166: return 352
    if b == 168: return 353
    if b == 180: return 381
    if b == 184: return 382
    if b == 188: return 338
    if b == 189: return 339
    if b == 190: return 376
    return b

# The extension table: "\n" + one "type ext ext ...\n" line per type, the
# preferred extension first. Generated from Python 3.14 mimetypes + Debian
# media-types (/etc/mime.types) + a hand-curated modern list.
