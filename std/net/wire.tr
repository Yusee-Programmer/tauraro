# std.net.wire -- small binary-safe byte helpers shared by the std.net protocol
# modules (ntp, mdns, ...). A Tauraro `str` carries its real length, so these work
# on data containing NUL and bytes >= 0x80. Offsets are NOT bounds-checked: callers
# (the decoders) check lengths first.

from std.core.string import StringBuilder

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_c_memcpy(dst: Pointer[char], src: Pointer[char], n: int)
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

# Byte at `off` (0..255).
pub def wire_u8(s: str, off: int) -> int:
    mut p = s as Pointer[char]
    unsafe:
        return (p.offset(off).read() as int) & 0xFF

# Big-endian 16-bit / 32-bit unsigned integer at `off`.
pub def wire_u16(s: str, off: int) -> int:
    return (wire_u8(s, off) << 8) | wire_u8(s, off + 1)

pub def wire_u32(s: str, off: int) -> int:
    return (wire_u8(s, off) << 24) | (wire_u8(s, off + 1) << 16) | (wire_u8(s, off + 2) << 8) | wire_u8(s, off + 3)

# Copy of s[off .. off+n) as a new binary-safe str.
pub def wire_slice(s: str, off: int, n: int) -> str:
    mut out = _tr_c_malloc(n + 1)
    if n > 0:
        unsafe:
            _tr_c_memcpy(out, (s as Pointer[char]).offset(off), n)
    unsafe: out.offset(n).write('\0')
    return _tr_str_wrap_len(out, n)

# Append big-endian 16 / 32-bit integers.
pub def wire_put_u16(sb: StringBuilder, v: int):
    sb.append_char((v >> 8) & 0xFF)
    sb.append_char(v & 0xFF)

pub def wire_put_u32(sb: StringBuilder, v: int):
    sb.append_char((v >> 24) & 0xFF)
    sb.append_char((v >> 16) & 0xFF)
    sb.append_char((v >> 8) & 0xFF)
    sb.append_char(v & 0xFF)

# Binary-safe concatenation (`+` stops at the first NUL).
pub def wire_concat(a: str, b: str) -> str:
    mut sb = StringBuilder.init(a.len() + b.len() + 8)
    sb.append(a)
    sb.append(b)
    mut out = sb.to_owned()
    sb.free()
    return out

# Binary-safe equality (`==` is strcmp-like).
pub def wire_eq(a: str, b: str) -> bool:
    if a.len() != b.len(): return false
    mut i = 0
    while i < a.len():
        if wire_u8(a, i) != wire_u8(b, i): return false
        i = i + 1
    return true

# Lower-case hex of every byte ("00ff10").
pub def wire_hex(s: str) -> str:
    mut sb = StringBuilder.init(s.len() * 2 + 4)
    mut i = 0
    while i < s.len():
        mut b = wire_u8(s, i)
        sb.append_char(_wire_hexdigit(b >> 4))
        sb.append_char(_wire_hexdigit(b & 15))
        i = i + 1
    mut out = sb.to_owned()
    sb.free()
    return out

def _wire_hexdigit(v: int) -> int:
    if v < 10: return 48 + v
    return 87 + v

# Inverse of wire_hex (ignores spaces; "" on odd length / bad digit).
pub def wire_unhex(h: str) -> str:
    mut sb = StringBuilder.init(h.len() / 2 + 4)
    mut hi = -1
    mut i = 0
    while i < h.len():
        mut c = wire_u8(h, i)
        i = i + 1
        if c == 32: continue
        mut d = -1
        if c >= 48 and c <= 57: d = c - 48
        elif c >= 97 and c <= 102: d = c - 87
        elif c >= 65 and c <= 70: d = c - 55
        if d < 0:
            sb.free()
            return ""
        if hi < 0:
            hi = d
        else:
            sb.append_char(hi * 16 + d)
            hi = -1
    mut out = ""
    if hi < 0: out = sb.to_owned()
    sb.free()
    return out
