# std.audio.wav — WAV (RIFF/WAVE) decode and encode, pure Tauraro.
#
#   from std.audio.wav import decode_wav, encode_wav, encode_wav_ex, WavTags
#
#   mut w = decode_wav(bytes, n)         # w.ok, w.buf (AudioBuffer), w.bits, w.tag(i)
#   mut out, olen = encode_wav(w.buf, 16, false)
#
# Decode  — format 1 (integer PCM: 8-bit unsigned, 16/24/32-bit signed),
#           format 3 (IEEE float 32/64), 6 (A-law), 7 (µ-law) and
#           WAVE_FORMAT_EXTENSIBLE wrapping PCM/float. Any channel count. Chunks
#           may come in any order; unknown chunks (fact, bext, cue, ...) are
#           skipped; a data chunk whose declared size runs past the end of the
#           file (streamed files, size 0 / 0xFFFFFFFF) is clamped to the bytes
#           actually present. LIST/INFO text chunks (INAM, IART, ICMT, ...) are
#           returned as tags.
# Encode  — 8/16/24/32-bit PCM or 32/64-bit float, rounding + clamping to the
#           range, optional LIST/INFO tags; >2 channels use WAVE_FORMAT_EXTENSIBLE.
#
# Samples become f32 in an std.audio.AudioBuffer, so 8/16/24-bit PCM round-trips
# exactly; 32-bit PCM keeps ~24 bits (f32 mantissa).

from std.audio.mod import AudioBuffer
from std.compress.common import rd8, rd16le, rd32le, CBuf, ptr_add
from std.core.vec import Vec

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_c_free(ptr: Pointer[char])
    def floor(x: float) -> float
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

# Result of decode_wav.
pub class WavFile:
    pub ok:     bool
    pub error:  str
    pub buf:    AudioBuffer
    pub format: int          # 1 = PCM, 3 = float, 6 = A-law, 7 = µ-law (extensible resolved)
    pub bits:   int          # bits per sample in the file
    pub tag_ids: Vec[str]    # LIST/INFO ids, e.g. "INAM"
    pub tag_vals: Vec[str]

extend WavFile:
    pub def tag_count(self) -> int:
        return self.tag_ids.len

    pub def tag_id(self, i: int) -> str:
        return self.tag_ids.get(i)

    pub def tag_value(self, i: int) -> str:
        return self.tag_vals.get(i)

    # Value of INFO tag `id` ("INAM" title, "IART" artist, "ICMT" comment, ...)
    # or "" when absent.
    pub def tag(self, id: str) -> str:
        mut i = 0
        while i < self.tag_ids.len:
            if self.tag_ids.get(i) == id:
                return self.tag_vals.get(i)
            i = i + 1
        return ""

    pub def free(self):
        self.buf.free()

# Tags to write into a LIST/INFO chunk.
pub class WavTags:
    pub ids:  Vec[str]
    pub vals: Vec[str]

extend WavTags:
    pub def init() -> WavTags:
        mut t = WavTags()
        t.ids = Vec[str].init(4)
        t.vals = Vec[str].init(4)
        return t

    # `id` must be a 4-character INFO id such as "INAM", "IART", "ICMT", "ICRD".
    pub def add(self, id: str, value: str):
        self.ids.push(id)
        self.vals.push(value)

def _fail(msg: str) -> WavFile:
    mut w = WavFile()
    w.ok = false
    w.error = msg
    w.buf = AudioBuffer.invalid()
    w.format = 0
    w.bits = 0
    w.tag_ids = Vec[str].init(1)
    w.tag_vals = Vec[str].init(1)
    return w

def _s8(v: int) -> int:
    if v >= 128:
        return v - 256
    return v

def _s16(v: int) -> int:
    if v >= 32768:
        return v - 65536
    return v

def _s24(v: int) -> int:
    if v >= 8388608:
        return v - 16777216
    return v

def _s32(v: int) -> int:
    if v >= 2147483648:
        return v - 4294967296
    return v

# G.711 expansion to 16-bit linear.
def _ulaw(u: int) -> int:
    mut x = (~u) & 0xFF
    mut sign = x & 0x80
    mut exp = (x >> 4) & 7
    mut man = x & 15
    mut s = (((man << 3) + 0x84) << exp) - 0x84
    if sign != 0:
        return 0 - s
    return s

def _alaw(a: int) -> int:
    mut x = a ^ 0x55
    mut sign = x & 0x80
    mut exp = (x >> 4) & 7
    mut man = x & 15
    mut s = 0
    if exp == 0:
        s = (man << 4) + 8
    else:
        s = ((man << 4) + 0x108) << (exp - 1)
    if sign != 0:
        return s
    return 0 - s

# f32/f64 from raw little-endian bits at byte offset `o` of p.
def _f32_at(p: Pointer[char], o: int, scratch: Pointer[char]) -> float:
    unsafe:
        scratch.offset(0).write(rd8(p, o) as char)
        scratch.offset(1).write(rd8(p, o + 1) as char)
        scratch.offset(2).write(rd8(p, o + 2) as char)
        scratch.offset(3).write(rd8(p, o + 3) as char)
        return (scratch as Pointer[f32]).read() as float

def _f64_at(p: Pointer[char], o: int, scratch: Pointer[char]) -> float:
    mut i = 0
    while i < 8:
        unsafe:
            scratch.offset(i).write(rd8(p, o + i) as char)
        i = i + 1
    unsafe:
        return (scratch as Pointer[f64]).read() as float

# Decode a WAV file. On failure `ok` is false, `error` says why and `buf` is
# the invalid buffer (rate == -1).
pub def decode_wav(data: str, len_: int) -> WavFile:
    if len_ < 12:
        return _fail("too short for a RIFF header")
    mut p = data as Pointer[char]
    if rd8(p, 0) != 0x52 or rd8(p, 1) != 0x49 or rd8(p, 2) != 0x46 or rd8(p, 3) != 0x46:
        return _fail("not a RIFF file")
    if rd8(p, 8) != 0x57 or rd8(p, 9) != 0x41 or rd8(p, 10) != 0x56 or rd8(p, 11) != 0x45:
        return _fail("not a WAVE file")
    mut fmt_tag = 0
    mut channels = 0
    mut rate = 0
    mut bits = 0
    mut block = 0
    mut have_fmt = false
    mut data_off = -1
    mut data_len = 0
    mut w = _fail("")
    mut pos = 12
    while pos + 8 <= len_:
        mut id0 = rd8(p, pos)
        mut id1 = rd8(p, pos + 1)
        mut id2 = rd8(p, pos + 2)
        mut id3 = rd8(p, pos + 3)
        mut sz = rd32le(p, pos + 4)
        mut body = pos + 8
        mut avail = len_ - body
        mut csz = sz
        if csz > avail:
            csz = avail
        if id0 == 0x66 and id1 == 0x6D and id2 == 0x74 and id3 == 0x20:           # "fmt "
            if csz < 16:
                return _fail("fmt chunk too short")
            fmt_tag = rd16le(p, body)
            channels = rd16le(p, body + 2)
            rate = rd32le(p, body + 4)
            block = rd16le(p, body + 12)
            bits = rd16le(p, body + 14)
            if fmt_tag == 0xFFFE and csz >= 26:
                fmt_tag = rd16le(p, body + 24)       # sub-format GUID starts with the tag
            have_fmt = true
        else:
            if id0 == 0x64 and id1 == 0x61 and id2 == 0x74 and id3 == 0x61:      # "data"
                if data_off < 0:
                    data_off = body
                    data_len = csz
            else:
                if id0 == 0x4C and id1 == 0x49 and id2 == 0x53 and id3 == 0x54:  # "LIST"
                    if csz >= 4 and rd8(p, body) == 0x49 and rd8(p, body + 1) == 0x4E and rd8(p, body + 2) == 0x46 and rd8(p, body + 3) == 0x4F:
                        # INFO sub-chunks
                        mut q = body + 4
                        mut end = body + csz
                        while q + 8 <= end:
                            mut ssz = rd32le(p, q + 4)
                            mut sb = q + 8
                            if sb + ssz > end:
                                ssz = end - sb
                            mut idb = _tr_c_malloc(5)
                            mut k = 0
                            while k < 4:
                                unsafe:
                                    idb.offset(k).write(rd8(p, q + k) as char)
                                k = k + 1
                            unsafe:
                                idb.offset(4).write('\0')
                            mut vl = ssz
                            while vl > 0 and rd8(p, sb + vl - 1) == 0:
                                vl = vl - 1
                            mut vb = _tr_c_malloc(vl + 1)
                            k = 0
                            while k < vl:
                                unsafe:
                                    vb.offset(k).write(rd8(p, sb + k) as char)
                                k = k + 1
                            unsafe:
                                vb.offset(vl).write('\0')
                            w.tag_ids.push(_tr_str_wrap_len(idb, 4))
                            w.tag_vals.push(_tr_str_wrap_len(vb, vl))
                            q = sb + ssz + (ssz & 1)
        pos = body + sz + (sz & 1)
        if sz > avail:
            pos = len_
    if not have_fmt:
        return _fail("no fmt chunk")
    if data_off < 0:
        return _fail("no data chunk")
    if channels < 1 or channels > 64:
        return _fail("bad channel count")
    if rate < 1:
        return _fail("bad sample rate")
    mut bps = bits / 8
    if fmt_tag == 6 or fmt_tag == 7:
        bps = 1
        if bits != 8:
            return _fail("G.711 must be 8 bits")
    else:
        if fmt_tag == 1:
            if bits != 8 and bits != 16 and bits != 24 and bits != 32:
                return _fail("unsupported PCM bit depth")
        else:
            if fmt_tag == 3:
                if bits != 32 and bits != 64:
                    return _fail("unsupported float bit depth")
            else:
                return _fail("unsupported WAV format tag")
    if bits % 8 != 0 or bps < 1:
        return _fail("bad bit depth")
    mut frame_bytes = bps * channels
    mut frames = data_len / frame_bytes
    mut buf = AudioBuffer.init(rate, channels, frames)
    mut scratch = _tr_c_malloc(8)
    mut i = 0
    mut total = frames * channels
    mut o = data_off
    while i < total:
        mut v = 0.0
        if fmt_tag == 1:
            if bits == 8:
                v = ((rd8(p, o) - 128) as float) / 128.0
            else:
                if bits == 16:
                    v = (_s16(rd16le(p, o)) as float) / 32768.0
                else:
                    if bits == 24:
                        v = (_s24(rd16le(p, o) | (rd8(p, o + 2) << 16)) as float) / 8388608.0
                    else:
                        v = (_s32(rd32le(p, o)) as float) / 2147483648.0
        else:
            if fmt_tag == 3:
                if bits == 32:
                    v = _f32_at(p, o, scratch)
                else:
                    v = _f64_at(p, o, scratch)
            else:
                if fmt_tag == 7:
                    v = (_ulaw(rd8(p, o)) as float) / 32768.0
                else:
                    v = (_alaw(rd8(p, o)) as float) / 32768.0
        unsafe:
            buf.data.offset(i).write(v as f32)
        o = o + bps
        i = i + 1
    _tr_c_free(scratch)
    w.ok = true
    w.error = ""
    w.buf.free()
    w.buf = buf
    w.format = fmt_tag
    w.bits = bits
    return w

# ── encoder ─────────────────────────────────────────────────────────────────

def _put_id(o: CBuf, a: int, b: int, c: int, d: int):
    o.push_u8(a)
    o.push_u8(b)
    o.push_u8(c)
    o.push_u8(d)

def _pad(o: CBuf):
    if (o.len & 1) != 0:
        o.push_u8(0)

def _patch32(o: CBuf, at: int, v: int):
    unsafe:
        o.data.offset(at).write((v & 0xFF) as char)
        o.data.offset(at + 1).write(((v >> 8) & 0xFF) as char)
        o.data.offset(at + 2).write(((v >> 16) & 0xFF) as char)
        o.data.offset(at + 3).write(((v >> 24) & 0xFF) as char)

def _rnd(x: float) -> int:
    return floor(x + 0.5) as int

# Encode `buf` as WAV with `bits` per sample (8/16/24/32) as integer PCM, or as
# IEEE float when `is_float` (bits 32 or 64). Returns (bytes, length); an empty
# string and length 0 for unsupported parameters.
pub def encode_wav(buf: AudioBuffer, bits: int, is_float: bool) -> (str, int):
    return encode_wav_ex(buf, bits, is_float, WavTags.init())

pub def encode_wav_ex(buf: AudioBuffer, bits: int, is_float: bool, tags: WavTags) -> (str, int):
    mut empty = CBuf.init(64)
    if not buf.valid():
        mut es = empty.to_str()
        empty.free()
        return (es, 0)
    if is_float:
        if bits != 32 and bits != 64:
            mut es2 = empty.to_str()
            empty.free()
            return (es2, 0)
    else:
        if bits != 8 and bits != 16 and bits != 24 and bits != 32:
            mut es3 = empty.to_str()
            empty.free()
            return (es3, 0)
    empty.free()
    mut ch = buf.channels
    mut bps = bits / 8
    mut dlen = buf.frames * ch * bps
    mut o = CBuf.init(dlen + 256)
    _put_id(o, 0x52, 0x49, 0x46, 0x46)                 # RIFF
    o.push_u32le(0)                                     # patched below
    _put_id(o, 0x57, 0x41, 0x56, 0x45)                 # WAVE
    _put_id(o, 0x66, 0x6D, 0x74, 0x20)                 # fmt
    mut ext = ch > 2
    if ext:
        o.push_u32le(40)
        o.push_u16le(0xFFFE)
    else:
        o.push_u32le(16)
        if is_float:
            o.push_u16le(3)
        else:
            o.push_u16le(1)
    o.push_u16le(ch)
    o.push_u32le(buf.rate)
    o.push_u32le(buf.rate * ch * bps)
    o.push_u16le(ch * bps)
    o.push_u16le(bits)
    if ext:
        o.push_u16le(22)
        o.push_u16le(bits)
        mut mask = (1 << ch) - 1
        o.push_u32le(mask)
        if is_float:
            o.push_u16le(3)
        else:
            o.push_u16le(1)
        # rest of KSDATAFORMAT_SUBTYPE GUID 00000000-0000-0010-8000-00aa00389b71
        o.push_u8(0)
        o.push_u8(0)
        o.push_u8(0)
        o.push_u8(0)
        o.push_u8(0x10)
        o.push_u8(0)
        o.push_u8(0x80)
        o.push_u8(0)
        o.push_u8(0)
        o.push_u8(0xAA)
        o.push_u8(0)
        o.push_u8(0x38)
        o.push_u8(0x9B)
        o.push_u8(0x71)
    _put_id(o, 0x64, 0x61, 0x74, 0x61)                 # data
    o.push_u32le(dlen)
    mut scratch = _tr_c_malloc(8)
    mut n = buf.frames * ch
    mut i = 0
    while i < n:
        mut v = 0.0
        unsafe:
            v = buf.data.offset(i).read() as float
        if is_float:
            if bits == 32:
                unsafe:
                    (scratch as Pointer[f32]).write(v as f32)
                mut k = 0
                while k < 4:
                    unsafe:
                        o.push_u8(scratch.offset(k).read() as int)
                    k = k + 1
            else:
                unsafe:
                    (scratch as Pointer[f64]).write(v as f64)
                mut k2 = 0
                while k2 < 8:
                    unsafe:
                        o.push_u8(scratch.offset(k2).read() as int)
                    k2 = k2 + 1
        else:
            if bits == 8:
                mut q8 = _rnd(v * 128.0) + 128
                if q8 < 0: q8 = 0
                if q8 > 255: q8 = 255
                o.push_u8(q8)
            else:
                if bits == 16:
                    mut q = _rnd(v * 32768.0)
                    if q < -32768: q = -32768
                    if q > 32767: q = 32767
                    o.push_u16le(q & 0xFFFF)
                else:
                    if bits == 24:
                        mut q3 = _rnd(v * 8388608.0)
                        if q3 < -8388608: q3 = -8388608
                        if q3 > 8388607: q3 = 8388607
                        o.push_u8(q3 & 0xFF)
                        o.push_u8((q3 >> 8) & 0xFF)
                        o.push_u8((q3 >> 16) & 0xFF)
                    else:
                        mut q4 = _rnd(v * 2147483648.0)
                        if q4 < -2147483648: q4 = -2147483648
                        if q4 > 2147483647: q4 = 2147483647
                        o.push_u32le(q4 & 0xFFFFFFFF)
        i = i + 1
    _tr_c_free(scratch)
    _pad(o)
    if tags.ids.len > 0:
        _put_id(o, 0x4C, 0x49, 0x53, 0x54)             # LIST
        mut list_at = o.len
        o.push_u32le(0)
        _put_id(o, 0x49, 0x4E, 0x46, 0x4F)             # INFO
        mut t = 0
        while t < tags.ids.len:
            mut tid = tags.ids.get(t)
            mut tv = tags.vals.get(t)
            mut tp = tid as Pointer[char]
            if tid.len() == 4:
                o.push_u8(rd8(tp, 0))
                o.push_u8(rd8(tp, 1))
                o.push_u8(rd8(tp, 2))
                o.push_u8(rd8(tp, 3))
                mut vl = tv.len()
                o.push_u32le(vl + 1)
                o.push_str(tv, vl)
                o.push_u8(0)
                _pad(o)
            t = t + 1
        _patch32(o, list_at, o.len - list_at - 4)
    _patch32(o, 4, o.len - 8)
    mut total = o.len
    mut s = o.to_str()
    o.free()
    return (s, total)
