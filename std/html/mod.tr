# std.html -- forgiving HTML5 parser and toolkit.
#
#   from std.html import html_parse, html_to_text, html_sanitize_default
#   from std.html import HtmlDocument, HtmlNode, HtmlSelector, HtmlPolicy
#
# Sub-modules (importable directly):
#   std.html.entities   html_escape, html_unescape, character references
#                       (all 2231 WHATWG named references, C table)
#   std.html.tokenizer  HtmlTokenizer (WHATWG tokenization states)
#   std.html.dom        HtmlDocument / HtmlNode, tree builder, serializer,
#                       CSS selectors
#   std.html.util       html_to_text, html_strip_tags, html_links,
#                       HtmlPolicy / html_sanitize

