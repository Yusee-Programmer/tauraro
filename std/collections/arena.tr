# std.collections.arena -- region and fixed-size-block allocators.
#
# `Arena` is a bump allocator: allocations come from large blocks and are
# released all at once with reset() or dispose(). It suits data with one
# shared lifetime (a parse tree, one request, one frame) -- the region form
# of single ownership: the arena owns everything allocated from it.
#
# `Slab` hands out fixed-size blocks from large chunks and recycles freed
# blocks through a free list -- O(1) alloc/release with no fragmentation for
# many same-sized objects.
#
# Both return raw `Pointer[char]` memory (8-byte aligned) for use with
# `unsafe` code, C interop or Tauraro's @value_type structs; memory is not
# zeroed unless you ask for it. Pointers become invalid after reset() /
# dispose() (Arena) or release() / dispose() (Slab). (Methods are named allocate, not
# alloc, which is a language built-in.)
#
# Usage:
#   from std.collections.arena import Arena, Slab
#   mut a = Arena.init(64 * 1024)
#   mut p = a.allocate(128)
#   mut s = a.copy_str("interned")       # NUL-terminated copy owned by the arena
#   a.reset()                            # everything freed, first block kept
#   a.dispose()

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_c_free(ptr: Pointer[char])
    def _tr_c_memcpy(dst: Pointer[char], src: Pointer[char], n: int)
    def _tr_c_memset(dst: Pointer[char], c: int, n: int)

def _ar_align(n: int) -> int: return (n + 7) & (~7)

pub class Arena:
    pub block_size: int
    pub blocks:     List[int]      # block base addresses (as integers)
    pub sizes:      List[int]
    pub used:       int            # bytes used in the current (last) block
    pub total_used: int            # bytes handed out since the last reset

extend Arena:
    # block_size: size of each underlying block (bigger requests get their own block).
    pub def init(block_size: int) -> Arena:
        mut a = Arena()
        mut bs = block_size
        if bs < 256: bs = 256
        a.block_size = _ar_align(bs)
        a.blocks = []
        a.sizes = []
        a.used = 0
        a.total_used = 0
        return a

    def _new_block(self, size: int) -> bool:
        mut p = _tr_c_malloc(size)
        if (p as usize) == (0 as usize): return false
        self.blocks.append(p as int)
        self.sizes.append(size)
        self.used = 0
        return true

    # `size` bytes, 8-byte aligned. Returns a null pointer if memory runs out.
    pub def allocate(self, size: int) -> Pointer[char]:
        mut n = _ar_align(size)
        if n == 0: n = 8
        if len(self.blocks) == 0 or self.used + n > self.sizes[len(self.sizes) - 1]:
            mut bs = self.block_size
            if n > bs: bs = n
            if not self._new_block(bs): return 0 as Pointer[char]
        mut addr = self.blocks[len(self.blocks) - 1] + self.used
        self.used = self.used + n
        self.total_used = self.total_used + n
        return addr as Pointer[char]

    pub def allocate_zeroed(self, size: int) -> Pointer[char]:
        mut p = self.allocate(size)
        if (p as usize) != (0 as usize): _tr_c_memset(p, 0, size)
        unsafe:
            return p

    # A NUL-terminated copy of s living in the arena.
    pub def copy_str(self, s: str) -> Pointer[char]:
        mut p = self.allocate(s.len() + 1)
        if (p as usize) == (0 as usize): return 0 as Pointer[char]
        mut sp = s as Pointer[char]
        _tr_c_memcpy(p, sp, s.len())
        unsafe:
            p.offset(s.len()).write('\0')
            return p

    # Free everything but keep the first block for reuse.
    pub def reset(self):
        mut i = len(self.blocks) - 1
        while i >= 1:
            _tr_c_free(self.blocks[i] as Pointer[char])
            self.blocks.pop()
            self.sizes.pop()
            i = i - 1
        self.used = 0
        self.total_used = 0

    pub def bytes_used(self) -> int: return self.total_used

    pub def bytes_reserved(self) -> int:
        mut t = 0
        mut i = 0
        while i < len(self.sizes):
            t = t + self.sizes[i]
            i = i + 1
        return t

    pub def block_count(self) -> int: return len(self.blocks)

    # Free every block.
    pub def dispose(self):
        mut i = 0
        while i < len(self.blocks):
            _tr_c_free(self.blocks[i] as Pointer[char])
            i = i + 1
        self.blocks = []
        self.sizes = []
        self.used = 0
        self.total_used = 0

pub class Slab:
    pub obj_size:  int
    pub per_chunk: int
    pub chunks:    List[int]
    pub free_head: int          # address of the first free block (0 = none)
    pub live:      int

extend Slab:
    # Blocks of `obj_size` bytes (at least 8), allocated `per_chunk` at a time.
    pub def init(obj_size: int, per_chunk: int) -> Slab:
        mut s = Slab()
        mut sz = _ar_align(obj_size)
        if sz < 8: sz = 8
        s.obj_size = sz
        mut pc = per_chunk
        if pc < 1: pc = 64
        s.per_chunk = pc
        s.chunks = []
        s.free_head = 0
        s.live = 0
        return s

    def _grow(self) -> bool:
        mut base = _tr_c_malloc(self.obj_size * self.per_chunk)
        if (base as usize) == (0 as usize): return false
        mut b = base as int
        self.chunks.append(b)
        # thread the new blocks onto the free list (last to first)
        mut i = self.per_chunk - 1
        while i >= 0:
            mut blk = (b + i * self.obj_size) as Pointer[int]
            unsafe: blk.write(self.free_head)
            self.free_head = b + i * self.obj_size
            i = i - 1
        return true

    # One block (null if memory runs out).
    pub def allocate(self) -> Pointer[char]:
        if self.free_head == 0:
            if not self._grow(): return 0 as Pointer[char]
        mut blk = self.free_head
        mut bp = blk as Pointer[int]
        unsafe: self.free_head = bp.read()
        self.live = self.live + 1
        return blk as Pointer[char]

    # Return a block obtained from alloc() of this slab.
    pub def release(self, p: Pointer[char]):
        if (p as usize) == (0 as usize): return
        mut bp = p as Pointer[int]
        unsafe: bp.write(self.free_head)
        self.free_head = p as int
        self.live = self.live - 1

    pub def live_count(self) -> int: return self.live
    pub def capacity(self) -> int: return len(self.chunks) * self.per_chunk

    pub def dispose(self):
        mut i = 0
        while i < len(self.chunks):
            _tr_c_free(self.chunks[i] as Pointer[char])
            i = i + 1
        self.chunks = []
        self.free_head = 0
        self.live = 0
