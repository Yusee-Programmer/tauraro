# std.collections.rope — Rope: a text buffer with O(log n) insert / delete /
# slice, for editors and large generated documents.
#
# A rope is an implicit-key treap (randomised balanced tree) whose nodes each
# hold a short text CHUNK (at most 256 bytes) instead of a single character.
# The tree is ordered by position, every node caches the byte size of its
# subtree, and priorities come from a seedable xorshift64 generator, so the
# shape is reproducible (`Rope.with_seed`).
#
#   insert(pos, text)      O(log n + |text|)   (small inserts that fit in the
#                                              chunk under `pos` do not split)
#   delete(pos, n)         O(log n)            (+ freeing the removed nodes)
#   slice(a, b) / to_str   O(log n + b - a)
#   append / prepend / replace / char_at / find / compact
#
# All positions are BYTE offsets into the text, clamped to [0, len()].  The
# rope is not UTF-8 aware: a position inside a multi-byte sequence splits it,
# exactly like `str` indexing does.  Text cannot contain a NUL byte (Tauraro
# strings are NUL-terminated).
#
# Fragmentation: many tiny edits leave many small chunks.  When the average
# chunk shrinks below ~16 bytes the rope compacts itself (rebuilds with full
# chunks, O(n), amortised O(1) per edit); `compact()` forces it.
#
# Storage is index-based (parallel Vecs, no raw pointers); removed nodes are
# recycled through a free list and their chunk strings are released
# immediately.  The compiler frees the rope at scope exit.  Not thread-safe.

from std.core.vec import Vec
from std.core.string import StringBuilder
from std.string.str import Str

pub class Rope:
    pub chunks: Vec[str]
    pub lft:    Vec[int]
    pub rgt:    Vec[int]
    pub pri:    Vec[int]
    pub size:   Vec[int]      # bytes in the subtree rooted here
    pub clen:   Vec[int]      # bytes in this node's own chunk
    pub free_l: Vec[int]
    pub root:   int
    pub live:   int           # nodes in use
    pub rng:    int
    pub sl:     int           # split scratch (left result)
    pub sr:     int           # split scratch (right result)

extend Rope:
    pub def with_seed(seed: int) -> Rope:
        mut r = Rope()
        r.chunks = Vec[str].init(8)
        r.lft = Vec[int].init(8)
        r.rgt = Vec[int].init(8)
        r.pri = Vec[int].init(8)
        r.size = Vec[int].init(8)
        r.clen = Vec[int].init(8)
        r.free_l = Vec[int].init(8)
        r.root = -1
        r.live = 0
        r.rng = seed
        if seed == 0: r.rng = 0x2545F4914F6CDD1D
        r.sl = -1
        r.sr = -1
        return r

    pub def init() -> Rope:
        return Rope.with_seed(88172645463325252)

    pub def from_str(s: str) -> Rope:
        mut r = Rope.init()
        r.append(s)
        return r

    pub def len(self) -> int:
        return self._sz(self.root)

    pub def is_empty(self) -> bool:
        return self.root < 0

    # Number of chunk nodes currently in the tree (a fragmentation measure).
    pub def chunk_count(self) -> int:
        return self.live

    def _sz(self, t: int) -> int:
        if t < 0: return 0
        return self.size.get(t)

    def _upd(self, t: int):
        self.size.set(t, self._sz(self.lft.get(t)) + self.clen.get(t) + self._sz(self.rgt.get(t)))

    def _rand(self) -> int:
        mut x: u64 = self.rng as u64
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        self.rng = x as int
        return (x >> 1) as int

    def _node(self, text: str, prio: int) -> int:
        mut n = text.len()
        if self.free_l.len > 0:
            mut i = self.free_l.pop()
            self.chunks.set(i, text)
            self.lft.set(i, -1)
            self.rgt.set(i, -1)
            self.pri.set(i, prio)
            self.size.set(i, n)
            self.clen.set(i, n)
            self.live = self.live + 1
            return i
        mut j = self.chunks.len
        self.chunks.push(text)
        self.lft.push(-1)
        self.rgt.push(-1)
        self.pri.push(prio)
        self.size.push(n)
        self.clen.push(n)
        self.live = self.live + 1
        return j

    # Release a whole subtree back to the free list.
    def _free_tree(self, t: int):
        if t < 0: return
        self._free_tree(self.lft.get(t))
        self._free_tree(self.rgt.get(t))
        self.chunks.set(t, "")
        self.free_l.push(t)
        self.live = self.live - 1

    # Split subtree t after its first k bytes; results in self.sl / self.sr.
    def _split(self, t: int, k: int):
        if t < 0:
            self.sl = -1
            self.sr = -1
            return
        mut ls = self._sz(self.lft.get(t))
        mut cl = self.clen.get(t)
        if k <= ls:
            self._split(self.lft.get(t), k)
            self.lft.set(t, self.sr)
            self._upd(t)
            self.sr = t
            return
        if k >= ls + cl:
            self._split(self.rgt.get(t), k - ls - cl)
            self.rgt.set(t, self.sl)
            self._upd(t)
            self.sl = t
            return
        # k falls strictly inside this node's chunk: cut the chunk in two.
        mut cut = k - ls
        mut s = self.chunks.get(t)
        mut head = Str.substr(s, 0, cut)
        mut tail = Str.substr(s, cut, cl - cut)
        mut n2 = self._node(tail, self.pri.get(t))
        self.rgt.set(n2, self.rgt.get(t))
        self.rgt.set(t, -1)
        self.chunks.set(t, head)
        self.clen.set(t, cut)
        self._upd(t)
        self._upd(n2)
        self.sl = t
        self.sr = n2

    def _merge(self, a: int, b: int) -> int:
        if a < 0: return b
        if b < 0: return a
        if self.pri.get(a) > self.pri.get(b):
            self.rgt.set(a, self._merge(self.rgt.get(a), b))
            self._upd(a)
            return a
        self.lft.set(b, self._merge(a, self.lft.get(b)))
        self._upd(b)
        return b

    # Try to place `text` inside the existing chunk covering pos.
    def _ins_in(self, t: int, pos: int, text: str) -> bool:
        if t < 0: return false
        mut ls = self._sz(self.lft.get(t))
        mut cl = self.clen.get(t)
        mut ok = false
        if pos < ls:
            ok = self._ins_in(self.lft.get(t), pos, text)
        elif pos <= ls + cl:
            if cl + text.len() <= 256:
                mut s = self.chunks.get(t)
                mut off = pos - ls
                mut ns = Str.substr(s, 0, off) + text + Str.substr(s, off, cl - off)
                self.chunks.set(t, ns)
                self.clen.set(t, cl + text.len())
                ok = true
        else:
            ok = self._ins_in(self.rgt.get(t), pos - ls - cl, text)
        if ok: self._upd(t)
        return ok

    # Build a balanced-ish subtree from text in <=256-byte chunks.
    def _build(self, text: str) -> int:
        mut n = text.len()
        mut mid = -1
        mut off = 0
        while off < n:
            mut take = n - off
            if take > 256: take = 256
            mid = self._merge(mid, self._node(Str.substr(text, off, take), self._rand()))
            off = off + take
        return mid

    # Insert text so that its first byte lands at byte offset pos.
    pub def insert(self, pos: int, text: str):
        if text.len() == 0: return
        mut p = pos
        if p < 0: p = 0
        mut total = self.len()
        if p > total: p = total
        if self.root >= 0 and text.len() < 64:
            if self._ins_in(self.root, p, text):
                self._maybe_compact()
                return
        self._split(self.root, p)
        mut l = self.sl
        mut r = self.sr
        mut mid = self._build(text)
        self.root = self._merge(self._merge(l, mid), r)
        self._maybe_compact()

    pub def append(self, text: str):
        self.insert(self.len(), text)

    pub def prepend(self, text: str):
        self.insert(0, text)

    # Remove n bytes starting at pos (clamped).  Returns the number removed.
    pub def delete(self, pos: int, n: int) -> int:
        mut total = self.len()
        mut p = pos
        if p < 0: p = 0
        if p >= total or n <= 0: return 0
        mut cnt = n
        if p + cnt > total: cnt = total - p
        self._split(self.root, p)
        mut l = self.sl
        mut rest = self.sr
        self._split(rest, cnt)
        mut mid = self.sl
        mut r = self.sr
        self._free_tree(mid)
        self.root = self._merge(l, r)
        return cnt

    # Replace n bytes at pos with text.
    pub def replace(self, pos: int, n: int, text: str):
        mut p = pos
        if p < 0: p = 0
        self.delete(p, n)
        self.insert(p, text)

    def _collect(self, t: int, lo: int, hi: int, base: int, sb: StringBuilder):
        # Append bytes of subtree t that fall in [lo, hi) where t starts at `base`.
        if t < 0: return
        mut total = self.size.get(t)
        if hi <= base or lo >= base + total: return
        mut ls = self._sz(self.lft.get(t))
        self._collect(self.lft.get(t), lo, hi, base, sb)
        mut cs = base + ls
        mut cl = self.clen.get(t)
        if hi > cs and lo < cs + cl:
            mut a = lo - cs
            if a < 0: a = 0
            mut b = hi - cs
            if b > cl: b = cl
            if a == 0 and b == cl:
                sb.append(self.chunks.get(t))
            else:
                sb.append(Str.substr(self.chunks.get(t), a, b - a))
        self._collect(self.rgt.get(t), lo, hi, cs + cl, sb)

    # Bytes [start, end) as a string (both clamped).
    pub def slice(self, start: int, end: int) -> str:
        mut a = start
        mut b = end
        if a < 0: a = 0
        mut total = self.len()
        if b > total: b = total
        if a >= b: return ""
        mut sb = StringBuilder.init(b - a + 1)
        self._collect(self.root, a, b, 0, sb)
        mut out = sb.to_owned()
        sb.free()
        return out

    pub def to_str(self) -> str:
        return self.slice(0, self.len())

    # Byte value (0..255) at pos, or -1 if out of range.
    pub def char_at(self, pos: int) -> int:
        if pos < 0 or pos >= self.len(): return -1
        mut t = self.root
        mut p = pos
        while t >= 0:
            mut ls = self._sz(self.lft.get(t))
            mut cl = self.clen.get(t)
            if p < ls:
                t = self.lft.get(t)
            elif p < ls + cl:
                return Str.char_at(self.chunks.get(t), p - ls)
            else:
                p = p - ls - cl
                t = self.rgt.get(t)
        return -1

    # First byte offset >= from where `needle` occurs, or -1.  O(n): it
    # materialises the text.  Intended for convenience, not hot loops.
    pub def find(self, needle: str, from_pos: int) -> int:
        mut s = self.to_str()
        mut start = from_pos
        if start < 0: start = 0
        if start > s.len(): return -1
        mut hit = Str.index_of(Str.substr(s, start, s.len() - start), needle)
        if hit < 0: return -1
        return start + hit

    pub def clear(self):
        self._free_tree(self.root)
        self.root = -1

    # Rebuild the tree out of full-size chunks.
    pub def compact(self):
        mut s = self.to_str()
        self._free_tree(self.root)
        self.root = self._build(s)

    def _maybe_compact(self):
        if self.live > 64 and self.live * 16 > self.len():
            self.compact()
