# std.collections.ringbuffer — RingBuffer[T]: fixed-capacity circular queue.
#
# A RingBuffer never reallocates after construction.  When it is full the
# policy chosen at construction decides what push() does:
#
#   RingBuffer[T].init(cap, true)    overwrite mode: the OLDEST element is
#                                    dropped to make room (dropped() counts
#                                    them); push() always returns true.
#   RingBuffer[T].init(cap, false)   refuse mode: push() leaves the buffer
#                                    unchanged and returns false.
#
# Index 0 is always the oldest element, len()-1 the newest.
#
# Ownership: storage is a Vec[T] filled lazily (no dummy values are needed, so
# T may be a class, str, int ...).  Vec.set retains the incoming element and
# releases the one it overwrites, so overwrite mode frees displaced elements
# correctly.  A popped slot is NOT cleared: it keeps its (reference-counted)
# element alive until the slot is overwritten or the buffer is dropped, which
# is only observable for classes with side-effecting teardown.
#
# Dropping: a generic class only gets a compiler-injected scope-exit drop when
# it declares `free(self)`, so RingBuffer does; it releases the storage Vecs.  Heap
# payloads (str / class values) and the small struct itself are still leaked by
# the current compiler for generic classes (bug D1-4, same as BTreeMap and
# LruCache); int / float / bool payloads leak only that struct.
#
# Empty buffer: pop_front/pop_back/front/back/at have no value to return, so
# they require a non-empty buffer (check len() / is_empty()).  The try_* and
# *_or forms are total: try_* return Option[T], *_or return a caller default.

from std.core.vec import Vec

pub class RingBuffer[T]:
    pub buf:       Vec[T]
    pub head:      int
    pub count:     int
    pub cap:       int
    pub overwrite: bool
    pub lost:      int

extend RingBuffer[T]:
    pub def init(cap: int, overwrite: bool) -> RingBuffer[T]:
        mut c = cap
        if c < 1: c = 1
        mut r = RingBuffer[T]()
        r.buf = Vec[T].init(c)
        r.head = 0
        r.count = 0
        r.cap = c
        r.overwrite = overwrite
        r.lost = 0
        return r

    pub def len(self) -> int:
        return self.count

    pub def capacity(self) -> int:
        return self.cap

    pub def is_empty(self) -> bool:
        return self.count == 0

    pub def is_full(self) -> bool:
        return self.count == self.cap

    # Number of elements discarded by overwrite-mode pushes so far.
    pub def dropped(self) -> int:
        return self.lost

    # Append v as the newest element.  Returns false only in refuse mode when full.
    pub def push(self, v: T) -> bool:
        if self.count == self.cap:
            if not self.overwrite: return false
            self.buf.set(self.head, v)
            self.head = (self.head + 1) % self.cap
            self.lost = self.lost + 1
            return true
        mut idx = (self.head + self.count) % self.cap
        if idx >= self.buf.len:
            self.buf.push(v)
        else:
            self.buf.set(idx, v)
        self.count = self.count + 1
        return true

    # Element i (0 = oldest).  Requires 0 <= i < len().
    pub def at(self, i: int) -> T:
        return self.buf.get((self.head + i) % self.cap)

    # Replace element i (0 = oldest).  No-op if out of range.
    pub def set_at(self, i: int, v: T):
        if i < 0 or i >= self.count: return
        self.buf.set((self.head + i) % self.cap, v)

    pub def front(self) -> T:
        return self.at(0)

    pub def back(self) -> T:
        return self.at(self.count - 1)

    # Remove and return the oldest element.  Requires non-empty.
    pub def pop_front(self) -> T:
        mut v = self.buf.get(self.head)
        self.head = (self.head + 1) % self.cap
        self.count = self.count - 1
        return v

    # Remove and return the newest element.  Requires non-empty.
    pub def pop_back(self) -> T:
        mut v = self.at(self.count - 1)
        self.count = self.count - 1
        return v

    pub def try_pop_front(self) -> Option[T]:
        if self.count == 0: return Option.None()
        return Option.Some(self.pop_front())

    pub def try_pop_back(self) -> Option[T]:
        if self.count == 0: return Option.None()
        return Option.Some(self.pop_back())

    pub def try_front(self) -> Option[T]:
        if self.count == 0: return Option.None()
        return Option.Some(self.at(0))

    pub def try_back(self) -> Option[T]:
        if self.count == 0: return Option.None()
        return Option.Some(self.at(self.count - 1))

    pub def pop_front_or(self, dflt: T) -> T:
        if self.count == 0: return dflt
        return self.pop_front()

    pub def pop_back_or(self, dflt: T) -> T:
        if self.count == 0: return dflt
        return self.pop_back()

    # Forget all elements (slots stay allocated for reuse).
    pub def clear(self):
        self.head = 0
        self.count = 0

    # Snapshot, oldest first.
    pub def to_vec(self) -> Vec[T]:
        mut out = Vec[T].init(self.count + 1)
        mut i = 0
        while i < self.count:
            out.push(self.at(i))
            i = i + 1
        return out

    # Release the element storage (also runs automatically at scope exit).
    pub def free(self):
        self.buf.free()
