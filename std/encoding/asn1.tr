# std.encoding.asn1 — ASN.1 DER encoder / decoder (ITU-T X.690) and OIDs.
#
# The subset needed for X.509 / PKCS#1 / PKCS#8 / SEC1 / SPKI: definite-length,
# single-byte identifier octets (tag numbers 0..30), primitive and constructed.
# Everything works on byte buffers (`Vec[int]`, values 0..255 — see
# std.crypto.pkutil `Bytes`), so embedded zero bytes are no problem.
#
# DECODING
#   Der.parse(buf)            one TLV that must span the whole buffer
#   Der.parse_at(buf, off)    one TLV starting at `off` (node.raw.len = its size)
#   DerNode                   tag + content + raw (the complete TLV bytes — kept
#                             because signatures cover the exact DER of the
#                             to-be-signed structure)
#   node.reader()             DerReader over a constructed node's children:
#                               mut r = seq.reader()
#                               while r.more(): mut child = r.next()?
#   typed getters: as_int / as_bn / as_bool / as_oid / as_bit_string /
#                  as_octets / as_text / as_time (unix seconds)
#   All decode failures `raise` a `str` (use `?`, or bind to `Result[T, str]`).
#   Decoding is strict DER where it matters for safety: definite lengths only,
#   minimal length encoding, no tag numbers >= 31, lengths checked against the
#   remaining input BEFORE anything is copied, nesting is never recursed into
#   by the parser itself (children are read lazily by the caller).
#   Integers with redundant leading 00/ff bytes are rejected by `as_int`/`as_bn`.
#
# ENCODING
#   Der.tlv(tag, content), Der.sequence(content), Der.set_of(content),
#   Der.integer_bn(bn) / Der.integer_int(n), Der.octet_string, Der.bit_string,
#   Der.null(), Der.boolean, Der.oid("1.2.840.113549.1.1.1"),
#   Der.utf8, Der.printable, Der.explicit(n, content), Der.implicit(n, ...)...
#   `content` arguments are already-encoded child buffers concatenated
#   (Bytes.concat / Bytes.append).
#
# OIDs: `Oid.name(dotted)` maps the common ones to readable names
# ("rsaEncryption", "ecdsa-with-SHA256", "commonName", ...), `Oid.*()` return
# the dotted strings for the ones the crypto modules use.
#
# Limits: no BER indefinite lengths, no high-tag-number form, no REAL/EXTERNAL
# types, no string re-validation (PrintableString etc. are not charset-checked).
#
# Usage:
#   from std.encoding.asn1 import Der, DerNode, DerReader, Oid
#   mut seq = Der.parse(der_bytes)?
#   mut r = seq.reader()
#   mut version = r.next()?
#   print(version.as_int()?)

from std.core.vec import Vec
from std.crypto.pkutil import Bytes
from std.crypto.bn import bn_from_bytes, bn_to_bytes, bn_byte_len, bn_trim, bn_get_bit, bn_bit_len

pub def DER_BOOLEAN() -> int: return 1
pub def DER_INTEGER() -> int: return 2
pub def DER_BIT_STRING() -> int: return 3
pub def DER_OCTET_STRING() -> int: return 4
pub def DER_NULL() -> int: return 5
pub def DER_OID() -> int: return 6
pub def DER_UTF8_STRING() -> int: return 12
pub def DER_PRINTABLE_STRING() -> int: return 19
pub def DER_T61_STRING() -> int: return 20
pub def DER_IA5_STRING() -> int: return 22
pub def DER_UTC_TIME() -> int: return 23
pub def DER_GENERALIZED_TIME() -> int: return 24
pub def DER_BMP_STRING() -> int: return 30
pub def DER_SEQUENCE() -> int: return 48     # 0x30
pub def DER_SET() -> int: return 49          # 0x31

pub class DerNode:
    pub tag:     int          # the identifier octet (class | constructed | number)
    pub content: Vec[int]     # the V of the TLV
    pub raw:     Vec[int]     # the whole TLV (tag, length, value)

pub class DerReader:
    pub buf: Vec[int]
    pub pos: int

pub class Der:
    _dummy: int

pub class Oid:
    _dummy: int

# ── decoding ────────────────────────────────────────────────────────────────

extend DerNode:
    pub def is_constructed(self) -> bool:
        return (self.tag & 32) != 0

    # 0 universal, 1 application, 2 context-specific, 3 private
    pub def tag_class(self) -> int:
        return (self.tag >> 6) & 3

    pub def tag_number(self) -> int:
        return self.tag & 31

    # Is this the context-specific tag [n] (constructed or primitive)?
    pub def is_context(self, n: int) -> bool:
        return self.tag_class() == 2 and self.tag_number() == n

    pub def reader(self) -> DerReader:
        mut r = DerReader()
        r.buf = Bytes.clone(self.content)
        r.pos = 0
        return r

    # Number of child TLVs (constructed nodes only; raises on malformed content).
    pub def child_count(self) throws str -> int:
        mut r = self.reader()
        mut n = 0
        while r.more():
            mut c = r.next()?
            n = n + 1
        return n

    # The i-th child.
    pub def child(self, i: int) throws str -> DerNode:
        mut r = self.reader()
        mut k = 0
        while r.more():
            mut c = r.next()?
            if k == i: return c
            k = k + 1
        raise("asn1: child index out of range")

    pub def as_bool(self) throws str -> bool:
        if self.tag != 1 or self.content.len != 1: raise("asn1: not a BOOLEAN")
        return self.content.get(0) != 0

    # Validates minimal two's-complement INTEGER encoding.
    def _check_int(self) throws str:
        if self.tag != 2: raise("asn1: not an INTEGER")
        if self.content.len == 0: raise("asn1: empty INTEGER")
        if self.content.len > 1:
            mut a = self.content.get(0)
            mut b = self.content.get(1)
            if a == 0 and (b & 128) == 0: raise("asn1: non-minimal INTEGER")
            if a == 255 and (b & 128) != 0: raise("asn1: non-minimal INTEGER")

    # Small signed INTEGER (must fit in 63 bits).
    pub def as_int(self) throws str -> int:
        self._check_int()?
        if self.content.len > 8: raise("asn1: INTEGER too large for int")
        mut v = 0
        if (self.content.get(0) & 128) != 0: v = -1
        mut i = 0
        while i < self.content.len:
            v = (v << 8) | self.content.get(i)
            i = i + 1
        return v

    # Non-negative INTEGER as a big-number magnitude (std.crypto.bn limbs).
    pub def as_bn(self) throws str -> Vec[int]:
        self._check_int()?
        if (self.content.get(0) & 128) != 0: raise("asn1: negative INTEGER where unsigned expected")
        return bn_from_bytes(self.content)

    # INTEGER content bytes with the leading sign byte (if any) stripped.
    pub def as_unsigned_bytes(self) throws str -> Vec[int]:
        mut m = self.as_bn()?
        return bn_to_bytes(m, bn_byte_len(m))

    pub def as_octets(self) throws str -> Vec[int]:
        if self.tag != 4: raise("asn1: not an OCTET STRING")
        return Bytes.clone(self.content)

    # BIT STRING payload bytes; `unused_bits` (0..7) is returned by bit_unused().
    pub def as_bit_string(self) throws str -> Vec[int]:
        if self.tag != 3: raise("asn1: not a BIT STRING")
        if self.content.len == 0: raise("asn1: empty BIT STRING")
        if self.content.get(0) > 7: raise("asn1: bad BIT STRING unused-bits")
        return Bytes.slice(self.content, 1, self.content.len - 1)

    pub def bit_unused(self) -> int:
        if self.content.len == 0: return 0
        return self.content.get(0)

    # Is bit `i` (0 = most significant bit of the first payload byte, the
    # numbering X.509 KeyUsage uses) set in a BIT STRING?
    pub def bit_is_set(self, i: int) -> bool:
        if self.tag != 3 or self.content.len < 2: return false
        mut byte_i = i / 8
        if byte_i + 1 >= self.content.len: return false
        mut total = (self.content.len - 1) * 8 - self.content.get(0)
        if i >= total: return false
        return ((self.content.get(1 + byte_i) >> (7 - (i - byte_i * 8))) & 1) == 1

    pub def as_oid(self) throws str -> str:
        if self.tag != 6: raise("asn1: not an OBJECT IDENTIFIER")
        return Oid.decode(self.content)?

    pub def is_oid(self, dotted: str) -> bool:
        if self.tag != 6: return false
        mut r: Result[str, str] = Oid.decode(self.content)
        if r.is_err: return false
        return r.ok == dotted

    pub def is_string(self) -> bool:
        mut t = self.tag
        return t == 12 or t == 19 or t == 20 or t == 22 or t == 30 or t == 28 or t == 18 or t == 26

    # Character string content as UTF-8 `str` (BMPString / UniversalString are
    # converted; T61 and the rest are passed through byte-for-byte).
    pub def as_text(self) throws str -> str:
        if not self.is_string(): raise("asn1: not a character string")
        if self.tag == 30:
            if self.content.len % 2 != 0: raise("asn1: odd BMPString length")
            mut out = Vec[int].init(self.content.len + 4)
            mut i = 0
            while i < self.content.len:
                mut cp = (self.content.get(i) << 8) | self.content.get(i + 1)
                Der._utf8_push(out, cp)
                i = i + 2
            return Bytes.to_str(out)
        if self.tag == 28:
            if self.content.len % 4 != 0: raise("asn1: bad UniversalString length")
            mut out = Vec[int].init(self.content.len + 4)
            mut i = 0
            while i < self.content.len:
                mut cp = (self.content.get(i) << 24) | (self.content.get(i + 1) << 16) | (self.content.get(i + 2) << 8) | self.content.get(i + 3)
                Der._utf8_push(out, cp)
                i = i + 4
            return Bytes.to_str(out)
        return Bytes.to_str(self.content)

    # UTCTime / GeneralizedTime -> Unix seconds (UTC). Only the `Z` form
    # (the only one DER/RFC 5280 allows) is accepted.
    pub def as_time(self) throws str -> int:
        if self.tag != 23 and self.tag != 24: raise("asn1: not a time")
        mut s = self.content
        mut n = s.len
        mut p = 0
        mut year = 0
        if self.tag == 23:
            if n != 13: raise("asn1: bad UTCTime length")
            year = Der._dig2(s, 0)?
            if year >= 50: year = 1900 + year
            else: year = 2000 + year
            p = 2
        else:
            if n != 15: raise("asn1: bad GeneralizedTime length")
            year = Der._dig2(s, 0)? * 100 + Der._dig2(s, 2)?
            p = 4
        mut mon = Der._dig2(s, p)?
        mut day = Der._dig2(s, p + 2)?
        mut hh = Der._dig2(s, p + 4)?
        mut mi = Der._dig2(s, p + 6)?
        mut ss = Der._dig2(s, p + 8)?
        if s.get(p + 10) != 90: raise("asn1: time must end in Z")
        if mon < 1 or mon > 12 or day < 1 or day > 31 or hh > 23 or mi > 59 or ss > 60:
            raise("asn1: time field out of range")
        return Der.unix_from_civil(year, mon, day) * 86400 + hh * 3600 + mi * 60 + ss

extend DerReader:
    pub def more(self) -> bool:
        return self.pos < self.buf.len

    pub def remaining(self) -> int:
        return self.buf.len - self.pos

    # Tag of the next child without consuming it (-1 at the end).
    pub def peek_tag(self) -> int:
        if self.pos >= self.buf.len: return -1
        return self.buf.get(self.pos)

    pub def next(self) throws str -> DerNode:
        mut node = Der.parse_at(self.buf, self.pos)?
        self.pos = self.pos + node.raw.len
        return node

extend Der:
    def _dig2(s: Vec[int], i: int) throws str -> int:
        mut a = s.get(i) - 48
        mut b = s.get(i + 1) - 48
        if a < 0 or a > 9 or b < 0 or b > 9: raise("asn1: bad digit in time")
        return a * 10 + b

    # Days since 1970-01-01 for a proleptic Gregorian civil date.
    pub def days_from_civil(y: int, m: int, d: int) -> int:
        mut yy = y
        if m <= 2: yy = yy - 1
        mut era = yy / 400
        if yy < 0: era = (yy - 399) / 400
        mut yoe = yy - era * 400
        mut mp = m + 9
        if m > 2: mp = m - 3
        mut doy = (153 * mp + 2) / 5 + d - 1
        mut doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
        return era * 146097 + doe - 719468

    pub def unix_from_civil(y: int, m: int, d: int) -> int:
        return Der.days_from_civil(y, m, d)

    # Unix seconds -> "YYYYMMDDHHMMSSZ" (GeneralizedTime text).
    pub def format_time(t: int) -> str:
        mut days = t / 86400
        mut rem = t - days * 86400
        if rem < 0:
            rem = rem + 86400
            days = days - 1
        mut z = days + 719468
        mut era = z / 146097
        if z < 0: era = (z - 146096) / 146097
        mut doe = z - era * 146097
        mut yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
        mut y = yoe + era * 400
        mut doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
        mut mp = (5 * doy + 2) / 153
        mut d = doy - (153 * mp + 2) / 5 + 1
        mut m = mp + 3
        if mp >= 10: m = mp - 9
        if m <= 2: y = y + 1
        return f"{Der._p(y, 4)}{Der._p(m, 2)}{Der._p(d, 2)}{Der._p(rem / 3600, 2)}{Der._p((rem % 3600) / 60, 2)}{Der._p(rem % 60, 2)}Z"

    def _p(v: int, w: int) -> str:
        mut s = str(v)
        while s.len() < w:
            s = "0" + s
        return s

    def _utf8_push(out: Vec[int], cp: int):
        if cp < 128:
            out.push(cp)
        elif cp < 2048:
            out.push(192 | (cp >> 6))
            out.push(128 | (cp & 63))
        elif cp < 65536:
            out.push(224 | (cp >> 12))
            out.push(128 | ((cp >> 6) & 63))
            out.push(128 | (cp & 63))
        else:
            out.push(240 | (cp >> 18))
            out.push(128 | ((cp >> 12) & 63))
            out.push(128 | ((cp >> 6) & 63))
            out.push(128 | (cp & 63))

    # Parse one TLV starting at `off` of `buf`.
    pub def parse_at(buf: Vec[int], off: int) throws str -> DerNode:
        mut n = buf.len
        if off >= n: raise("asn1: truncated (no tag)")
        mut tag = buf.get(off)
        if (tag & 31) == 31: raise("asn1: high-tag-number form not supported")
        if off + 1 >= n: raise("asn1: truncated (no length)")
        mut l0 = buf.get(off + 1)
        mut hdr = 2
        mut len_ = 0
        if l0 < 128:
            len_ = l0
        else:
            mut nl = l0 & 127
            if nl == 0: raise("asn1: indefinite length not allowed in DER")
            if nl > 4: raise("asn1: length too large")
            if off + 2 + nl > n: raise("asn1: truncated length")
            mut i = 0
            while i < nl:
                len_ = (len_ << 8) | buf.get(off + 2 + i)
                i = i + 1
            if buf.get(off + 2) == 0: raise("asn1: non-minimal length")
            if len_ < 128: raise("asn1: non-minimal length")
            hdr = 2 + nl
        if len_ > n - off - hdr: raise("asn1: length exceeds input")
        mut node = DerNode()
        node.tag = tag
        node.content = Bytes.slice(buf, off + hdr, len_)
        node.raw = Bytes.slice(buf, off, hdr + len_)
        return node

    # One TLV that must span the entire buffer.
    pub def parse(buf: Vec[int]) throws str -> DerNode:
        mut node = Der.parse_at(buf, 0)?
        if node.raw.len != buf.len: raise("asn1: trailing data after TLV")
        return node

    # ── encoding ──

    pub def length_bytes(n: int) -> Vec[int]:
        mut r = Vec[int].init(6)
        if n < 128:
            r.push(n)
            return r
        mut nb = 0
        mut t = n
        while t > 0:
            nb = nb + 1
            t = t >> 8
        r.push(128 | nb)
        mut i = nb - 1
        while i >= 0:
            r.push((n >> (i * 8)) & 255)
            i = i - 1
        return r

    pub def tlv(tag: int, content: Vec[int]) -> Vec[int]:
        mut r = Vec[int].init(content.len + 8)
        r.push(tag)
        Bytes.append(r, Der.length_bytes(content.len))
        Bytes.append(r, content)
        return r

    pub def sequence(content: Vec[int]) -> Vec[int]:
        return Der.tlv(48, content)

    pub def set_of(content: Vec[int]) -> Vec[int]:
        return Der.tlv(49, content)

    # [n] EXPLICIT: constructed context tag wrapping already-encoded content.
    pub def explicit(n: int, content: Vec[int]) -> Vec[int]:
        return Der.tlv(160 | n, content)

    # [n] IMPLICIT constructed / primitive replacements of the original tag.
    pub def implicit(n: int, constructed: bool, content: Vec[int]) -> Vec[int]:
        mut t = 128 | n
        if constructed: t = t | 32
        return Der.tlv(t, content)

    pub def null() -> Vec[int]:
        mut r = Vec[int].init(2)
        r.push(5)
        r.push(0)
        return r

    pub def boolean(b: bool) -> Vec[int]:
        mut c = Vec[int].init(1)
        if b: c.push(255)
        else: c.push(0)
        return Der.tlv(1, c)

    pub def octet_string(content: Vec[int]) -> Vec[int]:
        return Der.tlv(4, content)

    pub def bit_string(content: Vec[int], unused: int) -> Vec[int]:
        mut c = Vec[int].init(content.len + 2)
        c.push(unused)
        Bytes.append(c, content)
        return Der.tlv(3, c)

    # Unsigned big-number magnitude -> minimal INTEGER (0x00 prefix when the
    # top bit would otherwise read as a sign).
    pub def integer_bn(a: Vec[int]) -> Vec[int]:
        mut nb = bn_byte_len(a)
        if nb == 0: nb = 1
        mut b = bn_to_bytes(a, nb)
        mut c = Vec[int].init(nb + 2)
        if (b.get(0) & 128) != 0: c.push(0)
        Bytes.append(c, b)
        return Der.tlv(2, c)

    # Signed small INTEGER.
    pub def integer_int(n: int) -> Vec[int]:
        mut c = Vec[int].init(10)
        if n >= 0:
            mut nb = 1
            mut t = n
            while t > 127:
                nb = nb + 1
                t = t >> 8
            mut i = nb - 1
            while i >= 0:
                c.push((n >> (i * 8)) & 255)
                i = i - 1
        else:
            mut nb = 1
            mut t = n
            while t < -128:
                nb = nb + 1
                t = t >> 8
            mut i = nb - 1
            while i >= 0:
                c.push((n >> (i * 8)) & 255)
                i = i - 1
        return Der.tlv(2, c)

    pub def oid(dotted: str) -> Vec[int]:
        return Der.tlv(6, Oid.encode(dotted))

    pub def utf8(s: str) -> Vec[int]:
        return Der.tlv(12, Bytes.from_str(s))

    pub def printable(s: str) -> Vec[int]:
        return Der.tlv(19, Bytes.from_str(s))

    pub def ia5(s: str) -> Vec[int]:
        return Der.tlv(22, Bytes.from_str(s))

    pub def generalized_time(ts: int) -> Vec[int]:
        return Der.tlv(24, Bytes.from_str(Der.format_time(ts)))

# ── OIDs ────────────────────────────────────────────────────────────────────

extend Oid:
    # Dotted string -> encoded OID content bytes (no tag/length). Malformed
    # text yields an empty buffer.
    pub def encode(dotted: str) -> Vec[int]:
        mut out = Vec[int].init(16)
        mut arcs = Vec[int].init(8)
        mut p = dotted as Pointer[char]
        mut cur = 0
        mut have = false
        mut i = 0
        while i <= dotted.len():
            mut c = 46
            if i < dotted.len():
                unsafe:
                    c = (p.offset(i).read() as int) & 255
            i = i + 1
            if c == 46:
                if not have:
                    out.clear()
                    return out
                arcs.push(cur)
                cur = 0
                have = false
            elif c >= 48 and c <= 57:
                cur = cur * 10 + (c - 48)
                have = true
            else:
                out.clear()
                return out
        if arcs.len < 2:
            out.clear()
            return out
        Oid._push_arc(out, arcs.get(0) * 40 + arcs.get(1))
        mut k = 2
        while k < arcs.len:
            Oid._push_arc(out, arcs.get(k))
            k = k + 1
        return out

    def _push_arc(out: Vec[int], v: int):
        mut groups = Vec[int].init(10)
        mut t = v
        groups.push(t & 127)
        t = t >> 7
        while t > 0:
            groups.push((t & 127) | 128)
            t = t >> 7
        mut i = groups.len - 1
        while i >= 0:
            out.push(groups.get(i))
            i = i - 1

    # Encoded OID content bytes -> dotted text.
    pub def decode(c: Vec[int]) throws str -> str:
        if c.len == 0: raise("asn1: empty OBJECT IDENTIFIER")
        mut out = ""
        mut cur = 0
        mut first = true
        mut i = 0
        while i < c.len:
            mut b = c.get(i)
            if cur == 0 and b == 128: raise("asn1: non-minimal OID arc")
            if cur > 72057594037927935: raise("asn1: OID arc too large")
            cur = (cur << 7) | (b & 127)
            if (b & 128) == 0:
                if first:
                    mut a0 = cur / 40
                    if a0 > 2: a0 = 2
                    out = f"{a0}.{cur - a0 * 40}"
                    first = false
                else:
                    out = out + "." + str(cur)
                cur = 0
            i = i + 1
        if (c.get(c.len - 1) & 128) != 0: raise("asn1: truncated OID")
        return out

    pub def RSA_ENCRYPTION() -> str: return "1.2.840.113549.1.1.1"
    pub def RSASSA_PSS() -> str: return "1.2.840.113549.1.1.10"
    pub def MGF1() -> str: return "1.2.840.113549.1.1.8"
    pub def SHA1_WITH_RSA() -> str: return "1.2.840.113549.1.1.5"
    pub def SHA256_WITH_RSA() -> str: return "1.2.840.113549.1.1.11"
    pub def SHA384_WITH_RSA() -> str: return "1.2.840.113549.1.1.12"
    pub def SHA512_WITH_RSA() -> str: return "1.2.840.113549.1.1.13"
    pub def EC_PUBLIC_KEY() -> str: return "1.2.840.10045.2.1"
    pub def PRIME256V1() -> str: return "1.2.840.10045.3.1.7"
    pub def SECP384R1() -> str: return "1.3.132.0.34"
    pub def SECP521R1() -> str: return "1.3.132.0.35"
    pub def ECDSA_SHA1() -> str: return "1.2.840.10045.4.1"
    pub def ECDSA_SHA256() -> str: return "1.2.840.10045.4.3.2"
    pub def ECDSA_SHA384() -> str: return "1.2.840.10045.4.3.3"
    pub def ECDSA_SHA512() -> str: return "1.2.840.10045.4.3.4"
    pub def SHA1() -> str: return "1.3.14.3.2.26"
    pub def SHA256() -> str: return "2.16.840.1.101.3.4.2.1"
    pub def SHA384() -> str: return "2.16.840.1.101.3.4.2.2"
    pub def SHA512() -> str: return "2.16.840.1.101.3.4.2.3"
    pub def ED25519() -> str: return "1.3.101.112"
    pub def COMMON_NAME() -> str: return "2.5.4.3"
    pub def SUBJECT_ALT_NAME() -> str: return "2.5.29.17"
    pub def BASIC_CONSTRAINTS() -> str: return "2.5.29.19"
    pub def KEY_USAGE() -> str: return "2.5.29.15"
    pub def EXT_KEY_USAGE() -> str: return "2.5.29.37"
    pub def SUBJECT_KEY_ID() -> str: return "2.5.29.14"
