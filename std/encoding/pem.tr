# std.encoding.pem — PEM (RFC 7468) armor: parse and produce
# "-----BEGIN <LABEL>-----" / base64 / "-----END <LABEL>-----" blocks.
#
# Works on byte buffers (`Vec[int]`, see std.crypto.pkutil `Bytes`) so DER
# with embedded zero bytes round-trips. Handles any number of blocks in one
# text (a CA bundle like /etc/ssl/certs/ca-certificates.crt), CRLF or LF line
# endings, and text before/between/after the blocks (e.g. the human-readable
# "Certificate:" dump `openssl x509 -text` puts in front of the armor).
#
#   Pem.encode(label, der)      -> str      (64-column lines, trailing newline)
#   Pem.decode(text)            -> PemBlock throws str   first block
#   Pem.decode_label(text, "CERTIFICATE") -> first block with that label
#   Pem.decode_all(text)        -> Vec[PemBlock]         every well-formed block
#   Pem.count(text)             -> int
#   Pem.b64_encode / Pem.b64_decode (bytes <-> base64 text, strict decoder)
#
# Strictness: the END label must equal the BEGIN label, base64 must be valid
# (whitespace ignored, `=` padding only at the end, no stray characters).
# Encrypted PEM (`Proc-Type:` / `DEK-Info:` headers, RFC 1421) is NOT
# supported: such a block is reported as an error by `decode`, and skipped by
# `decode_all`.
#
# Usage:
#   from std.encoding.pem import Pem, PemBlock
#   mut b = Pem.decode(text)?
#   print(b.label)                 # "CERTIFICATE"
#   mut der = b.data               # Vec[int] of the decoded bytes

from std.core.vec import Vec
from std.crypto.pkutil import Bytes

pub class PemBlock:
    pub label: str
    pub data:  Vec[int]

pub class Pem:
    _dummy: int

def _pem_b64val(c: int) -> int:
    if c >= 65 and c <= 90: return c - 65
    if c >= 97 and c <= 122: return c - 71
    if c >= 48 and c <= 57: return c + 4
    if c == 43: return 62
    if c == 47: return 63
    return -1

# Does the line text[s, e) start with `lit`?
def _pem_starts(t: Vec[int], s: int, e: int, lit: str) -> bool:
    mut n = lit.len()
    if e - s < n: return false
    mut p = lit as Pointer[char]
    mut i = 0
    while i < n:
        mut c = 0
        unsafe:
            c = (p.offset(i).read() as int) & 255
        if t.get(s + i) != c: return false
        i = i + 1
    return true

extend Pem:
    pub def b64_encode(data: Vec[int]) -> str:
        return Bytes.to_str(Pem._b64_vec(data))

    def _b64_vec(data: Vec[int]) -> Vec[int]:
        mut alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        mut ap = alpha as Pointer[char]
        mut out = Vec[int].init(data.len * 4 / 3 + 8)
        mut i = 0
        while i < data.len:
            mut b0 = data.get(i)
            mut have1 = i + 1 < data.len
            mut have2 = i + 2 < data.len
            mut b1 = 0
            mut b2 = 0
            if have1: b1 = data.get(i + 1)
            if have2: b2 = data.get(i + 2)
            mut v = (b0 << 16) | (b1 << 8) | b2
            mut c0 = 0
            mut c1 = 0
            mut c2 = 61
            mut c3 = 61
            unsafe:
                c0 = ap.offset((v >> 18) & 63).read() as int
                c1 = ap.offset((v >> 12) & 63).read() as int
                if have1: c2 = ap.offset((v >> 6) & 63).read() as int
                if have2: c3 = ap.offset(v & 63).read() as int
            out.push(c0)
            out.push(c1)
            out.push(c2)
            out.push(c3)
            i = i + 3
        return out

    # Strict base64 decoder: whitespace is skipped; anything else outside the
    # alphabet, data after `=`, or a bad padding length is an error.
    pub def b64_decode(text: Vec[int]) throws str -> Vec[int]:
        mut out = Vec[int].init(text.len * 3 / 4 + 4)
        mut acc = 0
        mut nbits = 0
        mut pad = 0
        mut count = 0
        mut i = 0
        while i < text.len:
            mut c = text.get(i)
            i = i + 1
            if c == 32 or c == 10 or c == 13 or c == 9: continue
            if c == 61:
                pad = pad + 1
                continue
            if pad > 0: raise("pem: data after base64 padding")
            mut v = _pem_b64val(c)
            if v < 0: raise("pem: invalid base64 character")
            acc = (acc << 6) | v
            nbits = nbits + 6
            count = count + 1
            if nbits >= 8:
                nbits = nbits - 8
                out.push((acc >> nbits) & 255)
                acc = acc & ((1 << nbits) - 1)
        if pad > 2: raise("pem: bad base64 padding")
        if count % 4 == 1: raise("pem: truncated base64")
        if pad > 0 and (count + pad) % 4 != 0: raise("pem: bad base64 padding")
        if nbits > 0 and acc != 0: raise("pem: non-zero trailing base64 bits")
        return out

    # Armor `data` as a PEM block with the given label.
    pub def encode(label: str, data: Vec[int]) -> str:
        mut b64 = Pem._b64_vec(data)
        mut out = Bytes.from_str(f"-----BEGIN {label}-----\n")
        mut n = b64.len
        mut i = 0
        while i < n:
            mut take = 64
            if i + take > n: take = n - i
            Bytes.append(out, Bytes.slice(b64, i, take))
            out.push(10)
            i = i + take
        Bytes.append(out, Bytes.from_str(f"-----END {label}-----\n"))
        return Bytes.to_str(out)

    # Every well-formed block in `text` (malformed / encrypted ones are skipped).
    pub def decode_all(text: str) -> Vec[PemBlock]:
        mut res = Vec[PemBlock].init(8)
        Pem._scan(text, res, 0)
        return res

    pub def count(text: str) -> int:
        mut res = Vec[PemBlock].init(8)
        Pem._scan(text, res, 0)
        return res.len

    # First block (any label).
    pub def decode(text: str) throws str -> PemBlock:
        mut res = Vec[PemBlock].init(2)
        mut err = Pem._scan(text, res, 1)
        if res.len == 0:
            if err != "": raise(err)
            raise("pem: no PEM block found")
        return res.get(0)

    # First block whose label equals `label`.
    pub def decode_label(text: str, label: str) throws str -> PemBlock:
        mut res = Vec[PemBlock].init(8)
        Pem._scan(text, res, 0)
        mut i = 0
        while i < res.len:
            if res.get(i).label == label: return res.get(i)
            i = i + 1
        raise(f"pem: no {label} block found")

    # Shared scanner. `limit` > 0 stops after that many blocks. Returns the
    # last error text ("" if none).
    def _scan(text: str, out: Vec[PemBlock], limit: int) -> str:
        mut t = Bytes.from_str(text)
        mut last_err = ""
        mut n = t.len
        mut pos = 0
        mut in_block = false
        mut label = ""
        mut body = Vec[int].init(256)
        mut bad = false
        while pos < n:
            mut s = pos
            mut e = pos
            while e < n and t.get(e) != 10: e = e + 1
            pos = e + 1
            mut le = e
            if le > s and t.get(le - 1) == 13: le = le - 1
            if not in_block:
                if _pem_starts(t, s, le, "-----BEGIN ") and le - s >= 16:
                    mut tail = le - 5
                    if _pem_starts(t, tail, le, "-----"):
                        in_block = true
                        bad = false
                        body.clear()
                        label = Bytes.to_str(Bytes.slice(t, s + 11, tail - s - 11))
            else:
                if _pem_starts(t, s, le, "-----END "):
                    mut tail = le - 5
                    mut end_label = ""
                    if tail >= s + 9:
                        end_label = Bytes.to_str(Bytes.slice(t, s + 9, tail - s - 9))
                    in_block = false
                    if end_label != label:
                        last_err = "pem: END label does not match BEGIN"
                    elif bad:
                        last_err = "pem: encrypted or malformed block"
                    else:
                        mut r: Result[Vec[int], str] = Pem.b64_decode(body)
                        if r.is_err:
                            last_err = r.err
                        else:
                            mut blk = PemBlock()
                            blk.label = label
                            blk.data = r.ok
                            out.push(blk)
                            if limit > 0 and out.len >= limit: return last_err
                else:
                    # header lines (Proc-Type: ...) mean legacy encrypted PEM
                    mut k = s
                    while k < le:
                        if t.get(k) == 58: bad = true
                        k = k + 1
                    if not bad:
                        mut k2 = s
                        while k2 < le:
                            body.push(t.get(k2))
                            k2 = k2 + 1
        return last_err
