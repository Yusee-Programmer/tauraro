# std.compress.zlib — zlib/deflate compression and decompression.
#
# Requires: compile with -DTAURARO_COMPRESS_ZLIB -lz
# Without that flag all methods return safe stub results (empty or original input).
#
# Usage:
#   from std.compress.zlib import Zlib
#   mut compressed = Zlib.compress("hello world", 11)
#   mut original   = Zlib.decompress(compressed, Zlib.compressed_len(compressed), 4096)   # lengths are exact, binary-safe

extern "C":
    def _tr_zlib_compress(input: str, ilen: int, out_len: Pointer[c_int]) -> Pointer[char]
    def _tr_zlib_decompress_n(input: str, ilen: int, max_out: int, out_len: Pointer[c_int]) -> Pointer[char]
    def _tr_deflate_raw(input: str, ilen: int, out_len: Pointer[c_int]) -> Pointer[char]
    def _tr_inflate_n(input: str, ilen: int, max_out: int, out_len: Pointer[c_int]) -> Pointer[char]
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_c_free(ptr: Pointer[char])

pub class Zlib:
    _dummy: int

# Wrap a C result buffer + its exact byte count as a `str` that REMEMBERS its length
# (so embedded 0x00 bytes survive and `.len()` / Zlib.compressed_len() are exact; the
# plain `_tr_str_wrap` path measured with strlen and truncated at the first 0x00).
def _wrap_exact(p: Pointer[char], n: int) -> str:
    if p as int == 0: return ""
    if n < 0: return _tr_str_wrap_len(p, 0)
    return _tr_str_wrap_len(p, n)

extend Zlib:
    # Compress `input` (first `ilen` bytes) using zlib/deflate with a zlib wrapper.
    # Returns the compressed bytes as a length-tracked str (may contain null bytes);
    # Zlib.compressed_len() returns its exact length. "" when empty/unavailable.
    pub def compress(input: str, ilen: int) -> str:
        mut out_len_buf = _tr_c_malloc(8) as Pointer[c_int]
        unsafe: out_len_buf.write(0 as c_int)
        mut raw = _tr_zlib_compress(input, ilen, out_len_buf)
        mut n = 0
        unsafe: n = out_len_buf.read() as int
        _tr_c_free(out_len_buf as Pointer[char])
        return _wrap_exact(raw, n)

    # Decompress a zlib-wrapped stream back to at most `max_out` bytes. The result is
    # length-tracked (binary-safe): use `.len()` / Zlib.compressed_len() for its size.
    pub def decompress(input: str, ilen: int, max_out: int) -> str:
        mut out_len_buf = _tr_c_malloc(8) as Pointer[c_int]
        unsafe: out_len_buf.write(0 as c_int)
        mut raw = _tr_zlib_decompress_n(input, ilen, max_out, out_len_buf)
        mut n = 0
        unsafe: n = out_len_buf.read() as int
        _tr_c_free(out_len_buf as Pointer[char])
        return _wrap_exact(raw, n)

    # Raw deflate (no zlib header). Useful for gzip member data.
    pub def deflate(input: str, ilen: int) -> str:
        mut out_len_buf = _tr_c_malloc(8) as Pointer[c_int]
        unsafe: out_len_buf.write(0 as c_int)
        mut raw = _tr_deflate_raw(input, ilen, out_len_buf)
        mut n = 0
        unsafe: n = out_len_buf.read() as int
        _tr_c_free(out_len_buf as Pointer[char])
        return _wrap_exact(raw, n)

    # Raw inflate. Matches deflate output. Length-tracked like decompress().
    pub def inflate(input: str, ilen: int, max_out: int) -> str:
        mut out_len_buf = _tr_c_malloc(8) as Pointer[c_int]
        unsafe: out_len_buf.write(0 as c_int)
        mut raw = _tr_inflate_n(input, ilen, max_out, out_len_buf)
        mut n = 0
        unsafe: n = out_len_buf.read() as int
        _tr_c_free(out_len_buf as Pointer[char])
        return _wrap_exact(raw, n)

    # Exact byte length of a result of compress()/deflate()/decompress()/inflate()
    # (binary-safe: the results carry their own length, embedded 0x00 bytes included).
    pub def compressed_len(s: str) -> int:
        return s.len()
