# std.text.shlex -- shell-style word splitting and quoting.
#
# POSIX rules (as /bin/sh and Python's shlex in POSIX mode):
#   * unquoted whitespace separates words
#   * '...' is literal; "..." allows \" \\ \$ \` and backslash-newline
#   * an unquoted backslash escapes the next character; backslash-newline
#     joins lines
#   * with `comments`, an unquoted '#' at the start of a word ends the line
#   * quotes can join parts: a'b c'"d" is the single word "ab cd"
#   * '' and "" give an empty word
# Unterminated quotes or a trailing backslash raise.
#
# Windows rules (CommandLineToArgvW / the MSVC runtime) are available as
# split_windows / quote_windows / join_windows for building or parsing
# command lines for Windows programs.
#
# Usage:
#   from std.text.shlex import Shlex
#   mut words = Shlex.split("cc -o 'my prog' \"src/a b.c\"")?   # ["cc","-o","my prog","src/a b.c"]
#   mut cmd = Shlex.join(words)                                   # cc -o 'my prog' 'src/a b.c'

from std.core.string import StringBuilder

def _sh_byte(s: str, i: int) -> int:
    mut p = s as Pointer[char]
    unsafe:
        return (p.offset(i).read() as int) & 255

def _sh_space(c: int) -> bool:
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12

def _sh_safe(c: int) -> bool:
    if c >= 97 and c <= 122: return true
    if c >= 65 and c <= 90: return true
    if c >= 48 and c <= 57: return true
    # @ % + = : , . / _ -
    return c == 64 or c == 37 or c == 43 or c == 61 or c == 58 or c == 44 or c == 46 or c == 47 or c == 95 or c == 45

pub class Shlex:
    _dummy: int

extend Shlex:
    # Split with POSIX rules (no comment handling).
    pub def split(s: str) throws str -> List[str]:
        return Shlex.split_opts(s, false)?

    # Split, treating an unquoted '#' at the start of a word as a comment.
    pub def split_comments(s: str) throws str -> List[str]:
        return Shlex.split_opts(s, true)?

    pub def split_opts(s: str, comments: bool) throws str -> List[str]:
        mut out: List[str] = []
        mut sb = StringBuilder.init(64)
        mut in_word = false
        mut i = 0
        mut n = s.len()
        while i < n:
            mut c = _sh_byte(s, i)
            if _sh_space(c):
                if in_word:
                    out.append(sb.to_owned())
                    sb.clear()
                    in_word = false
                i = i + 1
                continue
            if c == 35 and comments and not in_word:          # '#': skip to end of line
                while i < n and _sh_byte(s, i) != 10:
                    i = i + 1
                continue
            in_word = true
            if c == 39:                                       # single quotes
                i = i + 1
                mut closed = false
                while i < n:
                    mut q = _sh_byte(s, i)
                    if q == 39:
                        closed = true
                        break
                    sb.append_char(q)
                    i = i + 1
                if not closed:
                    sb.free()
                    raise("shlex: unterminated single quote")
                i = i + 1
                continue
            if c == 34:                                       # double quotes
                i = i + 1
                mut closed2 = false
                while i < n:
                    mut q2 = _sh_byte(s, i)
                    if q2 == 34:
                        closed2 = true
                        break
                    if q2 == 92 and i + 1 < n:
                        mut nx = _sh_byte(s, i + 1)
                        if nx == 34 or nx == 92 or nx == 36 or nx == 96:
                            sb.append_char(nx)
                            i = i + 2
                            continue
                        if nx == 10:
                            i = i + 2
                            continue
                    sb.append_char(q2)
                    i = i + 1
                if not closed2:
                    sb.free()
                    raise("shlex: unterminated double quote")
                i = i + 1
                continue
            if c == 92:                                       # backslash escape
                if i + 1 >= n:
                    sb.free()
                    raise("shlex: no character after backslash")
                mut e = _sh_byte(s, i + 1)
                if e == 10:
                    if sb.len() == 0: in_word = false
                    i = i + 2
                    continue
                sb.append_char(e)
                i = i + 2
                continue
            sb.append_char(c)
            i = i + 1
        if in_word: out.append(sb.to_owned())
        sb.free()
        return out

    # Quote one argument so a POSIX shell reads it back unchanged.
    pub def quote(s: str) -> str:
        if s.len() == 0: return "''"
        mut safe = true
        mut i = 0
        while i < s.len():
            if not _sh_safe(_sh_byte(s, i)): safe = false
            i = i + 1
        if safe: return s
        mut sb = StringBuilder.init(s.len() + 8)
        sb.append_char(39)
        i = 0
        while i < s.len():
            mut c = _sh_byte(s, i)
            if c == 39:
                sb.append("'\"'\"'")
            else:
                sb.append_char(c)
            i = i + 1
        sb.append_char(39)
        mut out = sb.to_owned()
        sb.free()
        return out

    # Quote and join words into one POSIX command line.
    pub def join(words: List[str]) -> str:
        mut sb = StringBuilder.init(64)
        mut i = 0
        while i < len(words):
            if i > 0: sb.append_char(32)
            mut q = Shlex.quote(words[i])
            sb.append(q)
            i = i + 1
        mut out = sb.to_owned()
        sb.free()
        return out

    # Split a Windows command line (CommandLineToArgvW rules for arguments).
    pub def split_windows(s: str) -> List[str]:
        mut out: List[str] = []
        mut sb = StringBuilder.init(64)
        mut in_word = false
        mut in_q = false
        mut i = 0
        mut n = s.len()
        while i < n:
            mut c = _sh_byte(s, i)
            if (c == 32 or c == 9) and not in_q:
                if in_word:
                    out.append(sb.to_owned())
                    sb.clear()
                    in_word = false
                i = i + 1
                continue
            in_word = true
            if c == 92:
                mut nb = 0
                while i < n and _sh_byte(s, i) == 92:
                    nb = nb + 1
                    i = i + 1
                if i < n and _sh_byte(s, i) == 34:
                    mut k = 0
                    while k < nb / 2:
                        sb.append_char(92)
                        k = k + 1
                    if nb % 2 == 1:
                        sb.append_char(34)
                        i = i + 1
                else:
                    mut k2 = 0
                    while k2 < nb:
                        sb.append_char(92)
                        k2 = k2 + 1
                continue
            if c == 34:
                if in_q and i + 1 < n and _sh_byte(s, i + 1) == 34:
                    sb.append_char(34)                         # "" inside quotes -> "
                    i = i + 2
                    continue
                in_q = not in_q
                i = i + 1
                continue
            sb.append_char(c)
            i = i + 1
        if in_word: out.append(sb.to_owned())
        sb.free()
        return out

    # Quote one argument for a Windows command line.
    pub def quote_windows(s: str) -> str:
        mut needs = s.len() == 0
        mut i = 0
        while i < s.len():
            mut c = _sh_byte(s, i)
            if c == 32 or c == 9 or c == 34 or c == 10 or c == 11: needs = true
            i = i + 1
        if not needs: return s
        mut sb = StringBuilder.init(s.len() + 8)
        sb.append_char(34)
        i = 0
        mut nb = 0
        while i < s.len():
            mut c2 = _sh_byte(s, i)
            if c2 == 92:
                nb = nb + 1
            elif c2 == 34:
                mut k = 0
                while k < nb * 2 + 1:
                    sb.append_char(92)
                    k = k + 1
                nb = 0
                sb.append_char(34)
                i = i + 1
                continue
            else:
                mut k2 = 0
                while k2 < nb:
                    sb.append_char(92)
                    k2 = k2 + 1
                nb = 0
            if c2 != 92: sb.append_char(c2)
            i = i + 1
        mut k3 = 0
        while k3 < nb * 2:
            sb.append_char(92)
            k3 = k3 + 1
        sb.append_char(34)
        mut out = sb.to_owned()
        sb.free()
        return out

    pub def join_windows(words: List[str]) -> str:
        mut sb = StringBuilder.init(64)
        mut i = 0
        while i < len(words):
            if i > 0: sb.append_char(32)
            mut q = Shlex.quote_windows(words[i])
            sb.append(q)
            i = i + 1
        mut out = sb.to_owned()
        sb.free()
        return out
