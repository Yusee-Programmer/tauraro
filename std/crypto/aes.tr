        0xa0,0xe0,0x3b,0x4d,0xae,0x2a,0xf5,0xb0,0xc8,0xeb,0xbb,0x3c,0x83,0x53,0x99,0x61,
        0x17,0x2b,0x04,0x7e,0xba,0x77,0xd6,0x26,0xe1,0x69,0x14,0x63,0x55,0x21,0x0c,0x7d,
    ]

# Round constants used in key expansion (Rcon[i] as the byte in word position 0).
pub def _aes_rcon() -> List[int]:
    return [0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1b,0x36,0x6c,0xd8,0xab,0x4d]

# ─── GF(2^8) arithmetic for MixColumns ────────────────────────────────────────

# Multiply two bytes in GF(2^8) with the AES reduction polynomial
# x^8 + x^4 + x^3 + x + 1 (0x11b).
pub def _gmul(a: int, b: int) -> int:
    mut aa = a & 0xff
    mut bb = b & 0xff
    mut p = 0
    mut i = 0
    while i < 8:
        if (bb & 1) != 0:
            p = p ^ aa
        mut hi_bit = aa & 0x80
        aa = (aa << 1) & 0xff
        if hi_bit != 0:
            aa = aa ^ 0x1b
        bb = bb >> 1
        i = i + 1
    return p & 0xff

# ─── Key expansion ─────────────────────────────────────────────────────────

# Expand a 16- or 32-byte key into the round-key schedule (a flat byte list
# of length 16 * (Nr + 1)). `nk` = key length in 32-bit words (4 for
# AES-128, 8 for AES-256); `nr` = number of rounds (10 or 14).
pub def _key_expansion(key: List[int], nk: int, nr: int) -> List[int]:
    mut sbox = _aes_sbox()
    mut rcon = _aes_rcon()
    mut total_words = 4 * (nr + 1)
    # w[word][0..3] flattened as w[word*4 + byte]
    mut w: List[int] = []
    mut i = 0
    while i < total_words * 4:
        w.append(0)
        i = i + 1

    # First Nk words come directly from the key.
    i = 0
    while i < nk:
        w[i * 4 + 0] = key[i * 4 + 0]
        w[i * 4 + 1] = key[i * 4 + 1]
        w[i * 4 + 2] = key[i * 4 + 2]
        w[i * 4 + 3] = key[i * 4 + 3]
        i = i + 1

    i = nk
    while i < total_words:
        mut t0 = w[(i - 1) * 4 + 0]
        mut t1 = w[(i - 1) * 4 + 1]
        mut t2 = w[(i - 1) * 4 + 2]
        mut t3 = w[(i - 1) * 4 + 3]

        if i % nk == 0:
            # RotWord
            mut r0 = t1
            mut r1 = t2
            mut r2 = t3
            mut r3 = t0
            # SubWord
            r0 = sbox[r0]
            r1 = sbox[r1]
            r2 = sbox[r2]
            r3 = sbox[r3]
            # Rcon
            r0 = r0 ^ rcon[i / nk - 1]
            t0 = r0
            t1 = r1
            t2 = r2
            t3 = r3
        else:
            if nk > 6 and i % nk == 4:
                # AES-256 extra SubWord (no RotWord/Rcon) at word position 4 mod Nk.
                t0 = sbox[t0]
                t1 = sbox[t1]
                t2 = sbox[t2]
                t3 = sbox[t3]

        w[i * 4 + 0] = w[(i - nk) * 4 + 0] ^ t0
        w[i * 4 + 1] = w[(i - nk) * 4 + 1] ^ t1
        w[i * 4 + 2] = w[(i - nk) * 4 + 2] ^ t2
        w[i * 4 + 3] = w[(i - nk) * 4 + 3] ^ t3
        i = i + 1

    return w

# ─── Single-block encrypt / decrypt ───────────────────────────────────────

# state is a 16-byte List[int] laid out column-major per FIPS-197
# (state[r + 4*c]); round_keys is the flat schedule from _key_expansion.
pub def _add_round_key(state: List[int], round_keys: List[int], round: int):
    mut base = round * 16
    mut i = 0
    while i < 16:
        state[i] = state[i] ^ round_keys[base + i]
        i = i + 1

pub def _sub_bytes(state: List[int], sbox: List[int]):
    mut i = 0
    while i < 16:
        state[i] = sbox[state[i]]
        i = i + 1

pub def _inv_sub_bytes(state: List[int], inv_sbox: List[int]):
    mut i = 0
    while i < 16:
        state[i] = inv_sbox[state[i]]
        i = i + 1

# ShiftRows: row r is shifted left by r positions. state[r + 4*c].
pub def _shift_rows(state: List[int]):
    # Row 1: shift left by 1
    mut t = state[1]
    state[1] = state[5]
    state[5] = state[9]
    state[9] = state[13]
    state[13] = t
    # Row 2: shift left by 2
    mut t0 = state[2]
    mut t1 = state[6]
    state[2] = state[10]
    state[6] = state[14]
    state[10] = t0
    state[14] = t1
    # Row 3: shift left by 3 (= shift right by 1)
    mut t3 = state[15]
    state[15] = state[11]
    state[11] = state[7]
    state[7] = state[3]
    state[3] = t3

pub def _inv_shift_rows(state: List[int]):
    # Row 1: shift right by 1
    mut t = state[13]
    state[13] = state[9]
    state[9] = state[5]
    state[5] = state[1]
    state[1] = t
    # Row 2: shift right by 2 (same as shift left by 2 — self-inverse)
    mut t0 = state[2]
    mut t1 = state[6]
    state[2] = state[10]
    state[6] = state[14]
    state[10] = t0
    state[14] = t1
    # Row 3: shift right by 3 (= shift left by 1)
    mut t3 = state[3]
    state[3] = state[7]
    state[7] = state[11]
    state[11] = state[15]
    state[15] = t3

pub def _mix_columns(state: List[int]):
    mut c = 0
    while c < 4:
        mut base = c * 4
        mut a0 = state[base + 0]
        mut a1 = state[base + 1]
        mut a2 = state[base + 2]
        mut a3 = state[base + 3]
        state[base + 0] = _gmul(a0, 2) ^ _gmul(a1, 3) ^ a2 ^ a3
        state[base + 1] = a0 ^ _gmul(a1, 2) ^ _gmul(a2, 3) ^ a3
        state[base + 2] = a0 ^ a1 ^ _gmul(a2, 2) ^ _gmul(a3, 3)
        state[base + 3] = _gmul(a0, 3) ^ a1 ^ a2 ^ _gmul(a3, 2)
        c = c + 1

pub def _inv_mix_columns(state: List[int]):
    mut c = 0
    while c < 4:
        mut base = c * 4
        mut a0 = state[base + 0]
        mut a1 = state[base + 1]
        mut a2 = state[base + 2]
        mut a3 = state[base + 3]
        state[base + 0] = _gmul(a0, 14) ^ _gmul(a1, 11) ^ _gmul(a2, 13) ^ _gmul(a3, 9)
        state[base + 1] = _gmul(a0, 9) ^ _gmul(a1, 14) ^ _gmul(a2, 11) ^ _gmul(a3, 13)
        state[base + 2] = _gmul(a0, 13) ^ _gmul(a1, 9) ^ _gmul(a2, 14) ^ _gmul(a3, 11)
        state[base + 3] = _gmul(a0, 11) ^ _gmul(a1, 13) ^ _gmul(a2, 9) ^ _gmul(a3, 14)
        c = c + 1

# Encrypt exactly one 16-byte block. `round_keys` from _key_expansion, `nr`
# = number of rounds (10 for AES-128, 14 for AES-256).
pub def _encrypt_block(block: List[int], round_keys: List[int], nr: int) -> List[int]:
    mut sbox = _aes_sbox()
    mut state: List[int] = []
    mut i = 0
    while i < 16:
        state.append(block[i])
        i = i + 1

    _add_round_key(state, round_keys, 0)

    mut round = 1
    while round < nr:
        _sub_bytes(state, sbox)
        _shift_rows(state)
        _mix_columns(state)
        _add_round_key(state, round_keys, round)
        round = round + 1

    _sub_bytes(state, sbox)
    _shift_rows(state)
    _add_round_key(state, round_keys, nr)

    return state

# Decrypt exactly one 16-byte block.
pub def _decrypt_block(block: List[int], round_keys: List[int], nr: int) -> List[int]:
    mut inv_sbox = _aes_inv_sbox()
    mut state: List[int] = []
    mut i = 0
    while i < 16:
        state.append(block[i])
        i = i + 1

    _add_round_key(state, round_keys, nr)

    mut round = nr - 1
    while round > 0:
        _inv_shift_rows(state)
        _inv_sub_bytes(state, inv_sbox)
        _add_round_key(state, round_keys, round)
        _inv_mix_columns(state)
        round = round - 1

    _inv_shift_rows(state)
    _inv_sub_bytes(state, inv_sbox)
    _add_round_key(state, round_keys, 0)

    return state

# ─── Public API ────────────────────────────────────────────────────────────

pub class Aes:
    _dummy: int

extend Aes:
    # Encrypt exactly one 16-byte block (raw bytes in, raw bytes out — no
    # padding, no chaining). `key` must be `klen` bytes: 16 (AES-128) or
    # 32 (AES-256). Mainly useful for testing against known-answer
    # vectors; most callers want encrypt_cbc instead.
    #
    # `klen` is required (not inferred via strlen) because key material is
    # raw binary and may legitimately contain embedded NUL bytes.
    pub def encrypt_block(plaintext: str, key: str, klen: int) -> str:
        mut key_bytes = Aes._raw_bytes(key, klen)
        mut nk = 4
        mut nr = 10
        if klen == 32:
            nk = 8
            nr = 14
        mut round_keys = _key_expansion(key_bytes, nk, nr)
        mut block = Aes._raw_bytes(plaintext, 16)
        mut out = _encrypt_block(block, round_keys, nr)
        return Aes._bytes_to_str(out)

    # Decrypt exactly one 16-byte block (raw bytes in, raw bytes out).
    # See encrypt_block for why `klen` is required explicitly.
    pub def decrypt_block(ciphertext: str, key: str, klen: int) -> str:
        mut key_bytes = Aes._raw_bytes(key, klen)
        mut nk = 4
        mut nr = 10
        if klen == 32:
            nk = 8
            nr = 14
        mut round_keys = _key_expansion(key_bytes, nk, nr)
        mut block = Aes._raw_bytes(ciphertext, 16)
        mut out = _decrypt_block(block, round_keys, nr)
        return Aes._bytes_to_str(out)

    # Encrypt `plen` bytes of `plaintext` under CBC mode with PKCS#7
    # padding. `key` must be exactly `klen` bytes: 16 (AES-128) or 32
    # (AES-256); `iv` must be exactly 16 bytes and MUST be fresh random
    # data for every call with a given key (never reuse an IV). Returns
    # the raw ciphertext bytes as a str (may contain embedded NUL bytes —
    # use the returned length, not strlen, when passing it on).
    #
    # `klen` is required explicitly (not inferred via strlen) because key
    # bytes are raw binary and may legitimately contain embedded NULs;
    # `iv` is always read as exactly 16 raw bytes for the same reason.
    pub def encrypt_cbc(plaintext: str, plen: int, key: str, klen: int, iv: str) -> str:
        mut key_bytes = Aes._raw_bytes(key, klen)
        mut nk = 4
        mut nr = 10
        if klen == 32:
            nk = 8
            nr = 14
        mut round_keys = _key_expansion(key_bytes, nk, nr)

        mut iv_bytes = Aes._raw_bytes(iv, 16)
        mut prev: List[int] = []
        mut i = 0
        while i < 16:
            prev.append(iv_bytes[i])
            i = i + 1

        mut padded = Aes._pkcs7_pad(plaintext, plen)
        mut total = len(padded)

        mut sb = StringBuilder.init(total + 2)
        mut off = 0
        while off < total:
            mut block: List[int] = []
            mut j = 0
            while j < 16:
                block.append(padded[off + j] ^ prev[j])
                j = j + 1
            mut enc = _encrypt_block(block, round_keys, nr)
            mut k = 0
            while k < 16:
                sb.append_char(enc[k])
                k = k + 1
            prev = enc
            off = off + 16

        mut out = sb.to_owned()
        sb.free()
        return out

    # Decrypt `clen` bytes of CBC+PKCS#7 ciphertext. `key` must be exactly
    # `klen` bytes (16 or 32). Returns the original plaintext. On invalid
    # padding (corrupted ciphertext, wrong key, etc.) returns "" — callers
    # that need to distinguish a genuinely-empty plaintext from a padding
    # failure should use decrypt_cbc_checked below instead.
    pub def decrypt_cbc(ciphertext: str, clen: int, key: str, klen: int, iv: str) -> str:
        mut ok = [true]
        return Aes._decrypt_cbc_impl(ciphertext, clen, key, klen, iv, ok)

    # Same as decrypt_cbc, but also reports success/failure explicitly via
    # an out-parameter-style single-element List[bool] (`ok[0]` is set to
    # true on success, false if padding validation failed — e.g. tampered
    # ciphertext). This is the recommended entry point whenever the caller
    # cannot tell a genuinely-empty plaintext apart from a decrypt failure.
    pub def decrypt_cbc_checked(ciphertext: str, clen: int, key: str, klen: int, iv: str, ok: List[bool]) -> str:
        return Aes._decrypt_cbc_impl(ciphertext, clen, key, klen, iv, ok)

    pub def _decrypt_cbc_impl(ciphertext: str, clen: int, key: str, klen: int, iv: str, ok: List[bool]) -> str:
        if clen % 16 != 0 or clen == 0:
            ok[0] = false
            return ""

        mut key_bytes = Aes._raw_bytes(key, klen)
        mut nk = 4
        mut nr = 10
        if klen == 32:
            nk = 8
            nr = 14
        mut round_keys = _key_expansion(key_bytes, nk, nr)

        mut iv_bytes = Aes._raw_bytes(iv, 16)
        mut prev: List[int] = []
        mut i = 0
        while i < 16:
            prev.append(iv_bytes[i])
            i = i + 1

        mut ct_bytes = Aes._raw_bytes(ciphertext, clen)

        mut sb = StringBuilder.init(clen + 2)
        mut off = 0
        while off < clen:
            mut block: List[int] = []
            mut j = 0
            while j < 16:
                block.append(ct_bytes[off + j])
                j = j + 1
            mut dec = _decrypt_block(block, round_keys, nr)
            mut k = 0
            while k < 16:
                sb.append_char(dec[k] ^ prev[k])
                k = k + 1
            prev = block
            off = off + 16

        mut total = sb.len()
        mut plain = sb.to_owned()
        sb.free()

        # Verify + strip PKCS#7 padding.
        mut pad_len = Aes._raw_byte_at(plain, total - 1)
        if pad_len < 1 or pad_len > 16 or pad_len > total:
            ok[0] = false
            return ""
        mut i2 = total - pad_len
        mut valid = true
        while i2 < total:
            if Aes._raw_byte_at(plain, i2) != pad_len:
                valid = false
                break
            i2 = i2 + 1
        if not valid:
            ok[0] = false
            return ""

        ok[0] = true
        return Aes._substr(plain, total - pad_len)

    # ── internal helpers ──

    # Read `n` raw bytes from `s` without relying on strlen (safe even when
    # the buffer contains embedded NUL bytes, as ciphertext commonly does).
    # `& 0xff` (not `% 256`) is required: `char` is signed on this target,
    # so a byte like 0xff reads back as int -1, and Tauraro's `%` follows
    # the sign of the dividend (like C) so `-1 % 256` is -1, not 255 --
    # only a bitwise mask correctly reinterprets the two's-complement bit
    # pattern as an unsigned byte value.
    pub def _raw_bytes(s: str, n: int) -> List[int]:
        mut p = s as Pointer[char]
        mut out: List[int] = []
        mut i = 0
        while i < n:
            out.append((p.offset(i).read() as int) & 0xff)
            i = i + 1
        return out

    pub def _raw_byte_at(s: str, idx: int) -> int:
        mut p = s as Pointer[char]
        return (p.offset(idx).read() as int) & 0xff

    # Copy out the first `n` raw bytes of `s` as a fresh str (handles
    # embedded NULs; used to trim padding off decrypted plaintext).
    pub def _substr(s: str, n: int) -> str:
        mut p = s as Pointer[char]
        mut sb = StringBuilder.init(n + 2)
        mut i = 0
        while i < n:
            sb.append_char((p.offset(i).read() as int) & 0xff)
            i = i + 1
        mut out = sb.to_owned()
        sb.free()
        return out

    pub def _bytes_to_str(bytes_: List[int]) -> str:
        mut sb = StringBuilder.init(len(bytes_) + 2)
        mut i = 0
        while i < len(bytes_):
            sb.append_char(bytes_[i])
            i = i + 1
        mut out = sb.to_owned()
        sb.free()
        return out

    # PKCS#7-pad `plen` raw bytes of `s` up to a multiple of 16, returned
    # as a List[int] of bytes (pad value == number of pad bytes added,
    # 1..16 — an already-block-aligned input gets a full extra block of
    # padding, per the standard, so padding is always unambiguous to
    # strip on decrypt).
    pub def _pkcs7_pad(s: str, plen: int) -> List[int]:
        mut pad = 16 - (plen % 16)
        mut total = plen + pad
        mut p = s as Pointer[char]
        mut out: List[int] = []
        mut i = 0
        while i < plen:
            out.append((p.offset(i).read() as int) & 0xff)
            i = i + 1
        mut j = 0
        while j < pad:
            out.append(pad)
            j = j + 1
        return out
