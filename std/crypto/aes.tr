# std.crypto.aes — AES (Rijndael) symmetric block cipher, CBC mode + PKCS#7.
#
# Pure Tauraro implementation (standard S-box/round tables as literal
# constants, per FIPS-197) — compiles straight to native C, no runtime
# dependency needed, following the same approach as std/crypto/hash.tr's
# SHA-256.
#
# Supports AES-128 (10 rounds, 16-byte key) and AES-256 (14 rounds,
# 32-byte key), selected automatically from the key length passed to
# encrypt_cbc/decrypt_cbc. AES-192 is not implemented (rare in practice;
# add if needed — same structure, Nk=6/Nr=12).
#
# SECURITY NOTE: CBC mode alone is NOT authenticated. An attacker who can
# modify ciphertext in transit can flip bits that corrupt the decrypted
# plaintext in predictable ways, and this module will NOT detect that
# tampering (only PKCS#7 padding corruption is detected, and only
# probabilistically). If you need tamper detection, encrypt-then-MAC:
# compute an HMAC (see std/crypto/hmac.tr) over the ciphertext + IV using
# a *separate* key, send it alongside, and verify it before decrypting.
#
# Usage:
#   from std.crypto.aes import Aes
#   from std.math.random import Random          # for a fresh IV — see below
#
#   mut key = Hex.decode("000102030405060708090a0b0c0d0e0f")   # 16 bytes -> AES-128
#   mut iv  = "................"                                # 16 bytes, CALLER-supplied,
#                                                                 # must be fresh & random per message
#   mut ct  = Aes.encrypt_cbc("hello world", 11, key, iv)
#   mut pt  = Aes.decrypt_cbc(ct, ct.len(), key, iv)
#   # pt == "hello world"
#
# IV requirement: encrypt_cbc does NOT generate the IV for you — the
# caller must supply 16 fresh random bytes per encryption (reusing an IV
# with the same key leaks information about plaintext relationships).
# Use std/math/random.tr to generate one; this module deliberately does
# not do it silently, to avoid IV-reuse footguns hidden behind a
# "convenient" default.

from std.core.string import StringBuilder

extern "C":
    def _tr_strlen(s: str) -> int

# ─── AES S-box / inverse S-box (FIPS-197, Figure 7 / Figure 14) ──────────────

pub def _aes_sbox() -> List[int]:
    return [
        0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
        0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
        0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
        0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
        0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
        0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
        0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
        0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
        0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
        0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
