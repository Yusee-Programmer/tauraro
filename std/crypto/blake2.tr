# std.crypto.blake2 — BLAKE2b and BLAKE2s (RFC 7693), pure Tauraro.
#
#   BLAKE2b: 64-bit words, digests of 1..64 bytes, keys up to 64 bytes
#   BLAKE2s: 32-bit words, digests of 1..32 bytes, keys up to 32 bytes
#
# Both support the optional keyed (MAC) mode and the salt / personalization
# parameters (16 bytes each for BLAKE2b, 8 bytes for BLAKE2s) and an incremental
# `update` API. Sequential mode only (no tree hashing).
#
# Verified against the RFC 7693 appendix vectors (BLAKE2b-512("abc"),
# BLAKE2s-256("abc")) and the official BLAKE2 known-answer-test keyed vectors,
# and cross-checked against Python hashlib (blake2b / blake2s, including key,
# salt, person, digest_size) over every block-boundary length — see
# tests/lang/111_blake2.tr.
#
# Binary convention: inputs are a `str` (true length `s.len()` used); outputs are
# RAW bytes in a `str` of the true length (Hex.encode to print) or lowercase hex
# via the `_hex` helpers.
#
# Usage:
#   from std.crypto.blake2 import Blake2b, Blake2s, Blake2bHasher, Blake2sHasher
#   print(Blake2b.hash_hex("abc", 64))                 # BLAKE2b-512
#   print(Blake2s.hash_hex("abc", 32))                 # BLAKE2s-256
#   mut mac = Blake2b.keyed("message", "secret key", 32)   # raw 32-byte MAC
#
#   mut h = Blake2bHasher.init(32, "")                 # outlen 32, no key
#   h.update("ab")
#   h.update("c")
#   mut d = h.finalize()
#   h.free()
#
# Invalid parameters (outlen out of range, key too long, wrong salt/person size)
# return an empty string from the one-shot helpers.
#
# The hasher wipes its state/key buffer in `free()`.

from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

extern "C":
    def _tr_c_free(ptr: Pointer[char])
    def _tr_c_secure_zero(ptr: Pointer[char], n: int)


# message-word schedule (RFC 7693 section 2.7): row r, entry i, one hex digit each.
# BLAKE2b's rounds 10 and 11 reuse rows 0 and 1.
def b2_sig(r: int, i: int) -> int:
    mut rows = "0123456789abcdefea489fd61c02b753b8c052fdae3671947931dcbe265a40f8905724afe1bc683d2c6a0b834d75fe19c51fed4a0763928bdb7ec13950f4862a6fe9b308c2d714a5a2847615fb9e3cd0"
    mut p = rows as Pointer[char]
    mut c = 0
    unsafe:
        c = p.offset(r * 16 + i).read() as int
    if c >= 97: return c - 87
    return c - 48

def b2b_iv(i: int) -> u64:
    if i == 0: return 0x6a09e667f3bcc908 as u64
    if i == 1: return 0xbb67ae8584caa73b as u64
    if i == 2: return 0x3c6ef372fe94f82b as u64
    if i == 3: return 0xa54ff53a5f1d36f1 as u64
    if i == 4: return 0x510e527fade682d1 as u64
    if i == 5: return 0x9b05688c2b3e6c1f as u64
    if i == 6: return 0x1f83d9abfb41bd6b as u64
    return 0x5be0cd19137e2179 as u64

def b2s_iv(i: int) -> u32:
    if i == 0: return 0x6a09e667 as u32
    if i == 1: return 0xbb67ae85 as u32
    if i == 2: return 0x3c6ef372 as u32
    if i == 3: return 0xa54ff53a as u32
    if i == 4: return 0x510e527f as u32
    if i == 5: return 0x9b05688c as u32
    if i == 6: return 0x1f83d9ab as u32
    return 0x5be0cd19 as u32

def b2_ld64(p: Pointer[u64], i: int) -> u64:
    unsafe:
        return p.offset(i).read()

def b2_st64(p: Pointer[u64], i: int, v: u64):
    unsafe:
        p.offset(i).write(v)

def b2_ld32(p: Pointer[u32], i: int) -> u32:
    unsafe:
        return p.offset(i).read()

def b2_st32(p: Pointer[u32], i: int, v: u32):
    unsafe:
        p.offset(i).write(v)

def b2_rotr64(x: u64, n: int) -> u64:
    return (x >> n) | (x << (64 - n))

def b2_rotr32(x: u32, n: int) -> u32:
    return (x >> n) | (x << (32 - n))

# little-endian word loads from a byte buffer
def b2_le64(p: Pointer[char], off: int) -> u64:
    mut r: u64 = 0
    mut k = 0
    while k < 8:
        mut b = 0
        unsafe:
            b = (p.offset(off + k).read() as int) & 255
        r = r | ((b as u64) << (8 * k))
        k = k + 1
    return r

def b2_le32(p: Pointer[char], off: int) -> u32:
    mut r: u32 = 0
    mut k = 0
    while k < 4:
        mut b = 0
        unsafe:
            b = (p.offset(off + k).read() as int) & 255
        r = r | ((b as u32) << (8 * k))
        k = k + 1
    return r

def b2b_g(v: Pointer[u64], a: int, b: int, c: int, d: int, x: u64, y: u64):
    mut va: u64 = b2_ld64(v, a)
    mut vb: u64 = b2_ld64(v, b)
    mut vc: u64 = b2_ld64(v, c)
    mut vd: u64 = b2_ld64(v, d)
    va = va + vb + x
    vd = b2_rotr64(vd ^ va, 32)
    vc = vc + vd
    vb = b2_rotr64(vb ^ vc, 24)
    va = va + vb + y
    vd = b2_rotr64(vd ^ va, 16)
    vc = vc + vd
    vb = b2_rotr64(vb ^ vc, 63)
    b2_st64(v, a, va)
    b2_st64(v, b, vb)
    b2_st64(v, c, vc)
    b2_st64(v, d, vd)

def b2s_g(v: Pointer[u32], a: int, b: int, c: int, d: int, x: u32, y: u32):
    mut va: u32 = b2_ld32(v, a)
    mut vb: u32 = b2_ld32(v, b)
    mut vc: u32 = b2_ld32(v, c)
    mut vd: u32 = b2_ld32(v, d)
    va = va + vb + x
    vd = b2_rotr32(vd ^ va, 16)
    vc = vc + vd
    vb = b2_rotr32(vb ^ vc, 12)
    va = va + vb + y
    vd = b2_rotr32(vd ^ va, 8)
    vc = vc + vd
    vb = b2_rotr32(vb ^ vc, 7)
    b2_st32(v, a, va)
    b2_st32(v, b, vb)
    b2_st32(v, c, vc)
    b2_st32(v, d, vd)

# Compression function F for BLAKE2b. h: 8 words, v: 16 words scratch, m: 16 words
# scratch, block: 128 bytes, t: byte counter (low 64 bits), last: final-block flag.
pub def blake2b_compress(h: Pointer[u64], v: Pointer[u64], m: Pointer[u64], block: Pointer[char], t: u64, last: bool):
    mut i = 0
    while i < 16:
        b2_st64(m, i, b2_le64(block, i * 8))
        i = i + 1
    i = 0
    while i < 8:
        b2_st64(v, i, b2_ld64(h, i))
        b2_st64(v, i + 8, b2b_iv(i))
        i = i + 1
    b2_st64(v, 12, b2_ld64(v, 12) ^ t)
    if last: b2_st64(v, 14, ~b2_ld64(v, 14))
    mut r = 0
    while r < 12:
        mut s = r % 10
        b2b_g(v, 0, 4, 8, 12, b2_ld64(m, b2_sig(s, 0)), b2_ld64(m, b2_sig(s, 1)))
        b2b_g(v, 1, 5, 9, 13, b2_ld64(m, b2_sig(s, 2)), b2_ld64(m, b2_sig(s, 3)))
        b2b_g(v, 2, 6, 10, 14, b2_ld64(m, b2_sig(s, 4)), b2_ld64(m, b2_sig(s, 5)))
        b2b_g(v, 3, 7, 11, 15, b2_ld64(m, b2_sig(s, 6)), b2_ld64(m, b2_sig(s, 7)))
        b2b_g(v, 0, 5, 10, 15, b2_ld64(m, b2_sig(s, 8)), b2_ld64(m, b2_sig(s, 9)))
        b2b_g(v, 1, 6, 11, 12, b2_ld64(m, b2_sig(s, 10)), b2_ld64(m, b2_sig(s, 11)))
        b2b_g(v, 2, 7, 8, 13, b2_ld64(m, b2_sig(s, 12)), b2_ld64(m, b2_sig(s, 13)))
        b2b_g(v, 3, 4, 9, 14, b2_ld64(m, b2_sig(s, 14)), b2_ld64(m, b2_sig(s, 15)))
        r = r + 1
    i = 0
    while i < 8:
        b2_st64(h, i, b2_ld64(h, i) ^ b2_ld64(v, i) ^ b2_ld64(v, i + 8))
        i = i + 1

pub def blake2s_compress(h: Pointer[u32], v: Pointer[u32], m: Pointer[u32], block: Pointer[char], t: u64, last: bool):
    mut i = 0
    while i < 16:
        b2_st32(m, i, b2_le32(block, i * 4))
        i = i + 1
    i = 0
    while i < 8:
        b2_st32(v, i, b2_ld32(h, i))
        b2_st32(v, i + 8, b2s_iv(i))
        i = i + 1
    b2_st32(v, 12, b2_ld32(v, 12) ^ ((t & (0xFFFFFFFF as u64)) as u32))
    b2_st32(v, 13, b2_ld32(v, 13) ^ ((t >> 32) as u32))
    if last: b2_st32(v, 14, ~b2_ld32(v, 14))
    mut r = 0
    while r < 10:
        b2s_g(v, 0, 4, 8, 12, b2_ld32(m, b2_sig(r, 0)), b2_ld32(m, b2_sig(r, 1)))
        b2s_g(v, 1, 5, 9, 13, b2_ld32(m, b2_sig(r, 2)), b2_ld32(m, b2_sig(r, 3)))
        b2s_g(v, 2, 6, 10, 14, b2_ld32(m, b2_sig(r, 4)), b2_ld32(m, b2_sig(r, 5)))
        b2s_g(v, 3, 7, 11, 15, b2_ld32(m, b2_sig(r, 6)), b2_ld32(m, b2_sig(r, 7)))
        b2s_g(v, 0, 5, 10, 15, b2_ld32(m, b2_sig(r, 8)), b2_ld32(m, b2_sig(r, 9)))
        b2s_g(v, 1, 6, 11, 12, b2_ld32(m, b2_sig(r, 10)), b2_ld32(m, b2_sig(r, 11)))
        b2s_g(v, 2, 7, 8, 13, b2_ld32(m, b2_sig(r, 12)), b2_ld32(m, b2_sig(r, 13)))
        b2s_g(v, 3, 4, 9, 14, b2_ld32(m, b2_sig(r, 14)), b2_ld32(m, b2_sig(r, 15)))
        r = r + 1
    i = 0
    while i < 8:
        b2_st32(h, i, b2_ld32(h, i) ^ b2_ld32(v, i) ^ b2_ld32(v, i + 8))
        i = i + 1

# ─── BLAKE2b incremental hasher ──────────────────────────────────────────────

pub class Blake2bHasher:
    mem:     Pointer[char]     # one allocation: h[8] v[16] m[16] (u64) then the 128-byte buffer
    h:       Pointer[u64]
    v:       Pointer[u64]
    m:       Pointer[u64]
    buf:     Pointer[char]
    buflen:  int
    t:       u64
    outlen:  int
    done:    bool
    ok:      bool              # false if the parameters were invalid

extend Blake2bHasher:
    # Unkeyed hasher with `outlen` output bytes (1..64) and a (possibly empty) key.
    # `key` may be "" for plain hashing; up to 64 bytes.
    pub def init(outlen: int, key: str) -> Blake2bHasher:
        return Blake2bHasher.init_full(outlen, key, "", "")

    # Full parameter form: `salt` and `person` must each be "" or exactly 16 bytes.
    pub def init_full(outlen: int, key: str, salt: str, person: str) -> Blake2bHasher:
        mut x = Blake2bHasher()
        x.mem = CryptoBytes.zeroed(40 * 8 + 128)
        mut base = x.mem
        x.h = base as Pointer[u64]
        unsafe:
            x.v = base.offset(8 * 8) as Pointer[u64]
            x.m = base.offset(24 * 8) as Pointer[u64]
            x.buf = base.offset(40 * 8)
        x.buflen = 0
        x.t = 0
        x.outlen = outlen
        x.done = false
        x.ok = true
        mut kl = key.len()
        if outlen < 1 or outlen > 64 or kl > 64: x.ok = false
        if salt.len() != 0 and salt.len() != 16: x.ok = false
        if person.len() != 0 and person.len() != 16: x.ok = false
        if not x.ok: return x
        mut i = 0
        while i < 8:
            b2_st64(x.h, i, b2b_iv(i))
            i = i + 1
        b2_st64(x.h, 0, b2_ld64(x.h, 0) ^ ((0x01010000 ^ (kl << 8) ^ outlen) as u64))
        if salt.len() == 16:
            mut sp = salt as Pointer[char]
            b2_st64(x.h, 4, b2_ld64(x.h, 4) ^ b2_le64(sp, 0))
            b2_st64(x.h, 5, b2_ld64(x.h, 5) ^ b2_le64(sp, 8))
        if person.len() == 16:
            mut pp = person as Pointer[char]
            b2_st64(x.h, 6, b2_ld64(x.h, 6) ^ b2_le64(pp, 0))
            b2_st64(x.h, 7, b2_ld64(x.h, 7) ^ b2_le64(pp, 8))
        if kl > 0:
            mut kp = key as Pointer[char]
            i = 0
            while i < kl:
                unsafe:
                    x.buf.offset(i).write(kp.offset(i).read())
                i = i + 1
            x.buflen = 128
        return x

    pub def is_ok(self) -> bool:
        return self.ok

    pub def update_bytes(self, data: str, n: int):
        if not self.ok or self.done: return
        mut p = data as Pointer[char]
        mut i = 0
        while i < n:
            if self.buflen == 128:
                self.t = self.t + (128 as u64)
                blake2b_compress(self.h, self.v, self.m, self.buf, self.t, false)
                self.buflen = 0
            unsafe:
                self.buf.offset(self.buflen).write(p.offset(i).read())
            self.buflen = self.buflen + 1
            i = i + 1

    pub def update(self, data: str):
        self.update_bytes(data, data.len())

    # Finish and return the `outlen`-byte digest (raw). Returns "" if the
    # parameters were invalid. Call at most once; a second call returns "".
    pub def finalize(self) -> str:
        if not self.ok or self.done: return ""
        self.done = true
        self.t = self.t + (self.buflen as u64)
        mut i = self.buflen
        while i < 128:
            unsafe:
                self.buf.offset(i).write('\0')
            i = i + 1
        blake2b_compress(self.h, self.v, self.m, self.buf, self.t, true)
        mut out: Pointer[char] = CryptoBytes.zeroed(self.outlen)
        i = 0
        while i < self.outlen:
            mut w: u64 = b2_ld64(self.h, i >> 3)
            CryptoBytes.put(out, i, ((w >> ((i & 7) * 8)) & (255 as u64)) as int)
            i = i + 1
        return CryptoBytes.wrap(out, self.outlen)

    pub def finalize_hex(self) -> str:
        return Hex.encode(self.finalize())

    # Wipe and release the state.
    pub def free(self):
        _tr_c_secure_zero(self.mem, 40 * 8 + 128)
        _tr_c_free(self.mem)

# ─── BLAKE2s incremental hasher ──────────────────────────────────────────────

pub class Blake2sHasher:
    mem:     Pointer[char]     # h[8] v[16] m[16] (u32) then the 64-byte buffer
    h:       Pointer[u32]
    v:       Pointer[u32]
    m:       Pointer[u32]
    buf:     Pointer[char]
    buflen:  int
    t:       u64
    outlen:  int
    done:    bool
    ok:      bool

extend Blake2sHasher:
    pub def init(outlen: int, key: str) -> Blake2sHasher:
        return Blake2sHasher.init_full(outlen, key, "", "")

    # `salt` and `person` must each be "" or exactly 8 bytes.
    pub def init_full(outlen: int, key: str, salt: str, person: str) -> Blake2sHasher:
        mut x = Blake2sHasher()
        x.mem = CryptoBytes.zeroed(40 * 4 + 64)
        mut base = x.mem
        x.h = base as Pointer[u32]
        unsafe:
            x.v = base.offset(8 * 4) as Pointer[u32]
            x.m = base.offset(24 * 4) as Pointer[u32]
            x.buf = base.offset(40 * 4)
        x.buflen = 0
        x.t = 0
        x.outlen = outlen
        x.done = false
        x.ok = true
        mut kl = key.len()
        if outlen < 1 or outlen > 32 or kl > 32: x.ok = false
        if salt.len() != 0 and salt.len() != 8: x.ok = false
        if person.len() != 0 and person.len() != 8: x.ok = false
        if not x.ok: return x
        mut i = 0
        while i < 8:
            b2_st32(x.h, i, b2s_iv(i))
            i = i + 1
        b2_st32(x.h, 0, b2_ld32(x.h, 0) ^ ((0x01010000 ^ (kl << 8) ^ outlen) as u32))
        if salt.len() == 8:
            mut sp = salt as Pointer[char]
            b2_st32(x.h, 4, b2_ld32(x.h, 4) ^ b2_le32(sp, 0))
            b2_st32(x.h, 5, b2_ld32(x.h, 5) ^ b2_le32(sp, 4))
        if person.len() == 8:
            mut pp = person as Pointer[char]
            b2_st32(x.h, 6, b2_ld32(x.h, 6) ^ b2_le32(pp, 0))
            b2_st32(x.h, 7, b2_ld32(x.h, 7) ^ b2_le32(pp, 4))
        if kl > 0:
            mut kp = key as Pointer[char]
            i = 0
            while i < kl:
                unsafe:
                    x.buf.offset(i).write(kp.offset(i).read())
                i = i + 1
            x.buflen = 64
        return x

    pub def is_ok(self) -> bool:
        return self.ok

    pub def update_bytes(self, data: str, n: int):
        if not self.ok or self.done: return
        mut p = data as Pointer[char]
        mut i = 0
        while i < n:
            if self.buflen == 64:
                self.t = self.t + (64 as u64)
                blake2s_compress(self.h, self.v, self.m, self.buf, self.t, false)
                self.buflen = 0
            unsafe:
                self.buf.offset(self.buflen).write(p.offset(i).read())
            self.buflen = self.buflen + 1
            i = i + 1

    pub def update(self, data: str):
        self.update_bytes(data, data.len())

    pub def finalize(self) -> str:
        if not self.ok or self.done: return ""
        self.done = true
        self.t = self.t + (self.buflen as u64)
        mut i = self.buflen
        while i < 64:
            unsafe:
                self.buf.offset(i).write('\0')
            i = i + 1
        blake2s_compress(self.h, self.v, self.m, self.buf, self.t, true)
        mut out: Pointer[char] = CryptoBytes.zeroed(self.outlen)
        i = 0
        while i < self.outlen:
            mut w: u32 = b2_ld32(self.h, i >> 2)
            CryptoBytes.put(out, i, ((w >> ((i & 3) * 8)) & (255 as u32)) as int)
            i = i + 1
        return CryptoBytes.wrap(out, self.outlen)

    pub def finalize_hex(self) -> str:
        return Hex.encode(self.finalize())

    pub def free(self):
        _tr_c_secure_zero(self.mem, 40 * 4 + 64)
        _tr_c_free(self.mem)

# ─── one-shot API ────────────────────────────────────────────────────────────

pub class Blake2b:
    _dummy: int

pub class Blake2s:
    _dummy: int

extend Blake2b:
    # BLAKE2b digest of `data` with `outlen` (1..64) bytes. Returns "" if outlen is invalid.
    pub def hash(data: str, outlen: int) -> str:
        mut h = Blake2bHasher.init(outlen, "")
        h.update(data)
        mut out = h.finalize()
        h.free()
        return out

    pub def hash_hex(data: str, outlen: int) -> str:
        return Hex.encode(Blake2b.hash(data, outlen))

    # Keyed BLAKE2b (MAC mode): key 1..64 bytes. Returns "" on invalid parameters.
    pub def keyed(data: str, key: str, outlen: int) -> str:
        mut h = Blake2bHasher.init(outlen, key)
        h.update(data)
        mut out = h.finalize()
        h.free()
        return out

    pub def keyed_hex(data: str, key: str, outlen: int) -> str:
        return Hex.encode(Blake2b.keyed(data, key, outlen))

    # Fully parameterised: key ("" or <= 64 bytes), salt/person ("" or exactly 16 bytes).
    pub def hash_params(data: str, outlen: int, key: str, salt: str, person: str) -> str:
        mut h = Blake2bHasher.init_full(outlen, key, salt, person)
        h.update(data)
        mut out = h.finalize()
        h.free()
        return out

extend Blake2s:
    pub def hash(data: str, outlen: int) -> str:
        mut h = Blake2sHasher.init(outlen, "")
        h.update(data)
        mut out = h.finalize()
        h.free()
        return out

    pub def hash_hex(data: str, outlen: int) -> str:
        return Hex.encode(Blake2s.hash(data, outlen))

    pub def keyed(data: str, key: str, outlen: int) -> str:
        mut h = Blake2sHasher.init(outlen, key)
        h.update(data)
        mut out = h.finalize()
        h.free()
        return out

    pub def keyed_hex(data: str, key: str, outlen: int) -> str:
        return Hex.encode(Blake2s.keyed(data, key, outlen))

    # salt/person: "" or exactly 8 bytes.
    pub def hash_params(data: str, outlen: int, key: str, salt: str, person: str) -> str:
        mut h = Blake2sHasher.init_full(outlen, key, salt, person)
        h.update(data)
        mut out = h.finalize()
        h.free()
        return out
