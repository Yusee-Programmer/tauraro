# std.crypto.blake3 — BLAKE3 (hash, keyed hash, key derivation, extendable output),
# pure Tauraro.
#
#   Blake3.hash(data, n)                 default mode; n output bytes (32 is standard)
#   Blake3.keyed_hash(key, data, n)      MAC / PRF mode, key is exactly 32 bytes
#   Blake3.derive_key(context, material, n)   KDF mode (context is a hard-coded,
#                                        globally unique, application-specific string)
#   Blake3Hasher                         incremental: update / finalize(n) / free
#
# The output is an extendable-output function: the first 32 bytes of `hash(data, 64)`
# equal `hash(data, 32)`.
#
# Implementation notes: the full tree mode (1024-byte chunks, chaining-value stack,
# parent nodes) is implemented as in the reference implementation, sequentially (no
# SIMD / multithreading), so it is a correct but not a fast BLAKE3 (about 40-60 MB/s).
#
# Verified: the official BLAKE3 test vectors we could reproduce (empty input,
# 1/3/1023/1024/1025-byte inputs of the repeating 0..250 pattern, keyed and
# derive_key at length 0 and 3) plus a spec-derived Python model for inputs spanning
# 1..102400 bytes (several chunk-tree shapes), keyed, derive_key and long outputs —
# see tests/lang/112_blake3.tr. No copy of the official test_vectors.json was available
# offline, so the multi-megabyte vector set was not run.
#
# Binary convention: inputs are a `str` (true length used); outputs are RAW bytes in
# a `str` (Hex.encode to print) or lowercase hex via the `_hex` helpers. Invalid
# parameters (key length != 32, n < 0) return "".
#
# Usage:
#   from std.crypto.blake3 import Blake3, Blake3Hasher
#   print(Blake3.hash_hex("abc", 32))
#   mut mac = Blake3.keyed_hash(key32, "message", 32)
#   mut k = Blake3.derive_key("myapp 2026-10-11 session keys", secret, 32)
#
#   mut h = Blake3Hasher.new()            # or new_keyed(key) / new_derive_key(context)
#   h.update("part 1")
#   h.update("part 2")
#   mut digest = h.finalize(32)           # can be called repeatedly with any length
#   h.free()

from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

extern "C":
    def _tr_c_free(ptr: Pointer[char])
    def _tr_c_secure_zero(ptr: Pointer[char], n: int)

def b3_iv(i: int) -> u32:
    if i == 0: return 0x6a09e667 as u32
    if i == 1: return 0xbb67ae85 as u32
    if i == 2: return 0x3c6ef372 as u32
    if i == 3: return 0xa54ff53a as u32
    if i == 4: return 0x510e527f as u32
    if i == 5: return 0x9b05688c as u32
    if i == 6: return 0x1f83d9ab as u32
    return 0x5be0cd19 as u32

# message word permutation applied between rounds: m'[i] = m[PERM[i]]
def b3_perm(i: int) -> int:
    mut tbl = "263a704d1bc59ef8"
    mut p = tbl as Pointer[char]
    mut c = 0
    unsafe:
        c = p.offset(i).read() as int
    if c >= 97: return c - 87
    return c - 48

def b3_ld(p: Pointer[u32], i: int) -> u32:
    unsafe:
        return p.offset(i).read()

def b3_st(p: Pointer[u32], i: int, v: u32):
    unsafe:
        p.offset(i).write(v)

def b3_rotr(x: u32, n: int) -> u32:
    return (x >> n) | (x << (32 - n))

def b3_g(v: Pointer[u32], a: int, b: int, c: int, d: int, x: u32, y: u32):
    mut va: u32 = b3_ld(v, a)
    mut vb: u32 = b3_ld(v, b)
    mut vc: u32 = b3_ld(v, c)
    mut vd: u32 = b3_ld(v, d)
    va = va + vb + x
    vd = b3_rotr(vd ^ va, 16)
    vc = vc + vd
    vb = b3_rotr(vb ^ vc, 12)
    va = va + vb + y
    vd = b3_rotr(vd ^ va, 8)
    vc = vc + vd
    vb = b3_rotr(vb ^ vc, 7)
    b3_st(v, a, va)
    b3_st(v, b, vb)
    b3_st(v, c, vc)
    b3_st(v, d, vd)

def b3_round(v: Pointer[u32], m: Pointer[u32]):
    b3_g(v, 0, 4, 8, 12, b3_ld(m, 0), b3_ld(m, 1))
    b3_g(v, 1, 5, 9, 13, b3_ld(m, 2), b3_ld(m, 3))
    b3_g(v, 2, 6, 10, 14, b3_ld(m, 4), b3_ld(m, 5))
    b3_g(v, 3, 7, 11, 15, b3_ld(m, 6), b3_ld(m, 7))
    b3_g(v, 0, 5, 10, 15, b3_ld(m, 8), b3_ld(m, 9))
    b3_g(v, 1, 6, 11, 12, b3_ld(m, 10), b3_ld(m, 11))
    b3_g(v, 2, 7, 8, 13, b3_ld(m, 12), b3_ld(m, 13))
    b3_g(v, 3, 4, 9, 14, b3_ld(m, 14), b3_ld(m, 15))

# The compression function. cv: 8 words, m: 16 message words (DESTROYED: permuted in
# place), v: 16 words of scratch that receive the 16 output words (words 0..7 are the
# new chaining value, words 8..15 the extra XOF words).
def b3_compress(cv: Pointer[u32], m: Pointer[u32], tmp: Pointer[u32], counter: u64, block_len: int, flags: int, v: Pointer[u32]):
    mut i = 0
    while i < 8:
        b3_st(v, i, b3_ld(cv, i))
        b3_st(v, i + 8, b3_iv(i) if i < 4 else (0 as u32))
        i = i + 1
    b3_st(v, 12, (counter & (4294967295 as u64)) as u32)
    b3_st(v, 13, (counter >> 32) as u32)
    b3_st(v, 14, block_len as u32)
    b3_st(v, 15, flags as u32)
    mut r = 0
    while r < 7:
        b3_round(v, m)
        if r < 6:
            i = 0
            while i < 16:
                b3_st(tmp, i, b3_ld(m, b3_perm(i)))
                i = i + 1
            i = 0
            while i < 16:
                b3_st(m, i, b3_ld(tmp, i))
                i = i + 1
        r = r + 1
    i = 0
    while i < 8:
        b3_st(v, i, b3_ld(v, i) ^ b3_ld(v, i + 8))
        b3_st(v, i + 8, b3_ld(v, i + 8) ^ b3_ld(cv, i))
        i = i + 1

def b3_le32(p: Pointer[char], off: int) -> u32:
    mut r: u32 = 0
    mut k = 0
    while k < 4:
        mut b = 0
        unsafe:
            b = (p.offset(off + k).read() as int) & 255
        r = r | ((b as u32) << (8 * k))
        k = k + 1
    return r

# word offsets inside the single state allocation (u32 words)
#   key[0..8) cv[8..16) stack[16..448) v[448..464) m[464..480) tmp[480..496) w[496..512)
#   then the 64-byte block buffer at byte offset 2048
# `w` holds scratch words (parent block assembly / output block).

pub class Blake3Hasher:
    mem:       Pointer[char]
    w:         Pointer[u32]       # = mem as u32 words
    buf:       Pointer[char]
    buf_len:   int
    blocks:    int                # blocks of the current chunk already compressed
    chunk_ctr: u64
    stack_len: int
    flags:     int                # KEYED_HASH / DERIVE_KEY_MATERIAL (base flags)
    ok:        bool

def b3_new(key_words_src: Pointer[u32], flags: int) -> Blake3Hasher:
    mut h = Blake3Hasher()
    h.mem = CryptoBytes.zeroed(2048 + 64)
    h.w = h.mem as Pointer[u32]
    unsafe:
        h.buf = h.mem.offset(2048)
    mut i = 0
    while i < 8:
        b3_st(h.w, i, b3_ld(key_words_src, i))
        b3_st(h.w, 8 + i, b3_ld(key_words_src, i))
        i = i + 1
    h.buf_len = 0
    h.blocks = 0
    h.chunk_ctr = 0
    h.stack_len = 0
    h.flags = flags
    h.ok = true
    return h

def b3_wp(h: Blake3Hasher, off: int) -> Pointer[u32]:
    unsafe:
        return h.w.offset(off)

extend Blake3Hasher:
    # Default hashing mode.
    pub def new() -> Blake3Hasher:
        mut iv: Pointer[char] = CryptoBytes.zeroed(32)
        mut ivw = iv as Pointer[u32]
        mut i = 0
        while i < 8:
            b3_st(ivw, i, b3_iv(i))
            i = i + 1
        mut h = b3_new(ivw, 0)
        CryptoBytes.release(iv)
        return h

    # Keyed mode; `key` must be exactly 32 bytes (otherwise `is_ok()` is false and all
    # operations are no-ops returning "").
    pub def new_keyed(key: str) -> Blake3Hasher:
        mut kb: Pointer[char] = CryptoBytes.zeroed(32)
        mut kw = kb as Pointer[u32]
        mut okk = key.len() == 32
        if okk:
            mut kp = key as Pointer[char]
            mut i = 0
            while i < 8:
                b3_st(kw, i, b3_le32(kp, i * 4))
                i = i + 1
        mut h = b3_new(kw, 16)
        h.ok = okk
        CryptoBytes.release(kb)
        return h

    # Key-derivation mode: `context` is an application-specific, hard-coded string.
    # Feed the key material with update() and read the derived key with finalize(n).
    pub def new_derive_key(context: str) -> Blake3Hasher:
        mut iv: Pointer[char] = CryptoBytes.zeroed(32)
        mut ivw = iv as Pointer[u32]
        mut i = 0
        while i < 8:
            b3_st(ivw, i, b3_iv(i))
            i = i + 1
        mut ch = b3_new(ivw, 32)
        CryptoBytes.release(iv)
        ch.update(context)
        mut ck = ch.finalize(32)
        ch.free()
        mut kw: Pointer[char] = CryptoBytes.zeroed(32)
        mut kwp = kw as Pointer[u32]
        mut ckp = ck as Pointer[char]
        i = 0
        while i < 8:
            b3_st(kwp, i, b3_le32(ckp, i * 4))
            i = i + 1
        mut h = b3_new(kwp, 64)
        _tr_c_secure_zero(kw, 32)
        CryptoBytes.release(kw)
        return h

    pub def is_ok(self) -> bool:
        return self.ok

    # base-flags | CHUNK_START when this is the first block of the chunk
    def block_flags(self) -> int:
        if self.blocks == 0: return self.flags | 1
        return self.flags

    # load the 64-byte buffer (zero padded after buf_len) into the message words
    def load_buf(self, m: Pointer[u32]):
        mut i = self.buf_len
        while i < 64:
            unsafe:
                self.buf.offset(i).write('\0')
            i = i + 1
        mut k = 0
        while k < 16:
            b3_st(m, k, b3_le32(self.buf, k * 4))
            k = k + 1

    # Merge a finished chunk's chaining value `cv` (8 words at off 448..) into the tree.
    def push_cv(self, cv: Pointer[u32], total_chunks: int):
        mut total = total_chunks
        mut v = b3_wp(self, 448)
        mut m = b3_wp(self, 464)
        mut tmp = b3_wp(self, 480)
        mut key = b3_wp(self, 0)
        mut cur = b3_wp(self, 496)           # holds the CV being merged (8 words, then spare)
        mut i = 0
        while i < 8:
            b3_st(cur, i, b3_ld(cv, i))
            i = i + 1
        while total % 2 == 0:
            # parent block = stack top (left) || cur (right)
            self.stack_len = self.stack_len - 1
            mut top = b3_wp(self, 16 + self.stack_len * 8)
            i = 0
            while i < 8:
                b3_st(m, i, b3_ld(top, i))
                b3_st(m, 8 + i, b3_ld(cur, i))
                i = i + 1
            b3_compress(key, m, tmp, 0 as u64, 64, self.flags | 4, v)
            i = 0
            while i < 8:
                b3_st(cur, i, b3_ld(v, i))
                i = i + 1
            total = total / 2
        mut slot = b3_wp(self, 16 + self.stack_len * 8)
        i = 0
        while i < 8:
            b3_st(slot, i, b3_ld(cur, i))
            i = i + 1
        self.stack_len = self.stack_len + 1

    pub def update_bytes(self, data: str, n: int):
        if not self.ok: return
        mut p = data as Pointer[char]
        mut v = b3_wp(self, 448)
        mut m = b3_wp(self, 464)
        mut tmp = b3_wp(self, 480)
        mut cv = b3_wp(self, 8)
        mut i = 0
        while i < n:
            if self.blocks * 64 + self.buf_len == 1024:
                # chunk complete and more input follows: finish it (CHUNK_END) and merge
                self.load_buf(m)
                b3_compress(cv, m, tmp, self.chunk_ctr, self.buf_len, self.block_flags() | 2, v)
                self.push_cv(v, (self.chunk_ctr as int) + 1)
                self.chunk_ctr = self.chunk_ctr + (1 as u64)
                mut j = 0
                while j < 8:
                    b3_st(cv, j, b3_ld(b3_wp(self, 0), j))
                    j = j + 1
                self.blocks = 0
                self.buf_len = 0
            if self.buf_len == 64:
                self.load_buf(m)
                b3_compress(cv, m, tmp, self.chunk_ctr, 64, self.block_flags(), v)
                mut j2 = 0
                while j2 < 8:
                    b3_st(cv, j2, b3_ld(v, j2))
                    j2 = j2 + 1
                self.blocks = self.blocks + 1
                self.buf_len = 0
            unsafe:
                self.buf.offset(self.buf_len).write(p.offset(i).read())
            self.buf_len = self.buf_len + 1
            i = i + 1

    pub def update(self, data: str):
        self.update_bytes(data, data.len())

    # Read `n` output bytes (the XOF). May be called repeatedly (each call starts at
    # offset 0 — it does not advance) and does not consume the hasher: more `update`s
    # after a `finalize` are fine.
    pub def finalize(self, n: int) -> str:
        if not self.ok or n < 0: return ""
        mut v = b3_wp(self, 448)
        mut m = b3_wp(self, 464)
        mut tmp = b3_wp(self, 480)
        mut key = b3_wp(self, 0)
        mut cvc = b3_wp(self, 8)
        # the current chunk's last block is the first "output node": keep its input
        # parameters (cv, block words, counter, block_len, flags) in locals / scratch
        # slots: onode_cv (8) at 496.., onode_m copied at a separate temp allocation.
        mut node_m: Pointer[char] = CryptoBytes.zeroed(64 + 32 + 8)
        mut nm = node_m as Pointer[u32]
        mut node_cv = b3_wp(self, 496)
        self.load_buf(nm)
        mut i = 0
        while i < 8:
            b3_st(node_cv, i, b3_ld(cvc, i))
            i = i + 1
        mut counter: u64 = self.chunk_ctr
        mut blen = self.buf_len
        mut fl = self.block_flags() | 2
        # walk the stack: parent(stack[k], chaining_value(node)) from the top down
        mut k = self.stack_len
        while k > 0:
            k = k - 1
            # chaining value of the current node -> right child
            i = 0
            while i < 16:
                b3_st(m, i, b3_ld(nm, i))
                i = i + 1
            b3_compress(node_cv, m, tmp, counter, blen, fl, v)
            # new node = parent(left = stack[k], right = v[0..8])
            mut left = b3_wp(self, 16 + k * 8)
            i = 0
            while i < 8:
                b3_st(nm, i, b3_ld(left, i))
                b3_st(nm, 8 + i, b3_ld(v, i))
                i = i + 1
            i = 0
            while i < 8:
                b3_st(node_cv, i, b3_ld(key, i))
                i = i + 1
            counter = 0 as u64
            blen = 64
            fl = self.flags | 4
        # root output
        mut out: Pointer[char] = CryptoBytes.zeroed(n)
        mut pos = 0
        mut t: u64 = 0
        while pos < n:
            i = 0
            while i < 16:
                b3_st(m, i, b3_ld(nm, i))
                i = i + 1
            b3_compress(node_cv, m, tmp, t, blen, fl | 8, v)
            mut j = 0
            while j < 64 and pos + j < n:
                mut wv: u32 = b3_ld(v, j >> 2)
                CryptoBytes.put(out, pos + j, ((wv >> ((j & 3) * 8)) & (255 as u32)) as int)
                j = j + 1
            pos = pos + 64
            t = t + (1 as u64)
        _tr_c_secure_zero(node_m, 64 + 32 + 8)
        CryptoBytes.release(node_m)
        return CryptoBytes.wrap(out, n)

    pub def finalize_hex(self, n: int) -> str:
        return Hex.encode(self.finalize(n))

    # Wipe and release the state.
    pub def free(self):
        _tr_c_secure_zero(self.mem, 2048 + 64)
        _tr_c_free(self.mem)

# ─── one-shot API ────────────────────────────────────────────────────────────

pub class Blake3:
    _dummy: int

extend Blake3:
    # BLAKE3 hash of `data`, `n` output bytes (32 is the standard length).
    pub def hash(data: str, n: int) -> str:
        mut h = Blake3Hasher.new()
        h.update(data)
        mut out = h.finalize(n)
        h.free()
        return out

    pub def hash_hex(data: str, n: int) -> str:
        return Hex.encode(Blake3.hash(data, n))

    # Keyed hash (MAC / PRF); `key` must be exactly 32 bytes, else "".
    pub def keyed_hash(key: str, data: str, n: int) -> str:
        mut h = Blake3Hasher.new_keyed(key)
        if not h.is_ok():
            h.free()
            return ""
        h.update(data)
        mut out = h.finalize(n)
        h.free()
        return out

    pub def keyed_hash_hex(key: str, data: str, n: int) -> str:
        return Hex.encode(Blake3.keyed_hash(key, data, n))

    # Derive `n` key bytes from `material` under a hard-coded application `context`.
    pub def derive_key(context: str, material: str, n: int) -> str:
        mut h = Blake3Hasher.new_derive_key(context)
        h.update(material)
        mut out = h.finalize(n)
        h.free()
        return out

    pub def derive_key_hex(context: str, material: str, n: int) -> str:
        return Hex.encode(Blake3.derive_key(context, material, n))
