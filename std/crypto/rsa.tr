# std.crypto.rsa — RSA (RFC 8017): PKCS#1 v1.5 and RSASSA-PSS signatures,
# RSAES-OAEP encryption, key parsing/serialization (PKCS#1, PKCS#8, SPKI, PEM).
#
# Pure Tauraro on top of std.crypto.bn (28-bit limbs + Montgomery modexp with a
# 4-bit window) and std.crypto.pkutil (digests), std.encoding.asn1 / pem.
# Interoperates with OpenSSL: tests/lang/122_rsa.tr verifies OpenSSL-made
# PKCS#1 / PSS signatures, decrypts OpenSSL OAEP ciphertexts, and the
# signatures made here were cross-checked with `openssl dgst -verify` /
# `openssl pkeyutl -verify`.
#
# Hashes: "sha1" (legacy certificates only), "sha256", "sha384", "sha512".
# All data are byte buffers (`Vec[int]`, 0..255 — see pkutil `Bytes`).
#
# KEYS
#   Rsa.public_from_pem(text) / public_from_der(der)    SPKI ("PUBLIC KEY") or
#                                                       PKCS#1 ("RSA PUBLIC KEY")
#   Rsa.private_from_pem(text) / private_from_der(der)  PKCS#1 ("RSA PRIVATE KEY")
#                                                       or PKCS#8 ("PRIVATE KEY")
#   priv.public_key(); Rsa.public_to_der / public_to_pem (SPKI);
#   Rsa.private_to_der / private_to_pem (PKCS#1)
#   Keys must be at least 512 bits; use >= 2048 for anything real. Key GENERATION
#   is not provided (create keys with `openssl genrsa` / your own tooling).
#
# SIGNATURES (sign_* raise a `str` on failure, verify_* return bool and never
# raise: any malformed input is simply "false")
#   Rsa.verify_pkcs1(pub, alg, msg, sig)       Rsa.sign_pkcs1(priv, alg, msg)
#   Rsa.verify_pkcs1_digest(pub, alg, digest, sig)   (prehashed)
#   Rsa.verify_pss(pub, alg, msg, sig, salt_len)     salt_len < 0 accepts any salt length
#   Rsa.sign_pss(priv, alg, msg, salt_len)           random salt from the OS CSPRNG
#   Rsa.sign_pss_with_salt(priv, alg, msg, salt)     caller-chosen salt (tests)
#   (PSS uses MGF1 with the same hash as the message digest, the usual profile.)
#
# ENCRYPTION (RSAES-OAEP only; PKCS#1 v1.5 encryption is intentionally absent)
#   Rsa.oaep_encrypt(pub, alg, msg, label)  / oaep_encrypt_with_seed(...)
#   Rsa.oaep_decrypt(priv, alg, ct, label)  -> all failures give one message
#
# LIMITATIONS (be honest): arithmetic is variable-time (no constant-time
# modexp), there is no RSA blinding, so private-key operations on a machine
# where an attacker can measure timing or cache behaviour are NOT hardened.
# CRT results are re-verified with the public key (guards against fault
# attacks). Signature verification only handles public data and is safe.
#
# Usage:
#   from std.crypto.rsa import Rsa, RsaPublicKey, RsaPrivateKey
#   from std.crypto.pkutil import Bytes
#   mut pub = Rsa.public_from_pem(pem_text)?
#   mut ok = Rsa.verify_pkcs1(pub, "sha256", Bytes.from_str("hello"), sig_bytes)

from std.core.vec import Vec
from std.crypto.pkutil import Bytes, PkHash
from std.crypto.bn import bn_from_bytes, bn_to_bytes, bn_byte_len, bn_bit_len, bn_cmp, bn_modexp, bn_mod, bn_mul, bn_add, bn_sub, bn_is_zero, bn_is_odd, bn_from_int, bn_eq, bn_divmod, Mont
from std.encoding.asn1 import Der, DerNode, DerReader, Oid
from std.encoding.pem import Pem, PemBlock

pub class RsaPublicKey:
    pub n:      Vec[int]     # modulus (bn limbs)
    pub e:      Vec[int]     # public exponent
    pub nbytes: int          # modulus length in bytes
    pub bits:   int          # modulus length in bits

pub class RsaPrivateKey:
    pub n:       Vec[int]
    pub e:       Vec[int]
    pub d:       Vec[int]
    pub p:       Vec[int]
    pub q:       Vec[int]
    pub dp:      Vec[int]    # d mod (p-1)
    pub dq:      Vec[int]    # d mod (q-1)
    pub qinv:    Vec[int]    # q^-1 mod p
    pub has_crt: bool
    pub nbytes:  int
    pub bits:    int

pub class Rsa:
    _dummy: int

def _rsa_xor_into(dst: Vec[int], src: Vec[int]):
    mut i = 0
    while i < dst.len:
        dst.set(i, dst.get(i) ^ src.get(i))
        i = i + 1

# MGF1 (RFC 8017 B.2.1)
def _rsa_mgf1(alg: str, seed: Vec[int], mask_len: int) -> Vec[int]:
    mut out = Vec[int].init(mask_len + 64)
    mut counter = 0
    while out.len < mask_len:
        mut c = Bytes.clone(seed)
        c.push((counter >> 24) & 255)
        c.push((counter >> 16) & 255)
        c.push((counter >> 8) & 255)
        c.push(counter & 255)
        Bytes.append(out, PkHash.digest(alg, c))
        counter = counter + 1
    out.len = mask_len
    return out

# DER DigestInfo ::= SEQUENCE { AlgorithmIdentifier, OCTET STRING }
def _rsa_digest_info(alg: str, digest: Vec[int]) throws str -> Vec[int]:
    mut oid = ""
    if alg == "sha1": oid = Oid.SHA1()
    elif alg == "sha256": oid = Oid.SHA256()
    elif alg == "sha384": oid = Oid.SHA384()
    elif alg == "sha512": oid = Oid.SHA512()
    else: raise(f"rsa: unsupported hash '{alg}'")
    mut algid = Bytes.concat(Der.oid(oid), Der.null())
    mut content = Bytes.concat(Der.sequence(algid), Der.octet_string(digest))
    return Der.sequence(content)

# EMSA-PKCS1-v1_5 (RFC 8017 9.2)
def _rsa_emsa_pkcs1(alg: str, digest: Vec[int], em_len: int) throws str -> Vec[int]:
    mut t = _rsa_digest_info(alg, digest)?
    if em_len < t.len + 11: raise("rsa: key too short for this hash")
    mut em = Vec[int].init(em_len + 1)
    em.push(0)
    em.push(1)
    mut i = 0
    while i < em_len - t.len - 3:
        em.push(255)
        i = i + 1
    em.push(0)
    Bytes.append(em, t)
    return em

extend RsaPublicKey:
    pub def size_bytes(self) -> int:
        return self.nbytes

    # m^e mod n (RSAEP / RSAVP1). Caller guarantees m < n.
    pub def raw_public(self, m: Vec[int]) -> Vec[int]:
        return bn_modexp(m, self.e, self.n)

extend RsaPrivateKey:
    pub def size_bytes(self) -> int:
        return self.nbytes

    pub def public_key(self) -> RsaPublicKey:
        return Rsa._make_public(self.n, self.e)

    # c^d mod n (RSADP / RSASP1) using the CRT when p, q, dp, dq, qinv are
    # present; the result is re-checked with the public exponent.
    pub def raw_private(self, c: Vec[int]) throws str -> Vec[int]:
        if bn_cmp(c, self.n) >= 0: raise("rsa: input out of range")
        mut m = bn_zero_()
        if self.has_crt:
            mut m1 = bn_modexp(bn_mod(c, self.p), self.dp, self.p)
            mut m2 = bn_modexp(bn_mod(c, self.q), self.dq, self.q)
            mut m2p = bn_mod(m2, self.p)
            mut diff = bn_zero_()
            if bn_cmp(m1, m2p) >= 0:
                diff = bn_sub(m1, m2p)
            else:
                diff = bn_sub(bn_add(m1, self.p), m2p)
            mut h = bn_mod(bn_mul(self.qinv, diff), self.p)
            m = bn_add(m2, bn_mul(h, self.q))
        else:
            m = bn_modexp(c, self.d, self.n)
        mut chk = bn_modexp(m, self.e, self.n)
        if bn_cmp(chk, c) != 0: raise("rsa: private operation self-check failed")
        return m

def bn_zero_() -> Vec[int]:
    return Vec[int].init(4)

extend Rsa:
    # ── key construction / parsing ──

    pub def _make_public(n: Vec[int], e: Vec[int]) -> RsaPublicKey:
        mut k = RsaPublicKey()
        k.n = Bytes.clone(n)
        k.e = Bytes.clone(e)
        k.bits = bn_bit_len(n)
        k.nbytes = (k.bits + 7) / 8
        return k

    def _check_public(n: Vec[int], e: Vec[int]) throws str:
        if bn_bit_len(n) < 512: raise("rsa: modulus shorter than 512 bits")
        if not bn_is_odd(n): raise("rsa: modulus is even")
        if bn_bit_len(e) < 2 or not bn_is_odd(e): raise("rsa: invalid public exponent")
        if bn_bit_len(e) > bn_bit_len(n): raise("rsa: public exponent larger than modulus")

    # RSAPublicKey ::= SEQUENCE { modulus INTEGER, publicExponent INTEGER }
    def _public_from_pkcs1(node: DerNode) throws str -> RsaPublicKey:
        mut r = node.reader()
        mut n = r.next()?.as_bn()?
        mut e = r.next()?.as_bn()?
        if r.more(): raise("rsa: trailing data in RSAPublicKey")
        Rsa._check_public(n, e)?
        return Rsa._make_public(n, e)

    # SubjectPublicKeyInfo or PKCS#1 RSAPublicKey DER.
    pub def public_from_der(der: Vec[int]) throws str -> RsaPublicKey:
        mut top = Der.parse(der)?
        if top.tag != 48: raise("rsa: public key is not a SEQUENCE")
        mut r = top.reader()
        mut first = r.next()?
        if first.tag == 2:
            return Rsa._public_from_pkcs1(top)?
        if first.tag != 48: raise("rsa: unrecognized public key structure")
        # SPKI
        mut ar = first.reader()
        mut oid = ar.next()?
        if not oid.is_oid(Oid.RSA_ENCRYPTION()): raise("rsa: SPKI algorithm is not rsaEncryption")
        mut bits = r.next()?
        if r.more(): raise("rsa: trailing data in SPKI")
        mut inner = bits.as_bit_string()?
        if bits.bit_unused() != 0: raise("rsa: unexpected unused bits in SPKI key")
        mut node = Der.parse(inner)?
        return Rsa._public_from_pkcs1(node)?

    pub def public_from_pem(text: str) throws str -> RsaPublicKey:
        mut blocks = Pem.decode_all(text)
        mut i = 0
        while i < blocks.len:
            mut lb = blocks.get(i).label
            if lb == "PUBLIC KEY" or lb == "RSA PUBLIC KEY":
                return Rsa.public_from_der(blocks.get(i).data)?
            i = i + 1
        raise("rsa: no PUBLIC KEY / RSA PUBLIC KEY block")

    def _private_from_pkcs1(node: DerNode) throws str -> RsaPrivateKey:
        mut r = node.reader()
        mut ver = r.next()?.as_int()?
        if ver != 0: raise("rsa: unsupported RSAPrivateKey version (multi-prime?)")
        mut k = RsaPrivateKey()
        k.n = r.next()?.as_bn()?
        k.e = r.next()?.as_bn()?
        k.d = r.next()?.as_bn()?
        k.p = r.next()?.as_bn()?
        k.q = r.next()?.as_bn()?
        k.dp = r.next()?.as_bn()?
        k.dq = r.next()?.as_bn()?
        k.qinv = r.next()?.as_bn()?
        if r.more(): raise("rsa: trailing data in RSAPrivateKey")
        Rsa._check_public(k.n, k.e)?
        k.bits = bn_bit_len(k.n)
        k.nbytes = (k.bits + 7) / 8
        k.has_crt = false
        if not bn_is_zero(k.p) and not bn_is_zero(k.q) and bn_is_odd(k.p) and bn_is_odd(k.q):
            if bn_eq(bn_mul(k.p, k.q), k.n):
                k.has_crt = true
        return k

    # PKCS#1 RSAPrivateKey or PKCS#8 PrivateKeyInfo DER.
    pub def private_from_der(der: Vec[int]) throws str -> RsaPrivateKey:
        mut top = Der.parse(der)?
        if top.tag != 48: raise("rsa: private key is not a SEQUENCE")
        mut r = top.reader()
        mut ver = r.next()?
        if ver.tag != 2: raise("rsa: bad private key version")
        mut second_tag = r.peek_tag()
        if second_tag == 2:
            return Rsa._private_from_pkcs1(top)?
        if second_tag != 48: raise("rsa: unrecognized private key structure")
        mut algid = r.next()?
        mut ar = algid.reader()
        mut oid = ar.next()?
        if not oid.is_oid(Oid.RSA_ENCRYPTION()): raise("rsa: PKCS#8 algorithm is not rsaEncryption")
        mut octets = r.next()?.as_octets()?
        mut inner = Der.parse(octets)?
        if inner.tag != 48: raise("rsa: bad PKCS#8 payload")
        return Rsa._private_from_pkcs1(inner)?

    pub def private_from_pem(text: str) throws str -> RsaPrivateKey:
        mut blocks = Pem.decode_all(text)
        mut i = 0
        while i < blocks.len:
            mut lb = blocks.get(i).label
            if lb == "RSA PRIVATE KEY" or lb == "PRIVATE KEY":
                return Rsa.private_from_der(blocks.get(i).data)?
            i = i + 1
        raise("rsa: no RSA PRIVATE KEY / PRIVATE KEY block (encrypted keys are not supported)")

    # ── key serialization ──

    pub def public_to_pkcs1_der(k: RsaPublicKey) -> Vec[int]:
        return Der.sequence(Bytes.concat(Der.integer_bn(k.n), Der.integer_bn(k.e)))

    pub def public_to_der(k: RsaPublicKey) -> Vec[int]:
        mut algid = Der.sequence(Bytes.concat(Der.oid(Oid.RSA_ENCRYPTION()), Der.null()))
        mut body = Bytes.concat(algid, Der.bit_string(Rsa.public_to_pkcs1_der(k), 0))
        return Der.sequence(body)

    pub def public_to_pem(k: RsaPublicKey) -> str:
        return Pem.encode("PUBLIC KEY", Rsa.public_to_der(k))

    pub def private_to_der(k: RsaPrivateKey) -> Vec[int]:
        mut c = Der.integer_int(0)
        Bytes.append(c, Der.integer_bn(k.n))
        Bytes.append(c, Der.integer_bn(k.e))
        Bytes.append(c, Der.integer_bn(k.d))
        Bytes.append(c, Der.integer_bn(k.p))
        Bytes.append(c, Der.integer_bn(k.q))
        Bytes.append(c, Der.integer_bn(k.dp))
        Bytes.append(c, Der.integer_bn(k.dq))
        Bytes.append(c, Der.integer_bn(k.qinv))
        return Der.sequence(c)

    pub def private_to_pem(k: RsaPrivateKey) -> str:
        return Pem.encode("RSA PRIVATE KEY", Rsa.private_to_der(k))

    # ── PKCS#1 v1.5 signatures ──

    pub def sign_pkcs1_digest(k: RsaPrivateKey, alg: str, digest: Vec[int]) throws str -> Vec[int]:
        if digest.len != PkHash.out_len(alg): raise("rsa: digest length does not match hash")
        mut em = _rsa_emsa_pkcs1(alg, digest, k.nbytes)?
        mut s = k.raw_private(bn_from_bytes(em))?
        return bn_to_bytes(s, k.nbytes)

    pub def sign_pkcs1(k: RsaPrivateKey, alg: str, msg: Vec[int]) throws str -> Vec[int]:
        if not PkHash.supported(alg): raise(f"rsa: unsupported hash '{alg}'")
        return Rsa.sign_pkcs1_digest(k, alg, PkHash.digest(alg, msg))?

    pub def verify_pkcs1_digest(k: RsaPublicKey, alg: str, digest: Vec[int], sig: Vec[int]) -> bool:
        if sig.len != k.nbytes: return false
        if digest.len != PkHash.out_len(alg) or digest.len == 0: return false
        mut s = bn_from_bytes(sig)
        if bn_cmp(s, k.n) >= 0: return false
        mut r: Result[Vec[int], str] = _rsa_emsa_pkcs1(alg, digest, k.nbytes)
        if r.is_err: return false
        mut m = bn_to_bytes(k.raw_public(s), k.nbytes)
        return Bytes.eq_ct(m, r.ok)

    pub def verify_pkcs1(k: RsaPublicKey, alg: str, msg: Vec[int], sig: Vec[int]) -> bool:
        if not PkHash.supported(alg): return false
        return Rsa.verify_pkcs1_digest(k, alg, PkHash.digest(alg, msg), sig)

    # ── RSASSA-PSS ──

    pub def sign_pss_with_salt(k: RsaPrivateKey, alg: str, msg: Vec[int], salt: Vec[int]) throws str -> Vec[int]:
        if not PkHash.supported(alg): raise(f"rsa: unsupported hash '{alg}'")
        mut h_len = PkHash.out_len(alg)
        mut em_bits = k.bits - 1
        mut em_len = (em_bits + 7) / 8
        if em_len < h_len + salt.len + 2: raise("rsa: key too short for this hash/salt")
        mut m_hash = PkHash.digest(alg, msg)
        mut mp = Bytes.zeros(8)
        Bytes.append(mp, m_hash)
        Bytes.append(mp, salt)
        mut h = PkHash.digest(alg, mp)
        mut db = Bytes.zeros(em_len - salt.len - h_len - 2)
        db.push(1)
        Bytes.append(db, salt)
        mut mask = _rsa_mgf1(alg, h, em_len - h_len - 1)
        _rsa_xor_into(db, mask)
        mut top_clear = 8 * em_len - em_bits
        db.set(0, db.get(0) & (255 >> top_clear))
        mut em = Bytes.clone(db)
        Bytes.append(em, h)
        em.push(188)
        mut s = k.raw_private(bn_from_bytes(em))?
        return bn_to_bytes(s, k.nbytes)

    pub def sign_pss(k: RsaPrivateKey, alg: str, msg: Vec[int], salt_len: int) throws str -> Vec[int]:
        if salt_len < 0: raise("rsa: salt length must be >= 0")
        return Rsa.sign_pss_with_salt(k, alg, msg, Bytes.random(salt_len))?

    # salt_len < 0: accept any salt length; otherwise it must match exactly.
    pub def verify_pss(k: RsaPublicKey, alg: str, msg: Vec[int], sig: Vec[int], salt_len: int) -> bool:
        if not PkHash.supported(alg): return false
        if sig.len != k.nbytes: return false
        mut h_len = PkHash.out_len(alg)
        mut em_bits = k.bits - 1
        mut em_len = (em_bits + 7) / 8
        if em_len < h_len + 2: return false
        mut s = bn_from_bytes(sig)
        if bn_cmp(s, k.n) >= 0: return false
        mut mi = k.raw_public(s)
        if bn_byte_len(mi) > em_len: return false
        mut em = bn_to_bytes(mi, em_len)
        if em.get(em_len - 1) != 188: return false
        mut db = Bytes.slice(em, 0, em_len - h_len - 1)
        mut h = Bytes.slice(em, em_len - h_len - 1, h_len)
        mut top_clear = 8 * em_len - em_bits
        if (db.get(0) & (255 << (8 - top_clear)) & 255) != 0 and top_clear > 0: return false
        mut mask = _rsa_mgf1(alg, h, em_len - h_len - 1)
        _rsa_xor_into(db, mask)
        db.set(0, db.get(0) & (255 >> top_clear))
        mut i = 0
        while i < db.len and db.get(i) == 0:
            i = i + 1
        if i >= db.len: return false
        if db.get(i) != 1: return false
        mut got_salt = db.len - i - 1
        if salt_len >= 0 and got_salt != salt_len: return false
        mut salt = Bytes.slice(db, i + 1, got_salt)
        mut mp = Bytes.zeros(8)
        Bytes.append(mp, PkHash.digest(alg, msg))
        Bytes.append(mp, salt)
        mut h2 = PkHash.digest(alg, mp)
        return Bytes.eq_ct(h, h2)

    # ── RSAES-OAEP ──

    pub def oaep_max_message(k: RsaPublicKey, alg: str) -> int:
        return k.nbytes - 2 * PkHash.out_len(alg) - 2

    pub def oaep_encrypt_with_seed(k: RsaPublicKey, alg: str, msg: Vec[int], label: Vec[int], seed: Vec[int]) throws str -> Vec[int]:
        if not PkHash.supported(alg): raise(f"rsa: unsupported hash '{alg}'")
        mut h_len = PkHash.out_len(alg)
        if seed.len != h_len: raise("rsa: OAEP seed must be one digest long")
        if msg.len > k.nbytes - 2 * h_len - 2: raise("rsa: message too long for OAEP")
        mut db = PkHash.digest(alg, label)
        Bytes.append(db, Bytes.zeros(k.nbytes - msg.len - 2 * h_len - 2))
        db.push(1)
        Bytes.append(db, msg)
        mut db_mask = _rsa_mgf1(alg, seed, k.nbytes - h_len - 1)
        _rsa_xor_into(db, db_mask)
        mut seed_mask = _rsa_mgf1(alg, db, h_len)
        mut mseed = Bytes.clone(seed)
        _rsa_xor_into(mseed, seed_mask)
        mut em = Vec[int].init(k.nbytes + 1)
        em.push(0)
        Bytes.append(em, mseed)
        Bytes.append(em, db)
        mut c = k.raw_public(bn_from_bytes(em))
        return bn_to_bytes(c, k.nbytes)

    pub def oaep_encrypt(k: RsaPublicKey, alg: str, msg: Vec[int], label: Vec[int]) throws str -> Vec[int]:
        if not PkHash.supported(alg): raise(f"rsa: unsupported hash '{alg}'")
        return Rsa.oaep_encrypt_with_seed(k, alg, msg, label, Bytes.random(PkHash.out_len(alg)))?

    pub def oaep_decrypt(k: RsaPrivateKey, alg: str, ct: Vec[int], label: Vec[int]) throws str -> Vec[int]:
        if not PkHash.supported(alg): raise(f"rsa: unsupported hash '{alg}'")
        mut h_len = PkHash.out_len(alg)
        if ct.len != k.nbytes or k.nbytes < 2 * h_len + 2: raise("rsa: decryption error")
        mut c = bn_from_bytes(ct)
        if bn_cmp(c, k.n) >= 0: raise("rsa: decryption error")
        mut mi = k.raw_private(c)?
        mut em = bn_to_bytes(mi, k.nbytes)
        mut bad = em.get(0)
        mut mseed = Bytes.slice(em, 1, h_len)
        mut db = Bytes.slice(em, 1 + h_len, k.nbytes - h_len - 1)
        mut seed_mask = _rsa_mgf1(alg, db, h_len)
        _rsa_xor_into(mseed, seed_mask)
        mut db_mask = _rsa_mgf1(alg, mseed, k.nbytes - h_len - 1)
        _rsa_xor_into(db, db_mask)
        mut lhash = PkHash.digest(alg, label)
        if not Bytes.eq_ct(Bytes.slice(db, 0, h_len), lhash): bad = bad | 1
        mut i = h_len
        while i < db.len and db.get(i) == 0:
            i = i + 1
        if i >= db.len: bad = bad | 1
        elif db.get(i) != 1: bad = bad | 1
        if bad != 0: raise("rsa: decryption error")
        return Bytes.slice(db, i + 1, db.len - i - 1)
