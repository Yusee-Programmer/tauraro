# std.crypto.bn — unsigned arbitrary-precision integers for public-key crypto.
#
# Why this exists next to std.math.bigint: BigInt is a decimal (base 10^9),
# sign-magnitude type whose division is a per-limb binary search; a single
# 2048-bit modular exponentiation with it takes minutes. Public-key code needs
# a binary representation and Montgomery multiplication, so std.crypto.rsa /
# ecdsa / x509 use this module instead. Values are plain `Vec[int]` magnitudes:
#
#   * little-endian limbs of 28 bits (limb 0 = least significant);
#   * normalized: no high zero limbs; zero is the EMPTY vector;
#   * 28 bits (not 32) so limb*limb + two carries stays far below 2^63 and
#     never trips the compiler's signed-overflow trapping.
#
# Free functions (`bn_*`) operate on those vectors and never mutate their
# arguments unless the name says so (`bn_trim`). `Mont` is a Montgomery
# context for one ODD modulus (modexp, modular multiply, modular inverse for
# prime moduli via Fermat, plus the modular add/sub that elliptic-curve code
# needs). ALL of this is variable-time: it must not be used where timing side
# channels matter (see docs/std/crypto.md, "Limitations").
#
# Usage:
#   from std.crypto.bn import bn_from_hex, bn_to_hex, bn_modexp
#   mut r = bn_modexp(bn_from_hex("02"), bn_from_hex("0a"), bn_from_hex("03e9"))

from std.core.vec import Vec
from std.crypto.pkutil import Bytes

const BN_BITS = 28
const BN_BASE = 268435456      # 2^28
const BN_MASK = 268435455      # 2^28 - 1

# ── construction / conversion ───────────────────────────────────────────────

pub def bn_trim(a: Vec[int]):
    while a.len > 0 and a.get(a.len - 1) == 0:
        a.pop()

pub def bn_zero() -> Vec[int]:
    return Vec[int].init(4)

pub def bn_from_int(n: int) -> Vec[int]:
    mut r = Vec[int].init(4)
    mut m = n
    while m > 0:
        r.push(m & BN_MASK)
        m = m >> BN_BITS
    return r

pub def bn_clone(a: Vec[int]) -> Vec[int]:
    mut r = Vec[int].init(a.len + 1)
    mut i = 0
    while i < a.len:
        r.push(a.get(i))
        i = i + 1
    return r

pub def bn_is_zero(a: Vec[int]) -> bool:
    return a.len == 0

pub def bn_is_odd(a: Vec[int]) -> bool:
    if a.len == 0: return false
    return (a.get(0) & 1) == 1

# Big-endian bytes (values 0..255) -> number.
pub def bn_from_bytes(b: Vec[int]) -> Vec[int]:
    mut r = Vec[int].init(b.len * 8 / BN_BITS + 2)
    mut acc = 0
    mut nb = 0
    mut i = b.len - 1
    while i >= 0:
        acc = acc | ((b.get(i) & 255) << nb)
        nb = nb + 8
        if nb >= BN_BITS:
            r.push(acc & BN_MASK)
            acc = acc >> BN_BITS
            nb = nb - BN_BITS
        i = i - 1
    if nb > 0: r.push(acc)
    bn_trim(r)
    return r

# Number -> exactly `n` big-endian bytes (left-padded with zeros; if the value
# is wider than `n` bytes only its low `n` bytes are kept).
pub def bn_to_bytes(a: Vec[int], n: int) -> Vec[int]:
    mut r = Vec[int].init(n + 1)
    mut k = n - 1
    while k >= 0:
        mut off = k * 8
        mut limb = off / BN_BITS
        mut sh = off - limb * BN_BITS
        mut v = 0
        if limb < a.len:
            v = a.get(limb) >> sh
            if sh > BN_BITS - 8 and limb + 1 < a.len:
                v = v | (a.get(limb + 1) << (BN_BITS - sh))
        r.push(v & 255)
        k = k - 1
    return r

# Minimal big-endian byte length (0 for zero).
pub def bn_byte_len(a: Vec[int]) -> int:
    return (bn_bit_len(a) + 7) / 8

pub def bn_bit_len(a: Vec[int]) -> int:
    if a.len == 0: return 0
    mut top = a.get(a.len - 1)
    mut b = 0
    while top > 0:
        b = b + 1
        top = top >> 1
    return (a.len - 1) * BN_BITS + b

pub def bn_get_bit(a: Vec[int], i: int) -> int:
    mut limb = i / BN_BITS
    if limb >= a.len or i < 0: return 0
    return (a.get(limb) >> (i - limb * BN_BITS)) & 1

# Hex text (no 0x prefix; odd digit count allowed) -> number. Bad input -> 0.
pub def bn_from_hex(h: str) -> Vec[int]:
    mut digits = Vec[int].init(h.len() + 1)
    mut p = h as Pointer[char]
    mut i = 0
    while i < h.len():
        mut c = 0
        unsafe:
            c = (p.offset(i).read() as int) & 255
        i = i + 1
        if c == 32 or c == 10 or c == 13 or c == 9: continue
        mut d = -1
        if c >= 48 and c <= 57: d = c - 48
        if c >= 97 and c <= 102: d = c - 87
        if c >= 65 and c <= 70: d = c - 55
        if d < 0: return bn_zero()
        digits.push(d)
    mut r = Vec[int].init(digits.len / 7 + 2)
    mut acc = 0
    mut nb = 0
    mut j = digits.len - 1
    while j >= 0:
        acc = acc | (digits.get(j) << nb)
        nb = nb + 4
        if nb >= BN_BITS:
            r.push(acc & BN_MASK)
            acc = acc >> BN_BITS
            nb = nb - BN_BITS
        j = j - 1
    if nb > 0: r.push(acc)
    bn_trim(r)
    return r

# Lower-case hex of the minimal big-endian bytes (even digit count; "00" for zero).
pub def bn_to_hex(a: Vec[int]) -> str:
    mut n = bn_byte_len(a)
    if n == 0: n = 1
    return Bytes.to_hex(bn_to_bytes(a, n))

# ── comparison / add / sub / mul ────────────────────────────────────────────

# -1 / 0 / 1
pub def bn_cmp(a: Vec[int], b: Vec[int]) -> int:
    if a.len != b.len:
        if a.len < b.len: return -1
        return 1
    mut i = a.len - 1
    while i >= 0:
        mut x = a.get(i)
        mut y = b.get(i)
        if x != y:
            if x < y: return -1
            return 1
        i = i - 1
    return 0

pub def bn_eq(a: Vec[int], b: Vec[int]) -> bool:
    return bn_cmp(a, b) == 0

pub def bn_add(a: Vec[int], b: Vec[int]) -> Vec[int]:
    mut n = a.len
    if b.len > n: n = b.len
    mut r = Vec[int].init(n + 2)
    mut carry = 0
    mut i = 0
    while i < n:
        mut s = carry
        if i < a.len: s = s + a.get(i)
        if i < b.len: s = s + b.get(i)
        r.push(s & BN_MASK)
        carry = s >> BN_BITS
        i = i + 1
    if carry > 0: r.push(carry)
    return r

# a - b, requires a >= b.
pub def bn_sub(a: Vec[int], b: Vec[int]) -> Vec[int]:
    mut r = Vec[int].init(a.len + 1)
    mut borrow = 0
    mut i = 0
    while i < a.len:
        mut s = a.get(i) - borrow
        if i < b.len: s = s - b.get(i)
        if s < 0:
            s = s + BN_BASE
            borrow = 1
        else:
            borrow = 0
        r.push(s)
        i = i + 1
    bn_trim(r)
    return r

pub def bn_mul(a: Vec[int], b: Vec[int]) -> Vec[int]:
    if a.len == 0 or b.len == 0: return bn_zero()
    mut r = Vec[int].init(a.len + b.len + 1)
    mut k = 0
    while k < a.len + b.len:
        r.push(0)
        k = k + 1
    mut i = 0
    while i < a.len:
        mut ai = a.get(i)
        mut carry = 0
        mut j = 0
        while j < b.len:
            mut s = r.get(i + j) + ai * b.get(j) + carry
            r.set(i + j, s & BN_MASK)
            carry = s >> BN_BITS
            j = j + 1
        r.set(i + b.len, carry)
        i = i + 1
    bn_trim(r)
    return r

pub def bn_shl(a: Vec[int], bits: int) -> Vec[int]:
    if a.len == 0: return bn_zero()
    mut limbs = bits / BN_BITS
    mut sh = bits - limbs * BN_BITS
    mut r = Vec[int].init(a.len + limbs + 2)
    mut i = 0
    while i < limbs:
        r.push(0)
        i = i + 1
    mut carry = 0
    i = 0
    while i < a.len:
        mut v = (a.get(i) << sh) | carry
        r.push(v & BN_MASK)
        carry = v >> BN_BITS
        i = i + 1
    if carry > 0: r.push(carry)
    return r

pub def bn_shr(a: Vec[int], bits: int) -> Vec[int]:
    mut limbs = bits / BN_BITS
    mut sh = bits - limbs * BN_BITS
    mut r = Vec[int].init(a.len + 1)
    mut i = limbs
    while i < a.len:
        mut v = a.get(i) >> sh
        if i + 1 < a.len: v = v | ((a.get(i + 1) << (BN_BITS - sh)) & BN_MASK)
        r.push(v)
        i = i + 1
    bn_trim(r)
    return r

pub class BnDivMod:
    pub q: Vec[int]
    pub r: Vec[int]

# Knuth algorithm D. Division by zero returns q = r = 0.
pub def bn_divmod(a: Vec[int], b: Vec[int]) -> BnDivMod:
    mut res = BnDivMod()
    if b.len == 0:
        res.q = bn_zero()
        res.r = bn_zero()
        return res
    if bn_cmp(a, b) < 0:
        res.q = bn_zero()
        res.r = bn_clone(a)
        return res
    if b.len == 1:
        mut d = b.get(0)
        mut q = Vec[int].init(a.len + 1)
        mut k = 0
        while k < a.len:
            q.push(0)
            k = k + 1
        mut rem = 0
        mut i = a.len - 1
        while i >= 0:
            mut cur = rem * BN_BASE + a.get(i)
            q.set(i, cur / d)
            rem = cur - (cur / d) * d
            i = i - 1
        bn_trim(q)
        res.q = q
        res.r = bn_from_int(rem)
        return res
    # normalize so the top limb of the divisor has its high bit set
    mut s = 0
    mut top = b.get(b.len - 1)
    while top < (BN_BASE >> 1):
        top = top << 1
        s = s + 1
    mut v = bn_shl(b, s)
    mut u = bn_shl(a, s)
    while u.len < a.len + 1:
        u.push(0)
    if u.len == a.len + 1 and a.len + 1 > u.len: u.push(0)
    mut n = v.len
    mut m = u.len - n - 1
    mut q = Vec[int].init(m + 2)
    mut z = 0
    while z <= m:
        q.push(0)
        z = z + 1
    mut vn1 = v.get(n - 1)
    mut vn2 = v.get(n - 2)
    mut j = m
    while j >= 0:
        mut num = u.get(j + n) * BN_BASE + u.get(j + n - 1)
        mut qhat = num / vn1
        mut rhat = num - qhat * vn1
        while qhat >= BN_BASE or qhat * vn2 > rhat * BN_BASE + u.get(j + n - 2):
            qhat = qhat - 1
            rhat = rhat + vn1
            if rhat >= BN_BASE: break
        # multiply and subtract
        mut borrow = 0
        mut carry = 0
        mut i = 0
        while i < n:
            mut p = qhat * v.get(i) + carry
            carry = p >> BN_BITS
            mut t = u.get(i + j) - (p & BN_MASK) - borrow
            if t < 0:
                t = t + BN_BASE
                borrow = 1
            else:
                borrow = 0
            u.set(i + j, t)
            i = i + 1
        mut t2 = u.get(j + n) - carry - borrow
        if t2 < 0:
            # qhat was one too large: add the divisor back
            qhat = qhat - 1
            mut c2 = 0
            i = 0
            while i < n:
                mut s2 = u.get(i + j) + v.get(i) + c2
                u.set(i + j, s2 & BN_MASK)
                c2 = s2 >> BN_BITS
                i = i + 1
            t2 = (t2 + c2) & BN_MASK
        u.set(j + n, t2)
        q.set(j, qhat)
        j = j - 1
    bn_trim(q)
    # remainder = low n limbs of u, denormalized
    mut r = Vec[int].init(n + 1)
    mut ri = 0
    while ri < n:
        r.push(u.get(ri))
        ri = ri + 1
    bn_trim(r)
    res.q = q
    res.r = bn_shr(r, s)
    return res

pub def bn_mod(a: Vec[int], m: Vec[int]) -> Vec[int]:
    return bn_divmod(a, m).r

# ── Montgomery context ──────────────────────────────────────────────────────

pub class Mont:
    pub n:   Vec[int]     # the odd modulus (k limbs)
    pub k:   int
    pub n0:  int          # -n^-1 mod 2^28
    pub rr:  Vec[int]     # R^2 mod n, padded to k limbs (R = 2^(28k))
    pub one: Vec[int]     # R mod n (Montgomery form of 1), padded to k limbs

def bn_pad(a: Vec[int], k: int) -> Vec[int]:
    mut r = Vec[int].init(k + 1)
    mut i = 0
    while i < k:
        if i < a.len: r.push(a.get(i))
        else: r.push(0)
        i = i + 1
    return r

extend Mont:
    # Build a context for an odd modulus > 1.
    pub def init(n: Vec[int]) -> Mont:
        mut c = Mont()
        c.n = bn_clone(n)
        c.k = n.len
        mut m0 = n.get(0)
        mut x = m0
        mut it = 0
        while it < 5:
            x = (x * ((2 - ((m0 * x) & BN_MASK)) & BN_MASK)) & BN_MASK
            it = it + 1
        c.n0 = (BN_BASE - x) & BN_MASK
        # R^2 mod n = 2^(56k) mod n
        mut r2 = Vec[int].init(2 * c.k + 2)
        mut z = 0
        while z < 2 * c.k:
            r2.push(0)
            z = z + 1
        r2.push(1)
        c.rr = bn_pad(bn_mod(r2, n), c.k)
        mut r1 = Vec[int].init(c.k + 2)
        z = 0
        while z < c.k:
            r1.push(0)
            z = z + 1
        r1.push(1)
        c.one = bn_pad(bn_mod(r1, n), c.k)
        return c

    # a*b*R^-1 mod n for k-limb a, b (both < n).
    pub def mul(self, a: Vec[int], b: Vec[int]) -> Vec[int]:
        mut k = self.k
        mut t = Vec[int].init(k + 3)
        mut z = 0
        while z < k + 2:
            t.push(0)
            z = z + 1
        mut n = self.n
        mut n0 = self.n0
        mut i = 0
        while i < k:
            mut ai = a.get(i)
            mut c = 0
            mut j = 0
            while j < k:
                mut s = t.get(j) + ai * b.get(j) + c
                t.set(j, s & BN_MASK)
                c = s >> BN_BITS
                j = j + 1
            mut s1 = t.get(k) + c
            t.set(k, s1 & BN_MASK)
            t.set(k + 1, s1 >> BN_BITS)
            mut m = (t.get(0) * n0) & BN_MASK
            mut s0 = t.get(0) + m * n.get(0)
            c = s0 >> BN_BITS
            j = 1
            while j < k:
                mut s = t.get(j) + m * n.get(j) + c
                t.set(j - 1, s & BN_MASK)
                c = s >> BN_BITS
                j = j + 1
            mut s2 = t.get(k) + c
            t.set(k - 1, s2 & BN_MASK)
            c = s2 >> BN_BITS
            t.set(k, t.get(k + 1) + c)
            t.set(k + 1, 0)
            i = i + 1
        # conditional final subtraction
        mut ge = t.get(k) != 0
        if not ge:
            ge = true
            mut q = k - 1
            while q >= 0:
                mut x = t.get(q)
                mut y = n.get(q)
                if x != y:
                    ge = x > y
                    break
                q = q - 1
        if ge:
            mut borrow = 0
            mut q = 0
            while q < k:
                mut d = t.get(q) - n.get(q) - borrow
                if d < 0:
                    d = d + BN_BASE
                    borrow = 1
                else:
                    borrow = 0
                t.set(q, d)
                q = q + 1
        t.len = k
        return t

    # x (any value < n) -> Montgomery form, k limbs.
    pub def to_mont(self, x: Vec[int]) -> Vec[int]:
        return self.mul(bn_pad(x, self.k), self.rr)

    # Montgomery form -> normalized plain number.
    pub def from_mont(self, x: Vec[int]) -> Vec[int]:
        mut one = bn_pad(bn_from_int(1), self.k)
        mut r = self.mul(x, one)
        bn_trim(r)
        return r

    # (a + b) mod n for k-limb operands < n.
    pub def add(self, a: Vec[int], b: Vec[int]) -> Vec[int]:
        mut k = self.k
        mut r = Vec[int].init(k + 1)
        mut c = 0
        mut i = 0
        while i < k:
            mut s = a.get(i) + b.get(i) + c
            r.push(s & BN_MASK)
            c = s >> BN_BITS
            i = i + 1
        mut ge = c > 0
        if not ge:
            ge = true
            mut q = k - 1
            while q >= 0:
                mut x = r.get(q)
                mut y = self.n.get(q)
                if x != y:
                    ge = x > y
                    break
                q = q - 1
        if ge:
            mut borrow = 0
            i = 0
            while i < k:
                mut d = r.get(i) - self.n.get(i) - borrow
                if d < 0:
                    d = d + BN_BASE
                    borrow = 1
                else:
                    borrow = 0
                r.set(i, d)
                i = i + 1
        return r

    # (a - b) mod n for k-limb operands < n.
    pub def sub(self, a: Vec[int], b: Vec[int]) -> Vec[int]:
        mut k = self.k
        mut r = Vec[int].init(k + 1)
        mut borrow = 0
        mut i = 0
        while i < k:
            mut d = a.get(i) - b.get(i) - borrow
            if d < 0:
                d = d + BN_BASE
                borrow = 1
            else:
                borrow = 0
            r.push(d)
            i = i + 1
        if borrow == 1:
            mut c = 0
            i = 0
            while i < k:
                mut s = r.get(i) + self.n.get(i) + c
                r.set(i, s & BN_MASK)
                c = s >> BN_BITS
                i = i + 1
        return r

    # Montgomery-form exponentiation: base^exp (exp a plain number), 4-bit window.
    pub def pow(self, base_m: Vec[int], exp: Vec[int]) -> Vec[int]:
        mut k = self.k
        # table[i] = base^i, flat: 16 entries of k limbs
        mut table = Vec[int].init(16 * k + 1)
        mut i = 0
        while i < k:
            table.push(self.one.get(i))
            i = i + 1
        i = 0
        while i < k:
            table.push(base_m.get(i))
            i = i + 1
        mut e = 2
        while e < 16:
            mut prev = Vec[int].init(k + 1)
            mut q = 0
            while q < k:
                prev.push(table.get((e - 1) * k + q))
                q = q + 1
            mut nx = self.mul(prev, base_m)
            q = 0
            while q < k:
                table.push(nx.get(q))
                q = q + 1
            e = e + 1
        mut bits = bn_bit_len(exp)
        mut acc = bn_clone(self.one)
        if bits == 0: return acc
        mut nwin = (bits + 3) / 4
        mut w = nwin - 1
        while w >= 0:
            mut s = 0
            while s < 4:
                acc = self.mul(acc, acc)
                s = s + 1
            mut d = bn_get_bit(exp, w * 4) | (bn_get_bit(exp, w * 4 + 1) << 1) | (bn_get_bit(exp, w * 4 + 2) << 2) | (bn_get_bit(exp, w * 4 + 3) << 3)
            if d != 0:
                mut mulv = Vec[int].init(k + 1)
                mut q = 0
                while q < k:
                    mulv.push(table.get(d * k + q))
                    q = q + 1
                acc = self.mul(acc, mulv)
            w = w - 1
        return acc

    # Modular inverse of a plain number mod a PRIME modulus (Fermat: a^(n-2)).
    pub def inv_prime(self, a: Vec[int]) -> Vec[int]:
        mut e = bn_sub(self.n, bn_from_int(2))
        mut am = self.to_mont(bn_mod(a, self.n))
        return self.from_mont(self.pow(am, e))

# base^exp mod m for an ODD modulus m > 1 (plain numbers in and out).
pub def bn_modexp(base: Vec[int], exp: Vec[int], m: Vec[int]) -> Vec[int]:
    mut c = Mont.init(m)
    mut bm = c.to_mont(bn_mod(base, m))
    return c.from_mont(c.pow(bm, exp))
