# std.crypto.sha3 — SHA-3 (FIPS 202) and Keccak, pure Tauraro.
#
#   SHA3-224 / SHA3-256 / SHA3-384 / SHA3-512     fixed-length hashes
#   SHAKE128 / SHAKE256                           extendable-output functions (XOF)
#   Keccak-256 / Keccak-512                       the pre-standard Keccak padding (0x01)
#                                                 used by Ethereum & friends
#
# The Keccak-f[1600] permutation is computed from its definition (rotation
# offsets, lane walk and the iota round constants from the spec's LFSR), so there
# are no big constant tables. Verified against the NIST FIPS 202 / SHA-3 example
# and Keccak known-answer vectors (and cross-checked with Python hashlib /
# OpenSSL) — see tests/lang/110_sha3.tr.
#
# Binary convention: inputs are a `str` (its true length `s.len()` is used, so
# embedded NULs are fine); digests come back as RAW bytes in a `str` with the
# true length (print with Hex.encode) or, via the `_hex` helpers, as lowercase hex.
#
# Usage:
#   from std.crypto.sha3 import Sha3, Sha3Hasher
#   print(Sha3.sha3_256_hex("abc"))
#   mut raw = Sha3.sha3_512("abc")                # 64 raw bytes
#   mut xof = Sha3.shake128("seed", 40)           # 40 bytes of SHAKE128 output
#
#   # incremental / streaming
#   mut h = Sha3Hasher.sha3_256()
#   h.update("ab")
#   h.update("c")
#   mut d = h.digest()                            # == Sha3.sha3_256("abc")
#   h.free()
#
#   mut x = Sha3Hasher.shake256()
#   x.update("seed")
#   mut a = x.squeeze(16)                         # XOF: squeeze repeatedly
#   mut b = x.squeeze(16)                         # the next 16 bytes
#   x.free()
#
# Not constant-time-hardened beyond what the algorithm gives for free (Keccak has
# no secret-dependent branches or table lookups). The sponge state is wiped by
# `free()`.

from std.crypto.bytes import CryptoBytes
from std.encoding.hex import Hex

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_c_free(ptr: Pointer[char])
    def _tr_c_secure_zero(ptr: Pointer[char], n: int)
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str

def kc_rotl(x: u64, n: int) -> u64:
    if n == 0: return x
    return (x << n) | (x >> (64 - n))

def kc_ld(p: Pointer[u64], i: int) -> u64:
    unsafe:
        return p.offset(i).read()

def kc_st(p: Pointer[u64], i: int, v: u64):
    unsafe:
        p.offset(i).write(v)

# value i of a table stored as letters ('A' + value)
def kc_tab(tbl: str, i: int) -> int:
    mut p = tbl as Pointer[char]
    unsafe:
        return (p.offset(i).read() as int) - 65

# Keccak-f[1600] on 25 little-endian 64-bit lanes at `a` (lane index x + 5*y).
# `bc` is 5 lanes of scratch. Rotation offsets and the pi lane walk are the standard
# 24-entry tables (as in FIPS 202 section 3.2.2-3.2.3); the iota round constants come from
# the spec's degree-8 LFSR.
pub def keccak_f1600(a: Pointer[u64], bc: Pointer[u64]):
    mut rotc = "BDGKPV]enxCO\jyIZlSh~Um"
    mut piln = "KHLRSDFQIVYEPXTNMCUOWJGB"
    mut lfsr = 1
    mut round = 0
    while round < 24:
        # theta
        mut x = 0
        while x < 5:
            kc_st(bc, x, kc_ld(a, x) ^ kc_ld(a, x + 5) ^ kc_ld(a, x + 10) ^ kc_ld(a, x + 15) ^ kc_ld(a, x + 20))
            x = x + 1
        x = 0
        while x < 5:
            mut left = x + 4
            if left >= 5: left = left - 5
            mut right = x + 1
            if right >= 5: right = 0
            mut t: u64 = kc_ld(bc, left) ^ kc_rotl(kc_ld(bc, right), 1)
            mut y = x
            while y < 25:
                kc_st(a, y, kc_ld(a, y) ^ t)
                y = y + 5
            x = x + 1
        # rho + pi
        mut cur: u64 = kc_ld(a, 1)
        mut ti = 0
        while ti < 24:
            mut j = kc_tab(piln, ti)
            mut nxt: u64 = kc_ld(a, j)
            kc_st(a, j, kc_rotl(cur, kc_tab(rotc, ti)))
            cur = nxt
            ti = ti + 1
        # chi
        mut yy = 0
        while yy < 25:
            mut b0: u64 = kc_ld(a, yy)
            mut b1: u64 = kc_ld(a, yy + 1)
            mut b2: u64 = kc_ld(a, yy + 2)
            mut b3: u64 = kc_ld(a, yy + 3)
            mut b4: u64 = kc_ld(a, yy + 4)
            kc_st(a, yy, b0 ^ ((~b1) & b2))
            kc_st(a, yy + 1, b1 ^ ((~b2) & b3))
            kc_st(a, yy + 2, b2 ^ ((~b3) & b4))
            kc_st(a, yy + 3, b3 ^ ((~b4) & b0))
            kc_st(a, yy + 4, b4 ^ ((~b0) & b1))
            yy = yy + 5
        # iota
        mut rc: u64 = 0
        mut jj = 0
        while jj < 7:
            if (lfsr & 1) == 1:
                rc = rc | ((1 as u64) << ((1 << jj) - 1))
            lfsr = lfsr << 1
            if (lfsr & 0x100) != 0: lfsr = lfsr ^ 0x171
            jj = jj + 1
        kc_st(a, 0, kc_ld(a, 0) ^ rc)
        round = round + 1

# ─── incremental sponge ──────────────────────────────────────────────────────

pub class Sha3Hasher:
    st:       Pointer[u64]     # 25 lanes
    bc:       Pointer[u64]     # 5 lanes scratch
    rate:     int              # bytes
    pos:      int              # bytes absorbed/squeezed in the current block
    suffix:   int              # domain-separation/padding byte (0x06 SHA3, 0x1f SHAKE, 0x01 Keccak)
    outlen:   int              # fixed digest length (0 for XOFs)
    squeezing: bool

extend Sha3Hasher:
    pub def init(rate: int, suffix: int, outlen: int) -> Sha3Hasher:
        mut h = Sha3Hasher()
        mut raw: Pointer[char] = CryptoBytes.zeroed(25 * 8 + 5 * 8 + 16)
        h.st = raw as Pointer[u64]
        mut base = raw as Pointer[char]
        unsafe:
            h.bc = base.offset(25 * 8) as Pointer[u64]
        h.rate = rate
        h.pos = 0
        h.suffix = suffix
        h.outlen = outlen
        h.squeezing = false
        return h

    pub def sha3_224() -> Sha3Hasher:
        return Sha3Hasher.init(144, 6, 28)
    pub def sha3_256() -> Sha3Hasher:
        return Sha3Hasher.init(136, 6, 32)
    pub def sha3_384() -> Sha3Hasher:
        return Sha3Hasher.init(104, 6, 48)
    pub def sha3_512() -> Sha3Hasher:
        return Sha3Hasher.init(72, 6, 64)
    pub def shake128() -> Sha3Hasher:
        return Sha3Hasher.init(168, 31, 0)
    pub def shake256() -> Sha3Hasher:
        return Sha3Hasher.init(136, 31, 0)
    # Original Keccak padding (NOT SHA-3): Keccak-256 as used by Ethereum.
    pub def keccak256() -> Sha3Hasher:
        return Sha3Hasher.init(136, 1, 32)
    pub def keccak512() -> Sha3Hasher:
        return Sha3Hasher.init(72, 1, 64)

    def xor_byte(self, i: int, b: int):
        mut lane = i >> 3
        mut sh = (i & 7) * 8
        kc_st(self.st, lane, kc_ld(self.st, lane) ^ ((b as u64) << sh))

    # Absorb `n` bytes of `data`. Panics-free: calling after squeezing started is ignored.
    pub def update_bytes(self, data: str, n: int):
        if self.squeezing: return
        mut p = data as Pointer[char]
        mut i = 0
        while i < n:
            if (self.pos & 7) == 0 and n - i >= 8 and self.rate - self.pos >= 8:
                # whole aligned lane: assemble 8 little-endian bytes and XOR once
                mut w: u64 = 0
                mut k = 7
                while k >= 0:
                    mut b8 = 0
                    unsafe:
                        b8 = (p.offset(i + k).read() as int) & 255
                    w = (w << 8) | (b8 as u64)
                    k = k - 1
                mut lane = self.pos >> 3
                kc_st(self.st, lane, kc_ld(self.st, lane) ^ w)
                self.pos = self.pos + 8
                i = i + 8
            else:
                mut b = 0
                unsafe:
                    b = (p.offset(i).read() as int) & 255
                self.xor_byte(self.pos, b)
                self.pos = self.pos + 1
                i = i + 1
            if self.pos == self.rate:
                keccak_f1600(self.st, self.bc)
                self.pos = 0

    pub def update(self, data: str):
        self.update_bytes(data, data.len())

    def finish_absorb(self):
        if self.squeezing: return
        self.xor_byte(self.pos, self.suffix)
        self.xor_byte(self.rate - 1, 0x80)
        keccak_f1600(self.st, self.bc)
        self.pos = 0
        self.squeezing = true

    # Squeeze the next `n` output bytes (finishes absorbing on first call). For the
    # fixed-length hashes prefer `digest()`.
    pub def squeeze(self, n: int) -> str:
        self.finish_absorb()
        mut out: Pointer[char] = CryptoBytes.zeroed(n)
        mut i = 0
        while i < n:
            if self.pos == self.rate:
                keccak_f1600(self.st, self.bc)
                self.pos = 0
            mut lane: u64 = kc_ld(self.st, self.pos >> 3)
            mut b = ((lane >> ((self.pos & 7) * 8)) & (255 as u64)) as int
            CryptoBytes.put(out, i, b)
            self.pos = self.pos + 1
            i = i + 1
        return CryptoBytes.wrap(out, n)

    # The fixed-length digest (28/32/48/64 bytes). For SHAKE (outlen 0) returns "".
    pub def digest(self) -> str:
        return self.squeeze(self.outlen)

    pub def digest_hex(self) -> str:
        mut raw = self.squeeze(self.outlen)
        return Hex.encode(raw)

    # Wipe and release the sponge state.
    pub def free(self):
        _tr_c_secure_zero(self.st as Pointer[char], 25 * 8 + 5 * 8)
        _tr_c_free(self.st as Pointer[char])

# ─── one-shot API ────────────────────────────────────────────────────────────

pub class Sha3:
    _dummy: int

def sha3_one(h: Sha3Hasher, data: str) -> str:
    h.update(data)
    mut out = h.digest()
    h.free()
    return out

extend Sha3:
    pub def sha3_224(data: str) -> str:
        return sha3_one(Sha3Hasher.sha3_224(), data)
    pub def sha3_256(data: str) -> str:
        return sha3_one(Sha3Hasher.sha3_256(), data)
    pub def sha3_384(data: str) -> str:
        return sha3_one(Sha3Hasher.sha3_384(), data)
    pub def sha3_512(data: str) -> str:
        return sha3_one(Sha3Hasher.sha3_512(), data)
    pub def keccak256(data: str) -> str:
        return sha3_one(Sha3Hasher.keccak256(), data)
    pub def keccak512(data: str) -> str:
        return sha3_one(Sha3Hasher.keccak512(), data)

    pub def sha3_224_hex(data: str) -> str:
        return Hex.encode(Sha3.sha3_224(data))
    pub def sha3_256_hex(data: str) -> str:
        return Hex.encode(Sha3.sha3_256(data))
    pub def sha3_384_hex(data: str) -> str:
        return Hex.encode(Sha3.sha3_384(data))
    pub def sha3_512_hex(data: str) -> str:
        return Hex.encode(Sha3.sha3_512(data))
    pub def keccak256_hex(data: str) -> str:
        return Hex.encode(Sha3.keccak256(data))
    pub def keccak512_hex(data: str) -> str:
        return Hex.encode(Sha3.keccak512(data))

    # SHAKE128/256 extendable-output functions: `outlen` bytes of output.
    pub def shake128(data: str, outlen: int) -> str:
        mut h = Sha3Hasher.shake128()
        h.update(data)
        mut out = h.squeeze(outlen)
        h.free()
        return out
    pub def shake256(data: str, outlen: int) -> str:
        mut h = Sha3Hasher.shake256()
        h.update(data)
        mut out = h.squeeze(outlen)
        h.free()
        return out
    pub def shake128_hex(data: str, outlen: int) -> str:
        return Hex.encode(Sha3.shake128(data, outlen))
    pub def shake256_hex(data: str, outlen: int) -> str:
        return Hex.encode(Sha3.shake256(data, outlen))
