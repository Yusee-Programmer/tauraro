# std.crypto.hash — SHA-256, SHA-1, MD5 hashing.
#
# SHA-256/SHA-1 are pure-C, no external library needed.
# All methods are static — no instance required.
#
# Usage:
#   from std.crypto.hash import Hash
#   mut digest = Hash.sha256("hello")     # 64-char lowercase hex
#   mut raw    = Hash.sha256_bytes("hi", 2)  # 32-byte raw digest as str

extern "C":
    def _tr_sha256_hex(input: str) -> str
    def _tr_sha256_bytes_of(input: str, ilen: int) -> str
    def _tr_md5_hex(s: str) -> str
    def _tr_sha1_hex(s: str) -> str
    def _tr_sha1_bytes_hex(input: str, ilen: int) -> str

pub class Hash:
    _dummy: int

extend Hash:
    # SHA-256 digest of a null-terminated string. Returns 64-char lowercase hex.
    pub def sha256(s: str) -> str:
        return _tr_sha256_hex(s)

    # SHA-256 digest of exactly `len` bytes of `data`. Returns 64-char lowercase hex.
    pub def sha256_bytes(data: str, len_: int) -> str:
        return _tr_sha256_bytes_of(data, len_)

    # MD5 digest of a null-terminated string. Returns 32-char lowercase hex.
    # Note: MD5 is cryptographically broken — use SHA-256 for security-sensitive work.
    #
    # ALSO KNOWN BROKEN independent of that: the underlying `_tr_md5_hex`
    # runtime implementation currently returns the WRONG digest for any
    # input (confirmed against known-answer vectors, e.g. `md5("abc")`
    # should be `900150983cd24fb0d6963f7d28e17f72` but returns
    # `c3ef16ee4475f3000f4c483edfeff40d`; same divergence on `""` and `"a"`).
    # This predates any changes made in this session — the same wrong
    # output comes from the original, untouched compiler build. A full
    # line-by-line review against the reference MD5 algorithm (constants
    # table, shift table, round functions, message schedule, padding,
    # byte order, final combine) found no discrepancy, so whatever's wrong
    # is subtler than a transcription error and needs a real step-by-step
    # trace to isolate. See std/crypto/uuid.tr's `UUID.v3()` for the full
    # investigation notes (SHA-1, used by `Hash.sha1()`/`UUID.v5()`, does
    # NOT share this bug — verified correct against known-answer vectors).
    pub def md5(s: str) -> str:
        return _tr_md5_hex(s)

    # SHA-1 digest of a null-terminated string. Returns 40-char lowercase hex.
    # Note: SHA-1 is cryptographically broken — use SHA-256 for security-sensitive
    # work. Provided for UUID v5 (RFC 4122) and interop with legacy systems.
    pub def sha1(s: str) -> str:
        return _tr_sha1_hex(s)

    # SHA-1 digest of exactly `len` raw bytes of `data`. Returns 40-char lowercase hex.
    pub def sha1_bytes(data: str, len_: int) -> str:
        return _tr_sha1_bytes_hex(data, len_)
