# std.crypto.bytes — raw byte-string helpers shared by the std.crypto modules,
# plus a constant-time comparison and a secure wipe.
#
# Binary data in Tauraro is a `str` used as a raw byte buffer: the `str` header
# carries the TRUE byte length (`s.len()`), so values with embedded NULs (every
# digest, key and MAC in std.crypto) are handled byte-exactly. Use `Hex.encode`
# to print them and `Hex.decode` to build them from hex.
#
# Usage:
#   from std.crypto.bytes import CryptoBytes
#   if CryptoBytes.ct_eq(tag_a, tag_b): ...          # constant-time compare
#   mut buf = CryptoBytes.zeroed(32)                   # zeroed, freeable buffer
#   CryptoBytes.secure_zero(buf, 32)                  # wipe (not optimised away)
#
# SECURITY NOTES (honest limits)
#   * `ct_eq` runs in time that depends only on the LENGTHS of its inputs (it
#     ORs together the XOR of every byte pair, with no early exit and no
#     data-dependent branch). Length inequality returns false immediately: the
#     length of a MAC/hash is public. The generated C is compiled by an
#     optimising C compiler; this is the standard accumulate-and-test idiom
#     and holds on every mainstream compiler, but no language-level guarantee
#     exists. Use it for MAC / token / password-hash comparison, never `==`.
#   * `secure_zero` uses volatile stores (a C runtime helper) so the wipe is
#     not removed as a dead store. It wipes a raw buffer you own; `str` values
#     are immutable, reference-counted and may have been copied by the runtime,
#     so secrets held in `str`s cannot be guaranteed erased — keep key material
#     in the explicit buffers the std.crypto classes manage (their `free()`
#     wipes them) and avoid copying it into strings longer than needed.

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_c_free(ptr: Pointer[char])
    def _tr_c_memcpy(dst: Pointer[char], src: Pointer[char], n: int)
    def _tr_c_secure_zero(ptr: Pointer[char], n: int)
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str
    def _tr_ed25519_gen_seed() -> str

pub class CryptoBytes:
    _dummy: int

extend CryptoBytes:
    # Unsigned byte `i` of `s` (0..255). No bounds check: i must be < s.len().
    pub def at(s: str, i: int) -> int:
        mut p = s as Pointer[char]
        unsafe:
            return (p.offset(i).read() as int) & 255

    # Allocate a ZEROED buffer of `n` bytes (plus a terminating NUL, so it can be
    # wrapped by `wrap`). Release with `CryptoBytes.release` or turn it into a
    # `str` with `wrap`.
    pub def zeroed(n: int) -> Pointer[char]:
        mut p = _tr_c_malloc(n + 1)
        mut i = 0
        while i <= n:
            unsafe:
                p.offset(i).write('\0')
            i = i + 1
        return p

    pub def release(p: Pointer[char]):
        _tr_c_free(p)

    # Turn a buffer from `zeroed(n)` into a binary-safe `str` of length `n`.
    # Ownership of the buffer moves to the returned string.
    pub def wrap(p: Pointer[char], n: int) -> str:
        return _tr_str_wrap_len(p, n)

    pub def get(p: Pointer[char], i: int) -> int:
        unsafe:
            return (p.offset(i).read() as int) & 255

    pub def put(p: Pointer[char], i: int, v: int):
        unsafe:
            p.offset(i).write((v & 255) as char)

    # Byte-exact copy of `s[start .. start+n]` as a new string.
    pub def slice(s: str, start: int, n: int) -> str:
        mut out: Pointer[char] = CryptoBytes.zeroed(n)
        mut sp = s as Pointer[char]
        mut i = 0
        while i < n:
            unsafe:
                out.offset(i).write(sp.offset(start + i).read())
            i = i + 1
        return _tr_str_wrap_len(out, n)

    # Concatenate two binary strings (byte-exact).
    pub def concat(a: str, b: str) -> str:
        mut la = a.len()
        mut lb = b.len()
        mut out: Pointer[char] = CryptoBytes.zeroed(la + lb)
        mut ap = a as Pointer[char]
        mut bp = b as Pointer[char]
        mut i = 0
        while i < la:
            unsafe:
                out.offset(i).write(ap.offset(i).read())
            i = i + 1
        i = 0
        while i < lb:
            unsafe:
                out.offset(la + i).write(bp.offset(i).read())
            i = i + 1
        return _tr_str_wrap_len(out, la + lb)

    # Constant-time equality of two byte strings (see the module notes).
    # Different lengths -> false immediately (lengths are not secret).
    pub def ct_eq(a: str, b: str) -> bool:
        mut n = a.len()
        if n != b.len(): return false
        mut ap = a as Pointer[char]
        mut bp = b as Pointer[char]
        mut diff = 0
        mut i = 0
        while i < n:
            unsafe:
                diff = diff | (((ap.offset(i).read() as int) ^ (bp.offset(i).read() as int)) & 255)
            i = i + 1
        # (diff - 1) >> 8 is -1 (all ones) iff diff == 0 for diff in 0..255.
        return ((diff - 1) >> 8) & 1 == 1

    # Constant-time comparison of the first `n` bytes of two buffers (no length check).
    pub def ct_eq_n(a: Pointer[char], b: Pointer[char], n: int) -> bool:
        mut diff = 0
        mut i = 0
        while i < n:
            unsafe:
                diff = diff | (((a.offset(i).read() as int) ^ (b.offset(i).read() as int)) & 255)
            i = i + 1
        return ((diff - 1) >> 8) & 1 == 1

    # Constant-time select-free integer compare helper: returns 1 if x == y else 0
    # for 32-bit-range values, without a branch.
    pub def ct_eq_int(x: int, y: int) -> int:
        mut d = (x ^ y) & 0xFFFFFFFF
        return ((d - 1) >> 32) & 1

    # Overwrite `n` bytes at `p` with zeros using volatile stores.
    pub def secure_zero(p: Pointer[char], n: int):
        _tr_c_secure_zero(p, n)

    # `n` bytes of OS-CSPRNG randomness (BCryptGenRandom / /dev/urandom) as a
    # binary string. (If the OS source cannot be opened the runtime falls back to
    # a non-cryptographic PRNG — same behaviour as std.crypto.ed25519.gen_seed.)
    pub def random(n: int) -> str:
        mut out: Pointer[char] = CryptoBytes.zeroed(n)
        mut got = 0
        while got < n:
            mut hx = _tr_ed25519_gen_seed()
            mut hp = hx as Pointer[char]
            mut j = 0
            while j < 32 and got < n:
                mut c0 = 0
                mut c1 = 0
                unsafe:
                    c0 = hp.offset(2 * j).read() as int
                    c1 = hp.offset(2 * j + 1).read() as int
                mut v0 = c0 - 48
                if c0 >= 97: v0 = c0 - 87
                mut v1 = c1 - 48
                if c1 >= 97: v1 = c1 - 87
                CryptoBytes.put(out, got, (v0 << 4) | v1)
                got = got + 1
                j = j + 1
        return _tr_str_wrap_len(out, n)
