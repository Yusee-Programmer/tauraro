# std.crypto.jwt — JSON Web Tokens (RFC 7519).
#
# Two APIs live here:
#   * Jwt.encode / Jwt.decode -- the original HS256-only shared-secret API
#     with Dict[str, str] claims (described below, unchanged);
#   * Jwt.sign_jwk / verify_jwk / verify_jwks -- JWK-based tokens with every
#     algorithm std.crypto.jwk implements (RS/PS/ES/EdDSA/HS) and exp / nbf /
#     iat / aud / iss checks with leeway (see the section at the end).
#
# Claims are `Dict[str, str]` (string-valued claims only) — the simplest
# contract that covers the common case (sub, iss, exp-as-string, custom
# string claims) without needing a full dynamic JSON-value type in the
# public API. Numeric claims such as "exp"/"iat" (Unix timestamps) can be
# stored as their string decimal form and parsed back with `int(...)` by
# the caller.
#
# SECURITY — decode() ALWAYS verifies the signature before returning any
# claims. This directly targets the classic JWT vulnerability class:
# "alg:none" / signature-not-checked bugs, where a decoder that trusts
# the token's own `alg` header (or skips verification entirely) lets an
# attacker forge arbitrary claims. This module:
#   - hardcodes verification to HS256 (does NOT read `alg` from the
#     token and dispatch on it -- an attacker-controlled header field
#     must never select the verification algorithm)
#   - rejects any token whose header `alg` is not exactly "HS256"
#   - uses a constant-time-ish comparison for the signature check (see
#     ChaCha20._consteq in std/crypto/chacha20.tr for the same pattern
#     applied to an AEAD tag -- same rationale: avoid a timing
#     side-channel on a secret-dependent comparison)
#   - never returns claims to the caller on any verification failure
#
# NOTE ON NOT USING std/encoding/base64.tr's Base64.encode_url FOR THE
# SIGNATURE: the HMAC-SHA256 signature is 32 raw bytes and, like any raw
# binary digest, routinely contains embedded 0x00 bytes (roughly a 1-in-8
# chance per token in practice). `Base64.encode_url` takes only a `str`
# with no explicit length and hashes/encodes via `_tr_strlen()`
# internally, so it silently truncates at the first embedded NUL byte --
# this would intermittently produce a JWT whose signature segment doesn't
# actually cover the whole real signature (confirmed: a 32-byte digest
# with a NUL at index 6 encodes to an 8-character, not 43-character,
# base64url string). This module therefore base64url-encodes the
# signature itself via a small length-explicit local helper
# (`_b64url_encode_raw`); it still uses `Base64.encode_url`/`decode_url`
# for the header/payload JSON segments, since JSON text is never NUL-
# containing so strlen-based encoding is safe there.
#
# Usage:
#   from std.crypto.jwt import Jwt
#
#   mut claims: Dict[str, str] = {}
#   claims.set("sub", "user123")
#   claims.set("role", "admin")
#   mut token = Jwt.encode(claims, "shared-secret")
#
#   match Jwt.decode(token, "shared-secret"):
#       case JwtResult.Ok(verified_claims):
#           print(verified_claims.get("sub"))
#       case JwtResult.Err(msg):
#           print("rejected: " + msg)

from std.encoding.base64 import Base64
from std.encoding.json import Json, JsonWriter
from std.crypto.hmac import Hmac
from std.core.string import StringBuilder
from std.crypto.jwk import Jwk, JwkSet, Jws, JwsParts
from std.encoding.json import JsonDoc, JsonRef
from std.sys.time import Clock

extern "C":
    def _tr_strlen(s: str) -> int

# RFC 7519 decode result: either the verified claims, or a rejection
# reason. decode() NEVER returns Ok with unverified claims.
pub enum JwtResult:
    Ok(claims: Dict[str, str])
    Err(message: str)

pub class Jwt:
    _dummy: int

extend Jwt:
    # Encode `claims` as a signed HS256 JWT using `secret` as the HMAC
    # key (treated as a null-terminated string -- use a real random
    # secret of at least 32 bytes for production use, not a short
    # guessable string).
    pub def encode(claims: Dict[str, str], secret: str) -> str:
        mut header_json = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
        mut header_b64 = Base64.encode_url(header_json)

        mut w = JsonWriter.init(128)
        w.begin_object()
        for k, v in claims.items():
            w.field_str(k, v)
        w.end_object()
        mut payload_json = w.finish()
        w.free()
        mut payload_b64 = Base64.encode_url(payload_json)

        mut signing_input = header_b64 + "." + payload_b64
        mut slen = _tr_strlen(secret)
        mut sig_hex = Hmac.sha256(secret, slen, signing_input)
        mut sig_raw = Jwt._hex_to_raw(sig_hex)
        # Length-explicit encode (32 bytes) -- NOT Base64.encode_url, which
        # would silently truncate at an embedded NUL byte. See module header.
        mut sig_b64 = Jwt._b64url_encode_raw(sig_raw, 32)

        return signing_input + "." + sig_b64

    # Decode + VERIFY a token. Returns JwtResult.Ok(claims) only if the
    # signature is valid and the header declares alg="HS256"; otherwise
    # JwtResult.Err(reason). Never returns claims that haven't been
    # signature-checked.
    pub def decode(token: str, secret: str) -> JwtResult:
        if not Jwt._has_three_parts(token):
            return JwtResult.Err("malformed token: expected header.payload.signature")
        mut parts = Jwt._split3(token)
        mut header_b64  = parts[0]
        mut payload_b64 = parts[1]
        mut sig_b64     = parts[2]

        # ── Verify signature FIRST, before parsing/trusting anything in
        #    the header or payload (in particular: never branch on the
        #    header's own `alg` field before the signature is checked --
        #    that's exactly the "alg" confusion vulnerability class).
        mut signing_input = header_b64 + "." + payload_b64
        mut slen = _tr_strlen(secret)
        mut expected_sig_hex = Hmac.sha256(secret, slen, signing_input)
        mut expected_sig_raw = Jwt._hex_to_raw(expected_sig_hex)

        # Signature must decode to exactly 32 raw bytes (HMAC-SHA256 output
        # size). Checking the base64url TEXT length up front (rather than
        # scanning the decoded bytes for a NUL) is required for
        # correctness: a genuine 32-byte HMAC digest may legitimately
        # contain 0x00 bytes anywhere, including in a non-final position,
        # so NUL-scanning the decoded bytes would misreport a short length
        # and wrongly reject valid signatures.
        if not Jwt._b64url_decodes_to_32_bytes(sig_b64):
            return JwtResult.Err("invalid signature length")
        mut actual_sig_raw = Base64.decode_url(sig_b64)
        if not Jwt._consteq(expected_sig_raw, actual_sig_raw, 32):
            return JwtResult.Err("signature verification failed")

        # Only now is it safe to parse and trust the header/payload.
        mut header_json = Base64.decode_url(header_b64)
        mut hdoc = Json.parse(header_json)
        mut halg = hdoc.root().obj_get("alg")
        if not halg.exists() or not halg.is_str():
            return JwtResult.Err("missing alg header")
        if not halg.str_eq("HS256"):
            return JwtResult.Err("unsupported alg (only HS256 is supported)")

        mut payload_json = Base64.decode_url(payload_b64)
        mut pdoc = Json.parse(payload_json)
        mut proot = pdoc.root()
        if not proot.is_object():
            return JwtResult.Err("payload is not a JSON object")

        # Walk the payload object's members directly via the doc's kid/
        # sibling links (same traversal JsonDoc.write_at uses for objects)
        # and coerce each value to its string form, since claims here are
        # Dict[str, str] — see the module header on why string-valued
        # claims are this module's contract.
        mut claims: Dict[str, str] = {}
        mut child = pdoc.kids.get(proot.idx)
        while child != 0 - 1:
            mut key = pdoc.strs.slice(pdoc.koffs.get(child), pdoc.koffs.get(child) + pdoc.klens.get(child))
            if pdoc.tag_at(child) == 4:
                claims.set(key, pdoc.str_at(child))
            elif pdoc.tag_at(child) == 2:
                claims.set(key, Jwt._int_to_str(pdoc.int_at(child)))
            elif pdoc.tag_at(child) == 1:
                if pdoc.bool_at(child): claims.set(key, "true")
                else: claims.set(key, "false")
            child = pdoc.sibs.get(child)

        return JwtResult.Ok(claims)

    pub def _int_to_str(n: int) -> str:
        mut sb = StringBuilder.init(24)
        sb.append_int(n)
        mut out = sb.to_owned()
        sb.free()
        return out

    # Split "a.b.c" into its 3 dot-separated parts. Returns ("","","")
    # (caller must check _has_three_parts first) if not exactly 3 parts.
    pub def _has_three_parts(token: str) -> bool:
        mut p = token as Pointer[char]
        mut n = _tr_strlen(token)
        mut dots = 0
        mut i = 0
        while i < n:
            if (p.offset(i).read() as int) == 46: dots = dots + 1   # '.'
            i = i + 1
        if dots != 2: return false
        # also reject empty segments (".." or leading/trailing dot adjacency)
        mut seglen = 0
        mut segs_ok = true
        mut j = 0
        while j < n:
            mut c = p.offset(j).read() as int
            if c == 46:
                if seglen == 0: segs_ok = false
                seglen = 0
            else:
                seglen = seglen + 1
            j = j + 1
        if seglen == 0: segs_ok = false
        return segs_ok

    pub def _split3(token: str) -> (str, str, str):
        mut p = token as Pointer[char]
        mut n = _tr_strlen(token)
        mut first_dot = 0 - 1
        mut second_dot = 0 - 1
        mut i = 0
        while i < n:
            if (p.offset(i).read() as int) == 46:
                if first_dot < 0: first_dot = i
                else: second_dot = i
            i = i + 1
        if first_dot < 0 or second_dot < 0:
            return ("", "", "")
        mut header  = token.slice(0, first_dot)
        mut payload = token.slice(first_dot + 1, second_dot)
        mut sig     = token.slice(second_dot + 1, n)
        return (header, payload, sig)

    pub def _hex_to_raw(hex_str: str) -> str:
        mut p = hex_str as Pointer[char]
        mut n = _tr_strlen(hex_str)
        mut sb = StringBuilder.init(n / 2 + 2)
        mut i = 0
        while i + 1 < n:
            mut hi = Jwt._hex_val(p.offset(i).read() as int)
            mut lo = Jwt._hex_val(p.offset(i + 1).read() as int)
            sb.append_char(((hi << 4) | lo) & 0xff)
            i = i + 2
        mut out = sb.to_owned()
        sb.free()
        return out

    pub def _hex_val(c: int) -> int:
        if c >= 48 and c <= 57: return c - 48
        if c >= 97 and c <= 102: return c - 87
        if c >= 65 and c <= 70: return c - 55
        return 0

    pub def _b64url_char_at(idx: int) -> int:
        mut alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
        return (alpha as Pointer[char]).offset(idx).read() as int

    # Base64url-encode (RFC 4648 sec. 5: '-'/'_' alphabet, no padding)
    # exactly `n` raw bytes of `s` -- length-explicit throughout, unlike
    # std/encoding/base64.tr's Base64.encode_url (see module header note).
    pub def _b64url_encode_raw(s: str, n: int) -> str:
        mut p = s as Pointer[char]
        mut sb = StringBuilder.init((n / 3) * 4 + 8)
        mut i = 0
        while i + 2 < n:
            mut b0 = (p.offset(i).read() as int) & 255
            mut b1 = (p.offset(i + 1).read() as int) & 255
            mut b2 = (p.offset(i + 2).read() as int) & 255
            sb.append_char(Jwt._b64url_char_at((b0 >> 2) & 63))
            sb.append_char(Jwt._b64url_char_at(((b0 & 3) << 4) | ((b1 >> 4) & 15)))
            sb.append_char(Jwt._b64url_char_at(((b1 & 15) << 2) | ((b2 >> 6) & 3)))
            sb.append_char(Jwt._b64url_char_at(b2 & 63))
            i = i + 3
        mut rem = n - i
        if rem == 1:
            mut b0 = (p.offset(i).read() as int) & 255
            sb.append_char(Jwt._b64url_char_at((b0 >> 2) & 63))
            sb.append_char(Jwt._b64url_char_at((b0 & 3) << 4))
        elif rem == 2:
            mut b0 = (p.offset(i).read() as int) & 255
            mut b1 = (p.offset(i + 1).read() as int) & 255
            sb.append_char(Jwt._b64url_char_at((b0 >> 2) & 63))
            sb.append_char(Jwt._b64url_char_at(((b0 & 3) << 4) | ((b1 >> 4) & 15)))
            sb.append_char(Jwt._b64url_char_at((b1 & 15) << 2))
        mut out = sb.to_owned()
        sb.free()
        return out

    # Whether base64url text `s` (no padding, per RFC 7519/4648 sec. 5)
    # decodes to exactly 32 raw bytes -- computed from the TEXT length
    # alone (never by scanning decoded bytes for a NUL; see decode()'s
    # comment on why that would be wrong for arbitrary binary output).
    # 32 bytes of unpadded base64 is always exactly 43 characters
    # (ceil(32*8/6) = 43, and 32*8 = 256 is not a multiple of 6 so there's
    # no padding ambiguity to account for).
    pub def _b64url_decodes_to_32_bytes(s: str) -> bool:
        return _tr_strlen(s) == 43

    # Constant-time-ish comparison (see module header note).
    pub def _consteq(a: str, b: str, n: int) -> bool:
        mut ap = a as Pointer[char]
        mut bp = b as Pointer[char]
        mut diff = 0
        mut i = 0
        while i < n:
            mut ab = (ap.offset(i).read() as int) & 0xff
            mut bb = (bp.offset(i).read() as int) & 0xff
            diff = diff | (ab ^ bb)
            i = i + 1
        return diff == 0

# ─── Asymmetric / JWK-based JWTs (RFC 7519 + RFC 7515 + RFC 7517) ────────────
#
# Jwt.sign_jwk / Jwt.verify_jwk / Jwt.verify_jwks work with std.crypto.jwk
# keys and every JWS algorithm that module implements (HS256/384/512,
# RS256/384/512, PS256/384/512, ES256/384, EdDSA). Claims are the payload's
# JSON text; the verified result (`JwtClaims`) has typed accessors. The
# algorithm is taken from the header only after it has been checked against
# `JwtOptions.algorithms` and the key's type, so "alg" confusion (none, or an
# RSA public key used as an HMAC secret) cannot select a weaker check.
#
#   mut opts = JwtOptions.init()
#   opts.issuer = "https://issuer.example"
#   opts.audience = "my-client"
#   opts.algorithms.append("RS256")
#   mut claims = Jwt.verify_jwks(token, jwks, opts)?
#   print(claims.subject(), claims.get_int("exp"))


# Registered-claim checks applied after the signature has been verified.
pub class JwtOptions:
    pub issuer:      str         # required "iss" ("" = not checked)
    pub audience:    str         # must appear in "aud" ("" = not checked)
    pub subject:     str         # required "sub" ("" = not checked)
    pub algorithms:  List[str]   # accepted "alg" values ([] = any the key supports)
    pub leeway:      int         # clock skew allowance in seconds (default 60)
    pub now:         int         # Unix time to check against (0 = the clock)
    pub require_exp: bool        # reject tokens without "exp" (default true)
    pub typ:         str         # required header "typ", case-insensitive ("" = any)
    pub max_age:     int         # reject when now - iat exceeds this (0 = off)

extend JwtOptions:
    pub def init() -> JwtOptions:
        mut o = JwtOptions()
        o.issuer = ""
        o.audience = ""
        o.subject = ""
        o.algorithms = []
        o.leeway = 60
        o.now = 0
        o.require_exp = true
        o.typ = ""
        o.max_age = 0
        return o

# A verified token's header and claims.
pub class JwtClaims:
    pub header_json:  str
    pub payload_json: str
    pub alg:          str
    pub kid:          str
    pub doc:          JsonDoc

extend JwtClaims:
    pub def root(self) -> JsonRef:
        return self.doc.root()

    pub def has(self, name: str) -> bool:
        return self.doc.root().obj_has(name)

    # String claim ("" when absent or not a string).
    pub def get_str(self, name: str) -> str:
        mut v = self.doc.root().obj_get(name)
        if v.exists() and v.is_str(): return v.get_str()
        return ""

    # Integer claim (floats are truncated; 0 when absent).
    pub def get_int(self, name: str) -> int:
        mut v = self.doc.root().obj_get(name)
        if not v.exists(): return 0
        if v.is_int(): return v.get_int()
        if v.is_float(): return v.get_float() as int
        return 0

    pub def get_bool(self, name: str) -> bool:
        mut v = self.doc.root().obj_get(name)
        return v.exists() and v.is_bool() and v.get_bool()

    # The claim's JSON text ("" when absent).
    pub def get_json(self, name: str) -> str:
        mut v = self.doc.root().obj_get(name)
        if not v.exists(): return ""
        return v.to_str()

    pub def issuer(self) -> str: return self.get_str("iss")
    pub def subject(self) -> str: return self.get_str("sub")
    pub def expires_at(self) -> int: return self.get_int("exp")

    # "aud" as a list (a single string becomes a one-element list).
    pub def audiences(self) -> List[str]:
        mut out: List[str] = []
        mut v = self.doc.root().obj_get("aud")
        if not v.exists(): return out
        if v.is_str():
            mut s = v.get_str()
            out.append(s)
            return out
        if v.is_array():
            mut i = 0
            while i < v.array_len():
                mut el = v.array_get(i)
                if el.is_str():
                    mut es = el.get_str()
                    out.append(es)
                i = i + 1
        return out

def _jwt_numeric(r: JsonRef, name: str, present: Pointer[bool]) throws str -> int:
    mut v = r.obj_get(name)
    if not v.exists():
        unsafe: present.write(false)
        return 0
    unsafe: present.write(true)
    if v.is_int(): return v.get_int()
    if v.is_float(): return v.get_float() as int
    raise(f"JWT: claim '{name}' is not a number")

extend Jwt:
    # Sign `claims_json` (a JSON object) as a JWT with `key` and `alg`. The
    # header carries "typ":"JWT" and the key's "kid" when it has one.
    pub def sign_jwk(claims_json: str, key: Jwk, alg: str) throws str -> str:
        return Jws.sign(claims_json, key, alg, "JWT")?

    # Verify with a single key, then check the registered claims.
    pub def verify_jwk(token: str, key: Jwk, opts: JwtOptions) throws str -> JwtClaims:
        mut parts = Jws.verify(token, key, opts.algorithms)?
        mut c = Jwt._check_claims(parts, opts)?
        return c

    # Verify against a JWK Set (key chosen by "kid" and "alg").
    pub def verify_jwks(token: str, keys: JwkSet, opts: JwtOptions) throws str -> JwtClaims:
        mut parts = Jws.verify_set(token, keys, opts.algorithms)?
        mut c = Jwt._check_claims(parts, opts)?
        return c

    # Header and claims WITHOUT any verification (for routing / debugging
    # only -- never trust the result).
    pub def decode_unverified(token: str) throws str -> JwtClaims:
        mut parts = Jws.decode_unverified(token)?
        mut c = JwtClaims()
        c.header_json = parts.header_json
        c.payload_json = parts.payload
        c.alg = parts.alg
        c.kid = parts.kid
        c.doc = Json.parse(parts.payload)
        return c

    def _check_claims(parts: JwsParts, opts: JwtOptions) throws str -> JwtClaims:
        if opts.typ.len() > 0:
            mut want_typ = opts.typ.to_lower()
            mut got_typ = parts.typ.to_lower()
            if got_typ != want_typ and got_typ != "application/" + want_typ:
                raise(f"JWT: unexpected typ '{parts.typ}'")
        mut c = JwtClaims()
        c.header_json = parts.header_json
        c.payload_json = parts.payload
        c.alg = parts.alg
        c.kid = parts.kid
        c.doc = Json.parse(parts.payload)
        mut root = c.doc.root()
        if not root.is_object(): raise("JWT: claims are not a JSON object")
        mut now = opts.now
        if now == 0: now = Clock.timestamp()
        mut lw = opts.leeway
        if lw < 0: lw = 0
        mut present = [false]
        mut pp = present as Pointer[bool]
        mut exp = _jwt_numeric(root, "exp", pp)?
        if present[0]:
            if now - lw >= exp: raise("JWT: token has expired")
        elif opts.require_exp:
            raise("JWT: token has no 'exp' claim")
        mut nbf = _jwt_numeric(root, "nbf", pp)?
        if present[0] and now + lw < nbf: raise("JWT: token is not valid yet (nbf)")
        mut iat = _jwt_numeric(root, "iat", pp)?
        if present[0]:
            if iat > now + lw: raise("JWT: token was issued in the future (iat)")
            if opts.max_age > 0 and now - iat > opts.max_age + lw: raise("JWT: token is too old (iat + max_age)")
        elif opts.max_age > 0:
            raise("JWT: token has no 'iat' claim")
        if opts.issuer.len() > 0:
            mut iss = c.get_str("iss")
            if iss != opts.issuer: raise(f"JWT: unexpected issuer '{iss}'")
        if opts.subject.len() > 0:
            mut sub = c.get_str("sub")
            if sub != opts.subject: raise("JWT: unexpected subject")
        if opts.audience.len() > 0:
            mut auds = c.audiences()
            mut found = false
            for a in auds:
                if a == opts.audience: found = true
            if not found: raise("JWT: token is not intended for this audience")
        return c
