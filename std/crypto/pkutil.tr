# std.crypto.pkutil — byte-buffer helpers, raw digests and HMAC for the
# public-key modules (std.crypto.rsa / ecdsa / x509, std.encoding.asn1 / pem).
#
# Representation: a "byte buffer" is a `Vec[int]` whose elements are 0..255.
# Unlike `str` it is NUL-safe and sign-safe by construction, which is what
# ASN.1/DER, big-integer and signature code needs. `Bytes` converts to/from
# binary `str` (real byte length is used, embedded NULs are fine), hex, and
# text. `PkHash` gives RAW digests / HMAC of such buffers by algorithm name
# ("sha1", "sha256", "sha384", "sha512") on top of the existing std.crypto
# hashes, so the callers never juggle hex digests.
#
# Usage:
#   from std.crypto.pkutil import Bytes, PkHash
#   mut d = PkHash.digest("sha256", Bytes.from_str("abc"))
#   print(Bytes.to_hex(d))        # ba7816bf...
#   mut m = PkHash.hmac("sha256", key_bytes, msg_bytes)

from std.core.vec import Vec
from std.crypto.hash import Hash
from std.crypto.sha512 import Sha512

extern "C":
    def _tr_c_malloc(size: int) -> Pointer[char]
    def _tr_str_wrap_len(s: Pointer[char], blen: int) -> str
    def _tr_rand_bytes_hex(n: int) -> str

pub class Bytes:
    _dummy: int

extend Bytes:
    # Binary `str` (real length) -> byte buffer.
    pub def from_str(s: str) -> Vec[int]:
        mut n = s.len()
        mut v = Vec[int].init(n + 1)
        mut p = s as Pointer[char]
        mut i = 0
        while i < n:
            mut b = 0
            unsafe:
                b = (p.offset(i).read() as int) & 255
            v.push(b)
            i = i + 1
        return v

    # Byte buffer -> binary `str` (may contain NULs; its `.len()` is exact).
    pub def to_str(v: Vec[int]) -> str:
        mut n = v.len
        mut out = _tr_c_malloc(n + 1)
        mut i = 0
        unsafe:
            while i < n:
                out.offset(i).write((v.get(i) & 255) as char)
                i = i + 1
            out.offset(n).write('\0')
        return _tr_str_wrap_len(out, n)

    def _hexval(c: int) -> int:
        if c >= 48 and c <= 57: return c - 48
        if c >= 97 and c <= 102: return c - 87
        if c >= 65 and c <= 70: return c - 55
        return -1

    # Hex text -> bytes. Whitespace and ':' separators are skipped; an odd
    # digit count or a non-hex character yields an EMPTY buffer.
    pub def from_hex(h: str) -> Vec[int]:
        mut v = Vec[int].init(h.len() / 2 + 1)
        mut p = h as Pointer[char]
        mut hi = -1
        mut i = 0
        while i < h.len():
            mut c = 0
            unsafe:
                c = (p.offset(i).read() as int) & 255
            i = i + 1
            if c == 32 or c == 10 or c == 13 or c == 9 or c == 58: continue
            mut d = Bytes._hexval(c)
            if d < 0:
                v.clear()
                return v
            if hi < 0:
                hi = d
            else:
                v.push(hi * 16 + d)
                hi = -1
        if hi >= 0: v.clear()
        return v

    # Bytes -> lower-case hex text.
    pub def to_hex(v: Vec[int]) -> str:
        mut digits = "0123456789abcdef"
        mut dp = digits as Pointer[char]
        mut n = v.len
        mut out = _tr_c_malloc(n * 2 + 1)
        mut i = 0
        unsafe:
            while i < n:
                mut b = v.get(i) & 255
                out.offset(i * 2).write(dp.offset(b >> 4).read())
                out.offset(i * 2 + 1).write(dp.offset(b & 15).read())
                i = i + 1
            out.offset(n * 2).write('\0')
        return _tr_str_wrap_len(out, n * 2)

    pub def zeros(n: int) -> Vec[int]:
        mut v = Vec[int].init(n + 1)
        mut i = 0
        while i < n:
            v.push(0)
            i = i + 1
        return v

    # `n` bytes from the OS CSPRNG (/dev/urandom, BCryptGenRandom).
    pub def random(n: int) -> Vec[int]:
        return Bytes.from_hex(_tr_rand_bytes_hex(n))

    pub def slice(v: Vec[int], off: int, n: int) -> Vec[int]:
        mut r = Vec[int].init(n + 1)
        mut i = 0
        while i < n:
            r.push(v.get(off + i))
            i = i + 1
        return r

    pub def concat(a: Vec[int], b: Vec[int]) -> Vec[int]:
        mut r = Vec[int].init(a.len + b.len + 1)
        mut i = 0
        while i < a.len:
            r.push(a.get(i))
            i = i + 1
        i = 0
        while i < b.len:
            r.push(b.get(i))
            i = i + 1
        return r

    pub def append(dst: Vec[int], src: Vec[int]):
        mut i = 0
        while i < src.len:
            dst.push(src.get(i))
            i = i + 1

    pub def eq(a: Vec[int], b: Vec[int]) -> bool:
        if a.len != b.len: return false
        mut i = 0
        while i < a.len:
            if a.get(i) != b.get(i): return false
            i = i + 1
        return true

    # Compare without early exit on the first difference (the length is not secret).
    pub def eq_ct(a: Vec[int], b: Vec[int]) -> bool:
        if a.len != b.len: return false
        mut acc = 0
        mut i = 0
        while i < a.len:
            acc = acc | (a.get(i) ^ b.get(i))
            i = i + 1
        return acc == 0

    pub def clone(a: Vec[int]) -> Vec[int]:
        return Bytes.slice(a, 0, a.len)

pub class PkHash:
    _dummy: int

extend PkHash:
    # Digest size in bytes; 0 for an unknown algorithm name.
    pub def out_len(alg: str) -> int:
        if alg == "sha1": return 20
        if alg == "sha256": return 32
        if alg == "sha384": return 48
        if alg == "sha512": return 64
        return 0

    pub def block_len(alg: str) -> int:
        if alg == "sha384" or alg == "sha512": return 128
        return 64

    pub def supported(alg: str) -> bool:
        return PkHash.out_len(alg) > 0

    # Raw digest of `data`. Unknown algorithm -> empty buffer.
    pub def digest(alg: str, data: Vec[int]) -> Vec[int]:
        mut s = Bytes.to_str(data)
        mut n = data.len
        if alg == "sha256":
            return Bytes.from_str(Hash.sha256_bytes(s, n))
        if alg == "sha1":
            return Bytes.from_hex(Hash.sha1_bytes(s, n))
        if alg == "sha384":
            return Bytes.from_hex(Sha512.sha384_bytes(s, n))
        if alg == "sha512":
            return Bytes.from_hex(Sha512.sha512_bytes(s, n))
        return Bytes.zeros(0)

    # HMAC (RFC 2104) with any supported hash; raw output.
    pub def hmac(alg: str, key: Vec[int], msg: Vec[int]) -> Vec[int]:
        mut bl = PkHash.block_len(alg)
        mut k = Bytes.clone(key)
        if k.len > bl:
            k = PkHash.digest(alg, k)
        while k.len < bl:
            k.push(0)
        mut ipad = Vec[int].init(bl + msg.len + 1)
        mut opad = Vec[int].init(bl + 80)
        mut i = 0
        while i < bl:
            ipad.push(k.get(i) ^ 54)
            opad.push(k.get(i) ^ 92)
            i = i + 1
        Bytes.append(ipad, msg)
        mut inner = PkHash.digest(alg, ipad)
        Bytes.append(opad, inner)
        return PkHash.digest(alg, opad)
