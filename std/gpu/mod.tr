# std.gpu — Portable GPU compute for Tauraro.
#
# A unified, zero-cost compute API that runs on CUDA, OpenCL, or the CPU,
# chosen automatically at runtime. There is NO build- or link-time dependency
# on any GPU SDK: the vendor driver is loaded dynamically at first use and the
# backend degrades gracefully to the CPU when no GPU is present.
#
# Quick import:
#   from std.gpu import Device, Backend, Buffer, Module, Kernel, Dim3, Gpu
#
# Or per-module:
#   from std.gpu.device   import Device, Backend
#   from std.gpu.buffer   import Buffer
#   from std.gpu.kernel   import Module, Kernel, Dim3
#   from std.gpu.parallel import Gpu
#
# --- Device / buffer round-trip (works on any machine, GPU or not) ----------
#   from std.gpu import Device, Buffer
#   from std.core.vec import Vec
#
#   Device.detect()
#   print(Device.backend_name())          # "CUDA" / "OpenCL" / "CPU"
#   mut host = Vec[float].init(4)
#   host.push(1.0); host.push(2.0); host.push(3.0); host.push(4.0)
#   mut dev = Buffer[float].from_vec(host)
#   mut back = dev.download()             # Vec[float] with the same data
#   dev.free()
#
# --- Real kernel launch (OpenCL source shown; requires a GPU) ----------------
#   from std.gpu import Device, Buffer, Module, Kernel
#
#   src = "__kernel void scale(__global float* a, float k){"
#         " int i = get_global_id(0); a[i] = a[i]*k; }"
#   mut m = Module.load_source(src)
#   if m.is_valid():
#       mut k = m.kernel("scale")
#       k.arg_buffer(0, dev.handle).arg_f32(1, 2.0)
#       k.launch1d(dev.len, 64)
#       Device.synchronize()
#   else:
#       print(Device.last_error())

from std.gpu.device   import Device, Backend
from std.gpu.buffer   import Buffer
from std.gpu.kernel   import Module, Kernel, Dim3
from std.gpu.parallel import Gpu
from std.gpu.kernel_builtins import gpu_global_id, gpu_local_id, gpu_group_id, gpu_local_size, gpu_global_size, gpu_num_groups, gpu_barrier
